module web {
  /** @throws {never} */
  export function makeHeaders(init?: Readonly<Record<string, string>>, setCookies: ReadonlyArray<string> = []): Headers {
    const headers = new Headers(init)
    for (const cookie of setCookies) {
      if (cookie !== "") headers.append("set-cookie", cookie)
    }
    return headers
  }

  /** @throws {never} */
  export function makeResponse(body: BodyInit | null, init?: ResponseInit): Response {
    return new Response(body, init)
  }

  /** @throws {never} */
  export function randomUuid(): string {
    return globalThis.crypto.randomUUID()
  }
}
import { makeHeaders, makeResponse, randomUuid } from web

error HttpRequestError { status: number; code: string; message: string }

interface ParsedBody {
  readonly data: Readonly<Record<string, unknown>>
  readonly isForm: boolean
}

const RecordSchema = Schema.Record(Schema.String, Schema.Unknown)
const StringArraySchema = Schema.Array(Schema.String)

const PUBLIC_CORS_HEADERS: Readonly<Record<string, string>> = {
  "access-control-allow-origin": "*",
  "access-control-allow-methods": "GET, POST, OPTIONS",
  "access-control-allow-headers": "Content-Type, Authorization"
}

effect function badRequest(code: string, message: string, status = 400): never!HttpRequestError {
  throw new HttpRequestError({ status, code, message })
}

function jsonResponse(
  body: unknown,
  status = 200,
  extraHeaders: Readonly<Record<string, string>> = {},
  setCookies: ReadonlyArray<string> = []
): Response {
  const headers = makeHeaders(
    {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store",
      "x-content-type-options": "nosniff",
      ...extraHeaders
    },
    setCookies
  )
  return makeResponse(JSON.stringify(body), { status, headers })
}

function withRefreshedSessionCookie(response: Response, session: SessionIdentity | null): Response {
  const refreshedCookie = session?.refreshedSessionCookieHeader
  if (refreshedCookie === undefined || response.headers.has("set-cookie")) {
    return response
  }
  const copiedHeaders: Record<string, string> = {}
  for (const [name, value] of response.headers.entries()) {
    copiedHeaders[name] = value
  }
  return makeResponse(response.body, {
    status: response.status,
    statusText: response.statusText,
    headers: makeHeaders(copiedHeaders, [refreshedCookie])
  })
}
function clearCookieHeaders(publicAppUrl: string): ReadonlyArray<string> {
  const base = "Path=/; HttpOnly; SameSite=Lax; Max-Age=0"
  const headers = [`feed-session=; ${base}`]
  if (publicAppUrl.startsWith("https://")) {
    headers.push(`__Host-feed-session=; Secure; ${base}`)
  }
  return headers
}

function buildSlidingSessionCookieHeader(
  request: Request,
  session: SessionIdentity,
  config: AppServerConfig,
  now: number
): string | undefined {
  const cookieHeader = request.headers.get("cookie")
  if (cookieHeader === null || cookieHeader.trim() === "") return undefined
  const isHttps = config.publicAppUrl.startsWith("https://")
  const cookieName = isHttps ? "__Host-feed-session" : "feed-session"
  const pairs = cookieHeader.split(";").map((part) => part.trim())
  const names = isHttps ? ["__Host-feed-session"] : ["__Host-feed-session", "feed-session"]
  let token: string | undefined
  for (const name of names) {
    const prefix = `${name}=`
    const found = pairs.find((part) => part.startsWith(prefix))
    if (found !== undefined) {
      const candidate = found.slice(prefix.length).trim()
      if (candidate.length >= 20) {
        token = candidate
        break
      }
    }
  }
  if (token === undefined) return undefined
  const maxAgeSeconds = Math.max(1, Math.floor((session.expiresAt - now) / 1000))
  const secure = isHttps ? "; Secure" : ""
  return `${cookieName}=${token}; Path=/; HttpOnly${secure}; SameSite=Lax; Max-Age=${maxAgeSeconds}`
}

function requestOrigin(request: Request, config: AppServerConfig): string {
  if (config.publicAppUrl !== "") {
    return config.publicAppUrl
  }
  const url = new URL(request.url)
  if (url.origin !== "null" && url.origin !== "") {
    return url.origin.replace(/\/+$/, "")
  }
  return config.publicAppUrl
}

function clientIp(request: Request): string | undefined {
  for (const header of ["cf-connecting-ip", "x-real-ip", "x-forwarded-for"]) {
    const raw = request.headers.get(header)
    const candidate = (header === "x-forwarded-for" ? raw?.split(",")[0] : raw)?.trim()
    if (candidate !== undefined && candidate !== "") return candidate
  }
  return undefined
}

function strField(obj: Readonly<Record<string, unknown>>, ...keys: ReadonlyArray<string>): string | undefined {
  for (const key of keys) {
    const value = obj[key]
    if (typeof value === "string") return value
  }
  return undefined
}

effect function reqStr(obj: Readonly<Record<string, unknown>>, fieldName: string, ...keys: ReadonlyArray<string>): string!HttpRequestError {
  const value = strField(obj, ...keys)?.trim()
  if (value === undefined || value === "") {
    return try badRequest("invalid_input", `${fieldName} is required.`)
  }
  return value
}

function boolField(obj: Readonly<Record<string, unknown>>, fallback: boolean, ...keys: ReadonlyArray<string>): boolean {
  for (const key of keys) {
    const value = obj[key]
    if (typeof value === "boolean") return value
    if (value === "true") return true
    if (value === "false") return false
  }
  return fallback
}

function numField(obj: Readonly<Record<string, unknown>>, ...keys: ReadonlyArray<string>): number | undefined {
  for (const key of keys) {
    const value = obj[key]
    if (typeof value === "number" && Number.isFinite(value)) return value
    if (typeof value === "string" && value.trim() !== "") {
      const parsed = Number(value)
      if (Number.isFinite(parsed)) return parsed
    }
  }
  return undefined
}

function strArrayField(obj: Readonly<Record<string, unknown>>, ...keys: ReadonlyArray<string>): ReadonlyArray<string> | undefined {
  for (const key of keys) {
    const value = obj[key]
    const decoded = Option.getOrUndefined(Schema.decodeUnknownOption(StringArraySchema)(value))
    if (decoded !== undefined) return decoded
    if (typeof value === "string") {
      return value.trim().split(/[\s,]+/).filter((part) => part !== "")
    }
  }
  return undefined
}

effect function readParsedBody(request: Request): ParsedBody!HttpRequestError {
  const rawText = try tryPromise({
    try: () => request.text(),
    catch: () => new HttpRequestError({ status: 400, code: "invalid_body", message: "Unable to read request body." })
  })
  const trimmed = rawText.trim()
  const contentType = request.headers.get("content-type")?.toLowerCase() ?? ""
  const isForm = contentType.includes("application/x-www-form-urlencoded")
  if (trimmed === "") return { data: {}, isForm }
  if (isForm) {
    const params = new URLSearchParams(rawText)
    const obj: Record<string, unknown> = {}
    for (const [key, value] of params.entries()) {
      obj[key] = value
    }
    return { data: obj, isForm: true }
  }
  const parsed = try Effect.try({
    try: () => JSON.parse(trimmed) as unknown,
    catch: () => new HttpRequestError({ status: 400, code: "invalid_json", message: "Invalid JSON body." })
  })
  const record = Option.getOrUndefined(Schema.decodeUnknownOption(RecordSchema)(parsed))
  if (record === undefined) {
    return try badRequest("invalid_json", "Request body must be a JSON object.")
  }
  return { data: record, isForm: false }
}

effect function optionalSession(
  request: Request,
  config: AppServerConfig
): (SessionIdentity | null)!StoreFailure!Store {
  const cookieHeader = request.headers.get("cookie") ?? undefined
  return try authenticateSessionCookie(cookieHeader, config.auth)
}

effect function requireSession(
  request: Request,
  config: AppServerConfig
): SessionIdentity!(AuthFailure | StoreFailure)!Store {
  const session = try optionalSession(request, config)
  if (session === null) {
    throw new AuthFailure({ code: "unauthorized", message: "Authentication required.", status: 401 })
  }
  return session
}

effect function requireAdminSession(
  request: Request,
  config: AppServerConfig
): SessionIdentity!(AuthFailure | StoreFailure)!Store {
  const session = try requireSession(request, config)
  if (!session.isAdmin) {
    throw new AuthFailure({ code: "forbidden", message: "Admin privileges required.", status: 403 })
  }
  return session
}

function constantTimeEquals(a: string, b: string): boolean {
  if (a.length === 0 || a.length !== b.length) return false
  let diff = 0
  for (let i = 0; i < a.length; i += 1) {
    diff |= a.charCodeAt(i) ^ b.charCodeAt(i)
  }
  return diff === 0
}

function decodeSegment(raw: string): string {
  try {
    return decodeURIComponent(raw)
  } catch {
    return raw
  }
}

function clampIntQuery(url: URL, key: string, fallback: number, min: number, max: number): number {
  const raw = url.searchParams.get(key)
  if (raw === null || raw.trim() === "") return fallback
  const n = Number(raw)
  if (!Number.isFinite(n)) return fallback
  return Math.max(min, Math.min(max, Math.floor(n)))
}

function marketFailureStatus(code: string): number {
  if (code.includes("NOT_FOUND")) return 404
  if (code === "FORBIDDEN") return 403
  if (code === "RATE_LIMITED") return 429
  if (code === "MARKET_NOT_OPEN" || code === "ALREADY_SETTLED" || code === "CONFLICT" || code === "IDEMPOTENCY_CONFLICT") return 409
  if (code === "INVALID_IDEMPOTENCY_KEY") return 400
  return 400
}

function socialFailureStatus(code: string): number {
  if (code === "NotFound") return 404
  if (code === "Blocked" || code === "Forbidden" || code === "NpcDmDisallowed") return 403
  if (code === "RateLimited" || code === "CooldownActive") return 429
  if (code === "Conflict" || code === "TeamChatRetired" || code === "AlphaLimitReached") return 409
  return 400
}

function isPgUniqueViolation(cause: unknown): boolean {
  if (typeof cause === "object" && cause !== null) {
    const rec = cause as { readonly code?: unknown; readonly message?: unknown }
    if (rec.code === "23505") return true
    if (typeof rec.message === "string" && rec.message.toLowerCase().includes("duplicate key")) return true
  }
  if (cause instanceof Error && cause.message.toLowerCase().includes("duplicate key")) return true
  return false
}

function mapDomainError(err: unknown): Response {
  if (err instanceof HttpRequestError) {
    return jsonResponse({ error: err.code, code: err.code, message: err.message }, err.status)
  }
  if (err instanceof AuthFailure) {
    return jsonResponse(
      { error: err.code, code: err.code, message: err.message, error_description: err.message },
      err.status
    )
  }
  if (err instanceof RateLimited) {
    return jsonResponse(
      {
        error: "rate_limited",
        code: "rate_limited",
        message: err.message,
        error_description: err.message,
        retryAfterSeconds: err.retryAfterSeconds
      },
      429,
      { "retry-after": String(err.retryAfterSeconds) }
    )
  }
  if (err instanceof UnauthorizedError) {
    return jsonResponse(
      { error: err.code, code: err.code, message: err.message, error_description: err.message },
      401
    )
  }
  if (err instanceof MarketFailure) {
    return jsonResponse({ error: err.code, code: err.code, message: err.message }, marketFailureStatus(err.code))
  }
  if (err instanceof SocialFailure) {
    const extraHeaders: Record<string, string> = err.code === "RateLimited" && err.retryAfterSeconds !== undefined
      ? { "retry-after": String(err.retryAfterSeconds) }
      : {}
    return jsonResponse(
      {
        error: err.code,
        code: err.code,
        message: err.message,
        ...(err.retryAfterSeconds !== undefined ? { retryAfterSeconds: err.retryAfterSeconds } : {})
      },
      socialFailureStatus(err.code),
      extraHeaders
    )
  }
  if (err instanceof EngineFailure) {
    const status = err.code === "NOT_FOUND" ? 404 : err.code === "BUDGET_EXCEEDED" ? 429 : 400
    return jsonResponse({ error: err.code, code: err.code, message: err.message }, status)
  }
  if (err instanceof McpFailure) {
    return jsonResponse({ error: err.code, code: err.code, message: err.message }, 400)
  }
  if (err instanceof SkillPublishInvalid) {
    return jsonResponse({ error: "skill_invalid", code: "skill_invalid", message: err.reason }, 400)
  }
  if (err instanceof SkillDigestError) {
    return jsonResponse({ error: "skill_digest_error", code: "skill_digest_error", message: "Skill digest unavailable." }, 500)
  }
  if (err instanceof StoreFailure) {
    return jsonResponse({ error: "store_error", code: "store_error", message: "Database operation failed." }, 500)
  }
  return jsonResponse({ error: "internal_error", code: "internal_error", message: "Unexpected server failure." }, 500)
}

effect function appendRedirectParams(baseUri: string, params: Readonly<Record<string, string>>): string!HttpRequestError {
  const url = try Effect.try({
    try: () => new URL(baseUri),
    catch: () => new HttpRequestError({ status: 400, code: "invalid_redirect_uri", message: "Invalid redirect_uri." })
  })
  for (const [key, value] of Object.entries(params)) {
    url.searchParams.set(key, value)
  }
  return url.toString()
}

effect function consumeOAuthIpBudget(
  request: Request,
  config: AppServerConfig,
  endpoint: "device_code" | "register"
): void!(AuthFailure | RateLimited | StoreFailure)!Store {
  const ipAddress = clientIp(request)
  if (ipAddress !== undefined && config.auth.digestKey !== "") {
    try checkOAuthEndpointRateLimit({ endpoint, ipAddress, digestKey: config.auth.digestKey })
  }
}

effect function resolveOAuthClientRow(
  clientId: string,
  request: Request,
  config: AppServerConfig
): { readonly clientId: string; readonly clientName: string; readonly redirectUris: ReadonlyArray<string> }!(AuthFailure | RateLimited | StoreFailure)!Store {
  const trimmedId = clientId.trim()
  if (trimmedId === "") {
    throw new AuthFailure({ code: "invalid_client", message: "client_id is required.", status: 400 })
  }
  if (/^https?:\/\//i.test(trimmedId)) {
    try consumeOAuthIpBudget(request, config, "register")
    const cimd = try fetchClientMetadata(trimmedId)
    return { clientId: cimd.clientId, clientName: cimd.clientName, redirectUris: cimd.redirectUris }
  }
  const store = try Store
  const rows = try store.transaction((tx: Tx) =>
    tx.query("SELECT client_id, client_name, redirect_uris FROM feed_oauth_clients WHERE client_id = $1 LIMIT 1", [trimmedId])
  )
  const row = rows[0]
  if (row === undefined) {
    throw new AuthFailure({ code: "invalid_client", message: "Unknown OAuth client.", status: 400 })
  }
  const rawUris = Effect.try(() => JSON.parse(toText(row.redirect_uris) ?? "[]") as unknown) catch () => []
  const redirectUris = Option.getOrUndefined(Schema.decodeUnknownOption(StringArraySchema)(rawUris)) ?? []
  return {
    clientId: toText(row.client_id) ?? trimmedId,
    clientName: toText(row.client_name) ?? trimmedId,
    redirectUris
  }
}

effect function inspectOAuthConsent(
  params: URLSearchParams,
  request: Request,
  origin: string,
  config: AppServerConfig
): Response!(AuthFailure | RateLimited | StoreFailure)!Store {
  const clientId = params.get("client_id")?.trim() ?? ""
  const redirectUri = params.get("redirect_uri")?.trim() ?? ""
  const responseType = params.get("response_type")?.trim() || "code"
  const codeChallenge = params.get("code_challenge")?.trim() ?? ""
  const codeChallengeMethod = params.get("code_challenge_method")?.trim() || ""
  const state = params.get("state") ?? ""
  const resource = params.get("resource")?.trim() || `${origin}/mcp`
  const scopeRaw = params.get("scope")?.trim() || "read social:write messages trade"
  const scopes = scopeRaw.split(/\s+/).filter((token) => token !== "")
  const client = try resolveOAuthClientRow(clientId, request, config)
  if (!redirectUriMatchesRegistered(client.redirectUris, redirectUri)) {
    throw new AuthFailure({ code: "invalid_redirect_uri", message: "redirect_uri is not registered for this client.", status: 400 })
  }
  if (responseType !== "code" || codeChallengeMethod !== "S256" || codeChallenge === "" || state === "") {
    throw new AuthFailure({ code: "invalid_request", message: "Invalid OAuth authorization parameters.", status: 400 })
  }
  const session = try optionalSession(request, config)
  const priorGrant = session !== null ? try getActiveAgentGrant(session.accountId) : null
  return jsonResponse({
    clientId: client.clientId,
    clientName: client.clientName,
    redirectUri,
    scopes,
    state,
    resource,
    codeChallenge,
    codeChallengeMethod,
    responseType,
    priorGrantClientName: priorGrant?.clientName ?? null,
    error: null
  })
}

effect function submitOAuthDecision(
  request: Request,
  origin: string,
  config: AppServerConfig
): Response!(AuthFailure | RateLimited | StoreFailure | HttpRequestError)!Store {
  const session = try requireSession(request, config)
  const parsed = try readParsedBody(request)
  const body = parsed.data
  const clientId = try reqStr(body, "clientId", "clientId", "client_id")
  const redirectUri = try reqStr(body, "redirectUri", "redirectUri", "redirect_uri")
  const state = try reqStr(body, "state", "state")
  const resource = strField(body, "resource")?.trim() || `${origin}/mcp`
  const codeChallenge = try reqStr(body, "codeChallenge", "codeChallenge", "code_challenge")
  const codeChallengeMethod = strField(body, "codeChallengeMethod", "code_challenge_method")?.trim() || "S256"
  const responseType = strField(body, "responseType", "response_type")?.trim() || "code"
  const hasExplicitScopes = Object.prototype.hasOwnProperty.call(body, "scopes") || Object.prototype.hasOwnProperty.call(body, "scope")
  const scopesList = strArrayField(body, "scopes", "scope")
  const deny = body.approved === false || body.approved === "false" || body.deny === true || body.deny === "true" || body.decision === "deny"
  const client = try resolveOAuthClientRow(clientId, request, config)
  if (!redirectUriMatchesRegistered(client.redirectUris, redirectUri)) {
    throw new AuthFailure({ code: "invalid_redirect_uri", message: "redirect_uri is not registered for this client.", status: 400 })
  }
  if (deny) {
    const redirectTo = try appendRedirectParams(redirectUri, { error: "access_denied", state, iss: oauthAuthorizationServerMetadata(origin).issuer })
    return parsed.isForm ? makeResponse(null, { status: 302, headers: { location: redirectTo } }) : jsonResponse({ denied: true, redirectTo })
  }
  if (hasExplicitScopes && (scopesList === undefined || scopesList.length === 0)) {
    return try badRequest("invalid_scope", "Select at least one permission scope.")
  }
  const scope = scopesList !== undefined && scopesList.length > 0 ? scopesList.join(" ") : "read social:write messages trade"
  const issued = try createAuthorizationCode({
    accountId: session.accountId,
    clientId: client.clientId,
    clientName: client.clientName,
    redirectUri,
    codeChallenge,
    codeChallengeMethod,
    responseType,
    scope,
    state,
    resource,
    origin
  })
  const redirectTo = try appendRedirectParams(issued.redirectUri, { code: issued.code, state: issued.state, iss: issued.iss })
  return parsed.isForm ? makeResponse(null, { status: 302, headers: { location: redirectTo } }) : jsonResponse({ ...issued, redirectTo })
}

effect function handleOAuthRoute(
  request: Request,
  url: URL,
  origin: string,
  config: AppServerConfig
): (Response | undefined)!(AuthFailure | RateLimited | StoreFailure | HttpRequestError)!Store {
  const path = url.pathname
  const method = request.method.toUpperCase()
  if (method === "POST" && path === "/oauth/register") {
    try consumeOAuthIpBudget(request, config, "register")
    const { data } = try readParsedBody(request)
    const clientName = try reqStr(data, "client_name", "client_name", "clientName")
    const redirectUris = strArrayField(data, "redirect_uris", "redirectUris") ?? []
    const client = try registerDynamicClient({
      clientName,
      redirectUris,
      clientUri: strField(data, "client_uri", "clientUri"),
      tokenEndpointAuthMethod: strField(data, "token_endpoint_auth_method", "tokenEndpointAuthMethod"),
      grantTypes: strArrayField(data, "grant_types", "grantTypes"),
      responseTypes: strArrayField(data, "response_types", "responseTypes"),
      scope: strField(data, "scope")
    })
    return jsonResponse(client, 201, PUBLIC_CORS_HEADERS)
  }
  if (method === "GET" && path === "/oauth/authorize") {
    const accept = request.headers.get("accept")?.toLowerCase() ?? ""
    if (accept.includes("text/html") && url.searchParams.get("format") !== "json") return undefined
    return try inspectOAuthConsent(url.searchParams, request, origin, config)
  }
  if (method === "GET" && path === "/api/oauth/consent") {
    return try inspectOAuthConsent(url.searchParams, request, origin, config)
  }
  if (method === "POST" && (path === "/oauth/authorize" || path === "/api/oauth/authorize" || path === "/api/oauth/consent")) {
    return try submitOAuthDecision(request, origin, config)
  }
  if (method === "POST" && path === "/oauth/token") {
    const { data } = try readParsedBody(request)
    const grantType = try reqStr(data, "grant_type", "grant_type", "grantType")
    const token = try exchangeOAuthToken({
      grantType,
      code: strField(data, "code"),
      codeVerifier: strField(data, "code_verifier", "codeVerifier"),
      clientId: strField(data, "client_id", "clientId"),
      redirectUri: strField(data, "redirect_uri", "redirectUri"),
      refreshToken: strField(data, "refresh_token", "refreshToken"),
      deviceCode: strField(data, "device_code", "deviceCode"),
      resource: strField(data, "resource"),
      config: config.auth
    })
    return jsonResponse(token, 200, { ...PUBLIC_CORS_HEADERS, pragma: "no-cache" })
  }
  if (method === "POST" && path === "/oauth/revoke") {
    const { data } = try readParsedBody(request)
    const token = strField(data, "token") ?? ""
    return jsonResponse(try revokeOAuthToken({ token, config: config.auth }), 200, PUBLIC_CORS_HEADERS)
  }
  if (method === "POST" && (path === "/oauth/device" || path === "/oauth/device/code")) {
    try consumeOAuthIpBudget(request, config, "device_code")
    const { data } = try readParsedBody(request)
    const rawClientId = try reqStr(data, "client_id", "client_id", "clientId")
    let clientId = rawClientId
    let clientName = strField(data, "client_name", "clientName")
    if (/^https?:\/\//i.test(rawClientId)) {
      const cimd = try fetchClientMetadata(rawClientId)
      clientId = cimd.clientId
      clientName = cimd.clientName
    }
    const device = try startDeviceAuthorization({
      clientId,
      clientName,
      scope: strField(data, "scope"),
      resource: strField(data, "resource"),
      origin
    })
    return jsonResponse(device, 200, PUBLIC_CORS_HEADERS)
  }
  if (method === "GET" && path === "/api/oauth/device/lookup") {
    try requireSession(request, config)
    const userCode = url.searchParams.get("userCode")?.trim() || url.searchParams.get("user_code")?.trim() || ""
    if (userCode === "") {
      return try badRequest("invalid_user_code", "Query parameter userCode is required.")
    }
    return jsonResponse(try lookupDeviceCodeForUser(userCode))
  }
  if (method === "POST" && path === "/api/oauth/device/approve") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const userCode = try reqStr(data, "userCode", "userCode", "user_code")
    const approved = try approveDeviceAuthorization({
      accountId: session.accountId,
      userCode,
      scopes: strArrayField(data, "scopes", "scope"),
      deny: boolField(data, false, "deny")
    })
    return jsonResponse(approved)
  }
  return undefined
}

function authBootstrapFields(config: AppServerConfig) {
  const emailMode = resolveEmailMode(config.auth)
  return {
    acceptedCountries: config.auth.allowedCountries,
    publicAppUrl: config.publicAppUrl,
    turnstileSiteKey: config.auth.turnstileSiteKey ?? null,
    devSmsCodeEnabled: config.auth.smsMode === "loopback",
    emailAuthEnabled: emailMode !== "disabled",
    devEmailLinkEnabled: emailMode === "loopback"
  }
}

function emailStartJsonResponse(result: {
  readonly challengeId: string
  readonly emailMasked: string
  readonly expiresAt: number
  readonly resendAvailableAt: number
  readonly devMagicLinkUrl?: string | undefined
  readonly devToken?: string | undefined
}): Response {
  return jsonResponse({
    ok: true,
    challengeId: result.challengeId,
    emailMasked: result.emailMasked,
    expiresAt: result.expiresAt,
    expiresAtMs: result.expiresAt,
    resendAvailableAt: result.resendAvailableAt,
    resendAvailableAtMs: result.resendAvailableAt,
    ...(result.devMagicLinkUrl !== undefined ? { devMagicLinkUrl: result.devMagicLinkUrl, devToken: result.devToken } : {})
  })
}

function profileFeedQuery(authorId: string, viewerId: string | undefined, mode: "game" | "social", url: URL) {
  return {
    tab: "latest" as const,
    viewerId,
    mode,
    authorId,
    cursor: url.searchParams.get("cursor") ?? undefined,
    limit: clampIntQuery(url, "limit", 30, 1, 100),
    filter: parseFeedPostFilter(url.searchParams.get("filter")),
    onlyReplies: parseBoolQuery(url.searchParams.get("onlyReplies")),
    includeReplies: parseBoolQuery(url.searchParams.get("includeReplies"))
  }
}

function linkAuthContext(
  session: { readonly accountId: string; readonly authAt: number },
  request: Request,
  data: Readonly<Record<string, unknown>>,
  config: AppServerConfig
) {
  return {
    accountId: session.accountId,
    authAt: session.authAt,
    cookieHeader: request.headers.get("cookie") ?? undefined,
    turnstileToken: strField(data, "turnstileToken", "turnstile_token"),
    ipAddress: clientIp(request),
    config: config.auth
  }
}

effect function handleEmailAuthRoute(
  request: Request,
  url: URL,
  path: string,
  method: string,
  config: AppServerConfig
): (Response | undefined)!(AuthFailure | RateLimited | StoreFailure | HttpRequestError)!Store {
  if (method === "POST" && path === "/api/auth/email/start") {
    const { data } = try readParsedBody(request)
    const email = try reqStr(data, "email", "email")
    const result = try startEmailMagicLink({
      email,
      turnstileToken: strField(data, "turnstileToken", "turnstile_token"),
      redirectTo: strField(data, "redirectTo", "redirect_to"),
      ipAddress: clientIp(request),
      config: config.auth
    })
    return emailStartJsonResponse(result)
  }
  if (method === "POST" && path === "/api/auth/email/verify") {
    const { data } = try readParsedBody(request)
    const session = try optionalSession(request, config)
    const result = try verifyEmailMagicLink({
      token: try reqStr(data, "token", "token"),
      sessionAccountId: session?.accountId ?? null,
      config: config.auth
    })
    if (result.status === "needs_onboarding") {
      return jsonResponse({
        status: "needs_onboarding",
        needsOnboarding: true,
        onboardingToken: result.pendingToken,
        pendingToken: result.pendingToken,
        emailMasked: result.emailMasked,
        redirectTo: result.redirectTo
      })
    }
    if (result.status === "email_linked") {
      return jsonResponse(
        {
          status: "email_linked",
          needsOnboarding: false,
          emailMasked: result.account.emailMasked,
          account: result.account,
          redirectTo: result.redirectTo
        },
        200,
        {},
        [result.sessionCookieHeader]
      )
    }
    return jsonResponse(
      {
        status: "signed_in",
        needsOnboarding: false,
        account: result.account,
        redirectTo: result.redirectTo
      },
      200,
      {},
      [result.sessionCookieHeader]
    )
  }
  if (method === "POST" && (path === "/api/auth/email/onboard" || path === "/api/auth/onboard")) {
    const { data } = try readParsedBody(request)
    const onboardInput = {
      pendingToken: try reqStr(data, "onboardingToken", "onboardingToken", "pendingToken", "pending_token"),
      username: try reqStr(data, "username", "username", "handle"),
      accepted18Plus: boolField(data, false, "ageConfirmed", "accepted18Plus"),
      acceptedTerms: boolField(data, false, "tosAccepted", "acceptedTerms"),
      bio: strField(data, "bio"),
      displayName: strField(data, "displayName"),
      config: config.auth
    }
    const result = path === "/api/auth/email/onboard"
      ? try completeEmailOnboarding(onboardInput)
      : try completeOnboarding(onboardInput)
    return jsonResponse({ ok: true, account: result.account }, 201, {}, [result.sessionCookieHeader])
  }
  if (method === "POST" && path === "/api/auth/email/link/start") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const result = try startEmailLink({
      ...linkAuthContext(session, request, data, config),
      email: try reqStr(data, "email", "email")
    })
    return emailStartJsonResponse(result)
  }
  if (method === "POST" && path === "/api/auth/email/link/verify") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const result = try verifyEmailMagicLink({
      token: try reqStr(data, "token", "token"),
      sessionAccountId: session.accountId,
      config: config.auth
    })
    if (result.status !== "email_linked") {
      throw new AuthFailure({ code: "invalid_magic_link", message: "Expected an email-linking verification link.", status: 400 })
    }
    return jsonResponse(
      {
        status: "email_linked",
        emailMasked: result.account.emailMasked,
        account: result.account,
        redirectTo: result.redirectTo
      },
      200,
      {},
      [result.sessionCookieHeader]
    )
  }
  if (method === "GET" && path === "/api/auth/dev/loopback-email-link") {
    if (resolveEmailMode(config.auth) !== "loopback") {
      throw new AuthFailure({
        code: "loopback_disabled",
        message: "Loopback email links are only available when EMAIL_MODE=loopback.",
        status: 403
      })
    }
    const email = url.searchParams.get("email")?.trim() ?? ""
    if (email === "") return try badRequest("invalid_email", "Query parameter email is required.")
    const normalized = try normalizeEmail(email)
    const entry = getLoopbackMagicLink(normalized, config.auth)
    if (entry === undefined) return jsonResponse({ error: "not_found", code: "not_found", message: "No active loopback email link." }, 404)
    return jsonResponse({
      ok: true,
      emailMasked: maskEmail(normalized),
      magicLinkUrl: entry.magicLinkUrl,
      token: entry.token
    })
  }
  return undefined
}

effect function handleAuthRoute(
  request: Request,
  url: URL,
  config: AppServerConfig
): (Response | undefined)!(AuthFailure | RateLimited | StoreFailure | HttpRequestError)!Store {
  const path = url.pathname
  const method = request.method.toUpperCase()
  if (!path.startsWith("/api/auth/")) return undefined

  const emailResponse = try handleEmailAuthRoute(request, url, path, method, config)
  if (emailResponse !== undefined) return emailResponse

  if (method === "GET" && path === "/api/auth/me") {
    const bootstrap = authBootstrapFields(config)
    const session = try optionalSession(request, config)
    if (session === null) {
      return jsonResponse({
        authenticated: false,
        viewer: null,
        account: null,
        ...bootstrap
      })
    }
    const profile = getAccountProfile(session.accountId) catch effect (err) => {
      if (err instanceof StoreFailure) throw err
      return undefined
    }
    if (profile === undefined) {
      return jsonResponse(
        {
          authenticated: false,
          viewer: null,
          account: null,
          ...bootstrap
        },
        200,
        {},
        clearCookieHeaders(config.publicAppUrl)
      )
    }
    const grant = try getActiveAgentGrant(session.accountId)
    const now = try Clock.currentTimeMillis
    const refreshedCookie = buildSlidingSessionCookieHeader(request, session, config, now)
    const viewer = {
      accountId: profile.accountId,
      handle: profile.handle,
      displayName: profile.displayName,
      bio: profile.bio,
      avatarUrl: profile.avatarUrl,
      bannerUrl: profile.bannerUrl,
      phoneLast2: profile.phoneLast2,
      phoneVerifiedAt: profile.phoneVerifiedAt,
      emailMasked: profile.emailMasked,
      emailVerifiedAt: profile.emailVerifiedAt,
      uiMode: profile.uiMode,
      balanceCents: profile.balanceCents,
      startingGrantCents: profile.startingGrantCents,
      isAdmin: profile.isAdmin,
      isReviewer: profile.isReviewer,
      agentGrant: grant
    }
    return jsonResponse(
      {
        authenticated: true,
        viewer,
        account: viewer,
        ...bootstrap
      },
      200,
      {},
      refreshedCookie !== undefined ? [refreshedCookie] : []
    )
  }
  if (method === "POST" && path === "/api/auth/phone/start") {
    const { data } = try readParsedBody(request)
    const phoneE164 = try reqStr(data, "phoneE164", "phoneE164", "phone")
    const result = try startPhoneVerification({
      phoneE164,
      turnstileToken: strField(data, "turnstileToken", "turnstile_token"),
      ipAddress: clientIp(request),
      config: config.auth
    })
    return jsonResponse({ challengeId: result.challengeId, last2: result.last2, expiresAt: result.expiresAt, resendAvailableAt: result.resendAvailableAt })
  }
  if (method === "POST" && path === "/api/auth/phone/verify") {
    const { data } = try readParsedBody(request)
    const result = try verifyPhoneCode({
      phoneE164: try reqStr(data, "phoneE164", "phoneE164", "phone"),
      code: try reqStr(data, "code", "code"),
      config: config.auth
    })
    if (result.needsOnboarding) {
      return jsonResponse({
        status: "needs_onboarding",
        needsOnboarding: true,
        pendingToken: result.pendingToken,
        last2: result.last2
      })
    }
    return jsonResponse(
      { status: "signed_in", needsOnboarding: false, account: result.account },
      200,
      {},
      [result.sessionCookieHeader]
    )
  }
  if (method === "POST" && path === "/api/auth/phone/onboard") {
    const { data } = try readParsedBody(request)
    const result = try completePhoneOnboarding({
      pendingToken: try reqStr(data, "pendingToken", "pendingToken", "onboardingToken", "pending_token"),
      username: try reqStr(data, "username", "username", "handle"),
      accepted18Plus: boolField(data, false, "accepted18Plus", "ageConfirmed"),
      acceptedTerms: boolField(data, false, "acceptedTerms", "tosAccepted"),
      bio: strField(data, "bio"),
      displayName: strField(data, "displayName"),
      config: config.auth
    })
    return jsonResponse({ account: result.account }, 201, {}, [result.sessionCookieHeader])
  }
  if (method === "POST" && path === "/api/auth/reviewer/login") {
    const { data } = try readParsedBody(request)
    const result = try signInReviewerPassword({
      usernameOrId: try reqStr(data, "username", "usernameOrId", "username", "identifier"),
      password: try reqStr(data, "password", "password"),
      ipAddress: clientIp(request),
      config: config.auth
    })
    return jsonResponse({ account: result.account }, 200, {}, [result.sessionCookieHeader])
  }
  if (method === "POST" && path === "/api/auth/logout") {
    const session = try optionalSession(request, config)
    if (session !== null) {
      try revokeSession(session.sessionKey)
    }
    return jsonResponse({ ok: true }, 200, {}, clearCookieHeaders(config.publicAppUrl))
  }
  if (method === "POST" && path === "/api/auth/signout-everywhere") {
    const session = try requireSession(request, config)
    const res = try signOutEverywhere(session.accountId)
    return jsonResponse({ ok: true, ...res }, 200, {}, clearCookieHeaders(config.publicAppUrl))
  }
  if (method === "POST" && path === "/api/auth/account/delete") {
    const session = try requireSession(request, config)
    const res = try deleteAccountSelfServe({
      accountId: session.accountId,
      authAt: session.authAt,
      cookieHeader: request.headers.get("cookie") ?? undefined,
      config: config.auth
    })
    return jsonResponse(res, 200, {}, clearCookieHeaders(config.publicAppUrl))
  }
  if (method === "POST" && path === "/api/auth/mode") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const rawMode = try reqStr(data, "mode", "mode", "uiMode")
    if (rawMode !== "game" && rawMode !== "social") {
      return try badRequest("invalid_mode", "Mode must be game or social.")
    }
    const mode: PlayMode = rawMode
    return jsonResponse({ ok: true, ...(try setPlayMode(session.accountId, mode)) })
  }
  if (method === "POST" && (path === "/api/auth/phone/change/start" || path === "/api/auth/phone/link/start")) {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const res = try startPhoneLink({
      ...linkAuthContext(session, request, data, config),
      phoneE164: try reqStr(data, "newPhoneE164", "newPhoneE164", "phoneE164", "phone")
    })
    return jsonResponse({ challengeId: res.challengeId, last2: res.last2, expiresAt: res.expiresAt, resendAvailableAt: res.resendAvailableAt })
  }
  if (method === "POST" && (path === "/api/auth/phone/change/confirm" || path === "/api/auth/phone/link/confirm")) {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const res = try confirmPhoneChange({
      accountId: session.accountId,
      newPhoneE164: try reqStr(data, "newPhoneE164", "newPhoneE164", "phoneE164", "phone"),
      code: try reqStr(data, "code", "code"),
      config: config.auth
    })
    return jsonResponse({ account: res.account }, 200, {}, [res.sessionCookieHeader])
  }
  if (method === "POST" && path === "/api/auth/agent-grant/revoke") {
    const session = try requireSession(request, config)
    return jsonResponse(try revokeActiveAgentGrant(session.accountId))
  }
  if (method === "GET" && path === "/api/auth/dev/loopback-code") {
    if (config.auth.smsMode !== "loopback") {
      throw new AuthFailure({
        code: "loopback_disabled",
        message: "Loopback verification codes are only available when SMS_MODE=loopback.",
        status: 403
      })
    }
    const phone = url.searchParams.get("phone")?.trim() || url.searchParams.get("phoneE164")?.trim() || ""
    if (phone === "") return try badRequest("invalid_phone", "Query parameter phone is required.")
    const code = getLoopbackCode(phone, config.auth)
    if (code === undefined) return jsonResponse({ error: "not_found", code: "not_found", message: "No active loopback code." }, 404)
    return jsonResponse({ code })
  }
  return undefined
}

function resolveMode(session: SessionIdentity | null, url: URL): SocialPresentationMode {
  if (session !== null) return session.uiMode
  return url.searchParams.get("mode") === "social" ? "social" : "game"
}

// spec/app/navigation.md, "Surface visibility and delayed visitor banner derivation"; spec/social/moderation.md, "Story: Block, mute, follow, and report users or posts"
function canViewTraderActivity(
  profile: { readonly kind: string; readonly viewerBlockedBy: boolean; readonly viewerBlocks: boolean },
  mode: SocialPresentationMode
): boolean {
  return (profile.kind === "user" || profile.kind === "npc") && mode === "game" && !profile.viewerBlockedBy && !profile.viewerBlocks
}

effect function handlePostEngagement(
  request: Request,
  postId: string,
  action: string,
  config: AppServerConfig
): Response!(AuthFailure | SocialFailure | StoreFailure)!Store {
  const session = try requireSession(request, config)
  const method = request.method.toUpperCase()
  if (action === "like") {
    if (method === "POST") return jsonResponse(try likePost(session.accountId, postId))
    if (method === "DELETE") return jsonResponse(try unlikePost(session.accountId, postId))
  }
  if (action === "repost") {
    if (method === "POST") return jsonResponse(try repostPost(session.accountId, postId))
    if (method === "DELETE") return jsonResponse(try unrepostPost(session.accountId, postId))
  }
  return jsonResponse({ error: "method_not_allowed", code: "method_not_allowed", message: "Method not allowed." }, 405)
}

effect function handleAccountEdge(
  request: Request,
  handle: string,
  edge: string,
  config: AppServerConfig
): Response!(AuthFailure | SocialFailure | StoreFailure)!Store {
  const session = try requireSession(request, config)
  const method = request.method.toUpperCase()
  if (edge === "follow") {
    if (method === "POST") return jsonResponse(try followAccount(session.accountId, handle))
    if (method === "DELETE") return jsonResponse(try unfollowAccount(session.accountId, handle))
  }
  if (edge === "block") {
    if (method === "POST") return jsonResponse(try blockAccount(session.accountId, handle))
    if (method === "DELETE") return jsonResponse(try unblockAccount(session.accountId, handle))
  }
  if (edge === "mute") {
    if (method === "POST") return jsonResponse(try muteAccount(session.accountId, handle))
    if (method === "DELETE") return jsonResponse(try unmuteAccount(session.accountId, handle))
  }
  return jsonResponse({ error: "method_not_allowed", code: "method_not_allowed", message: "Method not allowed." }, 405)
}

effect function updateOwnAccountProfile(
  accountId: string,
  data: Readonly<Record<string, unknown>>
): UpdatedAccountProfile!(HttpRequestError | SocialFailure | StoreFailure)!Store {
  const hasDisplayName = Object.prototype.hasOwnProperty.call(data, "displayName")
  const hasBio = Object.prototype.hasOwnProperty.call(data, "bio")
  const hasAvatarUrl = Object.prototype.hasOwnProperty.call(data, "avatarUrl")
  const hasBannerUrl = Object.prototype.hasOwnProperty.call(data, "bannerUrl")
  if (!hasDisplayName && !hasBio && !hasAvatarUrl && !hasBannerUrl) {
    return try badRequest("invalid_input", "Provide displayName, bio, avatarUrl, or bannerUrl to update.")
  }
  let nextDisplayName: string | null = null
  if (hasDisplayName) {
    if (typeof data.displayName !== "string") {
      return try badRequest("invalid_display_name", "displayName must be a string.")
    }
    const trimmed = data.displayName.trim()
    if (trimmed.length < 1 || trimmed.length > 60) {
      return try badRequest("invalid_display_name", "displayName must be between 1 and 60 characters.")
    }
    nextDisplayName = trimmed
  }
  let nextBio: string | null = null
  if (hasBio) {
    if (typeof data.bio !== "string") {
      return try badRequest("invalid_bio", "bio must be a string.")
    }
    const trimmed = data.bio.trim()
    if (trimmed.length > 280) {
      return try badRequest("invalid_bio", "bio must be at most 280 characters.")
    }
    nextBio = trimmed
  }
  let nextAvatarUrl: string | null | undefined = undefined
  if (hasAvatarUrl) {
    if (data.avatarUrl !== null && typeof data.avatarUrl !== "string") {
      return try badRequest("invalid_avatar_url", "avatarUrl must be a string or null.")
    }
    const trimmed = typeof data.avatarUrl === "string" ? data.avatarUrl.trim() : ""
    if (trimmed.length > 500) {
      return try badRequest("invalid_avatar_url", "avatarUrl must be at most 500 characters.")
    }
    nextAvatarUrl = trimmed === "" ? null : try validateProfileImageUrl(trimmed, "avatarUrl")
  }
  let nextBannerUrl: string | null | undefined = undefined
  if (hasBannerUrl) {
    if (data.bannerUrl !== null && typeof data.bannerUrl !== "string") {
      return try badRequest("invalid_banner_url", "bannerUrl must be a string or null.")
    }
    const trimmed = typeof data.bannerUrl === "string" ? data.bannerUrl.trim() : ""
    if (trimmed.length > 500) {
      return try badRequest("invalid_banner_url", "bannerUrl must be at most 500 characters.")
    }
    nextBannerUrl = trimmed === "" ? null : try validateProfileImageUrl(trimmed, "bannerUrl")
  }
  const profile = try updateProfile(accountId, {
    displayName: nextDisplayName ?? undefined,
    bio: nextBio ?? undefined,
    avatarUrl: nextAvatarUrl,
    bannerUrl: nextBannerUrl
  })
  if (profile === undefined) return try badRequest("not_found", "Account profile not found.", 404)
  return profile
}

function parseFeedPostFilter(raw: string | null): FeedPostFilter | undefined {
  if (raw === "posts" || raw === "replies" || raw === "all") return raw
  return undefined
}

function parseBoolQuery(raw: string | null): boolean | undefined {
  if (raw === "true") return true
  if (raw === "false") return false
  return undefined
}

function parseReportCategory(raw: string | undefined): ReportCategory | undefined {
  const normalized = raw?.trim().toLowerCase()
  if (normalized === undefined || normalized === "") return undefined
  if (normalized === "spam") return "Spam"
  if (normalized === "harassment") return "Harassment"
  if (normalized === "impersonation") return "Impersonation"
  if (normalized === "other" || normalized === "otherviolation" || normalized === "other_violation") return "OtherViolation"
  return undefined
}

function escapeSqlLike(input: string): string {
  return input.replace(/[\\%_]/g, (ch) => `\\${ch}`)
}

effect function handleWorldStatusAndUserSearch(
  request: Request,
  url: URL,
  config: AppServerConfig
): (Response | undefined)!StoreFailure!Store {
  const path = url.pathname
  if (path === "/api/world/status") {
    const store = try Store
    const now = try Clock.currentTimeMillis
    const status = try store.transaction(effect (tx: Tx) => {
      const worldRows = try tx.query(
        "SELECT current_day, current_hour, phase, game_running, last_tick_at FROM feed_world_state WHERE singleton = true LIMIT 1"
      )
      const countsRows = try tx.query(
        `SELECT
           (SELECT COUNT(*) FROM feed_prediction_markets WHERE status = 'open' AND expires_at > $1)
             + (SELECT COUNT(*) FROM feed_perp_markets) AS active_markets_count,
           (SELECT COUNT(*) FROM feed_posts WHERE deleted_at IS NULL) AS total_posts_count,
           (SELECT COUNT(*) FROM feed_actors WHERE id NOT LIKE 'test-%' AND id NOT LIKE 'org-%') AS active_actors_count`,
        [now]
      )
      const [world] = worldRows
      const [counts] = countsRows
      return {
        currentDay: Math.max(1, toInt(world?.current_day) || 1),
        currentHour: Math.max(0, toInt(world?.current_hour)),
        phase: toText(world?.phase) ?? "active",
        gameRunning: world?.game_running !== false,
        lastTickAt: Math.max(0, toInt(world?.last_tick_at)),
        activeMarketsCount: Math.max(0, toInt(counts?.active_markets_count)),
        totalPostsCount: Math.max(0, toInt(counts?.total_posts_count)),
        activeActorsCount: Math.max(0, toInt(counts?.active_actors_count))
      }
    })
    return jsonResponse(status)
  }
  if (path === "/api/users/search") {
    const q = (url.searchParams.get("q") ?? "").trim().replace(/^@/, "")
    const limit = clampIntQuery(url, "limit", 20, 1, 50)
    if (q === "") return jsonResponse({ items: [], users: [] })
    const like = `%${escapeSqlLike(q)}%`
    const prefix = `${escapeSqlLike(q)}%`
    const session = try optionalSession(request, config)
    const viewerId = session?.accountId
    const store = try Store
    const items = try store.transaction(effect (tx: Tx) => {
      const searchParams = viewerId === undefined ? [like, prefix, limit] : [like, prefix, viewerId, limit]
      const limitParam = viewerId === undefined ? "$3" : "$4"
      const accountVisibility = viewerId === undefined ? "" : ` AND ${viewerAuthorVisibilitySql("$3", "fa.account_id")}`
      const actorVisibility = viewerId === undefined ? "" : ` AND ${viewerAuthorVisibilitySql("$3", "id")}`
      const accountRows = try tx.query(
        `SELECT fa.account_id AS id, fa.handle, fa.display_name, fa.avatar_url
         FROM feed_accounts fa
         LEFT JOIN accounts a ON a.key = fa.account_id
         WHERE fa.is_reviewer = false
           AND (a.key IS NULL OR a.status = 'active')
           AND (fa.handle ILIKE $1 ESCAPE '\\' OR fa.display_name ILIKE $1 ESCAPE '\\')${accountVisibility}
         ORDER BY CASE WHEN fa.handle ILIKE $2 ESCAPE '\\' THEN 0 ELSE 1 END, fa.handle ASC
         LIMIT ${limitParam}`,
        searchParams
      )
      const actorRows = try tx.query(
        `SELECT id, username AS handle, name AS display_name, profile_image_url AS avatar_url
         FROM feed_actors
         WHERE id NOT LIKE 'test-%'
           AND id NOT LIKE 'org-%'
           AND (username ILIKE $1 ESCAPE '\\' OR name ILIKE $1 ESCAPE '\\')${actorVisibility}
         ORDER BY CASE WHEN username ILIKE $2 ESCAPE '\\' THEN 0 ELSE 1 END, name ASC
         LIMIT ${limitParam}`,
        searchParams
      )
      const users = accountRows.map((row) => ({
        id: toText(row.id) ?? "",
        handle: toText(row.handle) ?? "",
        displayName: toText(row.display_name) ?? "",
        avatarUrl: toText(row.avatar_url) ?? null,
        kind: "user" as const,
        isNpc: false
      }))
      const actors = actorRows.map((row) => {
        const id = toText(row.id) ?? ""
        return {
          id,
          handle: toText(row.handle) ?? id,
          displayName: toText(row.display_name) ?? id,
          avatarUrl: toText(row.avatar_url) ?? (id !== "" ? resolveActorAvatarUrl(id) : null),
          kind: "npc" as const,
          isNpc: true
        }
      })
      return [...users, ...actors].slice(0, limit)
    })
    return jsonResponse({ items, users: items })
  }
  return undefined
}

effect function handleSocialPostsAndUsers(
  request: Request,
  url: URL,
  config: AppServerConfig
): (Response | undefined)!(AuthFailure | RateLimited | MarketFailure | SocialFailure | StoreFailure | HttpRequestError)!Store {
  const path = url.pathname
  const method = request.method.toUpperCase()
  if (method === "GET") {
    const worldOrSearch = try handleWorldStatusAndUserSearch(request, url, config)
    if (worldOrSearch !== undefined) return worldOrSearch
  }
  if (method === "GET" && (path === "/api/feed" || path === "/api/posts")) {
    const session = try optionalSession(request, config)
    const rawTab = url.searchParams.get("tab") ?? "latest"
    const tab: FeedTab = rawTab === "following"
      ? "following"
      : rawTab === "top" || rawTab === "for_you"
        ? "top"
        : "latest"
    return jsonResponse(try listFeedPosts({
      tab,
      viewerId: session?.accountId,
      mode: resolveMode(session, url),
      cursor: url.searchParams.get("cursor") ?? undefined,
      limit: clampIntQuery(url, "limit", 25, 1, 100),
      authorId: url.searchParams.get("authorId") ?? undefined,
      authorHandle: url.searchParams.get("authorHandle") ?? undefined,
      ticker: url.searchParams.get("ticker") ?? undefined,
      marketId: url.searchParams.get("marketId") ?? undefined,
      filter: parseFeedPostFilter(url.searchParams.get("filter")),
      onlyReplies: parseBoolQuery(url.searchParams.get("onlyReplies")),
      includeReplies: parseBoolQuery(url.searchParams.get("includeReplies"))
    }))
  }
  if (method === "POST" && path === "/api/posts") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const post = try createPost({
      authorId: session.accountId,
      authorKind: "user",
      content: try reqStr(data, "content", "content"),
      replyToPostId: strField(data, "replyToPostId", "reply_to_post_id"),
      quotePostId: strField(data, "quotePostId", "quote_post_id"),
      marketId: strField(data, "marketId", "market_id"),
      ticker: strField(data, "ticker")
    })
    return jsonResponse(post, 201)
  }
  const postEngMatch = /^\/api\/posts\/([^/]+)\/(like|repost)$/.exec(path)
  if (postEngMatch !== null) {
    return try handlePostEngagement(request, decodeSegment(postEngMatch[1] ?? ""), postEngMatch[2] ?? "", config)
  }
  const postMatch = /^\/api\/posts\/([^/]+)$/.exec(path)
  if (postMatch !== null) {
    const postId = decodeSegment(postMatch[1] ?? "")
    if (method === "GET") {
      const session = try optionalSession(request, config)
      const rawSort = url.searchParams.get("sort")
      const sort: PostThreadSort | undefined = rawSort === "popular" || rawSort === "newest" || rawSort === "oldest" ? rawSort : undefined
      return jsonResponse(try getPostThread(postId, session?.accountId, resolveMode(session, url), sort))
    }
    if (method === "DELETE") {
      const session = try requireSession(request, config)
      return jsonResponse(try deletePost(session.accountId, postId))
    }
  }
  if (method === "GET" && path === "/api/explore") {
    const session = try optionalSession(request, config)
    const mode = resolveMode(session, url)
    const q = url.searchParams.get("q")?.trim() ?? ""
    const trending = try listTrending(15, mode, session?.accountId)
    const articles = try listArticles(15, mode)
    const search = q === ""
      ? { posts: [], accounts: [], actors: [], organizations: [], tags: [] }
      : try searchWorld({ query: q, mode, viewerId: session?.accountId, limit: 20 })
    return jsonResponse({ trending, articles, search })
  }
  if (method === "GET" && path === "/api/articles") {
    const session = try optionalSession(request, config)
    return jsonResponse({ articles: try listArticles(clampIntQuery(url, "limit", 20, 1, 100), resolveMode(session, url)) })
  }
  const articleMatch = /^\/api\/articles\/([^/]+)$/.exec(path)
  if (method === "GET" && articleMatch !== null) {
    const session = try optionalSession(request, config)
    return jsonResponse(try getArticle(decodeSegment(articleMatch[1] ?? ""), resolveMode(session, url)))
  }
  if (method === "GET" && path === "/api/trending") {
    const session = try optionalSession(request, config)
    return jsonResponse({ trending: try listTrending(clampIntQuery(url, "limit", 15, 1, 50), resolveMode(session, url), session?.accountId) })
  }
  const trendingTagMatch = /^\/api\/trending\/([^/]+)$/.exec(path)
  if (method === "GET" && trendingTagMatch !== null) {
    const session = try optionalSession(request, config)
    const mode = resolveMode(session, url)
    const rawTag = decodeSegment(trendingTagMatch[1] ?? "").trim()
    const posts = try listPostsByTag({
      tag: rawTag,
      mode,
      viewerId: session?.accountId,
      limit: clampIntQuery(url, "limit", 30, 1, 50)
    })
    return jsonResponse({ tag: rawTag, posts })
  }
  const userLikesMatch = /^\/api\/users\/([^/]+)\/likes$/.exec(path)
  if (method === "GET" && userLikesMatch !== null) {
    const session = try optionalSession(request, config)
    const mode = resolveMode(session, url)
    const handle = decodeSegment(userLikesMatch[1] ?? "")
    const liked = try listUserLikedPosts({
      handleOrId: handle,
      viewerId: session?.accountId,
      mode,
      cursor: url.searchParams.get("cursor") ?? undefined,
      limit: clampIntQuery(url, "limit", 30, 1, 100)
    })
    return jsonResponse({ posts: liked.items, nextCursor: liked.nextCursor })
  }
  const userTradesMatch = /^\/api\/users\/([^/]+)\/trades$/.exec(path)
  if (method === "GET" && userTradesMatch !== null) {
    const session = try optionalSession(request, config)
    const mode = resolveMode(session, url)
    const handle = decodeSegment(userTradesMatch[1] ?? "")
    const profile = try getProfile(handle, session?.accountId, mode)
    const trades = canViewTraderActivity(profile, mode)
      ? try listUserTrades({ handleOrId: profile.id, limit: clampIntQuery(url, "limit", 50, 1, 200) })
      : []
    return jsonResponse({ trades })
  }
  const userFollowListMatch = /^\/api\/users\/([^/]+)\/(followers|following)$/.exec(path)
  if (method === "GET" && userFollowListMatch !== null) {
    const session = try optionalSession(request, config)
    const handle = decodeSegment(userFollowListMatch[1] ?? "")
    const kind = userFollowListMatch[2]
    const limit = clampIntQuery(url, "limit", 50, 1, 100)
    return jsonResponse({
      items: kind === "followers"
        ? try listFollowers(handle, session?.accountId, limit)
        : try listFollowing(handle, session?.accountId, limit)
    })
  }
  const userEdgeMatch = /^\/api\/users\/([^/]+)\/(follow|block|mute)$/.exec(path)
  if (userEdgeMatch !== null) {
    return try handleAccountEdge(request, decodeSegment(userEdgeMatch[1] ?? ""), userEdgeMatch[2] ?? "", config)
  }
  if (method === "GET" && (path === "/api/users/me/blocked" || path === "/api/moderation/blocks")) {
    const session = try requireSession(request, config)
    return jsonResponse({ items: try listBlockedAccounts(session.accountId, clampIntQuery(url, "limit", 50, 1, 200)) })
  }
  if (method === "GET" && (path === "/api/users/me/muted" || path === "/api/moderation/mutes")) {
    const session = try requireSession(request, config)
    return jsonResponse({ items: try listMutedAccounts(session.accountId, clampIntQuery(url, "limit", 50, 1, 200)) })
  }
  if (method === "GET" && path === "/api/users/me") {
    const session = try requireSession(request, config)
    const mode = session.uiMode
    const profile = try getProfile(session.handle, session.accountId, mode)
    const feed = try listFeedPosts(profileFeedQuery(profile.id, session.accountId, mode, url))
    const positions = mode === "game"
      ? try getUserPositions(profile.id)
      : { accountId: profile.id, predictionPositions: [], perpPositions: [] }
    return jsonResponse({ profile, posts: feed.items, nextCursor: feed.nextCursor, positions })
  }
  if (method === "PATCH" && path === "/api/users/me") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    return jsonResponse(try updateOwnAccountProfile(session.accountId, data))
  }
  const userMatch = /^\/api\/users\/([^/]+)$/.exec(path)
  if (method === "GET" && userMatch !== null) {
    const session = try optionalSession(request, config)
    const mode = resolveMode(session, url)
    const handle = decodeSegment(userMatch[1] ?? "")
    const profile = try getProfile(handle, session?.accountId, mode)
    const feed = try listFeedPosts(profileFeedQuery(profile.id, session?.accountId, mode, url))
    const positions = canViewTraderActivity(profile, mode)
      ? try getUserPositions(profile.id)
      : { accountId: profile.id, predictionPositions: [], perpPositions: [] }
    return jsonResponse({ profile, posts: feed.items, nextCursor: feed.nextCursor, positions })
  }
  if (method === "POST" && path === "/api/reports") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const rawKind = try reqStr(data, "targetKind", "targetKind", "target_kind")
    if (rawKind !== "account" && rawKind !== "post") {
      return try badRequest("invalid_target_kind", "targetKind must be account or post.")
    }
    const category = parseReportCategory(strField(data, "category"))
    return jsonResponse(try reportTarget({
      reporterId: session.accountId,
      targetKind: rawKind,
      targetId: try reqStr(data, "targetId", "targetId", "target_id"),
      reason: try reqStr(data, "reason", "reason"),
      ...(category === undefined ? {} : { category })
    }), 201)
  }
  return undefined
}

effect function handleSocialChatsAndNotifications(
  request: Request,
  url: URL,
  config: AppServerConfig,
  realtimeStore?: Store.Shape
): (Response | undefined)!(AuthFailure | RateLimited | SocialFailure | StoreFailure | HttpRequestError)!(Store | RealtimeBus) {
  const path = url.pathname
  const method = request.method.toUpperCase()
  if (method === "GET" && path === "/api/events") {
    const session = try optionalSession(request, config)
    return try createSseResponse({
      signal: request.signal,
      keepalive: true,
      viewerAccountId: session?.accountId ?? null,
      ...(realtimeStore !== undefined ? { store: realtimeStore } : {})
    })
  }
  if (method === "GET" && path === "/api/notifications") {
    const session = try requireSession(request, config)
    const mode = session.uiMode
    const notifications = try listNotifications(session.accountId, clampIntQuery(url, "limit", 50, 1, 100), mode)
    const unreadCount = try getUnreadNotificationCount(session.accountId, mode)
    return jsonResponse({ notifications, unreadCount })
  }
  if (method === "DELETE" && path === "/api/notifications") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    return jsonResponse(try clearNotifications(session.accountId, strArrayField(data, "notificationIds", "ids"), session.uiMode))
  }
  if (method === "POST" && path === "/api/notifications/read") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    return jsonResponse(try markNotificationsRead(session.accountId, strArrayField(data, "notificationIds", "ids"), session.uiMode))
  }
  if (method === "GET" && path === "/api/chats") {
    const session = try requireSession(request, config)
    return jsonResponse({ chats: try listChats(session.accountId) })
  }
  if (method === "GET" && (path === "/api/chats/invites" || path === "/api/chats/alpha-invites")) {
    const session = try requireSession(request, config)
    const rawKind = url.searchParams.get("kind")
    const kind: GroupInviteFilterKind = path === "/api/chats/alpha-invites"
      ? "npc_alpha"
      : rawKind === "npc_alpha" || rawKind === "user_group" ? rawKind : "all"
    return jsonResponse({ invites: try listPendingGroupInvites(session.accountId, kind) })
  }
  const inviteRespondMatch = /^\/api\/chats\/(?:alpha-)?invites\/([^/]+)\/respond$/.exec(path)
  if (method === "POST" && inviteRespondMatch !== null) {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    return jsonResponse(try respondGroupInvite({
      accountId: session.accountId,
      inviteId: decodeSegment(inviteRespondMatch[1] ?? ""),
      accept: boolField(data, true, "accept")
    }))
  }
  if (method === "POST" && path === "/api/chats/direct") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const target = try reqStr(data, "targetHandleOrId", "targetHandleOrId", "recipientHandleOrId", "handle")
    return jsonResponse({ chat: try createDirectChat(session.accountId, target) }, 201)
  }
  if (method === "POST" && path === "/api/chats/group") {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const title = try reqStr(data, "title", "title", "name")
    const memberHandles = strArrayField(data, "memberHandles", "members") ?? []
    return jsonResponse({
      chat: try createUserGroupChat(session.accountId, title, memberHandles, strField(data, "kind"))
    }, 201)
  }
  const chatReactionMatch = /^\/api\/chats\/([^/]+)\/messages\/([^/]+)\/reactions$/.exec(path)
  const legacyReactMatch = /^\/api\/chats\/messages\/([^/]+)\/react$/.exec(path)
  const reactionChatId = chatReactionMatch !== null ? decodeSegment(chatReactionMatch[1] ?? "") : undefined
  const reactionMessageId = chatReactionMatch !== null
    ? decodeSegment(chatReactionMatch[2] ?? "")
    : legacyReactMatch !== null
      ? decodeSegment(legacyReactMatch[1] ?? "")
      : undefined
  if (reactionMessageId !== undefined) {
    const session = try requireSession(request, config)
    if (method === "POST") {
      const { data } = try readParsedBody(request)
      return jsonResponse(try reactToMessage({
        accountId: session.accountId,
        ...(reactionChatId !== undefined ? { chatId: reactionChatId } : {}),
        messageId: reactionMessageId,
        emoji: try reqStr(data, "emoji", "emoji")
      }))
    }
    if (method === "DELETE") {
      const { data } = try readParsedBody(request)
      const emoji = (strField(data, "emoji") ?? url.searchParams.get("emoji") ?? "").trim()
      if (emoji === "") {
        return try badRequest("invalid_input", "emoji is required.")
      }
      return jsonResponse(try unreactToMessage({
        accountId: session.accountId,
        ...(reactionChatId !== undefined ? { chatId: reactionChatId } : {}),
        messageId: reactionMessageId,
        emoji
      }))
    }
  }
  const chatMsgsMatch = /^\/api\/chats\/([^/]+)\/messages$/.exec(path)
  if (chatMsgsMatch !== null) {
    const session = try requireSession(request, config)
    const chatId = decodeSegment(chatMsgsMatch[1] ?? "")
    if (method === "GET") {
      return jsonResponse({ messages: try getChatMessages(session.accountId, chatId, clampIntQuery(url, "limit", 60, 1, 200)) })
    }
    if (method === "POST") {
      const { data } = try readParsedBody(request)
      return jsonResponse(try sendChatMessage({
        senderId: session.accountId,
        senderKind: "user",
        chatId,
        content: try reqStr(data, "content", "content")
      }), 201)
    }
  }
  const chatMemberMatch = /^\/api\/chats\/([^/]+)\/members\/([^/]+)$/.exec(path)
  if (method === "DELETE" && chatMemberMatch !== null) {
    const session = try requireSession(request, config)
    return jsonResponse(try removeGroupMember(
      session.accountId,
      decodeSegment(chatMemberMatch[1] ?? ""),
      decodeSegment(chatMemberMatch[2] ?? "")
    ))
  }
  const chatTransferMatch = /^\/api\/chats\/([^/]+)\/transfer$/.exec(path)
  if (method === "POST" && chatTransferMatch !== null) {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const newOwner = try reqStr(data, "newOwnerHandleOrId", "newOwnerHandleOrId", "targetHandleOrId", "handle")
    return jsonResponse({
      chat: try transferGroupOwnership(session.accountId, decodeSegment(chatTransferMatch[1] ?? ""), newOwner)
    })
  }
  const chatInviteMatch = /^\/api\/chats\/([^/]+)\/invite$/.exec(path)
  if (method === "POST" && chatInviteMatch !== null) {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    return jsonResponse(try inviteToUserGroupChat({
      accountId: session.accountId,
      chatId: decodeSegment(chatInviteMatch[1] ?? ""),
      targetHandleOrId: try reqStr(data, "targetHandleOrId", "targetHandleOrId", "handle")
    }))
  }
  const chatReadMatch = /^\/api\/chats\/([^/]+)\/read$/.exec(path)
  if (method === "POST" && chatReadMatch !== null) {
    const session = try requireSession(request, config)
    return jsonResponse(try markChatRead(session.accountId, decodeSegment(chatReadMatch[1] ?? "")))
  }
  const chatLeaveMatch = /^\/api\/chats\/([^/]+)\/leave$/.exec(path)
  if (method === "POST" && chatLeaveMatch !== null) {
    const session = try requireSession(request, config)
    return jsonResponse(try leaveGroupChat(session.accountId, decodeSegment(chatLeaveMatch[1] ?? "")))
  }
  const chatIdMatch = /^\/api\/chats\/([^/]+)$/.exec(path)
  if (chatIdMatch !== null) {
    const chatId = decodeSegment(chatIdMatch[1] ?? "")
    if (method === "GET") {
      const session = try requireSession(request, config)
      return jsonResponse({ chat: try getChat(session.accountId, chatId) })
    }
    if (method === "PATCH") {
      const session = try requireSession(request, config)
      const { data } = try readParsedBody(request)
      const title = try reqStr(data, "title", "title", "name")
      const updated = try renameGroupChat(session.accountId, chatId, title)
      return jsonResponse({ chat: updated, chatId: updated.id, title: updated.title, name: updated.title })
    }
    if (method === "DELETE") {
      const session = try requireSession(request, config)
      return jsonResponse(try deleteGroupChat(session.accountId, chatId))
    }
  }
  return undefined
}

function parseLeaderboardScope(raw: string | null): LeaderboardScope {
  return raw === "characters" ? "characters" : "players"
}

function parseLeaderboardMetric(raw: string | null): LeaderboardMetric {
  if (raw === "return_pct" || raw === "win_rate" || raw === "volume") return raw
  return "net_profit"
}

function parseLeaderboardPageSize(url: URL): number {
  if (url.searchParams.has("pageSize")) {
    return clampIntQuery(url, "pageSize", 50, 1, 200)
  }
  return clampIntQuery(url, "limit", 50, 1, 200)
}

type MarketRouteOutcome = (Response | undefined)!(AuthFailure | RateLimited | MarketFailure | StoreFailure | HttpRequestError)!(Store | RealtimeBus)

function formatPriceHistoryResponse(view: {
  readonly range: string
  readonly points: ReadonlyArray<{ readonly timestamp: number }>
}): Response {
  const points = view.points.map((pt) => ({ ...pt, recordedAt: pt.timestamp }))
  return jsonResponse({ range: view.range, points, history: points })
}

// spec/app/navigation.md, "Surface visibility and delayed visitor banner derivation"; spec/social/moderation.md, "Story: Block, mute, follow, and report users or posts"
effect function respondAssetTrades(
  marketKind: "prediction" | "perp",
  marketRef: string,
  request: Request,
  url: URL,
  config: AppServerConfig
): Response!(AuthFailure | MarketFailure | StoreFailure)!Store {
  const session = try optionalSession(request, config)
  const trades = try listAssetTrades({
    marketKind,
    marketRef,
    viewerId: session?.accountId,
    limit: clampIntQuery(url, "limit", 50, 1, 200)
  })
  const visible = resolveMode(session, url) === "game" ? trades : []
  return jsonResponse({ trades: visible.map((t) => ({ ...t, traderDisplayName: t.traderName })) })
}

function readHistoryQuery(url: URL) {
  return {
    range: parseHistoryRange(url.searchParams.get("range")),
    limit: clampIntQuery(url, "limit", 200, 2, 500)
  }
}

effect function parsePerpOrderParams(
  data: Record<string, unknown>
): { readonly side: "long" | "short"; readonly collateralCents: number; readonly leverage: number; readonly mode?: PerpOrderMode }!HttpRequestError {
  const rawSide = (try reqStr(data, "side", "side")).toLowerCase()
  if (rawSide !== "long" && rawSide !== "short") {
    return try badRequest("invalid_side", "Side must be long or short.")
  }
  const collateralCents = numField(data, "collateralCents", "collateral_cents") ?? Math.round((numField(data, "collateralPts") ?? 0) * 100)
  const leverage = numField(data, "leverage") ?? 1
  const rawMode = strField(data, "mode")?.trim().toLowerCase()
  let mode: PerpOrderMode | undefined = undefined
  if (rawMode !== undefined && rawMode !== "") {
    if (rawMode !== "open" && rawMode !== "add" && rawMode !== "reduce" && rawMode !== "flip") {
      return try badRequest("invalid_mode", "Perp order mode must be open, add, reduce, or flip.")
    }
    mode = rawMode
  }
  return {
    side: rawSide,
    collateralCents: Math.round(collateralCents),
    leverage,
    ...(mode !== undefined ? { mode } : {})
  }
}

function readLeaderboardFilterParams(url: URL) {
  if (!url.searchParams.has("filter") && !url.searchParams.has("timeframe")) return null
  return {
    filter: parseLeaderboardFilter(url.searchParams.get("filter")),
    timeframe: parseLeaderboardTimeframe(url.searchParams.get("timeframe"))
  }
}

effect function handlePredictionMarketRoute(
  request: Request,
  url: URL,
  config: AppServerConfig
): MarketRouteOutcome {
  const path = url.pathname
  const method = request.method.toUpperCase()
  const predHistoryMatch = /^\/api\/markets\/predictions?\/([^/]+)\/history$/.exec(path)
  if (method === "GET" && predHistoryMatch !== null) {
    const marketId = decodeSegment(predHistoryMatch[1] ?? "")
    return formatPriceHistoryResponse(try getPredictionPriceHistory({ marketId, ...readHistoryQuery(url) }))
  }
  const predTradesMatch = /^\/api\/markets\/predictions?\/([^/]+)\/trades$/.exec(path)
  if (method === "GET" && predTradesMatch !== null) {
    return try respondAssetTrades("prediction", decodeSegment(predTradesMatch[1] ?? ""), request, url, config)
  }
  const predPreviewMatch = /^\/api\/markets\/predictions?\/([^/]+)\/preview$/.exec(path)
  if (method === "POST" && predPreviewMatch !== null) {
    const session = try optionalSession(request, config)
    const marketId = decodeSegment(predPreviewMatch[1] ?? "")
    const { data } = try readParsedBody(request)
    const rawSide = (try reqStr(data, "side", "side")).toLowerCase()
    if (rawSide !== "yes" && rawSide !== "no") return try badRequest("invalid_side", "Side must be yes or no.")
    const rawAction = strField(data, "action")?.trim().toLowerCase()
    const rawShares = numField(data, "shareUnits", "share_units", "shares")
    const rawAmount = numField(data, "amountCents", "amount_cents") ?? (numField(data, "amountPts") !== undefined ? Math.round((numField(data, "amountPts") ?? 0) * 100) : undefined)
    const isSell = rawAction === "sell" || (rawAction !== "buy" && rawShares !== undefined && rawAmount === undefined)
    if (rawAction !== "buy" && rawAction !== "sell" && rawShares !== undefined && rawAmount !== undefined) {
    return try badRequest("conflicting_amount", "Provide only one of shares/amountCents, or an explicit action.")
    }
    if (isSell) {
      const preview = try previewPredictionSell({
        marketId,
        side: rawSide,
        shares: rawShares ?? 0,
        ...(session !== null ? { holderId: session.accountId } : {})
      })
      return jsonResponse({ preview })
    }
    const preview = try previewPredictionBuy({
      marketId,
      side: rawSide,
      amountCents: Math.round(rawAmount ?? 0)
    })
    return jsonResponse({ preview })
  }
  const predDetailMatch = /^\/api\/markets\/predictions?\/([^/]+)$/.exec(path)
  if (method === "GET" && predDetailMatch !== null) {
    return jsonResponse(try getPredictionMarket(decodeSegment(predDetailMatch[1] ?? "")))
  }
  const predTradeMatch = /^\/api\/markets\/predictions?\/([^/]+)\/(buy|sell)$/.exec(path)
  if (method === "POST" && predTradeMatch !== null) {
    const session = try requireSession(request, config)
    const marketId = decodeSegment(predTradeMatch[1] ?? "")
    const action = predTradeMatch[2]
    const { data } = try readParsedBody(request)
    const idempotencyKey = request.headers.get("idempotency-key") ?? strField(data, "idempotencyKey", "idempotency_key")
    const rawSide = (try reqStr(data, "side", "side")).toLowerCase()
    if (rawSide !== "yes" && rawSide !== "no") return try badRequest("invalid_side", "Side must be yes or no.")
    const amountCents = Math.round(numField(data, "amountCents", "amount_cents") ?? Math.round((numField(data, "amountPts") ?? 0) * 100))
    const sharesInput = numField(data, "shareUnits", "share_units", "shares") ?? 0
    try checkAndConsumeRateLimit({ accountId: session.accountId, action: "trade", surface: "web" })
    const receipt = action === "buy"
      ? try buyPredictionShares({
          actorId: session.accountId,
          actorKind: "user",
          marketId,
          side: rawSide,
          amountCents,
          ...(idempotencyKey === undefined ? {} : { idempotencyKey })
        })
      : try sellPredictionShares({
          actorId: session.accountId,
          actorKind: "user",
          marketId,
          side: rawSide,
          shares: sharesInput,
          ...(idempotencyKey === undefined ? {} : { idempotencyKey })
        })
    const { marketId: receiptMarketId, action: receiptAction, side: receiptSide, yesPriceBps, noPriceBps, shares, notionalCents } = receipt
    try publishFeedEvent({
      type: "market.prediction",
      marketId: receiptMarketId,
      action: receiptAction,
      side: receiptSide,
      yesPriceBps,
      noPriceBps,
      shares,
      notionalCents
    })
    return jsonResponse(receipt)
  }
  return undefined
}

effect function handleLeaderboardAndEconomyRoute(
  request: Request,
  url: URL,
  config: AppServerConfig
): (Response | undefined)!(AuthFailure | MarketFailure | StoreFailure)!Store {
  const path = url.pathname
  const method = request.method.toUpperCase()
  if (method === "GET" && path === "/api/leaderboard") {
    const session = try optionalSession(request, config)
    const page = clampIntQuery(url, "page", 1, 1, 10_000)
    const pageSize = parseLeaderboardPageSize(url)
    const metric = parseLeaderboardMetric(url.searchParams.get("metric"))
    const filterParams = readLeaderboardFilterParams(url)
    if (filterParams !== null) {
      const result = try getFilteredLeaderboardPage({
        ...filterParams,
        metric,
        page,
        pageSize,
        ...(session !== null ? { viewerAccountId: session.accountId } : {})
      })
      return jsonResponse({
        scope: filterParams.filter === "npcs" ? "characters" : "players",
        metric: result.metric,
        entries: result.entries,
        leaderboard: result.entries,
        page: result.pagination.page,
        pageSize: result.pagination.pageSize,
        totalCount: result.pagination.totalCount,
        totalPages: result.pagination.totalPages,
        pagination: result.pagination,
        generatedAt: result.generatedAt,
        currentUser: result.currentUser
      })
    }
    const scope = parseLeaderboardScope(url.searchParams.get("scope"))
    const leaderboardPage = try getLeaderboard({
      scope,
      metric,
      page,
      pageSize,
      ...(session !== null ? { viewerAccountId: session.accountId } : {})
    })
    return jsonResponse({
      ...leaderboardPage,
      leaderboard: leaderboardPage.entries,
      pagination: {
        page: leaderboardPage.page,
        pageSize: leaderboardPage.pageSize,
        totalCount: leaderboardPage.totalCount,
        totalPages: leaderboardPage.totalPages
      }
    })
  }
  if (method === "GET" && path === "/api/leaderboard/me") {
    const session = try requireSession(request, config)
    const pageSize = parseLeaderboardPageSize(url)
    const metric = parseLeaderboardMetric(url.searchParams.get("metric"))
    const filterParams = readLeaderboardFilterParams(url)
    if (filterParams !== null) {
      const viewerRank = try getFilteredLeaderboardViewerRank(session.accountId, { ...filterParams, metric, pageSize })
      return jsonResponse({ ...viewerRank, position: viewerRank })
    }
    const position = try getAccountLeaderboardRank(session.accountId, metric, pageSize)
    return jsonResponse({
      ...(position !== null
        ? {
            rank: position.entry.rank,
            page: position.page,
            totalCount: position.totalCount,
            totalPages: Math.max(1, Math.ceil(position.totalCount / pageSize)),
            entry: position.entry
          }
        : { rank: null }),
      position
    })
  }
  if (method === "GET" && path === "/api/economy/me/pnl-history") {
    const session = try requireSession(request, config)
    return jsonResponse(try getAccountPnlHistory({
      accountId: session.accountId,
      range: parseHistoryRange(url.searchParams.get("range")),
      limit: clampIntQuery(url, "limit", 200, 2, 500)
    }))
  }
  if (method === "GET" && path === "/api/economy/me") {
    const session = try requireSession(request, config)
    return jsonResponse({
      economy: try getAccountEconomy(session.accountId),
      ledger: try getPointLedger(session.accountId, clampIntQuery(url, "limit", 50, 1, 200))
    })
  }
  return undefined
}

effect function handleMarketRoute(
  request: Request,
  url: URL,
  config: AppServerConfig
): MarketRouteOutcome {
  const path = url.pathname
  const method = request.method.toUpperCase()
  if (method === "GET" && path === "/api/markets") {
    const session = try optionalSession(request, config)
    const predictions = try listPredictionMarkets()
    const perps = try listPerpMarkets()
    if (session === null) return jsonResponse({ predictions, perps })
    const positions = try getUserPositions(session.accountId)
    return jsonResponse({ predictions, perps, positions })
  }
  if (method === "GET" && path === "/api/markets/positions/closed") {
    const session = try requireSession(request, config)
    const limit = clampIntQuery(url, "limit", 50, 1, 200)
    const paged = try listClosedPositions({
      accountId: session.accountId,
      outcome: parseClosedOutcomeFilter(url.searchParams.get("outcome")),
      page: clampIntQuery(url, "page", 1, 1, 10_000),
      limit: Math.min(limit, 100)
    })
    const predictionPositions = paged.items
      .filter((item) => item.kind === "prediction")
      .map((item) => ({
        marketId: item.marketId ?? item.id,
        question: item.title,
        side: item.side,
        shares: item.sharesOrSize,
        costBasisCents: item.costBasisCents,
        payoutCents: item.payoutCents,
        realizedPnlCents: item.realizedPnlCents,
        settledAt: item.closedAt,
        status: item.status
      }))
    const perpPositions = paged.items
      .filter((item) => item.kind === "perp")
      .map((item) => ({
        id: item.id,
        ticker: item.ticker ?? "PERP",
        side: item.side,
        marginCents: item.costBasisCents,
        sizeCents: item.sharesOrSize,
        realizedPnlCents: item.realizedPnlCents,
        closedAt: item.closedAt,
        status: item.status
      }))
    return jsonResponse({
      ...paged,
      accountId: session.accountId,
      predictionPositions,
      perpPositions
    })
  }
  const predictionResponse = try handlePredictionMarketRoute(request, url, config)
  if (predictionResponse !== undefined) return predictionResponse
  if (method === "POST" && path === "/api/markets/perp/preview") {
    const session = try optionalSession(request, config)
    const { data } = try readParsedBody(request)
    const ticker = try reqStr(data, "ticker", "ticker")
    const order = try parsePerpOrderParams(data)
    const preview = try previewPerpOrder({
      ...(session !== null ? { ownerId: session.accountId } : {}),
      ticker,
      ...order
    })
    return jsonResponse({ preview })
  }
  const perpHistoryMatch = /^\/api\/markets\/perp\/([^/]+)\/history$/.exec(path)
  if (method === "GET" && perpHistoryMatch !== null) {
    const ticker = decodeSegment(perpHistoryMatch[1] ?? "")
    return formatPriceHistoryResponse(try getPerpPriceHistory({ ticker, ...readHistoryQuery(url) }))
  }
  const perpTradesMatch = /^\/api\/markets\/perp\/([^/]+)\/trades$/.exec(path)
  if (method === "GET" && perpTradesMatch !== null) {
    return try respondAssetTrades("perp", decodeSegment(perpTradesMatch[1] ?? ""), request, url, config)
  }
  const perpDetailMatch = /^\/api\/markets\/perp\/([^/]+)$/.exec(path)
  if (method === "GET" && perpDetailMatch !== null) {
    return jsonResponse(try getPerpMarket(decodeSegment(perpDetailMatch[1] ?? "")))
  }
  const perpOpenMatch = /^\/api\/markets\/perp\/([^/]+)\/open$/.exec(path)
  if (method === "POST" && perpOpenMatch !== null) {
    const session = try requireSession(request, config)
    const ticker = decodeSegment(perpOpenMatch[1] ?? "")
    const { data } = try readParsedBody(request)
    const idempotencyKey = request.headers.get("idempotency-key") ?? strField(data, "idempotencyKey", "idempotency_key")
    const order = try parsePerpOrderParams(data)
    const maxSlippageBps = numField(data, "maxSlippageBps", "max_slippage_bps")
    try checkAndConsumeRateLimit({ accountId: session.accountId, action: "trade", surface: "web" })
    const opened = try openPerpPosition({
      ownerId: session.accountId,
      ownerKind: "user",
      ticker,
      ...order,
      ...(maxSlippageBps === undefined ? {} : { maxSlippageBps: Math.round(maxSlippageBps) }),
      ...(idempotencyKey === undefined ? {} : { idempotencyKey })
    })
    try publishFeedEvent({
      type: "market.perp",
      action: opened.action,
      actorId: session.accountId,
      ticker: opened.position.ticker,
      side: opened.position.side,
      sizeCents: opened.sizeCents,
      leverage: opened.leverage,
      positionId: opened.positionId,
      markPriceCents: opened.position.markPriceCents
    })
    return jsonResponse({ ...opened, markPriceCents: opened.position.markPriceCents }, 201)
  }
  const perpCloseMatch = /^\/api\/markets\/perp\/positions\/([^/]+)\/close$/.exec(path)
  if (method === "POST" && perpCloseMatch !== null) {
    const session = try requireSession(request, config)
    const { data } = try readParsedBody(request)
    const idempotencyKey = request.headers.get("idempotency-key") ?? strField(data, "idempotencyKey", "idempotency_key")
    const rawSizePts = numField(data, "sizePts", "size_pts")
    const sizeCents = numField(data, "sizeCents", "size_cents") ?? (rawSizePts !== undefined ? Math.round(rawSizePts * 100) : undefined)
    const closePct = numField(data, "closePct", "close_pct")
    const maxSlippageBps = numField(data, "maxSlippageBps", "max_slippage_bps")
    try checkAndConsumeRateLimit({ accountId: session.accountId, action: "trade", surface: "web" })
    const closed = try closePerpPosition({
      ownerId: session.accountId,
      positionId: decodeSegment(perpCloseMatch[1] ?? ""),
      ...(sizeCents === undefined ? {} : { sizeCents: Math.round(sizeCents) }),
      ...(closePct === undefined ? {} : { closePct }),
      ...(maxSlippageBps === undefined ? {} : { maxSlippageBps: Math.round(maxSlippageBps) }),
      ...(idempotencyKey === undefined ? {} : { idempotencyKey })
    })
    const store = try Store
    const levRows = try store.transaction((tx: Tx) =>
      tx.query("SELECT leverage FROM feed_perp_positions WHERE id = $1 LIMIT 1", [closed.positionId])
    )
    const leverage = levRows[0] === undefined ? 1 : Math.max(1, toInt(levRows[0].leverage))
    try publishFeedEvent({
      type: "market.perp",
      action: "close",
      actorId: session.accountId,
      ticker: closed.ticker,
      side: closed.side,
      sizeCents: closed.sizeCents,
      leverage,
      positionId: closed.positionId,
      markPriceCents: closed.exitPriceCents
    })
    return jsonResponse({ ...closed, markPriceCents: closed.exitPriceCents })
  }
  return try handleLeaderboardAndEconomyRoute(request, url, config)
}

effect function dispatchCronJob(
  job: string
): unknown!(EngineFailure | StoreFailure | MarketFailure | SocialFailure)!(Store | RealtimeBus) {
  switch (job) {
    case "minute":
    case "minute-tick":
      return try runMinuteTick()
    case "game":
    case "game-tick":
      return try runGameTick()
    case "markets":
    case "markets-tick":
      return try runMarketsTick()
    case "recovery":
    case "markets-recovery":
      return try runMarketsRecovery()
    case "npc":
    case "npc-tick":
      return try runNpcTick()
    case "org":
    case "organization":
    case "organization-tick":
      return try runOrganizationTick()
    case "article":
    case "articles":
    case "article-tick":
      return try runArticleTick()
    case "funding":
    case "perp-funding":
    case "perp-funding-tick":
      return try runPerpFundingTick()
    case "world-facts":
    case "world-facts-tick":
      return try runWorldFactsTick()
    case "rss":
    case "rss-refresh":
    case "rss-refresh-tick":
      return try runRssRefreshTick()
    default:
      throw new EngineFailure({ code: "INVALID_ARGUMENT", message: `Unknown engine job: ${job}` })
  }
}

effect function authorizeCronRequest(
  request: Request,
  config: AppServerConfig
): void!(AuthFailure | StoreFailure)!Store {
  const bearerMatch = /^\s*Bearer\s+(.+)\s*$/i.exec(request.headers.get("authorization") ?? "")
  const headerSecret = request.headers.get("x-cron-secret")?.trim() ?? bearerMatch?.[1]?.trim() ?? ""
  if (config.cronSecret !== "" && constantTimeEquals(headerSecret, config.cronSecret)) {
    return
  }
  if (config.deploymentEnv === "localnet") {
    const session = try optionalSession(request, config)
    if (session?.isAdmin === true) return
  }
  throw new AuthFailure({ code: "unauthorized", message: "Valid CRON_SECRET bearer token required.", status: 401 })
}

effect function handleEngineAdminRoute(
  request: Request,
  url: URL,
  config: AppServerConfig
): (Response | undefined)!(AuthFailure | EngineFailure | MarketFailure | SocialFailure | StoreFailure | HttpRequestError)!(Store | RealtimeBus) {
  const path = url.pathname
  const method = request.method.toUpperCase()
  if (method === "GET" && path === "/api/admin/status") {
    try requireAdminSession(request, config)
    const status = try getEngineAdminStatus()
    const spend = try getDailySpendStatus()
    const store = try Store
    const extra = try store.transaction(effect (tx: Tx) => {
      const tickRows = try tx.query(
        "SELECT job_name, last_status, last_error, pending_count, duration_ms, last_success_at FROM feed_tick_health ORDER BY job_name ASC"
      )
      const holdRows = try tx.query(
        "SELECT id, question, timeframe, expires_at FROM feed_prediction_markets WHERE status = 'manual_hold' ORDER BY expires_at ASC LIMIT 50"
      )
      return {
        ticks: tickRows.map((row) => ({
          jobName: toText(row.job_name) ?? "",
          lastStatus: toText(row.last_status) ?? "unknown",
          lastError: toText(row.last_error) ?? null,
          pendingCount: toInt(row.pending_count),
          durationMs: toInt(row.duration_ms),
          lastSuccessAt: toInt(row.last_success_at)
        })),
        manualHolds: holdRows.map((row) => ({
          id: toText(row.id) ?? "",
          question: toText(row.question) ?? "",
          timeframe: toText(row.timeframe) ?? "1h",
          expiresAt: toInt(row.expires_at)
        }))
      }
    })
    return jsonResponse({
      ...status,
      worldState: {
        currentDay: status.currentDay,
        currentHour: status.currentHour,
        phase: status.phase,
        gameRunning: status.gameRunning
      },
      ticks: extra.ticks,
      spend,
      manualHolds: extra.manualHolds
    })
  }
  if (method === "POST" && path === "/api/admin/clock/fast-forward") {
    try requireAdminSession(request, config)
    const { data } = try readParsedBody(request)
    const hours = numField(data, "hours") ?? ((numField(data, "minutes") ?? 60) / 60)
    return jsonResponse(try fastForwardSimulatedHours(hours))
  }
  const adminCronMatch = /^\/api\/admin\/cron\/([^/]+)$/.exec(path)
  if (method === "POST" && adminCronMatch !== null) {
    try requireAdminSession(request, config)
    const job = decodeSegment(adminCronMatch[1] ?? "")
    return jsonResponse({ ok: true, job, result: try dispatchCronJob(job) })
  }
  const holdMatch = /^\/api\/admin\/holds\/([^/]+)\/(approve|override)$/.exec(path)
  if (method === "POST" && holdMatch !== null) {
    try requireAdminSession(request, config)
    const marketId = decodeSegment(holdMatch[1] ?? "")
    const action = holdMatch[2]
    const { data } = try readParsedBody(request)
    const rawOutcome = strField(data, "outcome")?.toLowerCase()
    const outcome = rawOutcome === "no" ? "no" : rawOutcome === "yes" ? "yes" : undefined
    if (action === "approve") {
      return jsonResponse(try approveManualHold(marketId, outcome))
    }
    if (outcome === undefined) return try badRequest("invalid_outcome", "Outcome must be yes or no.")
    const reason = try reqStr(data, "reason", "reason")
    return jsonResponse(try overrideManualHold(marketId, outcome, reason))
  }
  const adminMarketCancelMatch = /^\/api\/admin\/markets\/([^/]+)\/cancel$/.exec(path)
  if (method === "POST" && adminMarketCancelMatch !== null) {
    try requireAdminSession(request, config)
    const marketId = decodeSegment(adminMarketCancelMatch[1] ?? "")
    return jsonResponse(try cancelPredictionMarket(marketId))
  }
  if (method === "GET" && path === "/api/admin/reports") {
    try requireAdminSession(request, config)
    const rawStatus = url.searchParams.get("status")?.trim().toLowerCase()
    const status: ReportStatusFilter = rawStatus === "open" || rawStatus === "reviewed" || rawStatus === "dismissed"
      ? rawStatus
      : "all"
    const limit = clampIntQuery(url, "limit", 50, 1, 200)
    return jsonResponse({ reports: try listModerationReports({ status, limit }) })
  }
  const adminReportResolveMatch = /^\/api\/admin\/reports\/([^/]+)\/resolve$/.exec(path)
  if (method === "POST" && adminReportResolveMatch !== null) {
    try requireAdminSession(request, config)
    const reportId = decodeSegment(adminReportResolveMatch[1] ?? "")
    const { data } = try readParsedBody(request)
    const rawStatus = (try reqStr(data, "status", "status")).toLowerCase()
    const nextStatus = rawStatus === "resolved" || rawStatus === "reviewed"
      ? "reviewed"
      : rawStatus === "dismissed"
        ? "dismissed"
        : null
    if (nextStatus === null) {
      return try badRequest("invalid_status", "status must be reviewed or dismissed.")
    }
    return jsonResponse(try resolveModerationReport({ reportId, status: nextStatus }))
  }
  const adminReportPatchMatch = /^\/api\/admin\/reports\/([^/]+)$/.exec(path)
  if (method === "PATCH" && adminReportPatchMatch !== null) {
    try requireAdminSession(request, config)
    const reportId = decodeSegment(adminReportPatchMatch[1] ?? "")
    const { data } = try readParsedBody(request)
    const rawStatus = (try reqStr(data, "status", "status")).toLowerCase()
    if (rawStatus === "resolved" || rawStatus === "reviewed" || rawStatus === "dismissed") {
      const nextStatus = rawStatus === "dismissed" ? "dismissed" : "reviewed"
      return jsonResponse(try resolveModerationReport({ reportId, status: nextStatus }))
    }
    if (rawStatus !== "open") {
      return try badRequest("invalid_status", "Report status must be open, reviewed, resolved, or dismissed.")
    }
    const store = try Store
    const updated = store.transaction(effect (tx: Tx) => {
      const rows = try tx.query(
        "UPDATE feed_reports SET status = 'open' WHERE id = $1 RETURNING id, status",
        [reportId]
      )
      return rows[0]
    }) catch effect (err) => {
      if (err instanceof StoreFailure && isPgUniqueViolation(err.cause)) {
        return try badRequest("report_conflict", "Another open report already exists for this reporter and target.", 409)
      }
      throw err
    }
    if (updated === undefined) {
      return try badRequest("not_found", "Report not found.", 404)
    }
    return jsonResponse({ id: toText(updated.id) ?? reportId, status: toText(updated.status) ?? "open" })
  }
  if (method === "GET" && path === "/api/admin/users") {
    try requireAdminSession(request, config)
    const q = (url.searchParams.get("q") ?? "").trim()
    const limit = clampIntQuery(url, "limit", 50, 1, 200)
    const store = try Store
    const users = try store.transaction(effect (tx: Tx) => {
      const rows = q === ""
        ? try tx.query(
            `SELECT account_id, handle, display_name, avatar_url, ui_mode, balance_cents, starting_grant_cents, total_fees_paid_cents, is_admin, is_reviewer, phone_verified_at, email_masked, email_verified_at, created_at
             FROM feed_accounts
             ORDER BY created_at DESC
             LIMIT $1`,
            [limit]
          )
        : try tx.query(
            `SELECT account_id, handle, display_name, avatar_url, ui_mode, balance_cents, starting_grant_cents, total_fees_paid_cents, is_admin, is_reviewer, phone_verified_at, email_masked, email_verified_at, created_at
             FROM feed_accounts
             WHERE handle ILIKE $1 ESCAPE '\\' OR display_name ILIKE $1 ESCAPE '\\'
             ORDER BY created_at DESC
             LIMIT $2`,
            [`%${escapeSqlLike(q)}%`, limit]
          )
      return rows.map((row) => ({
        accountId: toText(row.account_id) ?? "",
        handle: toText(row.handle) ?? "",
        displayName: toText(row.display_name) ?? "",
        avatarUrl: toText(row.avatar_url) ?? null,
        uiMode: toText(row.ui_mode) === "social" ? "social" : "game",
        balanceCents: toInt(row.balance_cents),
        startingGrantCents: toInt(row.starting_grant_cents),
        totalFeesPaidCents: toInt(row.total_fees_paid_cents),
        isAdmin: row.is_admin === true,
        isReviewer: row.is_reviewer === true,
        phoneVerifiedAt: row.phone_verified_at === null ? null : toInt(row.phone_verified_at),
        emailMasked: toText(row.email_masked) ?? null,
        emailVerifiedAt: row.email_verified_at === null ? null : toInt(row.email_verified_at),
        createdAt: toInt(row.created_at)
      }))
    })
    return jsonResponse({ users })
  }
  if (method === "GET" && path === "/api/admin/world-facts") {
    try requireAdminSession(request, config)
    const limit = clampIntQuery(url, "limit", 100, 1, 200)
    const store = try Store
    const facts = try store.transaction(effect (tx: Tx) => {
      const rows = try tx.query(
        "SELECT id, fact_text, category, created_at FROM feed_world_facts ORDER BY created_at DESC LIMIT $1",
        [limit]
      )
      return rows.map((row) => ({
        id: toText(row.id) ?? "",
        factText: toText(row.fact_text) ?? "",
        category: toText(row.category) ?? "markets",
        createdAt: toInt(row.created_at)
      }))
    })
    return jsonResponse({ facts })
  }
  if (method === "POST" && path === "/api/admin/world-facts") {
    try requireAdminSession(request, config)
    const { data } = try readParsedBody(request)
    const factText = try reqStr(data, "factText", "factText", "fact_text", "text")
    const category = strField(data, "category")?.trim() || "markets"
    if (factText.length > 500) {
      return try badRequest("invalid_input", "factText must be at most 500 characters.")
    }
    const id = `fact-${randomUuid()}`
    const now = try Clock.currentTimeMillis
    const store = try Store
    try store.transaction((tx: Tx) =>
      tx.query(
        "INSERT INTO feed_world_facts (id, fact_text, category, created_at) VALUES ($1, $2, $3, $4)",
        [id, factText, category.slice(0, 60), now]
      )
    )
    return jsonResponse({ id, factText, category: category.slice(0, 60), createdAt: now }, 201)
  }
  const worldFactDeleteMatch = /^\/api\/admin\/world-facts\/([^/]+)$/.exec(path)
  if (method === "DELETE" && worldFactDeleteMatch !== null) {
    try requireAdminSession(request, config)
    const factId = decodeSegment(worldFactDeleteMatch[1] ?? "")
    const store = try Store
    const removed = try store.transaction((tx: Tx) =>
      tx.query("DELETE FROM feed_world_facts WHERE id = $1 RETURNING id", [factId])
    )
    if (removed.length === 0) {
      return try badRequest("not_found", "World fact not found.", 404)
    }
    return jsonResponse({ id: factId, deleted: true })
  }
  const cronMatch = /^\/api\/cron\/([^/]+)$/.exec(path)
  if (method === "POST" && cronMatch !== null) {
    try authorizeCronRequest(request, config)
    const job = decodeSegment(cronMatch[1] ?? "")
    return jsonResponse({ ok: true, job, result: try dispatchCronJob(job) })
  }
  return undefined
}

export interface RouteRequestOptions {
  readonly realtimeStore?: Store.Shape | undefined
}

effect function routeOptionalResponse(
  request: Request,
  config: AppServerConfig,
  options?: RouteRequestOptions
): (Response | undefined)!(
  AuthFailure
  | RateLimited
  | UnauthorizedError
  | MarketFailure
  | SocialFailure
  | EngineFailure
  | McpFailure
  | SkillDigestError
  | SkillPublishInvalid
  | StoreFailure
  | HttpRequestError
)!(Store | RealtimeBus) {
  const url = new URL(request.url)
  const origin = requestOrigin(request, config)
  const path = url.pathname
  const method = request.method.toUpperCase()

  if ((method === "GET" || method === "HEAD") && path === "/api/health") {
    const store = try Store
    try store.transaction((tx: Tx) => tx.query("SELECT 1 AS ok"))
    const payload = {
      ok: true,
      service: "feed",
      pack: manifest.id,
      version: manifest.version,
      deploymentEnv: config.deploymentEnv,
      smsMode: config.auth.smsMode,
      emailMode: resolveEmailMode(config.auth),
      gameStart: config.gameStart,
      ...(config.commitSha !== undefined ? { commit: config.commitSha } : {})
    }
    return method === "HEAD" ? makeResponse(null, { status: 200 }) : jsonResponse(payload)
  }

  const statelessResponse = try resolveStatelessPublicRoute(request, config)
  if (statelessResponse !== undefined) return statelessResponse

  if (path === "/mcp") {
    return try handleMcpRequest({ request, origin, authConfig: config.auth })
  }

  const oauthResponse = try handleOAuthRoute(request, url, origin, config)
  if (oauthResponse !== undefined) return oauthResponse

  const authResponse = try handleAuthRoute(request, url, config)
  if (authResponse !== undefined) return authResponse

  const postsUsersResponse = try handleSocialPostsAndUsers(request, url, config)
  if (postsUsersResponse !== undefined) return postsUsersResponse

  const chatNotifyResponse = try handleSocialChatsAndNotifications(request, url, config, options?.realtimeStore)
  if (chatNotifyResponse !== undefined) return chatNotifyResponse

  const marketResponse = try handleMarketRoute(request, url, config)
  if (marketResponse !== undefined) return marketResponse

  const adminResponse = try handleEngineAdminRoute(request, url, config)
  if (adminResponse !== undefined) return adminResponse

  const acceptHeader = request.headers.get("accept")?.toLowerCase() ?? ""
  const isHtmlOAuthAuthorize = method === "GET"
    && path === "/oauth/authorize"
    && acceptHeader.includes("text/html")
    && url.searchParams.get("format") !== "json"
  if (!isHtmlOAuthAuthorize && (path.startsWith("/api/") || path.startsWith("/oauth/"))) {
    return jsonResponse({ error: "not_found", code: "not_found", message: `Unknown route: ${path}` }, 404)
  }
  return undefined
}

export effect function resolveStatelessPublicRoute(
  request: Request,
  config: AppServerConfig
): (Response | undefined)!! {
  const url = new URL(request.url)
  const origin = requestOrigin(request, config)
  const path = url.pathname
  const method = request.method.toUpperCase()
  const run = effect {
    if (path === "/skill.md") {
      if (method === "OPTIONS") return makeResponse(null, { status: 204, headers: PUBLIC_CORS_HEADERS })
      if (method === "GET" || method === "HEAD") {
        return makeResponse(null, { status: 301, headers: { location: `${origin}/SKILL.md`, ...PUBLIC_CORS_HEADERS } })
      }
    }
    const skillResponse = try handleSkillRoute(request, origin)
    if (skillResponse !== undefined) return skillResponse
    if (method === "OPTIONS" && (path.startsWith("/.well-known/oauth") || path.startsWith("/oauth/"))) {
      return makeResponse(null, { status: 204, headers: PUBLIC_CORS_HEADERS })
    }
    if (method === "GET" && path === "/.well-known/oauth-authorization-server") {
      return jsonResponse(oauthAuthorizationServerMetadata(origin), 200, PUBLIC_CORS_HEADERS)
    }
    if (method === "GET" && (path === "/.well-known/oauth-protected-resource" || path === "/.well-known/oauth-protected-resource/mcp")) {
      return jsonResponse(oauthProtectedResourceMetadata(origin), 200, PUBLIC_CORS_HEADERS)
    }
    return undefined
  }
  return run catch (err) => mapDomainError(err)
}

export effect function resolveOptionalRouteResponse(
  request: Request,
  config: AppServerConfig,
  options?: RouteRequestOptions
): (Response | undefined)!!(Store | RealtimeBus) {
  const path = new URL(request.url).pathname
  const shouldPreAuthenticate = path.startsWith("/api/") && path !== "/api/skills/hosts" && path !== "/api/health" && path !== "/api/auth/me"
  if (!shouldPreAuthenticate) {
    const publicResponse = routeOptionalResponse(request, config, options) catch (err) => mapDomainError(err)
    return publicResponse
  }
  const session = optionalSession(request, config) catch () => null
  const response = routeOptionalResponse(request, config, options) catch (err) => mapDomainError(err)
  if (response === undefined) return undefined
  return withRefreshedSessionCookie(response, session)
}

export interface ScheduledTickOptions {
  readonly slowJobTimeoutMs?: number
  readonly slowCycleBudgetMs?: number
}

export type WorkerCronLane = "fast" | "minute-slow" | "npc" | "periodic-slow" | "all-slow"

const DEFAULT_SLOW_JOB_TIMEOUT_MS = 25_000
const DEFAULT_SLOW_CYCLE_BUDGET_MS = 45_000

interface ScheduledJobEntry {
  readonly name: string
  readonly run: () => unknown!(EngineFailure | StoreFailure | MarketFailure | SocialFailure)!(Store | RealtimeBus)
}

effect function runScheduledJob(
  name: string,
  run: () => unknown!(EngineFailure | StoreFailure | MarketFailure | SocialFailure)!(Store | RealtimeBus),
  timeoutMs?: number
): void!!(Store | RealtimeBus) {
  const exec = timeoutMs === undefined
    ? run()
    : timeout(run(), `${Math.max(1, Math.trunc(timeoutMs))} millis`)
  exec catch effect (err) => {
    const detail = err instanceof Error ? err.message : String(err)
    try Effect.logWarning(`scheduled tick ${name} failed: ${detail}`)
  }
}

effect function runBoundedSlowJobs(
  jobs: ReadonlyArray<ScheduledJobEntry>,
  options: ScheduledTickOptions = {}
): void!!(Store | RealtimeBus) {
  if (jobs.length === 0) return
  const jobTimeoutMs = Math.max(1, Math.trunc(options.slowJobTimeoutMs ?? DEFAULT_SLOW_JOB_TIMEOUT_MS))
  const cycleBudgetMs = Math.max(1, Math.trunc(options.slowCycleBudgetMs ?? DEFAULT_SLOW_CYCLE_BUDGET_MS))
  const startedAt = try Clock.currentTimeMillis
  for (const job of jobs) {
    const elapsedMs = (try Clock.currentTimeMillis) - startedAt
    const remainingMs = cycleBudgetMs - elapsedMs
    if (remainingMs <= 0) {
      try Effect.logWarning(`scheduled tick ${job.name} deferred: slow cycle budget (${cycleBudgetMs}ms) exhausted`)
      continue
    }
    try runScheduledJob(job.name, job.run, Math.min(jobTimeoutMs, remainingMs))
  }
}

export effect function runFastScheduledTicks(cycle: number): void!!(Store | RealtimeBus) {
  try runScheduledJob("minute-tick", () => runMinuteTick())
  if (isRouteDue("RoutePerpFunding", cycle)) {
    try runScheduledJob("perp-funding-tick", () => runPerpFundingTick())
  }
}

function minuteSlowJobsForCycle(cycle: number): ReadonlyArray<ScheduledJobEntry> {
  const jobs: ScheduledJobEntry[] = [
    { name: "markets-recovery", run: () => runMarketsRecovery() }
  ]
  if (isRouteDue("RouteMarketsTick", cycle)) {
    jobs.push({ name: "markets-tick", run: () => runMarketsTick() })
  }
  return jobs
}

function npcJobsForCycle(cycle: number): ReadonlyArray<ScheduledJobEntry> {
  return isRouteDue("RouteNpcTick", cycle)
    ? [{ name: "npc-tick", run: () => runNpcTick() }]
    : []
}

function periodicSlowJobsForCycle(cycle: number): ReadonlyArray<ScheduledJobEntry> {
  const jobs: ScheduledJobEntry[] = []
  if (isRouteDue("RouteOrganizationTick", cycle)) {
    jobs.push({ name: "organization-tick", run: () => runOrganizationTick() })
  }
  if (isRouteDue("RouteRssRefresh", cycle)) {
    jobs.push({ name: "rss-refresh-tick", run: () => runRssRefreshTick() })
  }
  if (isRouteDue("RouteArticleTick", cycle)) {
    jobs.push({ name: "article-tick", run: () => runArticleTick() })
  }
  if (isRouteDue("RouteWorldFacts", cycle)) {
    jobs.push({ name: "world-facts-tick", run: () => runWorldFactsTick() })
  }
  return jobs
}

export effect function runSlowScheduledTicks(
  cycle: number,
  options: ScheduledTickOptions = {}
): void!!(Store | RealtimeBus) {
  const jobs: ReadonlyArray<ScheduledJobEntry> = [
    ...minuteSlowJobsForCycle(cycle),
    ...npcJobsForCycle(cycle),
    ...periodicSlowJobsForCycle(cycle)
  ]
  try runBoundedSlowJobs(jobs, options)
}

export function workerCronLanes(cron: string): ReadonlyArray<WorkerCronLane> {
  switch (cron.trim()) {
    case "* * * * *":
      return ["fast", "minute-slow"]
    case "*/2 * * * *":
      return ["npc"]
    case "*/5 * * * *":
      return ["periodic-slow"]
    default:
      return ["fast", "all-slow"]
  }
}

export effect function runWorkerCronLane(
  lane: WorkerCronLane,
  cycle: number,
  options: ScheduledTickOptions = {}
): void!!(Store | RealtimeBus) {
  switch (lane) {
    case "fast":
      try runFastScheduledTicks(cycle)
      return
    case "minute-slow":
      try runBoundedSlowJobs(minuteSlowJobsForCycle(cycle), options)
      return
    case "npc":
      try runBoundedSlowJobs(npcJobsForCycle(cycle), options)
      return
    case "periodic-slow":
      try runBoundedSlowJobs(periodicSlowJobsForCycle(cycle), options)
      return
    case "all-slow":
      try runSlowScheduledTicks(cycle, options)
      return
    default: {
      const _exhaustive: never = lane
      return _exhaustive
    }
  }
}

export effect function runScheduledTicks(
  cycle: number,
  options: ScheduledTickOptions = {}
): void!!(Store | RealtimeBus) {
  try runFastScheduledTicks(cycle)
  try runSlowScheduledTicks(cycle, options)
}

export effect function handleFeedRequest(
  request: Request,
  config: AppServerConfig
): Response!!(Store | RealtimeBus) {
  const response = try resolveOptionalRouteResponse(request, config)
  if (response !== undefined) return response
  const path = new URL(request.url).pathname
  return jsonResponse({ error: "not_found", code: "not_found", message: `Unknown route: ${path}` }, 404)
}
