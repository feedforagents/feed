// spec/app/index.md, "Story: Browse, switch modes, and sign in through the JoinSheet"; spec/app/gameplayJourney.md, "Story: Walk the full Feed gameplay loop from visitor to settlement"
import { type CloudflareEmailSender } from "@repo/auth"
import { migrateFeedSchema, seedFeedWorld, Store, toInt, workerDbStore, type StoreFailure, type Tx } from "@repo/db/worker"
import { createDbBackedRealtimeBusLayer, RealtimeBus } from "@repo/social"
import { assertAppServerConfig, parseAppServerConfig, stringEnvRecord, syncProcessEnv } from "./config.vibe"
import { resolveOptionalRouteResponse, resolveStatelessPublicRoute, runWorkerCronLane, workerCronLanes } from "./router.vibe"

module web {
  /** @throws {never} */
  export function makeResponse(body: BodyInit | null, init?: ResponseInit): Response {
    return new Response(body, init)
  }

  /** @throws {never} */
  export function randomIsolateId(): string {
    return crypto.randomUUID()
  }
}
import { makeResponse, randomIsolateId } from web

export interface WorkerHyperdrive {
  readonly connectionString: string
}

export interface WorkerAssets {
  fetch(request: Request): Promise<Response>
}

export interface WorkerExecutionContext {
  waitUntil(promise: Promise<unknown>): void
  passThroughOnException?(): void
}

export interface WorkerScheduledController {
  readonly cron: string
  readonly scheduledTime: number
}

export interface WorkerEnv extends Readonly<Record<string, unknown>> {
  readonly HYPERDRIVE?: WorkerHyperdrive | undefined
  readonly DATABASE_URL?: string | undefined
  readonly ASSETS?: WorkerAssets | undefined
  readonly EMAIL?: CloudflareEmailSender | undefined
  readonly DEPLOYMENT_ENV?: string | undefined
  readonly PUBLIC_APP_URL?: string | undefined
  readonly PUBLIC_API_URL?: string | undefined
  readonly SMS_MODE?: string | undefined
  readonly SMS_ALLOWED_COUNTRIES?: string | undefined
  readonly EMAIL_MODE?: string | undefined
  readonly EMAIL_FROM?: string | undefined
  readonly EMAIL_PUBLIC_ORIGIN?: string | undefined
  readonly AUTH_DIGEST_KEY?: string | undefined
  readonly AUTH_SEALING_KEY?: string | undefined
  readonly OAUTH_SIGNING_SECRET?: string | undefined
  readonly TWILIO_ACCOUNT_SID?: string | undefined
  readonly TWILIO_AUTH_TOKEN?: string | undefined
  readonly TWILIO_VERIFY_SERVICE_SID?: string | undefined
  readonly TURNSTILE_SECRET_KEY?: string | undefined
  readonly TURNSTILE_SITE_KEY?: string | undefined
  readonly CRON_SECRET?: string | undefined
  readonly GAME_START?: string | undefined
  readonly COMMIT_SHA?: string | undefined
}

const bootstrappedConnections = new Set<string>()
let workerIsolateId: string | undefined
const isolateBusRuntimes = new Map<string, ManagedRuntime.ManagedRuntime<RealtimeBus, never>>()

function getWorkerIsolateId(): string {
  workerIsolateId ??= randomIsolateId()
  return workerIsolateId
}

function connectionStringForEnv(env: WorkerEnv): string | undefined {
  const hyperdriveUrl = env.HYPERDRIVE?.connectionString?.trim()
  if (hyperdriveUrl !== undefined && hyperdriveUrl !== "") return hyperdriveUrl
  const directUrl = env.DATABASE_URL?.trim()
  return directUrl !== undefined && directUrl !== "" ? directUrl : undefined
}

effect function schemaAndSeedReady(): boolean!StoreFailure!Store {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const tableRows = try tx.query(
      `SELECT
         to_regclass('public.feed_actors') AS actors,
         to_regclass('public.feed_prediction_markets') AS predictions,
         to_regclass('public.feed_perp_markets') AS perps,
         to_regclass('public.feed_market_price_history') AS price_history,
         to_regclass('public.feed_npc_spot_holdings') AS spot_holdings,
         to_regclass('public.feed_alpha_invite_cooldowns') AS alpha_cooldowns,
         to_regclass('public.feed_world_events') AS world_events,
         to_regclass('public.feed_email_magic_links') AS email_magic_links,
         to_regclass('public.feed_email_cooldowns') AS email_cooldowns,
         to_regclass('public.feed_job_leases') AS job_leases,
         to_regclass('public.feed_realtime_events') AS realtime_events`
    )
    const row = tableRows[0]
    if (
      row === undefined
      || typeof row.actors !== "string"
      || typeof row.predictions !== "string"
      || typeof row.perps !== "string"
      || typeof row.price_history !== "string"
      || typeof row.spot_holdings !== "string"
      || typeof row.alpha_cooldowns !== "string"
      || typeof row.world_events !== "string"
      || typeof row.email_magic_links !== "string"
      || typeof row.email_cooldowns !== "string"
      || typeof row.job_leases !== "string"
      || typeof row.realtime_events !== "string"
    ) {
      return false
    }
    const colRows = try tx.query(
      `SELECT count(*) AS count
       FROM information_schema.columns
       WHERE table_schema = 'public'
         AND (
           (table_name = 'feed_chat_members' AND column_name = 'last_read_at')
           OR (table_name = 'feed_group_invites' AND column_name = 'invited_by_id')
           OR (table_name = 'feed_trades' AND column_name = 'realized_pnl_cents')
           OR (table_name = 'feed_organizations' AND column_name = 'username')
           OR (table_name = 'feed_accounts' AND column_name = 'email_hash')
           OR (table_name = 'feed_accounts' AND column_name = 'email_masked')
           OR (table_name = 'feed_accounts' AND column_name = 'email_verified_at')
           OR (table_name = 'feed_notifications' AND column_name = 'chat_id')
           OR (table_name = 'feed_notifications' AND column_name = 'invite_id')
         )`
    )
    if (toInt(colRows[0]?.count) < 9) return false
    const seedRows = try tx.query(
      `SELECT
         (SELECT count(*) FROM feed_actors) AS actors_count,
         (SELECT count(*) FROM feed_market_price_history) AS history_count,
         (SELECT count(*) FROM feed_npc_spot_holdings) AS holdings_count`
    )
    const counts = seedRows[0]
    return toInt(counts?.actors_count) > 0 && toInt(counts?.history_count) > 0 && toInt(counts?.holdings_count) > 0
  })
}

effect function bootstrapDatabase(): void!StoreFailure!Store {
  const ready = try schemaAndSeedReady()
  if (ready) return
  try migrateFeedSchema()
  try seedFeedWorld()
}

async function ensureBootstrapped(connectionString: string, dbLayer: Layer.Layer<Store, StoreFailure>): Promise<void> {
  if (bootstrappedConnections.has(connectionString)) return
  await Effect.runPromise(Effect.provide(bootstrapDatabase(), dbLayer))
  bootstrappedConnections.add(connectionString)
}

effect function readBusService(): RealtimeBus.Shape!!RealtimeBus {
  return try RealtimeBus
}

async function sharedRealtimeBusLayer(connectionString: string): Promise<Layer.Layer<RealtimeBus>> {
  let runtime = isolateBusRuntimes.get(connectionString)
  if (runtime === undefined) {
    runtime = ManagedRuntime.make(
      createDbBackedRealtimeBusLayer(perCheckWorkerStore(connectionString), {
        isolateId: getWorkerIsolateId()
      })
    )
    isolateBusRuntimes.set(connectionString, runtime)
  }
  const bus = await runtime.runPromise(readBusService())
  return Layer.succeed(RealtimeBus, bus)
}

function perCheckWorkerStore(connectionString: string): Store.Shape {
  return {
    location: { kind: "connected-pg" },
    transaction: <A, E, R>(body: (tx: Tx) => A!E!R) =>
      Effect.scoped(
        Effect.provide(
          effect {
            const store = try Store
            return try store.transaction(body)
          },
          workerDbStore(connectionString)
        )
      )
  }
}

async function workerRuntimeLayer(env: WorkerEnv): Promise<{
  readonly layer: Layer.Layer<Store | RealtimeBus, StoreFailure>
  readonly connectionString: string
}> {
  const connectionString = connectionStringForEnv(env)
  if (connectionString === undefined) {
    throw new Error("HYPERDRIVE or DATABASE_URL binding is required.")
  }
  const dbLayer = workerDbStore(connectionString)
  await ensureBootstrapped(connectionString, dbLayer)
  const busLayer = await sharedRealtimeBusLayer(connectionString)
  return {
    layer: Layer.mergeAll(dbLayer, busLayer),
    connectionString
  }
}

function workerJsonError(status: number, code: string, message: string): Response {
  return makeResponse(
    JSON.stringify({ error: code, code, message }),
    {
      status,
      headers: {
        "content-type": "application/json; charset=utf-8",
        "cache-control": "no-store"
      }
    }
  )
}

export default {
  async fetch(request: Request, env: WorkerEnv, _ctx: WorkerExecutionContext): Promise<Response> {
    syncProcessEnv(env)
    const url = new URL(request.url)
    const isApiOrMcp = url.pathname.startsWith("/api/") || url.pathname === "/mcp" || url.pathname.startsWith("/oauth/") || url.pathname.startsWith("/.well-known/") || url.pathname === "/SKILL.md" || url.pathname === "/skill.md" || url.pathname === "/llms.txt" || url.pathname === "/how-to-play.md"
    if (!isApiOrMcp && env.ASSETS !== undefined && (request.method === "GET" || request.method === "HEAD")) {
      return env.ASSETS.fetch(request)
    }
    try {
      const config = parseAppServerConfig(stringEnvRecord(env), url.origin, { emailSender: env.EMAIL })
      await Effect.runPromise(assertAppServerConfig(config))
      const stateless = await Effect.runPromise(resolveStatelessPublicRoute(request, config))
      if (stateless !== undefined) return stateless
      const { layer: appLayer, connectionString } = await workerRuntimeLayer(env)
      const handled = await Effect.runPromise(
        Effect.provide(
          resolveOptionalRouteResponse(request, config, {
            realtimeStore: perCheckWorkerStore(connectionString)
          }),
          appLayer
        )
      )
      if (handled !== undefined) return handled
      if (env.ASSETS !== undefined) {
        return env.ASSETS.fetch(request)
      }
      return workerJsonError(404, "not_found", "Route not found.")
    } catch (err) {
      const message = err instanceof Error ? err.message : "Database unavailable."
      return workerJsonError(503, "service_unavailable", message)
    }
  },

  scheduled(controller: WorkerScheduledController, env: WorkerEnv, ctx: WorkerExecutionContext): void {
    syncProcessEnv(env)
    const config = parseAppServerConfig(stringEnvRecord(env), "https://feed.fun")
    if (config.gameStart !== "run") return
    const cycle = Math.max(1, Math.floor(controller.scheduledTime / 60_000))
    const lanes = workerCronLanes(controller.cron)
    for (const lane of lanes) {
      ctx.waitUntil(
        (async () => {
          await Effect.runPromise(assertAppServerConfig(config))
          const { layer: appLayer } = await workerRuntimeLayer(env)
          await Effect.runPromise(Effect.provide(runWorkerCronLane(lane, cycle), appLayer))
        })()
      )
    }
  }
}
