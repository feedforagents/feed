    const mutesListRes = try callApp("/api/moderation/mutes", { cookie: alice.cookie })
    const blocksItems = (try readJson(blocksListRes)).items as ReadonlyArray<Record<string, unknown>>
    const mutesItems = (try readJson(mutesListRes)).items as ReadonlyArray<Record<string, unknown>>
    try check(() => assert.deepStrictEqual(
      [blocksListRes.status, blocksItems.length, mutesListRes.status, mutesItems.length],
      [200, 1, 200, 1]
    ))
    const blockedSearchRes = try callApp("/api/users/search?q=parity_bob", { cookie: alice.cookie })
    const blockedSearchItems = (try readJson(blockedSearchRes)).items as ReadonlyArray<Record<string, unknown>>
    const anonSearchRes = try callApp("/api/users/search?q=parity_bob")
    const anonSearchItems = (try readJson(anonSearchRes)).items as ReadonlyArray<Record<string, unknown>>
    const mutedSearchRes = try callApp("/api/users/search?q=parity_charlie", { cookie: alice.cookie })
    const mutedSearchItems = (try readJson(mutedSearchRes)).items as ReadonlyArray<Record<string, unknown>>
    try check(() => assert.deepStrictEqual(
      [
        blockedSearchRes.status,
        blockedSearchItems.some((item) => item.handle === "parity_bob"),
        anonSearchItems.some((item) => item.handle === "parity_bob"),
        mutedSearchItems.some((item) => item.handle === "parity_charlie")
      ],
      [200, false, true, false]
    ))

    // spec/markets/spotPerp.md, "Opening a perp enforces the 20x leverage cap and updates only the mark premium"
    const heldOpenRes = try callApp("/api/markets/perp/NVDAI/open", {
      cookie: alice.cookie,
      json: { side: "long", collateralCents: 1000, leverage: 2 }
    })
    const heldPerpView = effect () => {
      const markets = try readJson(try callApp("/api/markets", { cookie: alice.cookie }))
      const market = (markets.perps as ReadonlyArray<Record<string, unknown>>).find((m) => m.ticker === "NVDAI")
      const held = ((markets.positions as Record<string, unknown>).perpPositions as ReadonlyArray<Record<string, unknown>>)
        .find((pos) => pos.ticker === "NVDAI")
      return [Number(market?.markPriceCents), Number(market?.openInterestCents), Number(held?.markPriceCents)]
    }
    const heldBefore = try heldPerpView()
    const bobOpposingRes = try callApp("/api/markets/perp/NVDAI/open", {
      cookie: bob.cookie,
      json: { side: "short", collateralCents: 4000, leverage: 5 }
    })
    const heldAfter = try heldPerpView()
    try check(() => assert.deepStrictEqual(
      [
        heldOpenRes.status,
        bobOpposingRes.status,
        heldAfter[0]! < heldBefore[0]!,
        heldAfter[1]! - heldBefore[1]!,
        heldBefore[2] === heldBefore[0] && heldAfter[2] === heldAfter[0]
      ],
      [201, 201, true, 20000, true]
    ))

    const bobOpenPos = try callApp("/api/markets/perp/XTRPC/open", {
      cookie: bob.cookie,
      json: { side: "long", collateralCents: 1000, leverage: 2 }
    })
    try check(() => assert.strictEqual(bobOpenPos.status, 201))
    const blockedProfileRes = try callApp("/api/users/parity_bob", { cookie: alice.cookie })
    const blockedProfile = try readJson(blockedProfileRes)
    const blockedPositions = blockedProfile.positions as Record<string, unknown>
    try check(() => assert.deepStrictEqual(
      [
        blockedProfileRes.status,
        (blockedPositions.perpPositions as ReadonlyArray<unknown>).length,
        (blockedPositions.predictionPositions as ReadonlyArray<unknown>).length
      ],
      [200, 0, 0]
    ))

    const privateDmForBob = try callApp("/api/chats/direct", { cookie: bob.cookie, json: { targetHandleOrId: "parity_charlie" } })
    const bobDmId = String(((try readJson(privateDmForBob)).chat as Record<string, unknown>).id ?? "")
    try callApp(`/api/chats/${encodeURIComponent(bobDmId)}/messages`, {
      cookie: bob.cookie,
      json: { content: "Private message hidden from unauth SSE" }
    })
    try callApp("/api/posts", {
      cookie: bob.cookie,
      json: { content: "Blocked author post hidden from Alice SSE" }
    })

    const perpOpenRes = try callApp("/api/markets/perp/XTRPC/open", {
      cookie: alice.cookie,
      json: { side: "long", collateralCents: 1000, leverage: 2 }
    })
    try check(() => assert.strictEqual(perpOpenRes.status, 201))
    const perpOpened = try readJson(perpOpenRes)
    const perpPosId = String(perpOpened.positionId ?? "")

    const perpCloseRes = try callApp(`/api/markets/perp/positions/${encodeURIComponent(perpPosId)}/close`, {
      method: "POST",
      cookie: alice.cookie,
      json: {}
    })
    try check(() => assert.strictEqual(perpCloseRes.status, 200))

    const anonFrames = try readSseEventsUntil(anonReader, anonNext, '"action":"close"')
    const aliceFrames = try readSseEventsUntil(aliceReader, aliceNext, '"action":"close"')

    anonAbort.abort()
    aliceAbort.abort()

    const anonJoined = anonFrames.join("\n")
    const aliceJoined = aliceFrames.join("\n")
    const bobId = String(bob.account.accountId)
    const aliceMarketUpdates = aliceFrames
      .filter((f) => f.includes("event: world.tick"))
      .map((f) => f.trim().replace(/"createdAt":\d+/, '"createdAt":0'))
    try check(() => assert.deepStrictEqual(
      {
        anonHasNoPrivateChat: !anonJoined.includes("event: chat.message"),
        anonHasPerpOpen: anonJoined.includes("event: market.perp") && anonJoined.includes('"action":"open"'),
        aliceHasNoBlockedPost: !aliceJoined.includes("event: post.created"),
        aliceHasNoBlockedPerp: !aliceFrames.some((f) => f.includes("event: market.perp") && f.includes(bobId)),
        anonHasBobPerp: anonFrames.some((f) => f.includes("event: market.perp") && f.includes(bobId)),
        aliceBlockedPerpUpdates: aliceMarketUpdates,
        anonHasNoMarketUpdate: !anonJoined.includes("event: world.tick"),
        aliceHasPerpOpen: aliceJoined.includes("event: market.perp") && aliceJoined.includes('"action":"open"'),
        aliceHasPerpClose: aliceJoined.includes("event: market.perp") && aliceJoined.includes('"action":"close"') && aliceJoined.includes('"leverage":2')
      },
      {
        anonHasNoPrivateChat: true,
        anonHasPerpOpen: true,
        aliceHasNoBlockedPost: true,
        aliceHasNoBlockedPerp: true,
        anonHasBobPerp: true,
        aliceBlockedPerpUpdates: [
          'event: world.tick\ndata: {"type":"world.tick","kind":"market","refId":"NVDAI","createdAt":0}',
          'event: world.tick\ndata: {"type":"world.tick","kind":"market","refId":"XTRPC","createdAt":0}'
        ],
        anonHasNoMarketUpdate: true,
        aliceHasPerpOpen: true,
        aliceHasPerpClose: true
      }
    ))

    // spec/auth/phone.md, "Changing phone requires verifying the old phone or support recovery and an unused new number"
    try TestClock.adjust("9 minutes")
    const recentPhoneChangeRes = try callApp("/api/auth/phone/change/start", {
      cookie: alice.cookie,
      json: { newPhoneE164: "+14155550187" }
    })
    const recentPhoneChangeBody = try readJson(recentPhoneChangeRes)
    try check(() => assert.deepStrictEqual(
      [recentPhoneChangeRes.status, recentPhoneChangeBody.last2],
      [200, "87"]
    ))

    try TestClock.adjust("2 minutes")
    const stalePhoneChangeRes = try callApp("/api/auth/phone/change/start", {
      cookie: alice.cookie,
      json: { newPhoneE164: "+14155550188" }
    })
    const stalePhoneChangeBody = try readJson(stalePhoneChangeRes)
    try check(() => assert.deepStrictEqual(
      [stalePhoneChangeRes.status, stalePhoneChangeBody.code],
      [403, "old_phone_verification_required"]
    ))

    const reauthStartRes = try callApp("/api/auth/phone/start", { json: { phoneE164: "+14155550111" } })
    try check(() => assert.strictEqual(reauthStartRes.status, 200))
    const reauthCodeBody = try readJson(try callApp(`/api/auth/dev/loopback-code?phone=${encodeURIComponent("+14155550111")}`))
    const reauthVerifyRes = try callApp("/api/auth/phone/verify", { json: { phoneE164: "+14155550111", code: String(reauthCodeBody.code ?? "") } })
    try check(() => assert.strictEqual(reauthVerifyRes.status, 200))
    const secondCookie = extractSessionCookie(reauthVerifyRes)

    const logoutRes = try callApp("/api/auth/logout", { method: "POST", cookie: alice.cookie })
    const reusedCookieEconomyRes = try callApp("/api/economy/me", { cookie: alice.cookie })
    const reusedCookieMeBody = try readJson(try callApp("/api/auth/me", { cookie: alice.cookie }))
    const repeatLogoutRes = try callApp("/api/auth/logout", { method: "POST", cookie: alice.cookie })
    const secondCookieMeAfterLogout = try readJson(try callApp("/api/auth/me", { cookie: secondCookie }))
    const logoutClearsCookie = (logoutRes.headers.get("set-cookie") ?? "").includes("Max-Age=0")
    try check(() => assert.deepStrictEqual(
      [logoutRes.status, reusedCookieEconomyRes.status, reusedCookieMeBody.authenticated, repeatLogoutRes.status, secondCookieMeAfterLogout.authenticated, logoutClearsCookie],
      [200, 401, false, 200, true, true]
    ))

    // spec/auth/phone.md, "Story: Onboard once, change phone, sign out everywhere, or delete after cooldown"
    const explorePeople = effect (query: string) => {
      const body = try readJson(try callApp(`/api/explore?q=${query}`))
      return (body.search as { readonly accounts: ReadonlyArray<Record<string, unknown>> }).accounts.map((account) => account.handle)
    }
    const peopleBeforeDelete = try explorePeople("parity_alice")
    const deleteAccountRes = try callApp("/api/auth/account/delete", { method: "POST", cookie: secondCookie })
    const mcpSearchAfterDelete = try readJson(try callApp("/mcp", {
      json: { jsonrpc: "2.0", id: 90, method: "tools/call", params: { name: "search", arguments: { query: "deleted", kind: "users" } } }
    }))
    const mcpPeopleAfterDelete = ((mcpSearchAfterDelete.result as Record<string, unknown>).structuredContent as { readonly accounts: ReadonlyArray<Record<string, unknown>> }).accounts
    const mentionSearchAfterDelete = (try readJson(try callApp("/api/users/search?q=deleted"))).items
    const explorePeopleAfterDelete = try explorePeople("deleted")
    const activePeopleAfterDelete = try explorePeople("parity_bob")
    try check(() => assert.deepStrictEqual(
      {
        peopleBeforeDelete,
        deleteStatus: deleteAccountRes.status,
        explorePeopleAfterDelete,
        activePeopleAfterDelete,
        mcpPeopleAfterDelete: mcpPeopleAfterDelete.map((account) => account.handle),
        mentionSearchAfterDelete
      },
      {
        peopleBeforeDelete: ["parity_alice"],
        deleteStatus: 200,
        explorePeopleAfterDelete: [],
        activePeopleAfterDelete: ["parity_bob"],
        mcpPeopleAfterDelete: [],
        mentionSearchAfterDelete: []
      }
    ))
  }
}, 180_000)

it.effect('Session cookie slides with the server session (spec/app/index.md, "Story: Browse, switch modes, and sign in through the JoinSheet")', effect () => {
  provide appLayer() {
    try TestClock.setTime(Date.now())
    try seedWorld()
    const player = try onboardPhonePlayer("+14155550155", "sliding_session")

    const meFresh = try callApp("/api/auth/me", { cookie: player.cookie })
    const meFreshBody = try readJson(meFresh)
    try check(() => assert.strictEqual(meFreshBody.authenticated, true))
    const meFreshMaxAge = sessionCookieMaxAge(meFresh.headers.get("set-cookie"))
    const meFreshPair = extractSessionCookie(meFresh)
    try check(() => assert.deepStrictEqual(
         { meFreshMaxAge, sameToken: meFreshPair === player.cookie },
     { meFreshMaxAge: 30 * 86_400, sameToken: true }
    ))

    try TestClock.adjust("25 days")
    const marketsLater = try callApp("/api/markets", { cookie: player.cookie })
    try check(() => assert.strictEqual(marketsLater.status, 200))
    const refreshedMaxAge = sessionCookieMaxAge(marketsLater.headers.get("set-cookie"))
    const refreshedPair = extractSessionCookie(marketsLater)
    try check(() => assert.deepStrictEqual(
      { refreshedMaxAge, sameToken: refreshedPair === player.cookie },
      { refreshedMaxAge: 30 * 86_400, sameToken: true }
    ))
    const meLater = try callApp("/api/auth/me", { cookie: player.cookie })
    const meLaterBody = try readJson(meLater)
    try check(() => assert.strictEqual(meLaterBody.authenticated, true))
        const meLaterMaxAge = sessionCookieMaxAge(meLater.headers.get("set-cookie"))
      const meLaterPair = extractSessionCookie(meLater)
      try check(() => assert.deepStrictEqual(
       { meLaterMaxAge, sameToken: meLaterPair === player.cookie },
       { meLaterMaxAge: 30 * 86_400, sameToken: true }
      ))
      try TestClock.adjust("25 days")
      const meStill = try callApp("/api/auth/me", { cookie: player.cookie })
      const meStillBody = try readJson(meStill)
      try check(() => assert.strictEqual(meStillBody.authenticated, true))
    try TestClock.adjust("20 days")
    const marketsDay70 = try callApp("/api/markets", { cookie: player.cookie })
    try check(() => assert.strictEqual(marketsDay70.status, 200))
    const cappedMaxAge = sessionCookieMaxAge(marketsDay70.headers.get("set-cookie"))
    const cappedPair = extractSessionCookie(marketsDay70)
    try check(() => assert.deepStrictEqual(
     { cappedMaxAge, sameToken: cappedPair === player.cookie },
     { cappedMaxAge: 20 * 86_400, sameToken: true }
  ))
  }
}, 180_000)

// spec/auth/email.md, "Story: Request and consume a single-use email magic link safely"
it.effect('Email magic link sign-in, onboarding 100 pts grant, and profile likes REST journey (spec/auth/email.md, "Story: Request and consume a single-use email magic link safely")', effect () => {
  provide appLayer() {
    try TestClock.setTime(Date.now())
    try seedWorld()

    const startRes = try callApp("/api/auth/email/start", {
      json: { email: "magic_journey@example.com", redirectTo: "/" }
    })
    const startBody = try readJson(startRes)
    const devMagicLinkUrl = String(startBody.devMagicLinkUrl ?? "")
    const token = extractMagicToken(devMagicLinkUrl)
    try check(() => assert.deepStrictEqual(
      [startRes.status, String(startBody.emailMasked ?? ""), token.length > 0],
      [200, "m***@example.com", true]
    ))

    const verifyRes = try callApp("/api/auth/email/verify", {
      json: { token }
    })
    const verifyBody = try readJson(verifyRes)
    const onboardingToken = String(verifyBody.onboardingToken ?? verifyBody.pendingToken ?? "")
    try check(() => assert.deepStrictEqual(
      [verifyRes.status, String(verifyBody.status ?? ""), onboardingToken.length > 0],
      [200, "needs_onboarding", true]
    ))

    const onboardRes = try callApp("/api/auth/email/onboard", {
      json: {
        onboardingToken,
        pendingToken: onboardingToken,
        username: "magic_alice",
        displayName: "Magic Alice",
        ageConfirmed: true,
        accepted18Plus: true,
        tosAccepted: true,
        acceptedTerms: true
      }
    })
    const onboardCookie = extractSessionCookie(onboardRes)
    const meRes = try callApp("/api/auth/me", { cookie: onboardCookie })
    const meBody = try readJson(meRes)
    const viewer = (meBody.viewer ?? meBody.account) as Record<string, unknown>
    try check(() => assert.deepStrictEqual(
      [
        onboardRes.status === 200 || onboardRes.status === 201,
        meRes.status,
        Boolean(meBody.authenticated),
        Boolean(meBody.emailAuthEnabled),
        String(viewer.handle ?? ""),
        String(viewer.emailMasked ?? ""),
        Number(viewer.balanceCents ?? 0)
      ],
      [true, 200, true, true, "magic_alice", "m***@example.com", 10000]
    ))

    const feedBody = try readJson(try callApp("/api/feed?tab=latest", { cookie: onboardCookie }))
    const firstPost = ((feedBody.items ?? []) as ReadonlyArray<Record<string, unknown>>)[0]
    const firstPostId = String(firstPost?.id ?? "")
    if (firstPostId !== "") {
      const likeRes = try callApp(`/api/posts/${encodeURIComponent(firstPostId)}/like`, {
        method: "POST",
        cookie: onboardCookie,
        json: {}
      })
      const likesRes = try callApp("/api/users/magic_alice/likes", { cookie: onboardCookie })
      const likesBody = try readJson(likesRes)
      const likedItems = (likesBody.posts ?? likesBody.items ?? []) as ReadonlyArray<Record<string, unknown>>
      try check(() => assert.deepStrictEqual(
        [likeRes.status, likesRes.status, likedItems.some((p) => String(p.id ?? "") === firstPostId)],
        [200, 200, true]
      ))
    }

    // spec/auth/email.md, "Sign out everywhere bumps `sessionsEpoch`, and self-serve deletion holds the email hash for 30 days"; spec/social/moderation.md, "Following is refused when blocked"; spec/social/messaging.md, "Sending a DM reuses any existing thread or auto-creates one for a non-blocked pair"
    const deletedId = String(viewer.accountId ?? "")
    const deletedHandle = `deleted_${deletedId}`
    const watcher = try onboardPhonePlayer("+14155550121", "magic_watcher")
    const buyRes = try callApp("/api/markets/prediction/seed-market-1/buy", { cookie: onboardCookie, json: { side: "yes", amountCents: 500 } })
    const groupBody = try readJson(try callApp("/api/chats/group", { cookie: watcher.cookie, json: { title: "watchers", memberHandles: [] } }))
    const groupId = String((groupBody.chat as Record<string, unknown>).id ?? "")
    const profileBeforeDelete = try callApp(`/api/users/${deletedId}`, { cookie: watcher.cookie })
    const tradesBeforeDelete = try readJson(try callApp(`/api/users/${deletedId}/trades`, { cookie: watcher.cookie }))
    const deleteRes = try callApp("/api/auth/account/delete", { method: "POST", cookie: onboardCookie })
    const profileById = try callApp(`/api/users/${deletedId}`, { cookie: watcher.cookie })
    const profileByHandle = try callApp(`/api/users/${deletedHandle}`)
    const tradesById = try callApp(`/api/users/${deletedId}/trades`)
    const mcpProfile = try readText(try callApp("/mcp", {
      json: { jsonrpc: "2.0", id: 91, method: "tools/call", params: { name: "get_profile", arguments: { handleOrId: deletedId } } }
    }))
    const followRes = try callApp(`/api/users/${deletedHandle}/follow`, { method: "POST", cookie: watcher.cookie })
    const dmRes = try callApp("/api/chats/direct", { cookie: watcher.cookie, json: { targetHandleOrId: deletedId } })
    const inviteRes = try callApp(`/api/chats/${encodeURIComponent(groupId)}/invite`, { cookie: watcher.cookie, json: { targetHandleOrId: deletedId } })
    const watcherFollowing = try readText(try callApp("/api/users/magic_watcher/following", { cookie: watcher.cookie }))
    const watcherChats = try readText(try callApp("/api/chats", { cookie: watcher.cookie }))
    const activeProfile = try callApp("/api/users/magic_watcher")
    try check(() => assert.deepStrictEqual(
      {
        buyStatus: buyRes.status,
        profileBeforeDelete: profileBeforeDelete.status,
        tradesBeforeDelete: (tradesBeforeDelete.trades as ReadonlyArray<unknown>).length,
        deleteStatus: deleteRes.status,
        profileById: profileById.status,
        profileByHandle: profileByHandle.status,
        tradesById: tradesById.status,
        mcpProfileFound: mcpProfile.includes(deletedHandle),
        writes: [followRes.status, dmRes.status, inviteRes.status],
        followingShowsDeleted: watcherFollowing.includes(deletedId),
        chatsShowDeleted: watcherChats.includes(deletedId),
        activeProfile: activeProfile.status
      },
      {
        buyStatus: 200,
        profileBeforeDelete: 200,
        tradesBeforeDelete: 1,
        deleteStatus: 200,
        profileById: 404,
        profileByHandle: 404,
        tradesById: 404,
        mcpProfileFound: false,
        writes: [404, 404, 404],
        followingShowsDeleted: false,
        chatsShowDeleted: false,
        activeProfile: 200
      }
    ))

    // spec/social/moderation.md, "Creating notifications skips blocked actors and increments unread count"; spec/markets/prediction.md, "Resolution declassifies the hidden outcome, publishes the proof, and pays 1 pt (100 cents) per winning share idempotently"
    const watcherId = String(watcher.account.accountId ?? "")
    const watcherBuyRes = try callApp("/api/markets/prediction/seed-market-1/buy", { cookie: watcher.cookie, json: { side: "yes", amountCents: 500 } })
    disableRssFeeds()
    const store = try Store
    const settleStart = try Clock.currentTimeMillis
    try store.transaction((tx: Tx) => tx.query("UPDATE feed_prediction_markets SET expires_at = $1 WHERE id = 'seed-market-1'", [settleStart + 30_000]))
    try TestClock.adjust("1 minute")
    try runScheduledTicks(Math.floor((settleStart + 60_000) / 60_000))
    const settled = try store.transaction(effect (tx: Tx) => ({
      market: try tx.query("SELECT status FROM feed_prediction_markets WHERE id = 'seed-market-1'"),
      holders: try tx.query("SELECT holder_id FROM feed_prediction_positions WHERE market_id = 'seed-market-1' AND holder_kind = 'user' AND settled_at IS NOT NULL"),
      notified: try tx.query("SELECT account_id FROM feed_notifications WHERE kind = 'market_resolved' AND market_id = 'seed-market-1'")
    }))
    try check(() => assert.deepStrictEqual(
      {
        watcherBuy: watcherBuyRes.status,
        market: String(settled.market[0]?.status),
        settledHolders: settled.holders.map((row) => String(row.holder_id)).sort(),
        notified: settled.notified.map((row) => String(row.account_id))
      },
      {
        watcherBuy: 200,
        market: "resolved",
        settledHolders: [deletedId, watcherId].sort(),
        notified: [watcherId]
      }
    ))
  }
}, 120_000)

it.effect('REST perp idempotency: same Idempotency-Key replays the open/close receipt, different params conflict, and an order whose mode no longer matches the position is refused (spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/markets/spotPerp.md, "Opening a perp enforces the 20x leverage cap and updates only the mark premium")', effect () => {
  provide appLayer() {
    try TestClock.setTime(Date.now())
    try seedWorld()

    const alice = try onboardPhonePlayer("+14155550156", "perp_idem_alice")

    const openPerp = effect (key: string, collateralCents = 1000) => {
      const res = try callApp("/api/markets/perp/XTRPC/open", {
        cookie: alice.cookie,
        headers: { "Idempotency-Key": key },
        json: { side: "long", collateralCents, leverage: 2 }
      })
      return { res, body: try readJson(res) }
    }
    const closePerp = effect (id: string, key: string) => {
      const res = try callApp(`/api/markets/perp/positions/${encodeURIComponent(id)}/close`, {
        method: "POST",
        cookie: alice.cookie,
        headers: { "Idempotency-Key": key },
        json: {}
      })
      return { res, body: try readJson(res) }
    }

    const { res: open1, body: open1Body } = try openPerp("rest-perp-open-1")
    const { res: openReplay, body: openReplayBody } = try openPerp("rest-perp-open-1")
    const { res: openConflict, body: openConflictBody } = try openPerp("rest-perp-open-1", 2000)
    const { res: openInvalid, body: openInvalidBody } = try openPerp("k".repeat(260))

    const positionId = String(open1Body.positionId ?? "")
    const { res: close1, body: close1Body } = try closePerp(positionId, "rest-perp-close-1")
    const { res: closeReplay, body: closeReplayBody } = try closePerp(positionId, "rest-perp-close-1")
    const { res: open2, body: open2Body } = try openPerp("rest-perp-open-2")
    const positionId2 = String(open2Body.positionId ?? "")
    const { res: closeConflict, body: closeConflictBody } = try closePerp(positionId2, "rest-perp-close-1")

    const agent = try connectAgentOAuthPkce(alice.cookie, "PerpModeAgent")
    const agentFlip = try readJson(try callApp("/mcp", {
      bearer: String(agent.access_token ?? ""),
      json: {
        jsonrpc: "2.0",
        id: 1,
        method: "tools/call",
        params: { name: "open_perp", arguments: { ticker: "XTRPC", side: "short", collateralPts: 10, leverage: 2, mode: "flip" } }
      }
    }))
    const orderWithMode = effect (side: "long" | "short", mode: string, collateralCents = 1000) => {
      const res = try callApp("/api/markets/perp/XTRPC/open", { cookie: alice.cookie, json: { side, collateralCents, leverage: 2, mode } })
      const body = try readJson(res)
      const markets = try readJson(try callApp("/api/markets", { cookie: alice.cookie }))
      const held = (markets.positions as { readonly perpPositions: ReadonlyArray<{ readonly side: string; readonly sizeCents: number }> }).perpPositions
      return [res.status, body.code ?? body.action, ...held.flatMap((pos) => [pos.side, pos.sizeCents])]
    }
    const staleAdd = try orderWithMode("long", "add")
    const staleFlip = try orderWithMode("short", "flip")
    const reduceOnHeldSide = try orderWithMode("short", "reduce")
    const reducePastHeldSize = try orderWithMode("long", "reduce", 1500)
    const openWhileHolding = try orderWithMode("short", "open")
    const matchingReduce = try orderWithMode("long", "reduce", 500)
    const matchingClose = try orderWithMode("long", "reduce", 500)
    const addAfterClose = try orderWithMode("short", "add")
    try check(() => assert.deepStrictEqual(
      {
        agentFlip: ((agentFlip.result as Record<string, unknown>).structuredContent as Record<string, unknown>).action,
        staleAdd,
        staleFlip,
        reduceOnHeldSide,
        reducePastHeldSize,
        openWhileHolding,
        matchingReduce,
        matchingClose,
        addAfterClose
      },
      {
        agentFlip: "flip",
        staleAdd: [400, "ORDER_MODE_MISMATCH", "short", 2000],
        staleFlip: [400, "ORDER_MODE_MISMATCH", "short", 2000],
        reduceOnHeldSide: [400, "ORDER_MODE_MISMATCH", "short", 2000],
        reducePastHeldSize: [400, "ORDER_MODE_MISMATCH", "short", 2000],
        openWhileHolding: [400, "ORDER_MODE_MISMATCH", "short", 2000],
        matchingReduce: [201, "reduce", "short", 1000],
        matchingClose: [201, "close"],
        addAfterClose: [400, "ORDER_MODE_MISMATCH"]
      }
    ))

    try check(() => assert.deepStrictEqual(
      {
        statuses: [open1.status, openReplay.status, openConflict.status, openInvalid.status, close1.status, closeReplay.status, open2.status, closeConflict.status],
        sameOpenTradeId: open1Body.tradeId === openReplayBody.tradeId,
        sameOpenPositionId: open1Body.positionId === openReplayBody.positionId,
        sameOpenBalance: open1Body.balanceAfterCents === openReplayBody.balanceAfterCents,
        sameCloseTradeId: close1Body.tradeId === closeReplayBody.tradeId,
        sameCloseBalance: close1Body.balanceAfterCents === closeReplayBody.balanceAfterCents,
        codes: [openConflictBody.code, openInvalidBody.code, closeConflictBody.code]
      },
      {
        statuses: [201, 201, 409, 400, 200, 200, 201, 409],
        sameOpenTradeId: true,
        sameOpenPositionId: true,
        sameOpenBalance: true,
        sameCloseTradeId: true,
        sameCloseBalance: true,
        codes: ["IDEMPOTENCY_CONFLICT", "INVALID_IDEMPOTENCY_KEY", "IDEMPOTENCY_CONFLICT"]
      }
    ))
  }
}, 180_000)

it.effect('REST trade routes reject conflicting duplicate unit aliases, matching aliases still succeed (spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/markets/prediction.md, "Story: Open and trade a prediction market")', effect () => {
  provide appLayer() {
    try TestClock.setTime(Date.now())
    try seedWorld()

    const alice = try onboardPhonePlayer("+14155550157", "alias_alice")

    const buyConflictRes = try callApp("/api/markets/prediction/seed-market-1/buy", {
      cookie: alice.cookie,
      json: { side: "yes", amountCents: 1000, amountPts: 50 }
    })
    const buyConflictBody = try readJson(buyConflictRes)
    const buyAgreeRes = try callApp("/api/markets/prediction/seed-market-1/buy", {
      cookie: alice.cookie,
      json: { side: "yes", amountCents: 5000, amountPts: 50 }
    })
    const sellConflictRes = try callApp("/api/markets/prediction/seed-market-1/sell", {
      cookie: alice.cookie,
      json: { side: "yes", shareUnits: 100, shares: 5 }
    })
    const sellConflictBody = try readJson(sellConflictRes)
    const perpConflictRes = try callApp("/api/markets/perp/XTRPC/open", {
      cookie: alice.cookie,
      json: { side: "long", collateralCents: 1000, collateralPts: 50, leverage: 2 }
    })
    const perpConflictBody = try readJson(perpConflictRes)
    const perpAgreeRes = try callApp("/api/markets/perp/XTRPC/open", {
      cookie: alice.cookie,
      json: { side: "long", collateralCents: 1000, collateralPts: 10, leverage: 2 }
    })
    const perpAgreeBody = try readJson(perpAgreeRes)

    try check(() => assert.deepStrictEqual(
      {
        buyConflict: [buyConflictRes.status, buyConflictBody.code],
        buyAgree: buyAgreeRes.status,
        sellConflict: [sellConflictRes.status, sellConflictBody.code],
        perpConflict: [perpConflictRes.status, perpConflictBody.code],
        perpAgree: [perpAgreeRes.status, perpAgreeBody.action]
      },
      {
        buyConflict: [400, "conflicting_amount"],
        buyAgree: 200,
        sellConflict: [400, "conflicting_amount"],
        perpConflict: [400, "conflicting_amount"],
        perpAgree: [201, "open"]
      }
    ))
  }
}, 180_000)
