// spec/app/gameplayJourney.md, "Story: Walk the full Feed gameplay loop from visitor to settlement"; spec/app/index.md, "Story: Connect and revoke the account's single AI agent"; spec/app/index.md, "Story: Browse, switch modes, and sign in through the JoinSheet"
import { assert, it } from "@effect/vitest"
import { migrateFeedSchema, seedFeedWorld, Store, toInt, type Tx } from "@repo/db"
import { localStoreLayer } from "@repo/db/node"
import { realtimeBusLayer } from "@repo/social"
import { TestClock } from "effect/testing"
import { parseAppServerConfig, type AppServerConfig } from "../src/server/config.vibe"
import { handleFeedRequest } from "../src/server/router.vibe"

module node {
  import { createHash } from "node:crypto"

  /** @throws {never} */
  export function sha256Hex(text: string): string {
    return createHash("sha256").update(text, "utf8").digest("hex")
  }

  /** @throws {never} */
  export function pkceChallenge(verifier: string): string {
    return createHash("sha256").update(verifier, "utf8").digest("base64url")
  }

  /** @throws {never} */
  export function makeHeaders(init?: Readonly<Record<string, string>>): Headers {
    return new Headers(init)
  }

  /** @throws {never} */
  export function makeRequest(url: string, init: RequestInit): Request {
    return new Request(url, init)
  }

  /** @throws {never} */
  export function makeAbortController(): AbortController {
    return new AbortController()
  }

  /** @throws {never} */
  export function decodeUtf8(bytes: Uint8Array | undefined): string {
    return bytes === undefined ? "" : new TextDecoder().decode(bytes)
  }

  /** @throws {never} */
  export function getBodyReader(response: Response): ReadableStreamDefaultReader<Uint8Array> {
    return response.body!.getReader()
  }

  /** @throws {never} */
  export function startReadChunk(reader: ReadableStreamDefaultReader<Uint8Array>): Promise<ReadableStreamReadResult<Uint8Array>> {
    return reader.read()
  }
}
import { decodeUtf8, getBodyReader, makeAbortController, makeHeaders, makeRequest, pkceChallenge, sha256Hex, startReadChunk } from node

const APP_ORIGIN = "http://feed.localtest"

const TEST_CONFIG = parseAppServerConfig(
  {
    DEPLOYMENT_ENV: "localnet",
    PUBLIC_APP_URL: APP_ORIGIN,
    PUBLIC_API_URL: APP_ORIGIN,
    SMS_MODE: "loopback",
    AUTH_DIGEST_KEY: "test-digest-key-00000000000000000000000000000000",
    OAUTH_SIGNING_SECRET: "test-oauth-secret-00000000000000000000000000000",
    CRON_SECRET: "test-cron-secret",
    TURNSTILE_SITE_KEY: "0x4AAAAAAB_test_site_key"
  },
  APP_ORIGIN
)

const TWILIO_CONFIG = parseAppServerConfig(
  {
    DEPLOYMENT_ENV: "production",
    PUBLIC_APP_URL: "https://feed.fun",
    PUBLIC_API_URL: "https://feed.fun",
    SMS_MODE: "twilio",
    AUTH_DIGEST_KEY: "prod-digest-key-00000000000000000000000000000000",
    OAUTH_SIGNING_SECRET: "prod-oauth-secret-00000000000000000000000000000",
    CRON_SECRET: "prod-cron-secret"
  },
  "https://feed.fun"
)

function check(run: () => void): void!! {
  return orDie(Effect.try(run))
}

function appLayer() {
  return Layer.merge(
    Layer.fresh(localStoreLayer({ kind: "pglite", file: undefined })),
    Layer.fresh(realtimeBusLayer)
  )
}

error TestHttpFailure { message: string }

effect function callApp(
  path: string,
  options?: {
    readonly method?: string
    readonly json?: unknown
    readonly rawBody?: string
    readonly cookie?: string
    readonly bearer?: string
    readonly headers?: Readonly<Record<string, string>>
    readonly signal?: AbortSignal
    readonly config?: AppServerConfig
  }
) {
  const rawHeaders: Record<string, string> = { ...(options?.headers ?? {}) }
  if (options?.cookie !== undefined) rawHeaders.cookie = options.cookie
  if (options?.bearer !== undefined) rawHeaders.authorization = `Bearer ${options.bearer}`
  const hasJson = options?.json !== undefined
  const hasRaw = options?.rawBody !== undefined
  if (hasJson && !Object.keys(rawHeaders).some((k) => k.toLowerCase() === "content-type")) {
    rawHeaders["content-type"] = "application/json"
  }
  const request = makeRequest(`${APP_ORIGIN}${path}`, {
    method: options?.method ?? (hasJson || hasRaw ? "POST" : "GET"),
    headers: makeHeaders(rawHeaders),
    body: hasRaw ? options.rawBody : hasJson ? JSON.stringify(options.json) : undefined,
    ...(options?.signal === undefined ? {} : { signal: options.signal })
  })
  return try handleFeedRequest(request, options?.config ?? TEST_CONFIG)
}

effect function readJson(response: Response) {
  return try tryPromise({
    try: () => response.json() as Promise<Record<string, unknown>>,
    catch: () => new TestHttpFailure({ message: "Invalid JSON response" })
  })
}

effect function readText(response: Response) {
  return try tryPromise({
    try: () => response.text(),
    catch: () => new TestHttpFailure({ message: "Invalid text response" })
  })
}

function extractSessionCookie(response: Response): string {
  const raw = response.headers.get("set-cookie") ?? ""
  const tokenPart = raw.split(";")[0]?.trim() ?? ""
  return tokenPart
}
function sessionCookieMaxAge(setCookieHeader: string | null): number | null {
  if (setCookieHeader === null) return null
  const match = /Max-Age=(\d+)/.exec(setCookieHeader)
  if (match === null) return null
  return Number(match[1])
}

effect function seedWorld() {
  try migrateFeedSchema()
  try seedFeedWorld()
}

effect function onboardPhonePlayer(phoneE164: string, username: string) {
  const startRes = try callApp("/api/auth/phone/start", { json: { phoneE164 } })
  try check(() => assert.strictEqual(startRes.status, 200))
  const codeRes = try callApp(`/api/auth/dev/loopback-code?phone=${encodeURIComponent(phoneE164)}`)
  try check(() => assert.strictEqual(codeRes.status, 200))
  const codeBody = try readJson(codeRes)
  const code = String(codeBody.code ?? "")
  const verifyRes = try callApp("/api/auth/phone/verify", { json: { phoneE164, code } })
  try check(() => assert.strictEqual(verifyRes.status, 200))
  const verifyBody = try readJson(verifyRes)
  const pendingToken = String(verifyBody.pendingToken ?? "")
  const onboardRes = try callApp("/api/auth/phone/onboard", {
    json: { pendingToken, username, accepted18Plus: true, acceptedTerms: true }
  })
  try check(() => assert.strictEqual(onboardRes.status, 201))
  const onboardBody = try readJson(onboardRes)
  return {
    cookie: extractSessionCookie(onboardRes),
    account: onboardBody.account as Record<string, unknown>
  }
}

effect function connectAgentOAuthPkce(cookie: string, clientName: string) {
  const redirectUri = "http://127.0.0.1:49100/callback"
  const regRes = try callApp("/oauth/register", {
    json: {
      client_name: clientName,
      redirect_uris: [redirectUri],
      token_endpoint_auth_method: "none"
    }
  })
  try check(() => assert.strictEqual(regRes.status, 201))
  const regBody = try readJson(regRes)
  const clientId = String(regBody.client_id ?? "")
  const verifier = `pkce-verifier-${clientName.replace(/\s+/g, "-")}-0123456789abcdef`
  const authRes = try callApp("/api/oauth/authorize", {
    cookie,
    json: {
      clientId,
      redirectUri,
      codeChallenge: pkceChallenge(verifier),
      codeChallengeMethod: "S256",
      responseType: "code",
      state: "s".repeat(410),
      resource: `${APP_ORIGIN}/mcp/`,
      scopes: ["read", "social:write", "messages", "trade"]
    }
  })
  try check(() => assert.strictEqual(authRes.status, 200))
  const authBody = try readJson(authRes)
  const tokenRes = try callApp("/oauth/token", {
    json: {
      grant_type: "authorization_code",
      code: String(authBody.code ?? ""),
      code_verifier: verifier,
      client_id: clientId,
      redirect_uri: redirectUri,
      resource: `${APP_ORIGIN}/mcp/`
    }
  })
  try check(() => assert.strictEqual(tokenRes.status, 200))
  return try readJson(tokenRes)
}

it.effect('Full HTTP + MCP + Single-Agent Replacement gameplay journey (spec/app/gameplayJourney.md, "Story: Walk the full Feed gameplay loop from visitor to settlement")', effect () => {
  provide appLayer() {
    try TestClock.setTime(Date.now())
    try seedWorld()

    const skillRes = try callApp("/SKILL.md")
    try check(() => assert.strictEqual(skillRes.status, 200))
    const skillText = try readText(skillRes)
    const indexRes = try callApp("/.well-known/agent-skills/index.json")
    try check(() => assert.strictEqual(indexRes.status, 200))
    const indexBody = try readJson(indexRes)
    const firstSkill = (indexBody.skills as ReadonlyArray<Record<string, unknown>>)[0]
    try check(() => assert.strictEqual(firstSkill?.digest, `sha256:${sha256Hex(skillText)}`))

    const publicFeed = try callApp("/api/feed?tab=latest")
    const publicMarkets = try callApp("/api/markets")
    try check(() => assert.strictEqual(publicFeed.status, 200))
    try check(() => assert.strictEqual(publicMarkets.status, 200))

    const player = try onboardPhonePlayer("+14155550199", "journey_web")
    try check(() => assert.strictEqual(Number(player.account.balanceCents), 10_000))

    const webPost = try callApp("/api/posts", {
      cookie: player.cookie,
      json: { content: "Human verified and exploring seeded $XTRPC markets on Feed." }
    })
    try check(() => assert.strictEqual(webPost.status, 201))

    const tokenA = try connectAgentOAuthPkce(player.cookie, "JourneyAgentA")
    const accessA = String(tokenA.access_token ?? "")

    const unauthMcp = try callApp("/mcp", {
      json: { jsonrpc: "2.0", id: 1, method: "tools/call", params: { name: "create_post", arguments: { content: "hi" } } }
    })
    try check(() => assert.strictEqual(unauthMcp.status, 401))

    const mcpPostA = try callApp("/mcp", {
      bearer: accessA,
      json: {
        jsonrpc: "2.0",
        id: 2,
        method: "tools/call",
        params: { name: "create_post", arguments: { content: "Agent A live via MCP" } }
      }
    })
    try check(() => assert.strictEqual(mcpPostA.status, 200))

    const mcpTradeA = try callApp("/mcp", {
      bearer: accessA,
      json: {
        jsonrpc: "2.0",
        id: 3,
        method: "tools/call",
        params: { name: "buy_prediction", arguments: { marketId: "seed-market-1", side: "yes", amountPts: 5 } }
      }
    })
    try check(() => assert.strictEqual(mcpTradeA.status, 200))

    const deviceStart = try callApp("/oauth/device", {
      json: { client_id: "device-agent-b", client_name: "JourneyAgentB", scope: "read social:write messages trade" }
    })
    try check(() => assert.strictEqual(deviceStart.status, 200))
    const deviceBody = try readJson(deviceStart)
    const approveRes = try callApp("/api/oauth/device/approve", {
      cookie: player.cookie,
      json: { userCode: String(deviceBody.user_code ?? "") }
    })
    try check(() => assert.strictEqual(approveRes.status, 200))
    const tokenBRes = try callApp("/oauth/token", {
      json: {
        grant_type: "urn:ietf:params:oauth:grant-type:device_code",
        device_code: String(deviceBody.device_code ?? ""),
        client_id: "device-agent-b"
      }
    })
    try check(() => assert.strictEqual(tokenBRes.status, 200))
    const tokenB = try readJson(tokenBRes)
    const accessB = String(tokenB.access_token ?? "")

    const revokedA = try callApp("/mcp", {
      bearer: accessA,
      json: {
        jsonrpc: "2.0",
        id: 4,
        method: "tools/call",
        params: { name: "whoami", arguments: {} }
      }
    })
    try check(() => assert.strictEqual(revokedA.status, 401))

    const activeB = try callApp("/mcp", {
      bearer: accessB,
      json: {
        jsonrpc: "2.0",
        id: 5,
        method: "tools/call",
        params: { name: "get_portfolio", arguments: {} }
      }
    })
    try check(() => assert.strictEqual(activeB.status, 200))

    const store = try Store
    const grantCount = try store.transaction((tx: Tx) =>
      tx.query("SELECT count(*) AS c FROM feed_agent_grants WHERE account_id = $1 AND status = 'active'", [String(player.account.accountId)])
    )
    try check(() => assert.strictEqual(toInt(grantCount[0]?.c), 1))

    const cronRes = try callApp("/api/cron/npc-tick", {
      method: "POST",
      headers: { authorization: "Bearer test-cron-secret" }
    })
    const lbRes = try callApp("/api/leaderboard")
    try check(() => assert.strictEqual(cronRes.status, 200))
    try check(() => assert.strictEqual(lbRes.status, 200))
  }
}, 180_000)

effect function readNextSseChunk(reader: ReadableStreamDefaultReader<Uint8Array>) {
  const step = try tryPromise({
    try: () => reader.read(),
    catch: () => new TestHttpFailure({ message: "Failed reading SSE stream" })
  })
  return decodeUtf8(step.value)
}

effect function beginReadSseChunk(reader: ReadableStreamDefaultReader<Uint8Array>) {
  return try Effect.try({
    try: () => startReadChunk(reader),
    catch: () => new TestHttpFailure({ message: "Failed starting SSE read" })
  })
}

effect function readSseEventsUntil(
  reader: ReadableStreamDefaultReader<Uint8Array>,
  firstPending: Promise<ReadableStreamReadResult<Uint8Array>> | undefined,
  needle: string
): ReadonlyArray<string>!TestHttpFailure {
  const frames: string[] = []
  let pending = firstPending
  for (let i = 0; i < 12; i += 1) {
    const chunk = pending !== undefined
      ? decodeUtf8((try tryPromise({
          try: () => pending!,
          catch: () => new TestHttpFailure({ message: "Failed awaiting SSE chunk" })
        })).value)
      : try readNextSseChunk(reader)
    pending = undefined
    if (chunk !== "" && !chunk.trim().startsWith(":")) {
      frames.push(chunk)
      if (chunk.includes(needle)) return frames
    }
  }
  return frames
}

it.effect('REST parity: fixed 100 pts capital, no Stripe routes, session revocation, leaderboard, perp preview/partial-close, chat invites/reactions, moderation, SSE isolation (spec/app/index.md, "Story: Browse, switch modes, and sign in through the JoinSheet")', effect () => {
  provide appLayer() {
    const now = Date.now()
    try TestClock.setTime(now)
    try seedWorld()

    const meLoopbackRes = try callApp("/api/auth/me")
    const meLoopback = try readJson(meLoopbackRes)
    const meTwilioRes = try callApp("/api/auth/me", { config: TWILIO_CONFIG })
    const meTwilio = try readJson(meTwilioRes)
    try check(() => assert.deepStrictEqual(
      {
        loopback: [meLoopback.turnstileSiteKey, meLoopback.devSmsCodeEnabled],
        twilio: [meTwilio.turnstileSiteKey, meTwilio.devSmsCodeEnabled]
      },
      {
        loopback: ["0x4AAAAAAB_test_site_key", true],
        twilio: [null, false]
      }
    ))

    const spoofedMetaRes = try callApp("/.well-known/oauth-authorization-server", {
      config: TWILIO_CONFIG,
      headers: { "x-forwarded-host": "evil.example", "x-forwarded-proto": "http" }
    })
    const spoofedMeta = try readJson(spoofedMetaRes)
    try check(() => assert.strictEqual(spoofedMeta.issuer, "https://feed.fun"))

    const alice = try onboardPhonePlayer("+14155550111", "parity_alice")
    const bob = try onboardPhonePlayer("+14155550112", "parity_bob")
    const charlie = try onboardPhonePlayer("+14155550113", "parity_charlie")
    const aliceId = String(alice.account.accountId)

    const aliceMeInitial = try readJson(try callApp("/api/auth/me", { cookie: alice.cookie }))
    const aliceViewerInitial = aliceMeInitial.viewer as Record<string, unknown>
    const packsRes = try callApp("/api/economy/packs")
    const checkoutRes = try callApp("/api/economy/checkout", { cookie: alice.cookie, json: { packId: "pack_5" } })
    const webhookRes = try callApp("/api/webhooks/stripe", { rawBody: "{}" })
    try check(() => assert.deepStrictEqual(
      {
        startingGrantCents: aliceViewerInitial.startingGrantCents,
        balanceCents: aliceViewerInitial.balanceCents,
        hasPurchasedCents: Object.prototype.hasOwnProperty.call(aliceViewerInitial, "purchasedCents"),
        removedStatuses: [packsRes.status, checkoutRes.status, webhookRes.status]
      },
      {
        startingGrantCents: 10_000,
        balanceCents: 10_000,
        hasPurchasedCents: false,
        removedStatuses: [404, 404, 404]
      }
    ))

    const badLevRes = try callApp("/api/markets/perp/XTRPC/open", {
      cookie: alice.cookie,
      json: { side: "long", collateralCents: 1000, leverage: 2.5 }
    })
    const badLevBody = try readJson(badLevRes)
    try check(() => assert.deepStrictEqual([badLevRes.status, badLevBody.code], [400, "INVALID_LEVERAGE"]))

    const predPreviewRes = try callApp("/api/markets/predictions/seed-market-1/preview", {
      cookie: alice.cookie,
      json: { side: "yes", amountCents: 500 }
    })
    const predPreviewBody = try readJson(predPreviewRes)
    const predPreview = predPreviewBody.preview as Record<string, unknown>
    try check(() => assert.strictEqual(predPreviewRes.status, 200))
    try check(() => assert.ok(Number(predPreview.sharesOut) > 0))

    const buyWithKey = effect (side: "yes" | "no", key: string) => {
      const response = try callApp("/api/markets/prediction/seed-market-1/buy", {
        cookie: alice.cookie,
        headers: { "Idempotency-Key": key },
        json: { side, amountCents: 500 }
      })
      return { status: response.status, body: try readJson(response) }
    }
    const key = "rest-idem-key-1"
    const buy = try buyWithKey("yes", key)
    const replay = try buyWithKey("yes", key)
    const conflict = try buyWithKey("no", key)
    const invalid = try buyWithKey("yes", "k".repeat(260))
    try check(() => assert.deepStrictEqual(
      {
        statuses: [buy.status, replay.status, conflict.status, invalid.status],
        sameTradeId: buy.body.tradeId === replay.body.tradeId,
        sameBalance: buy.body.balanceAfterCents === replay.body.balanceAfterCents,
        codes: [conflict.body.code, invalid.body.code]
      },
      {
        statuses: [200, 200, 409, 400],
        sameTradeId: true,
        sameBalance: true,
        codes: ["IDEMPOTENCY_CONFLICT", "INVALID_IDEMPOTENCY_KEY"]
      }
    ))

    const predHistoryRes = try callApp("/api/markets/predictions/seed-market-1/history?limit=20")
    const predTradesRes = try callApp("/api/markets/predictions/seed-market-1/trades?limit=20")
    const predHistory = (try readJson(predHistoryRes)).history as ReadonlyArray<Record<string, unknown>>
    const predTrades = (try readJson(predTradesRes)).trades as ReadonlyArray<Record<string, unknown>>
    try check(() => assert.deepStrictEqual(
      [predHistoryRes.status, predTradesRes.status, predHistory.length >= 1, predTrades.length >= 1],
      [200, 200, true, true]
    ))

    const perpPreviewRes = try callApp("/api/markets/perp/preview", {
      cookie: alice.cookie,
      json: { ticker: "XTRPC", side: "long", collateralCents: 1000, leverage: 2 }
    })
    const perpPreviewBody = try readJson(perpPreviewRes)
    const perpPreview = perpPreviewBody.preview as Record<string, unknown>
    try check(() => assert.strictEqual(perpPreviewRes.status, 200))
    try check(() => assert.deepStrictEqual(
      [perpPreview.ticker, perpPreview.action, Number(perpPreview.executionPriceCents) >= Number(perpPreview.preMarkPriceCents)],
      ["XTRPC", "open", true]
    ))

    const econBefore = try readJson(try callApp("/api/economy/me", { cookie: alice.cookie }))
    const balanceBeforePerp = Number((econBefore.economy as Record<string, unknown>).balanceCents)
    const sellPredRes = try callApp("/api/markets/predictions/seed-market-1/sell", {
      cookie: alice.cookie,
      json: { side: "yes", shareUnits: 100 }
    })
    try check(() => assert.strictEqual(sellPredRes.status, 200))
    const econAfterPredSell = try readJson(try callApp("/api/economy/me", { cookie: alice.cookie }))
    const balanceBeforePerpAfterSell = Number((econAfterPredSell.economy as Record<string, unknown>).balanceCents)
    try check(() => assert.ok(balanceBeforePerpAfterSell > balanceBeforePerp))
    const roundTripOpenRes = try callApp("/api/markets/perp/XTRPC/open", {
      cookie: alice.cookie,
      json: { side: "long", collateralCents: 1000, leverage: 3, maxSlippageBps: 500 }
    })
    const roundTripOpen = try readJson(roundTripOpenRes)
    try check(() => assert.strictEqual(roundTripOpenRes.status, 201))
    try check(() => assert.strictEqual(roundTripOpen.action, "open"))
    const rtPosId = String(roundTripOpen.positionId ?? "")

    const partialCloseRes = try callApp(`/api/markets/perp/positions/${encodeURIComponent(rtPosId)}/close`, {
      cookie: alice.cookie,
      json: { closePct: 50, maxSlippageBps: 500 }
    })
    const partialClose = try readJson(partialCloseRes)
    try check(() => assert.deepStrictEqual(
      [partialCloseRes.status, partialClose.isFullClose, Number(partialClose.remainingSizeCents) > 0],
      [200, false, true]
    ))

    const finalCloseRes = try callApp(`/api/markets/perp/positions/${encodeURIComponent(rtPosId)}/close`, {
      cookie: alice.cookie,
      json: {}
    })
    const finalClose = try readJson(finalCloseRes)
    try check(() => assert.deepStrictEqual(
      [finalCloseRes.status, finalClose.isFullClose, Number(finalClose.remainingSizeCents)],
      [200, true, 0]
    ))
    try check(() => assert.ok(Number(finalClose.balanceAfterCents) < balanceBeforePerpAfterSell))

    const perpHistoryRes = try callApp("/api/markets/perp/XTRPC/history?range=1D&limit=20")
    const perpTradesRes = try callApp("/api/markets/perp/XTRPC/trades?limit=20")
    const closedPosRes = try callApp("/api/markets/positions/closed?limit=20", { cookie: alice.cookie })
    const pnlHistRes = try callApp("/api/economy/me/pnl-history?range=ALL", { cookie: alice.cookie })
    const aliceTradesRes = try callApp("/api/users/parity_alice/trades?limit=20")
    const perpHistJson = try readJson(perpHistoryRes)
    const perpHistory = perpHistJson.history as ReadonlyArray<Record<string, unknown>>
    const perpPoints = perpHistJson.points as ReadonlyArray<Record<string, unknown>>
    const perpTrades = (try readJson(perpTradesRes)).trades as ReadonlyArray<Record<string, unknown>>
    const closedPos = try readJson(closedPosRes)
    const closedPerps = closedPos.perpPositions as ReadonlyArray<Record<string, unknown>>
    const closedItems = closedPos.items as ReadonlyArray<Record<string, unknown>>
    const pnlPoints = (try readJson(pnlHistRes)).points as ReadonlyArray<Record<string, unknown>>
    const aliceTrades = (try readJson(aliceTradesRes)).trades as ReadonlyArray<Record<string, unknown>>
    try check(() => assert.deepStrictEqual(
      [
        perpHistoryRes.status,
        perpTradesRes.status,
        closedPosRes.status,
        pnlHistRes.status,
        aliceTradesRes.status,
        perpHistory.length >= 2 && perpPoints.length >= 2,
        perpTrades.length >= 2,
        closedPerps.length >= 1 && closedItems.length >= 1,
        pnlPoints.length >= 2,
        aliceTrades.length >= 3
      ],
      [200, 200, 200, 200, 200, true, true, true, true, true]
    ))

    const lbPlayersRes = try callApp("/api/leaderboard?scope=players&metric=volume&page=1&pageSize=2", { cookie: alice.cookie })
    const lbPlayers = try readJson(lbPlayersRes)
    const lbCharsRes = try callApp("/api/leaderboard?scope=characters&metric=net_profit&page=1&pageSize=5")
    const lbChars = try readJson(lbCharsRes)
    const lbFilteredRes = try callApp("/api/leaderboard?filter=traders&timeframe=all&page=1&pageSize=10")
    const lbFiltered = try readJson(lbFilteredRes)
    const lbMeRes = try callApp("/api/leaderboard/me?metric=volume&pageSize=2", { cookie: alice.cookie })
    const lbMe = try readJson(lbMeRes)
    const lbMeFilteredRes = try callApp("/api/leaderboard/me?filter=traders&timeframe=all", { cookie: alice.cookie })
    const lbMeFiltered = try readJson(lbMeFilteredRes)
    try check(() => assert.deepStrictEqual(
      {
        statuses: [lbPlayersRes.status, lbCharsRes.status, lbFilteredRes.status, lbMeRes.status, lbMeFilteredRes.status],
        scopePlayers: lbPlayers.scope,
        metricPlayers: lbPlayers.metric,
        hasAlias: Array.isArray(lbPlayers.leaderboard) && Array.isArray(lbPlayers.entries),
        pageSize: lbPlayers.pageSize,
        hasCurrentUser: lbPlayers.currentUser !== null,
        charsCount: (lbChars.entries as ReadonlyArray<unknown>).length,
        filteredTradersCount: (lbFiltered.entries as ReadonlyArray<unknown>).length,
        hasMyRank: lbMe.position !== null && typeof lbMe.rank === "number",
        hasFilteredRank: typeof lbMeFiltered.rank === "number"
      },
      {
        statuses: [200, 200, 200, 200, 200],
        scopePlayers: "players",
        metricPlayers: "volume",
        hasAlias: true,
        pageSize: 2,
        hasCurrentUser: true,
        charsCount: 5,
        filteredTradersCount: 3,
        hasMyRank: true,
        hasFilteredRank: true
      }
    ))

    const worldStatusRes = try callApp("/api/world/status")
    const worldStatus = try readJson(worldStatusRes)
    const userSearchRes = try callApp("/api/users/search?q=parity")
    const userSearch = try readJson(userSearchRes)
    try check(() => assert.deepStrictEqual(
      [
        worldStatusRes.status,
        typeof worldStatus.currentDay === "number" && Number(worldStatus.activeMarketsCount) > 0 && Number(worldStatus.activeActorsCount) > 0,
        userSearchRes.status,
        (userSearch.items as ReadonlyArray<unknown>).length >= 2
      ],
      [200, true, 200, true]
    ))

    const badPatch = try callApp("/api/users/me", { method: "PATCH", cookie: alice.cookie, json: {} })
    const goodPatch = try callApp("/api/users/me", {
      method: "PATCH",
      cookie: alice.cookie,
      json: { displayName: "Alice Parity", bio: "Verified markets trader" }
    })
    const goodPatchBody = try readJson(goodPatch)
    const meAfterPatch = try readJson(try callApp("/api/auth/me", { cookie: alice.cookie }))
    const meViewer = meAfterPatch.viewer as Record<string, unknown>
    try check(() => assert.deepStrictEqual(
      {
        statuses: [badPatch.status, goodPatch.status],
        patched: [goodPatchBody.displayName, goodPatchBody.bio],
        me: [meViewer.displayName, meViewer.bio]
      },
      {
        statuses: [400, 200],
        patched: ["Alice Parity", "Verified markets trader"],
        me: ["Alice Parity", "Verified markets trader"]
      }
    ))

    const p1 = try callApp("/api/posts", { cookie: alice.cookie, json: { content: "Parity pagination post 1 #wave3alpha" } })
    const p1Body = try readJson(p1)
    const trendingTagRes = try callApp("/api/trending/wave3alpha")
    const trendingTag = try readJson(trendingTagRes)
    try check(() => assert.deepStrictEqual(
      [trendingTagRes.status, (trendingTag.posts as ReadonlyArray<unknown>).length >= 1],
      [200, true]
    ))
    try TestClock.adjust("2 seconds")
    const p2 = try callApp("/api/posts", { cookie: alice.cookie, json: { content: "Parity pagination post 2" } })
    try TestClock.adjust("2 seconds")
    const p3 = try callApp("/api/posts", { cookie: alice.cookie, json: { content: "Parity pagination post 3" } })
    try TestClock.adjust("2 seconds")
    const r1 = try callApp("/api/posts", {
      cookie: alice.cookie,
      json: { content: "Parity reply 1", replyToPostId: String(p1Body.id ?? "") }
    })
    try check(() => assert.deepStrictEqual([p1.status, p2.status, p3.status, r1.status], [201, 201, 201, 201]))

    const repliesOnlyRes = try callApp("/api/posts?authorHandle=parity_alice&filter=replies")
    const repliesOnlyBody = try readJson(repliesOnlyRes)
    const repliesOnlyItems = repliesOnlyBody.items as ReadonlyArray<Record<string, unknown>>
    try check(() => assert.deepStrictEqual([repliesOnlyRes.status, repliesOnlyItems.length], [200, 1]))

    const page1Res = try callApp("/api/users/parity_alice?limit=2")
    const page1 = try readJson(page1Res)
    const page1Posts = page1.posts as ReadonlyArray<Record<string, unknown>>
    const nextCursor = String(page1.nextCursor ?? "")
    try check(() => assert.strictEqual(page1Posts.length, 2))
    try check(() => assert.ok(nextCursor.length > 0))
    const page2Res = try callApp(`/api/users/parity_alice?limit=2&cursor=${encodeURIComponent(nextCursor)}`)
    const page2 = try readJson(page2Res)
    const page2Posts = page2.posts as ReadonlyArray<Record<string, unknown>>
    const page1Ids = new Set(page1Posts.map((p) => String(p.id)))
    try check(() => assert.strictEqual(page2Posts.length, 1))
    try check(() => assert.ok(!page1Ids.has(String(page2Posts[0]?.id ?? ""))))

    const npcDmRes = try callApp("/api/chats/direct", { cookie: bob.cookie, json: { targetHandleOrId: "ailonmusk" } })
    const npcDmBody = try readJson(npcDmRes)
    try check(() => assert.deepStrictEqual([npcDmRes.status, npcDmBody.code], [403, "NpcDmDisallowed"]))

    const dmRes = try callApp("/api/chats/direct", { cookie: alice.cookie, json: { targetHandleOrId: "parity_bob" } })
    const dmBody = try readJson(dmRes)
    const dmChatId = String((dmBody.chat as Record<string, unknown>).id ?? "")
    const dmMsgRes = try callApp(`/api/chats/${encodeURIComponent(dmChatId)}/messages`, {
      cookie: alice.cookie,
      json: { content: "Single bucket check" }
    })
    try check(() => assert.strictEqual(dmMsgRes.status, 201))
    const dmMsgBody = try readJson(dmMsgRes)
    const dmMsgId = String(dmMsgBody.id ?? "")

    const readChatRes = try callApp(`/api/chats/${encodeURIComponent(dmChatId)}/read`, { method: "POST", cookie: bob.cookie })
    const readChatBody = try readJson(readChatRes)
    try check(() => assert.deepStrictEqual([readChatRes.status, readChatBody.unreadCount], [200, 0]))

    const reactAddRes = try callApp(`/api/chats/${encodeURIComponent(dmChatId)}/messages/${encodeURIComponent(dmMsgId)}/reactions`, {
      method: "POST",
      cookie: bob.cookie,
      json: { emoji: "🔥" }
    })
    const reactAdd = try readJson(reactAddRes)
    const reactDelRes = try callApp(`/api/chats/${encodeURIComponent(dmChatId)}/messages/${encodeURIComponent(dmMsgId)}/reactions?emoji=${encodeURIComponent("🔥")}`, {
      method: "DELETE",
      cookie: bob.cookie
    })
    const reactDel = try readJson(reactDelRes)
    try check(() => assert.deepStrictEqual(
      [reactAddRes.status, reactAdd.added, reactDelRes.status, reactDel.added],
      [200, true, 200, false]
    ))

    const groupRes = try callApp("/api/chats/group", {
      cookie: alice.cookie,
      json: { title: "Alpha Desk", memberHandles: ["parity_charlie"] }
    })
    try check(() => assert.strictEqual(groupRes.status, 201))
    const groupChatId = String(((try readJson(groupRes)).chat as Record<string, unknown>).id ?? "")
    const charlieInvitesRes = try callApp("/api/chats/invites?kind=user_group", { cookie: charlie.cookie })
    const charlieInvites = (try readJson(charlieInvitesRes)).invites as ReadonlyArray<Record<string, unknown>>
    try check(() => assert.strictEqual(charlieInvitesRes.status, 200))
    try check(() => assert.strictEqual(charlieInvites.length, 1))
    const inviteId = String(charlieInvites[0]?.id ?? "")
    const acceptInviteRes = try callApp(`/api/chats/invites/${encodeURIComponent(inviteId)}/respond`, {
      cookie: charlie.cookie,
      json: { accept: true }
    })
    try check(() => assert.strictEqual(acceptInviteRes.status, 200))

    const renameRes = try callApp(`/api/chats/${encodeURIComponent(groupChatId)}`, {
      method: "PATCH",
      cookie: alice.cookie,
      json: { title: "Renamed Desk" }
    })
    const renameBody = try readJson(renameRes)
    const transferRes = try callApp(`/api/chats/${encodeURIComponent(groupChatId)}/transfer`, {
      cookie: alice.cookie,
      json: { newOwnerHandleOrId: "parity_charlie" }
    })
    const removeMemberRes = try callApp(`/api/chats/${encodeURIComponent(groupChatId)}/members/parity_alice`, {
      method: "DELETE",
      cookie: charlie.cookie
    })
    const deleteGroupRes = try callApp(`/api/chats/${encodeURIComponent(groupChatId)}`, {
      method: "DELETE",
      cookie: charlie.cookie
    })
    try check(() => assert.deepStrictEqual(
      [renameRes.status, (renameBody.chat as Record<string, unknown>).title, transferRes.status, removeMemberRes.status, deleteGroupRes.status],
      [200, "Renamed Desk", 200, 200, 200]
    ))

    const reportRes = try callApp("/api/reports", {
      cookie: alice.cookie,
      json: { targetKind: "account", targetId: "parity_bob", reason: "Spam bot behavior", category: "spam" }
    })
    const reportBody = try readJson(reportRes)
    const reportId = String(reportBody.id ?? "")
    try check(() => assert.deepStrictEqual([reportRes.status, reportBody.category], [201, "Spam"]))

    const clearNotifRes = try callApp("/api/notifications", { method: "DELETE", cookie: charlie.cookie })
    const clearNotifBody = try readJson(clearNotifRes)
    try check(() => assert.deepStrictEqual([clearNotifRes.status, clearNotifBody.unreadCount], [200, 0]))

    const store = try Store
    try store.transaction((tx: Tx) =>
      tx.query("UPDATE feed_accounts SET is_admin = true WHERE account_id = $1", [aliceId])
    )
    const adminReportsRes = try callApp("/api/admin/reports?status=open", { cookie: alice.cookie })
    const adminReports = (try readJson(adminReportsRes)).reports as ReadonlyArray<Record<string, unknown>>
    const patchReportRes = try callApp(`/api/admin/reports/${encodeURIComponent(reportId)}`, {
      method: "PATCH",
      cookie: alice.cookie,
      json: { status: "open" }
    })
    const resolveReportRes = try callApp(`/api/admin/reports/${encodeURIComponent(reportId)}/resolve`, {
      cookie: alice.cookie,
      json: { status: "reviewed" }
    })
    const adminUsersRes = try callApp("/api/admin/users?q=parity", { cookie: alice.cookie })
    const adminUsers = (try readJson(adminUsersRes)).users as ReadonlyArray<Record<string, unknown>>
    const adminFactCreateRes = try callApp("/api/admin/world-facts", {
      cookie: alice.cookie,
      json: { factText: "Wave 3 integrated world fact", category: "markets" }
    })
    const factId = String((try readJson(adminFactCreateRes)).id ?? "")
    const adminFactsListRes = try callApp("/api/admin/world-facts", { cookie: alice.cookie })
    const adminFacts = (try readJson(adminFactsListRes)).facts as ReadonlyArray<Record<string, unknown>>
    const adminFactDelRes = try callApp(`/api/admin/world-facts/${encodeURIComponent(factId)}`, {
      method: "DELETE",
      cookie: alice.cookie
    })
    const cancelMarketRes = try callApp("/api/admin/markets/seed-market-2/cancel", {
      method: "POST",
      cookie: alice.cookie
    })
    const cancelMarketBody = try readJson(cancelMarketRes)
    try check(() => assert.deepStrictEqual(
      [
        adminReportsRes.status,
        adminReports.some((r) => String(r.id) === reportId),
        patchReportRes.status,
        resolveReportRes.status,
        adminUsersRes.status,
        adminUsers.length >= 2,
        adminFactCreateRes.status,
        adminFactsListRes.status,
        adminFacts.some((f) => String(f.id) === factId),
        adminFactDelRes.status,
        cancelMarketRes.status,
        cancelMarketBody.status
      ],
      [200, true, 200, 200, 200, true, 201, 200, true, 200, 200, "cancelled"]
    ))

    const rlRows = try store.transaction((tx: Tx) =>
      tx.query(
        "SELECT scope_key, count FROM feed_rate_limits WHERE scope_key IN ($1, $2, $3) ORDER BY scope_key ASC",
        [`${aliceId}:dm`, `${aliceId}:post`, `${aliceId}:trade`]
      )
    )
    const countsByKey = Object.fromEntries(rlRows.map((r) => [String(r.scope_key), toInt(r.count)]))
    try check(() => assert.deepStrictEqual(countsByKey, {
      [`${aliceId}:dm`]: 1,
      [`${aliceId}:post`]: 4,
      [`${aliceId}:trade`]: 9
    }))

    const anonAbort = makeAbortController()
    const aliceAbort = makeAbortController()
    const anonSseRes = try callApp("/api/events", { signal: anonAbort.signal })
    const aliceSseRes = try callApp("/api/events", { cookie: alice.cookie, signal: aliceAbort.signal })
    const anonReader = getBodyReader(anonSseRes)
    const aliceReader = getBodyReader(aliceSseRes)

    const anonConnected = try readNextSseChunk(anonReader)
    const aliceConnected = try readNextSseChunk(aliceReader)
    try check(() => assert.ok(anonConnected.includes(": connected")))
    try check(() => assert.ok(aliceConnected.includes(": connected")))

    const anonNext = try beginReadSseChunk(anonReader)
    const aliceNext = try beginReadSseChunk(aliceReader)
    try Effect.yieldNow

    const blockRes = try callApp("/api/users/parity_bob/block", { method: "POST", cookie: alice.cookie })
    const muteRes = try callApp("/api/users/parity_charlie/mute", { method: "POST", cookie: alice.cookie })
    try check(() => assert.deepStrictEqual([blockRes.status, muteRes.status], [200, 200]))

    const blocksListRes = try callApp("/api/moderation/blocks", { cookie: alice.cookie })
    const mutesListRes = try callApp("/api/moderation/mutes", { cookie: alice.cookie })
    const blocksItems = (try readJson(blocksListRes)).items as ReadonlyArray<Record<string, unknown>>
    const mutesItems = (try readJson(mutesListRes)).items as ReadonlyArray<Record<string, unknown>>
    try check(() => assert.deepStrictEqual(
      [blocksListRes.status, blocksItems.length, mutesListRes.status, mutesItems.length],
      [200, 1, 200, 1]
    ))

    const bobOpenPos = try callApp("/api/markets/perp/XTRPC/open", {
      cookie: bob.cookie,
      json: { side: "long", collateralCents: 1000, leverage: 2 }
    })
    try check(() => assert.strictEqual(bobOpenPos.status, 201))
    const blockedProfileRes = try callApp("/api/users/parity_bob", { cookie: alice.cookie })
    const blockedProfile = try readJson(blockedProfileRes)
    const blockedPositions = blockedProfile.positions as Record<string, unknown>
    try check(() => assert.deepStrictEqual(
      [
        blockedProfileRes.status,
        (blockedPositions.perpPositions as ReadonlyArray<unknown>).length,
        (blockedPositions.predictionPositions as ReadonlyArray<unknown>).length
      ],
      [200, 0, 0]
    ))

    const privateDmForBob = try callApp("/api/chats/direct", { cookie: bob.cookie, json: { targetHandleOrId: "parity_charlie" } })
    const bobDmId = String(((try readJson(privateDmForBob)).chat as Record<string, unknown>).id ?? "")
    try callApp(`/api/chats/${encodeURIComponent(bobDmId)}/messages`, {
      cookie: bob.cookie,
      json: { content: "Private message hidden from unauth SSE" }
    })
    try callApp("/api/posts", {
      cookie: bob.cookie,
      json: { content: "Blocked author post hidden from Alice SSE" }
    })

    const perpOpenRes = try callApp("/api/markets/perp/XTRPC/open", {
      cookie: alice.cookie,
      json: { side: "long", collateralCents: 1000, leverage: 2 }
    })
    try check(() => assert.strictEqual(perpOpenRes.status, 201))
    const perpOpened = try readJson(perpOpenRes)
    const perpPosId = String(perpOpened.positionId ?? "")

    const perpCloseRes = try callApp(`/api/markets/perp/positions/${encodeURIComponent(perpPosId)}/close`, {
      method: "POST",
      cookie: alice.cookie,
      json: {}
    })
    try check(() => assert.strictEqual(perpCloseRes.status, 200))

    const anonFrames = try readSseEventsUntil(anonReader, anonNext, '"action":"close"')
    const aliceFrames = try readSseEventsUntil(aliceReader, aliceNext, '"action":"close"')

    anonAbort.abort()
    aliceAbort.abort()

    const anonJoined = anonFrames.join("\n")
    const aliceJoined = aliceFrames.join("\n")
    try check(() => assert.deepStrictEqual(
      {
        anonHasNoPrivateChat: !anonJoined.includes("event: chat.message"),
        anonHasPerpOpen: anonJoined.includes("event: market.perp") && anonJoined.includes('"action":"open"'),
        aliceHasNoBlockedPost: !aliceJoined.includes("event: post.created"),
        aliceHasPerpOpen: aliceJoined.includes("event: market.perp") && aliceJoined.includes('"action":"open"'),
        aliceHasPerpClose: aliceJoined.includes("event: market.perp") && aliceJoined.includes('"action":"close"') && aliceJoined.includes('"leverage":2')
      },
      {
        anonHasNoPrivateChat: true,
        anonHasPerpOpen: true,
        aliceHasNoBlockedPost: true,
        aliceHasPerpOpen: true,
        aliceHasPerpClose: true
      }
    ))

    try TestClock.adjust("11 minutes")
    const stalePhoneChangeRes = try callApp("/api/auth/phone/change/start", {
      cookie: alice.cookie,
      json: { newPhoneE164: "+14155550188" }
    })
    const stalePhoneChangeBody = try readJson(stalePhoneChangeRes)
    try check(() => assert.deepStrictEqual(
      [stalePhoneChangeRes.status, stalePhoneChangeBody.code],
      [403, "old_phone_verification_required"]
    ))

    const logoutRes = try callApp("/api/auth/logout", { method: "POST", cookie: alice.cookie })
    const reusedCookieEconomyRes = try callApp("/api/economy/me", { cookie: alice.cookie })
    const reusedCookieMeBody = try readJson(try callApp("/api/auth/me", { cookie: alice.cookie }))
    try check(() => assert.deepStrictEqual(
      [logoutRes.status, reusedCookieEconomyRes.status, reusedCookieMeBody.authenticated],
      [200, 401, false]
    ))
  }
}, 180_000)
it.effect('Session cookie slides with the server session (spec/app/index.md, "Story: Browse, switch modes, and sign in through the JoinSheet")', effect () => {
  provide appLayer() {
    try TestClock.setTime(Date.now())
    try seedWorld()
    const player = try onboardPhonePlayer("+14155550155", "sliding_session")

    const meFresh = try callApp("/api/auth/me", { cookie: player.cookie })
    const meFreshBody = try readJson(meFresh)
    try check(() => assert.strictEqual(meFreshBody.authenticated, true))
    try check(() => assert.strictEqual(meFresh.headers.get("set-cookie"), null))

    try TestClock.adjust("25 days")
    const marketsLater = try callApp("/api/markets", { cookie: player.cookie })
    try check(() => assert.strictEqual(marketsLater.status, 200))
    const refreshedMaxAge = sessionCookieMaxAge(marketsLater.headers.get("set-cookie"))
    const refreshedPair = extractSessionCookie(marketsLater)
    try check(() => assert.deepStrictEqual(
      { refreshedMaxAge, sameToken: refreshedPair === player.cookie },
      { refreshedMaxAge: 30 * 86_400, sameToken: true }
    ))
    const meLater = try callApp("/api/auth/me", { cookie: player.cookie })
    const meLaterBody = try readJson(meLater)
    try check(() => assert.strictEqual(meLaterBody.authenticated, true))
    try check(() => assert.strictEqual(meLater.headers.get("set-cookie"), null))
    try TestClock.adjust("25 days")
    const meStill = try callApp("/api/auth/me", { cookie: player.cookie })
    const meStillBody = try readJson(meStill)
    try check(() => assert.strictEqual(meStillBody.authenticated, true))
  try TestClock.adjust("20 days")
  const marketsDay70 = try callApp("/api/markets", { cookie: player.cookie })
  try check(() => assert.strictEqual(marketsDay70.status, 200))
  const cappedMaxAge = sessionCookieMaxAge(marketsDay70.headers.get("set-cookie"))
  const cappedPair = extractSessionCookie(marketsDay70)
  try check(() => assert.deepStrictEqual(
   { cappedMaxAge, sameToken: cappedPair === player.cookie },
   { cappedMaxAge: 20 * 86_400, sameToken: true }
  ))
  }
}, 180_000)
