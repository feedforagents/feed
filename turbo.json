{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["QUINT_HOME"],
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "vibestack/*.ts",
    "vibestack/gen/**",
    "vibestack/proof/**",
    "vibestack/std/**",
    "vibestack/testing/**",
    "vibestack/stories/**",
    "vibestack/design/**",
    "!vibestack/**/{node_modules,.cache}/**",
    "!vibestack/selftest.ts",
    "!vibestack/remote-cache.ts",
    "!vibestack/proof/lib.dfy",
    "!vibestack/{testing,stories,design}/test/**",
    ".cache/toolchain.json"
  ],
  "tasks": {
    "gen": {
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "@repo/ui#gen": {
      "dependsOn": [
        "//#gen",
        "@repo/design-system#build"
      ],
      "outputs": [
        "generated/**"
      ]
    },
    "@repo/ui#storybook:build": {
      "dependsOn": [
        "@repo/design-system#build",
        "@repo/ui#gen"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "test:deploy": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "ALCHEMY_FAST_DISTILLED",
        "ALCHEMY_TEST_STAGE",
        "ALCHEMY_STAGE"
      ]
    },
    "deploy": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "CLOUDFLARE_*",
        "ALCHEMY_*",
        "R2_STATE_*",
        "COMMIT_SHA",
        "GITHUB_SHA",
        "CRON_SECRET",
        "SURPLUS_API_KEY",
        "CLOUDFLARE_RUNTIME_SECRETS"
      ]
    },
    "check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser"
      ],
      "cache": false
    },
    "vibestack-studio#check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser",
        "//#build"
      ],
      "cache": false
    },
    "//#gen": {
      "env": ["!VITE_*"],
      "inputs": [
        "spec/**",
        "apps/*/package.json",
        "apps/*/spec/**",
        "packages/*/package.json",
        "packages/*/spec/**",
        "package.json"
      ],
      "outputs": [
        "gen/**",
        "apps/*/gen/**",
        "packages/*/gen/**"
      ]
    },
    "//#build": {
      "dependsOn": [
        "vibestack-studio#build"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/selftest.ts",
        "!vibestack/selftests/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!vibestack/fixtures/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,.alchemy,.wrangler,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#typecheck": {
      "dependsOn": [
        "//#gen"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,.alchemy,.wrangler,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "spec/**",
        "src/**",
        "test/**"
      ],
      "outputs": []
    },
    "//#test": {
      "dependsOn": [
        "//#gen",
        "^build"
      ],
      "inputs": [
        "*",
        "!.git",
        "!*.md",
        "!docs/**",
        "!vendor/**",
        "vibestack/**",
        "!vibestack/{examples,studio}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,.alchemy,.wrangler,generated,storybook-static}/**",
        "!**/.DS_Store",
        "spec/**",
        "!spec/**/*.md",
        "src/**",
        "test/**"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#check": {
      "dependsOn": [
        "//#build",
        "//#typecheck",
        "//#test",
        "@repo/design-system#build",
        "@repo/ui#build",
        "@repo/pack-default#build",
        "@repo/db#build",
        "@repo/markets#build",
        "@repo/social#build",
        "@repo/auth#build",
        "@repo/engine#build",
        "@repo/mcp#build",
        "@repo/app#build",
        "@repo/app#typecheck",
        "@repo/app#test",
        "@repo/app#test:browser"
      ],
      "cache": false
    },
    "//#lint:js": {
      "dependsOn": [
        "@repo/design-system#build",
        "@repo/cli#typecheck",
        "@repo/ui#typecheck",
        "@repo/pack-default#typecheck",
        "@repo/db#typecheck",
        "@repo/markets#typecheck",
        "@repo/social#typecheck",
        "@repo/auth#typecheck",
        "@repo/engine#typecheck",
        "@repo/mcp#typecheck",
        "@repo/app#typecheck",
        "vibestack-studio#typecheck"
      ],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!vendor/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,.alchemy,.wrangler,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts"
      ],
      "outputs": []
    },
    "//#lint:css": {
      "inputs": [
        "**/*.css",
        "!.claude/**",
        "!vendor/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,.alchemy,.wrangler,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "!vibestack/{examples,fixtures}/**",
        "stylelint.config.js",
        "package.json",
        "pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "//#analyze": {
      "dependsOn": ["//#gen", "@repo/design-system#build", "@repo/ui#gen", "vibestack-studio#gen"],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!vendor/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,.alchemy,.wrangler,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts",
        ".madgerc",
        ".jscpd.json"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#studio": {
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#gen": {
      "env": ["!VITE_*"],
      "outputs": ["gen/**", "generated/**"]
    },
    "vibestack-studio#dev": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#build": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "vibestack-studio#typecheck": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "vibestack-studio#test": {
      "dependsOn": [
        "gen",
        "^build",
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/fixtures/**",
        "$TURBO_ROOT$/vibestack/proof/lib.dfy",
        "!$TURBO_ROOT$/vibestack/fixtures/**/.DS_Store"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "vibestack-studio#test:browser": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/ui#build": {
      "dependsOn": [
        "^build",
        "gen"
      ],
      "inputs": [
        "package.json",
        "src/**",
        "styles.css",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "@repo/cli#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/cli#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/ui#typecheck": {
      "dependsOn": [
        "^build",
        "gen"
      ],
      "outputs": []
    },
    "@repo/design-system#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "generated/**",
        "design.md"
      ]
    }
  },
  "remoteCache": {
    "apiUrl": "https://vibestack-turbo-cache.shawmakesmagic.workers.dev",
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 60,
    "teamSlug": "vibestack"
  }
}
