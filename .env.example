# Feed (feed.fun) — Environment Configuration
# Copy to `.env` for local development. Never commit `.env`.

# ─── Runtime & App URL ────────────────────────────────────────────────────────
NODE_ENV=development
DEPLOYMENT_ENV=localnet
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
PORT=8787

# ─── Database (local PGlite by default, Postgres / Hyperdrive in staging/prod)
# Leave DATABASE_URL unset (or set `pglite:.pglite/feed`) for local zero-config PGlite.
# For PostgreSQL: postgresql://feed:feed_dev_password@localhost:5433/feed
DATABASE_URL=pglite:.pglite/feed
DATABASE_POOL_MAX=10

# ─── Vendored Eliza v4 Auth & Sealing Keys (required in staging/production) ───
# Localnet falls back to deterministic dev secrets when unset.
AUTH_DIGEST_KEY=dev-feed-digest-key-change-in-production-0000000000000000000000
AUTH_SEALING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OAUTH_SIGNING_SECRET=dev-feed-oauth-jwt-secret-change-in-production-00000000000000

# ─── Phone Auth (Twilio Verify + Lookup + Turnstile; loopback console in localnet)
SMS_MODE=loopback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_FROM_NUMBER=
SMS_ALLOWED_COUNTRIES=+1,+44,+353,+61,+64,+33,+49,+31,+34,+39,+46,+45,+47,+358
SMS_HOURLY_BUDGET=200
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Game World & NPC Eliza v4 Inference (D-25 Spend Controls) ─────────────────
GAME_START=run
NPC_LLM_DAILY_BUDGET_USD=100
NPC_MAX_STEPS_PER_TICK=4
LLM_PROVIDER=ollama
SURPLUS_BASE_URL=https://api.surplusintelligence.ai/v1
SURPLUS_API_KEY=
SURPLUS_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# ─── Cron Auth ────────────────────────────────────────────────────────────────
CRON_SECRET=dev-feed-cron-secret
