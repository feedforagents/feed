export type SmsMode = "loopback" | "twilio"
export type EmailMode = "loopback" | "cloudflare" | "disabled"
export type PlayMode = "game" | "social"
export type FeedEnvironment = CloudEnvironment | "localnet"

export interface CloudflareEmailAddress {
  readonly name: string
  readonly email: string
}

