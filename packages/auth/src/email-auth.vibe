// spec/auth/email.md, "Story: Request and consume a single-use email magic link safely"; spec/auth/email.md, "Only valid non-disposable emails, Turnstile-verified requests, and rate-limited addresses receive a magic link"; spec/auth/email.md, "Magic links are single-use, expire in 15 minutes, and purge pending secrets on consume or expiry"; spec/auth/email.md, "Story: Onboard once, link or change email, sign out everywhere, or delete after cooldown"; spec/auth/email.md, "Email onboarding requires username, 18+ attestation, and Terms, and issues 100 pts once per verified email"; spec/auth/email.md, "Linking or changing an email requires an active non-reviewer account, an unused address, and recent sign-in or first link"
import {
  Store,
  type StoreFailure,
  resolveUserPresetAvatarUrl,
  resolveUserPresetBannerUrl,
  toInt,
  toText,
  type Tx
} from "@repo/db"
