// spec/auth/phone.md, "Story: Verify a phone number safely without magic links or SMS pumping"; spec/auth/oauth.md, "Story: Authorize one MCP client over OAuth 2.1 or Device Flow and rotate tokens safely"; spec/shared/limits.md, "Posts, DMs, and trades share one hourly budget across web and MCP"
export error AuthFailure {
  code: string
  message: string
  status: number
}

export error RateLimited {
  message: string
  retryAfterSeconds: number
  action?: string
}

export error UnauthorizedError {
  code: string
  message: string
}
