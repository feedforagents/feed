// spec/auth/oauth.md, "Story: Authorize one MCP client over OAuth 2.1 or Device Flow and rotate tokens safely"; spec/auth/oauth.md, "Clients register via CIMD or DCR for hosted callbacks or RFC 8252 loopback redirects only"; spec/auth/oauth.md, "Authorization requires PKCE S256, code flow, normalized resource, and preserves 400+ character state across one 4-scope consent screen"; spec/auth/oauth.md, "Rotating refresh tokens cap grants at 90 days and revoke the entire grant family on reuse"; spec/auth/oauth.md, "Story: Authorize headless agents through RFC 8628 device flow at `/link`"; spec/auth/oauth.md, "Exchanging an approved device code issues tokens and atomically replaces any prior connected agent"
import { type Row, Store, type StoreFailure, toInt, toText, type Tx } from "@repo/db"
import { HttpClientRequest } from "effect/http"
