  canApproveConsent,
  canApproveDeviceFlow,
  canExchangeAuthCode,
  canExchangeDeviceCode,
  canRefreshOAuthToken,
  canRegisterClient,
  canRevokeOAuthGrant,
  canStartAuthorization,
  canStartDeviceFlow,
  canonicalDeviceUri,
  canonicalIssuer,
  canonicalMcpResource,
  deviceCodeLifetimeMs,
  emptyFamily,
  exchangeAuthCode,
  exchangeDeviceCode,
  idleAuth,
  idleDeviceAuth,
  initial,
  isRefreshReuse,
  maxGrantLifetimeMs,
  normalizeResource as specNormalizeResource,
  redirectAllowed,
  refreshOAuthToken,
  registerClient,
  resourceAllowed,
  revokeOAuthGrant,
  startAuthorization,
  startDeviceFlow,
  type OAuthState,
  type RedirectKind
} from "../gen/auth__oauth.effect.vibe"
import type { ScopeSet } from "../gen/auth__agentGrant.effect.vibe"
