// spec/auth/phone.md, "Story: Verify a phone number safely without magic links or SMS pumping"; spec/auth/phone.md, "Story: Onboard once, change phone, sign out everywhere, or delete after cooldown"; spec/auth/phone.md, "Story: Admit directory reviewer password sign-in only for `isReviewer` accounts"; spec/auth/email.md, "Story: Request and consume a single-use email magic link safely"; spec/auth/email.md, "Story: Onboard once, link or change email, sign out everywhere, or delete after cooldown"; spec/auth/agentGrant.md, "Story: Connect at most one agent per account with clear attribution"; spec/auth/oauth.md, "Story: Authorize one MCP client over OAuth 2.1 or Device Flow and rotate tokens safely"; spec/auth/oauth.md, "Story: Authorize headless agents through RFC 8628 device flow at `/link`"; spec/shared/limits.md, "Posts, DMs, and trades share one hourly budget across web and MCP"
import { assert, it } from "@effect/vitest"
import { TestClock } from "effect/testing"
import { Store, StoreFailure, migrateFeedSchema, seedFeedWorld, toInt, toText, type Tx } from "@repo/db"
import { localStoreLayer } from "@repo/db/node"
import {
  ACTION_HOURLY_LIMITS,
  AuthFailure,
  DEFAULT_ALLOWED_COUNTRIES,
  RateLimited,
  UnauthorizedError,
  approveDeviceAuthorization,
  authenticateSessionCookie,
  checkAndConsumeRateLimit,
  checkAndConsumeRateLimitInTx,
  checkOAuthEndpointRateLimit,
  completeEmailOnboarding,
  completeOnboarding,
  completePhoneOnboarding,
  confirmPhoneChange,
  createAuthorizationCode,
  deleteAccountSelfServe,
  exchangeOAuthToken,
  fetchClientMetadata,
  getAccountProfile,
  getActiveAgentGrant,
  getLoopbackCode,
  getLoopbackMagicLink,
  getRateLimitStatus,
  hashEmail,
  hashReviewerPassword,
  isDisallowedRemoteHost,
  lookupDeviceCodeForUser,
  normalizeResource,
  rateLimitScopeKey,
  recordAgentAttribution,
  redirectUriMatchesRegistered,
  registerDynamicClient,
  requestEmailMagicLink,
  requestPhoneChange,
  revokeSession,
  signInReviewerPassword,
  signOutEverywhere,
  startDeviceAuthorization,
  startEmailLink,
  startPhoneLink,
  startPhoneVerification,
  verifyAccessToken,
  verifyEmailMagicLink,
  verifyPhoneCode,
  type AuthRuntimeConfig,
  type CloudflareEmailMessage
} from "../src/index.vibe"
import { insertCloudAccountTx } from "../src/phone-auth.vibe"

module node {
  import { createHash, createHmac } from "node:crypto"
  import { createServer } from "node:net"

  /** @throws {never} */
  export function pkceChallengeS256(verifier: string): string {
    return createHash("sha256").update(verifier, "utf8").digest("base64url")
  }

  /** @throws {never} */
  export function hmacSha256Hex(key: string, input: string): string {
    return createHmac("sha256", key).update(input, "utf8").digest("hex")
  }

  export function installTwilioFetchStub(onFirstVerify: () => Promise<void>): () => void {
    const originalFetch = globalThis.fetch
    let firstVerifyDone = false
    const stubFetch = (async (input: Parameters<typeof fetch>[0], init?: Parameters<typeof fetch>[1]) => {
      const url = typeof input === "string" ? input : input instanceof URL ? input.toString() : input.url
      if (url.includes("lookups.twilio.com")) {
        return new Response(JSON.stringify({ valid: true, country_code: "US", line_type_intelligence: { type: "mobile" } }), { status: 200, headers: { "content-type": "application/json" } })
      }
      if (url.includes("/Verifications")) {
        if (!firstVerifyDone) {
          firstVerifyDone = true
          await onFirstVerify()
        }
        return new Response(JSON.stringify({ sid: "VE00000000000000000000000000000000", status: "pending" }), { status: 201, headers: { "content-type": "application/json" } })
      }
      return originalFetch(input, init)
    }) as typeof fetch
    globalThis.fetch = stubFetch
    return () => {
      globalThis.fetch = originalFetch
    }
  }

  /** @throws {unknown} */
  export async function startCountingTcpProbe(): Promise<{
    readonly port: number
    readonly getHits: () => number
    readonly close: () => Promise<void>
  }> {
    let hits = 0
    const server = createServer((socket) => {
      hits += 1
      socket.destroy()
    })
    await new Promise<void>((resolve, reject) => {
      server.once("error", reject)
      server.listen(0, "127.0.0.1", () => resolve())
    })
    const addr = server.address()
    const port = typeof addr === "object" && addr !== null ? addr.port : 0
    return {
      port,
      getHits: () => hits,
      close: () => new Promise<void>((resolve) => server.close(() => resolve()))
    }
  }
}
import { hmacSha256Hex, installTwilioFetchStub, pkceChallengeS256, startCountingTcpProbe } from node

const localnetConfig: AuthRuntimeConfig = {
  digestKey: "dev-digest-key-change-in-production-32-bytes",
  oauthSigningSecret: "dev-oauth-signing-secret-change-in-prod-32-bytes",
  smsMode: "loopback",
  turnstileSiteKey: "0x4AAAAAAA_localnet_site_key",
  allowedCountries: DEFAULT_ALLOWED_COUNTRIES,
  publicAppUrl: "http://localhost:5173"
}

const NINETY_DAYS_MS = 90 * 86_400_000
const FIFTEEN_MINUTES_MS = 15 * 60_000

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function withFeedStore<A, E>(body: A!E!Store) {
  provide localStoreLayer({ kind: "pglite", file: undefined }) {
    try migrateFeedSchema()
    try seedFeedWorld()
    return try body
  }
}

effect function sqlQuery(sql: string, params: ReadonlyArray<unknown> = []) {
  const store = try Store
  return try store.transaction((tx: Tx) => tx.query(sql, params))
}

function failureCode(err: unknown): string {
  if (err instanceof AuthFailure) return err.code
  if (err instanceof UnauthorizedError) return err.code
  if (err instanceof RateLimited) return `rate_limited:${err.action ?? ""}`
  if (err instanceof StoreFailure) return `store_failure:${err.operation}`
  return String(err)
}

effect function refusedCode<A, E, R>(program: A!E!R): string!!R {
  return effect {
    const value = try program
    return `unexpected_success:${JSON.stringify(value)}`
  } catch (err) => failureCode(err)
}

effect function refusedStatusAndCode<A, E, R>(program: A!E!R): string!!R {
  return effect {
    const value = try program
    return `unexpected_success:${JSON.stringify(value)}`
  } catch (err) => err instanceof AuthFailure ? `${err.status}:${err.code}` : failureCode(err)
}

function rateLimitDetail(err: unknown): { readonly tag: string; readonly action: string | undefined; readonly retryAfterPositive: boolean } {
  if (err instanceof RateLimited) {
    return { tag: err._tag, action: err.action, retryAfterPositive: err.retryAfterSeconds >= 1 }
  }
  return { tag: failureCode(err), action: undefined, retryAfterPositive: false }
}

effect function expectRateLimited<A, E, R>(program: A!E!R) {
  return effect {
    const value = try program
    return { tag: `unexpected_success:${JSON.stringify(value)}`, action: undefined as string | undefined, retryAfterPositive: false }
  } catch (err) => rateLimitDetail(err)
}

function cookiePairOf(setCookieHeader: string): string {
  return setCookieHeader.split(";")[0] ?? setCookieHeader
}

effect function verifyBearer(accessToken: string, expectedResource?: string) {
  return try verifyAccessToken({
    authorizationHeader: `Bearer ${accessToken}`,
    config: localnetConfig,
    ...(expectedResource === undefined ? {} : { expectedResource })
  })
}

effect function onboardViaPhone(phoneE164: string, username: string) {
  try startPhoneVerification({ phoneE164, config: localnetConfig })
  const code = getLoopbackCode(phoneE164, localnetConfig)
  if (code === undefined) {
    return try Effect.die(`Missing loopback code for ${phoneE164}`)
  }
  const verified = try verifyPhoneCode({ phoneE164, code, config: localnetConfig })
  if (!verified.needsOnboarding) {
    return try Effect.die(`Expected onboarding state for ${phoneE164}`)
  }
  return try completePhoneOnboarding({
    pendingToken: verified.pendingToken,
    username,
    accepted18Plus: true,
    acceptedTerms: true,
    config: localnetConfig
  })
}

effect function provisionReviewerAccount(handle: string, password: string) {
  const passwordHash = try hashReviewerPassword(password)
  const now = try Clock.currentTimeMillis
  const accountId = `rev-${handle}`
  const organizationId = `org-${handle}`
  const stateJson = JSON.stringify({
    status: "Active",
    userId: accountId,
    organizationId,
    identities: []
  })
  const store = try Store
  try store.transaction(effect (tx: Tx) => {
    try insertCloudAccountTx(tx, {
      accountId,
      organizationId,
      displayName: handle,
      stateJson,
      now
    })
    try tx.query(
      `INSERT INTO feed_accounts
         (account_id, handle, display_name, bio, avatar_url, phone_hash, phone_last2, phone_verified_at, age_confirmed_at, ui_mode, balance_cents, starting_grant_cents, total_fees_paid_cents, is_admin, is_reviewer, reviewer_password_hash, created_at, updated_at)
       VALUES ($1, $2, $3, '', NULL, NULL, NULL, NULL, $4, 'game', 0, 0, 0, false, true, $5, $4, $4)`,
      [accountId, handle, handle, now, passwordHash]
    )
  })
  return accountId
}

it.effect('Phone auth onboarding, lockout, reviewer password gate, session revocation, phone change gate, sign-out everywhere, and 30-day deletion cooldown (spec/auth/phone.md, "Story: Verify a phone number safely without magic links or SMS pumping"; spec/auth/phone.md, "Only allowed countries, non-VoIP lines, Turnstile-verified requests, and rate-limited numbers receive a 6-digit autofill code"; spec/auth/phone.md, "Codes expire in 10 minutes, lock after 5 wrong attempts, and verify without leaking secrets"; spec/auth/phone.md, "Story: Onboard once, change phone, sign out everywhere, or delete after cooldown"; spec/auth/phone.md, "Onboarding requires username, 18+ self-attestation, and Terms, and issues 100 pts once per verified phone"; spec/auth/phone.md, "Changing phone requires verifying the old phone or support recovery and an unused new number"; spec/auth/phone.md, "Sign out everywhere bumps `sessionsEpoch`, and self-serve deletion holds the phone hash for 30 days"; spec/auth/phone.md, "Story: Admit directory reviewer password sign-in only for `isReviewer` accounts"; spec/auth/phone.md, "Username and password sign-in is admitted solely when `isReviewer` is true (D-29)")', () => effect {
  try TestClock.setTime(Date.now())
  try withFeedStore(effect {
    const phone = "+14155550101"
    const disallowedCountry = try refusedCode(startPhoneVerification({ phoneE164: "+74951234567", config: localnetConfig }))
    const started = try startPhoneVerification({ phoneE164: phone, config: localnetConfig })
    const lockedCode = getLoopbackCode(phone, localnetConfig)
    if (lockedCode === undefined) return try Effect.die("Missing initial loopback code")
    const wrongCode = lockedCode === "000000" ? "111111" : "000000"
    const attemptResults: string[] = []
    for (let i = 0; i < 5; i += 1) {
      attemptResults.push(try refusedCode(verifyPhoneCode({ phoneE164: phone, code: wrongCode, config: localnetConfig })))
    }
    const rightAfterLock = try refusedCode(verifyPhoneCode({ phoneE164: phone, code: lockedCode, config: localnetConfig }))
    const rapidResend = try refusedCode(startPhoneVerification({ phoneE164: phone, config: localnetConfig }))

    try TestClock.adjust("31 seconds")
    try startPhoneVerification({ phoneE164: phone, config: localnetConfig })
    const secondCode = getLoopbackCode(phone, localnetConfig)
    if (secondCode === undefined) return try Effect.die("Missing second loopback code")
    const verified = try verifyPhoneCode({ phoneE164: phone, code: secondCode, config: localnetConfig })
    if (!verified.needsOnboarding) return try Effect.die("Expected needsOnboarding=true")

    const underageRefusal = try refusedCode(completePhoneOnboarding({
      pendingToken: verified.pendingToken,
      username: "alice",
      accepted18Plus: false,
      acceptedTerms: true,
      config: localnetConfig
    }))
    const onboarded = try completePhoneOnboarding({
      pendingToken: verified.pendingToken,
      username: "alice",
      accepted18Plus: true,
      acceptedTerms: true,
      config: localnetConfig
    })
    const initialCookie = cookiePairOf(onboarded.sessionCookieHeader)
    const authedInitial = try authenticateSessionCookie(initialCookie, localnetConfig)

    const nonReviewerRefused = try refusedCode(signInReviewerPassword({
      usernameOrId: "alice",
      password: "reviewer-pass-123",
      config: localnetConfig
    }))
    try provisionReviewerAccount("reviewer_demo", "reviewer-pass-123")
    const wrongReviewerPass = try refusedCode(signInReviewerPassword({
      usernameOrId: "reviewer_demo",
      password: "wrong-password-1",
      config: localnetConfig
    }))
    const reviewerSignedIn = try signInReviewerPassword({
      usernameOrId: "reviewer_demo",
      password: "reviewer-pass-123",
      config: localnetConfig
    })
    const reviewerCookie1 = cookiePairOf(reviewerSignedIn.sessionCookieHeader)
    const reviewerSession = try authenticateSessionCookie(reviewerCookie1, localnetConfig)
    const reviewerSignedInSecond = try signInReviewerPassword({
      usernameOrId: "reviewer_demo",
      password: "reviewer-pass-123",
      config: localnetConfig
    })
    const reviewerCookie2 = cookiePairOf(reviewerSignedInSecond.sessionCookieHeader)
    const revokedOnce = try revokeSession(reviewerSession?.sessionKey ?? "")
    const revokedTwice = try revokeSession(reviewerSession?.sessionKey ?? "")
    const reviewerCookie1AfterRevoke = try authenticateSessionCookie(reviewerCookie1, localnetConfig)
    const reviewerCookie2AfterRevoke = try authenticateSessionCookie(reviewerCookie2, localnetConfig)

    const signedOut = try signOutEverywhere(onboarded.account.accountId)
    const afterSignOut = try authenticateSessionCookie(initialCookie, localnetConfig)

    try TestClock.adjust("31 seconds")
    try startPhoneVerification({ phoneE164: phone, config: localnetConfig })
    const reauthCode = getLoopbackCode(phone, localnetConfig)
    if (reauthCode === undefined) return try Effect.die("Missing re-auth loopback code")
    const reauthed = try verifyPhoneCode({ phoneE164: phone, code: reauthCode, config: localnetConfig })
    if (reauthed.needsOnboarding) return try Effect.die("Expected existing account sign-in")
    const reauthedCookie = cookiePairOf(reauthed.sessionCookieHeader)
    const reauthedSession = try authenticateSessionCookie(reauthedCookie, localnetConfig)
    if (reauthedSession === null) return try Effect.die("Expected authenticated re-auth session")

    const newPhone = "+14155550177"
    const phoneChangeMissingProof = try refusedCode(requestPhoneChange({
      accountId: onboarded.account.accountId,
      newPhoneE164: newPhone,
      config: localnetConfig
    }))
    const phoneChangeExplicitFalse = try refusedCode(requestPhoneChange({
      accountId: onboarded.account.accountId,
      newPhoneE164: newPhone,
      authAt: reauthedSession.authAt,
      oldPhoneVerifiedOrRecovery: false,
      config: localnetConfig
    }))
    try TestClock.adjust("11 minutes")
    const phoneChangeStaleAuthAt = try refusedCode(requestPhoneChange({
      accountId: onboarded.account.accountId,
      newPhoneE164: newPhone,
      authAt: reauthedSession.authAt,
      config: localnetConfig
    }))
    const phoneChangeStaleCookie = try refusedCode(requestPhoneChange({
      accountId: onboarded.account.accountId,
      newPhoneE164: newPhone,
      cookieHeader: reauthedCookie,
      config: localnetConfig
    }))
    const phoneChangeViaRecovery = try requestPhoneChange({
      accountId: onboarded.account.accountId,
      newPhoneE164: newPhone,
      oldPhoneVerifiedOrRecovery: true,
      config: localnetConfig
    })
    const recoveryChangeCode = getLoopbackCode(newPhone, localnetConfig)
    if (recoveryChangeCode === undefined) return try Effect.die("Missing phone-change loopback code")
    const phoneChanged = try confirmPhoneChange({
      accountId: onboarded.account.accountId,
      newPhoneE164: newPhone,
      code: recoveryChangeCode,
      config: localnetConfig
    })
    const changedCookie = cookiePairOf(phoneChanged.sessionCookieHeader)
    const changedSession = try authenticateSessionCookie(changedCookie, localnetConfig)
    if (changedSession === null) return try Effect.die("Expected authenticated phone-changed session")
    const recentPhoneChange = try requestPhoneChange({
      accountId: onboarded.account.accountId,
      newPhoneE164: "+14155550178",
      cookieHeader: changedCookie,
      config: localnetConfig
    })

    const peer = try onboardViaPhone("+14155550199", "peer_user")
    const aliceId = onboarded.account.accountId
    const peerId = peer.account.accountId
    const seedNow = try Clock.currentTimeMillis
    const actorRows = try sqlQuery("SELECT id FROM feed_actors ORDER BY id ASC LIMIT 1")
    const seededActorId = toText(actorRows[0]?.id)
    if (seededActorId === undefined) return try Effect.die("Missing seeded actor for cooldown test")
    try sqlQuery(
      `INSERT INTO feed_posts (id, author_id, author_kind, content, reply_to_post_id, like_count, repost_count, reply_count, created_at)
       VALUES
         ('post-shared', $1, 'user', 'Shared post', NULL, 2, 2, 3, $3),
         ('post-solo', $1, 'user', 'Solo post', NULL, 1, 1, 0, $3),
         ('post-floor', $1, 'user', 'Zero floor post', NULL, 0, 0, 0, $3),
         ('post-alice-root', $2, 'user', 'Alice post', NULL, 0, 0, 0, $3),
         ('post-alice-reply-1', $2, 'user', 'Alice reply 1', 'post-shared', 0, 0, 0, $3),
         ('post-alice-reply-2', $2, 'user', 'Alice reply 2', 'post-shared', 0, 0, 0, $3),
         ('post-peer-reply', $1, 'user', 'Peer reply', 'post-shared', 0, 0, 0, $3)`,
      [peerId, aliceId, seedNow]
    )
    for (const engagementTable of ["feed_post_likes", "feed_post_reposts"]) {
      try sqlQuery(
        `INSERT INTO ${engagementTable} (post_id, account_id, created_at)
         VALUES
           ('post-shared', $1, $3),
           ('post-shared', $2, $3),
           ('post-solo', $1, $3),
           ('post-floor', $1, $3)`,
        [aliceId, peerId, seedNow]
      )
    }
    try sqlQuery(
      `INSERT INTO feed_follows (follower_id, target_id, target_kind, created_at)
       VALUES
         ($1, $2, 'user', $3),
         ($2, $1, 'user', $3),
         ($2, 'npc-1', 'npc', $3)`,
      [aliceId, peerId, seedNow]
    )
    try sqlQuery(
      `INSERT INTO feed_blocks (blocker_id, blocked_id, created_at)
       VALUES
         ($1, $2, $3),
         ($2, $1, $3),
         ($2, 'npc-1', $3)`,
      [aliceId, peerId, seedNow]
    )
    try sqlQuery(
      `INSERT INTO feed_mutes (muter_id, muted_id, created_at)
       VALUES
         ($1, $2, $3),
         ($2, $1, $3),
         ($2, 'npc-1', $3)`,
      [aliceId, peerId, seedNow]
    )
    try sqlQuery(
      `INSERT INTO feed_alpha_invite_cooldowns (actor_id, account_id, decline_count, next_eligible_at, updated_at)
       VALUES
         ($1, $2, 1, $4, $5),
         ($1, $3, 1, $4, $5)`,
      [seededActorId, aliceId, peerId, seedNow + 60_000, seedNow]
    )
    try sqlQuery(
      `INSERT INTO feed_chats (id, kind, name, created_by, created_at)
       VALUES ('chat-del-1', 'group', 'Test Group', $1, $2)`,
      [peerId, seedNow]
    )
    try sqlQuery(
      `INSERT INTO feed_chat_members (chat_id, member_id, member_kind, role, joined_at)
       VALUES
         ('chat-del-1', $1, 'user', 'member', $3),
         ('chat-del-1', $2, 'user', 'owner', $3)`,
      [aliceId, peerId, seedNow]
    )
    try sqlQuery(
      `INSERT INTO feed_messages (id, chat_id, sender_id, sender_kind, body, created_at)
       VALUES ('msg-del-1', 'chat-del-1', $1, 'user', 'hello', $2)`,
      [peerId, seedNow]
    )
    try sqlQuery(
      `INSERT INTO feed_message_reactions (message_id, account_id, emoji, created_at)
       VALUES
         ('msg-del-1', $1, 'fire', $3),
         ('msg-del-1', $2, 'fire', $3)`,
      [aliceId, peerId, seedNow]
    )
    try sqlQuery(
      `INSERT INTO feed_group_invites (id, chat_id, invited_account_id, invited_by_id, status, created_at)
       VALUES
         ('inv-recv', 'chat-del-1', $1, 'npc-1', 'pending', $3),
         ('inv-sent', 'chat-del-1', $2, $1, 'pending', $3),
         ('inv-peer', 'chat-del-1', $2, 'npc-1', 'pending', $3)`,
      [aliceId, peerId, seedNow]
    )
    try sqlQuery(
      `INSERT INTO feed_notifications (id, account_id, kind, actor_id, title, body, created_at)
       VALUES
         ('notif-recv', $1, 'like', $2, 'Liked', 'body', $3),
         ('notif-actor', $2, 'follow', $1, 'Followed', 'body', $3),
         ('notif-peer', $2, 'system', 'npc-1', 'Keep', 'body', $3)`,
      [aliceId, peerId, seedNow]
    )

    const deleted = try deleteAccountSelfServe({
      accountId: aliceId,
      cookieHeader: changedCookie,
      config: localnetConfig
    })
    const postCountsAfterDelete = try sqlQuery(
      "SELECT id, like_count, repost_count, reply_count, deleted_at IS NOT NULL AS is_deleted FROM feed_posts WHERE id IN ('post-shared', 'post-solo', 'post-floor', 'post-alice-root', 'post-alice-reply-1', 'post-alice-reply-2', 'post-peer-reply') ORDER BY id ASC"
    )
    const remainingLikes = try sqlQuery(
      "SELECT post_id, account_id FROM feed_post_likes WHERE post_id IN ('post-shared', 'post-solo', 'post-floor') ORDER BY post_id, account_id"
    )
    const remainingReposts = try sqlQuery(
      "SELECT post_id, account_id FROM feed_post_reposts WHERE post_id IN ('post-shared', 'post-solo', 'post-floor') ORDER BY post_id, account_id"
    )
    const remainingFollows = try sqlQuery(
      "SELECT follower_id, target_id FROM feed_follows WHERE follower_id IN ($1, $2) OR target_id IN ($1, $2) ORDER BY follower_id, target_id",
      [aliceId, peerId]
    )
    const remainingBlocks = try sqlQuery(
      "SELECT blocker_id, blocked_id FROM feed_blocks WHERE blocker_id IN ($1, $2) OR blocked_id IN ($1, $2) ORDER BY blocker_id, blocked_id",
      [aliceId, peerId]
    )
    const remainingMutes = try sqlQuery(
      "SELECT muter_id, muted_id FROM feed_mutes WHERE muter_id IN ($1, $2) OR muted_id IN ($1, $2) ORDER BY muter_id, muted_id",
      [aliceId, peerId]
    )
    const remainingCooldowns = try sqlQuery(
      "SELECT account_id FROM feed_alpha_invite_cooldowns WHERE account_id IN ($1, $2) ORDER BY account_id",
      [aliceId, peerId]
    )
    const remainingChatMembers = try sqlQuery(
      "SELECT member_id FROM feed_chat_members WHERE chat_id = 'chat-del-1' ORDER BY member_id"
    )
    const remainingReactions = try sqlQuery(
      "SELECT account_id FROM feed_message_reactions WHERE message_id = 'msg-del-1' ORDER BY account_id"
    )
    const remainingInvites = try sqlQuery(
      "SELECT id FROM feed_group_invites WHERE chat_id = 'chat-del-1' ORDER BY id"
    )
    const remainingNotifications = try sqlQuery(
      "SELECT id FROM feed_notifications WHERE id IN ('notif-recv', 'notif-actor', 'notif-peer') ORDER BY id"
    )
    const afterDeleteSession = try authenticateSessionCookie(changedCookie, localnetConfig)
    const profileAfterDelete = try refusedCode(getAccountProfile(aliceId))
    const cooldownBlocked = try refusedCode(startPhoneVerification({ phoneE164: newPhone, config: localnetConfig }))

    try TestClock.adjust("30 days")
    try startPhoneVerification({ phoneE164: newPhone, config: localnetConfig })
    const postCooldownCode = getLoopbackCode(newPhone, localnetConfig)
    if (postCooldownCode === undefined) return try Effect.die("Missing post-cooldown loopback code")
    const postCooldownVerified = try verifyPhoneCode({ phoneE164: newPhone, code: postCooldownCode, config: localnetConfig })

    const racePhone = "+14155550155"
    const raceOutcomes = try Effect.all(
      [
        Effect.result(startPhoneVerification({ phoneE164: racePhone, config: localnetConfig })),
        Effect.result(startPhoneVerification({ phoneE164: racePhone, config: localnetConfig }))
      ],
      { concurrency: "unbounded" }
    )
    const raceResults = [...raceOutcomes.map((outcome) =>
      outcome._tag === "Failure" ? failureCode(outcome.failure) : "ok"
    )].sort()
    const racePhoneHash = hmacSha256Hex(localnetConfig.digestKey, racePhone)
    const raceRows = try sqlQuery(
      "SELECT key, phase FROM code_challenges WHERE method = 'sms' AND destination_digest = $1 ORDER BY sent_at",
      [racePhoneHash]
    )
    const raceCode = getLoopbackCode(racePhone, localnetConfig)
    if (raceCode === undefined) return try Effect.die("Missing race loopback code")
    const raceVerified = try verifyPhoneCode({ phoneE164: racePhone, code: raceCode, config: localnetConfig })

    const outOfOrderPhone = "+14155550156"
    const outOfOrderPhoneHash = hmacSha256Hex(localnetConfig.digestKey, outOfOrderPhone)
    const twilioConfig: AuthRuntimeConfig = {
      ...localnetConfig,
      smsMode: "twilio",
      twilioAccountSid: "AC00000000000000000000000000000000",
      twilioAuthToken: "test-twilio-auth-token",
      twilioVerifyServiceSid: "VA00000000000000000000000000000000"
    }
    const store = try Store
    const testClock = try TestClock.testClockWith((clock) => Effect.succeed(clock))
    const outOfOrderNested: Array<string> = []
    const restoreTwilioFetch = try Effect.try(() => installTwilioFetchStub(async () => {
      if (outOfOrderNested.length > 0) return
      outOfOrderNested.push("running")
      await runPromise(Effect.provide(
        sqlQuery(
          "UPDATE code_challenges SET sent_at = sent_at - 31000 WHERE method = 'sms' AND purpose_key = 'sign-in' AND destination_digest = $1 AND phase = 'unsent'",
          [outOfOrderPhoneHash]
        ),
        Layer.succeed(Store, store)
      ))
      const nestedStarted = await runPromise(Effect.provide(
        Effect.provide(
          startPhoneVerification({ phoneE164: outOfOrderPhone, config: twilioConfig }),
          Layer.succeed(Store, store)
        ),
        Layer.succeed(Clock.Clock, testClock)
      )).then(
        (started) => {
          outOfOrderNested[0] = "ok"
          return started
        },
        (err: unknown) => {
          outOfOrderNested[0] = failureCode(err)
          return undefined
        }
      )
      if (nestedStarted !== undefined) {
        await runPromise(Effect.provide(
          sqlQuery("UPDATE code_challenges SET sent_at = sent_at + 31000 WHERE key = $1", [nestedStarted.challengeId]),
          Layer.succeed(Store, store)
        ))
      }
    }))
    const outOfOrderFirst = try Effect.result(startPhoneVerification({ phoneE164: outOfOrderPhone, config: twilioConfig }))
    const outOfOrderFirstOutcome = outOfOrderFirst._tag === "Failure" ? failureCode(outOfOrderFirst.failure) : "ok"
    try Effect.try(() => restoreTwilioFetch())
    const outOfOrderRows = try sqlQuery(
      "SELECT key, phase FROM code_challenges WHERE method = 'sms' AND destination_digest = $1 ORDER BY sent_at",
      [outOfOrderPhoneHash]
    )

    try check(() => assert.deepStrictEqual(
      {
        disallowedCountry,
        startedLast2: started.last2,
        codeFormat: /^\d{6}$/.test(lockedCode),
        attemptResults,
        rightAfterLock,
        rapidResend,
        verifiedOnboarding: [verified.needsOnboarding, verified.last2],
        underageRefusal,
        onboardedGrant: [
          onboarded.account.handle,
          onboarded.account.balanceCents,
          onboarded.account.startingGrantCents,
          "purchasedCents" in onboarded.account,
          authedInitial?.accountId === onboarded.account.accountId,
          authedInitial?.balanceCents,
          authedInitial?.sessionsEpoch
        ],
        reviewer: [
          nonReviewerRefused,
          wrongReviewerPass,
          reviewerSignedIn.account.isReviewer,
          reviewerSession?.handle,
          reviewerSession?.isReviewer
        ],
        singleSessionRevoke: [
          revokedOnce.revoked,
          revokedTwice.revoked,
          reviewerCookie1AfterRevoke,
          reviewerCookie2AfterRevoke?.handle
        ],
        phoneChange: [
          phoneChangeMissingProof,
          phoneChangeExplicitFalse,
          phoneChangeStaleAuthAt,
          phoneChangeStaleCookie,
          phoneChangeViaRecovery.last2,
          phoneChanged.account.phoneLast2,
          recentPhoneChange.last2
        ],
        signOut: [signedOut.sessionsEpoch, afterSignOut],
        deletion: [
          deleted.deleted,
          deleted.cooldownEndsAt > 0,
          afterDeleteSession,
          profileAfterDelete,
          cooldownBlocked
        ],
        deletionCleanup: {
          postCounts: postCountsAfterDelete.map((row) => [
            toText(row.id),
            toInt(row.like_count),
            toInt(row.repost_count),
            toInt(row.reply_count),
            row.is_deleted === true
          ]),
          likes: remainingLikes.map((row) => [toText(row.post_id), toText(row.account_id) === peerId]),
          reposts: remainingReposts.map((row) => [toText(row.post_id), toText(row.account_id) === peerId]),
          follows: remainingFollows.map((row) => [toText(row.follower_id) === peerId, toText(row.target_id)]),
          blocks: remainingBlocks.map((row) => [toText(row.blocker_id) === peerId, toText(row.blocked_id)]),
          mutes: remainingMutes.map((row) => [toText(row.muter_id) === peerId, toText(row.muted_id)]),
          alphaCooldowns: remainingCooldowns.map((row) => toText(row.account_id) === peerId),
          chatMembers: remainingChatMembers.map((row) => toText(row.member_id) === peerId),
          reactions: remainingReactions.map((row) => toText(row.account_id) === peerId),
          invites: remainingInvites.map((row) => toText(row.id)),
          notifications: remainingNotifications.map((row) => toText(row.id))
        },
        turnstileSiteKeyConfigured: localnetConfig.turnstileSiteKey,
        postCooldownOnboarding: postCooldownVerified.needsOnboarding,
        phoneParallelRace: {
          results: raceResults,
          rows: raceRows.map((row) => toText(row.phase)),
          verifiedNeedsOnboarding: raceVerified.needsOnboarding
        },
        phoneOutOfOrderSupersession: {
          first: outOfOrderFirstOutcome,
          nested: outOfOrderNested[0] ?? "missing",
          rows: outOfOrderRows.map((row) => toText(row.phase))
        }
      },
      {
        disallowedCountry: "country_not_allowed",
        startedLast2: "01",
        codeFormat: true,
        attemptResults: ["invalid_code", "invalid_code", "invalid_code", "invalid_code", "challenge_locked"],
        rightAfterLock: "challenge_locked",
        rapidResend: "rate_limited:sms_send",
        verifiedOnboarding: [true, "01"],
        underageRefusal: "attestation_required",
        onboardedGrant: ["alice", 10_000, 10_000, false, true, 10_000, 1],
        reviewer: ["reviewer_signin_refused", "reviewer_signin_refused", true, "reviewer_demo", true],
        singleSessionRevoke: [true, false, null, "reviewer_demo"],
        phoneChange: [
          "old_phone_verification_required",
          "old_phone_verification_required",
          "old_phone_verification_required",
          "old_phone_verification_required",
          "77",
          "77",
          "78"
        ],
        signOut: [2, null],
        deletion: [true, true, null, "account_not_found", "phone_cooldown"],
        deletionCleanup: {
          postCounts: [
            ["post-alice-reply-1", 0, 0, 0, true],
            ["post-alice-reply-2", 0, 0, 0, true],
            ["post-alice-root", 0, 0, 0, true],
            ["post-floor", 0, 0, 0, false],
            ["post-peer-reply", 0, 0, 0, false],
            ["post-shared", 1, 1, 1, false],
            ["post-solo", 0, 0, 0, false]
          ],
          likes: [["post-shared", true]],
          reposts: [["post-shared", true]],
          follows: [[true, "npc-1"]],
          blocks: [[true, "npc-1"]],
          mutes: [[true, "npc-1"]],
          alphaCooldowns: [true],
          chatMembers: [true],
          reactions: [true],
          invites: ["inv-peer"],
          notifications: ["notif-peer"]
        },
        turnstileSiteKeyConfigured: "0x4AAAAAAA_localnet_site_key",
        postCooldownOnboarding: true,
        phoneParallelRace: {
          results: ["ok", "rate_limited:sms_send"],
          rows: ["open"],
          verifiedNeedsOnboarding: true
        },
        phoneOutOfOrderSupersession: {
          first: "challenge_not_found",
          nested: "ok",
          rows: ["unsent", "open"]
        }
      }
    ))
  })
}, 180_000)

it.effect('OAuth 2.1 DCR, PKCE S256, 420-char state, normalized audience, RFC 8628 single-agent replacement, refresh rotation, and reuse revocation (spec/auth/oauth.md, "Story: Authorize one MCP client over OAuth 2.1 or Device Flow and rotate tokens safely"; spec/auth/oauth.md, "Clients register via CIMD or DCR for hosted callbacks or RFC 8252 loopback redirects only"; spec/auth/oauth.md, "Authorization requires PKCE S256, code flow, normalized resource, and preserves 400+ character state across one 4-scope consent screen"; spec/auth/oauth.md, "Rotating refresh tokens cap grants at 90 days and revoke the entire grant family on reuse"; spec/auth/oauth.md, "Story: Authorize headless agents through RFC 8628 device flow at `/link`"; spec/auth/oauth.md, "Exchanging an approved device code issues tokens and atomically replaces any prior connected agent"; spec/auth/agentGrant.md, "Story: Connect at most one agent per account with clear attribution"; spec/auth/agentGrant.md, "Connecting a new agent atomically revokes any prior active grant")', () => effect {
  try TestClock.setTime(Date.now())
  try withFeedStore(effect {
    const onboarded = try onboardViaPhone("+14155550102", "bob")
    const accountId = onboarded.account.accountId

    const badRedirect = try refusedCode(registerDynamicClient({
      clientName: "Insecure Client",
      redirectUris: ["http://evil.example/cb"]
    }))
    const redirectUriA = "https://claude.ai/api/mcp/auth_callback"
    const clientA = try registerDynamicClient({
      clientName: "Claude Desktop",
      redirectUris: [redirectUriA],
      scope: "read social:write messages trade"
    })
    const verifierA = `verifier-claude-${"v".repeat(32)}`
    const challengeA = pkceChallengeS256(verifierA)
    const state420 = "s".repeat(420)

    const plainRefused = try refusedCode(createAuthorizationCode({
      accountId,
      clientId: clientA.client_id,
      redirectUri: redirectUriA,
      codeChallenge: challengeA,
      codeChallengeMethod: "plain",
      responseType: "code",
      state: state420,
      resource: "https://feed.fun/mcp/"
    }))
    const badResource = try refusedCode(createAuthorizationCode({
      accountId,
      clientId: clientA.client_id,
      redirectUri: redirectUriA,
      codeChallenge: challengeA,
      codeChallengeMethod: "S256",
      responseType: "code",
      state: state420,
      resource: "https://evil.example/mcp"
    }))

    const authCode = try createAuthorizationCode({
      accountId,
      clientId: clientA.client_id,
      redirectUri: redirectUriA,
      codeChallenge: challengeA,
      codeChallengeMethod: "S256",
      responseType: "code",
      scope: "read social:write messages trade",
      state: state420,
      resource: "https://feed.fun/mcp/"
    })
    const wrongVerifier = try refusedCode(exchangeOAuthToken({
      grantType: "authorization_code",
      code: authCode.code,
      codeVerifier: `wrong-verifier-${"w".repeat(32)}`,
      clientId: clientA.client_id,
      redirectUri: redirectUriA,
      resource: "https://feed.fun/mcp/",
      config: localnetConfig
    }))
    const tokenA = try exchangeOAuthToken({
      grantType: "authorization_code",
      code: authCode.code,
      codeVerifier: verifierA,
      clientId: clientA.client_id,
      redirectUri: redirectUriA,
      resource: "https://feed.fun/mcp/",
      config: localnetConfig
    })
    const tokenARows = try sqlQuery(
      "SELECT token_kind, expires_at FROM feed_oauth_tokens WHERE grant_id = $1 ORDER BY token_kind ASC",
      [tokenA.grant_id]
    )
    const tokenALifetimeDelta = toInt(tokenARows[1]?.expires_at) - toInt(tokenARows[0]?.expires_at)
    const verifiedA = try verifyBearer(tokenA.access_token, "https://feed.fun/mcp/")

    const clientB = try registerDynamicClient({
      clientName: "Hermes CLI",
      redirectUris: ["http://127.0.0.1:43123/callback"],
      scope: "read trade"
    })
    const deviceAuth = try startDeviceAuthorization({
      clientId: clientB.client_id,
      scope: "read trade",
      resource: "https://feed.fun/mcp/",
      origin: "https://feed.fun"
    })
    const deviceExchangeInput = {
      grantType: "urn:ietf:params:oauth:grant-type:device_code" as const,
      deviceCode: deviceAuth.device_code,
      clientId: clientB.client_id,
      resource: "https://feed.fun/mcp/",
      config: localnetConfig
    }
    const pendingDeviceExchange = try refusedCode(exchangeOAuthToken(deviceExchangeInput))
    const deviceApproved = try approveDeviceAuthorization({
      accountId,
      userCode: deviceAuth.user_code,
      scopes: ["read", "trade"]
    })
    const tokenB = try exchangeOAuthToken(deviceExchangeInput)

    const tokenAAfterSwap = try refusedCode(verifyBearer(tokenA.access_token))
    const attribAAfterSwap = try refusedCode(recordAgentAttribution(accountId, tokenA.grant_id))
    const verifiedB = try verifyBearer(tokenB.access_token)
    const attribB = try recordAgentAttribution(accountId, tokenB.grant_id)
    const grantsAfterSwap = try sqlQuery(
      "SELECT grant_id, status FROM feed_agent_grants WHERE account_id = $1 ORDER BY created_at ASC",
      [accountId]
    )
    const activeGrantsAfterSwap = grantsAfterSwap.filter((row) => toText(row.status) === "active")

    const rotatedB = try exchangeOAuthToken({
      grantType: "refresh_token",
      refreshToken: tokenB.refresh_token,
      clientId: clientB.client_id,
      resource: "https://feed.fun/mcp",
      config: localnetConfig
    })
    const verifiedRotatedB = try verifyBearer(rotatedB.access_token)

    const replayedOldRefresh = try refusedCode(exchangeOAuthToken({
      grantType: "refresh_token",
      refreshToken: tokenB.refresh_token,
      clientId: clientB.client_id,
      config: localnetConfig
    }))
    const newRefreshAfterReuse = try refusedCode(exchangeOAuthToken({
      grantType: "refresh_token",
      refreshToken: rotatedB.refresh_token,
      clientId: clientB.client_id,
      config: localnetConfig
    }))
    const accessBAfterReuse = try refusedCode(verifyBearer(tokenB.access_token))
    const rotatedAccessAfterReuse = try refusedCode(verifyBearer(rotatedB.access_token))
    const activeGrantAfterReuse = try getActiveAgentGrant(accountId)
    const unrevokedTokensAfterReuse = try sqlQuery(
      "SELECT count(*) AS count FROM feed_oauth_tokens WHERE grant_id = $1 AND revoked_at IS NULL",
      [tokenB.grant_id]
    )
    const activeGrantRowsAfterReuse = try sqlQuery(
      "SELECT count(*) AS count FROM feed_agent_grants WHERE account_id = $1 AND status = 'active'",
      [accountId]
    )

    const lateCode = try createAuthorizationCode({
      accountId,
      clientId: clientA.client_id,
      redirectUri: redirectUriA,
      codeChallenge: challengeA,
      codeChallengeMethod: "S256",
      responseType: "code",
      scope: "read",
      state: "late",
      resource: "https://feed.fun/mcp"
    })
    try TestClock.adjust("5 minutes")
    const expiredCodeExchange = try refusedCode(exchangeOAuthToken({
      grantType: "authorization_code",
      code: lateCode.code,
      codeVerifier: verifierA,
      clientId: clientA.client_id,
      redirectUri: redirectUriA,
      resource: "https://feed.fun/mcp",
      config: localnetConfig
    }))

    try check(() => assert.deepStrictEqual(
      {
        badRedirect,
        clientAAuthMethod: clientA.token_endpoint_auth_method,
        enforced: [plainRefused, badResource, wrongVerifier],
        authCode: [authCode.state.length === 420, authCode.state === state420, authCode.resource],
        tokenA: [
          tokenA.token_type, tokenA.expires_in, tokenA.resource, normalizeResource("https://feed.fun/mcp/"),
          tokenA.refresh_token.startsWith("feed_rt_"), tokenARows.map((row) => toText(row.token_kind)), tokenALifetimeDelta
        ],
        verifiedA: [
          verifiedA.activeGrant, verifiedA.grantId === tokenA.grant_id,
          verifiedA.clientId === clientA.client_id, verifiedA.clientName, verifiedA.scopes
        ],
        deviceFlow: [
          deviceAuth.verification_uri, /^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$/.test(deviceAuth.user_code),
          pendingDeviceExchange, deviceApproved.approved, tokenB.grant_id !== tokenA.grant_id, tokenB.resource
        ],
        singleAgentReplacement: [
          tokenAAfterSwap, attribAAfterSwap, verifiedB.activeGrant, verifiedB.clientName, verifiedB.scopes,
          attribB.viaClientName, grantsAfterSwap.map((row) => toText(row.status)),
          activeGrantsAfterSwap.length <= 1, activeGrantsAfterSwap.length
        ],
        rotationAndReuse: [
          rotatedB.grant_id === tokenB.grant_id, rotatedB.refresh_token !== tokenB.refresh_token,
          rotatedB.access_token !== tokenB.access_token, verifiedRotatedB.activeGrant,
          replayedOldRefresh, newRefreshAfterReuse, accessBAfterReuse, rotatedAccessAfterReuse,
          activeGrantAfterReuse, toInt(unrevokedTokensAfterReuse[0]?.count), toInt(activeGrantRowsAfterReuse[0]?.count)
        ],
        expiredCodeExchange
      },
      {
        badRedirect: "invalid_redirect_uri",
        clientAAuthMethod: "none",
        enforced: ["invalid_request", "invalid_target", "invalid_grant"],
        authCode: [true, true, "https://feed.fun/mcp"],
        tokenA: ["Bearer", 900, "https://feed.fun/mcp", "https://feed.fun/mcp", true, ["access", "refresh"], NINETY_DAYS_MS - FIFTEEN_MINUTES_MS],
        verifiedA: [true, true, true, "Claude Desktop", ["read", "social:write", "messages", "trade"]],
        deviceFlow: ["https://feed.fun/link", true, "authorization_pending", true, true, "https://feed.fun/mcp"],
        singleAgentReplacement: ["token_revoked", "grant_revoked", true, "Hermes CLI", ["read", "trade"], "Hermes CLI", ["revoked", "active"], true, 1],
        rotationAndReuse: [true, true, true, true, "reused_revoked", "invalid_grant", "token_revoked", "token_revoked", null, 0, 0],
        expiredCodeExchange: "invalid_grant"
      }
    ))
  })
}, 180_000)

it.effect('Web and MCP share one per-account hourly rate-limit budget and exhaustion hits both identically (spec/shared/limits.md, "Posts, DMs, and trades share one hourly budget across web and MCP"; spec/shared/limits.md, "Web and MCP always see identical capacity, and consuming via one reduces the other")', () => effect {
  try TestClock.setTime(Date.now())
  try withFeedStore(effect {
    const onboarded = try onboardViaPhone("+447700900099", "carol")
    const accountId = onboarded.account.accountId

    const initialStatus = try getRateLimitStatus(accountId)
    const firstWeb = try checkAndConsumeRateLimit({ accountId, action: "post", surface: "web" })
    const secondMcp = try checkAndConsumeRateLimit({ accountId, action: "post", surface: "mcp" })

    let lastUsed = secondMcp.used
    let lastRemaining = secondMcp.remaining
    for (let i = 2; i < initialStatus.post.limit; i += 1) {
      const surface = i % 2 === 0 ? "web" : "mcp"
      const step = try checkAndConsumeRateLimit({ accountId, action: "post", surface })
      lastUsed = step.used
      lastRemaining = step.remaining
    }

    const exhaustedStatus = try getRateLimitStatus(accountId)
    const webExhausted = try expectRateLimited(checkAndConsumeRateLimit({ accountId, action: "post", surface: "web" }))
    const mcpExhausted = try expectRateLimited(checkAndConsumeRateLimit({ accountId, action: "post", surface: "mcp" }))

    const dmWeb = try checkAndConsumeRateLimit({ accountId, action: "dm", surface: "web" })
    const store = try Store
    const dmNow = try Clock.currentTimeMillis
    const dmMcp = try store.transaction((tx: Tx) =>
      checkAndConsumeRateLimitInTx(tx, { accountId, action: "dm", surface: "mcp" }, dmNow)
    )
    const canonicalKeys = [
      rateLimitScopeKey(accountId, "post"),
      rateLimitScopeKey(accountId, "dm"),
      rateLimitScopeKey(accountId, "trade")
    ]
    const tradeLimits = [ACTION_HOURLY_LIMITS.post, ACTION_HOURLY_LIMITS.dm, ACTION_HOURLY_LIMITS.trade]

    try TestClock.adjust("1 hour")
    const nextHourStatus = try getRateLimitStatus(accountId)
    const nextHourMcp = try checkAndConsumeRateLimit({ accountId, action: "post", surface: "mcp" })
    const nextHourWeb = try checkAndConsumeRateLimit({ accountId, action: "post", surface: "web" })

    try check(() => assert.deepStrictEqual(
      {
        initialPost: [initialStatus.post.used, initialStatus.post.limit],
        firstPair: [
          [firstWeb.surface, firstWeb.used, firstWeb.remaining],
          [secondMcp.surface, secondMcp.used, secondMcp.remaining]
        ],
        atCap: [lastUsed, lastRemaining, exhaustedStatus.post.used],
        exhausted: [webExhausted, mcpExhausted],
        dmShared: [[dmWeb.used, dmWeb.remaining], [dmMcp.used, dmMcp.remaining]],
        canonicalKeys,
        tradeLimits,
        afterHourReset: [
          nextHourStatus.post.used,
          [nextHourMcp.surface, nextHourMcp.used, nextHourMcp.remaining],
          [nextHourWeb.surface, nextHourWeb.used, nextHourWeb.remaining]
        ]
      },
      {
        initialPost: [0, 30],
        firstPair: [["web", 1, 29], ["mcp", 2, 28]],
        atCap: [30, 0, 30],
        exhausted: [
          { tag: "RateLimited", action: "post", retryAfterPositive: true },
          { tag: "RateLimited", action: "post", retryAfterPositive: true }
        ],
        dmShared: [[1, 59], [2, 58]],
        canonicalKeys: [`${accountId}:post`, `${accountId}:dm`, `${accountId}:trade`],
        tradeLimits: [30, 60, 120],
        afterHourReset: [0, ["mcp", 1, 29], ["web", 2, 28]]
      }
    ))
  })
}, 180_000)

it.effect('Email magic link signup, superseding, expiry, replay refusal, onboarding, OAuth eligibility, credential linking, and dual 30-day cooldown + chat cleanup on deletion (spec/auth/email.md, "Story: Request and consume a single-use email magic link safely"; spec/auth/email.md, "Story: Onboard once, link or change email, sign out everywhere, or delete after cooldown"; spec/auth/oauth.md, "Story: Authorize headless agents through RFC 8628 device flow at `/link`")', () => effect {
  try TestClock.setTime(Date.now())
  try withFeedStore(effect {
    const emailConfig: AuthRuntimeConfig = {
      ...localnetConfig,
      emailMode: "loopback",
      emailPublicOrigin: "http://localhost:5173"
    }
    const disabledConfig: AuthRuntimeConfig = {
      ...localnetConfig,
      emailMode: "disabled"
    }
    const invalidEmail = try refusedCode(requestEmailMagicLink({ email: "not-an-email", config: emailConfig }))
    const disposableEmail = try refusedCode(requestEmailMagicLink({ email: "bot@mailinator.com", config: emailConfig }))
    const disabledMode = try refusedCode(requestEmailMagicLink({ email: "alice@example.com", config: disabledConfig }))

    const firstStart = try requestEmailMagicLink({
      email: "Alice@Example.com",
      redirectTo: "/markets",
      ipAddress: "203.0.113.10",
      config: emailConfig
    })
    const firstLoopback = getLoopbackMagicLink("alice@example.com", emailConfig)
    if (firstLoopback === undefined || firstStart.devToken !== firstLoopback.token) {
      return try Effect.die("Missing loopback email magic link")
    }
    const rapidResend = try refusedCode(requestEmailMagicLink({
      email: "alice@example.com",
      ipAddress: "203.0.113.10",
      config: emailConfig
    }))

    try TestClock.adjust("31 seconds")
    const secondStart = try requestEmailMagicLink({
      email: "alice@example.com",
      redirectTo: "/explore",
      ipAddress: "203.0.113.10",
      config: emailConfig
    })
    const supersededRefusal = try refusedCode(verifyEmailMagicLink({
      token: firstLoopback.token,
      config: emailConfig
    }))

    try TestClock.adjust("16 minutes")
    const expiredRefusal = try refusedCode(verifyEmailMagicLink({
      token: secondStart.devToken ?? "",
      config: emailConfig
    }))

    const thirdStart = try requestEmailMagicLink({
      email: "alice@example.com",
      redirectTo: "/markets",
      ipAddress: "203.0.113.10",
      config: emailConfig
    })
    const thirdToken = thirdStart.devToken ?? ""
    const verifiedNew = try verifyEmailMagicLink({
      token: thirdToken,
      config: emailConfig
    })
    const replayRefusal = try refusedCode(verifyEmailMagicLink({
      token: thirdToken,
      config: emailConfig
    }))
    if (verifiedNew.status !== "needs_onboarding") {
      return try Effect.die("Expected needs_onboarding for new email user")
    }

    const underageEmail = try refusedCode(completeEmailOnboarding({
      pendingToken: verifiedNew.pendingToken,
      username: "email_alice",
      accepted18Plus: false,
      acceptedTerms: true,
      config: emailConfig
    }))
    const npcHijackEmail = try refusedCode(completeEmailOnboarding({
      pendingToken: verifiedNew.pendingToken,
      username: "ailonmusk",
      accepted18Plus: true,
      acceptedTerms: true,
      config: emailConfig
    }))
    const orgHijackEmail = try refusedCode(completeEmailOnboarding({
      pendingToken: verifiedNew.pendingToken,
      username: "openagi",
      accepted18Plus: true,
      acceptedTerms: true,
      config: emailConfig
    }))
    const reservedHijackEmail = try refusedCode(completeEmailOnboarding({
      pendingToken: verifiedNew.pendingToken,
      username: "settings",
      accepted18Plus: true,
      acceptedTerms: true,
      config: emailConfig
    }))

    const onboarded = try completeOnboarding({
      pendingToken: verifiedNew.pendingToken,
      username: "email_alice",
      accepted18Plus: true,
      acceptedTerms: true,
      config: emailConfig
    })
    const emailSessionCookie = cookiePairOf(onboarded.sessionCookieHeader)
    const emailSession = try authenticateSessionCookie(emailSessionCookie, emailConfig)
    const rawEmailStoredRows = try sqlQuery(
      "SELECT email_hash, email_masked, email_verified_at, phone_hash FROM feed_accounts WHERE account_id = $1",
      [onboarded.account.accountId]
    )

    try TestClock.adjust("31 seconds")
    const returningStart = try requestEmailMagicLink({
      email: "alice@example.com",
      ipAddress: "203.0.113.10",
      config: emailConfig
    })
    const returningVerify = try verifyEmailMagicLink({
      token: returningStart.devToken ?? "",
      config: emailConfig
    })
    if (returningVerify.status !== "signed_in") {
      return try Effect.die("Expected signed_in for returning email user")
    }

    const agentClient = try registerDynamicClient({
      clientName: "EmailAgent",
      redirectUris: ["http://127.0.0.1:43123/callback"],
      scope: "read trade"
    })
    const deviceStart = try startDeviceAuthorization({
      clientId: agentClient.client_id,
      scope: "read trade",
      origin: "https://feed.fun"
    })
    const deviceLookup = try lookupDeviceCodeForUser(deviceStart.user_code)
    const emptyScopeDevice = try refusedCode(approveDeviceAuthorization({
      accountId: onboarded.account.accountId,
      userCode: deviceStart.user_code,
      scopes: []
    }))
    const approvedEmailDevice = try approveDeviceAuthorization({
      accountId: onboarded.account.accountId,
      userCode: deviceStart.user_code,
      scopes: ["read", "trade"]
    })
    const emailAgentToken = try exchangeOAuthToken({
      grantType: "urn:ietf:params:oauth:grant-type:device_code",
      deviceCode: deviceStart.device_code,
      clientId: agentClient.client_id,
      config: emailConfig
    })
    const verifiedEmailAgent = try verifyBearer(emailAgentToken.access_token)
    const deniedDevice = try startDeviceAuthorization({ clientId: agentClient.client_id, scope: "read", origin: "https://feed.fun" })
    try approveDeviceAuthorization({ accountId: onboarded.account.accountId, userCode: deniedDevice.user_code, deny: true })
    try startDeviceAuthorization({ clientId: agentClient.client_id, scope: "read", origin: "https://feed.fun" })
    const deniedExchange = try refusedCode(exchangeOAuthToken({
      grantType: "urn:ietf:params:oauth:grant-type:device_code",
      deviceCode: deniedDevice.device_code,
      clientId: agentClient.client_id,
      config: emailConfig
    }))
    try check(() => assert.strictEqual(deniedExchange, "access_denied"))

    try startPhoneLink({
      accountId: onboarded.account.accountId,
      phoneE164: "+14155550199",
      config: emailConfig
    })
    const linkedPhoneCode = getLoopbackCode("+14155550199", emailConfig)
    if (linkedPhoneCode === undefined) return try Effect.die("Missing phone link code")
    const linkedPhone = try confirmPhoneChange({
      accountId: onboarded.account.accountId,
      newPhoneE164: "+14155550199",
      code: linkedPhoneCode,
      config: emailConfig
    })

    const phoneOnlyUser = try onboardViaPhone("+14155550188", "phone_bob")
    const emailInUseRefusal = try refusedCode(startEmailLink({
      accountId: phoneOnlyUser.account.accountId,
      email: "alice@example.com",
      config: emailConfig
    }))
    const linkStart = try startEmailLink({
      accountId: phoneOnlyUser.account.accountId,
      email: "bob@example.com",
      config: emailConfig
    })
    const unauthLinkRefusal = try refusedCode(verifyEmailMagicLink({
      token: linkStart.devToken ?? "",
      sessionAccountId: null,
      config: emailConfig
    }))
    const bobOldCookie = cookiePairOf(phoneOnlyUser.sessionCookieHeader)
    const linkedEmail = try verifyEmailMagicLink({
      token: linkStart.devToken ?? "",
      sessionAccountId: phoneOnlyUser.account.accountId,
      config: emailConfig
    })
    const bobOldSessionAfterLink = try authenticateSessionCookie(bobOldCookie, emailConfig)

    const nowMs = try Clock.currentTimeMillis
    const store = try Store
    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        "INSERT INTO feed_chats (id, kind, name, created_by, tier, created_at) VALUES ('dm-alice-bob', 'direct', NULL, $1, NULL, $2), ('grp-transfer', 'group', 'Transfer Group', $1, NULL, $2), ('grp-empty', 'group', 'Solo Group', $1, NULL, $2)",
        [onboarded.account.accountId, nowMs]
      )
      try tx.query(
        "INSERT INTO feed_chat_members (chat_id, member_id, member_kind, role, joined_at, last_read_at) VALUES ('dm-alice-bob', $1, 'user', 'member', $3, $3), ('dm-alice-bob', $2, 'user', 'member', $3, $3), ('grp-transfer', $1, 'user', 'owner', $3, $3), ('grp-transfer', $2, 'user', 'member', $4, $4), ('grp-empty', $1, 'user', 'owner', $3, $3)",
        [onboarded.account.accountId, phoneOnlyUser.account.accountId, nowMs, nowMs + 10]
      )
    })

    const deleted = try deleteAccountSelfServe({
      accountId: onboarded.account.accountId,
      authAt: nowMs,
      config: emailConfig
    })
    const emailCooldownRefusal = try refusedCode(requestEmailMagicLink({
      email: "alice@example.com",
      config: emailConfig
    }))
    const phoneCooldownRefusal = try refusedCode(startPhoneVerification({
      phoneE164: "+14155550199",
      config: emailConfig
    }))
    const deletedAccountRow = try sqlQuery(
      "SELECT email_hash, email_masked, email_verified_at, phone_hash FROM feed_accounts WHERE account_id = $1",
      [onboarded.account.accountId]
    )
    const remainingChats = try sqlQuery(
      "SELECT id, kind, created_by FROM feed_chats WHERE id IN ('dm-alice-bob', 'grp-transfer', 'grp-empty') ORDER BY id ASC"
    )
    const transferredOwner = try sqlQuery(
      "SELECT member_id, role FROM feed_chat_members WHERE chat_id = 'grp-transfer'"
    )

    const dispatchedMessages: Array<CloudflareEmailMessage> = []
    const cloudflareConfig: AuthRuntimeConfig = {
      ...localnetConfig,
      emailMode: "cloudflare",
      emailFrom: "Feed <login@feed.fun>",
      emailPublicOrigin: "https://feed.fun",
      cloudflareEmailSender: {
        send: async (message) => {
          dispatchedMessages.push(message)
          return { messageId: "cf-msg-1" }
        }
      }
    }
    const cfSent = try requestEmailMagicLink({
      email: "cfuser@example.com",
      config: cloudflareConfig
    })
    const cfMissingBinding = try refusedCode(requestEmailMagicLink({
      email: "cfmissing@example.com",
      config: { ...cloudflareConfig, cloudflareEmailSender: undefined }
    }))
    const cfBindingFailure = try refusedCode(requestEmailMagicLink({
      email: "cffail@example.com",
      config: {
        ...cloudflareConfig,
        cloudflareEmailSender: {
          send: async () => {
            throw new Error("downstream send_email error")
          }
        }
      }
    }))

    const failedSendPrior = try requestEmailMagicLink({
      email: "racefail@example.com",
      ipAddress: "203.0.113.10",
      config: emailConfig
    })
    const failedSendPriorToken = failedSendPrior.devToken ?? ""
    try TestClock.adjust("31 seconds")
    const failedSendRefusal = try refusedCode(requestEmailMagicLink({
      email: "racefail@example.com",
      ipAddress: "203.0.113.10",
      config: {
        ...cloudflareConfig,
        cloudflareEmailSender: {
          send: async () => {
            throw new Error("downstream send_email error")
          }
        }
      }
    }))
    const failedSendRows = try sqlQuery(
      "SELECT id, superseded_at FROM feed_email_magic_links WHERE email_masked = $1 ORDER BY created_at",
      ["r***@example.com"]
    )
    const failedSendPriorVerify = try verifyEmailMagicLink({
      token: failedSendPriorToken,
      config: emailConfig
    })

    const raceNested: Array<string> = []
    const raceConfig: AuthRuntimeConfig = {
      ...cloudflareConfig,
      cloudflareEmailSender: {
        send: async (message) => {
          dispatchedMessages.push(message)
          if (message.to === "raceparallel@example.com") {
            await runPromise(Effect.provide(
              requestEmailMagicLink({
                email: "raceparallel@example.com",
                ipAddress: "203.0.113.11",
                config: cloudflareConfig
              }),
              Layer.succeed(Store, store)
            )).then(
              () => { raceNested.push("ok") },
              (err: unknown) => { raceNested.push(failureCode(err)) }
            )
          }
          return { messageId: "cf-msg-race" }
        }
      }
    }
    const raceFirst = try requestEmailMagicLink({
      email: "raceparallel@example.com",
      ipAddress: "203.0.113.11",
      config: raceConfig
    })
    const raceHash = try hashEmail(emailConfig.digestKey, "raceparallel@example.com")
    const raceRows = try sqlQuery(
      "SELECT id, superseded_at FROM feed_email_magic_links WHERE email_hash = $1 ORDER BY created_at",
      [raceHash]
    )
    const raceSends = dispatchedMessages.filter((message) => message.to === "raceparallel@example.com")

    const testClock = try TestClock.testClockWith((clock) => Effect.succeed(clock))
    const outOfOrderNested: Array<string> = []
    const outOfOrderConfig: AuthRuntimeConfig = {
      ...cloudflareConfig,
      cloudflareEmailSender: {
        send: async (message) => {
          dispatchedMessages.push(message)
          if (message.to === "raceoutoforder@example.com" && outOfOrderNested.length === 0) {
            await runPromise(testClock.adjust("31 seconds"))
            await runPromise(Effect.provide(
              Effect.provide(
                requestEmailMagicLink({
                  email: "raceoutoforder@example.com",
                  ipAddress: "203.0.113.13",
                  config: emailConfig
                }),
                Layer.succeed(Store, store)
              ),
              Layer.succeed(Clock.Clock, testClock)
            )).then(
              () => { outOfOrderNested.push("ok") },
              (err: unknown) => { outOfOrderNested.push(failureCode(err)) }
            )
          }
          return { messageId: "cf-msg-outoforder" }
        }
      }
    }
    const outOfOrderFirst = try requestEmailMagicLink({
      email: "raceoutoforder@example.com",
      ipAddress: "203.0.113.13",
      config: outOfOrderConfig
    })
    const outOfOrderHash = try hashEmail(emailConfig.digestKey, "raceoutoforder@example.com")
    const outOfOrderRows = try sqlQuery(
      "SELECT id, superseded_at FROM feed_email_magic_links WHERE email_hash = $1 ORDER BY created_at",
      [outOfOrderHash]
    )
    const outOfOrderSends = dispatchedMessages.filter((message) => message.to === "raceoutoforder@example.com")
    const outOfOrderMessage = dispatchedMessages.find((message) => message.to === "raceoutoforder@example.com")
    const outOfOrderFirstToken = outOfOrderMessage?.text?.split("token=")[1]?.split("\n")[0] ?? ""
    const outOfOrderFirstRefusal = try refusedCode(verifyEmailMagicLink({
      token: outOfOrderFirstToken,
      config: emailConfig
    }))
    const outOfOrderSecondLink = getLoopbackMagicLink("raceoutoforder@example.com", emailConfig)
    if (outOfOrderSecondLink === undefined) {
      return try Effect.die("Missing out-of-order second loopback magic link")
    }
    const outOfOrderSecondVerify = try verifyEmailMagicLink({
      token: outOfOrderSecondLink.token,
      config: emailConfig
    })

    try check(() => assert.deepStrictEqual(
      {
        validation: [invalidEmail, disposableEmail, disabledMode, rapidResend, supersededRefusal, expiredRefusal, replayRefusal],
        onboardingGuards: [underageEmail, npcHijackEmail, orgHijackEmail, reservedHijackEmail],
        onboardedState: [
          onboarded.account.balanceCents,
          onboarded.account.startingGrantCents,
          onboarded.account.emailMasked,
          onboarded.account.phoneHash,
          emailSession?.emailMasked,
          emailSession?.emailVerifiedAt !== null,
          toText(rawEmailStoredRows[0]?.email_masked),
          toText(rawEmailStoredRows[0]?.email_hash)?.includes("alice") ?? false
        ],
        oauthOnEmailAccount: [
          deviceLookup.clientName,
          deviceLookup.scopes,
          emptyScopeDevice,
          approvedEmailDevice.approved,
          verifiedEmailAgent.activeGrant,
          verifiedEmailAgent.accountId === onboarded.account.accountId
        ],
        credentialLinking: [
          linkedPhone.account.phoneLast2,
          linkedPhone.account.emailMasked,
          emailInUseRefusal,
          unauthLinkRefusal,
          linkedEmail.status,
          linkedEmail.status === "email_linked" ? linkedEmail.account.emailMasked : null,
          bobOldSessionAfterLink
        ],
        deletionAndCleanup: [
          deleted.deleted,
          emailCooldownRefusal,
          phoneCooldownRefusal,
          deletedAccountRow[0]?.email_hash,
          deletedAccountRow[0]?.email_masked,
          deletedAccountRow[0]?.email_verified_at,
          deletedAccountRow[0]?.phone_hash,
          remainingChats.map((row) => [toText(row.id), toText(row.created_by)]),
          transferredOwner.map((row) => [toText(row.member_id), toText(row.role)])
        ],
        cloudflareEmailBinding: [
          cfSent.emailMasked,
          cfSent.devToken === undefined,
          cfSent.devMagicLinkUrl === undefined,
          dispatchedMessages.length - raceSends.length - outOfOrderSends.length,
          dispatchedMessages[0]?.from,
          dispatchedMessages[0]?.to,
          dispatchedMessages[0]?.subject,
          Boolean(dispatchedMessages[0]?.html?.includes("https://feed.fun/auth/email?token=")),
          Boolean(dispatchedMessages[0]?.text?.includes("https://feed.fun/auth/email?token=")),
          cfMissingBinding,
          cfBindingFailure
        ],
        failedSendPreservesPriorLink: [
          failedSendRefusal,
          failedSendRows.length,
          failedSendRows[0]?.superseded_at ?? null,
          failedSendPriorVerify.status
        ],
        parallelRace: [
          raceNested[0] ?? "missing",
          raceRows.length,
          raceSends.length,
          raceFirst.emailMasked
        ],
        outOfOrderSupersession: [
          outOfOrderNested[0] ?? "missing",
          outOfOrderRows.length,
          outOfOrderRows[0]?.superseded_at !== null,
          outOfOrderRows[1]?.superseded_at === null,
          outOfOrderSecondVerify.status,
          outOfOrderFirstRefusal,
          outOfOrderFirst.emailMasked
        ]
      },
      {
        validation: [
          "invalid_email",
          "disposable_email_not_allowed",
          "email_auth_disabled",
          "rate_limited:email_send",
          "magic_link_superseded",
          "magic_link_expired",
          "magic_link_used"
        ],
        onboardingGuards: ["attestation_required", "username_taken", "username_taken", "username_reserved"],
        onboardedState: [10_000, 10_000, "a***@example.com", null, "a***@example.com", true, "a***@example.com", false],
        oauthOnEmailAccount: ["EmailAgent", ["read", "trade"], "invalid_scope", true, true, true],
        credentialLinking: ["99", "a***@example.com", "email_in_use", "session_required_to_link", "email_linked", "b***@example.com", null],
        deletionAndCleanup: [
          true,
          "email_cooldown",
          "phone_cooldown",
          null,
          null,
          null,
          null,
          [["grp-transfer", phoneOnlyUser.account.accountId]],
          [[phoneOnlyUser.account.accountId, "owner"]]
        ],
        cloudflareEmailBinding: [
          "c***@example.com",
          true,
          true,
          1,
          { name: "Feed", email: "login@feed.fun" },
          "cfuser@example.com",
          "Sign in to Feed",
          true,
          true,
          "email_provider_unavailable",
          "email_provider_unavailable"
        ],
        failedSendPreservesPriorLink: [
          "email_provider_unavailable",
          1,
          null,
          "needs_onboarding"
        ],
        parallelRace: [
          "rate_limited:email_send",
          1,
          1,
          "r***@example.com"
        ],
        outOfOrderSupersession: [
          "ok",
          2,
          true,
          true,
          "needs_onboarding",
          "magic_link_superseded",
          "r***@example.com"
        ]
      }
    ))
  })
}, 180_000)

it.effect('Device approval attempts are budgeted per account so pending user codes cannot be guessed (spec/auth/oauth.md, "Story: Authorize headless agents through RFC 8628 device flow at `/link`"; spec/auth/oauth.md, "Exchanging an approved device code issues tokens and atomically replaces any prior connected agent")', () => effect {
  try TestClock.setTime(Date.now())
  try withFeedStore(effect {
    const onboarded = try onboardViaPhone("+14155550177", "dave_device")
    const accountId = onboarded.account.accountId
    const client = try registerDynamicClient({
      clientName: "Guess Target CLI",
      redirectUris: ["http://127.0.0.1:49152/callback"],
      scope: "read"
    })
    const first = try startDeviceAuthorization({
      clientId: client.client_id,
      scope: "read",
      resource: "https://feed.fun/mcp/",
      origin: "https://feed.fun"
    })
    const approvedFirst = try approveDeviceAuthorization({ accountId, userCode: first.user_code, scopes: ["read"] })

    const second = try startDeviceAuthorization({
      clientId: client.client_id,
      scope: "read",
      resource: "https://feed.fun/mcp/",
      origin: "https://feed.fun"
    })
    const wrongCode = first.user_code === "FEED-9999" || second.user_code === "FEED-9999" ? "FEED-9998" : "FEED-9999"
    const wrongCodes: string[] = []
    for (let i = 0; i < 19; i += 1) {
      wrongCodes.push(try refusedCode(approveDeviceAuthorization({ accountId, userCode: wrongCode, scopes: ["read"] })))
    }
    const cappedWrong = try refusedCode(approveDeviceAuthorization({ accountId, userCode: wrongCode, scopes: ["read"] }))
    const cappedCorrect = try refusedCode(approveDeviceAuthorization({ accountId, userCode: second.user_code, scopes: ["read"] }))

    const other = try onboardViaPhone("+14155550178", "erin_device")
    const approvedByOther = try approveDeviceAuthorization({ accountId: other.account.accountId, userCode: second.user_code, scopes: ["read"] })

    try TestClock.adjust("1 hour")
    const third = try startDeviceAuthorization({
      clientId: client.client_id,
      scope: "read",
      resource: "https://feed.fun/mcp/",
      origin: "https://feed.fun"
    })
    const approvedAfterReset = try approveDeviceAuthorization({ accountId, userCode: third.user_code, scopes: ["read"] })

    try check(() => assert.deepStrictEqual(
      {
        approvedFirst: approvedFirst.approved,
        wrongCodes: [...new Set(wrongCodes)],
        wrongAttempts: wrongCodes.length,
        cappedWrong,
        cappedCorrect,
        approvedByOther: approvedByOther.approved,
        approvedAfterReset: approvedAfterReset.approved
      },
      {
        approvedFirst: true,
        wrongCodes: ["invalid_user_code"],
        wrongAttempts: 19,
        cappedWrong: "rate_limited:device_approve",
        cappedCorrect: "rate_limited:device_approve",
        approvedByOther: true,
        approvedAfterReset: true
      }
    ))
  })
}, 180_000)

it.effect('Security hardening (handle hijack, reviewer lockout, RFC 8252 loopback port, SSRF host checks, device pruning) and DB seeding invariants (spec/auth/phone.md, "Story: Admit directory reviewer password sign-in only for `isReviewer` accounts"; spec/auth/oauth.md, "Clients register via CIMD or DCR for hosted callbacks or RFC 8252 loopback redirects only")', () => effect {
  try TestClock.setTime(Date.now())
  try withFeedStore(effect {
    try provisionReviewerAccount("reviewer_lock", "reviewer-pass-123")
    const reviewerAttempts: string[] = []
    for (let i = 0; i < 6; i += 1) {
      reviewerAttempts.push(try refusedCode(signInReviewerPassword({
        usernameOrId: "reviewer_lock",
        password: "bad-password",
        ipAddress: "198.51.100.7",
        config: localnetConfig
      })))
    }

    const dcrClient = try registerDynamicClient({
      clientName: "LoopbackCLI",
      redirectUris: ["http://127.0.0.1:41000/callback"],
      scope: "read",
      ipAddress: "198.51.100.8",
      digestKey: localnetConfig.digestKey
    })
    const user = try onboardViaPhone("+14155550177", "loopback_user")
    const verifier = "loopback-verifier-0123456789abcdefghijklmnopqrstuvwxyz"
    const baseLoopbackCodeInput = {
      accountId: user.account.accountId,
      clientId: dcrClient.client_id,
      redirectUri: "http://127.0.0.1:59123/callback",
      codeChallenge: pkceChallengeS256(verifier),
      codeChallengeMethod: "S256" as const,
      resource: "https://feed.fun/mcp"
    }
    const dynamicPortCode = try createAuthorizationCode({
      ...baseLoopbackCodeInput,
      scope: "read",
      state: "state-loopback"
    })
    const emptyAuthScopeRefusal = try refusedCode(createAuthorizationCode({
      ...baseLoopbackCodeInput,
      scope: "",
      state: "state-empty-scope"
    }))

    const ssrfChecks = [
      isDisallowedRemoteHost("fc00::1"),
      isDisallowedRemoteHost("fd12:3456::1"),
      isDisallowedRemoteHost("fe80::1"),
      isDisallowedRemoteHost("[::ffff:127.0.0.1]"),
      isDisallowedRemoteHost("100.64.0.1"),
      isDisallowedRemoteHost("0.0.0.0"),
      isDisallowedRemoteHost("example.com")
    ]
    const loopbackMatchChecks = [
      redirectUriMatchesRegistered(["http://127.0.0.1:41000/callback"], "http://127.0.0.1:59123/callback"),
      redirectUriMatchesRegistered(["http://localhost:3000/cb"], "http://localhost:9999/cb"),
      redirectUriMatchesRegistered(["https://app.example.com:8443/cb"], "https://app.example.com:9443/cb")
    ]

    try checkOAuthEndpointRateLimit({
      endpoint: "device_code",
      ipAddress: "198.51.100.9",
      digestKey: localnetConfig.digestKey
    })
    const nowMs = try Clock.currentTimeMillis
    const store = try Store
    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        `INSERT INTO feed_device_codes
           (device_code_hash, user_code, client_id, client_name, scope, status, account_id, expires_at, interval_sec)
         VALUES ('expired-hash', 'AAAA-BBBB', $1, 'LoopbackCLI', 'read', 'pending', NULL, $2, 5)`,
        [dcrClient.client_id, nowMs - 1000]
      )
    })
    try startDeviceAuthorization({
      clientId: dcrClient.client_id,
      scope: "read",
      origin: "https://feed.fun"
    })
    const expiredDeviceLeft = try sqlQuery(
      "SELECT count(*) AS count FROM feed_device_codes WHERE device_code_hash = 'expired-hash'"
    )

    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        `INSERT INTO feed_actors (id, name, username, tier, description, system_prompt, personality_json, balance_cents, created_at)
         VALUES ('org-openagi', 'Legacy Org Mirror', 'legacy_org_openagi', 'A_TIER', 'mirror', 'mirror', '{}', 1000, $1)
         ON CONFLICT (id) DO NOTHING`,
        [nowMs]
      )
      try tx.query(
        `INSERT INTO feed_posts (id, author_id, author_kind, content, created_at)
         VALUES ('legacy-org-post', 'org-openagi', 'npc', 'Legacy org post', $1)
         ON CONFLICT (id) DO NOTHING`,
        [nowMs]
      )
      try tx.query(
        `INSERT INTO feed_follows (follower_id, target_id, target_kind, created_at)
         VALUES ('ailon-musk', 'org-openagi', 'npc', $1)
         ON CONFLICT DO NOTHING`,
        [nowMs]
      )
      try tx.query(
        `INSERT INTO feed_job_leases (job_name, owner_id, lease_until, updated_at)
         VALUES ('minute-tick', 'worker-1', $1, $2)
         ON CONFLICT (job_name) DO UPDATE SET owner_id = EXCLUDED.owner_id, lease_until = EXCLUDED.lease_until, updated_at = EXCLUDED.updated_at`,
        [nowMs + 120_000, nowMs]
      )
    })
    try seedFeedWorld()

    const orgActorsAfterSeed = try sqlQuery("SELECT count(*) AS count FROM feed_actors WHERE id LIKE 'org-%'")
    const migratedPost = try sqlQuery("SELECT author_id, author_kind FROM feed_posts WHERE id = 'legacy-org-post'")
    const migratedFollow = try sqlQuery("SELECT target_id, target_kind FROM feed_follows WHERE follower_id = 'ailon-musk' AND target_id = 'openagi'")
    const orgUsernameRow = try sqlQuery("SELECT username FROM feed_organizations WHERE id = 'openagi'")
    const npcFollowerCount = try sqlQuery("SELECT count(*) AS count FROM feed_follows WHERE target_id = 'ailon-musk' AND target_kind = 'npc'")
    const npcFollowingCount = try sqlQuery("SELECT count(*) AS count FROM feed_follows WHERE follower_id = 'ailon-musk'")
    const market1Row = try sqlQuery("SELECT question FROM feed_prediction_markets WHERE id = 'seed-market-1'")
    const article2Row = try sqlQuery("SELECT summary FROM feed_articles WHERE id = 'seed-article-2'")
    const notifCols = try sqlQuery(
      "SELECT column_name FROM information_schema.columns WHERE table_name = 'feed_notifications' AND column_name IN ('chat_id', 'invite_id') ORDER BY column_name ASC"
    )
    const leaseRow = try sqlQuery("SELECT owner_id FROM feed_job_leases WHERE job_name = 'minute-tick'")

    try check(() => assert.deepStrictEqual(
      {
        reviewerLockout: reviewerAttempts,
        dynamicLoopbackRedirect: dynamicPortCode.redirectUri,
        emptyAuthScopeRefusal,
        ssrfChecks,
        loopbackMatchChecks,
        expiredDevicePruned: toInt(expiredDeviceLeft[0]?.count),
        toIntNullUndefined: [toInt(null), toInt(undefined)],
        dbMigrationsAndSeeding: [
          toInt(orgActorsAfterSeed[0]?.count),
          toText(migratedPost[0]?.author_id),
          toText(migratedPost[0]?.author_kind),
          toText(migratedFollow[0]?.target_kind),
          Boolean(toText(orgUsernameRow[0]?.username)),
          toInt(npcFollowerCount[0]?.count) > 0,
          toInt(npcFollowingCount[0]?.count) > 0,
          (toText(market1Row[0]?.question) ?? "").includes("SMH-9000"),
          (toText(article2Row[0]?.summary) ?? "").includes("supply chain rumors swirl"),
          notifCols.map((row) => toText(row.column_name)),
          toText(leaseRow[0]?.owner_id)
        ]
      },
      {
        reviewerLockout: [
          "reviewer_signin_refused",
          "reviewer_signin_refused",
          "reviewer_signin_refused",
          "reviewer_signin_refused",
          "reviewer_signin_refused",
          "rate_limited:reviewer_login"
        ],
        dynamicLoopbackRedirect: "http://127.0.0.1:59123/callback",
        emptyAuthScopeRefusal: "invalid_scope",
        ssrfChecks: [true, true, true, true, true, true, false],
        loopbackMatchChecks: [true, true, false],
        expiredDevicePruned: 0,
        toIntNullUndefined: [0, 0],
        dbMigrationsAndSeeding: [
          0,
          "openagi",
          "org",
          "org",
          true,
          true,
          true,
          true,
          false,
          ["chat_id", "invite_id"],
          "worker-1"
        ]
      }
    ))
  })
}, 180_000)

it.effect('Refuse trailing-dot local FQDNs, *.localhost, and non-public IPv4 ranges in OAuth DCR and CIMD host checks (spec/auth/oauth.md, "Story: Authorize one MCP client over OAuth 2.1 or Device Flow and rotate tokens safely"; spec/auth/oauth.md, "Clients register via CIMD or DCR for hosted callbacks or RFC 8252 loopback redirects only")', () => effect {
  try TestClock.setTime(Date.now())
  try withFeedStore(effect {
    const blockedRedirects = [
      "https://localhost./cb",
      "https://sub.localhost/cb",
      "https://sub.localhost./cb",
      "https://metadata.google.internal./cb",
      "https://redis.local./cb",
      "https://intranet./cb",
      "https://router.home.arpa/cb",
      "https://0.0.0.0/cb",
      "https://100.64.0.1/cb",
      "https://100.100.100.200/cb",
      "https://100.127.255.254/cb",
      "https://192.0.0.1/cb",
      "https://192.0.2.1/cb",
      "https://192.88.99.1/cb",
      "https://198.18.0.1/cb",
      "https://198.19.255.254/cb",
      "https://198.51.100.1/cb",
      "https://203.0.113.1/cb",
      "https://224.0.0.1/cb",
      "https://240.0.0.1/cb",
      "https://255.255.255.255/cb"
    ]
    const blockedResults: string[] = []
    for (const uri of blockedRedirects) {
      blockedResults.push(try refusedCode(registerDynamicClient({
        clientName: "Disallowed Host Probe",
        redirectUris: [uri]
      })))
    }

    const allowedPublicBoundaries = [
      "https://100.63.255.254/cb",
      "https://100.128.0.1/cb",
      "https://172.15.255.254/cb",
      "https://172.32.0.1/cb",
      "https://198.17.255.254/cb",
      "https://198.20.0.1/cb",
      "https://223.255.255.254/cb"
    ]
    const allowedCount = (try registerDynamicClient({
      clientName: "Public Boundary Client",
      redirectUris: allowedPublicBoundaries
    })).redirect_uris.length

    const probe = try tryPromise(() => startCountingTcpProbe())
    const cimdStatuses: Array<string> = []
    for (const target of [
      `https://0.0.0.0:${probe.port}/client.json`,
      `https://localhost.:${probe.port}/client.json`,
      `https://sub.localhost:${probe.port}/client.json`
    ]) {
      cimdStatuses.push(try refusedStatusAndCode(fetchClientMetadata(target)))
    }
    const tcpHits = try Effect.try(() => probe.getHits())
    try tryPromise(() => probe.close())

    try check(() => assert.deepStrictEqual(
      {
        allBlockedRefused: blockedResults.every((code) => code === "invalid_redirect_uri"),
        sampleBlocked: blockedResults.slice(0, 9),
        allowedCount,
        cimdProbe: {
          statuses: cimdStatuses,
          tcpHits
        }
      },
      {
        allBlockedRefused: true,
        sampleBlocked: Array(9).fill("invalid_redirect_uri"),
        allowedCount: allowedPublicBoundaries.length,
        cimdProbe: {
          statuses: ["400:invalid_client", "400:invalid_client", "400:invalid_client"],
          tcpHits: 0
        }
      }
    ))
  })
}, 60_000)
