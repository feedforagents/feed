{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "rootDir": ".",
    "rootDirs": [
      ".",
      ".vibe/declarations"
    ]
  },
  "include": [
    "src",
    "test",
    "gen/*.ts",
    "gen/*.vibe"
  ],
  "vibe": {
    "sidecarDir": ".vibe/declarations"
  }
}
