// spec/social/moderation.md, "Story: Block, mute, follow, and report users or posts"; spec/social/moderation.md, "Story: In-app notifications and Social-mode presentation filtering"
import { assert, it } from "@effect/vitest"
import { Store, migrateFeedSchema, seedFeedWorld, toText, type Tx } from "@repo/db"
import { localStoreLayer } from "@repo/db/node"
import { TestClock } from "effect/testing"
import {
  SocialFailure,
  blockAccount,
  getPostThread,
  getProfile,
  listFeedPosts,
  muteAccount,
  realtimeBusLayer,
  unblockAccount,
  unmuteAccount,
} from "../src/index.vibe"

effect function execTx(sql: string, params: ReadonlyArray<unknown> = []) {
  const store = try Store
  return try store.transaction((tx: Tx) => tx.query(sql, params))
}

it.effect(
  'getProfile suppresses tradeCount, openPositionCount, and postsCount across mutual user and NPC blocks and mutes and excludes market posts from postsCount in SocialMode while preserving unblocked GameMode and self views (spec/social/moderation.md, "Story: Block, mute, follow, and report users or posts"; spec/social/moderation.md, "Story: In-app notifications and Social-mode presentation filtering")',
  () => effect {
    try TestClock.setTime(1_760_000_500_000)
    provide Layer.merge(
      Layer.fresh(localStoreLayer({ kind: "pglite", file: undefined })),
      Layer.fresh(realtimeBusLayer),
    ) {
      try migrateFeedSchema()
      try seedFeedWorld()

      const npcRows = try execTx("SELECT id, username FROM feed_actors ORDER BY id ASC LIMIT 1")
      const npcId = toText(npcRows[0]?.id) ?? ""
      const npcHandle = toText(npcRows[0]?.username) ?? ""

      try execTx(
        `INSERT INTO feed_accounts (account_id, handle, display_name, bio, ui_mode, balance_cents, created_at, updated_at)
         VALUES
           ('pbc-alice', 'pbc_alice', 'Alice', '', 'game', 10000, $1, $1),
           ('pbc-bob', 'pbc_bob', 'Bob', '', 'game', 10000, $1, $1)`,
        [1_760_000_500_000],
      )

      const perpRows = try execTx("SELECT ticker FROM feed_perp_markets ORDER BY ticker ASC LIMIT 1")
      const perpTicker = toText(perpRows[0]?.ticker) ?? ""

      try execTx(
        `INSERT INTO feed_trades (id, trader_id, trader_kind, market_kind, market_ref, side, shares_or_size, price_cents, notional_cents, fee_cents, created_at)
         VALUES
           ('pbc-t1', 'pbc-alice', 'user', 'prediction', 'seed-market-1', 'buy_yes', 400, 50, 200, 2, $1),
           ('pbc-t2', 'pbc-alice', 'user', 'perp', $3, 'open_long', 600, 1000, 600, 3, $1),
           ('pbc-t3', 'pbc-bob', 'user', 'prediction', 'seed-market-1', 'buy_no', 200, 50, 100, 1, $1),
           ('pbc-t4', $2, 'npc', 'prediction', 'seed-market-1', 'buy_yes', 500, 50, 250, 0, $1)`,
        [1_760_000_500_000, npcId, perpTicker],
      )

      try execTx(
        `INSERT INTO feed_prediction_positions (market_id, holder_id, holder_kind, side, shares, cost_basis_cents, settled_at, payout_cents)
         VALUES
           ('seed-market-1', 'pbc-alice', 'user', 'YES', 400, 200, NULL, 0),
           ('seed-market-1', 'pbc-bob', 'user', 'NO', 200, 100, NULL, 0),
           ('seed-market-1', $1, 'npc', 'YES', 500, 250, NULL, 0)`,
        [npcId],
      )

      try execTx(
        `INSERT INTO feed_perp_positions (id, ticker, holder_id, holder_kind, side, margin_cents, size_cents, entry_price_cents, leverage, status, created_at)
         VALUES ('pbc-perp-1', $1, 'pbc-alice', 'user', 'LONG', 300, 600, 1000, 2, 'open', $2)`,
        [perpTicker, 1_760_000_500_000],
      )

      try execTx(
        `INSERT INTO feed_posts (id, author_id, author_kind, content, reply_to_post_id, quote_post_id, via_client_name, market_id, ticker, like_count, repost_count, reply_count, deleted_at, created_at)
         VALUES
           ('pbc-post-a1', 'pbc-alice', 'user', 'Morning dispatch from Alice', NULL, NULL, NULL, NULL, NULL, 0, 0, 0, NULL, $1),
           ('pbc-post-a2', 'pbc-alice', 'user', 'NEW MARKET (FOO) is live', NULL, NULL, NULL, NULL, NULL, 0, 0, 0, NULL, $1),
           ('pbc-post-b1', 'pbc-bob', 'user', 'Morning dispatch from Bob', NULL, NULL, NULL, NULL, NULL, 0, 0, 0, NULL, $1),
           ('pbc-post-n1', $2, 'npc', 'Morning dispatch from the NPC', NULL, NULL, NULL, NULL, NULL, 0, 0, 0, NULL, $1)`,
        [1_760_000_500_000, npcId],
      )

      const unblockedBobViewsAlice = try getProfile("pbc_alice", "pbc-bob", "game")
      const unblockedBobViewsNpc = try getProfile(npcHandle, "pbc-bob", "game")
      const anonGameViewsAlice = try getProfile("pbc_alice", undefined, "game")
      const socialModeViewsAlice = try getProfile("pbc_alice", "pbc-bob", "social")

      try blockAccount("pbc-alice", "pbc_bob")
      const bobViewsAliceWhileBlockedBy = try getProfile("pbc_alice", "pbc-bob", "game")
      const aliceViewsBobWhileBlocking = try getProfile("pbc_bob", "pbc-alice", "game")
      const aliceSelfWhileBlocking = try getProfile("pbc_alice", "pbc-alice", "game")
      const bobSelfWhileBlocked = try getProfile("pbc_bob", "pbc-bob", "game")

      try unblockAccount("pbc-alice", "pbc_bob")
      const bobViewsAliceAfterUnblock = try getProfile("pbc_alice", "pbc-bob", "game")

      try muteAccount("pbc-bob", "pbc_alice")
      const bobViewsAliceWhileMuted = try getProfile("pbc_alice", "pbc-bob", "game")
      try unmuteAccount("pbc-bob", "pbc_alice")
      const bobViewsAliceAfterUnmute = try getProfile("pbc_alice", "pbc-bob", "game")

      try blockAccount("pbc-bob", npcHandle)
      const bobViewsNpcWhileBlocking = try getProfile(npcHandle, "pbc-bob", "game")

      try orDie(
        Effect.try(() => {
          assert.deepStrictEqual(
            {
              unblockedBobViewsAlice: [unblockedBobViewsAlice.tradeCount, unblockedBobViewsAlice.openPositionCount],
              unblockedBobViewsNpcPositive:
                (unblockedBobViewsNpc.tradeCount ?? 0) >= 1 && (unblockedBobViewsNpc.openPositionCount ?? 0) >= 1,
              anonGameViewsAlice: [anonGameViewsAlice.tradeCount, anonGameViewsAlice.openPositionCount],
              socialModeViewsAlice: [socialModeViewsAlice.tradeCount, socialModeViewsAlice.openPositionCount],
              bobViewsAliceWhileBlockedBy: [
                bobViewsAliceWhileBlockedBy.viewerBlockedBy,
                bobViewsAliceWhileBlockedBy.tradeCount,
                bobViewsAliceWhileBlockedBy.openPositionCount,
              ],
              aliceViewsBobWhileBlocking: [
                aliceViewsBobWhileBlocking.viewerBlocks,
                aliceViewsBobWhileBlocking.tradeCount,
                aliceViewsBobWhileBlocking.openPositionCount,
              ],
              aliceSelfWhileBlocking: [aliceSelfWhileBlocking.tradeCount, aliceSelfWhileBlocking.openPositionCount],
              bobSelfWhileBlocked: [bobSelfWhileBlocked.tradeCount, bobSelfWhileBlocked.openPositionCount],
              bobViewsAliceAfterUnblock: [
                bobViewsAliceAfterUnblock.tradeCount,
                bobViewsAliceAfterUnblock.openPositionCount,
              ],
              bobViewsNpcWhileBlocking: [
                bobViewsNpcWhileBlocking.viewerBlocks,
                bobViewsNpcWhileBlocking.tradeCount,
                bobViewsNpcWhileBlocking.openPositionCount,
              ],
              unblockedBobViewsAlicePosts: unblockedBobViewsAlice.postsCount,
              anonGameViewsAlicePosts: anonGameViewsAlice.postsCount,
              socialModeViewsAlicePosts: socialModeViewsAlice.postsCount,
              bobViewsAliceWhileBlockedByPosts: bobViewsAliceWhileBlockedBy.postsCount,
              aliceViewsBobWhileBlockingPosts: aliceViewsBobWhileBlocking.postsCount,
              aliceSelfWhileBlockingPosts: aliceSelfWhileBlocking.postsCount,
              bobSelfWhileBlockedPosts: bobSelfWhileBlocked.postsCount,
              bobViewsAliceAfterUnblockPosts: bobViewsAliceAfterUnblock.postsCount,
              bobViewsAliceWhileMutedPosts: bobViewsAliceWhileMuted.postsCount,
              bobViewsAliceAfterUnmutePosts: bobViewsAliceAfterUnmute.postsCount,
              bobViewsNpcWhileBlockingPosts: bobViewsNpcWhileBlocking.postsCount,
            },
            {
              unblockedBobViewsAlice: [2, 2],
              unblockedBobViewsNpcPositive: true,
              anonGameViewsAlice: [2, 2],
              socialModeViewsAlice: [null, null],
              bobViewsAliceWhileBlockedBy: [true, null, null],
              aliceViewsBobWhileBlocking: [true, null, null],
              aliceSelfWhileBlocking: [2, 2],
              bobSelfWhileBlocked: [1, 1],
              bobViewsAliceAfterUnblock: [2, 2],
              bobViewsNpcWhileBlocking: [true, null, null],
              unblockedBobViewsAlicePosts: 2,
              anonGameViewsAlicePosts: 2,
              socialModeViewsAlicePosts: 1,
              bobViewsAliceWhileBlockedByPosts: 0,
              aliceViewsBobWhileBlockingPosts: 0,
              aliceSelfWhileBlockingPosts: 2,
              bobSelfWhileBlockedPosts: 1,
              bobViewsAliceAfterUnblockPosts: 2,
              bobViewsAliceWhileMutedPosts: 0,
              bobViewsAliceAfterUnmutePosts: 2,
              bobViewsNpcWhileBlockingPosts: 0,
            },
          )
        }),
      )
    }
  },
  60_000,
)

it.effect(
  'A blocked author stays out of the profile Posts list and direct thread entry, including the reply-to attribution on a visible reply (spec/social/moderation.md, "Story: Block, mute, follow, and report users or posts")',
  () => effect {
    try TestClock.setTime(1_760_000_600_000)
    provide Layer.merge(
      Layer.fresh(localStoreLayer({ kind: "pglite", file: undefined })),
      Layer.fresh(realtimeBusLayer),
    ) {
      try migrateFeedSchema()
      try seedFeedWorld()
      try execTx(
        `INSERT INTO feed_accounts (account_id, handle, display_name, bio, ui_mode, balance_cents, created_at, updated_at)
         VALUES
           ('pb-alice', 'pb_alice', 'Alice', '', 'game', 10000, $1, $1),
           ('pb-bob', 'pb_bob', 'Bob', '', 'game', 10000, $1, $1),
           ('pb-carol', 'pb_carol', 'Carol', '', 'game', 10000, $1, $1)`,
        [1_760_000_600_000],
      )
      try execTx(
        `INSERT INTO feed_posts (id, author_id, author_kind, content, reply_to_post_id, quote_post_id, via_client_name, market_id, ticker, like_count, repost_count, reply_count, deleted_at, created_at)
         VALUES
           ('pb-bob-post', 'pb-bob', 'user', 'Bob alpha call', NULL, NULL, NULL, NULL, NULL, 0, 0, 0, NULL, $1),
           ('pb-carol-post', 'pb-carol', 'user', 'Carol note', NULL, NULL, NULL, NULL, NULL, 0, 0, 0, NULL, $1),
           ('pb-carol-quote-bob', 'pb-carol', 'user', 'Carol quoting Bob', NULL, 'pb-bob-post', NULL, NULL, NULL, 0, 0, 0, NULL, $1),
           ('pb-carol-reply-bob', 'pb-carol', 'user', 'Carol replying to Bob', 'pb-bob-post', NULL, NULL, NULL, NULL, 0, 0, 0, NULL, $1),
           ('pb-bob-reply-carol', 'pb-bob', 'user', 'Bob replying to Carol', 'pb-carol-post', NULL, NULL, NULL, NULL, 0, 0, 0, NULL, $1)`,
        [1_760_000_600_000],
      )
      try execTx(
        `INSERT INTO feed_post_reposts (post_id, account_id, created_at) VALUES
           ('pb-carol-post', 'pb-bob', $1),
           ('pb-bob-post', 'pb-carol', $1)`,
        [1_760_000_600_000],
      )

      const replyThreadBeforeBlock = try getPostThread("pb-carol-reply-bob", "pb-alice", "game")

      try blockAccount("pb-alice", "pb_bob")

      const bobProfile = try getProfile("pb_bob", "pb-alice", "game")
      const bobPosts = try listFeedPosts({ tab: "latest", viewerId: "pb-alice", mode: "game", authorId: "pb-bob", limit: 30 })
      const carolPosts = try listFeedPosts({ tab: "latest", viewerId: "pb-alice", mode: "game", authorId: "pb-carol", limit: 30 })
      const bobThreadError = (getPostThread("pb-bob-post", "pb-alice", "game") catch effect (err) => err instanceof SocialFailure ? err.code : "other")
      const carolThread = try getPostThread("pb-carol-post", "pb-alice", "game")
      const carolReplyThread = try getPostThread("pb-carol-reply-bob", "pb-alice", "game")
      const anonReplyThread = try getPostThread("pb-carol-reply-bob", undefined, "game")

      try unblockAccount("pb-alice", "pb_bob")
      try blockAccount("pb-bob", "pb_alice")
      const carolReplyThreadAuthorBlocksViewer = try getPostThread("pb-carol-reply-bob", "pb-alice", "game")
      const carolReplyThreadForCarol = try getPostThread("pb-carol-reply-bob", "pb-carol", "game")

      try orDie(
        Effect.try(() => {
          assert.deepStrictEqual(
            {
              replyToHandleBeforeBlock: replyThreadBeforeBlock.post.replyToHandle,
              bobViewerBlocks: bobProfile.viewerBlocks,
              bobPostsCount: bobProfile.postsCount,
              bobPostIds: bobPosts.items.map((p) => p.id),
              carolPostIds: carolPosts.items.map((p) => p.id),
              carolQuoteDeleted: carolPosts.items.find((p) => p.id === "pb-carol-quote-bob")?.quotePost?.deleted ?? null,
              carolRepostAttr: carolPosts.items.find((p) => p.id === "pb-carol-post")?.repostedByHandle ?? null,
              bobThreadError,
              carolThreadReplies: carolThread.replies.map((p) => p.id),
              carolReplyParent: carolReplyThread.parentPost?.id ?? null,
              carolReplyAncestors: carolReplyThread.ancestors.map((p) => p.id),
              carolReplyToHandle: carolReplyThread.post.replyToHandle,
              carolReplyToAuthorId: carolReplyThread.post.replyToAuthorId,
              anonReplyToHandle: anonReplyThread.post.replyToHandle,
              authorBlocksViewerReplyToHandle: carolReplyThreadAuthorBlocksViewer.post.replyToHandle,
              authorBlocksViewerReplyToAuthorId: carolReplyThreadAuthorBlocksViewer.post.replyToAuthorId,
              authorBlocksViewerParent: carolReplyThreadAuthorBlocksViewer.parentPost?.id ?? null,
              carolOwnReplyToHandle: carolReplyThreadForCarol.post.replyToHandle,
            },
            {
              replyToHandleBeforeBlock: "pb_bob",
              bobViewerBlocks: true,
              bobPostsCount: 0,
              bobPostIds: [],
              carolPostIds: ["pb-carol-quote-bob", "pb-carol-post"],
              carolQuoteDeleted: true,
              carolRepostAttr: null,
              bobThreadError: "Blocked",
              carolThreadReplies: [],
              carolReplyParent: null,
              carolReplyAncestors: [],
              carolReplyToHandle: null,
              carolReplyToAuthorId: null,
              anonReplyToHandle: "pb_bob",
              authorBlocksViewerReplyToHandle: null,
              authorBlocksViewerReplyToAuthorId: null,
              authorBlocksViewerParent: null,
              carolOwnReplyToHandle: "pb_bob",
            },
          )
        }),
      )
    }
  },
  60_000,
)
