// spec/social/posts.md, "Story: Create and delete posts with unified replies and attribution"; spec/social/messaging.md, "Story: Direct messages, chat messages, and reactions"; spec/social/moderation.md, "Story: Block, mute, follow, and report users or posts"; spec/social/moderation.md, "Story: In-app notifications and Social-mode presentation filtering"
import { Store, toInt, toText, type Tx } from "@repo/db"
import { viewerAuthorVisibilitySql, viewerBlockVisibilitySql } from "./visibility.vibe"

export type FeedRealtimeEvent =
  | {
      readonly type: "post.created"
      readonly postId: string
      readonly authorId: string
      readonly authorKind: "user" | "npc" | "org"
      readonly replyToPostId: string | null
      readonly quotePostId: string | null
      readonly quoteAuthorId?: string | null
      readonly createdAt: number
      readonly parentReplyCount?: number | null
    }
  | {
      readonly type: "post.deleted"
      readonly postId: string
      readonly authorId: string
      readonly replyToPostId?: string | null
      readonly parentReplyCount?: number | null
    }
  | {
      readonly type: "post.engagement"
      readonly postId: string
      readonly kind: "like" | "unlike" | "repost" | "unrepost"
      readonly accountId: string
      readonly postAuthorId?: string
      readonly likeCount: number
      readonly repostCount: number
    }
  | {
      readonly type: "chat.message"
      readonly chatId: string
      readonly messageId: string
      readonly senderId: string
      readonly senderKind: "user" | "npc"
      readonly createdAt: number
      readonly recipientIds?: ReadonlyArray<string>
    }
  | {
      readonly type: "chat.reaction"
      readonly chatId: string
      readonly messageId: string
      readonly accountId: string
      readonly emoji: string
      readonly action?: "added" | "removed"
      readonly recipientIds?: ReadonlyArray<string>
    }
  | {
      readonly type: "chat.invite"
      readonly inviteId: string
      readonly chatId: string
      readonly invitedAccountId: string
      readonly invitedById?: string
      readonly invitedByNpcId: string
      readonly status: "pending" | "accepted" | "declined"
      readonly recipientIds?: ReadonlyArray<string>
    }
  | {
      readonly type: "chat.updated"
      readonly chatId: string
      readonly action: "renamed" | "member_joined" | "member_left" | "member_removed" | "ownership_transferred" | "deleted"
      readonly actorId: string
      readonly recipientIds?: ReadonlyArray<string>
    }
  | {
      readonly type: "notification.created"
      readonly notificationId: string
      readonly accountId: string
      readonly kind: string
      readonly isGameOnly: boolean
      readonly actorId?: string | null
      readonly recipientIds?: ReadonlyArray<string>
    }
  | {
      readonly type: "world.tick"
      readonly kind: "market" | "world" | "article"
      readonly refId: string
      readonly createdAt: number
    }
  | {
      readonly type: "market.spot"
      readonly actorId: string
      readonly ticker: string
      readonly side: "buy" | "sell"
      readonly quoteCents: number
      readonly indexPriceCents?: number
      readonly markPriceCents?: number
    }
  | {
      readonly type: "market.perp"
      readonly action: "open" | "add" | "reduce" | "flip" | "close" | "liquidate"
      readonly actorId: string
      readonly ticker: string
      readonly side: "long" | "short"
      readonly sizeCents: number
      readonly leverage: number
      readonly positionId?: string
      readonly markPriceCents?: number
    }
  | {
      readonly type: "market.prediction"
      readonly marketId: string
      readonly action: "buy" | "sell"
      readonly side: "yes" | "no"
      readonly yesPriceBps: number
      readonly noPriceBps: number
      readonly shares: number
      readonly notionalCents: number
    }
  | {
      readonly type: "market.clue"
      readonly marketId: string
      readonly actorId: string
      readonly phase: string
    }
  | {
      readonly type: "market.resolved"
      readonly marketId: string
      readonly outcome: "yes" | "no"
      readonly articleId: string
    }
  | {
      readonly type: "alpha.invite"
      readonly actorId: string
      readonly targetAccountId: string
      readonly recipientIds?: ReadonlyArray<string>
    }
  | {
      readonly type: "org.posted"
      readonly organizationId: string
      readonly ticker: string
    }
  | {
      readonly type: "article.published"
      readonly articleId: string
      readonly organizationId: string
    }

export interface SseStreamOptions {
  readonly signal?: AbortSignal
  readonly keepalive?: boolean
}

export interface SseResponseOptions extends SseStreamOptions {
  readonly filter?: (event: FeedRealtimeEvent) => boolean
  readonly viewerAccountId?: string | null
  readonly store?: Store.Shape
}

const encoder = new TextEncoder()

module web {
  /** @throws {never} */
  export function sseResponse(body: ReadableStream<Uint8Array>): Response {
    return new Response(body, {
      status: 200,
      headers: {
        "content-type": "text/event-stream; charset=utf-8",
        "cache-control": "no-cache, no-transform",
        connection: "keep-alive"
      }
    })
  }

  /** @throws {never} */
  export function randomIsolateId(): string {
    return crypto.randomUUID()
  }
}
import { randomIsolateId, sseResponse } from web

export service RealtimeBus {
  static readonly key = "@repo/social/RealtimeBus"
  publish(event: FeedRealtimeEvent): boolean!!
  subscribe(): Stream.Stream<FeedRealtimeEvent>
}

export interface DbRealtimeBusOptions {
  readonly isolateId?: string
  readonly pollIntervalMs?: number
  readonly retentionMs?: number
}

const VALID_REALTIME_EVENT_TYPES = new Set<string>([
  "post.created",
  "post.deleted",
  "post.engagement",
  "chat.message",
  "chat.reaction",
  "chat.invite",
  "chat.updated",
  "notification.created",
  "world.tick",
  "market.spot",
  "market.perp",
  "market.prediction",
  "market.clue",
  "market.resolved",
  "alpha.invite",
  "org.posted",
  "article.published"
])

function parseRealtimeEventJson(raw: string): FeedRealtimeEvent | undefined {
  try {
    const parsed: unknown = JSON.parse(raw)
    if (typeof parsed !== "object" || parsed === null) return undefined
    const eventType = (parsed as { readonly type?: unknown }).type
    if (typeof eventType !== "string" || !VALID_REALTIME_EVENT_TYPES.has(eventType)) return undefined
    return parsed as FeedRealtimeEvent
  } catch {
    return undefined
  }
}

export const realtimeBusLayer: Layer.Layer<RealtimeBus> = Layer.effect(RealtimeBus, effect {
  const pubsub = try PubSub.unbounded<FeedRealtimeEvent>()
  const shape: RealtimeBus.Shape = {
    publish: (event) => PubSub.publish(pubsub, event),
    subscribe: () => Stream.fromPubSub(pubsub)
  }
  return shape
})

export function createDbBackedRealtimeBusLayer(
  store: Store.Shape,
  options: DbRealtimeBusOptions = {}
): Layer.Layer<RealtimeBus> {
  const isolateId = options.isolateId?.trim() || randomIsolateId()
  const pollIntervalMs = Math.max(50, Math.trunc(options.pollIntervalMs ?? 1_500))
  const retentionMs = Math.max(10_000, Math.trunc(options.retentionMs ?? 300_000))
  return Layer.effect(RealtimeBus, effect {
    const pubsub = try PubSub.unbounded<FeedRealtimeEvent>()
    let publishCount = 0
    const shape: RealtimeBus.Shape = {
      publish: (event) => effect {
        const localOk = try PubSub.publish(pubsub, event)
        const now = try Clock.currentTimeMillis
        publishCount += 1
        const shouldPrune = publishCount % 50 === 0
        const persisted = try exit(store.transaction(effect (tx: Tx) => {
          try tx.query(
            `INSERT INTO feed_realtime_events (origin_isolate, payload_json, created_at)
             VALUES ($1, $2, $3)`,
            [isolateId, JSON.stringify(event), now]
          )
          if (shouldPrune) {
            try tx.query("DELETE FROM feed_realtime_events WHERE created_at < $1", [now - retentionMs])
          }
        }))
        return localOk || Exit.isSuccess(persisted)
      },
      subscribe: () => {
        const localStream = Stream.fromPubSub(pubsub)
        const remoteStream = Stream.unwrap(effect {
          const initialSeqRes = try exit(store.transaction(effect (tx: Tx) => {
            const rows = try tx.query("SELECT COALESCE(MAX(seq), 0) AS max_seq FROM feed_realtime_events")
            return toInt(rows[0]?.max_seq)
          }))
          const cursorRef = try Ref.make(Exit.isSuccess(initialSeqRes) ? initialSeqRes.value : 0)
          const batches = Stream.mapEffect(Stream.tick(`${pollIntervalMs} millis`), () => effect {
            const lastSeq = try Ref.get(cursorRef)
            const batchRes = try exit(store.transaction(effect (tx: Tx) =>
              try tx.query(
                `SELECT seq, payload_json
                 FROM feed_realtime_events
                 WHERE seq > $1 AND origin_isolate <> $2
                 ORDER BY seq ASC
                 LIMIT 100`,
                [lastSeq, isolateId]
              )
            ))
            if (!Exit.isSuccess(batchRes) || batchRes.value.length === 0) return [] as ReadonlyArray<FeedRealtimeEvent>
            let nextSeq = lastSeq
            const out: FeedRealtimeEvent[] = []
            for (const row of batchRes.value) {
              const seq = toInt(row.seq)
              if (seq > nextSeq) nextSeq = seq
              const raw = toText(row.payload_json)
              if (raw === undefined) continue
              const decoded = parseRealtimeEventJson(raw)
              if (decoded !== undefined) out.push(decoded)
            }
            if (nextSeq > lastSeq) {
              try Ref.set(cursorRef, nextSeq)
            }
            return out as ReadonlyArray<FeedRealtimeEvent>
          })
          return Stream.flatMap(batches, (items) => Stream.fromIterable(items))
        })
        return Stream.merge(localStream, remoteStream)
      }
    }
    return shape
  })
}

function normalizeViewerId(viewerAccountId: string | null | undefined): string | undefined {
  if (viewerAccountId === undefined || viewerAccountId === null) return undefined
  const trimmed = viewerAccountId.trim()
  return trimmed === "" ? undefined : trimmed
}

function recipientListAllows(recipientIds: ReadonlyArray<string> | undefined, viewerId: string): boolean {
  return recipientIds === undefined || recipientIds.includes(viewerId)
}

effect function runFailClosedLookup(lookup: boolean!unknown!never): boolean!! {
  const res = try exit(lookup)
  return Exit.isSuccess(res) ? res.value : false
}

effect function visibleParentReplyCountForViewer(
  store: Store.Shape,
  parentPostId: string,
  viewerId?: string
): (number | null)!! {
  const res = try exit(store.transaction(effect (tx: Tx) => {
    const rows = viewerId === undefined
      ? try tx.query(
          "SELECT count(*)::int AS visible_count FROM feed_posts r WHERE r.reply_to_post_id = $1 AND r.deleted_at IS NULL",
          [parentPostId]
        )
      : try tx.query(
          `SELECT count(*)::int AS visible_count FROM feed_posts r WHERE r.reply_to_post_id = $1 AND r.deleted_at IS NULL AND ${viewerAuthorVisibilitySql("$2", "r.author_id")}`,
          [parentPostId, viewerId]
        )
    const row = rows[0]
    return row === undefined ? 0 : toInt(row.visible_count)
  }))
  return Exit.isSuccess(res) ? res.value : null
}

export effect function personalizePostDeletedEvent(
  store: Store.Shape | undefined,
  event: FeedRealtimeEvent,
  viewerAccountId: string | null | undefined
): FeedRealtimeEvent!! {
  if (event.type === "post.created") {
    const parentId = event.replyToPostId
    if (parentId === null || parentId === "" || store === undefined) return event
    const viewerId = normalizeViewerId(viewerAccountId)
    const count = try visibleParentReplyCountForViewer(store, parentId, viewerId)
    if (count === null) return event
    return {
      type: "post.created",
      postId: event.postId,
      authorId: event.authorId,
      authorKind: event.authorKind,
      replyToPostId: event.replyToPostId,
      quotePostId: event.quotePostId,
      ...(event.quoteAuthorId === undefined ? {} : { quoteAuthorId: event.quoteAuthorId }),
      createdAt: event.createdAt,
      parentReplyCount: count
    }
  }
  if (event.type !== "post.deleted") return event
  const viewerId = normalizeViewerId(viewerAccountId)
  const parentId = event.replyToPostId ?? null
  if (viewerId === undefined || parentId === null || parentId === "" || store === undefined) return event
  const count = try visibleParentReplyCountForViewer(store, parentId, viewerId)
  if (count === null) return event
  return { type: "post.deleted", postId: event.postId, authorId: event.authorId, replyToPostId: event.replyToPostId, parentReplyCount: count }
}

effect function isAuthorVisibleInStore(
  store: Store.Shape | undefined,
  viewerId: string,
  authorId: string
): boolean!! {
  if (authorId === "" || authorId === viewerId) return true
  if (store === undefined) return false
  return try runFailClosedLookup(store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      "SELECT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = $1 AND b.blocked_id = $2) OR (b.blocker_id = $2 AND b.blocked_id = $1)) AS is_blocked, EXISTS (SELECT 1 FROM feed_mutes m WHERE m.muter_id = $1 AND m.muted_id = $2) AS is_muted",
      [viewerId, authorId]
    )
    const row = rows[0]
    if (row === undefined) return false
    return !row.is_blocked && !row.is_muted
  }))
}

// spec/app/navigation.md, "Surface visibility and delayed visitor banner derivation"; spec/social/moderation.md, "Story: Block, mute, follow, and report users or posts"
effect function traderActivityDeliveryInStore(
  store: Store.Shape | undefined,
  viewerId: string,
  traderId: string
): ("full" | "aggregate" | "none")!! {
  if (store === undefined) return "none"
  const res = try exit(store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      `SELECT a.ui_mode, ${viewerBlockVisibilitySql("$1", "$2")} AS is_visible FROM feed_accounts a WHERE a.account_id = $1 LIMIT 1`,
      [viewerId, traderId]
    )
    const row = rows[0]
    if (row === undefined || toText(row.ui_mode) === "social") return "none" as const
    const isVisible = Boolean(row.is_visible)
    return isVisible ? "full" as const : "aggregate" as const
  }))
  return Exit.isSuccess(res) ? res.value : "none"
}

effect function isPostCreatedDeliverableInStore(
  store: Store.Shape | undefined,
  viewerId: string,
  event: Extract<FeedRealtimeEvent, { readonly type: "post.created" }>
): boolean!! {
  if (store === undefined) return false
  return try runFailClosedLookup(store.transaction(effect (tx: Tx) => {
    if (event.authorId !== "" && event.authorId !== viewerId) {
      const authorRows = try tx.query(
        "SELECT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = $1 AND b.blocked_id = $2) OR (b.blocker_id = $2 AND b.blocked_id = $1)) AS is_blocked, EXISTS (SELECT 1 FROM feed_mutes m WHERE m.muter_id = $1 AND m.muted_id = $2) AS is_muted",
        [viewerId, event.authorId]
      )
      const authorRow = authorRows[0]
      if (authorRow === undefined || Boolean(authorRow.is_blocked) || Boolean(authorRow.is_muted)) return false
    }
    let quoteAuthorId = event.quoteAuthorId ?? null
    if (quoteAuthorId === null && event.quotePostId !== null && event.quotePostId !== "") {
      const quoteRows = try tx.query(
        "SELECT author_id FROM feed_posts WHERE id = $1 LIMIT 1",
        [event.quotePostId]
      )
      quoteAuthorId = toText(quoteRows[0]?.author_id) ?? null
    }
    if (quoteAuthorId !== null && quoteAuthorId !== "" && quoteAuthorId !== viewerId) {
      const quoteVisRows = try tx.query(
        "SELECT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = $1 AND b.blocked_id = $2) OR (b.blocker_id = $2 AND b.blocked_id = $1)) AS is_blocked, EXISTS (SELECT 1 FROM feed_mutes m WHERE m.muter_id = $1 AND m.muted_id = $2) AS is_muted",
        [viewerId, quoteAuthorId]
      )
      const quoteVis = quoteVisRows[0]
      if (quoteVis === undefined || Boolean(quoteVis.is_blocked) || Boolean(quoteVis.is_muted)) return false
    }
    return true
  }))
}

effect function isChatEventDeliverableInStore(
  store: Store.Shape | undefined,
  viewerId: string,
  chatId: string,
  authorId: string,
  recipientIds: ReadonlyArray<string> | undefined
): boolean!! {
  if (!recipientListAllows(recipientIds, viewerId)) return false
  if (store === undefined || chatId === "") return false
  return try runFailClosedLookup(store.transaction(effect (tx: Tx) => {
    const memberRows = try tx.query(
      "SELECT c.kind FROM feed_chat_members m INNER JOIN feed_chats c ON c.id = m.chat_id WHERE m.chat_id = $1 AND m.member_id = $2 LIMIT 1",
      [chatId, viewerId]
    )
    const memberRow = memberRows[0]
    if (memberRow === undefined) return false
    if (authorId === "" || authorId === viewerId) return true
    const chatKind = toText(memberRow.kind) ?? "group"
    const visRows = try tx.query(
      "SELECT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = $1 AND b.blocked_id = $2) OR (b.blocker_id = $2 AND b.blocked_id = $1)) AS is_blocked, EXISTS (SELECT 1 FROM feed_mutes m WHERE m.muter_id = $1 AND m.muted_id = $2) AS is_muted",
      [viewerId, authorId]
    )
    const row = visRows[0]
    if (row === undefined) return false
    if (chatKind === "direct") return !row.is_blocked
    return !row.is_blocked && !row.is_muted
  }))
}

effect function isNotificationDeliverableInStore(
  store: Store.Shape | undefined,
  viewerId: string,
  event: Extract<FeedRealtimeEvent, { readonly type: "notification.created" }>
): boolean!! {
  if (event.accountId !== viewerId) return false
  if (!recipientListAllows(event.recipientIds, viewerId)) return false
  if (store === undefined) return false
  return try runFailClosedLookup(store.transaction(effect (tx: Tx) => {
    const accountRows = try tx.query(
      "SELECT ui_mode FROM feed_accounts WHERE account_id = $1 LIMIT 1",
      [viewerId]
    )
    if (accountRows.length === 0) return false
    const isGameNotif = event.isGameOnly || event.kind === "market_resolved" || event.kind === "pnl_digest"
    if (isGameNotif && toText(accountRows[0]?.ui_mode) === "social") return false
    const actorId = event.actorId ?? null
    if (actorId !== null && actorId !== "" && actorId !== viewerId) {
      const blockedRows = try tx.query(
        "SELECT 1 FROM feed_blocks WHERE (blocker_id = $1 AND blocked_id = $2) OR (blocker_id = $2 AND blocked_id = $1) LIMIT 1",
        [viewerId, actorId]
      )
      if (blockedRows.length > 0) return false
      const mutedRows = try tx.query(
        "SELECT 1 FROM feed_mutes WHERE muter_id = $1 AND muted_id = $2 LIMIT 1",
        [viewerId, actorId]
      )
      if (mutedRows.length > 0) return false
    }
    return true
  }))
}

effect function isPostEngagementAuthorVisibleInStore(
  store: Store.Shape | undefined,
  viewerId: string,
  event: Extract<FeedRealtimeEvent, { readonly type: "post.engagement" }>
): boolean!! {
  const fieldAuthorId = event.postAuthorId ?? null
  if (fieldAuthorId !== null && fieldAuthorId !== "") {
    if (fieldAuthorId === viewerId) return true
    return try isAuthorVisibleInStore(store, viewerId, fieldAuthorId)
  }
  if (store === undefined) return false
  return try runFailClosedLookup(store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      "SELECT author_id FROM feed_posts WHERE id = $1 LIMIT 1",
      [event.postId]
    )
    const postAuthorId = toText(rows[0]?.author_id) ?? ""
    if (postAuthorId === "") return false
    if (postAuthorId === viewerId) return true
    const visRows = try tx.query(
      "SELECT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = $1 AND b.blocked_id = $2) OR (b.blocker_id = $2 AND b.blocked_id = $1)) AS is_blocked, EXISTS (SELECT 1 FROM feed_mutes m WHERE m.muter_id = $1 AND m.muted_id = $2) AS is_muted",
      [viewerId, postAuthorId]
    )
    const row = visRows[0]
    if (row === undefined) return false
    return !row.is_blocked && !row.is_muted
  }))
}
export effect function canDeliverRealtimeEventToViewer(
  store: Store.Shape | undefined,
  event: FeedRealtimeEvent,
  viewerAccountId: string | null | undefined
): boolean!! {
  const viewerId = normalizeViewerId(viewerAccountId)
  switch (event.type) {
    case "world.tick":
    case "market.prediction":
    case "market.clue":
    case "market.resolved":
    case "article.published":
      return true
    case "org.posted":
      return viewerId === undefined ? true : try isAuthorVisibleInStore(store, viewerId, event.organizationId)
    case "market.spot":
    case "market.perp":
      return viewerId === undefined ? true : (try traderActivityDeliveryInStore(store, viewerId, event.actorId)) === "full"
    case "post.created":
      return viewerId === undefined ? true : try isPostCreatedDeliverableInStore(store, viewerId, event)
    case "post.deleted":
      return viewerId === undefined ? true : try isAuthorVisibleInStore(store, viewerId, event.authorId)
    case "post.engagement":
      if (viewerId === undefined) return true
      if (!try isAuthorVisibleInStore(store, viewerId, event.accountId)) return false
      return try isPostEngagementAuthorVisibleInStore(store, viewerId, event)
    case "chat.message":
      return viewerId === undefined
        ? false
        : try isChatEventDeliverableInStore(store, viewerId, event.chatId, event.senderId, event.recipientIds)
    case "chat.reaction":
      return viewerId === undefined
        ? false
        : try isChatEventDeliverableInStore(store, viewerId, event.chatId, event.accountId, event.recipientIds)
    case "chat.invite":
      if (viewerId === undefined || event.invitedAccountId !== viewerId || !recipientListAllows(event.recipientIds, viewerId)) {
        return false
      }
      return try isAuthorVisibleInStore(store, viewerId, event.invitedById ?? event.invitedByNpcId)
    case "chat.updated":
      if (viewerId === undefined || !recipientListAllows(event.recipientIds, viewerId)) {
        return false
      }
      if (event.action === "deleted" || event.action === "member_removed" || event.action === "member_left") {
        return event.recipientIds !== undefined && event.recipientIds.includes(viewerId)
      }
      return try isChatEventDeliverableInStore(store, viewerId, event.chatId, event.actorId, event.recipientIds)
    case "alpha.invite":
      if (viewerId === undefined || event.targetAccountId !== viewerId || !recipientListAllows(event.recipientIds, viewerId)) {
        return false
      }
      return try isAuthorVisibleInStore(store, viewerId, event.actorId)
    case "notification.created":
      return viewerId === undefined ? false : try isNotificationDeliverableInStore(store, viewerId, event)
    default: {
      const _exhaustive: never = event
      return _exhaustive
    }
  }
}

// spec/markets/spotPerp.md, "Opening a perp enforces the 20x leverage cap and updates only the mark premium"; spec/social/moderation.md, "Story: Block, mute, follow, and report users or posts"
export effect function realtimeEventForViewer(
  store: Store.Shape | undefined,
  event: FeedRealtimeEvent,
  viewerAccountId: string | null | undefined
): (FeedRealtimeEvent | undefined)!! {
  const viewerId = normalizeViewerId(viewerAccountId)
  if ((event.type !== "market.perp" && event.type !== "market.spot") || viewerId === undefined) {
    return (try canDeliverRealtimeEventToViewer(store, event, viewerAccountId)) ? event : undefined
  }
  const delivery = try traderActivityDeliveryInStore(store, viewerId, event.actorId)
  if (delivery === "full") return event
  if (delivery === "none") return undefined
  return { type: "world.tick", kind: "market", refId: event.ticker, createdAt: try Clock.currentTimeMillis }
}

export effect function publishFeedEvent(event: FeedRealtimeEvent): boolean!! {
  const maybeBus = try Effect.serviceOption(RealtimeBus)
  if (Option.isSome(maybeBus)) {
    return try maybeBus.value.publish(event)
  }
  return false
}

export effect function subscribeFeedEvents(): Stream.Stream<FeedRealtimeEvent>!! {
  const maybeBus = try Effect.serviceOption(RealtimeBus)
  return Option.isSome(maybeBus) ? maybeBus.value.subscribe() : Stream.empty
}

export effect function subscribeViewerFeedEvents(
  viewerAccountId: string | null | undefined,
  storeOverride?: Store.Shape
): Stream.Stream<FeedRealtimeEvent>!! {
  const maybeStore = try Effect.serviceOption(Store)
  const store = storeOverride ?? (Option.isSome(maybeStore) ? maybeStore.value : undefined)
  const events = try subscribeFeedEvents()
  const delivered = Stream.filter(
    Stream.mapEffect(events, (event) => realtimeEventForViewer(store, event, viewerAccountId)),
    (event): event is FeedRealtimeEvent => event !== undefined
  )
  return Stream.mapEffect(delivered, (event) => personalizePostDeletedEvent(store, event, viewerAccountId))
}

export function encodeSseEvent(event: FeedRealtimeEvent): Uint8Array {
  return encoder.encode(`event: ${event.type}\ndata: ${JSON.stringify(event)}\n\n`)
}

export function toSseReadableStream(
  events: Stream.Stream<FeedRealtimeEvent>,
  options: SseStreamOptions = {}
): ReadableStream<Uint8Array> {
  const initialFrame = Stream.make(encoder.encode(": connected\n\n"))
  const eventFrames = Stream.map(events, encodeSseEvent)
  const payload = options.keepalive === false
    ? eventFrames
    : Stream.merge(eventFrames, Stream.map(Stream.tick("25 seconds"), () => encoder.encode(": keepalive\n\n")))
  const bytes = Stream.concat(initialFrame, payload)
  return options.signal === undefined
    ? Stream.toReadableStream(bytes)
    : Stream.toReadableStreamWith(bytes, Context.empty(), { signal: options.signal })
}

export effect function createSseResponse(options: SseResponseOptions = {}): Response!! {
  const events = try subscribeViewerFeedEvents(options.viewerAccountId, options.store)
  const filtered = options.filter === undefined ? events : Stream.filter(events, options.filter)
  const streamOptions: SseStreamOptions = {
    ...(options.signal === undefined ? {} : { signal: options.signal }),
    ...(options.keepalive === undefined ? {} : { keepalive: options.keepalive })
  }
  return sseResponse(toSseReadableStream(filtered, streamOptions))
}
