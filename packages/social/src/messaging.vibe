}

export type RespondAlphaInviteInput = RespondGroupInviteInput

export interface CreateNpcAlphaInviteInput {
  readonly actorId: string
  readonly targetAccountId: string
  readonly tier?: string | null
}

export interface InviteToUserGroupInput {
  readonly accountId: string
  readonly chatId: string
