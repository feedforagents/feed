} from "./shared.vibe"

export type ChatKind = "direct" | "user_group" | "npc_alpha"

export type ChatSenderKind = "user" | "npc"

export type ChatMemberRole = "owner" | "admin" | "member"

export interface ChatMemberView {
  readonly memberId: string
  readonly memberKind: ChatSenderKind
  readonly handle: string
  readonly displayName: string
  readonly avatarUrl: string | null
  readonly role: ChatMemberRole
  readonly joinedAt: number
}

export interface ChatSummaryView {
  readonly id: string
  readonly kind: ChatKind
  readonly title: string
  readonly memberCount: number
  readonly unreadCount: number
  readonly lastMessageAt: number | null
  readonly lastMessagePreview: string | null
  readonly createdBy: string
  readonly tier: string | null
  readonly members: ReadonlyArray<ChatMemberView>
  readonly isBlocked: boolean
  readonly createdAt: number
}

export type ChatView = ChatSummaryView

export interface MessageReactionSummary {
  readonly emoji: string
  readonly count: number
  readonly reactedByViewer: boolean
}

export interface ChatMessageView {
  readonly id: string
  readonly chatId: string
  readonly senderId: string
  readonly senderKind: ChatSenderKind
  readonly senderHandle: string
  readonly senderDisplayName: string
  readonly senderAvatarUrl: string | null
  readonly viaClientName: string | null
  readonly content: string
  readonly reactions: ReadonlyArray<MessageReactionSummary>
  readonly createdAt: number
}

export type GroupInviteFilterKind = "all" | "npc_alpha" | "user_group"

export interface GroupInviteView {
  readonly id: string
  readonly chatId: string
  readonly chatKind: "user_group" | "npc_alpha"
  readonly isAlpha: boolean
  readonly inviterId: string
  readonly inviterKind: ChatSenderKind
  readonly inviterHandle: string
  readonly inviterDisplayName: string
  readonly actorId: string
  readonly actorHandle: string
  readonly actorDisplayName: string
  readonly actorAvatarUrl: string | null
  readonly chatTitle: string
  readonly invitedAccountId: string
  readonly tier: string | null
  readonly status: "pending" | "accepted" | "declined"
  readonly respondedAt: number | null
  readonly createdAt: number
}

export type AlphaInviteView = GroupInviteView

export interface SendChatMessageInput {
  readonly senderId: string
  readonly senderKind: ChatSenderKind
  readonly chatId: string
  readonly content: string
  readonly viaClientName?: string | null
}

export interface ReactToMessageInput {
  readonly accountId: string
  readonly chatId?: string
