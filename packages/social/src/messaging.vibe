import {
  canAddReaction,
  canCreateGroup,
  canInviteAlphaGroup,
  canInviteMember,
  canLeaveGroup,
  canReadChat,
  canRespondInvite,
  canSendMessage,
  initial as initialMessagingState,
  maxActiveNpcAlphaGroups,
  maxMessageChars,
  type Account as SpecAccount,
  type BlockPair,
  type Chat as SpecChat,
  type ChatMember as SpecChatMember,
  type ChatMessage as SpecChatMessage,
  type ChatType as SpecChatType,
  type MessagingState,
  type PendingInvite as SpecPendingInvite
} from "../gen/social__messaging.effect.vibe"
import { type FeedRealtimeEvent } from "./realtime.vibe"
