  | {
      readonly kind: "prediction"
      readonly marketId: string
      readonly question: string
      readonly yesPriceBps: number
      readonly closesAt: number
    }
  | {
      readonly kind: "perp"
      readonly ticker: string
      readonly name: string
      readonly markPriceCents: number
    }

