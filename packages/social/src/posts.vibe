const POSTS_PER_HOUR_LIMIT = 30
const MAX_REPLY_ANCESTOR_DEPTH = 50
const HOUR_MS = 3_600_000
const TOP_RECENCY_WINDOW_MS = 24 * HOUR_MS

function toAuthorKind(raw: unknown): PostAuthorKind {
  const value = toText(raw)
  return value === "npc" ? "npc" : value === "org" ? "org" : "user"
}

function viewerAuthorVisibilitySql(viewerParam: string, authorColumn: string): string {
  return `NOT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = ${viewerParam} AND b.blocked_id = ${authorColumn}) OR (b.blocker_id = ${authorColumn} AND b.blocked_id = ${viewerParam})) AND NOT EXISTS (SELECT 1 FROM feed_mutes m WHERE m.muter_id = ${viewerParam} AND m.muted_id = ${authorColumn})`
}

function makeSpecPost(
  id: number,
  authorId: string,
  authorKind: PostAuthorKind,
  viaClientName: string | null,
  content: string,
  replyToPostId: string | null,
  quotePostId: string | null,
  marketId: string | null,
  ticker: string | null,
  likeCount: number,
  repostCount: number,
  likedBy: string[],
  repostedBy: string[]
): SpecPost {
  return {
    id,
    authorId,
    viaClientName: viaClientName ?? "",
    isNpcParody: authorKind !== "user",
    textLen: Math.max(1, Math.min(maxPostChars, content.length)),
    quotePostId: quotePostId === null ? 0 : 1,
    replyToPostId: replyToPostId === null ? 0 : 1,
    hasTradeEmbed: marketId !== null,
    hasCashtag: ticker !== null || extractCashtags(content).length > 0,
    deleted: false,
    deletedBy: "",
    likedBy,
    repostedBy,
    likeCount,
    repostCount
  }
}

function buildAuthorMapKey(kind: PostAuthorKind, id: string): string {
  return `${kind}:${id}`
}

function projectRowToPreview(
  row: Row,
  authors: ReadonlyMap<string, SubjectProfile>,
  mode: SocialPresentationMode
): PostQuotePreview {
  const id = toText(row.id) ?? ""
  const authorId = toText(row.author_id) ?? ""
  const authorKind = toAuthorKind(row.author_kind)
  const content = toText(row.content) ?? ""
  const viaClientName = toText(row.via_client_name) ?? null
  const rawMarketId = toText(row.market_id) ?? null
  const rawTicker = toText(row.ticker) ?? null
  const specPost = makeSpecPost(
    1,
    authorId,
    authorKind,
    viaClientName,
    content,
    toText(row.reply_to_post_id) ?? null,
    toText(row.quote_post_id) ?? null,
    rawMarketId,
    rawTicker,
    safeInt(row.like_count, 0),
    safeInt(row.repost_count, 0),
    [],
    []
  )
  const projected = projectForMode(specPost, toSpecMode(mode))
  const author = authors.get(buildAuthorMapKey(authorKind, authorId))
  return {
    id,
    authorId,
    authorKind,
    authorHandle: author?.handle ?? authorId,
    authorDisplayName: author?.displayName ?? authorId,
    avatarUrl: author?.avatarUrl ?? null,
    isParody: projected.isNpcParody,
    parodyLabel: null,
    viaClientName: projected.viaClientName === "" ? null : projected.viaClientName,
    content,
    marketId: projected.showTradeEmbed ? rawMarketId : null,
    ticker: projected.linkCashtags ? rawTicker : null,
    cashtags: projected.linkCashtags ? extractCashtags(content, rawTicker) : [],
    hashtags: extractHashtags(content),
    showTradeEmbed: projected.showTradeEmbed,
    linkCashtags: projected.linkCashtags,
    createdAt: safeInt(row.created_at, 0)
  }
}

effect function hydratePostRowsTx(
  tx: Tx,
  rows: ReadonlyArray<Row>,
  viewerId: string | undefined,
  mode: SocialPresentationMode
): ReadonlyArray<PostView>!StoreFailure {
  if (rows.length === 0) return []
  const quoteIds = [...new Set(rows.map((r) => toText(r.quote_post_id)).filter((id): id is string => id !== undefined && id !== ""))]
  let quoteRows: ReadonlyArray<Row> = []
  if (quoteIds.length > 0) {
    quoteRows = viewerId !== undefined && viewerId !== ""
      ? try tx.query(
          `SELECT p.* FROM feed_posts p WHERE p.id = ANY($1) AND p.deleted_at IS NULL AND ${viewerAuthorVisibilitySql("$2", "p.author_id")}`,
          [quoteIds, viewerId]
        )
      : try tx.query("SELECT * FROM feed_posts WHERE id = ANY($1) AND deleted_at IS NULL", [quoteIds])
  }
  const replyParentIds = [...new Set(rows.map((r) => toText(r.reply_to_post_id)).filter((id): id is string => id !== undefined && id !== ""))]
  const parentAuthorByPostId = new Map<string, { readonly authorId: string; readonly authorKind: PostAuthorKind }>()
  if (replyParentIds.length > 0) {
    const parentRows = try tx.query(
      "SELECT id, author_id, author_kind FROM feed_posts WHERE id = ANY($1)",
      [replyParentIds]
    )
    for (const parentRow of parentRows) {
      const pid = toText(parentRow.id)
      const aid = toText(parentRow.author_id)
      if (pid !== undefined && aid !== undefined) {
        parentAuthorByPostId.set(pid, { authorId: aid, authorKind: toAuthorKind(parentRow.author_kind) })
      }
    }
  }
  const allRows = [...rows, ...quoteRows]
  const authorRefs = [
    ...allRows.map((r) => ({ id: toText(r.author_id) ?? "", kind: toAuthorKind(r.author_kind) })),
    ...[...parentAuthorByPostId.values()].map((p) => ({ id: p.authorId, kind: p.authorKind }))
  ]
  const authors = try loadSubjectProfilesMapTx(tx, authorRefs)
  const reposterIds = [...new Set(rows.map((r) => toText(r.reposter_id)).filter((id): id is string => id !== undefined && id !== ""))]
  const reposterProfiles = reposterIds.length > 0 ? try loadProfilesByIdsTx(tx, reposterIds) : new Map<string, SubjectProfile>()
  const quoteMap = new Map<string, PostQuotePreview>()
  for (const quoteRow of quoteRows) {
    const preview = projectRowToPreview(quoteRow, authors, mode)
    quoteMap.set(preview.id, preview)
  }
  const predictionBadgeMap = new Map<string, PostMarketBadge>()
  const perpBadgeMap = new Map<string, PostMarketBadge>()
  if (mode === "game") {
    const marketIds = [...new Set(rows.map((r) => toText(r.market_id)).filter((id): id is string => id !== undefined && id !== ""))]
    if (marketIds.length > 0) {
      const marketRows = try tx.query(
        "SELECT id, question, yes_shares, no_shares, expires_at FROM feed_prediction_markets WHERE id = ANY($1)",
        [marketIds]
      )
      for (const mRow of marketRows) {
        const mid = toText(mRow.id) ?? ""
        if (mid === "") continue
        const yesShares = safeInt(mRow.yes_shares, 0)
        const noShares = safeInt(mRow.no_shares, 0)
        const total = yesShares + noShares
        const yesPriceBps = total > 0 ? Math.floor((noShares * 10_000) / total) : 5_000
        predictionBadgeMap.set(mid, {
          kind: "prediction",
          marketId: mid,
          question: toText(mRow.question) ?? "",
          yesPriceBps,
          closesAt: safeInt(mRow.expires_at, 0)
        })
      }
    }
    const tickers = [...new Set(rows.map((r) => toText(r.ticker)?.trim().toUpperCase()).filter((t): t is string => t !== undefined && t !== ""))]
    if (tickers.length > 0) {
      const perpRows = try tx.query(
        `SELECT m.ticker, m.mark_price_cents, COALESCE(o.name, m.ticker) AS org_name
         FROM feed_perp_markets m
         LEFT JOIN feed_spot_pools p ON p.ticker = m.ticker
         LEFT JOIN feed_organizations o ON o.id = p.organization_id
         WHERE upper(m.ticker) = ANY($1)`,
        [tickers]
      )
      for (const pRow of perpRows) {
        const ticker = (toText(pRow.ticker) ?? "").toUpperCase()
        if (ticker === "") continue
        perpBadgeMap.set(ticker, {
          kind: "perp",
          ticker,
          name: toText(pRow.org_name) ?? ticker,
          markPriceCents: safeInt(pRow.mark_price_cents, 0)
        })
      }
    }
  }
  const postIds = rows.map((r) => toText(r.id) ?? "").filter(Boolean)
  const replyCountMap = new Map<string, number>()
  if (postIds.length > 0) {
    const replyCountRows = viewerId !== undefined && viewerId !== ""
      ? try tx.query(
          `SELECT r.reply_to_post_id AS post_id, count(*)::int AS visible_count FROM feed_posts r WHERE r.reply_to_post_id = ANY($1) AND r.deleted_at IS NULL AND ${viewerAuthorVisibilitySql("$2", "r.author_id")} GROUP BY r.reply_to_post_id`,
          [postIds, viewerId]
        )
      : try tx.query(
          "SELECT r.reply_to_post_id AS post_id, count(*)::int AS visible_count FROM feed_posts r WHERE r.reply_to_post_id = ANY($1) AND r.deleted_at IS NULL GROUP BY r.reply_to_post_id",
          [postIds]
        )
    for (const row of replyCountRows) {
      const pid = toText(row.post_id)
      if (pid !== undefined) replyCountMap.set(pid, safeInt(row.visible_count, 0))
    }
  }
  const likedSet = new Set<string>()
  const repostedSet = new Set<string>()
  if (viewerId !== undefined && viewerId !== "" && postIds.length > 0) {
    const likeRows = try tx.query(
      "SELECT post_id FROM feed_post_likes WHERE account_id = $1 AND post_id = ANY($2)",
      [viewerId, postIds]
    )
    for (const row of likeRows) {
      const pid = toText(row.post_id)
      if (pid !== undefined) likedSet.add(pid)
    }
    const repostRows = try tx.query(
      "SELECT post_id FROM feed_post_reposts WHERE account_id = $1 AND post_id = ANY($2)",
      [viewerId, postIds]
    )
    for (const row of repostRows) {
      const pid = toText(row.post_id)
      if (pid !== undefined) repostedSet.add(pid)
    }
  }
  return rows.map((row) => {
    const base = projectRowToPreview(row, authors, mode)
    const replyToPostId = toText(row.reply_to_post_id) ?? null
    const parentMeta = replyToPostId === null ? undefined : parentAuthorByPostId.get(replyToPostId)
    const parentProfile = parentMeta === undefined ? undefined : authors.get(buildAuthorMapKey(parentMeta.authorKind, parentMeta.authorId))
    const quotePostId = toText(row.quote_post_id) ?? null
    const reposterId = toText(row.reposter_id) ?? null
    const reposterProfile = reposterId === null ? undefined : reposterProfiles.get(reposterId)
    const rawRepostedAt = row.reposted_at === null || row.reposted_at === undefined ? null : safeInt(row.reposted_at, 0)
    const marketBadge = mode !== "game"
      ? null
      : (base.marketId !== null ? predictionBadgeMap.get(base.marketId) : undefined)
        ?? (base.ticker !== null ? perpBadgeMap.get(base.ticker.toUpperCase()) : undefined)
        ?? null
    return {
      ...base,
      replyToPostId,
      replyToHandle: parentProfile?.handle ?? parentMeta?.authorId ?? null,
      replyToAuthorId: parentMeta?.authorId ?? null,
      quotePostId,
      quotePost: quotePostId === null ? null : (quoteMap.get(quotePostId) ?? null),
      repostedByHandle: reposterId === null ? null : (reposterProfile?.handle ?? reposterId),
      repostedByName: reposterId === null ? null : (reposterProfile?.displayName ?? reposterProfile?.handle ?? reposterId),
      repostedAt: reposterId === null ? null : rawRepostedAt,
      marketBadge,
      likeCount: safeInt(row.like_count, 0),
      repostCount: safeInt(row.repost_count, 0),
      replyCount: replyCountMap.get(base.id) ?? 0,
      likedByViewer: likedSet.has(base.id),
      repostedByViewer: repostedSet.has(base.id)
    }
  })
}

function parseCursor(cursor: string | undefined, requireScore: boolean): ParsedCursor | undefined {
  if (cursor === undefined || cursor.trim() === "") return undefined
  if (requireScore) {
    const first = cursor.indexOf(":")
    const second = first < 0 ? -1 : cursor.indexOf(":", first + 1)
    if (first <= 0 || second <= first + 1) return undefined
    const score = Number(cursor.slice(0, first))
    const createdAt = Number(cursor.slice(first + 1, second))
    const id = cursor.slice(second + 1)
    if (!Number.isFinite(score) || !Number.isFinite(createdAt) || id === "") return undefined
    return { score, createdAt, id }
  }
  const sep = cursor.indexOf(":")
  if (sep <= 0) return undefined
  const createdAt = Number(cursor.slice(0, sep))
  const id = cursor.slice(sep + 1)
  if (!Number.isFinite(createdAt) || id === "") return undefined
  return { score: undefined, createdAt, id }
}

function encodeCursorFromRow(row: Row, tab: FeedTab): string {
  const sortTs = safeInt(row.sort_ts ?? row.created_at, 0)
  const id = toText(row.id) ?? ""
  if (tab === "top") {
    const score = safeInt(row.computed_score, safeInt(row.like_count, 0) * 2 + safeInt(row.repost_count, 0) * 3 + safeInt(row.reply_count, 0) * 2)
    return `${score}:${sortTs}:${id}`
  }
  return `${sortTs}:${id}`
}

effect function resolveAuthorFilterIdsTx(tx: Tx, authorFilter: string): ReadonlyArray<string>!StoreFailure {
  const orgMatch = try tx.query("SELECT 1 FROM feed_organizations WHERE id = $1 LIMIT 1", [authorFilter])
  return orgMatch.length > 0 ? [authorFilter, `org-${authorFilter}`] : [authorFilter]
}

effect function finishFeedPageTx(
  tx: Tx,
  sql: string,
  params: ReadonlyArray<unknown>,
  limit: number,
  viewerId: string | undefined,
  mode: SocialPresentationMode,
  tab: FeedTab
): FeedPage!StoreFailure {
  const rows = try tx.query(sql, params)
  const hasMore = rows.length > limit
  const pageRows = hasMore ? rows.slice(0, limit) : rows
  const items = try hydratePostRowsTx(tx, pageRows, viewerId, mode)
  const lastRow = pageRows[pageRows.length - 1]
  return {
    items,
    nextCursor: hasMore && lastRow !== undefined ? encodeCursorFromRow(lastRow, tab) : null
  }
}

export effect function listFeedPosts(input: ListFeedPostsInput): FeedPage!(SocialFailure | StoreFailure)!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const limit = clampLimit(input.limit, 25, 100)
  const viewerId = normalizeOptionalText(input.viewerId) ?? undefined
  if (input.tab === "following" && viewerId === undefined) {
    return { items: [], nextCursor: null }
  }
  const parsedCursor = input.cursor === undefined ? undefined : parseCursor(input.cursor, input.tab === "top")
  if (input.cursor !== undefined && input.cursor.trim() !== "" && parsedCursor === undefined) {
    throw new SocialFailure({ code: "InvalidInput", message: "Invalid feed cursor" })
  }
  const effectiveFilter: FeedPostFilter = input.onlyReplies === true
    ? "replies"
    : (input.filter ?? (input.includeReplies === true ? "all" : "posts"))
  return try store.transaction(effect (tx: Tx) => {
    const mode = input.mode ?? (try readViewerUiModeTx(tx, viewerId))
    let authorFilter = normalizeOptionalText(input.authorId)
    if (authorFilter === null) {
      const handleFilter = normalizeOptionalText(input.authorHandle)
      if (handleFilter !== null) {
        const subject = try resolveSubjectTx(tx, handleFilter)
        authorFilter = subject.id
      }
    }
    const tickerFilter = normalizeOptionalText(input.ticker)
    const marketFilter = normalizeOptionalText(input.marketId)
    const includeReposts = effectiveFilter === "posts" && (input.tab === "following" || (authorFilter !== null && input.tab === "latest"))
    if (includeReposts) {
      const params: unknown[] = []
      const origConditions: string[] = ["p.deleted_at IS NULL", "p.reply_to_post_id IS NULL"]
      const repostConditions: string[] = ["p.deleted_at IS NULL", "p.reply_to_post_id IS NULL"]
      if (viewerId !== undefined) {
        params.push(viewerId)
        const viewerParam = `$${params.length}`
        origConditions.push(viewerAuthorVisibilitySql(viewerParam, "p.author_id"))
        repostConditions.push(viewerAuthorVisibilitySql(viewerParam, "p.author_id"))
        repostConditions.push(viewerAuthorVisibilitySql(viewerParam, "r.account_id"))
        if (input.tab === "following") {
          origConditions.push(`(p.author_id = ${viewerParam} OR EXISTS (SELECT 1 FROM feed_follows f WHERE f.follower_id = ${viewerParam} AND f.target_id = p.author_id))`)
          repostConditions.push(`(r.account_id = ${viewerParam} OR EXISTS (SELECT 1 FROM feed_follows f WHERE f.follower_id = ${viewerParam} AND f.target_id = r.account_id))`)
        }
      }
      if (authorFilter !== null) {
        const authorIds = try resolveAuthorFilterIdsTx(tx, authorFilter)
        if (authorIds.length === 2) {
          params.push(authorIds[0], authorIds[1])
          const ap = `$${params.length - 1}`
          const orgAp = `$${params.length}`
          origConditions.push(`(p.author_id = ${ap} OR p.author_id = ${orgAp})`)
          repostConditions.push(`(r.account_id = ${ap} OR r.account_id = ${orgAp})`)
        } else {
          params.push(authorIds[0])
          const ap = `$${params.length}`
          origConditions.push(`p.author_id = ${ap}`)
          repostConditions.push(`r.account_id = ${ap}`)
        }
      }
      if (tickerFilter !== null) {
        params.push(tickerFilter.toUpperCase())
        const tp = `$${params.length}`
        origConditions.push(`upper(p.ticker) = ${tp}`)
        repostConditions.push(`upper(p.ticker) = ${tp}`)
      }
      if (marketFilter !== null) {
        params.push(marketFilter)
        const mp = `$${params.length}`
        origConditions.push(`p.market_id = ${mp}`)
        repostConditions.push(`p.market_id = ${mp}`)
      }
      let cursorWhere = ""
      if (parsedCursor !== undefined) {
        params.push(parsedCursor.createdAt, parsedCursor.id)
        const c = `$${params.length - 1}`
        const idp = `$${params.length}`
        cursorWhere = `WHERE (deduped.sort_ts < ${c} OR (deduped.sort_ts = ${c} AND deduped.id < ${idp}))`
      }
      params.push(limit + 1)
      const limitParam = `$${params.length}`
      const sql = `WITH feed_entries AS (
        SELECT p.*, NULL::text AS reposter_id, NULL::bigint AS reposted_at, p.created_at AS sort_ts
        FROM feed_posts p
        WHERE ${origConditions.join(" AND ")}
        UNION ALL
        SELECT p.*, r.account_id AS reposter_id, r.created_at AS reposted_at, r.created_at AS sort_ts
        FROM feed_post_reposts r
        INNER JOIN feed_posts p ON p.id = r.post_id
        WHERE ${repostConditions.join(" AND ")}
      ),
      deduped AS (
        SELECT DISTINCT ON (id) *
        FROM feed_entries
        ORDER BY id, sort_ts DESC, (reposter_id IS NULL) DESC
      )
      SELECT * FROM deduped
      ${cursorWhere}
      ORDER BY sort_ts DESC, id DESC
      LIMIT ${limitParam}`
      return try finishFeedPageTx(tx, sql, params, limit, viewerId, mode, input.tab)
    }
    const conditions: string[] = ["p.deleted_at IS NULL"]
    if (effectiveFilter === "posts") {
      conditions.push("p.reply_to_post_id IS NULL")
    } else if (effectiveFilter === "replies") {
      conditions.push("p.reply_to_post_id IS NOT NULL")
    }
    const params: unknown[] = []
    if (viewerId !== undefined) {
      params.push(viewerId)
      const v = `$${params.length}`
      conditions.push(viewerAuthorVisibilitySql(v, "p.author_id"))
    }
    if (authorFilter !== null) {
      const authorIds = try resolveAuthorFilterIdsTx(tx, authorFilter)
      if (authorIds.length === 2) {
        params.push(authorIds[0], authorIds[1])
        conditions.push(`(p.author_id = $${params.length - 1} OR p.author_id = $${params.length})`)
      } else {
        params.push(authorIds[0])
        conditions.push(`p.author_id = $${params.length}`)
      }
    }
    if (tickerFilter !== null) {
      params.push(tickerFilter.toUpperCase())
      conditions.push(`upper(p.ticker) = $${params.length}`)
    }
    if (marketFilter !== null) {
      params.push(marketFilter)
      conditions.push(`p.market_id = $${params.length}`)
    }
    let selectCols = "p.*"
    let orderBy = "p.created_at DESC, p.id DESC"
    if (input.tab === "top") {
      const cutoff = now - TOP_RECENCY_WINDOW_MS
      params.push(cutoff, now)
      const cutoffParam = `$${params.length - 1}`
      const nowParam = `$${params.length}`
      conditions.push(`p.created_at >= ${cutoffParam}`)
      const scoreExpr = `((p.like_count * 2 + p.repost_count * 3 + p.reply_count * 2) * GREATEST(1, 24 - FLOOR(GREATEST(0, ${nowParam} - p.created_at) / 3600000)::int))`
      selectCols = `p.*, ${scoreExpr} AS computed_score`
      orderBy = `${scoreExpr} DESC, p.created_at DESC, p.id DESC`
      if (parsedCursor !== undefined && parsedCursor.score !== undefined) {
        params.push(parsedCursor.score, parsedCursor.createdAt, parsedCursor.id)
        const s = `$${params.length - 2}`
        const c = `$${params.length - 1}`
        const idp = `$${params.length}`
        conditions.push(`(${scoreExpr} < ${s} OR (${scoreExpr} = ${s} AND (p.created_at < ${c} OR (p.created_at = ${c} AND p.id < ${idp}))))`)
      }
    } else if (parsedCursor !== undefined) {
      params.push(parsedCursor.createdAt, parsedCursor.id)
      const c = `$${params.length - 1}`
      const idp = `$${params.length}`
      conditions.push(`(p.created_at < ${c} OR (p.created_at = ${c} AND p.id < ${idp}))`)
    }
    params.push(limit + 1)
    const sql = `SELECT ${selectCols} FROM feed_posts p WHERE ${conditions.join(" AND ")} ORDER BY ${orderBy} LIMIT $${params.length}`
    return try finishFeedPageTx(tx, sql, params, limit, viewerId, mode, input.tab)
  })
}

effect function checkViewerCanSeeAuthorTx(tx: Tx, viewerId: string, authorId: string): void!(SocialFailure | StoreFailure) {
  const blocked = try isBlockedBetweenTx(tx, viewerId, authorId)
  const mutedRows = try tx.query("SELECT 1 FROM feed_mutes WHERE muter_id = $1 AND muted_id = $2 LIMIT 1", [viewerId, authorId])
  const muted = mutedRows.length > 0
  const blocks: BlockRecord[] = blocked ? [{ blockerId: viewerId, blockedId: authorId }] : []
  const mutes: MuteRecord[] = muted ? [{ muterId: viewerId, mutedId: authorId }] : []
  const modState: ModerationState = {
    accounts: [
      { id: viewerId, mode: "GameMode", openPositionCount: 0, unreadCount: 0 },
      ...(authorId === viewerId ? [] : [{ id: authorId, mode: "GameMode" as const, openPositionCount: 0, unreadCount: 0 }])
    ],
    blocks,
    mutes,
    follows: [],
    reports: [],
    notifications: [],
    lastReportId: 0,
    lastNotificationId: 0,
    blocksClearedFollowsCount: 0
  }
  if (!isAuthorVisibleToViewer(modState, viewerId, authorId)) {
    throw new SocialFailure({ code: blocked ? "Blocked" : "NotFound", message: blocked ? "Post is unavailable due to a block" : "Post not found" })
  }
}

export effect function getPostThread(
  postId: string,
  viewerId?: string,
  mode?: SocialPresentationMode,
  sort?: PostThreadSort
): PostThreadView!(SocialFailure | StoreFailure)!Store {
  if (postId.trim() === "") {
    throw new SocialFailure({ code: "InvalidInput", message: "Post ID is required" })
  }
  const store = try Store
  const viewer = normalizeOptionalText(viewerId) ?? undefined
  return try store.transaction(effect (tx: Tx) => {
    const effectiveMode = mode ?? (try readViewerUiModeTx(tx, viewer))
    const rootRows = try tx.query("SELECT * FROM feed_posts WHERE id = $1 AND deleted_at IS NULL LIMIT 1", [postId])
    const rootRow = rootRows[0]
    if (rootRow === undefined) {
      throw new SocialFailure({ code: "NotFound", message: "Post not found" })
    }
    const rootAuthorId = toText(rootRow.author_id) ?? ""
    if (viewer !== undefined) {
      try checkViewerCanSeeAuthorTx(tx, viewer, rootAuthorId)
    }
    const visibilitySuffix = viewer === undefined ? "" : ` AND ${viewerAuthorVisibilitySql("$2", "p.author_id")}`
    const replyOrderBy = sort === "popular"
      ? "(p.like_count * 2 + p.repost_count * 3 + p.reply_count * 2) DESC, p.created_at DESC, p.id DESC"
      : sort === "newest"
        ? "p.created_at DESC, p.id DESC"
        : "p.created_at ASC, p.id ASC"
    const replyParams: unknown[] = viewer === undefined ? [postId] : [postId, viewer]
    const replyRows = try tx.query(
      `SELECT p.* FROM feed_posts p WHERE p.reply_to_post_id = $1 AND p.deleted_at IS NULL${visibilitySuffix} ORDER BY ${replyOrderBy}`,
      replyParams
    )
    const parentId = toText(rootRow.reply_to_post_id) ?? null
    const ancestorVisibility = viewer === undefined ? "" : ` AND ${viewerAuthorVisibilitySql("$4", "p.author_id")}`
    const ancestorRows = parentId === null
      ? []
      : try tx.query(
          `WITH RECURSIVE chain(id, reply_to_post_id, depth, visited) AS (
             SELECT id, reply_to_post_id, 1, ARRAY[$1::text, id]
             FROM feed_posts
             WHERE id = $2 AND id <> $1
             UNION ALL
             SELECT p.id, p.reply_to_post_id, c.depth + 1, c.visited || p.id
             FROM feed_posts p
             INNER JOIN chain c ON p.id = c.reply_to_post_id
             WHERE c.reply_to_post_id IS NOT NULL
               AND c.depth < $3
               AND NOT (p.id = ANY(c.visited))
           )
           SELECT p.*
           FROM chain c
           INNER JOIN feed_posts p ON p.id = c.id
           WHERE p.deleted_at IS NULL${ancestorVisibility}
           ORDER BY c.depth DESC`,
          viewer === undefined
            ? [postId, parentId, MAX_REPLY_ANCESTOR_DEPTH]
            : [postId, parentId, MAX_REPLY_ANCESTOR_DEPTH, viewer]
        )
    const allHydrated = try hydratePostRowsTx(tx, [rootRow, ...ancestorRows, ...replyRows], viewer, effectiveMode)
    const post = allHydrated[0]!
    const ancestors = allHydrated.slice(1, 1 + ancestorRows.length)
    const parentPost = parentId === null ? null : (ancestors.find((a) => a.id === parentId) ?? null)
    const replies = allHydrated.slice(1 + ancestorRows.length)
    return { post, parentPost, ancestors, replies }
  })
}

effect function resolveReferencePostTx(
  tx: Tx,
  authorId: string,
  targetPostId: string | null,
  label: string,
  walkReplyAncestors: boolean
): ({ readonly id: string; readonly authorId: string; readonly authorKind: PostAuthorKind } | undefined)!(SocialFailure | StoreFailure) {
  if (targetPostId === null) return undefined
  const rows = try tx.query(
    "SELECT id, author_id, author_kind, reply_to_post_id FROM feed_posts WHERE id = $1 AND deleted_at IS NULL LIMIT 1 FOR UPDATE",
    [targetPostId]
  )
  const row = rows[0]
  if (row === undefined) {
    throw new SocialFailure({ code: "NotFound", message: `${label} target post not found` })
  }
  const resolvedId = toText(row.id) ?? targetPostId
  const targetAuthorId = toText(row.author_id) ?? ""
  if (try isBlockedBetweenTx(tx, authorId, targetAuthorId)) {
    throw new SocialFailure({ code: "Blocked", message: `Cannot ${label.toLowerCase()} a post from a blocked account` })
  }
  const parentReplyToPostId = toText(row.reply_to_post_id) ?? null
  if (walkReplyAncestors && parentReplyToPostId !== null) {
    const blockedAncestors = try tx.query(
      `WITH RECURSIVE ancestors(id, author_id, reply_to_post_id, depth, visited) AS (
         SELECT id, author_id, reply_to_post_id, 1, ARRAY[$1::text, id]
         FROM feed_posts
         WHERE id = $2 AND id <> $1
         UNION ALL
         SELECT p.id, p.author_id, p.reply_to_post_id, a.depth + 1, a.visited || p.id
         FROM feed_posts p
         INNER JOIN ancestors a ON p.id = a.reply_to_post_id
         WHERE a.reply_to_post_id IS NOT NULL
           AND a.depth < $3
           AND NOT (p.id = ANY(a.visited))
       )
       SELECT 1
       FROM ancestors a
       INNER JOIN feed_blocks b
         ON (b.blocker_id = $4 AND b.blocked_id = a.author_id)
         OR (b.blocker_id = a.author_id AND b.blocked_id = $4)
       LIMIT 1`,
      [resolvedId, parentReplyToPostId, MAX_REPLY_ANCESTOR_DEPTH, authorId]
    )
    if (blockedAncestors.length > 0) {
      throw new SocialFailure({ code: "Blocked", message: "Cannot reply in a thread with a blocked ancestor account" })
    }
  }
  return {
    id: resolvedId,
    authorId: targetAuthorId,
    authorKind: toAuthorKind(row.author_kind)
  }
}

export effect function createPost(input: CreatePostInput): PostView!(SocialFailure | StoreFailure)!Store {
  if (input.content.trim() === "" || input.content.length > maxPostChars) {
    throw new SocialFailure({
      code: "InvalidInput",
      message: `Post content must be between 1 and ${maxPostChars} characters`
    })
  }
  const replyToPostId = normalizeOptionalText(input.replyToPostId ?? undefined)
  const quotePostId = normalizeOptionalText(input.quotePostId ?? undefined)
  const marketId = normalizeOptionalText(input.marketId ?? undefined)
  const rawTicker = normalizeOptionalText(input.ticker ?? undefined)
  const ticker = rawTicker === null ? null : rawTicker.toUpperCase()
  const viaClientName = normalizeOptionalText(input.viaClientName ?? undefined)
  if (input.authorKind !== "user" && viaClientName !== null) {
    throw new SocialFailure({ code: "Forbidden", message: "Non-user authors cannot specify viaClientName" })
  }
  const store = try Store
  const now = try Clock.currentTimeMillis
  const committed = try store.transaction(effect (tx: Tx) => {
    try ensureAuthorExistsTx(tx, input.authorId, input.authorKind)
    if (input.authorKind === "user") {
      if (viaClientName !== null) {
        const grantRows = try tx.query(
          "SELECT client_name FROM feed_agent_grants WHERE account_id = $1 AND status = 'active' LIMIT 1",
          [input.authorId]
        )
        const activeClient = toText(grantRows[0]?.client_name)
        if (activeClient !== viaClientName) {
          throw new SocialFailure({ code: "Forbidden", message: "Active connected agent grant does not match viaClientName" })
        }
      }
      try consumeHourlyRateLimitTx(tx, `${input.authorId}:post`, POSTS_PER_HOUR_LIMIT, now)
    }
    const replyTarget = try resolveReferencePostTx(tx, input.authorId, replyToPostId, "Reply", true)
    const quoteTarget = try resolveReferencePostTx(tx, input.authorId, quotePostId, "Quote", false)
    const specAccounts: AccountInfo[] = [
      {
        id: input.authorId,
        kind: input.authorKind === "user" ? "HumanAuthor" : "NpcAuthor",
        connectedClient: viaClientName ?? "",
        postsInWindow: 0
      }
    ]
    const specPosts: SpecPost[] = []
    let replyRefNum = 0
    let quoteRefNum = 0
    if (replyTarget !== undefined) {
      replyRefNum = 1
      specAccounts.push({
        id: replyTarget.authorId,
        kind: replyTarget.authorKind === "user" ? "HumanAuthor" : "NpcAuthor",
        connectedClient: "",
        postsInWindow: 0
      })
      specPosts.push(makeSpecPost(1, replyTarget.authorId, replyTarget.authorKind, null, "parent", null, null, null, null, 0, 0, [], []))
    }
    if (quoteTarget !== undefined) {
      quoteRefNum = replyTarget !== undefined && quoteTarget.id === replyTarget.id ? 1 : 2
      if (quoteRefNum === 2) {
        specAccounts.push({
          id: quoteTarget.authorId,
          kind: quoteTarget.authorKind === "user" ? "HumanAuthor" : "NpcAuthor",
          connectedClient: "",
          postsInWindow: 0
        })
        specPosts.push(makeSpecPost(2, quoteTarget.authorId, quoteTarget.authorKind, null, "quote", null, null, null, null, 0, 0, [], []))
      }
    }
    const specState: PostsState = {
      accounts: specAccounts,
      posts: specPosts,
      follows: [],
      blocks: [],
      lastPostId: specPosts.length,
      unrepostEvents: 0
    }
    const caller: Caller = { accountId: input.authorId, viaClientName: viaClientName ?? "" }
    if (!canCreatePost(specState, input.content.length, quoteRefNum, replyRefNum, caller)) {
      throw new SocialFailure({ code: "InvalidInput", message: "Post failed specification validation" })
    }
    const postId = freshId()
    try tx.query(
      "INSERT INTO feed_posts (id, author_id, author_kind, content, reply_to_post_id, quote_post_id, via_client_name, market_id, ticker, like_count, repost_count, reply_count, deleted_at, created_at) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9, 0, 0, 0, NULL, $10)",
      [postId, input.authorId, input.authorKind, input.content, replyToPostId, quotePostId, viaClientName, marketId, ticker, now]
    )
    if (replyToPostId !== null) {
      try tx.query("UPDATE feed_posts SET reply_count = reply_count + 1 WHERE id = $1 AND deleted_at IS NULL", [replyToPostId])
    }
    const events: FeedRealtimeEvent[] = [
      {
        type: "post.created",
        postId,
        authorId: input.authorId,
        authorKind: input.authorKind,
        replyToPostId,
        quotePostId,
        quoteAuthorId: quoteTarget?.authorId ?? null,
        createdAt: now
      }
    ]
    const notifiedAccounts = new Set<string>([input.authorId])
    if (replyTarget !== undefined && replyTarget.authorKind === "user" && !notifiedAccounts.has(replyTarget.authorId)) {
      notifiedAccounts.add(replyTarget.authorId)
      const ev = try insertNotificationTx(tx, {
        accountId: replyTarget.authorId,
        kind: "reply",
        actorId: input.authorId,
        postId,
        marketId: null,
        title: "New reply",
        body: input.content.slice(0, 120),
        isGameOnly: false,
        createdAt: now
      })
      if (ev !== undefined) events.push(ev)
    }
    if (quoteTarget !== undefined && quoteTarget.authorKind === "user" && !notifiedAccounts.has(quoteTarget.authorId)) {
      notifiedAccounts.add(quoteTarget.authorId)
      const ev = try insertNotificationTx(tx, {
        accountId: quoteTarget.authorId,
        kind: "quote",
        actorId: input.authorId,
        postId,
        marketId: null,
        title: "Quoted your post",
        body: input.content.slice(0, 120),
        isGameOnly: false,
        createdAt: now
      })
      if (ev !== undefined) events.push(ev)
    }
    const mentions = extractMentionHandles(input.content).slice(0, 5)
    if (mentions.length > 0) {
      const mentionedRows = try tx.query(
        "SELECT account_id FROM feed_accounts WHERE lower(handle) = ANY($1)",
        [mentions]
      )
      for (const row of mentionedRows) {
        const targetAccountId = toText(row.account_id)
        if (targetAccountId !== undefined && !notifiedAccounts.has(targetAccountId)) {
          notifiedAccounts.add(targetAccountId)
          const ev = try insertNotificationTx(tx, {
            accountId: targetAccountId,
            kind: "mention",
            actorId: input.authorId,
            postId,
            marketId: null,
            title: "Mentioned you",
            body: input.content.slice(0, 120),
            isGameOnly: false,
            createdAt: now
          })
          if (ev !== undefined) events.push(ev)
        }
      }
    }
    const createdRows = try tx.query("SELECT * FROM feed_posts WHERE id = $1 LIMIT 1", [postId])
    const authorMode = input.authorKind === "user" ? try readViewerUiModeTx(tx, input.authorId) : "game"
    const hydrated = try hydratePostRowsTx(tx, createdRows, input.authorId, authorMode)
    const createdPost = hydrated[0]
    if (createdPost === undefined) {
      throw new SocialFailure({ code: "NotFound", message: "Created post missing" })
    }
    return { post: createdPost, events }
  })
  try emitAfterCommit(committed.events)
  return committed.post
}

function textOrEmpty(value: unknown): string {
  return toText(value) ?? ""
}

function buildSpecAccounts(
  actorId: string,
  actorKind: PostAuthorKind,
  postAuthorId: string,
  postAuthorKind: PostAuthorKind
): AccountInfo[] {
  const actorAccount: AccountInfo = {
    id: actorId,
    kind: actorKind === "user" ? "HumanAuthor" : "NpcAuthor",
    connectedClient: "",
    postsInWindow: 0
  }
  if (postAuthorId === actorId) return [actorAccount]
  return [
    actorAccount,
    {
      id: postAuthorId,
      kind: postAuthorKind === "user" ? "HumanAuthor" : "NpcAuthor",
      connectedClient: "",
      postsInWindow: 0
    }
  ]
}

effect function recordEngagementNotificationTx(
  tx: Tx,
  params: {
    readonly postAuthorId: string
    readonly postAuthorKind: PostAuthorKind
    readonly actorId: string
    readonly postId: string
    readonly kind: "like" | "repost"
    readonly content: string
    readonly now: number
  },
  events: FeedRealtimeEvent[]
): void!StoreFailure {
  if (params.postAuthorKind !== "user" || params.postAuthorId === params.actorId) return
  const ev = try insertNotificationTx(tx, {
    accountId: params.postAuthorId,
    kind: params.kind,
    actorId: params.actorId,
    postId: params.postId,
    marketId: null,
    title: params.kind === "like" ? "Liked your post" : "Reposted your post",
    body: params.content.slice(0, 120),
    isGameOnly: false,
    createdAt: params.now
  })
  if (ev !== undefined) events.push(ev)
}

effect function runPostMutation<A>(
  accountId: string,
  postId: string,
  run: (tx: Tx, now: number) => { readonly value: A; readonly events: ReadonlyArray<FeedRealtimeEvent> }!(SocialFailure | StoreFailure)
): A!(SocialFailure | StoreFailure)!Store {
  if (accountId.trim() === "" || postId.trim() === "") {
    throw new SocialFailure({ code: "InvalidInput", message: "Account ID and post ID are required" })
  }
  const store = try Store
  const now = try Clock.currentTimeMillis
  const committed = try store.transaction(effect (tx: Tx) => try run(tx, now))
  try emitAfterCommit(committed.events)
  return committed.value
}

effect function engagePost(
  accountId: string,
  postId: string,
  kind: "like" | "repost",
  active: boolean
): { readonly postId: string; readonly likeCount: number; readonly repostCount: number }!(SocialFailure | StoreFailure)!Store {
  return try runPostMutation(accountId, postId, effect (tx: Tx, now: number) => {
    const actorRows = try tx.query(
      "SELECT account_id AS id, 'user' AS kind FROM feed_accounts WHERE account_id = $1 UNION ALL SELECT id, 'npc' AS kind FROM feed_actors WHERE id = $1 LIMIT 1",
      [accountId]
    )
    const actor = actorRows[0]
    if (actor === undefined) {
      throw new SocialFailure({ code: "NotFound", message: "Account not found" })
    }
    const actorKind = toAuthorKind(actor.kind)
    const postRows = try tx.query(
      "SELECT id, author_id, author_kind, content, like_count, repost_count FROM feed_posts WHERE id = $1 AND deleted_at IS NULL FOR UPDATE",
      [postId]
    )
    const postRow = postRows[0]
    if (postRow === undefined) {
      throw new SocialFailure({ code: "NotFound", message: "Post not found" })
    }
    const postAuthorId = toText(postRow.author_id) ?? ""
    const postAuthorKind = toAuthorKind(postRow.author_kind)
    const content = toText(postRow.content) ?? ""
    let likeCount = safeInt(postRow.like_count, 0)
    let repostCount = safeInt(postRow.repost_count, 0)
    const blocked = try isBlockedBetweenTx(tx, accountId, postAuthorId)
    if (active && blocked) {
      throw new SocialFailure({ code: "Blocked", message: "Cannot engage with a blocked account's post" })
    }
    const tableName = kind === "like" ? "feed_post_likes" : "feed_post_reposts"
    const existingRows = try tx.query(
      `SELECT 1 FROM ${tableName} WHERE post_id = $1 AND account_id = $2 LIMIT 1`,
      [postId, accountId]
    )
    const already = existingRows.length > 0
    const specAccounts = buildSpecAccounts(accountId, actorKind, postAuthorId, postAuthorKind)
    const specBlocks: BlockEdge[] = blocked ? [{ blockerId: accountId, blockedId: postAuthorId }] : []
    const specPost = makeSpecPost(
      1,
      postAuthorId,
      postAuthorKind,
      null,
      content,
      null,
      null,
      null,
      null,
      likeCount,
      repostCount,
      kind === "like" && already ? [accountId] : [],
      kind === "repost" && already ? [accountId] : []
    )
    const specState: PostsState = {
      accounts: specAccounts,
      posts: [specPost],
      follows: [],
      blocks: specBlocks,
      lastPostId: 1,
      unrepostEvents: 0
    }
    const caller: Caller = { accountId, viaClientName: "" }
    const events: FeedRealtimeEvent[] = []
    if (kind === "like") {
      if (active && !already) {
        if (!canLikePost(specState, 1, caller)) {
          throw new SocialFailure({ code: "Forbidden", message: "Cannot like post" })
        }
        try tx.query("INSERT INTO feed_post_likes (post_id, account_id, created_at) VALUES ($1, $2, $3)", [postId, accountId, now])
        likeCount += 1
        try tx.query("UPDATE feed_posts SET like_count = $2 WHERE id = $1", [postId, likeCount])
        try recordEngagementNotificationTx(
          tx,
          { postAuthorId, postAuthorKind, actorId: accountId, postId, kind: "like", content, now },
          events
        )
        events.push({ type: "post.engagement", postId, kind: "like", accountId, likeCount, repostCount })
      } else if (!active && already) {
        if (!canUnlikePost(specState, 1, caller)) {
          throw new SocialFailure({ code: "Forbidden", message: "Cannot unlike post" })
        }
        try tx.query("DELETE FROM feed_post_likes WHERE post_id = $1 AND account_id = $2", [postId, accountId])
        likeCount = Math.max(0, likeCount - 1)
        try tx.query("UPDATE feed_posts SET like_count = $2 WHERE id = $1", [postId, likeCount])
        events.push({ type: "post.engagement", postId, kind: "unlike", accountId, likeCount, repostCount })
      }
    } else if (active && !already) {
      if (!canRepostPost(specState, 1, caller)) {
        throw new SocialFailure({ code: "Forbidden", message: "Cannot repost post" })
      }
      try tx.query("INSERT INTO feed_post_reposts (post_id, account_id, repost_post_id, created_at) VALUES ($1, $2, NULL, $3)", [postId, accountId, now])
      repostCount += 1
      try tx.query("UPDATE feed_posts SET repost_count = $2 WHERE id = $1", [postId, repostCount])
      try recordEngagementNotificationTx(
        tx,
        { postAuthorId, postAuthorKind, actorId: accountId, postId, kind: "repost", content, now },
        events
      )
      events.push({ type: "post.engagement", postId, kind: "repost", accountId, likeCount, repostCount })
    } else if (!active && already) {
      if (!canUnrepostPost(specState, 1, caller)) {
        throw new SocialFailure({ code: "Forbidden", message: "Cannot unrepost post" })
      }
      try tx.query("DELETE FROM feed_post_reposts WHERE post_id = $1 AND account_id = $2", [postId, accountId])
      repostCount = Math.max(0, repostCount - 1)
      try tx.query("UPDATE feed_posts SET repost_count = $2 WHERE id = $1", [postId, repostCount])
      events.push({ type: "post.engagement", postId, kind: "unrepost", accountId, likeCount, repostCount })
    }
    return { value: { postId, likeCount, repostCount }, events }
  })
}

export effect function likePost(accountId: string, postId: string): LikeResult!(SocialFailure | StoreFailure)!Store {
  const res = try engagePost(accountId, postId, "like", true)
  return { postId: res.postId, liked: true, likeCount: res.likeCount }
}

export effect function unlikePost(accountId: string, postId: string): LikeResult!(SocialFailure | StoreFailure)!Store {
  const res = try engagePost(accountId, postId, "like", false)
  return { postId: res.postId, liked: false, likeCount: res.likeCount }
}

export effect function repostPost(accountId: string, postId: string): RepostResult!(SocialFailure | StoreFailure)!Store {
  const res = try engagePost(accountId, postId, "repost", true)
  return { postId: res.postId, reposted: true, repostCount: res.repostCount }
}

export effect function unrepostPost(accountId: string, postId: string): RepostResult!(SocialFailure | StoreFailure)!Store {
  const res = try engagePost(accountId, postId, "repost", false)
  return { postId: res.postId, reposted: false, repostCount: res.repostCount }
}

export effect function deletePost(accountId: string, postId: string): DeletePostResult!(SocialFailure | StoreFailure)!Store {
  return try runPostMutation(accountId, postId, effect (tx: Tx, now: number) => {
    const rows = try tx.query(
      "SELECT id, author_id, author_kind, content, reply_to_post_id FROM feed_posts WHERE id = $1 AND deleted_at IS NULL FOR UPDATE",
      [postId]
    )
    const row = rows[0]
    if (row === undefined) {
      throw new SocialFailure({ code: "NotFound", message: "Post not found" })
    }
    const postAuthorId = toText(row.author_id) ?? ""
    const postAuthorKind = toAuthorKind(row.author_kind)
    const replyToPostId = toText(row.reply_to_post_id) ?? null
    const specAccounts = buildSpecAccounts(accountId, "user", postAuthorId, postAuthorKind)
    const specState: PostsState = {
      accounts: specAccounts,
      posts: [makeSpecPost(1, postAuthorId, postAuthorKind, null, toText(row.content) ?? "p", replyToPostId, null, null, null, 0, 0, [], [])],
      follows: [],
      blocks: [],
      lastPostId: 1,
      unrepostEvents: 0
    }
    if (!canDeletePost(specState, 1, { accountId, viaClientName: "" })) {
      throw new SocialFailure({ code: "Forbidden", message: "Only the post author can delete this post" })
    }
    try tx.query("UPDATE feed_posts SET deleted_at = $2 WHERE id = $1 AND deleted_at IS NULL", [postId, now])
    let parentReplyCount: number | null = null
    if (replyToPostId !== null) {
      const updatedParent = try tx.query(
        "UPDATE feed_posts SET reply_count = GREATEST(0, reply_count - 1) WHERE id = $1 RETURNING reply_count",
        [replyToPostId]
      )
      parentReplyCount = updatedParent[0] === undefined ? null : safeInt(updatedParent[0].reply_count, 0)
    }
    const events: FeedRealtimeEvent[] = [{ type: "post.deleted", postId, authorId: postAuthorId }]
    return { value: { postId, deleted: true, replyToPostId, parentReplyCount }, events }
  })
}

export effect function searchWorld(input: SearchWorldInput): SearchResult!(SocialFailure | StoreFailure)!Store {
  const queryText = input.query.trim()
  if (queryText === "") {
    return { posts: [], accounts: [], actors: [], organizations: [], tags: [] }
  }
  const limit = clampLimit(input.limit, 15, 50)
  const viewerId = normalizeOptionalText(input.viewerId) ?? undefined
  const likePattern = `%${escapeLikePattern(queryText)}%`
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const mode = input.mode ?? (try readViewerUiModeTx(tx, viewerId))
    const postMatch = mode === "social"
      ? "p.content ILIKE $1 ESCAPE '\\'"
      : "(p.content ILIKE $1 ESCAPE '\\' OR p.ticker ILIKE $1 ESCAPE '\\')"
    const postRows = viewerId === undefined
      ? try tx.query(`SELECT p.* FROM feed_posts p WHERE p.deleted_at IS NULL AND ${postMatch} ORDER BY p.created_at DESC LIMIT $2`, [likePattern, limit])
      : try tx.query(`SELECT p.* FROM feed_posts p WHERE p.deleted_at IS NULL AND ${postMatch} AND ${viewerAuthorVisibilitySql("$2", "p.author_id")} ORDER BY p.created_at DESC LIMIT $3`, [likePattern, viewerId, limit])
    const posts = try hydratePostRowsTx(tx, postRows, viewerId, mode)
    const accountWhere = "is_reviewer = false AND (handle ILIKE $1 ESCAPE '\\' OR display_name ILIKE $1 ESCAPE '\\')"
    const accountRows = viewerId === undefined
      ? try tx.query(`SELECT account_id, handle, display_name, bio, avatar_url FROM feed_accounts WHERE ${accountWhere} ORDER BY created_at DESC LIMIT $2`, [likePattern, limit])
      : try tx.query(`SELECT account_id, handle, display_name, bio, avatar_url FROM feed_accounts WHERE ${accountWhere} AND ${viewerAuthorVisibilitySql("$2", "account_id")} ORDER BY created_at DESC LIMIT $3`, [likePattern, viewerId, limit])
    const accounts: SearchAccountResult[] = accountRows.map((row) => ({
      accountId: textOrEmpty(row.account_id),
      handle: textOrEmpty(row.handle),
      displayName: textOrEmpty(row.display_name),
      bio: textOrEmpty(row.bio),
      avatarUrl: toText(row.avatar_url) ?? null
    }))
    const actorWhere = "id NOT LIKE 'test-%' AND (username ILIKE $1 ESCAPE '\\' OR name ILIKE $1 ESCAPE '\\' OR description ILIKE $1 ESCAPE '\\')"
    const actorRows = viewerId === undefined
      ? try tx.query(`SELECT id, username, name, tier, description, profile_image_url FROM feed_actors WHERE ${actorWhere} ORDER BY name ASC LIMIT $2`, [likePattern, limit])
      : try tx.query(`SELECT id, username, name, tier, description, profile_image_url FROM feed_actors WHERE ${actorWhere} AND ${viewerAuthorVisibilitySql("$2", "id")} ORDER BY name ASC LIMIT $3`, [likePattern, viewerId, limit])
    const actors: SearchActorResult[] = actorRows.map((row) => {
      const id = toText(row.id) ?? ""
      return {
        id,
        username: toText(row.username) ?? "",
        name: toText(row.name) ?? "",
        tier: toText(row.tier) ?? "",
        description: toText(row.description) ?? "",
        avatarUrl: toText(row.profile_image_url) ?? (id !== "" ? resolveActorAvatarUrl(id) : null),
        isParody: true
      }
    })
    const orgMatch = mode === "social"
      ? "name ILIKE $1 ESCAPE '\\' OR description ILIKE $1 ESCAPE '\\'"
      : "name ILIKE $1 ESCAPE '\\' OR ticker ILIKE $1 ESCAPE '\\' OR description ILIKE $1 ESCAPE '\\'"
    const orgRows = try tx.query(
      `SELECT id, name, ticker, org_type, description, image_url, initial_price_cents FROM feed_organizations WHERE ${orgMatch} ORDER BY name ASC LIMIT $2`,
      [likePattern, limit]
    )
    const organizations: SearchOrganizationResult[] = orgRows.map((row) => {
      const id = toText(row.id) ?? ""
      return {
        id,
        name: toText(row.name) ?? "",
        ticker: mode === "social" ? null : (toText(row.ticker) ?? null),
        orgType: toText(row.org_type) ?? "",
        description: toText(row.description) ?? "",
        avatarUrl: toText(row.image_url) ?? (id !== "" ? resolveOrgLogoUrl(id) : null),
        initialPriceCents: mode === "social" || row.initial_price_cents === null ? null : safeInt(row.initial_price_cents, 0)
      }
    })
    const cleanedTag = queryText.replace(/^[#$]/, "").toLowerCase()
    const tagCounts = new Map<string, SearchTagResult>()
    for (const post of posts) {
      for (const hashtag of post.hashtags) {
        if (cleanedTag === "" || hashtag.includes(cleanedTag)) {
          const key = `hashtag:${hashtag}`
          const current = tagCounts.get(key)
          tagCounts.set(key, { tag: `#${hashtag}`, kind: "hashtag", postCount: (current?.postCount ?? 0) + 1 })
        }
      }
      if (mode === "game") {
        for (const cashtag of post.cashtags) {
          if (cleanedTag === "" || cashtag.toLowerCase().includes(cleanedTag)) {
            const key = `ticker:${cashtag}`
            const current = tagCounts.get(key)
            tagCounts.set(key, { tag: `$${cashtag}`, kind: "ticker", postCount: (current?.postCount ?? 0) + 1 })
          }
        }
      }
    }
    const tags = [...tagCounts.values()].sort((a, b) => b.postCount - a.postCount).slice(0, limit)
    return { posts, accounts, actors, organizations, tags }
  })
}

function rowToArticle(row: Row, mode: SocialPresentationMode): ArticleView {
  const authorOrgId = toText(row.author_org_id) ?? ""
  return {
    id: toText(row.id) ?? "",
    title: toText(row.title) ?? "",
    summary: toText(row.summary) ?? "",
    body: toText(row.body) ?? "",
    authorOrgId,
    authorOrgName: toText(row.author_org_name) ?? authorOrgId,
    authorOrgAvatarUrl: toText(row.author_org_image_url) ?? (authorOrgId !== "" ? resolveOrgLogoUrl(authorOrgId) : null),
    imageUrl: toText(row.image_url) ?? null,
    relatedMarketId: mode === "social" ? null : (toText(row.related_market_id) ?? null),
    isResolutionProof: Boolean(row.is_resolution_proof),
    publishedAt: safeInt(row.published_at, 0)
  }
}

const ARTICLE_BASE_SQL =
  "SELECT a.id, a.title, a.summary, a.body, a.author_org_id, o.name AS author_org_name, o.image_url AS author_org_image_url, a.image_url, a.related_market_id, a.is_resolution_proof, a.published_at FROM feed_articles a LEFT JOIN feed_organizations o ON o.id = a.author_org_id LEFT JOIN feed_prediction_markets m ON m.id = a.related_market_id"

const ARTICLE_VISIBLE_SQL = "(a.is_resolution_proof = false OR a.related_market_id IS NULL OR m.status = 'resolved')"

function bumpTrendingTag(
  aggregates: Map<string, TrendingView>,
  prefix: "#" | "$",
  kind: TrendingKind,
  rawTag: string,
  engagement: number,
  createdAt: number
): void {
  const key = `${kind}:${rawTag}`
  const prev = aggregates.get(key)
  aggregates.set(key, {
    tag: `${prefix}${rawTag}`,
    kind,
    postCount: (prev?.postCount ?? 0) + 1,
    engagementScore: (prev?.engagementScore ?? 0) + engagement,
    latestPostAt: Math.max(prev?.latestPostAt ?? 0, createdAt)
  })
}

export effect function listArticles(
  limit?: number,
  mode: SocialPresentationMode = "game"
): ReadonlyArray<ArticleView>!StoreFailure!Store {
  const effectiveLimit = clampLimit(limit, 20, 100)
  const store = try Store
  const rows = try store.transaction((tx) => tx.query(
    `${ARTICLE_BASE_SQL} WHERE ${ARTICLE_VISIBLE_SQL} ORDER BY a.published_at DESC, a.id DESC LIMIT $1`,
    [effectiveLimit]
  ))
  return rows.map((row) => rowToArticle(row, mode))
}

export effect function getArticle(
  articleId: string,
  mode: SocialPresentationMode = "game"
): ArticleView!(SocialFailure | StoreFailure)!Store {
  if (articleId.trim() === "") {
    throw new SocialFailure({ code: "InvalidInput", message: "Article ID is required" })
  }
  const store = try Store
  const rows = try store.transaction((tx) => tx.query(
    `${ARTICLE_BASE_SQL} WHERE a.id = $1 AND ${ARTICLE_VISIBLE_SQL} LIMIT 1`,
    [articleId]
  ))
  const row = rows[0]
  if (row === undefined) {
    throw new SocialFailure({ code: "NotFound", message: "Article not found" })
  }
  return rowToArticle(row, mode)
}

export effect function listTrending(
  limit?: number,
  mode: SocialPresentationMode = "game",
  viewerId?: string,
  windowHours?: number
): ReadonlyArray<TrendingView>!StoreFailure!Store {
  const effectiveLimit = clampLimit(limit, 10, 50)
  const effectiveWindowHours = clampLimit(windowHours, 24, 168)
  const viewer = normalizeOptionalText(viewerId) ?? undefined
  const now = try Clock.currentTimeMillis
  const cutoff = now - effectiveWindowHours * HOUR_MS
  const visibilitySuffix = viewer === undefined ? "" : ` AND ${viewerAuthorVisibilitySql("$2", "author_id")}`
  const store = try Store
  const rows = try store.transaction((tx) => tx.query(
    `SELECT content, ticker, like_count, repost_count, reply_count, created_at FROM feed_posts WHERE deleted_at IS NULL AND created_at >= $1${visibilitySuffix} ORDER BY created_at DESC LIMIT 250`,
    viewer === undefined ? [cutoff] : [cutoff, viewer]
  ))
  const aggregates = new Map<string, TrendingView>()
  for (const row of rows) {
    const content = toText(row.content) ?? ""
    const rawTicker = toText(row.ticker) ?? null
    const createdAt = safeInt(row.created_at, 0)
    const rawEngagement = 1 + safeInt(row.like_count, 0) + safeInt(row.repost_count, 0) * 2 + safeInt(row.reply_count, 0)
    const ageHours = Math.max(0, (now - createdAt) / HOUR_MS)
    const decayFactor = Math.max(0.1, 1 - ageHours * 0.03)
    const engagement = Math.max(1, Math.round(rawEngagement * decayFactor))
    for (const hashtag of extractHashtags(content)) {
      bumpTrendingTag(aggregates, "#", "hashtag", hashtag, engagement, createdAt)
    }
    if (mode === "game") {
      for (const cashtag of extractCashtags(content, rawTicker)) {
        bumpTrendingTag(aggregates, "$", "ticker", cashtag, engagement, createdAt)
      }
    }
  }
  return [...aggregates.values()]
    .sort((a, b) => b.engagementScore - a.engagementScore || b.postCount - a.postCount || b.latestPostAt - a.latestPostAt)
    .slice(0, effectiveLimit)
}
