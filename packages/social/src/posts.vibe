import { type FeedRealtimeEvent } from "./realtime.vibe"
import {
  clampLimit,
  consumeHourlyRateLimitTx,
  emitAfterCommit,
  ensureAuthorExistsTx,
  escapeLikePattern,
  extractCashtags,
  extractHashtags,
  extractMentionHandles,
  freshId,
  insertNotificationTx,
  isBlockedBetweenTx,
  loadSubjectProfilesMapTx,
  normalizeOptionalText,
  readViewerUiModeTx,
  safeInt,
  SocialFailure,
  toSpecMode,
  type SocialPresentationMode,
  type SubjectKind,
  type SubjectProfile
} from "./shared.vibe"

export { SocialFailure, type SocialPresentationMode } from "./shared.vibe"

export type PostAuthorKind = SubjectKind

export type FeedTab = "latest" | "following" | "top"

export interface ListFeedPostsInput {
  readonly tab: FeedTab
  readonly viewerId?: string
  readonly mode?: SocialPresentationMode
  readonly cursor?: string
  readonly limit?: number
  readonly authorId?: string
  readonly ticker?: string
  readonly marketId?: string
}

