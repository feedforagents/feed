interface ModerationPairSnapshot {
  readonly actor: ResolvedSubject
  readonly target: ResolvedSubject
  readonly state: ModerationState
  readonly following: boolean
  readonly directBlock: boolean
  readonly blockedEitherWay: boolean
  readonly muted: boolean
}

function buildPairModerationState(
  actorId: string,
  targetId: string,
  following: boolean,
  directBlock: boolean,
  reverseBlock: boolean,
  muted: boolean
): ModerationState {
  const accounts: AccountModeration[] = [
    { id: actorId, mode: "GameMode", openPositionCount: 0, unreadCount: 0 },
    ...(targetId === actorId ? [] : [{ id: targetId, mode: "GameMode" as const, openPositionCount: 0, unreadCount: 0 }])
  ]
  const blocks: BlockRecord[] = [
    ...(directBlock ? [{ blockerId: actorId, blockedId: targetId }] : []),
    ...(reverseBlock ? [{ blockerId: targetId, blockedId: actorId }] : [])
  ]
  const mutes: MuteRecord[] = muted ? [{ muterId: actorId, mutedId: targetId }] : []
  const follows: FollowRecord[] = following ? [{ followerId: actorId, followingId: targetId }] : []
  return {
    accounts,
    blocks,
    mutes,
    follows,
    reports: [],
    notifications: [],
    lastReportId: 0,
    lastNotificationId: 0,
    blocksClearedFollowsCount: 0
  }
}

effect function lockAccountPairTx(tx: Tx, a: string, b: string): void!StoreFailure {
  const pairKey = a < b ? `${a}:${b}` : `${b}:${a}`
  try tx.query("SELECT pg_advisory_xact_lock(hashtextextended($1, 0))", [`social:pair:${pairKey}`])
}

function isUniqueViolationFailure(err: StoreFailure): boolean {
  const cause = err.cause
  if (typeof cause === "object" && cause !== null && "code" in cause && cause.code === "23505") {
    return true
  }
  const msg = cause instanceof Error ? cause.message : String(cause)
  return msg.includes("23505") || msg.toLowerCase().includes("duplicate key")
}

effect function loadPairSnapshotTx(
  tx: Tx,
  actorId: string,
  targetHandleOrId: string,
  allowOrgTarget: boolean,
  lockPair = false
): ModerationPairSnapshot!(SocialFailure | StoreFailure) {
  const actor = try resolveUserOrNpcTx(tx, actorId)
  const target = allowOrgTarget
    ? try resolveSubjectTx(tx, targetHandleOrId)
    : try resolveUserOrNpcTx(tx, targetHandleOrId)
  if (lockPair && actor.id !== target.id) {
    try lockAccountPairTx(tx, actor.id, target.id)
  }
  const followRows = try tx.query(
    "SELECT 1 FROM feed_follows WHERE follower_id = $1 AND target_id = $2 LIMIT 1",
    [actor.id, target.id]
  )
  const blockRows = try tx.query(
    "SELECT blocker_id, blocked_id FROM feed_blocks WHERE (blocker_id = $1 AND blocked_id = $2) OR (blocker_id = $2 AND blocked_id = $1)",
    [actor.id, target.id]
  )
  const muteRows = try tx.query(
    "SELECT 1 FROM feed_mutes WHERE muter_id = $1 AND muted_id = $2 LIMIT 1",
    [actor.id, target.id]
  )
  const directBlock = blockRows.some((r) => toText(r.blocker_id) === actor.id && toText(r.blocked_id) === target.id)
  const reverseBlock = blockRows.some((r) => toText(r.blocker_id) === target.id && toText(r.blocked_id) === actor.id)
  const following = followRows.length > 0
  const muted = muteRows.length > 0
  return {
    actor,
    target,
    following,
    directBlock,
    blockedEitherWay: directBlock || reverseBlock,
    muted,
    state: buildPairModerationState(actor.id, target.id, following, directBlock, reverseBlock, muted)
  }
}

function parseAffiliations(personalityJson: string | undefined): ReadonlyArray<string> {
  if (personalityJson === undefined || personalityJson.trim() === "") return []
  try {
    const parsed = JSON.parse(personalityJson) as { readonly affiliations?: unknown } | null
    if (parsed !== null && typeof parsed === "object" && Array.isArray(parsed.affiliations)) {
      return parsed.affiliations.filter((item): item is string => typeof item === "string" && item.trim() !== "")
    }
    return []
  } catch {
    return []
  }
}

export effect function getProfile(
  handleOrId: string,
  viewerId?: string,
  mode?: SocialPresentationMode
): ProfileView!(SocialFailure | StoreFailure)!Store {
  const store = try Store
  const viewer = normalizeOptionalText(viewerId) ?? undefined
  return try store.transaction(effect (tx: Tx) => {
    const target = try resolveSubjectTx(tx, handleOrId)
    const isSelf = viewer !== undefined && target.kind === "user" && viewer === target.id
    const effectiveMode = mode ?? (isSelf ? target.uiMode : try readViewerUiModeTx(tx, viewer))
    let bio: string
    let createdAt: number
    let actorMeta: ProfileActorMeta | null = null
    let orgMeta: ProfileOrgMeta | null = null
    let balanceCents: number | null = null
    let activeAgentClientName: string | null = null
    if (target.kind === "user") {
      const accountRows = try tx.query(
        "SELECT bio, balance_cents, created_at FROM feed_accounts WHERE account_id = $1 LIMIT 1",
        [target.id]
      )
      const accountRow = accountRows[0]
      bio = toText(accountRow?.bio) ?? ""
      createdAt = safeInt(accountRow?.created_at, 0)
      if (isSelf && effectiveMode === "game") {
        balanceCents = safeInt(accountRow?.balance_cents, 0)
      }
      const grantRows = try tx.query(
        "SELECT client_name FROM feed_agent_grants WHERE account_id = $1 AND status = 'active' LIMIT 1",
        [target.id]
      )
      activeAgentClientName = toText(grantRows[0]?.client_name) ?? null
    } else if (target.kind === "npc") {
      const actorRows = try tx.query(
        "SELECT description, tier, personality_json, created_at FROM feed_actors WHERE id = $1 LIMIT 1",
        [target.id]
      )
      const actorRow = actorRows[0]
      bio = toText(actorRow?.description) ?? ""
      createdAt = safeInt(actorRow?.created_at, 0)
      actorMeta = {
        tier: toText(actorRow?.tier) ?? "",
        affiliations: parseAffiliations(toText(actorRow?.personality_json))
      }
    } else {
      const orgRows = try tx.query(
        "SELECT description, ticker, org_type, created_at FROM feed_organizations WHERE id = $1 LIMIT 1",
        [target.id]
      )
      const orgRow = orgRows[0]
      bio = toText(orgRow?.description) ?? ""
      createdAt = safeInt(orgRow?.created_at, 0)
      orgMeta = {
        ticker: effectiveMode === "social" ? null : (toText(orgRow?.ticker) ?? null),
        orgType: toText(orgRow?.org_type) ?? ""
      }
    }
    const followersCount = viewer === undefined
      ? safeInt((try tx.query("SELECT count(*) AS count FROM feed_follows WHERE target_id = $1", [target.id]))[0]?.count, 0)
      : safeInt((try tx.query(
          "SELECT count(*) AS count FROM feed_follows f WHERE f.target_id = $1 AND NOT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = $2 AND b.blocked_id = f.follower_id) OR (b.blocker_id = f.follower_id AND b.blocked_id = $2))",
          [target.id, viewer]
        ))[0]?.count, 0)
    const followingCount = viewer === undefined
      ? safeInt((try tx.query("SELECT count(*) AS count FROM feed_follows WHERE follower_id = $1", [target.id]))[0]?.count, 0)
      : safeInt((try tx.query(
          "SELECT count(*) AS count FROM feed_follows f WHERE f.follower_id = $1 AND NOT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = $2 AND b.blocked_id = f.target_id) OR (b.blocker_id = f.target_id AND b.blocked_id = $2))",
          [target.id, viewer]
        ))[0]?.count, 0)
    const postsCountParams: unknown[] = [target.id]
    const postsCountConditions = ["p.author_id = $1", "p.deleted_at IS NULL"]
    if (effectiveMode === "social") {
      postsCountConditions.push(socialModeMarketExclusionSql("p"))
    }
    if (viewer !== undefined) {
      postsCountParams.push(viewer)
      postsCountConditions.push(viewerAuthorVisibilitySql(`$${postsCountParams.length}`, "p.author_id"))
    }
    const postsCount = safeInt((try tx.query(
      `SELECT count(*) AS count FROM feed_posts p WHERE ${postsCountConditions.join(" AND ")}`,
      postsCountParams
    ))[0]?.count, 0)
    let viewerFollows = false
    let viewerFollowedBy = false
    let viewerBlocks = false
    let viewerBlockedBy = false
    let viewerMutes = false
    if (viewer !== undefined && viewer !== target.id) {
      const pair = try loadPairSnapshotTx(tx, viewer, target.id, true)
      viewerFollows = pair.following
      viewerBlocks = pair.directBlock
      viewerBlockedBy = pair.blockedEitherWay && !pair.directBlock
      viewerMutes = pair.muted
      const reverseFollow = try tx.query(
        "SELECT 1 FROM feed_follows WHERE follower_id = $1 AND target_id = $2 LIMIT 1",
        [target.id, viewer]
      )
      viewerFollowedBy = reverseFollow.length > 0
    }
    let tradeCount: number | null = null
    let openPositionCount: number | null = null
    if (effectiveMode === "game" && (target.kind === "user" || target.kind === "npc") && !viewerBlocks && !viewerBlockedBy) {
      tradeCount = safeInt((try tx.query("SELECT count(*) AS count FROM feed_trades WHERE trader_id = $1", [target.id]))[0]?.count, 0)
      const openPerps = safeInt((try tx.query("SELECT count(*) AS count FROM feed_perp_positions WHERE holder_id = $1 AND status = 'open'", [target.id]))[0]?.count, 0)
      const openPreds = safeInt((try tx.query("SELECT count(*) AS count FROM feed_prediction_positions WHERE holder_id = $1 AND settled_at IS NULL AND shares > 0", [target.id]))[0]?.count, 0)
      openPositionCount = openPerps + openPreds
    }
    const isParody = target.kind !== "user"
    return {
      id: target.id,
      kind: target.kind,
      handle: target.handle,
      displayName: target.displayName,
      bio,
      avatarUrl: target.avatarUrl,
      bannerUrl: target.bannerUrl,
      createdAt,
      actorMeta,
      orgMeta,
      isParody,
      parodyLabel: null,
      followersCount,
      followingCount,
      postsCount,
      viewerFollows,
      viewerFollowedBy,
      viewerBlocks,
      viewerBlockedBy,
      viewerMutes,
      activeAgentClientName,
      balanceCents,
      tradeCount,
      openPositionCount,
      uiMode: isSelf ? target.uiMode : null
    }
  })
}

export effect function updateProfile(
  accountId: string,
  patch: {
    readonly displayName?: string
    readonly bio?: string
    readonly avatarUrl?: string | null
    readonly bannerUrl?: string | null
  }
): (UpdatedAccountProfile | undefined)!(SocialFailure | StoreFailure)!Store {
  const hasAvatarUrl = patch.avatarUrl !== undefined
  const hasBannerUrl = patch.bannerUrl !== undefined
  const validatedAvatarUrl = hasAvatarUrl ? try validateProfileImageUrl(patch.avatarUrl, "avatarUrl") : null
  const validatedBannerUrl = hasBannerUrl ? try validateProfileImageUrl(patch.bannerUrl, "bannerUrl") : null
  const store = try Store
  const now = try Clock.currentTimeMillis
  const rows = try store.transaction((tx: Tx) => tx.query(
    `UPDATE feed_accounts
     SET display_name = COALESCE($2, display_name),
         bio = COALESCE($3, bio),
         avatar_url = CASE WHEN $4::boolean THEN $5 ELSE avatar_url END,
         banner_url = CASE WHEN $6::boolean THEN $7 ELSE banner_url END,
         updated_at = $8
     WHERE account_id = $1
     RETURNING account_id, handle, display_name, bio, avatar_url, banner_url`,
    [
      accountId,
      patch.displayName ?? null,
      patch.bio ?? null,
      hasAvatarUrl,
      validatedAvatarUrl,
      hasBannerUrl,
      validatedBannerUrl,
      now
    ]
  ))
  const row = rows[0]
  if (row === undefined) return undefined
  const resolvedId = toText(row.account_id) ?? accountId
  const avatarUrl = toText(row.avatar_url) ?? null
  const bannerUrl = toText(row.banner_url) ?? null
  return {
    accountId: resolvedId,
    handle: toText(row.handle) ?? "",
    displayName: toText(row.display_name) ?? "",
    bio: toText(row.bio) ?? "",
    avatarUrl,
    bannerUrl
  }
}

export effect function followAccount(followerId: string, targetHandleOrId: string): FollowResult!(SocialFailure | StoreFailure)!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const committed = try store.transaction(effect (tx: Tx) => {
    const pair = try loadPairSnapshotTx(tx, followerId, targetHandleOrId, true, true)
    if (pair.actor.id === pair.target.id) {
      throw new SocialFailure({ code: "InvalidInput", message: "Cannot follow yourself" })
    }
    if (pair.blockedEitherWay) {
      throw new SocialFailure({ code: "Blocked", message: "Cannot follow a blocked account" })
    }
    const events: FeedRealtimeEvent[] = []
    if (!pair.following) {
      if (!canFollowUser(pair.state, pair.target.id, pair.actor.id)) {
        throw new SocialFailure({ code: "Forbidden", message: "Follow refused by moderation rules" })
      }
      try tx.query(
        "INSERT INTO feed_follows (follower_id, target_id, target_kind, created_at) VALUES ($1, $2, $3, $4) ON CONFLICT (follower_id, target_id, target_kind) DO NOTHING",
        [pair.actor.id, pair.target.id, pair.target.kind, now]
      )
      if (pair.target.kind === "user") {
        const ev = try insertNotificationTx(tx, {
          accountId: pair.target.id,
          kind: "follow",
          actorId: pair.actor.id,
          postId: null,
          marketId: null,
          title: "New follower",
          body: `@${pair.actor.handle} followed you`,
          isGameOnly: false,
          createdAt: now
        })
        if (ev !== undefined) events.push(ev)
      }
    }
    return {
      result: {
        followerId: pair.actor.id,
        targetId: pair.target.id,
        targetKind: pair.target.kind,
        following: true
      },
      events
    }
  })
  try emitAfterCommit(committed.events)
  return committed.result
}

export effect function unfollowAccount(followerId: string, targetHandleOrId: string): FollowResult!(SocialFailure | StoreFailure)!Store {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const pair = try loadPairSnapshotTx(tx, followerId, targetHandleOrId, true, true)
    if (pair.following && !canUnfollowUser(pair.state, pair.target.id, pair.actor.id)) {
      throw new SocialFailure({ code: "Forbidden", message: "Cannot unfollow account" })
    }
    try tx.query(
      "DELETE FROM feed_follows WHERE follower_id = $1 AND target_id = $2",
      [pair.actor.id, pair.target.id]
    )
    return {
      followerId: pair.actor.id,
      targetId: pair.target.id,
      targetKind: pair.target.kind,
      following: false
    }
  })
}

export effect function blockAccount(blockerId: string, targetHandleOrId: string): BlockResult!(SocialFailure | StoreFailure)!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const pair = try loadPairSnapshotTx(tx, blockerId, targetHandleOrId, true, true)
    if (pair.actor.id === pair.target.id) {
      throw new SocialFailure({ code: "InvalidInput", message: "Cannot block yourself" })
    }
    if (!pair.directBlock) {
      if (!canBlock(pair.state, pair.target.id, pair.actor.id)) {
        throw new SocialFailure({ code: "Forbidden", message: "Block refused by moderation rules" })
      }
      const after = applySpecBlock(pair.state, pair.target.id, pair.actor.id)
      try tx.query(
        "INSERT INTO feed_blocks (blocker_id, blocked_id, created_at) VALUES ($1, $2, $3) ON CONFLICT (blocker_id, blocked_id) DO NOTHING",
        [pair.actor.id, pair.target.id, now]
      )
      if (after.follows.length === 0) {
        try tx.query(
          "DELETE FROM feed_follows WHERE (follower_id = $1 AND target_id = $2) OR (follower_id = $2 AND target_id = $1)",
          [pair.actor.id, pair.target.id]
        )
      }
    }
    return {
      blockerId: pair.actor.id,
      blockedId: pair.target.id,
      blocked: true
    }
  })
}

export effect function unblockAccount(blockerId: string, targetHandleOrId: string): BlockResult!(SocialFailure | StoreFailure)!Store {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const pair = try loadPairSnapshotTx(tx, blockerId, targetHandleOrId, true, true)
    if (pair.directBlock && !canUnblock(pair.state, pair.target.id, pair.actor.id)) {
      throw new SocialFailure({ code: "Forbidden", message: "Cannot unblock account" })
    }
    try tx.query(
      "DELETE FROM feed_blocks WHERE blocker_id = $1 AND blocked_id = $2",
      [pair.actor.id, pair.target.id]
    )
    return {
      blockerId: pair.actor.id,
      blockedId: pair.target.id,
      blocked: false
    }
  })
}

export effect function muteAccount(muterId: string, targetHandleOrId: string): MuteResult!(SocialFailure | StoreFailure)!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const pair = try loadPairSnapshotTx(tx, muterId, targetHandleOrId, true)
    if (pair.actor.id === pair.target.id) {
      throw new SocialFailure({ code: "InvalidInput", message: "Cannot mute yourself" })
    }
    if (!pair.muted) {
      if (!canMute(pair.state, pair.target.id, pair.actor.id)) {
        throw new SocialFailure({ code: "Forbidden", message: "Mute refused by moderation rules" })
      }
      try tx.query(
        "INSERT INTO feed_mutes (muter_id, muted_id, created_at) VALUES ($1, $2, $3) ON CONFLICT (muter_id, muted_id) DO NOTHING",
        [pair.actor.id, pair.target.id, now]
      )
    }
    return {
      muterId: pair.actor.id,
      mutedId: pair.target.id,
      muted: true
    }
  })
}

export effect function unmuteAccount(muterId: string, targetHandleOrId: string): MuteResult!(SocialFailure | StoreFailure)!Store {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const pair = try loadPairSnapshotTx(tx, muterId, targetHandleOrId, true)
    if (pair.muted && !canUnmute(pair.state, pair.target.id, pair.actor.id)) {
      throw new SocialFailure({ code: "Forbidden", message: "Cannot unmute account" })
    }
    try tx.query(
      "DELETE FROM feed_mutes WHERE muter_id = $1 AND muted_id = $2",
      [pair.actor.id, pair.target.id]
    )
    return {
      muterId: pair.actor.id,
      mutedId: pair.target.id,
      muted: false
    }
  })
}

function normalizeReportCategory(raw: string | undefined): ReportCategory {
  if (raw === "Spam" || raw === "Harassment" || raw === "Impersonation" || raw === "OtherViolation") {
    return raw
  }
  return "OtherViolation"
}

function encodeStoredReportReason(category: ReportCategory, reason: string): string {
  return `[${category}] ${reason}`
}

function decodeStoredReportReason(raw: string): { readonly category: ReportCategory; readonly reason: string } {
  const match = /^\[(Spam|Harassment|Impersonation|OtherViolation)\]\s+([\s\S]*)$/.exec(raw)
  if (match === null) {
    return { category: "OtherViolation", reason: raw }
  }
  return {
    category: normalizeReportCategory(match[1]),
    reason: match[2] ?? ""
  }
}

function rowToReportView(row: Row): ReportView {
  const decoded = decodeStoredReportReason(toText(row.reason) ?? "")
  const rawKind = toText(row.target_kind)
  return {
    id: toText(row.id) ?? "",
    reporterId: toText(row.reporter_id) ?? "",
    targetKind: rawKind === "account" ? "account" : "post",
    targetId: toText(row.target_id) ?? "",
    category: decoded.category,
    reason: decoded.reason,
    status: toText(row.status) ?? "open",
    createdAt: safeInt(row.created_at, 0)
  }
}

export effect function reportTarget(input: ReportTargetInput): ReportView!(SocialFailure | StoreFailure)!Store {
  const reason = input.reason.trim()
  if (reason === "" || reason.length > 1000) {
    throw new SocialFailure({ code: "InvalidInput", message: "Report reason must be between 1 and 1000 characters" })
  }
  const category = normalizeReportCategory(input.category)
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const reporter = try resolveUserOrNpcTx(tx, input.reporterId)
    let resolvedTargetId: string
    let targetOwnerId: string
    if (input.targetKind === "account") {
      const target = try resolveSubjectTx(tx, input.targetId)
      resolvedTargetId = target.id
      targetOwnerId = target.id
    } else {
      const postRows = try tx.query(
        "SELECT id, author_id FROM feed_posts WHERE id = $1 AND deleted_at IS NULL LIMIT 1",
        [input.targetId]
      )
      const postRow = postRows[0]
      if (postRow === undefined) {
        throw new SocialFailure({ code: "NotFound", message: "Reported post not found" })
      }
      resolvedTargetId = toText(postRow.id) ?? input.targetId
      targetOwnerId = toText(postRow.author_id) ?? ""
    }
    if (reporter.id === targetOwnerId) {
      throw new SocialFailure({ code: "InvalidInput", message: "Cannot report yourself or your own post" })
    }
    try tx.query(
      "SELECT pg_advisory_xact_lock(hashtextextended($1, 0))",
      [`social:report:${reporter.id}:${input.targetKind}:${resolvedTargetId}`]
    )
    const existingOpen = try tx.query(
      "SELECT 1 FROM feed_reports WHERE reporter_id = $1 AND target_id = $2 AND target_kind = $3 AND status = 'open' LIMIT 1",
      [reporter.id, resolvedTargetId, input.targetKind]
    )
    const specTargetKind = input.targetKind === "account" ? "UserTarget" : "PostTarget"
    const specPostId = input.targetKind === "account" ? 0 : 1
    const existingReports: ModerationReport[] = existingOpen.length > 0
      ? [{
          id: 1,
          reporterId: reporter.id,
          targetKind: specTargetKind,
          targetUserId: targetOwnerId,
          targetPostId: specPostId,
          category,
          status: "PendingReview"
        }]
      : []
    const modState: ModerationState = {
      accounts: [
        { id: reporter.id, mode: "GameMode", openPositionCount: 0, unreadCount: 0 },
        { id: targetOwnerId, mode: "GameMode", openPositionCount: 0, unreadCount: 0 }
      ],
      blocks: [],
      mutes: [],
      follows: [],
      reports: existingReports,
      notifications: [],
      lastReportId: existingReports.length,
      lastNotificationId: 0,
      blocksClearedFollowsCount: 0
    }
    if (!canReport(modState, specTargetKind, targetOwnerId, specPostId, reporter.id)) {
      throw new SocialFailure({ code: "Conflict", message: "An open report already exists for this target" })
    }
    const id = freshId()
    const storedReason = encodeStoredReportReason(category, reason)
    tx.query(
      "INSERT INTO feed_reports (id, reporter_id, target_id, target_kind, reason, status, created_at) VALUES ($1, $2, $3, $4, $5, 'open', $6)",
      [id, reporter.id, resolvedTargetId, input.targetKind, storedReason, now]
    ) catch effect (err) => {
      if (isUniqueViolationFailure(err)) {
        throw new SocialFailure({ code: "Conflict", message: "An open report already exists for this target" })
      }
      throw err
    }
    return {
      id,
      reporterId: reporter.id,
      targetKind: input.targetKind,
      targetId: resolvedTargetId,
      category,
      reason,
      status: "open",
      createdAt: now
    }
  })
}

export effect function listModerationReports(
  input: ListModerationReportsInput = {}
): ReadonlyArray<ReportView>!StoreFailure!Store {
  const effectiveLimit = clampLimit(input.limit, 50, 200)
  const statusFilter = input.status ?? "open"
  const store = try Store
  const rows = try store.transaction((tx: Tx) =>
    statusFilter === "all"
      ? tx.query("SELECT * FROM feed_reports ORDER BY created_at DESC, id DESC LIMIT $1", [effectiveLimit])
      : tx.query("SELECT * FROM feed_reports WHERE status = $1 ORDER BY created_at DESC, id DESC LIMIT $2", [statusFilter, effectiveLimit])
  )
  return rows.map(rowToReportView)
}

export effect function resolveModerationReport(
  input: ResolveModerationReportInput
): ReportView!(SocialFailure | StoreFailure)!Store {
  if (input.reportId.trim() === "") {
    throw new SocialFailure({ code: "InvalidInput", message: "Report ID is required" })
  }
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      "UPDATE feed_reports SET status = $2 WHERE id = $1 RETURNING *",
      [input.reportId, input.status]
    )
    const row = rows[0]
    if (row === undefined) {
      throw new SocialFailure({ code: "NotFound", message: "Report not found" })
    }
    return rowToReportView(row)
  })
}

interface HydratedNotificationMeta {
  readonly actor: SubjectProfile | undefined
  readonly chatId: string | null
  readonly inviteId: string | null
  readonly invitePending: boolean
}

function rowToNotification(row: Row, meta: HydratedNotificationMeta): NotificationView {
  const readAt = row.read_at === null || row.read_at === undefined ? null : safeInt(row.read_at, 0)
  const kind = toText(row.kind) ?? ""
  const actorIsParody = meta.actor !== undefined && meta.actor.kind !== "user"
  return {
    id: toText(row.id) ?? "",
    kind,
    title: toText(row.title) ?? "",
    body: toText(row.body) ?? "",
    actorId: toText(row.actor_id) ?? null,
    actorName: meta.actor?.displayName ?? null,
    actorHandle: meta.actor?.handle ?? null,
    actorAvatarUrl: meta.actor?.avatarUrl ?? null,
    actorIsParody,
    actorIsVerified: actorIsParody,
    postId: toText(row.post_id) ?? null,
    marketId: kind === "perp_liquidated" ? null : toText(row.market_id) ?? null,
    ticker: kind === "perp_liquidated" ? toText(row.market_id) ?? null : null,
    chatId: meta.chatId,
    inviteId: meta.inviteId,
    invitePending: meta.invitePending,
    isRead: readAt !== null,
    readAt,
    isGameOnly: Boolean(row.is_game_only),
    createdAt: safeInt(row.created_at, 0)
  }
}

effect function requireAccountUiModeTx(
  tx: Tx,
  accountId: string
): SocialPresentationMode!(SocialFailure | StoreFailure) {
  const accountRows = try tx.query("SELECT account_id, ui_mode FROM feed_accounts WHERE account_id = $1 LIMIT 1", [accountId])
  if (accountRows.length === 0) {
    throw new SocialFailure({ code: "NotFound", message: "Account not found" })
  }
  return toText(accountRows[0]?.ui_mode) === "social" ? "social" : "game"
}

function notificationVisibilityWhereSql(mode: SocialPresentationMode): string {
  const modeFilter = mode === "social"
    ? " AND n.is_game_only = false AND n.kind NOT IN ('market_resolved', 'pnl_digest')"
    : ""
  return `n.account_id = $1${modeFilter} AND (n.post_id IS NULL OR (p.id IS NOT NULL AND p.deleted_at IS NULL)) AND (n.chat_id IS NULL OR (EXISTS (SELECT 1 FROM feed_chats c WHERE c.id = n.chat_id) AND (n.kind <> 'chat_message' OR EXISTS (SELECT 1 FROM feed_chat_members cm WHERE cm.chat_id = n.chat_id AND cm.member_id = $1)))) AND (n.actor_id IS NULL OR (NOT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = $1 AND b.blocked_id = n.actor_id) OR (b.blocker_id = n.actor_id AND b.blocked_id = $1)) AND NOT EXISTS (SELECT 1 FROM feed_mutes m WHERE m.muter_id = $1 AND m.muted_id = n.actor_id)))`
}

export effect function listNotifications(
  accountId: string,
  limit?: number,
  mode?: SocialPresentationMode,
  unreadOnly?: boolean
): ReadonlyArray<NotificationView>!(SocialFailure | StoreFailure)!Store {
  if (accountId.trim() === "") {
    throw new SocialFailure({ code: "InvalidInput", message: "Account ID is required" })
  }
  const effectiveLimit = clampLimit(limit, 50, 200)
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const accountMode = try requireAccountUiModeTx(tx, accountId)
    const effectiveMode = mode ?? accountMode
    const specMode = toSpecMode(effectiveMode)
    const unreadFilter = unreadOnly === true ? " AND n.read_at IS NULL" : ""
    const rows = try tx.query(
      `SELECT n.* FROM feed_notifications n LEFT JOIN feed_posts p ON p.id = n.post_id WHERE ${notificationVisibilityWhereSql(effectiveMode)}${unreadFilter} ORDER BY n.created_at DESC, n.id DESC LIMIT $2`,
      [accountId, effectiveLimit]
    )
    if (rows.length === 0) return []
    const actorIds = rows.map((r) => toText(r.actor_id) ?? "").filter(Boolean)
    const actorProfiles = try loadProfilesByIdsTx(tx, actorIds)
    const directInviteIds = [...new Set(rows.map((r) => toText(r.invite_id) ?? "").filter(Boolean))]
    const inviteById = new Map<string, { readonly id: string; readonly chatId: string; readonly pending: boolean }>()
    if (directInviteIds.length > 0) {
      const directInviteRows = try tx.query(
        "SELECT id, chat_id, status FROM feed_group_invites WHERE id = ANY($1)",
        [directInviteIds]
      )
      for (const inv of directInviteRows) {
        const id = toText(inv.id) ?? ""
        if (id !== "") {
          inviteById.set(id, {
            id,
            chatId: toText(inv.chat_id) ?? "",
            pending: toText(inv.status) === "pending"
          })
        }
      }
    }
    const needsLegacyInviteLookup = rows.some((r) => toText(r.kind) === "group_invite" && (toText(r.invite_id) ?? "") === "")
    const inviteExact = new Map<string, { readonly id: string; readonly chatId: string; readonly pending: boolean }>()
    const inviteLatestByInviter = new Map<string, { readonly id: string; readonly chatId: string; readonly pending: boolean }>()
    if (needsLegacyInviteLookup) {
      const inviteRows = try tx.query(
        "SELECT id, chat_id, invited_by_id, status, created_at FROM feed_group_invites WHERE invited_account_id = $1 ORDER BY created_at DESC, id DESC",
        [accountId]
      )
      for (const inv of inviteRows) {
        const inviter = toText(inv.invited_by_id) ?? ""
        const createdAt = safeInt(inv.created_at, 0)
        const entry = {
          id: toText(inv.id) ?? "",
          chatId: toText(inv.chat_id) ?? "",
          pending: toText(inv.status) === "pending"
        }
        const exactKey = `${inviter}:${createdAt}`
        if (!inviteExact.has(exactKey)) inviteExact.set(exactKey, entry)
        if (!inviteLatestByInviter.has(inviter)) inviteLatestByInviter.set(inviter, entry)
      }
    }
    const legacyChatSenderIds = [...new Set(
      rows
        .filter((r) => toText(r.kind) === "chat_message" && (toText(r.chat_id) ?? "") === "")
        .map((r) => toText(r.actor_id) ?? "")
        .filter(Boolean)
    )]
    const chatExact = new Map<string, string>()
    const chatLatestBySender = new Map<string, string>()
    if (legacyChatSenderIds.length > 0) {
      const msgRows = try tx.query(
        `SELECT m.chat_id, m.sender_id, m.created_at
         FROM feed_messages m
         INNER JOIN feed_chat_members cm ON cm.chat_id = m.chat_id AND cm.member_id = $1
         WHERE m.sender_id = ANY($2)
         ORDER BY m.created_at DESC, m.id DESC`,
        [accountId, legacyChatSenderIds]
      )
      for (const msg of msgRows) {
        const sender = toText(msg.sender_id) ?? ""
        const cid = toText(msg.chat_id) ?? ""
        const createdAt = safeInt(msg.created_at, 0)
        const exactKey = `${sender}:${createdAt}`
        if (!chatExact.has(exactKey)) chatExact.set(exactKey, cid)
        if (!chatLatestBySender.has(sender)) chatLatestBySender.set(sender, cid)
      }
    }
    return rows
      .map((row) => {
        const kind = toText(row.kind) ?? ""
        const actorId = toText(row.actor_id) ?? null
        const createdAt = safeInt(row.created_at, 0)
        const actor = actorId === null ? undefined : actorProfiles.get(actorId)
        let chatId: string | null = normalizeOptionalText(toText(row.chat_id))
        let inviteId: string | null = normalizeOptionalText(toText(row.invite_id))
        let invitePending = false
        if (kind === "group_invite") {
          if (inviteId !== null) {
            const direct = inviteById.get(inviteId)
            if (direct !== undefined) {
              chatId = chatId ?? (direct.chatId === "" ? null : direct.chatId)
              invitePending = direct.pending
            }
          } else if (actorId !== null) {
            const matched = inviteExact.get(`${actorId}:${createdAt}`) ?? inviteLatestByInviter.get(actorId)
            if (matched !== undefined) {
              chatId = chatId ?? (matched.chatId === "" ? null : matched.chatId)
              inviteId = matched.id === "" ? null : matched.id
              invitePending = matched.pending
            }
          }
        } else if (kind === "chat_message" && chatId === null && actorId !== null) {
          chatId = chatExact.get(`${actorId}:${createdAt}`) ?? chatLatestBySender.get(actorId) ?? null
        }
        return rowToNotification(row, { actor, chatId, inviteId, invitePending })
      })
      .filter((notif) => isVisibleInMode(toSpecNotificationKind(notif.kind, notif.isGameOnly), specMode))
  })
}

effect function requireNonEmptyAccountId(accountId: string): void!SocialFailure {
  if (accountId.trim() === "") {
    throw new SocialFailure({ code: "InvalidInput", message: "Account ID is required" })
  }
}

export effect function clearNotifications(
  accountId: string,
  notificationIds?: ReadonlyArray<string>,
  modeOverride?: SocialPresentationMode
): ClearNotificationsResult!(SocialFailure | StoreFailure)!Store {
  try requireNonEmptyAccountId(accountId)
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const accountMode = try requireAccountUiModeTx(tx, accountId)
    const mode = modeOverride ?? accountMode
    if (notificationIds !== undefined && notificationIds.length === 0) {
      return { clearedCount: 0, unreadCount: try countUnreadNotificationsTx(tx, accountId, mode) }
    }
    const deleted = notificationIds !== undefined
      ? try tx.query(
          "DELETE FROM feed_notifications WHERE account_id = $1 AND id = ANY($2) RETURNING id",
          [accountId, [...notificationIds]]
        )
      : try tx.query(
          `DELETE FROM feed_notifications n WHERE n.id IN (SELECT n2.id FROM feed_notifications n2 LEFT JOIN feed_posts p ON p.id = n2.post_id WHERE ${notificationVisibilityWhereSql(mode).replace(/\bn\./g, "n2.")}) RETURNING n.id`,
          [accountId]
        )
    return {
      clearedCount: deleted.length,
      unreadCount: try countUnreadNotificationsTx(tx, accountId, mode)
    }
  })
}

effect function listModerationEdges(
  kind: "blocks" | "mutes",
  accountId: string,
  limit?: number
): ReadonlyArray<ModerationListEntry>!(SocialFailure | StoreFailure)!Store {
  const effectiveLimit = clampLimit(limit, 50, 200)
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const owner = try resolveUserOrNpcTx(tx, accountId)
    const rows = kind === "blocks"
      ? try tx.query(
          "SELECT blocked_id AS target_id, created_at FROM feed_blocks WHERE blocker_id = $1 ORDER BY created_at DESC, blocked_id DESC LIMIT $2",
          [owner.id, effectiveLimit]
        )
      : try tx.query(
          "SELECT muted_id AS target_id, created_at FROM feed_mutes WHERE muter_id = $1 ORDER BY created_at DESC, muted_id DESC LIMIT $2",
          [owner.id, effectiveLimit]
        )
    if (rows.length === 0) return []
    const createdAtById = new Map<string, number>()
    const targetIds: string[] = []
    for (const row of rows) {
      const targetId = toText(row.target_id) ?? ""
      if (targetId === "") continue
      targetIds.push(targetId)
      if (!createdAtById.has(targetId)) {
        createdAtById.set(targetId, safeInt(row.created_at, 0))
      }
    }
    const hydrated = try hydratePeerEntriesTx(tx, targetIds, owner.id, false)
    return hydrated.map((entry) => ({
      ...entry,
      createdAt: createdAtById.get(entry.id) ?? 0
    }))
  })
}

export effect function listBlockedAccounts(
  accountId: string,
  limit?: number
): ReadonlyArray<ModerationListEntry>!(SocialFailure | StoreFailure)!Store {
  return try listModerationEdges("blocks", accountId, limit)
}

export effect function listMutedAccounts(
  accountId: string,
  limit?: number
): ReadonlyArray<ModerationListEntry>!(SocialFailure | StoreFailure)!Store {
  return try listModerationEdges("mutes", accountId, limit)
}

effect function countUnreadNotificationsTx(
  tx: Tx,
  accountId: string,
  mode: SocialPresentationMode
): number!StoreFailure {
  const rows = try tx.query(
    `SELECT count(*) AS count FROM feed_notifications n LEFT JOIN feed_posts p ON p.id = n.post_id WHERE n.read_at IS NULL AND ${notificationVisibilityWhereSql(mode)}`,
    [accountId]
  )
  return safeInt(rows[0]?.count, 0)
}

export effect function getUnreadNotificationCount(
  accountId: string,
  mode?: SocialPresentationMode
): number!(SocialFailure | StoreFailure)!Store {
  try requireNonEmptyAccountId(accountId)
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const effectiveMode = mode ?? (try readViewerUiModeTx(tx, accountId))
    return try countUnreadNotificationsTx(tx, accountId, effectiveMode)
  })
}

export effect function markNotificationsRead(
  accountId: string,
  notificationIds?: ReadonlyArray<string>,
  modeOverride?: SocialPresentationMode
): MarkNotificationsReadResult!(SocialFailure | StoreFailure)!Store {
  try requireNonEmptyAccountId(accountId)
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const accountMode = try requireAccountUiModeTx(tx, accountId)
    const mode = modeOverride ?? accountMode
    const unreadRows = try tx.query(
      `SELECT n.id, n.kind, n.actor_id, n.is_game_only FROM feed_notifications n LEFT JOIN feed_posts p ON p.id = n.post_id WHERE n.read_at IS NULL AND ${notificationVisibilityWhereSql(mode)}`,
      [accountId]
    )
    const specNotifs: SpecNotification[] = unreadRows.map((row, idx) => ({
      id: idx + 1,
      userId: accountId,
      actorId: toText(row.actor_id) ?? "",
      notifKind: toSpecNotificationKind(toText(row.kind) ?? "", Boolean(row.is_game_only)),
      read: false
    }))
    const modState: ModerationState = {
      accounts: [{ id: accountId, mode: toSpecMode(mode), openPositionCount: 0, unreadCount: specNotifs.length }],
      blocks: [],
      mutes: [],
      follows: [],
      reports: [],
      notifications: specNotifs,
      lastReportId: 0,
      lastNotificationId: specNotifs.length,
      blocksClearedFollowsCount: 0
    }
    if (!canMarkNotificationsRead(modState, accountId) || (notificationIds !== undefined && notificationIds.length === 0)) {
      return { markedCount: 0, unreadCount: try countUnreadNotificationsTx(tx, accountId, mode) }
    }
    const idFilter = notificationIds !== undefined ? " AND n.id = ANY($3)" : ""
    const params: unknown[] = notificationIds !== undefined ? [accountId, now, [...notificationIds]] : [accountId, now]
    const updated = try tx.query(
      `UPDATE feed_notifications n SET read_at = $2 WHERE n.read_at IS NULL AND n.id IN (SELECT n2.id FROM feed_notifications n2 LEFT JOIN feed_posts p ON p.id = n2.post_id WHERE n2.read_at IS NULL AND ${notificationVisibilityWhereSql(mode).replace(/\bn\./g, "n2.")})${idFilter} RETURNING n.id`,
      params
    )
    return {
      markedCount: updated.length,
      unreadCount: try countUnreadNotificationsTx(tx, accountId, mode)
    }
  })
}

effect function hydratePeerEntriesTx(
  tx: Tx,
  peerIds: ReadonlyArray<string>,
  viewerId: string | undefined,
  skipBlocked: boolean
): ReadonlyArray<FollowListEntry>!StoreFailure {
  const uniqueIds = [...new Set(peerIds.filter((id) => id !== ""))]
  if (uniqueIds.length === 0) return []
  const blockedSet = new Set<string>()
  if (skipBlocked && viewerId !== undefined) {
    const blockRows = try tx.query(
      "SELECT blocker_id, blocked_id FROM feed_blocks WHERE (blocker_id = $1 AND blocked_id = ANY($2)) OR (blocked_id = $1 AND blocker_id = ANY($2))",
      [viewerId, uniqueIds]
    )
    for (const r of blockRows) {
      const blocker = toText(r.blocker_id) ?? ""
      const blocked = toText(r.blocked_id) ?? ""
      if (blocker === viewerId && blocked !== "") blockedSet.add(blocked)
      else if (blocked === viewerId && blocker !== "") blockedSet.add(blocker)
    }
  }
  const visibleIds = uniqueIds.filter((id) => !blockedSet.has(id))
  if (visibleIds.length === 0) return []
  const profileMap = try loadProfilesByIdsTx(tx, visibleIds)
  const resolvedPeers: SubjectProfile[] = []
  for (const id of visibleIds) {
    const found = profileMap.get(id)
    if (found !== undefined) resolvedPeers.push(found)
  }
  if (resolvedPeers.length === 0) return []
  const userIds = resolvedPeers.filter((p) => p.kind === "user").map((p) => p.id)
  const npcIds = resolvedPeers.filter((p) => p.kind === "npc").map((p) => p.id)
  const orgIds = resolvedPeers.filter((p) => p.kind === "org").map((p) => p.id)
  const bioMap = new Map<string, string>()
  if (userIds.length > 0) {
    const rows = try tx.query("SELECT account_id, bio FROM feed_accounts WHERE account_id = ANY($1)", [userIds])
    for (const r of rows) {
      const id = toText(r.account_id)
      if (id !== undefined) bioMap.set(`user:${id}`, toText(r.bio) ?? "")
    }
  }
  if (npcIds.length > 0) {
    const rows = try tx.query("SELECT id, description FROM feed_actors WHERE id = ANY($1)", [npcIds])
    for (const r of rows) {
      const id = toText(r.id)
      if (id !== undefined) bioMap.set(`npc:${id}`, toText(r.description) ?? "")
    }
  }
  if (orgIds.length > 0) {
    const rows = try tx.query("SELECT id, description FROM feed_organizations WHERE id = ANY($1)", [orgIds])
    for (const r of rows) {
      const id = toText(r.id)
      if (id !== undefined) bioMap.set(`org:${id}`, toText(r.description) ?? "")
    }
  }
  const viewerFollowedSet = new Set<string>()
  if (viewerId !== undefined) {
    const allIds = resolvedPeers.map((p) => p.id)
    const followRows = try tx.query(
      "SELECT target_id FROM feed_follows WHERE follower_id = $1 AND target_id = ANY($2)",
      [viewerId, allIds]
    )
    for (const r of followRows) {
      const targetId = toText(r.target_id)
      if (targetId !== undefined) viewerFollowedSet.add(targetId)
    }
  }
  return resolvedPeers.map((resolved) => ({
    id: resolved.id,
    kind: resolved.kind,
    handle: resolved.handle,
    displayName: resolved.displayName,
    bio: bioMap.get(`${resolved.kind}:${resolved.id}`) ?? "",
    avatarUrl: resolved.avatarUrl,
    viewerFollows: viewerFollowedSet.has(resolved.id),
    isParody: resolved.kind !== "user"
  }))
}

effect function listFollowEdges(
  direction: "followers" | "following",
  handleOrId: string,
  viewerId?: string,
  limit?: number
): ReadonlyArray<FollowListEntry>!(SocialFailure | StoreFailure)!Store {
  const effectiveLimit = clampLimit(limit, 50, 200)
  const viewer = normalizeOptionalText(viewerId) ?? undefined
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const subject = try resolveSubjectTx(tx, handleOrId)
    if (viewer !== undefined && (try isBlockedBetweenTx(tx, viewer, subject.id))) {
      throw new SocialFailure({ code: "Blocked", message: "Follow list unavailable due to a block" })
    }
    const peerCol = direction === "followers" ? "f.follower_id" : "f.target_id"
    const matchCol = direction === "followers" ? "f.target_id" : "f.follower_id"
    const rows = viewer === undefined
      ? try tx.query(
          `SELECT ${peerCol} AS peer_id FROM feed_follows f WHERE ${matchCol} = $1 ORDER BY f.created_at DESC LIMIT $2`,
          [subject.id, effectiveLimit]
        )
      : try tx.query(
          `SELECT ${peerCol} AS peer_id FROM feed_follows f WHERE ${matchCol} = $1 AND NOT EXISTS (SELECT 1 FROM feed_blocks b WHERE (b.blocker_id = $2 AND b.blocked_id = ${peerCol}) OR (b.blocker_id = ${peerCol} AND b.blocked_id = $2)) ORDER BY f.created_at DESC LIMIT $3`,
          [subject.id, viewer, effectiveLimit]
        )
    const peerIds = rows.map((r) => toText(r.peer_id) ?? "").filter(Boolean)
    return try hydratePeerEntriesTx(tx, peerIds, viewer, true)
  })
}

export effect function listFollowers(
  handleOrId: string,
  viewerId?: string,
  limit?: number
): ReadonlyArray<FollowListEntry>!(SocialFailure | StoreFailure)!Store {
  return try listFollowEdges("followers", handleOrId, viewerId, limit)
}

export effect function listFollowing(
  handleOrId: string,
  viewerId?: string,
  limit?: number
): ReadonlyArray<FollowListEntry>!(SocialFailure | StoreFailure)!Store {
  return try listFollowEdges("following", handleOrId, viewerId, limit)
}
