      amountCents: 4_000
    })
    try cancelPredictionMarket("seed-market-1")
    const all = try listClosedPositions({ accountId: "user-bob" })
    const cancelled = try listClosedPositions({ accountId: "user-bob", outcome: "cancelled" })
    const lost = try listClosedPositions({ accountId: "user-bob", outcome: "lost" })
    const canonical = try listUserClosedPositions("user-bob")
    const payoutEqualsCostBasis = all.items[0]?.payoutCents === all.items[0]?.costBasisCents
    try check(() => assert.deepStrictEqual(
      {
