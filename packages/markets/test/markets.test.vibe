// spec/markets/prediction.md, "Story: Open and trade a prediction market"; spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel"; spec/markets/spotPerp.md, "Story: NPC spot trades drive the index price"; spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/markets/spotPerp.md, "Story: 8-hour funding accrual and mark-price liquidation"; spec/markets/economy.md, "Story: Trade with fixed starting capital and rank by net profit"
import { assert, it } from "@effect/vitest"
import { Store, StoreFailure, migrateFeedSchema, seedFeedWorld, toInt, type Tx } from "@repo/db"
import { localStoreLayer } from "@repo/db/node"
import { TestClock } from "effect/testing"
import {
  CENT_SHARES_PER_SHARE,
  INITIAL_GRANT_CENTS,
  MarketFailure,
  MarketRealtimeBus,
  accruePerpFunding,
  buyPredictionShares,
  cancelPredictionMarket,
  closePerpPosition,
  executeNpcSpotTrade,
  getAccountEconomy,
  getAccountLeaderboardRank,
  getFilteredLeaderboardPage,
  getLeaderboard,
  getMarketPriceHistory,
  getPerpPriceHistory,
  getPerpMarket,
  getPointLedger,
  getPredictionMarket,
  getPredictionPriceHistory,
  getUserPositions,
  liquidateEligiblePositions,
  listClosedPositions,
  listMarketTrades,
  listPerpMarkets,
  listPerpPositions,
  listPredictionMarkets,
  listUserClosedPositions,
  markToMarketPredictionCents,
  openPerpPosition,
  parseClosedOutcomeFilter,
  previewPerpOrder,
  previewPredictionBuy,
  previewPredictionSell,
  resolvePredictionMarket,
  sellPredictionShares,
  snapshotMarketPrices,
  type BuyPredictionInput,
  type MarketPerpRealtimeEvent,
  type SellPredictionInput
} from "../src/index.vibe"

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function runWithSeededDb<A, E>(body: A!E!Store) {
  provide localStoreLayer({ kind: "pglite", file: undefined }) {
    try migrateFeedSchema()
    try seedFeedWorld()
    return try body
  }
}

effect function runWithSeededMarketDay<A, E>(body: (now: number) => A!E!Store) {
  try TestClock.setTime(Date.UTC(2026, 10, 19, 12, 0, 0))
  return try runWithSeededDb(effect {
    const now = try Clock.currentTimeMillis
    return try body(now)
  })
}

effect function seedHundredCorpMarket(now: number): void!StoreFailure!Store {
  const store = try Store
  try store.transaction(effect (tx: Tx) => {
    try tx.query(
      `INSERT INTO feed_organizations (id, name, ticker, org_type, description, post_style, can_be_involved, initial_price_cents, created_at)
       VALUES ('org-hundred', 'Hundred Corp', 'HUND', 'company', 'Synthetic $100 org', 'neutral', true, 10000, $1)
       ON CONFLICT (id) DO NOTHING`,
      [now]
    )
    try tx.query(
      `INSERT INTO feed_spot_pools (ticker, organization_id, base_reserve, quote_reserve_cents, index_price_cents, updated_at)
       VALUES ('HUND', 'org-hundred', 50000, 5000000, 10000, $1)
       ON CONFLICT (ticker) DO NOTHING`,
      [now]
    )
    try tx.query(
      `INSERT INTO feed_perp_markets (ticker, index_price_cents, mark_price_cents, long_oi_cents, short_oi_cents, max_leverage, funding_rate_bps, last_funding_period, updated_at)
       VALUES ('HUND', 10000, 10000, 0, 0, 20, 0, 0, $1)
       ON CONFLICT (ticker) DO NOTHING`,
      [now]
    )
  })
}

effect function openAndCloseUserPerp(input: {
  readonly ownerId: string
  readonly ticker: string
  readonly side: "long" | "short"
  readonly collateralCents: number
  readonly leverage: number
}) {
  const open = try openPerpPosition({
    ownerId: input.ownerId,
    ownerKind: "user",
    ticker: input.ticker,
    side: input.side,
    collateralCents: input.collateralCents,
    leverage: input.leverage
  })
  const close = try closePerpPosition({
    ownerId: input.ownerId,
    positionId: open.positionId
  })
  return { open, close }
}

function closedPositionSummary(result: Awaited<ReturnType<typeof listClosedPositions>> extends Effect.Effect<infer A, unknown, unknown> ? A : never) {
  const item = result.items[0]
  return {
    itemKind: item?.kind,
    itemMarketId: item?.marketId,
    itemSide: item?.side,
    itemOutcome: item?.outcome
  }
}

function closedPerpPayoutSummary(result: Awaited<ReturnType<typeof listClosedPositions>> extends Effect.Effect<infer A, unknown, unknown> ? A : never) {
  const item = result.items[0]
  return {
    totalCount: result.totalCount,
    itemKind: item?.kind,
    itemTicker: item?.ticker,
    itemSide: item?.side,
    itemCostBasisCents: item?.costBasisCents,
    itemPayoutCents: item?.payoutCents,
    itemRealizedPnlCents: item?.realizedPnlCents
  }
}

const FEED_ACCOUNT_COLUMNS = `account_id, handle, display_name, bio, avatar_url, phone_hash, phone_last2,
  phone_verified_at, age_confirmed_at, ui_mode, balance_cents, starting_grant_cents,
  total_fees_paid_cents, is_admin, is_reviewer, reviewer_password_hash,
  created_at, updated_at`

effect function createVerifiedAccount(accountId: string, handle: string, balanceCents = INITIAL_GRANT_CENTS): void!StoreFailure!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  try store.transaction(effect (tx: Tx) => {
    const orgId = `org-${accountId}`
    try tx.query(
      "INSERT INTO organizations (id, name, credit_balance, created_at) VALUES ($1, $2, 0, $3) ON CONFLICT (id) DO NOTHING",
      [orgId, handle, now]
    )
    try tx.query(
      `INSERT INTO accounts (key, state, revision, organization_id, status, email, phone, name, created_at, updated_at)
       VALUES ($1, '{}'::jsonb, 1, $2, 'active', NULL, NULL, $3, $4, $4)
       ON CONFLICT (key) DO NOTHING`,
      [accountId, orgId, handle, now]
    )
    try tx.query(
      `INSERT INTO feed_accounts (${FEED_ACCOUNT_COLUMNS})
       VALUES ($1, $2, $3, '', NULL, $4, '01', $5, $5, 'game', $6, $6, 0, false, false, NULL, $5, $5)`,
      [accountId, handle, handle, `phone-hash-${accountId}`, now, balanceCents]
    )
  })
}

effect function seedAliceHundredDay(now: number): void!StoreFailure!Store {
  try createVerifiedAccount("user-alice", "alice", INITIAL_GRANT_CENTS)
  try seedHundredCorpMarket(now)
}

effect function marketErrorCode<A, R>(program: A!(MarketFailure | StoreFailure)!R): string!!R {
  return effect {
    try program
    return "NONE"
  } catch (error) => match (error) {
    when MarketFailure: error.code;
    when StoreFailure: `STORE:${error.operation}`;
  }
}

it.effect('Prediction market lifecycle: previews, cent-share CPMM, MIN_SELL_SHARE_UNITS, price history, atomic proof resolution, and closed positions (spec/markets/prediction.md, "Story: Open and trade a prediction market"; spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel")', () =>
  runWithSeededMarketDay(effect (now) => {
    const store = try Store
    // spec/markets/prediction.md, "Hidden outcome and prepared proof are never visible before resolution"
    const openView = try getPredictionMarket("seed-market-1")
    try createVerifiedAccount("user-alice", "alice", INITIAL_GRANT_CENTS)
    try createVerifiedAccount("user-bob", "bob", INITIAL_GRANT_CENTS)

    const historyBefore = try getMarketPriceHistory("prediction", "seed-market-1", 50)
    const buyPreview = try previewPredictionBuy({
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 2_000
    })

    // spec/markets/prediction.md, "Buying YES or NO shares requires an open non-expired market, sufficient balance, and bounded odds impact"
    const aliceBuy = try buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 2_000
    })
    const bobBuy = try buyPredictionShares({
      actorId: "user-bob",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "no",
      amountCents: 1_000
    })

    // spec/markets/prediction.md, "Selling shares floors gross proceeds to whole cents before charging the canonical fee"
    const tooSmallSellCode = try marketErrorCode(sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      shares: 50
    }))
    const sharesToSell = 1_000 + (aliceBuy.shares % 100)
    const sellPreview = try previewPredictionSell({
      marketId: "seed-market-1",
      side: "yes",
      shares: sharesToSell,
      holderId: "user-alice"
    })
    try TestClock.adjust(Duration.millis(1))
    const aliceSell = try sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      shares: sharesToSell
    })
    const remainingShares = aliceBuy.shares - sharesToSell
    const positionsBeforeResolve = try getUserPositions("user-alice")
    const marketAfterTrades = try getPredictionMarket("seed-market-1")
    const history = try getMarketPriceHistory("prediction", "seed-market-1", 50)
    const trades = try listMarketTrades("prediction", "seed-market-1", 10)

    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        `INSERT INTO feed_market_price_history (id, market_kind, market_ref, price_cents, yes_price_bps, recorded_at)
         SELECT 'prediction-history-' || tick, 'prediction', 'seed-market-1', $1, $2, $3::bigint - tick
         FROM generate_series(1, $4::integer) AS fixtures(tick)`,
        [Math.round(openView.yesPriceBps / 100), openView.yesPriceBps, now, 203 - history.length]
      )
    })
    try TestClock.adjust(Duration.millis(1))
    try snapshotMarketPrices()
    const fullHistory = try getPredictionPriceHistory({ marketId: "seed-market-1", range: "ALL", limit: 500 })
    const sampledHistory = try getPredictionPriceHistory({ marketId: "seed-market-1", range: "ALL" })
    try check(() => {
      assert.deepStrictEqual({
        recordedPoints: fullHistory.points.length,
        sampledPoints: sampledHistory.points.length,
        firstPoint: sampledHistory.points[0],
        lastPoint: sampledHistory.points.at(-1),
        sampledVolumeCents: sampledHistory.points.reduce((volume, point) => volume + point.volumeCents, 0)
      }, {
        recordedPoints: 204,
        sampledPoints: 200,
        firstPoint: fullHistory.points[0],
        lastPoint: fullHistory.points.at(-1),
        sampledVolumeCents: history.reduce((volume, point) => volume + point.volumeCents, 0)
      })
    })

    // spec/markets/prediction.md, "Resolved, cancelled, held, and expired markets allow no trades, and duplicate resolution pays nothing extra"
    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        `INSERT INTO feed_prediction_resolution_work (market_id, attempts, last_error, next_retry_at, updated_at)
         VALUES ('seed-market-1', 0, NULL, $1, $1) ON CONFLICT (market_id) DO NOTHING`,
        [now]
      )
    })
    try TestClock.adjust(Duration.seconds(4 * 86_400))
    const expiredBuyCode = try marketErrorCode(buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 100
    }))

    // spec/markets/prediction.md, "Resolution declassifies the hidden outcome, publishes the proof, and pays 1 pt (100 cents) per winning share idempotently"
    const resolved = try resolvePredictionMarket({
      marketId: "seed-market-1",
      clearResolutionWork: true,
      proofArticle: {
        id: "art-proof-seed-1",
        title: "OpenAGI publishes frontier compute pricing",
        summary: "OpenAGI published frontier compute pricing.",
        body: "Official rate card published before expiry.",
        authorOrgId: "the-new-york-taimes"
      }
    })
    const proofArticleRows = try store.transaction((tx: Tx) =>
      tx.query("SELECT id, is_resolution_proof FROM feed_articles WHERE id = 'art-proof-seed-1'")
    )
    const remainingWorkRows = try store.transaction((tx: Tx) =>
      tx.query("SELECT market_id FROM feed_prediction_resolution_work WHERE market_id = 'seed-market-1'")
    )
    const aliceAfterResolve = try getAccountEconomy("user-alice")
    const bobAfterResolve = try getAccountEconomy("user-bob")
    const resolvedView = try getPredictionMarket("seed-market-1")
    const aliceClosed = try listUserClosedPositions("user-alice")
    const bobClosed = try listUserClosedPositions("user-bob")
    const aliceLedger = try getPointLedger("user-alice")
    const resolutionLedger = aliceLedger.find((entry) => entry.kind === "prediction_resolution")

    const replayed = try resolvePredictionMarket({ marketId: "seed-market-1" })
    const aliceAfterReplay = try getAccountEconomy("user-alice")

    try check(() => assert.deepStrictEqual(
      {
        openSecrecy: [
          openView.status,
          openView.resolvedOutcome,
          openView.resolutionProof,
          openView.resolutionArticleId,
          openView.resolvedAt,
          Object.prototype.hasOwnProperty.call(openView, "secretOutcome")
        ],
        previewMatchesBuy: [
          buyPreview.sharesOut === aliceBuy.shares,
          buyPreview.feeCents === aliceBuy.feeCents,
          buyPreview.newYesPriceBps === aliceBuy.yesPriceBps
        ],
        tooSmallSellCode,
        previewMatchesSell: [
          sellPreview.grossCents === aliceSell.notionalCents,
          sellPreview.feeCents === aliceSell.feeCents,
          sellPreview.netCreditCents === aliceSell.netCents,
          sellPreview.newYesPriceBps === aliceSell.yesPriceBps
        ],
        aliceSellRealizedRecorded: aliceSell.realizedPnlCents !== null,
        marketVolumeMatchesTrades: marketAfterTrades.volumeCents === aliceBuy.notionalCents + bobBuy.notionalCents + aliceSell.notionalCents,
        historyAndTradesCounts: [history.length - historyBefore.length, trades.length],
        openPositionsBeforeResolve: positionsBeforeResolve.predictionPositions.map((p) => p.shares),
        expiredBuyCode,
        resolved: [
          resolved.status,
          resolved.outcome,
          resolved.positionsSettled,
          resolved.totalPayoutCents,
          resolved.alreadyResolved,
          remainingShares % 100
        ],
        atomicProofAndWorkCleanup: [
          proofArticleRows.length,
          proofArticleRows[0]?.is_resolution_proof,
          remainingWorkRows.length,
          resolvedView.resolutionArticleId
        ],
        balancesAfterResolve: [
          aliceAfterResolve.balanceCents,
          bobAfterResolve.balanceCents,
          resolutionLedger?.deltaCents
        ],
        closedOutcomes: [
          aliceClosed.predictionPositions[0]?.outcome,
          bobClosed.predictionPositions[0]?.outcome
        ],
        replayed: [replayed.alreadyResolved, replayed.totalPayoutCents, aliceAfterReplay.balanceCents]
      },
      {
        openSecrecy: ["open", null, null, null, null, false],
        previewMatchesBuy: [true, true, true],
        tooSmallSellCode: "INVALID_SHARES",
        previewMatchesSell: [true, true, true, true],
        aliceSellRealizedRecorded: true,
        marketVolumeMatchesTrades: true,
        historyAndTradesCounts: [3, 3],
        openPositionsBeforeResolve: [remainingShares],
        expiredBuyCode: "MARKET_CLOSED",
        resolved: ["resolved", "yes", 2, remainingShares, false, 0],
        atomicProofAndWorkCleanup: [1, true, 0, "art-proof-seed-1"],
        balancesAfterResolve: [
          aliceSell.balanceAfterCents + remainingShares,
          9_000,
          remainingShares
        ],
        closedOutcomes: ["won", "lost"],
        replayed: [true, 0, aliceSell.balanceAfterCents + remainingShares]
      }
    ))
  })
)

it.effect('Spot BASE_SCALE=100, NPC inventory enforcement, and anti-exploit perp open/close round-trip (spec/markets/spotPerp.md, "Story: NPC spot trades drive the index price"; spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/markets/spotPerp.md, "Zero-time open and close round-trips on an unchanged index price strictly decrease trader cash")', () =>
  runWithSeededMarketDay(effect (now) => {
    const store = try Store
    try createVerifiedAccount("user-alice", "alice", INITIAL_GRANT_CENTS)
    try createVerifiedAccount("user-bob", "bob", INITIAL_GRANT_CENTS)
    try seedHundredCorpMarket(now)

    // spec/markets/spotPerp.md, "Only NPCs may trade the spot CPMM pool, updating the persisted index price"
    const nonNpcCode = try marketErrorCode(executeNpcSpotTrade({
      actorId: "user-alice",
      ticker: "HUND",
      side: "buy",
      quoteCents: 2_500
    }))
    const sellWithoutInventoryCode = try marketErrorCode(executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "HUND",
      side: "sell",
      quoteCents: 2_500
    }))
    const smallSpotBuy = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "HUND",
      side: "buy",
      quoteCents: 2_500
    })
    const holdingAfterBuy = try store.transaction((tx: Tx) =>
      tx.query("SELECT base_units FROM feed_npc_spot_holdings WHERE actor_id = 'ailon-musk' AND ticker = 'HUND'")
    )
    const smallSpotSell = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "HUND",
      side: "sell",
      quoteCents: 1_000
    })

    // spec/markets/spotPerp.md, "Zero-time open and close round-trips on an unchanged index price strictly decrease trader cash"
    const longPreview = try previewPerpOrder({
      ownerId: "user-alice",
      ticker: "HUND",
      side: "long",
      collateralCents: 500,
      leverage: 20
    })
    const { open: longOpen, close: longClose } = try openAndCloseUserPerp({
      ownerId: "user-alice",
      ticker: "HUND",
      side: "long",
      collateralCents: 500,
      leverage: 20
    })

    const shortOpen = try openPerpPosition({
      ownerId: "user-bob",
      ownerKind: "user",
      ticker: "HUND",
      side: "short",
      collateralCents: 500,
      leverage: 20
    })
    const shortClose = try closePerpPosition({
      ownerId: "user-bob",
      positionId: shortOpen.positionId
    })

    const aliceEconAfter = try getAccountEconomy("user-alice")
    const bobEconAfter = try getAccountEconomy("user-bob")
    const perpHistory = try getMarketPriceHistory("perp", "HUND", 20)
    const perpMarkets = try listPerpMarkets()
    const hundMarket = perpMarkets.find((m) => m.ticker === "HUND")

    // spec/markets/spotPerp.md, "Opening a perp enforces the 20x leverage cap and updates only the mark premium"
    const heldLong = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "HUND",
      side: "long",
      collateralCents: 1_000,
      leverage: 10
    })
    try TestClock.adjust(Duration.seconds(3_600))
    const quietSpotBuy = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "HUND",
      side: "buy",
      quoteCents: 200
    })
    try TestClock.adjust(Duration.seconds(3_600))
    const balancingShort = try openPerpPosition({
      ownerId: "user-bob",
      ownerKind: "user",
      ticker: "HUND",
      side: "short",
      collateralCents: 1_000,
      leverage: 10
    })
    try TestClock.adjust(Duration.seconds(23 * 3_600 + 1_800))
    const hundAfterPremiumClosed = (try listPerpMarkets()).find((m) => m.ticker === "HUND")
    const hundDetailAfterPremiumClosed = try getPerpMarket("HUND")
    try TestClock.adjust(Duration.seconds(3_600))
    const hundFlatForADay = try getPerpMarket("HUND")

    try check(() => assert.deepStrictEqual(
      {
        nonNpcCode,
        sellWithoutInventoryCode,
        smallSpotBuy: [smallSpotBuy.baseDelta, smallSpotBuy.indexPriceCents, toInt(holdingAfterBuy[0]?.base_units)],
        smallSpotSellReducedIndex: smallSpotSell.indexPriceCents < smallSpotBuy.indexPriceCents,
        previewMatchesLongOpen: [
          longPreview.action,
          longPreview.executionPriceCents === longOpen.executionPriceCents,
          longPreview.feeCents === longOpen.feeCents,
          longPreview.estimatedLiquidationPriceCents === longOpen.position.liquidationPriceCents,
          longPreview.priceImpactBps > 0
        ],
        longFillsPostImpactAndLosesOnRoundTrip: [
          longOpen.executionPriceCents > smallSpotSell.indexPriceCents,
          longClose.exitPriceCents === smallSpotSell.indexPriceCents,
          longClose.balanceAfterCents < INITIAL_GRANT_CENTS,
          longClose.realizedPnlCents === aliceEconAfter.balanceCents - INITIAL_GRANT_CENTS
        ],
        shortFillsPostImpactAndLosesOnRoundTrip: [
          shortOpen.executionPriceCents < smallSpotSell.indexPriceCents,
          shortClose.exitPriceCents === smallSpotSell.indexPriceCents,
          shortClose.balanceAfterCents < INITIAL_GRANT_CENTS,
          shortClose.realizedPnlCents === bobEconAfter.balanceCents - INITIAL_GRANT_CENTS
        ],
        historyRecorded: perpHistory.length >= 6,
        hundVolumeRecorded: (hundMarket?.volumeCents ?? 0) === 40_000,
        markDayAgoAndNow: [
          heldLong.position.markPriceCents,
          quietSpotBuy.indexPriceCents,
          quietSpotBuy.markPriceCents,
          balancingShort.position.markPriceCents,
          hundAfterPremiumClosed?.markPriceCents
        ],
        change24hAfterPremiumClosed: [hundAfterPremiumClosed?.change24hPct, hundDetailAfterPremiumClosed.change24hPct],
        change24hOnceFlatForADay: [hundFlatForADay.markPriceCents, hundFlatForADay.change24hPct]
      },
      {
        nonNpcCode: "FORBIDDEN_NON_NPC",
        sellWithoutInventoryCode: "INSUFFICIENT_SPOT_INVENTORY",
        smallSpotBuy: [24, 10_009, 24],
        smallSpotSellReducedIndex: true,
        previewMatchesLongOpen: ["open", true, true, true, true],
        longFillsPostImpactAndLosesOnRoundTrip: [true, true, true, true],
        shortFillsPostImpactAndLosesOnRoundTrip: [true, true, true, true],
        historyRecorded: true,
        hundVolumeRecorded: true,
        markDayAgoAndNow: [10_505, 10_006, 10_506, 10_006, 10_006],
        change24hAfterPremiumClosed: [-4.76, -4.76],
        change24hOnceFlatForADay: [10_006, 0]
      }
    ))
  })
)

it.effect('Perp add, partial close, reduce, flip, 8h funding, and cascading liquidation with SSE + notifications (spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/markets/spotPerp.md, "Story: 8-hour funding accrual and mark-price liquidation")', () => effect {
  try TestClock.setTime(Date.UTC(2026, 10, 19, 1, 0, 0))
  try runWithSeededDb(effect {
    const store = try Store
    try createVerifiedAccount("user-alice", "alice", 50_000)
    try createVerifiedAccount("user-bob", "bob", 50_000)

    const initialXtrpc = try getPerpMarket("XTRPC")
    const overLeverageCode = try marketErrorCode(openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 1_000,
      leverage: 21
    }))
    const slippageBlockedCode = try marketErrorCode(openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 1_000,
      leverage: 10,
      maxSlippageBps: 100
    }))

    const opened = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 1_000,
      leverage: 5
    })
    const addPreview = try previewPerpOrder({
      ownerId: "user-alice",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 1_000,
      leverage: 5
    })
    const added = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 1_000,
      leverage: 5
    })
    const partialClose = try closePerpPosition({
      ownerId: "user-alice",
      positionId: added.positionId,
      closePct: 40
    })
    const reduced = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "short",
      collateralCents: 400,
      leverage: 5
    })
    const flipPreview = try previewPerpOrder({
      ownerId: "user-alice",
      ticker: "XTRPC",
      side: "short",
      collateralCents: 2_000,
      leverage: 5
    })
    const flipSlippageBlockedCode = try marketErrorCode(openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "short",
      collateralCents: 2_000,
      leverage: 5,
      maxSlippageBps: 600
    }))
    const modeFlipPreview = try previewPerpOrder({
      ownerId: "user-alice",
      ticker: "XTRPC",
      side: "short",
      collateralCents: 2_000,
      leverage: 5,
      mode: "flip"
    })
    const modeFlipSlippageBlockedCode = try marketErrorCode(openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "short",
      collateralCents: 2_000,
      leverage: 5,
      mode: "flip",
      maxSlippageBps: 600
    }))
    const heldAfterBlockedModeFlip = try listPerpPositions("user-alice")
    const flipped = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "short",
      collateralCents: 2_000,
      leverage: 5,
      maxSlippageBps: flipPreview.priceImpactBps
    })

    // spec/markets/spotPerp.md, "UTC time advances across 8-hour funding boundaries, and funding skips pre-cutover or duplicate periods"
    try TestClock.adjust(Duration.seconds(2 * 3_600))
    const samePeriodTime = try Clock.currentTimeMillis
    const samePeriodFunding = try accruePerpFunding()
    try TestClock.adjust(Duration.seconds(6 * 3_600))
    const nextPeriodFunding = try accruePerpFunding()
    const marketAfterFunding = try getPerpMarket("XTRPC")
    try TestClock.adjust(Duration.seconds(3_600))
    const duplicatePeriodFunding = try accruePerpFunding()
    const marketAfterDuplicateFunding = try getPerpMarket("XTRPC")
    try accruePerpFunding(samePeriodTime)
    const marketAfterStaleFunding = try getPerpMarket("XTRPC")
    const aliceHeldAfterFunding = try listPerpPositions("user-alice")

    const bobLong = try openPerpPosition({
      ownerId: "user-bob",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 500,
      leverage: 20
    })
    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        "UPDATE feed_perp_markets SET index_price_cents = 500, mark_price_cents = 500 WHERE ticker = 'XTRPC'"
      )
    })
    const publishedEvents: Array<MarketPerpRealtimeEvent> = []
    const busLayer = Layer.succeed(MarketRealtimeBus, {
      publish: (event: MarketPerpRealtimeEvent) => Effect.sync(() => {
        publishedEvents.push(event)
        return true
      })
    })
    const liqSummary = try effect {
      provide busLayer {
        return try liquidateEligiblePositions()
      }
    }
    const bobNotifs = try store.transaction((tx: Tx) =>
      tx.query("SELECT kind, title, market_id FROM feed_notifications WHERE account_id = 'user-bob' AND kind = 'perp_liquidated'")
    )
    const bobClosed = try listUserClosedPositions("user-bob")

    const modeFlipBackPreview = try previewPerpOrder({
      ownerId: "user-alice",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 2_000,
      leverage: 5,
      mode: "flip"
    })
    const modeFlippedBack = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 2_000,
      leverage: 5,
      mode: "flip",
      maxSlippageBps: modeFlipBackPreview.priceImpactBps
    })

    try check(() => assert.deepStrictEqual(
      {
        initialPrice: initialXtrpc.indexPriceCents,
        overLeverageCode,
        slippageBlockedCode,
        addFlow: [
          opened.action,
          addPreview.action,
          added.action,
          added.position.sizeCents,
          added.position.marginCents
        ],
        partialAndReduce: [
          partialClose.isFullClose,
          partialClose.sizeCents,
          partialClose.remainingSizeCents,
          reduced.action,
          reduced.position.sizeCents
        ],
        flipFlow: [
          flipPreview.action,
          flipPreview.priceImpactBps,
          flipSlippageBlockedCode,
          flipped.action,
          flipped.position.side,
          flipped.position.sizeCents,
          flipped.executionPriceCents === flipPreview.executionPriceCents,
          flipped.closedPositionId === opened.positionId
        ],
        modeFlipPreview: [
          modeFlipPreview.action,
          modeFlipPreview.executionPriceCents,
          modeFlipPreview.priceImpactBps,
          modeFlipPreview.feeCents
        ],
        modeFlipBlocked: [
          modeFlipSlippageBlockedCode,
          heldAfterBlockedModeFlip.length,
          heldAfterBlockedModeFlip[0]?.side,
          heldAfterBlockedModeFlip[0]?.sizeCents
        ],
        modeFlipBack: [
          modeFlipBackPreview.action,
          modeFlipBackPreview.executionPriceCents,
          modeFlipBackPreview.priceImpactBps,
          modeFlippedBack.action,
          modeFlippedBack.position.side,
          modeFlippedBack.position.sizeCents,
          modeFlippedBack.feeCents,
          modeFlippedBack.closedPositionId === flipped.positionId
        ],
        funding: [
          samePeriodFunding.accruedCount,
          nextPeriodFunding.accruedCount,
          duplicatePeriodFunding.accruedCount,
          aliceHeldAfterFunding.length,
          [marketAfterFunding.lastFundingPeriod, marketAfterDuplicateFunding.lastFundingPeriod, marketAfterStaleFunding.lastFundingPeriod],
          [marketAfterFunding.updatedAt, marketAfterDuplicateFunding.updatedAt, marketAfterStaleFunding.updatedAt]
        ],
        liquidation: [
          liqSummary.liquidatedCount,
          liqSummary.liquidatedPositionIds.includes(bobLong.positionId),
          publishedEvents.length,
          publishedEvents[0]?.action,
          publishedEvents[0]?.positionId === bobLong.positionId,
          bobNotifs.length,
          bobNotifs[0]?.market_id,
          bobClosed.perpPositions[0]?.status
        ]
      },
      {
        initialPrice: 1_200,
        overLeverageCode: "INVALID_LEVERAGE",
        slippageBlockedCode: "SLIPPAGE_EXCEEDED",
        addFlow: ["open", "add", "add", 10_000, 2_000],
        partialAndReduce: [false, 4_000, 6_000, "reduce", 4_000],
        flipFlow: ["flip", 952, "SLIPPAGE_EXCEEDED", "flip", "short", 6_000, true, true],
        modeFlipPreview: ["flip", 1_140, 952, 14],
        modeFlipBlocked: ["SLIPPAGE_EXCEEDED", 1, "long", 4_000],
        modeFlipBack: ["flip", 525, 1_053, "flip", "long", 10_000, 16, true],
        funding: [
          0,
          1,
          0,
          1,
          [nextPeriodFunding.period, nextPeriodFunding.period, nextPeriodFunding.period],
          [marketAfterFunding.updatedAt, marketAfterFunding.updatedAt, marketAfterFunding.updatedAt]
        ],
        liquidation: [1, true, 1, "liquidate", true, 1, "XTRPC", "liquidated"]
      }
    ))
  })
})

it.effect('Prediction guards, expiry filtering, idempotency, 0-share settlement, and resolved notifications (spec/markets/prediction.md, "Story: Open and trade a prediction market"; spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel")', () =>
  runWithSeededMarketDay(effect (now) => {
    const store = try Store
    try createVerifiedAccount("user-alice", "alice", 500_000)
    try createVerifiedAccount("user-bob", "bob", 500_000)
    try createVerifiedAccount("user-carol", "carol", 500_000)

    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        `INSERT INTO feed_prediction_markets
           (id, slot_index, question, description, category, timeframe, phase, yes_shares, no_shares, liquidity_cents, secret_outcome, status, resolved_outcome, resolution_proof, resolution_article_id, expires_at, resolved_at, created_at)
         VALUES
           ('mkt-expired', NULL, 'Expired still open?', 'desc', 'tech', '15m', 'open', 50000, 50000, 50000, 'YES', 'open', NULL, NULL, NULL, $1, NULL, $2),
           ('mkt-extreme-low', NULL, 'Extreme low market?', 'desc', 'tech', '15m', 'open', 99000, 1000, 100000, 'YES', 'open', NULL, NULL, NULL, $3, NULL, $2),
           ('mkt-sell-guard', NULL, 'Sell guard market?', 'desc', 'tech', '15m', 'open', 10000, 10000, 20000, 'YES', 'open', NULL, NULL, NULL, $3, NULL, $2)`,
        [now - 1_000, now - 60_000, now + 3_600_000]
      )
      try tx.query(
        `INSERT INTO feed_prediction_positions
           (market_id, holder_id, holder_kind, side, shares, cost_basis_cents, settled_at, payout_cents)
         VALUES
           ('mkt-extreme-low', 'user-alice', 'user', 'YES', 5000, 1000, NULL, 0),
           ('mkt-extreme-low', 'user-bob', 'user', 'NO', 5000, 4000, NULL, 0),
           ('mkt-extreme-low', 'user-carol', 'user', 'NO', 50000000, 400000, NULL, 0),
           ('mkt-sell-guard', 'user-alice', 'user', 'YES', 12000, 6000, NULL, 0)`
      )
    })

    const openMarkets = try listPredictionMarkets("open")
    const allMarkets = try listPredictionMarkets()

    const extremeWorsenBuyCode = try marketErrorCode(buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "no",
      amountCents: 100
    }))
    const extremeUnwindBuy = try buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "yes",
      amountCents: 100
    })

    const extremeWorsenSellCode = try marketErrorCode(sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "yes",
      shares: 500
    }))
    const extremeCrossCenterSellCode = try marketErrorCode(sellPredictionShares({
      actorId: "user-carol",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "no",
      shares: 50_000_000
    }))
    const extremeUnwindSell = try sellPredictionShares({
      actorId: "user-bob",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "no",
      shares: 500
    })
    const partialSellBlockedCode = try marketErrorCode(sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-sell-guard",
      side: "yes",
      shares: 11_000
    }))
    const fullExitSell = try sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-sell-guard",
      side: "yes",
      shares: 12_000
    })

    const idempotentBuy: BuyPredictionInput = {
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 1_000,
      idempotencyKey: "trade-key-1"
    }
    const idemBuy1 = try buyPredictionShares(idempotentBuy)
    const idemBuyReplay = try buyPredictionShares(idempotentBuy)
    const idemBuyConflictCode = try marketErrorCode(buyPredictionShares({ ...idempotentBuy, amountCents: 2_000 }))
    const idemOtherUserBuy = try buyPredictionShares({ ...idempotentBuy, actorId: "user-bob", side: "no" })
    const idempotentSell: SellPredictionInput = {
      actorId: idempotentBuy.actorId,
      actorKind: idempotentBuy.actorKind,
      marketId: idempotentBuy.marketId,
      side: idempotentBuy.side,
      shares: idemBuy1.shares,
      idempotencyKey: "trade-sell-1"
    }
    const idemSell1 = try sellPredictionShares(idempotentSell)
    const idemSellReplay = try sellPredictionShares(idempotentSell)
    const idemSellConflictCode = try marketErrorCode(sellPredictionShares({ ...idempotentSell, shares: 100 }))

    try buyPredictionShares({
      actorId: "user-carol",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 1_500
    })

    const resolved = try resolvePredictionMarket({ marketId: "seed-market-1" })
    const idemReplayAfterClose = try buyPredictionShares(idempotentBuy)
    const zeroSharePos = try store.transaction((tx: Tx) =>
      tx.query(
        "SELECT shares, settled_at FROM feed_prediction_positions WHERE market_id = 'seed-market-1' AND holder_id = 'user-alice' AND side = 'YES'"
      )
    )
    const notifications = try store.transaction((tx: Tx) =>
      tx.query(
        "SELECT account_id, kind, market_id, is_game_only FROM feed_notifications WHERE market_id = 'seed-market-1' ORDER BY account_id ASC"
      )
    )

    try check(() => assert.deepStrictEqual(
      {
        expiredExcludedFromOpen: openMarkets.some((m) => m.id === "mkt-expired"),
        expiredIncludedInAll: allMarkets.some((m) => m.id === "mkt-expired"),
        extremeWorsenBuyCode,
        extremeUnwindBuyImproved: extremeUnwindBuy.yesPriceBps > 100 && extremeUnwindBuy.yesPriceBps < 200,
        extremeWorsenSellCode,
        extremeCrossCenterSellCode,
        extremeUnwindSellImproved: extremeUnwindSell.yesPriceBps > extremeUnwindBuy.yesPriceBps,
        partialSellBlockedCode,
        fullExitMovedOverCap: Math.abs(fullExitSell.yesPriceBps - 5000) > 2000 && fullExitSell.yesPriceBps >= 200,
        idemBuyExactReplay: idemBuyReplay.tradeId === idemBuy1.tradeId && idemBuyReplay.balanceAfterCents === idemBuy1.balanceAfterCents,
        idemReplayAfterCloseMatches: idemReplayAfterClose.tradeId === idemBuy1.tradeId,
        idemBuyConflictCode,
        idemOtherUserSucceeded: idemOtherUserBuy.tradeId !== idemBuy1.tradeId,
        idemSellExactReplay: idemSellReplay.tradeId === idemSell1.tradeId,
        idemSellConflictCode,
        resolvedSettledCount: resolved.positionsSettled,
        aliceZeroShareNotSettled: [toInt(zeroSharePos[0]?.shares), zeroSharePos[0]?.settled_at],
        resolvedNotifications: notifications.map((row) => [row.account_id, row.kind, row.market_id, row.is_game_only])
      },
      {
        expiredExcludedFromOpen: false,
        expiredIncludedInAll: true,
        extremeWorsenBuyCode: "PRICE_IMPACT_EXCEEDED",
        extremeUnwindBuyImproved: true,
        extremeWorsenSellCode: "PRICE_IMPACT_EXCEEDED",
        extremeCrossCenterSellCode: "PRICE_IMPACT_EXCEEDED",
        extremeUnwindSellImproved: true,
        partialSellBlockedCode: "PRICE_IMPACT_EXCEEDED",
        fullExitMovedOverCap: true,
        idemBuyExactReplay: true,
        idemReplayAfterCloseMatches: true,
        idemBuyConflictCode: "IDEMPOTENCY_CONFLICT",
        idemOtherUserSucceeded: true,
        idemSellExactReplay: true,
        idemSellConflictCode: "IDEMPOTENCY_CONFLICT",
        resolvedSettledCount: 2,
        aliceZeroShareNotSettled: [0, null],
        resolvedNotifications: [
          ["user-bob", "market_resolved", "seed-market-1", true],
          ["user-carol", "market_resolved", "seed-market-1", true]
        ]
      }
    ))
  })
)

it.effect('Fixed $100 economy, slippage-aware MTM, leaderboard filtering, pagination, server-side metrics, early-sell win rate, and NPC characters board (spec/markets/economy.md, "Story: Trade with fixed starting capital and rank by net profit"; spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel")', () =>
  runWithSeededMarketDay(effect (now) => {
    const store = try Store
    for (const handle of ["alice", "bob", "carol", "dave"]) {
      try createVerifiedAccount(`user-${handle}`, handle, INITIAL_GRANT_CENTS)
    }

    try store.transaction(effect (tx: Tx) => {
      try tx.query("INSERT INTO organizations (id, name, credit_balance, created_at) VALUES ('org-deleted', 'Deleted', 0, $1)", [now])
      try tx.query("INSERT INTO organizations (id, name, credit_balance, created_at) VALUES ('org-reviewer', 'Reviewer', 0, $1)", [now])
      try tx.query("INSERT INTO organizations (id, name, credit_balance, created_at) VALUES ('org-unverified', 'Unverified', 0, $1)", [now])
      try tx.query(
        `INSERT INTO accounts (key, state, revision, organization_id, status, email, phone, name, created_at, updated_at) VALUES
           ('user-deleted', '{}'::jsonb, 1, 'org-deleted', 'erased', NULL, NULL, 'Deleted', $1, $1),
           ('user-reviewer', '{}'::jsonb, 1, 'org-reviewer', 'active', NULL, NULL, 'Reviewer', $1, $1),
           ('user-unverified', '{}'::jsonb, 1, 'org-unverified', 'active', NULL, NULL, 'Unverified', $1, $1)`,
        [now]
      )
      try tx.query(
        `INSERT INTO feed_accounts (${FEED_ACCOUNT_COLUMNS}) VALUES
           ('user-deleted', 'deleted_user', 'Deleted', '', NULL, NULL, NULL, $1, $1, 'game', 50000, 10000, 0, false, false, NULL, $1, $1),
           ('user-reviewer', 'reviewer1', 'Reviewer', '', NULL, NULL, NULL, $1, $1, 'game', 50000, 10000, 0, false, true, 'hash', $1, $1),
           ('user-unverified', 'unverified1', 'Unverified', '', NULL, NULL, NULL, NULL, $1, 'game', 50000, 10000, 0, false, false, NULL, $1, $1),
           ('user-ghost', 'ghost1', 'Ghost', '', NULL, NULL, NULL, $1, $1, 'game', 90000, 10000, 0, false, false, NULL, $1, $1)`,
        [now]
      )
    })

    const aliceOpenBuy = try buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 2_000
    })
    const bobPushBuy = try buyPredictionShares({
      actorId: "user-bob",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 4_000
    })

    const expectedAliceMtm = markToMarketPredictionCents(
      "yes",
      aliceOpenBuy.shares,
      bobPushBuy.market.yesShares,
      bobPushBuy.market.noShares
    )
    const aliceEconMtm = try getAccountEconomy("user-alice")
    const linearMidpointMtm = Math.floor((aliceOpenBuy.shares * bobPushBuy.yesPriceBps) / 10_000)

    const aliceEarlySell = try sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      shares: aliceOpenBuy.shares
    })

    // spec/markets/prediction.md, "Cancelled markets refund every open position at cost basis without publishing an outcome"
    try cancelPredictionMarket("seed-market-1")

    const page1 = try getLeaderboard({ scope: "players", metric: "net_profit", page: 1, pageSize: 2, viewerAccountId: "user-dave" })
    const page2 = try getLeaderboard({ scope: "players", metric: "net_profit", page: 2, pageSize: 2 })
    const byVolume = try getLeaderboard({ scope: "players", metric: "volume", page: 1, pageSize: 10 })
    const byWinRate = try getLeaderboard({ scope: "players", metric: "win_rate", page: 1, pageSize: 10 })
    const daveRank = try getAccountLeaderboardRank("user-dave", "net_profit", 2)

    try buyPredictionShares({
      actorId: "ailon-musk",
      actorKind: "npc",
      marketId: "seed-market-2",
      side: "yes",
      amountCents: 5_000
    })
    try resolvePredictionMarket({ marketId: "seed-market-2" })
    try store.transaction(effect (tx: Tx) => {
      try tx.query("UPDATE feed_actors SET profile_image_url = NULL WHERE id = 'eric-weinstain'")
      try tx.query("INSERT INTO organizations (id, name, credit_balance, created_at) VALUES ('org-email-only', 'Email Only', 0, $1) ON CONFLICT (id) DO NOTHING", [now])
      try tx.query(
        `INSERT INTO accounts (key, state, revision, organization_id, status, email, phone, name, created_at, updated_at)
         VALUES ('user-email-only', '{}'::jsonb, 1, 'org-email-only', 'active', NULL, NULL, 'Email Only', $1, $1)
         ON CONFLICT (key) DO NOTHING`,
        [now]
      )
      try tx.query(
        `INSERT INTO feed_accounts (account_id, handle, display_name, phone_hash, phone_last2, phone_verified_at, email_hash, email_masked, email_verified_at, age_confirmed_at, ui_mode, balance_cents, starting_grant_cents, total_fees_paid_cents, is_admin, is_reviewer, created_at, updated_at)
         VALUES ('user-email-only', 'emailonly', 'Email Only', NULL, NULL, NULL, 'hash-email-only', 'e***@example.com', $1, $1, 'game', 10000, 10000, 0, false, false, $1, $1)
         ON CONFLICT (account_id) DO NOTHING`,
        [now]
      )
    })
    const emailEconomy = try getAccountEconomy("user-email-only")
    const emailBoard = try getLeaderboard({ scope: "players", metric: "net_profit", page: 1, pageSize: 20, viewerAccountId: "user-email-only" })
    const npcBoard = try getLeaderboard({ scope: "characters", metric: "net_profit", page: 1, pageSize: 200 })
    const ericEntry = npcBoard.entries.find((e) => e.accountId === "eric-weinstain")
    const politaicoEntry = npcBoard.entries.find((e) => e.accountId === "org-politaico")

    try store.transaction((tx: Tx) =>
      tx.query("UPDATE feed_accounts SET balance_cents = 5000 WHERE account_id = 'user-carol'")
    )
    const boardFinal = try getLeaderboard()
    try check(() => assert.deepStrictEqual(
      {
        fixedStartingGrant: [aliceEconMtm.startingGrantCents, Object.prototype.hasOwnProperty.call(aliceEconMtm, "purchasedCents")],
        slippageAwareMtm: [
          aliceEconMtm.positionValueCents === expectedAliceMtm,
          expectedAliceMtm <= linearMidpointMtm
        ],
        earlySellProfitable: (aliceEarlySell.realizedPnlCents ?? 0) > 0,
        filteredEligiblePlayers: [
          page1.totalCount,
          page1.totalPages,
          page1.entries.length,
          page2.entries.length,
          [...page1.entries, ...page2.entries].map((e) => e.accountId).every((id) =>
            id !== "user-deleted" && id !== "user-reviewer" && id !== "user-unverified" && id !== "user-ghost"
          )
        ],
        emailVerifiedEligible: [
          emailEconomy.verified,
          emailBoard.entries.some((e) => e.accountId === "user-email-only"),
          emailBoard.currentUser?.accountId
        ],
        sharedTiedRankForZeroProfitPlayers: [
          page1.entries[0]?.accountId,
          page1.entries[0]?.rank,
          page1.entries[1]?.rank,
          page2.entries[0]?.rank,
          page2.entries[1]?.rank,
          page1.currentUser?.accountId,
          page1.currentUser?.rank,
          daveRank?.rank,
          daveRank?.page
        ],
        serverSideMetricSorting: [
          byVolume.entries[0]?.accountId,
          byWinRate.entries[0]?.accountId,
          byWinRate.entries[0]?.winRatePct,
          byWinRate.entries[0]?.wins,
          byWinRate.entries[0]?.settledCount
        ],
        charactersBoard: [
          npcBoard.scope,
          npcBoard.totalCount > 0,
          npcBoard.entries[0]?.isNpc,
          npcBoard.entries[0]?.accountId,
          (npcBoard.entries[0]?.netProfitCents ?? 0) > 0,
          ericEntry?.avatarUrl,
          ericEntry?.handle,
          politaicoEntry === undefined
    ],
    tiedRanksShareRankTwo: boardFinal.entries.map((entry) => [entry.accountId, entry.rank])
          },
      {
        fixedStartingGrant: [10_000, false],
        slippageAwareMtm: [true, true],
        earlySellProfitable: true,
        filteredEligiblePlayers: [4, 2, 2, 2, true],
        emailVerifiedEligible: [true, true, "user-email-only"],
        sharedTiedRankForZeroProfitPlayers: ["user-alice", 1, 2, 2, 2, "user-dave", 2, 2, 2],
        serverSideMetricSorting: ["user-alice", "user-alice", 100, 1, 1],
        charactersBoard: [
          "characters",
          true,
          true,
          "ailon-musk",
          true,
          "/images/actors/eric-weinstain.jpg",
          "ericrweinstain",
      true
    ],
    tiedRanksShareRankTwo: [["user-alice", 1], ["user-bob", 2], ["user-dave", 2], ["user-email-only", 2], ["user-carol", 5]]
      }
    ))
  })
)

it.effect('Open positions stop marking expired prediction markets to market (spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel"; spec/markets/economy.md, "Story: Trade with fixed starting capital and rank by net profit")', () =>
  runWithSeededMarketDay(effect (now) => {
    try createVerifiedAccount("user-alice", "alice", INITIAL_GRANT_CENTS)
    const buy = try buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 2_000
    })
    const expectedMtm = markToMarketPredictionCents("yes", buy.shares, buy.market.yesShares, buy.market.noShares)
    const expectedProfitBefore = expectedMtm - 2_000
    const expectedProfitAfter = -2_000
    const beforeExpiry = try getUserPositions("user-alice")
    const beforeItem = beforeExpiry.predictionPositions[0]
    const econBefore = try getAccountEconomy("user-alice")
    const boardBefore = try getLeaderboard()
    const boardBeforeAlice = boardBefore.entries.find((e) => e.accountId === "user-alice")
    const board7dBefore = try getFilteredLeaderboardPage({ timeframe: "7d", viewerAccountId: "user-alice" })
    const board7dBeforeAlice = board7dBefore.currentUser
    const board30dBefore = try getFilteredLeaderboardPage({ timeframe: "30d", viewerAccountId: "user-alice" })
    const board30dBeforeAlice = board30dBefore.currentUser
    try check(() => assert.deepStrictEqual(
      {
        listedBeforeExpiry: beforeExpiry.predictionPositions.length,
        estimatedBeforeExpiry: beforeItem?.estimatedValueCents,
        expectedMtm,
        estimatedMatchesMtmBeforeExpiry: beforeItem?.estimatedValueCents === expectedMtm,
        mtmPositiveBeforeExpiry: (beforeItem?.estimatedValueCents ?? 0) > 0,
        econBeforeExpiry: econBefore.positionValueCents,
        boardBeforeExpiry: boardBeforeAlice?.positionValueCents,
        econProfitBeforeExpiry: econBefore.netProfitCents,
        boardProfitBeforeExpiry: boardBeforeAlice?.netProfitCents,
        board7dProfitBeforeExpiry: board7dBeforeAlice?.netProfitCents,
        board30dProfitBeforeExpiry: board30dBeforeAlice?.netProfitCents
      },
      {
        listedBeforeExpiry: 1,
        estimatedBeforeExpiry: expectedMtm,
        expectedMtm,
        estimatedMatchesMtmBeforeExpiry: true,
        mtmPositiveBeforeExpiry: true,
        econBeforeExpiry: expectedMtm,
        boardBeforeExpiry: expectedMtm,
        econProfitBeforeExpiry: expectedProfitBefore,
        boardProfitBeforeExpiry: expectedProfitBefore,
        board7dProfitBeforeExpiry: expectedProfitBefore,
        board30dProfitBeforeExpiry: expectedProfitBefore
      }
    ))
    try TestClock.adjust(Duration.millis(buy.market.expiresAt - now))
    const atExpiry = try getUserPositions("user-alice")
    const atItem = atExpiry.predictionPositions[0]
    const econAt = try getAccountEconomy("user-alice")
    const boardAt = try getLeaderboard()
    const boardAtAlice = boardAt.entries.find((e) => e.accountId === "user-alice")
    const board7dAt = try getFilteredLeaderboardPage({ timeframe: "7d", viewerAccountId: "user-alice" })
    const board7dAtAlice = board7dAt.currentUser
    const board30dAt = try getFilteredLeaderboardPage({ timeframe: "30d", viewerAccountId: "user-alice" })
    const board30dAtAlice = board30dAt.currentUser
    try check(() => assert.deepStrictEqual(
      {
        stillListedAtExpiry: atExpiry.predictionPositions.length,
        sharesAtExpiry: atItem?.shares,
        marketStatusAtExpiry: atItem?.marketStatus,
        estimatedAtExpiry: atItem?.estimatedValueCents,
        econAtExpiry: econAt.positionValueCents,
        boardAtExpiry: boardAtAlice?.positionValueCents,
        econProfitAtExpiry: econAt.netProfitCents,
        boardProfitAtExpiry: boardAtAlice?.netProfitCents,
        board7dProfitAtExpiry: board7dAtAlice?.netProfitCents,
        board30dProfitAtExpiry: board30dAtAlice?.netProfitCents
      },
      {
        stillListedAtExpiry: 1,
        sharesAtExpiry: buy.shares,
        marketStatusAtExpiry: "open",
        estimatedAtExpiry: 0,
        econAtExpiry: 0,
        boardAtExpiry: 0,
        econProfitAtExpiry: expectedProfitAfter,
        boardProfitAtExpiry: expectedProfitAfter,
        board7dProfitAtExpiry: expectedProfitAfter,
        board30dProfitAtExpiry: expectedProfitAfter
      }
    ))
    try TestClock.adjust(Duration.seconds(24 * 86_400))
    const afterExpiry = try getUserPositions("user-alice")
    const afterItem = afterExpiry.predictionPositions[0]
    const econAfter = try getAccountEconomy("user-alice")
    const boardAfter = try getLeaderboard()
    const boardAfterAlice = boardAfter.entries.find((e) => e.accountId === "user-alice")
    const board7dAfter = try getFilteredLeaderboardPage({ timeframe: "7d", viewerAccountId: "user-alice" })
    const board7dAfterAlice = board7dAfter.currentUser
    const board30dAfter = try getFilteredLeaderboardPage({ timeframe: "30d", viewerAccountId: "user-alice" })
    const board30dAfterAlice = board30dAfter.currentUser
    try check(() => assert.deepStrictEqual(
      {
        stillListedAfterExpiry: afterExpiry.predictionPositions.length,
        sharesAfterExpiry: afterItem?.shares,
        marketStatusAfterExpiry: afterItem?.marketStatus,
        estimatedAfterExpiry: afterItem?.estimatedValueCents,
        econAfterExpiry: econAfter.positionValueCents,
        boardAfterExpiry: boardAfterAlice?.positionValueCents,
        econProfitAfterExpiry: econAfter.netProfitCents,
        boardProfitAfterExpiry: boardAfterAlice?.netProfitCents,
        board7dProfitAfterExpiry: board7dAfterAlice?.netProfitCents,
        board30dProfitAfterExpiry: board30dAfterAlice?.netProfitCents
      },
      {
        stillListedAfterExpiry: 1,
        sharesAfterExpiry: buy.shares,
        marketStatusAfterExpiry: "open",
        estimatedAfterExpiry: 0,
        econAfterExpiry: 0,
        boardAfterExpiry: 0,
        econProfitAfterExpiry: expectedProfitAfter,
        boardProfitAfterExpiry: expectedProfitAfter,
        board7dProfitAfterExpiry: expectedProfitAfter,
        board30dProfitAfterExpiry: expectedProfitAfter
      }
    ))
  })
)

it.effect('The perp price chart counts each NPC spot trade once, matching its traded volume (spec/markets/spotPerp.md, "Story: NPC spot trades drive the index price")', () =>
  runWithSeededMarketDay(effect (now) => {
    try seedHundredCorpMarket(now)
    const buy = try executeNpcSpotTrade({ actorId: "ailon-musk", ticker: "HUND", side: "buy", quoteCents: 2_500 })
    try TestClock.adjust("1 minute")
    const sell = try executeNpcSpotTrade({ actorId: "ailon-musk", ticker: "HUND", side: "sell", quoteCents: 1_000 })
    const traded = (range: "1D" | "ALL") => effect {
      const history = try getPerpPriceHistory({ ticker: "HUND", range })
      return history.points.filter((p) => p.volumeCents > 0).map((p) => [p.volumeCents, p.indexPriceCents])
    }
    const day = try traded("1D")
    const all = try traded("ALL")
    try check(() => assert.deepStrictEqual(
      { day, all },
      { day: [[2_500, buy.indexPriceCents], [1_000, sell.indexPriceCents]], all: [[2_500, buy.indexPriceCents], [1_000, sell.indexPriceCents]] }
    ))
  })
)

it.effect('Adding to a perp keeps the unrealized P&L of both legs, so a short gains nothing by adding (spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/markets/spotPerp.md, "Opening a perp enforces the 20x leverage cap and updates only the mark premium")', () =>
  runWithSeededMarketDay(effect (now) => {
    try createVerifiedAccount("user-bob", "bob", INITIAL_GRANT_CENTS)
    try createVerifiedAccount("user-carol", "carol", INITIAL_GRANT_CENTS)
    try seedHundredCorpMarket(now)
    const legs = (side: "long" | "short", ownerId: string) =>
      openPerpPosition({ ownerId, ownerKind: "user", ticker: "HUND", side, collateralCents: 1_000, leverage: 20 })
    const shortFirst = try legs("short", "user-bob")
    const longFirst = try legs("long", "user-carol")
    for (let i = 0; i < 4; i += 1) {
      try executeNpcSpotTrade({ actorId: "ailon-musk", ticker: "HUND", side: "buy", quoteCents: 100_000 })
    }
    const shortAdded = try legs("short", "user-bob")
    const longAdded = try legs("long", "user-carol")
    const mark = longAdded.executionPriceCents
    const legPnl = (side: "long" | "short", size: number, entry: number) =>
      Math.floor((side === "long" ? size * (mark - entry) : size * (entry - mark)) / entry)
    const summary = (side: "long" | "short", first: typeof shortFirst, added: typeof shortFirst) => {
      const size = first.position.sizeCents
      const harmonic = (2 * size * first.executionPriceCents * added.executionPriceCents) / (size * added.executionPriceCents + size * first.executionPriceCents)
      return {
        entry: added.position.entryPriceCents,
        harmonicEntry: side === "long" ? Math.ceil(harmonic) : Math.floor(harmonic),
        pnlGainFromAdding: legPnl(side, 2 * size, added.position.entryPriceCents) - legPnl(side, size, first.executionPriceCents) - legPnl(side, size, added.executionPriceCents) > 1
      }
    }
    const short = summary("short", shortFirst, shortAdded)
    const long = summary("long", longFirst, longAdded)
    try check(() => {
      assert.isTrue(shortAdded.executionPriceCents > shortFirst.executionPriceCents * 1.1)
      assert.deepStrictEqual(
        { short: [short.entry, short.pnlGainFromAdding], long: [long.entry, long.pnlGainFromAdding] },
        { short: [short.harmonicEntry, false], long: [long.harmonicEntry, false] }
      )
    })
  })
)

it.effect('Closed perp positions report payout equal to cash credited with open fees in cost basis (spec/shared/money.md, "Every trade pays a 0.1% fee rounded up to whole cents on the settled amount"; spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage")', () =>
  runWithSeededMarketDay(effect (now) => {
    try seedAliceHundredDay(now)

    const { close: longClose } = try openAndCloseUserPerp({
      ownerId: "user-alice",
      ticker: "HUND",
      side: "long",
      collateralCents: 500,
      leverage: 20
    })
    const closed = try listClosedPositions({ accountId: "user-alice" })
    const ledger = try getPointLedger("user-alice", 10)
    const closeLedgerDelta = ledger.find((entry) => entry.kind === "perp_close")?.deltaCents ?? null
    const item = closed.items[0]

    try check(() => assert.deepStrictEqual(
      {
        ...closedPerpPayoutSummary(closed),
        payoutEqualsCashCredited: item?.payoutCents === longClose.netCreditCents,
        payoutEqualsLedgerCloseCredit: item?.payoutCents === closeLedgerDelta,
        payoutMinusCostEqualsRealizedPnl: (item?.payoutCents ?? 0) - (item?.costBasisCents ?? 0) === item?.realizedPnlCents,
        realizedMatchesReceipt: item?.realizedPnlCents === longClose.realizedPnlCents
      },
      {
        totalCount: 1,
        itemKind: "perp",
        itemTicker: "HUND",
        itemSide: "long",
        itemCostBasisCents: 510,
        itemPayoutCents: longClose.netCreditCents,
        itemRealizedPnlCents: longClose.realizedPnlCents,
        payoutEqualsCashCredited: true,
        payoutEqualsLedgerCloseCredit: true,
        payoutMinusCostEqualsRealizedPnl: true,
        realizedMatchesReceipt: true
      }
    ))

    // spec/markets/economy.md, "Initial grants are fixed at 100 pts, balances stay non-negative, and net profit excludes only the starting grant"
    const heldShort = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "HUND",
      side: "short",
      collateralCents: 400,
      leverage: 10
    })
    const profitWithOpenPerp = longClose.realizedPnlCents - heldShort.feeCents
    const boardProfits = effect () => {
      const profits: Array<number | undefined> = [(try getAccountEconomy("user-alice")).netProfitCents]
      for (const timeframe of ["all", "24h", "7d", "30d"] as const) {
        profits.push((try getFilteredLeaderboardPage({ timeframe, viewerAccountId: "user-alice" })).currentUser?.netProfitCents)
      }
      return profits
    }
    const profitsWhileOpen = try boardProfits()
    const shortClose = try closePerpPosition({ ownerId: "user-alice", positionId: heldShort.positionId })
    const profitAfterClose = longClose.realizedPnlCents + shortClose.realizedPnlCents
    const profitsAfterClose = try boardProfits()

    try check(() => assert.deepStrictEqual(
      {
        heldShortOpenFeeAndEquity: [heldShort.feeCents, heldShort.position.equityCents],
        profitsWhileOpen,
        profitsAfterClose
      },
      {
        heldShortOpenFeeAndEquity: [4, 400],
        profitsWhileOpen: [profitWithOpenPerp, profitWithOpenPerp, profitWithOpenPerp, profitWithOpenPerp, profitWithOpenPerp],
        profitsAfterClose: [profitAfterClose, profitAfterClose, profitAfterClose, profitAfterClose, profitAfterClose]
      }
    ))
  })
)

it.effect('Flipping a perp does not count the new leg in the closed leg cost basis in listClosedPositions (spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage")', () =>
  runWithSeededMarketDay(effect (now) => {
    try seedAliceHundredDay(now)
    const opened = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "HUND",
      side: "long",
      collateralCents: 500,
      leverage: 20
    })
    try TestClock.adjust(Duration.seconds(3_600))
    const flipped = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "HUND",
      side: "short",
      collateralCents: 1000,
      leverage: 20,
      mode: "flip"
    })
    const ledger = try getPointLedger("user-alice", 10)
    const closeLedgerDelta = ledger.find((entry) => entry.kind === "perp_close")?.deltaCents ?? null
    const closed = try listClosedPositions({ accountId: "user-alice" })
    const item = closed.items[0]
    try check(() => assert.deepStrictEqual(
      {
        ...closedPerpPayoutSummary(closed),
        closedPositionIdMatches: flipped.closedPositionId,
        payoutEqualsCashCredited: item?.payoutCents === closeLedgerDelta,
        payoutMinusCostEqualsRealizedPnl: (item?.payoutCents ?? 0) - (item?.costBasisCents ?? 0) === item?.realizedPnlCents,
        realizedMatchesFlipReceipt: item?.realizedPnlCents === flipped.realizedPnlCents
      },
      {
        totalCount: 1,
        itemKind: "perp",
        itemTicker: "HUND",
        itemSide: "long",
        itemCostBasisCents: 510,
        itemPayoutCents: closeLedgerDelta,
        itemRealizedPnlCents: flipped.realizedPnlCents,
        closedPositionIdMatches: opened.positionId,
        payoutEqualsCashCredited: true,
        payoutMinusCostEqualsRealizedPnl: true,
        realizedMatchesFlipReceipt: true
      }
    ))
    try TestClock.adjust(Duration.seconds(3_600))
    const shortClose = try closePerpPosition({
      ownerId: "user-alice",
      positionId: flipped.positionId
    })
    const ledgerAfter = try getPointLedger("user-alice", 10)
    const shortCloseDelta = ledgerAfter.find((entry) => entry.kind === "perp_close")?.deltaCents ?? null
    const closedAfter = try listClosedPositions({ accountId: "user-alice" })
    const shortItem = closedAfter.items.find((entry) => entry.side === "short")
    try check(() => assert.deepStrictEqual(
      {
        totalClosedCount: closedAfter.totalCount,
        shortCostBasisCents: shortItem?.costBasisCents,
        shortPayoutCents: shortItem?.payoutCents,
        shortPayoutEqualsCashCredited: shortItem?.payoutCents === shortCloseDelta,
        shortPayoutMinusCostEqualsRealizedPnl: (shortItem?.payoutCents ?? 0) - (shortItem?.costBasisCents ?? 0) === shortItem?.realizedPnlCents,
        shortRealizedMatchesReceipt: shortItem?.realizedPnlCents === shortClose.realizedPnlCents
      },
      {
        totalClosedCount: 2,
        shortCostBasisCents: 1020,
        shortPayoutCents: shortCloseDelta,
        shortPayoutEqualsCashCredited: true,
        shortPayoutMinusCostEqualsRealizedPnl: true,
        shortRealizedMatchesReceipt: true
      }
    ))
  })
)

