it.effect('Cancelled prediction positions read cancelled in listClosedPositions (spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel")', () =>
  runWithSeededMarketDay(effect (_now) => {
    try createVerifiedAccount("user-bob", "bob", INITIAL_GRANT_CENTS)
