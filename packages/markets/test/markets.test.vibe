// spec/markets/prediction.md, "Story: Open and trade a prediction market"; spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel"; spec/markets/spotPerp.md, "Story: NPC spot trades drive the index price"; spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/markets/spotPerp.md, "Story: 8-hour funding accrual and mark-price liquidation"; spec/markets/economy.md, "Story: Buy points on web outside Washington, and play anywhere"
import { assert, it } from "@effect/vitest"
import { Store, StoreFailure, migrateFeedSchema, seedFeedWorld, toInt, type Tx } from "@repo/db"
import { localStoreLayer } from "@repo/db/node"
import { HttpClient, HttpClientResponse } from "effect/http"
import { TestClock } from "effect/testing"
import {
  MarketFailure,
  accruePerpFunding,
  buyPredictionShares,
  cancelPredictionMarket,
  closePerpPosition,
  createStripeCheckoutSession,
  executeNpcSpotTrade,
  getAccountEconomy,
  getLeaderboard,
  getPerpMarket,
  getPointLedger,
  getPredictionMarket,
  getUserPositions,
  handleStripeWebhook,
  listPerpPositions,
  listPredictionMarkets,
  openPerpPosition,
  resolvePredictionMarket,
  sellPredictionShares,
  type BuyPredictionInput,
  type SellPredictionInput
} from "../src/index.vibe"

module node {
  import { createHmac } from "node:crypto"

  /** @throws {never} */
  export function signStripeWebhook(rawBody: string, secret: string, timestampSec: number): string {
    const signature = createHmac("sha256", secret).update(`${timestampSec}.${rawBody}`).digest("hex")
    return `t=${timestampSec},v1=${signature}`
  }

  /** @throws {never} */
  export function jsonResponse(body: string, status: number): Response {
    return new Response(body, { status, headers: { "content-type": "application/json" } })
  }
}
import { jsonResponse, signStripeWebhook } from node

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function runWithSeededDb<A, E>(body: A!E!Store) {
  provide localStoreLayer({ kind: "pglite", file: undefined }) {
    try migrateFeedSchema()
    try seedFeedWorld()
    return try body
  }
}

const FEED_ACCOUNT_COLUMNS = `account_id, handle, display_name, bio, avatar_url, phone_hash, phone_last2,
  phone_verified_at, age_confirmed_at, ui_mode, balance_cents, starting_grant_cents,
  purchased_cents, total_fees_paid_cents, is_admin, is_reviewer, reviewer_password_hash,
  created_at, updated_at`

effect function createVerifiedAccount(accountId: string, handle: string, balanceCents = 10_000): void!StoreFailure!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  try store.transaction(effect (tx: Tx) => {
    try tx.query(
      `INSERT INTO feed_accounts (${FEED_ACCOUNT_COLUMNS}) VALUES ($1, $2, $3, '', NULL, $4, '01', $5, $5, 'game', $6, $6, 0, 0, false, false, NULL, $5, $5)`,
      [accountId, handle, handle, `phone-hash-${accountId}`, now, balanceCents]
    )
  })
}

effect function marketErrorCode<A, R>(program: A!(MarketFailure | StoreFailure)!R): string!!R {
  return effect {
    try program
    return "NONE"
  } catch (error) => match (error) {
    when MarketFailure: error.code;
    when StoreFailure: `STORE:${error.operation}`;
  }
}

it.effect('Prediction market lifecycle: omits secretOutcome while open, CPMM buy/sell, 1 pt winning payout per whole share, and idempotent resolution (spec/markets/prediction.md, "Story: Open and trade a prediction market"; spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel")', () => effect {
  try TestClock.setTime(Date.UTC(2026, 10, 19, 12, 0, 0))
  try runWithSeededDb(effect {
    // spec/markets/prediction.md, "Hidden outcome and prepared proof are never visible before resolution"
    const openView = try getPredictionMarket("seed-market-1")
    try createVerifiedAccount("user-alice", "alice", 10_000)
    try createVerifiedAccount("user-bob", "bob", 10_000)

    // spec/markets/prediction.md, "Buying YES or NO shares requires an open non-expired market, sufficient balance, and bounded odds impact"
    const aliceBuy = try buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 2_000
    })
    const bobBuy = try buyPredictionShares({
      actorId: "user-bob",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "no",
      amountCents: 1_000
    })

    // spec/markets/prediction.md, "Selling shares floors gross proceeds to whole cents before charging the canonical fee"
    const sharesToSell = 1_000 + (aliceBuy.shares % 100)
    const aliceSell = try sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      shares: sharesToSell
    })
    const remainingShares = aliceBuy.shares - sharesToSell
    const positionsBeforeResolve = try getUserPositions("user-alice")

    // spec/markets/prediction.md, "Resolved, cancelled, held, and expired markets allow no trades, and duplicate resolution pays nothing extra"
    try TestClock.adjust(Duration.seconds(4 * 86_400))
    const expiredBuyCode = try marketErrorCode(buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 100
    }))

    // spec/markets/prediction.md, "Resolution declassifies the hidden outcome, publishes the proof, and pays 1 pt (100 cents) per winning share idempotently"
    const resolved = try resolvePredictionMarket({
      marketId: "seed-market-1",
      proofSummary: "OpenAGI published frontier compute pricing."
    })
    const aliceAfterResolve = try getAccountEconomy("user-alice")
    const bobAfterResolve = try getAccountEconomy("user-bob")
    const resolvedView = try getPredictionMarket("seed-market-1")
    const aliceLedger = try getPointLedger("user-alice")
    const resolutionLedger = aliceLedger.find((entry) => entry.kind === "prediction_resolution")

    const replayed = try resolvePredictionMarket({ marketId: "seed-market-1" })
    const aliceAfterReplay = try getAccountEconomy("user-alice")
    const bobAfterReplay = try getAccountEconomy("user-bob")

    try check(() => assert.deepStrictEqual(
      {
        openSecrecy: [
          openView.status,
          openView.resolvedOutcome,
          openView.resolutionProof,
          openView.resolutionArticleId,
          openView.resolvedAt,
          Object.prototype.hasOwnProperty.call(openView, "secretOutcome"),
          Object.prototype.hasOwnProperty.call(openView, "secret_outcome")
        ],
        aliceBuy: [
          aliceBuy.action,
          aliceBuy.side,
          aliceBuy.feeCents,
          aliceBuy.netCents,
          aliceBuy.balanceAfterCents,
          aliceBuy.yesPriceBps > openView.yesPriceBps,
          aliceBuy.market.yesShares * aliceBuy.market.noShares >= openView.yesShares * openView.noShares
        ],
        bobBuy: [bobBuy.balanceAfterCents, bobBuy.shares > 0],
        aliceSell: [
          aliceSell.action,
          aliceSell.shares,
          aliceSell.feeCents,
          aliceSell.netCents,
          aliceSell.balanceAfterCents,
          positionsBeforeResolve.predictionPositions.map((pos) => pos.shares)
        ],
        expiredBuyCode,
        resolved: [
          resolved.status,
          resolved.outcome,
          resolved.positionsSettled,
          resolved.totalPayoutCents,
          resolved.alreadyResolved,
          remainingShares % 100,
          resolved.totalPayoutCents === Math.trunc(remainingShares / 100) * 100
        ],
        balancesAfterResolve: [
          aliceAfterResolve.balanceCents,
          bobAfterResolve.balanceCents,
          resolutionLedger?.deltaCents
        ],
        resolvedView: [
          resolvedView.status,
          resolvedView.resolvedOutcome,
          resolvedView.resolutionProof
        ],
        replayed: [
          replayed.status,
          replayed.outcome,
          replayed.positionsSettled,
          replayed.totalPayoutCents,
          replayed.alreadyResolved,
          aliceAfterReplay.balanceCents,
          bobAfterReplay.balanceCents
        ]
      },
      {
        openSecrecy: ["open", null, null, null, null, false, false],
        aliceBuy: ["buy", "yes", 2, 1_998, 8_000, true, true],
        bobBuy: [9_000, true],
        aliceSell: [
          "sell",
          sharesToSell,
          Math.floor((aliceSell.notionalCents * 10 + 9_999) / 10_000),
          aliceSell.notionalCents - aliceSell.feeCents,
          8_000 + aliceSell.netCents,
          [remainingShares]
        ],
        expiredBuyCode: "MARKET_CLOSED",
        resolved: ["resolved", "yes", 2, remainingShares, false, 0, true],
        balancesAfterResolve: [
          aliceSell.balanceAfterCents + remainingShares,
          9_000,
          remainingShares
        ],
        resolvedView: ["resolved", "yes", "OpenAGI published frontier compute pricing."],
        replayed: [
          "resolved",
          "yes",
          0,
          0,
          true,
          aliceSell.balanceAfterCents + remainingShares,
          9_000
        ]
      }
    ))
  })
})

it.effect('Spot and perpetuals: NPC-only spot shifts index price, 20x leverage cap enforced, 8h UTC funding accrues once per period, and perp close realizes P&L (spec/markets/spotPerp.md, "Story: NPC spot trades drive the index price"; spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/markets/spotPerp.md, "Story: 8-hour funding accrual and mark-price liquidation")', () => effect {
  try TestClock.setTime(Date.UTC(2026, 10, 19, 1, 0, 0))
  try runWithSeededDb(effect {
    const store = try Store
    try createVerifiedAccount("user-alice", "alice", 10_000)
    const initialPerp = try getPerpMarket("XTRPC")

    // spec/markets/spotPerp.md, "Only NPCs may trade the spot CPMM pool, updating the persisted index price"
    const nonNpcCode = try marketErrorCode(executeNpcSpotTrade({
      actorId: "user-alice",
      ticker: "XTRPC",
      side: "buy",
      quoteCents: 1_000
    }))

    const spotBuy1 = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "XTRPC",
      side: "buy",
      quoteCents: 3_000_000
    })
    const poolAfterSpot = try store.transaction((tx: Tx) =>
      tx.query("SELECT base_reserve, quote_reserve_cents, index_price_cents FROM feed_spot_pools WHERE ticker = $1", ["XTRPC"])
    )
    const perpAfterSpot = try getPerpMarket("XTRPC")

    // spec/markets/spotPerp.md, "Opening a perp enforces the 20x leverage cap and updates only the mark premium"
    const overLeverageCode = try marketErrorCode(openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 1_000,
      leverage: 21
    }))

    const opened = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 2_000,
      leverage: 10
    })
    const perpAfterOpen = try getPerpMarket("XTRPC")

    // spec/markets/spotPerp.md, "UTC time advances across 8-hour funding boundaries, and funding skips pre-cutover or duplicate periods"
    try TestClock.adjust(Duration.seconds(2 * 3_600))
    const samePeriodFunding = try accruePerpFunding()
    try TestClock.adjust(Duration.seconds(6 * 3_600))
    const nextPeriodFunding = try accruePerpFunding()
    try TestClock.adjust(Duration.seconds(3_600))
    const duplicatePeriodFunding = try accruePerpFunding()
    const positionsDuringHold = try listPerpPositions("user-alice")
    const fundingRows = try store.transaction((tx: Tx) =>
      tx.query("SELECT period_index, funding_delta_cents FROM feed_perp_funding_periods WHERE position_id = $1", [opened.positionId])
    )

    const spotBuy2 = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "XTRPC",
      side: "buy",
      quoteCents: 5_000_000
    })

    // spec/markets/spotPerp.md, "Closing a perp settles equity and canonical fees at mark price without touching spot"
    const closed = try closePerpPosition({
      ownerId: "user-alice",
      positionId: opened.positionId
    })
    const positionsAfterClose = try listPerpPositions("user-alice")
    const perpAfterClose = try getPerpMarket("XTRPC")

    try check(() => assert.deepStrictEqual(
      {
        initialPerp: [initialPerp.indexPriceCents, initialPerp.markPriceCents, initialPerp.baseReserve, initialPerp.quoteReserveCents],
        nonNpcCode,
        spotBuy1: [
          spotBuy1.baseReserve,
          spotBuy1.quoteReserveCents,
          spotBuy1.indexPriceCents,
          spotBuy1.markPriceCents,
          toInt(poolAfterSpot[0]?.base_reserve),
          toInt(poolAfterSpot[0]?.quote_reserve_cents),
          toInt(poolAfterSpot[0]?.index_price_cents),
          perpAfterSpot.indexPriceCents,
          perpAfterSpot.markPriceCents
        ],
        overLeverageCode,
        opened: [
          opened.leverage,
          opened.sizeCents,
          opened.feeCents,
          opened.executionPriceCents,
          opened.balanceAfterCents,
          perpAfterOpen.indexPriceCents,
          perpAfterOpen.markPriceCents,
          perpAfterOpen.longOiCents
        ],
        funding: [
          samePeriodFunding.accruedCount,
          samePeriodFunding.skippedCutover,
          nextPeriodFunding.period - samePeriodFunding.period,
          nextPeriodFunding.accruedCount,
          duplicatePeriodFunding.period === nextPeriodFunding.period,
          duplicatePeriodFunding.accruedCount,
          positionsDuringHold.map((pos) => [pos.accruedFundingCents, pos.lastFundingPeriod === nextPeriodFunding.period]),
          fundingRows.map((row) => [toInt(row.period_index) === nextPeriodFunding.period, toInt(row.funding_delta_cents)])
        ],
        spotBuy2: [spotBuy2.baseReserve, spotBuy2.quoteReserveCents, spotBuy2.indexPriceCents, spotBuy2.markPriceCents],
        closed: [
          closed.exitPriceCents,
          closed.feeCents,
          closed.netCreditCents,
          closed.realizedPnlCents,
          closed.balanceAfterCents,
          positionsAfterClose.length,
          perpAfterClose.longOiCents,
          perpAfterClose.shortOiCents,
          perpAfterClose.indexPriceCents,
          perpAfterClose.markPriceCents
        ]
      },
      {
        initialPerp: [1_200, 1_200, 10_000, 12_000_000],
        nonNpcCode: "FORBIDDEN_NON_NPC",
        spotBuy1: [8_000, 15_000_000, 1_875, 1_875, 8_000, 15_000_000, 1_875, 1_875, 1_875],
        overLeverageCode: "INVALID_LEVERAGE",
        opened: [10, 20_000, 20, 1_875, 7_980, 1_875, 1_968, 20_000],
        funding: [0, false, 1, 1, true, 0, [[100, true]], [[true, 100]]],
        spotBuy2: [6_000, 20_000_000, 3_333, 3_499],
        closed: [3_499, 20, 19_202, 17_202, 27_182, 0, 0, 0, 3_333, 3_333]
      }
    ))
  })
})

it.effect('Economy and Stripe Checkout: Washington geo-block, idempotent HMAC webhook crediting, and netProfitCents purchase invariance (spec/markets/economy.md, "Story: Buy points on web outside Washington, and play anywhere")', () => effect {
  try TestClock.setTime(Date.UTC(2026, 10, 19, 12, 0, 0))
  try runWithSeededDb(effect {
    try createVerifiedAccount("user-alice", "alice", 10_000)
    try createVerifiedAccount("user-bob", "bob", 10_000)
    try buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 2_000
    })
    try resolvePredictionMarket({ marketId: "seed-market-1" })
    // spec/markets/economy.md, "Pack pricing, equity, net profit, and leaderboard rank helpers"
    try createVerifiedAccount("user-carol", "carol", 15_000)
    const db = try Store
    try db.transaction(effect (tx: Tx) => {
      try tx.query(
        "UPDATE feed_accounts SET handle = 'deleted_user-carol', display_name = 'Deleted User', phone_hash = NULL, phone_last2 = NULL, phone_verified_at = NULL, starting_grant_cents = 10000 WHERE account_id = 'user-carol'"
      )
    })

    const bobCheckoutInput = (billingState: string, ipRegion: string) => ({
      accountId: "user-bob",
      packId: "pack_20" as const,
      billingState,
      ipRegion,
      requestCountry: "US",
      successUrl: "https://feed.fun/markets?checkout=success",
      cancelUrl: "https://feed.fun/markets?checkout=cancel",
      stripeSecretKey: "sk_test_fake"
    })
    // spec/markets/economy.md, "Stripe Checkout packs are web-only and strictly blocked for Washington billing addresses or IPs"
    const waBillingCode = try marketErrorCode(createStripeCheckoutSession(bobCheckoutInput("WA", "CA")))
    const waIpCode = try marketErrorCode(createStripeCheckoutSession(bobCheckoutInput("CA", "US-WA")))

    const bobBefore = try getAccountEconomy("user-bob")
    const boardBefore = try getLeaderboard()

    const stripeRequests: Array<{ readonly method: string; readonly url: string; readonly auth: string | undefined }> = []
    const stripeClient = HttpClient.make(effect (request, url) => {
      stripeRequests.push({ method: request.method, url: url.href, auth: request.headers.authorization })
      return HttpClientResponse.fromWeb(
        request,
        jsonResponse(
          JSON.stringify({ id: "cs_test_ca_pack20", url: "https://checkout.stripe.com/c/pay/cs_test_ca_pack20" }),
          200
        )
      )
    })

    const checkout = try Effect.provideService(
      createStripeCheckoutSession(bobCheckoutInput("CA", "US-CA")),
      HttpClient.HttpClient,
      stripeClient
    )

    const now = try Clock.currentTimeMillis
    const webhookSecret = "whsec_test_feed_markets"
    const rawBody = JSON.stringify({
      id: "evt_test_ca_pack20",
      type: "checkout.session.completed",
      data: {
        object: {
          id: checkout.sessionId,
          payment_status: "paid",
          amount_total: checkout.pack.amountCentsUsd,
          client_reference_id: "user-bob",
          metadata: {
            accountId: "user-bob",
            packId: checkout.pack.id,
            pointsCents: String(checkout.pack.pointsCents)
          }
        }
      }
    })
    const invalidSigCode = try marketErrorCode(handleStripeWebhook({
      rawBody,
      signature: `t=${Math.floor(now / 1000)},v1=${"0".repeat(64)}`,
      webhookSecret
    }))
    const signature = signStripeWebhook(rawBody, webhookSecret, Math.floor(now / 1000))
    const firstWebhook = try handleStripeWebhook({ rawBody, signature, webhookSecret })
    const replayWebhook = try handleStripeWebhook({ rawBody, signature, webhookSecret })

    // spec/markets/economy.md, "Buying points never changes net profit or leaderboard rank, and broke players receive no free refills"
    const bobAfter = try getAccountEconomy("user-bob")
    const boardAfter = try getLeaderboard()
    const bobLedger = try getPointLedger("user-bob")
    const purchaseEntries = bobLedger.filter((entry) => entry.kind === "stripe_purchase")

    try check(() => assert.deepStrictEqual(
      {
        waBlocks: [waBillingCode, waIpCode],
        checkout: [
          checkout.status,
          checkout.sessionId,
          checkout.checkoutUrl,
          checkout.pack.pointsCents,
          stripeRequests
        ],
        invalidSigCode,
        firstWebhook: [
          firstWebhook.received,
          firstWebhook.processed,
          firstWebhook.alreadyCompleted,
          firstWebhook.accountId,
          firstWebhook.sessionId,
          firstWebhook.creditedCents,
          firstWebhook.balanceAfterCents
        ],
        replayWebhook: [
          replayWebhook.received,
          replayWebhook.processed,
          replayWebhook.alreadyCompleted,
          replayWebhook.creditedCents,
          replayWebhook.balanceAfterCents
        ],
        bobEconomy: [
          bobBefore.balanceCents,
          bobAfter.balanceCents,
          bobBefore.purchasedCents,
          bobAfter.purchasedCents,
          bobBefore.netProfitCents,
          bobAfter.netProfitCents,
          purchaseEntries.length,
          purchaseEntries[0]?.deltaCents
        ],
        leaderboardBefore: boardBefore.map((entry) => [entry.rank, entry.accountId, entry.netProfitCents]),
        leaderboardAfter: boardAfter.map((entry) => [entry.rank, entry.accountId, entry.netProfitCents, entry.balanceCents, entry.purchasedCents])
      },
      {
        waBlocks: ["REGION_BLOCKED", "REGION_BLOCKED"],
        checkout: [
          "pending",
          "cs_test_ca_pack20",
          "https://checkout.stripe.com/c/pay/cs_test_ca_pack20",
          200_000,
          [{ method: "POST", url: "https://api.stripe.com/v1/checkout/sessions", auth: "Bearer sk_test_fake" }]
        ],
        invalidSigCode: "INVALID_SIGNATURE",
        firstWebhook: [true, true, false, "user-bob", "cs_test_ca_pack20", 200_000, 210_000],
        replayWebhook: [true, true, true, 0, 210_000],
        bobEconomy: [10_000, 210_000, 0, 200_000, 0, 0, 1, 200_000],
        leaderboardBefore: [
          [1, "user-alice", 1_639],
          [2, "user-bob", 0]
        ],
        leaderboardAfter: [
          [1, "user-alice", 1_639, 11_639, 0],
          [2, "user-bob", 0, 210_000, 200_000]
        ]
      }
    ))
  })
})

effect function runWithSeededMarketDay<A, E>(body: (now: number) => A!E!Store) {
  try TestClock.setTime(Date.UTC(2026, 10, 19, 12, 0, 0))
  return try runWithSeededDb(effect {
    const now = try Clock.currentTimeMillis
    return try body(now)
  })
}

it.effect('Prediction guards, expiry filtering, idempotency, 0-share settlement, and resolved notifications (spec/markets/prediction.md, "Story: Open and trade a prediction market"; spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel")', () =>
  runWithSeededMarketDay(effect (now) => {
    const store = try Store
    try createVerifiedAccount("user-alice", "alice", 500_000)
    try createVerifiedAccount("user-bob", "bob", 500_000)
    try createVerifiedAccount("user-carol", "carol", 500_000)

    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        `INSERT INTO feed_prediction_markets
           (id, slot_index, question, description, category, timeframe, phase, yes_shares, no_shares, liquidity_cents, secret_outcome, status, resolved_outcome, resolution_proof, resolution_article_id, expires_at, resolved_at, created_at)
         VALUES
           ('mkt-expired', NULL, 'Expired still open?', 'desc', 'tech', '15m', 'open', 50000, 50000, 50000, 'YES', 'open', NULL, NULL, NULL, $1, NULL, $2),
           ('mkt-extreme-low', NULL, 'Extreme low market?', 'desc', 'tech', '15m', 'open', 99000, 1000, 100000, 'YES', 'open', NULL, NULL, NULL, $3, NULL, $2),
           ('mkt-sell-guard', NULL, 'Sell guard market?', 'desc', 'tech', '15m', 'open', 10000, 10000, 20000, 'YES', 'open', NULL, NULL, NULL, $3, NULL, $2)`,
        [now - 1_000, now - 60_000, now + 3_600_000]
      )
      try tx.query(
        `INSERT INTO feed_prediction_positions
           (market_id, holder_id, holder_kind, side, shares, cost_basis_cents, settled_at, payout_cents)
         VALUES
           ('mkt-extreme-low', 'user-alice', 'user', 'YES', 5000, 1000, NULL, 0),
           ('mkt-extreme-low', 'user-bob', 'user', 'NO', 5000, 4000, NULL, 0),
           ('mkt-extreme-low', 'user-carol', 'user', 'NO', 50000000, 400000, NULL, 0),
           ('mkt-sell-guard', 'user-alice', 'user', 'YES', 12000, 6000, NULL, 0)`
      )
    })

    // spec/markets/prediction.md, "Resolved, cancelled, held, and expired markets allow no trades, and duplicate resolution pays nothing extra"
    const openMarkets = try listPredictionMarkets("open")
    const allMarkets = try listPredictionMarkets()

    // spec/markets/prediction.md, "Buying YES or NO shares requires an open non-expired market, sufficient balance, and bounded odds impact"
    const extremeWorsenBuyCode = try marketErrorCode(buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "no",
      amountCents: 100
    }))
    const extremeUnwindBuy = try buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "yes",
      amountCents: 100
    })

    // spec/markets/prediction.md, "Selling shares floors gross proceeds to whole cents before charging the canonical fee"
    const extremeWorsenSellCode = try marketErrorCode(sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "yes",
      shares: 500
    }))
    const extremeCrossCenterSellCode = try marketErrorCode(sellPredictionShares({
      actorId: "user-carol",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "no",
      shares: 50_000_000
    }))
    const extremeUnwindSell = try sellPredictionShares({
      actorId: "user-bob",
      actorKind: "user",
      marketId: "mkt-extreme-low",
      side: "no",
      shares: 500
    })
    const partialSellBlockedCode = try marketErrorCode(sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-sell-guard",
      side: "yes",
      shares: 11_000
    }))
    const fullExitSell = try sellPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "mkt-sell-guard",
      side: "yes",
      shares: 12_000
    })

    const idempotentBuy: BuyPredictionInput = {
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 1_000,
      idempotencyKey: "trade-key-1"
    }
    const idemBuy1 = try buyPredictionShares(idempotentBuy)
    const idemBuyReplay = try buyPredictionShares(idempotentBuy)
    const idemBuyConflictCode = try marketErrorCode(buyPredictionShares({ ...idempotentBuy, amountCents: 2_000 }))
    const idemOtherUserBuy = try buyPredictionShares({ ...idempotentBuy, actorId: "user-bob", side: "no" })
    const idempotentSell: SellPredictionInput = {
      actorId: idempotentBuy.actorId,
      actorKind: idempotentBuy.actorKind,
      marketId: idempotentBuy.marketId,
      side: idempotentBuy.side,
      shares: idemBuy1.shares,
      idempotencyKey: "trade-sell-1"
    }
    const idemSell1 = try sellPredictionShares(idempotentSell)
    const idemSellReplay = try sellPredictionShares(idempotentSell)
    const idemSellConflictCode = try marketErrorCode(sellPredictionShares({ ...idempotentSell, shares: 100 }))

    try buyPredictionShares({
      actorId: "user-carol",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 1_500
    })

    // spec/markets/prediction.md, "Resolution declassifies the hidden outcome, publishes the proof, and pays 1 pt (100 cents) per winning share idempotently"
    const resolved = try resolvePredictionMarket({ marketId: "seed-market-1" })
    const idemReplayAfterClose = try buyPredictionShares(idempotentBuy)
    const zeroSharePos = try store.transaction((tx: Tx) =>
      tx.query(
        "SELECT shares, settled_at FROM feed_prediction_positions WHERE market_id = 'seed-market-1' AND holder_id = 'user-alice' AND side = 'YES'"
      )
    )
    const notifications = try store.transaction((tx: Tx) =>
      tx.query(
        "SELECT account_id, kind, market_id, is_game_only FROM feed_notifications WHERE market_id = 'seed-market-1' ORDER BY account_id ASC"
      )
    )

    try check(() => assert.deepStrictEqual(
      {
        expiredExcludedFromOpen: openMarkets.some((m) => m.id === "mkt-expired"),
        expiredIncludedInAll: allMarkets.some((m) => m.id === "mkt-expired"),
        extremeWorsenBuyCode,
        extremeUnwindBuyImproved: extremeUnwindBuy.yesPriceBps > 100 && extremeUnwindBuy.yesPriceBps < 200,
        extremeWorsenSellCode,
        extremeCrossCenterSellCode,
        extremeUnwindSellImproved: extremeUnwindSell.yesPriceBps > extremeUnwindBuy.yesPriceBps,
        partialSellBlockedCode,
        fullExitMovedOverCap: Math.abs(fullExitSell.yesPriceBps - 5000) > 2000 && fullExitSell.yesPriceBps >= 200,
        idemBuyExactReplay: idemBuyReplay.tradeId === idemBuy1.tradeId && idemBuyReplay.balanceAfterCents === idemBuy1.balanceAfterCents,
        idemReplayAfterCloseMatches: idemReplayAfterClose.tradeId === idemBuy1.tradeId,
        idemBuyConflictCode,
        idemOtherUserSucceeded: idemOtherUserBuy.tradeId !== idemBuy1.tradeId,
        idemSellExactReplay: idemSellReplay.tradeId === idemSell1.tradeId,
        idemSellConflictCode,
        resolvedSettledCount: resolved.positionsSettled,
        aliceZeroShareNotSettled: [toInt(zeroSharePos[0]?.shares), zeroSharePos[0]?.settled_at],
        resolvedNotifications: notifications.map((row) => [row.account_id, row.kind, row.market_id, row.is_game_only])
      },
      {
        expiredExcludedFromOpen: false,
        expiredIncludedInAll: true,
        extremeWorsenBuyCode: "PRICE_IMPACT_EXCEEDED",
        extremeUnwindBuyImproved: true,
        extremeWorsenSellCode: "PRICE_IMPACT_EXCEEDED",
        extremeCrossCenterSellCode: "PRICE_IMPACT_EXCEEDED",
        extremeUnwindSellImproved: true,
        partialSellBlockedCode: "PRICE_IMPACT_EXCEEDED",
        fullExitMovedOverCap: true,
        idemBuyExactReplay: true,
        idemReplayAfterCloseMatches: true,
        idemBuyConflictCode: "IDEMPOTENCY_CONFLICT",
        idemOtherUserSucceeded: true,
        idemSellExactReplay: true,
        idemSellConflictCode: "IDEMPOTENCY_CONFLICT",
        resolvedSettledCount: 2,
        aliceZeroShareNotSettled: [0, null],
        resolvedNotifications: [
          ["user-bob", "market_resolved", "seed-market-1", true],
          ["user-carol", "market_resolved", "seed-market-1", true]
        ]
      }
    ))
  })
)

it.effect('Leaderboard filters, MTM valuation, voided market exclusion, and unified Stripe refund and dispute reversals (spec/markets/economy.md, "Story: Buy points on web outside Washington, and play anywhere"; spec/markets/prediction.md, "Story: Close on schedule, review, resolve, or cancel")', () =>
  runWithSeededMarketDay(effect (now) => {
    const store = try Store
    try createVerifiedAccount("user-alice", "alice", 10_000)
    try createVerifiedAccount("user-bob", "bob", 10_000)

    try store.transaction(effect (tx: Tx) => {
      try tx.query("INSERT INTO organizations (id, name, credit_balance, created_at) VALUES ('org-deleted', 'Deleted', 0, $1)", [now])
      try tx.query(
        `INSERT INTO accounts (key, state, revision, organization_id, status, email, phone, name, created_at, updated_at)
         VALUES ('user-deleted', '{}'::jsonb, 1, 'org-deleted', 'erased', NULL, NULL, 'Deleted', $1, $1)`,
        [now]
      )
      try tx.query(
        `INSERT INTO feed_accounts (${FEED_ACCOUNT_COLUMNS}) VALUES
           ('user-deleted', 'deleted_user', 'Deleted', '', NULL, NULL, NULL, $1, $1, 'game', 50000, 10000, 0, 0, false, false, NULL, $1, $1),
           ('user-reviewer', 'reviewer1', 'Reviewer', '', NULL, NULL, NULL, $1, $1, 'game', 50000, 10000, 0, 0, false, true, 'hash', $1, $1),
           ('user-unverified', 'unverified1', 'Unverified', '', NULL, NULL, NULL, NULL, $1, 'game', 50000, 10000, 0, 0, false, false, NULL, $1, $1)`,
        [now]
      )
    })

    const aliceOpenBuy = try buyPredictionShares({
      actorId: "user-alice",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 2_000
    })
    const bobPushBuy = try buyPredictionShares({
      actorId: "user-bob",
      actorKind: "user",
      marketId: "seed-market-1",
      side: "yes",
      amountCents: 4_000
    })
    const expectedAliceMtm = Math.floor((aliceOpenBuy.shares * bobPushBuy.yesPriceBps) / 10_000)
    const aliceEconMtm = try getAccountEconomy("user-alice")
    const boardMtm = try getLeaderboard()
    const aliceBoardMtm = boardMtm.find((e) => e.accountId === "user-alice")

    // spec/markets/prediction.md, "Cancelled markets refund every open position at cost basis without publishing an outcome"
    try cancelPredictionMarket("seed-market-1")
    const boardAfterCancel = try getLeaderboard()
    const aliceAfterCancel = boardAfterCancel.find((e) => e.accountId === "user-alice")

    const webhookSecret = "whsec_test_reversals"
    const sendSigned = (payload: Readonly<Record<string, unknown>>) => effect {
      const rawBody = JSON.stringify(payload)
      const signature = signStripeWebhook(rawBody, webhookSecret, Math.floor(now / 1000))
      return try handleStripeWebhook({ rawBody, signature, webhookSecret })
    }

    const checkoutRes = try sendSigned({
      id: "evt_checkout_rev_1",
      type: "checkout.session.completed",
      data: {
        object: {
          id: "cs_rev_1",
          payment_status: "paid",
          payment_intent: "pi_rev_1",
          amount_total: 2_000,
          client_reference_id: "user-bob",
          metadata: { accountId: "user-bob", packId: "pack_20" }
        }
      }
    })
    const earlyWonCode = try marketErrorCode(sendSigned({
      id: "evt_dispute_won_early",
      type: "charge.dispute.closed",
      data: { object: { id: "dp_1", payment_intent: "pi_rev_1", status: "won", amount: 1_500 } }
    }))
    const refund1 = try sendSigned({
      id: "evt_refund_1",
      type: "charge.refunded",
      data: { object: { id: "ch_1", payment_intent: "pi_rev_1", amount_refunded: 600 } }
    })
    const refund1Dup = try sendSigned({
      id: "evt_refund_1",
      type: "charge.refunded",
      data: { object: { id: "ch_1", payment_intent: "pi_rev_1", amount_refunded: 600 } }
    })
    const refundStale = try sendSigned({
      id: "evt_refund_stale",
      type: "charge.refunded",
      data: { object: { id: "ch_1", payment_intent: "pi_rev_1", amount_refunded: 400 } }
    })
    const refund2 = try sendSigned({
      id: "evt_refund_2",
      type: "charge.refunded",
      data: { object: { id: "ch_1", payment_intent: "pi_rev_1", amount_refunded: 1_000 } }
    })
    const disputeCreated = try sendSigned({
      id: "evt_dispute_1",
      type: "charge.dispute.created",
      data: { object: { id: "dp_1", payment_intent: "pi_rev_1", amount: 1_500, status: "needs_response" } }
    })
    const disputeWon = try sendSigned({
      id: "evt_dispute_won_1",
      type: "charge.dispute.closed",
      data: { object: { id: "dp_1", payment_intent: "pi_rev_1", amount: 1_500, status: "won" } }
    })
    const disputeWonDup = try sendSigned({
      id: "evt_dispute_won_dup",
      type: "charge.dispute.closed",
      data: { object: { id: "dp_1", payment_intent: "pi_rev_1", amount: 1_500, status: "won" } }
    })
    const bobAfterReversals = try getAccountEconomy("user-bob")

    try sendSigned({
      id: "evt_checkout_lowbal",
      type: "checkout.session.completed",
      data: {
        object: {
          id: "cs_lowbal_1",
          payment_status: "paid",
          payment_intent: "pi_lowbal_1",
          amount_total: 500,
          client_reference_id: "user-alice",
          metadata: { accountId: "user-alice", packId: "pack_5" }
        }
      }
    })
    try store.transaction((tx: Tx) =>
      tx.query("UPDATE feed_accounts SET balance_cents = 10000 WHERE account_id = 'user-alice'")
    )
    const lowBalRefund1 = try sendSigned({
      id: "evt_lowbal_ref_1",
      type: "charge.refunded",
      data: { object: { id: "ch_low", payment_intent: "pi_lowbal_1", amount_refunded: 300 } }
    })
    try store.transaction((tx: Tx) =>
      tx.query("UPDATE feed_accounts SET balance_cents = 50000 WHERE account_id = 'user-alice'")
    )
    const lowBalRefund2 = try sendSigned({
      id: "evt_lowbal_ref_2",
      type: "charge.refunded",
      data: { object: { id: "ch_low", payment_intent: "pi_lowbal_1", amount_refunded: 400 } }
    })

    try check(() => assert.deepStrictEqual(
      {
        leaderboardIds: boardMtm.map((e) => e.accountId).sort(),
        mtmMatchesEconomyAndBoard: [
          aliceEconMtm.positionValueCents === expectedAliceMtm,
          aliceBoardMtm?.positionValueCents === expectedAliceMtm,
          expectedAliceMtm !== 2_000
        ],
        cancelledNotCountedAsSettledOrLoss: [
          aliceAfterCancel?.settledCount,
          aliceAfterCancel?.wins
        ],
        checkoutCredited: checkoutRes.creditedCents,
        earlyWonCode,
        refund1: [refund1.creditedCents, refund1.balanceAfterCents],
        refund1Dup: [refund1Dup.alreadyCompleted, refund1Dup.creditedCents],
        refundStale: [refundStale.creditedCents, refundStale.balanceAfterCents],
        refund2: [refund2.creditedCents, refund2.balanceAfterCents],
        disputeCreatedCapped: [disputeCreated.creditedCents, disputeCreated.balanceAfterCents],
        disputeWonRestoresExactDebit: [disputeWon.creditedCents, disputeWon.balanceAfterCents],
        disputeWonDup: [disputeWonDup.alreadyCompleted, disputeWonDup.creditedCents],
        bobFinalEconomy: [bobAfterReversals.balanceCents, bobAfterReversals.purchasedCents, bobAfterReversals.netProfitCents],
        lowBalRefundTracksCumulativeSeparately: [lowBalRefund1.creditedCents, lowBalRefund2.creditedCents]
      },
      {
        leaderboardIds: ["user-alice", "user-bob"],
        mtmMatchesEconomyAndBoard: [true, true, true],
        cancelledNotCountedAsSettledOrLoss: [0, 0],
        checkoutCredited: 200_000,
        earlyWonCode: "STRIPE_RETRYABLE_DISPUTE_DEBIT_MISSING",
        refund1: [-60_000, 150_000],
        refund1Dup: [true, 0],
        refundStale: [0, 150_000],
        refund2: [-40_000, 110_000],
        disputeCreatedCapped: [-100_000, 10_000],
        disputeWonRestoresExactDebit: [100_000, 110_000],
        disputeWonDup: [true, 0],
        bobFinalEconomy: [110_000, 100_000, 0],
        lowBalRefundTracksCumulativeSeparately: [-10_000, -10_000]
      }
    ))
  })
)
