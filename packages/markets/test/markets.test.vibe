        ...closedPositionSummary(all),
        itemStatus: all.items[0]?.status,
        itemRealizedPnlCents: all.items[0]?.realizedPnlCents,
        payoutEqualsCostBasis: payoutEqualsCostBasis,
        cancelledTotalCount: cancelled.totalCount,
        lostTotalCount: lost.totalCount,
        canonicalOutcome: canonical.predictionPositions[0]?.outcome
      },
      {
        parseCancelled: "cancelled",
        parseBogus: "all",
        allTotalCount: 1,
        itemKind: "prediction",
        itemMarketId: "seed-market-1",
        itemSide: "yes",
        itemOutcome: "cancelled",
        itemStatus: "cancelled",
        itemRealizedPnlCents: 0,
        payoutEqualsCostBasis: true,
        cancelledTotalCount: 1,
        lostTotalCount: 0,
        canonicalOutcome: "cancelled"
      }
    ))
  })
)

it.effect('NPC spot sells use seeded holdings: a fresh sell settles on a seeded pair before any buy, unseeded sells are refused, buys accrue holdings (spec/markets/spotPerp.md, "Story: NPC spot trades drive the index price")', () => effect {
  try TestClock.setTime(Date.UTC(2026, 10, 19, 1, 0, 0))
  try runWithSeededDb(effect {
    const store = try Store
    const holdingsFor = (actorId: string, ticker: string) => store.transaction((tx: Tx) =>
      tx.query("SELECT base_units FROM feed_npc_spot_holdings WHERE actor_id = $1 AND ticker = $2", [actorId, ticker])
    )
    const seededTslaHoldings = try holdingsFor("ailon-musk", "TSLAI")
    const seededXtrpcHoldings = try holdingsFor("ailon-musk", "XTRPC")
    // spec/markets/spotPerp.md, "Only NPCs may trade the spot CPMM pool, updating the persisted index price"
    const freshSell = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "TSLAI",
      side: "sell",
      quoteCents: 100
    })
    const holdingsAfterFreshSell = try holdingsFor("ailon-musk", "TSLAI")
    const sellWithNoHoldingsCode = try marketErrorCode(executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "XTRPC",
      side: "sell",
      quoteCents: 100
    }))
    const spotBuy = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "XTRPC",
      side: "buy",
      quoteCents: 3_000_000
    })
    const holdingsAfterBuy = try holdingsFor("ailon-musk", "XTRPC")
    const spotSell = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "XTRPC",
      side: "sell",
      quoteCents: 1_000_000
    })
    const holdingsAfterSell = try holdingsFor("ailon-musk", "XTRPC")
    const sellBeyondHoldingsCode = try marketErrorCode(executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "XTRPC",
      side: "sell",
      quoteCents: 2_500_000
    }))
    const exactLimitSell = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "XTRPC",
      side: "sell",
      quoteCents: 1_999_920
    })
    const holdingsAfterExactSell = try holdingsFor("ailon-musk", "XTRPC")
    const secondNpcSellCode = try marketErrorCode(executeNpcSpotTrade({
      actorId: "dairiio-amodei",
      ticker: "XTRPC",
      side: "sell",
      quoteCents: 100
    }))
    const secondTickerSellCode = try marketErrorCode(executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "SEQ",
      side: "sell",
      quoteCents: 100
    }))
    // spec/markets/economy.md, "Initial grants are fixed at 100 pts, balances stay non-negative, and net profit excludes only the starting grant"
    const npcBoardRow = effect () => {
      const board = try getLeaderboard({ scope: "characters", metric: "net_profit", page: 1, pageSize: 200 })
      const row = board.entries.find((entry) => entry.accountId === "ailon-musk")!
      return [row.startingGrantCents, row.netProfitCents]
    }
    const boardBeforeTslaDrain = try npcBoardRow()
    const tslaDrain = try executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "TSLAI",
      side: "sell",
      quoteCents: 1_719_026
    })
    const holdingsAfterTslaDrain = try holdingsFor("ailon-musk", "TSLAI")
    const boardAfterTslaDrain = try npcBoardRow()
    try seedFeedWorld()
    const holdingsAfterReseed = try holdingsFor("ailon-musk", "TSLAI")
    const resellAfterReseedCode = try marketErrorCode(executeNpcSpotTrade({
      actorId: "ailon-musk",
      ticker: "TSLAI",
      side: "sell",
      quoteCents: 100
    }))
    try check(() => assert.deepStrictEqual(
      {
        seededTslaHoldings: seededTslaHoldings.map((row) => toInt(row.base_units)),
        seededXtrpcHoldings: seededXtrpcHoldings.map((row) => toInt(row.base_units)),
        freshSell: [freshSell.baseDelta, freshSell.baseReserve, freshSell.quoteReserveCents, freshSell.indexPriceCents, freshSell.markPriceCents, freshSell.balanceAfterCents],
        holdingsAfterFreshSell: holdingsAfterFreshSell.map((row) => toInt(row.base_units)),
        sellWithNoHoldingsCode,
        spotBuy: [spotBuy.baseDelta, spotBuy.baseReserve, spotBuy.quoteReserveCents, spotBuy.indexPriceCents, spotBuy.markPriceCents, spotBuy.balanceAfterCents],
        holdingsAfterBuy: holdingsAfterBuy.map((row) => toInt(row.base_units)),
        spotSell: [spotSell.baseDelta, spotSell.baseReserve, spotSell.quoteReserveCents, spotSell.indexPriceCents, spotSell.markPriceCents, spotSell.balanceAfterCents],
        holdingsAfterSell: holdingsAfterSell.map((row) => toInt(row.base_units)),
        sellBeyondHoldingsCode,
        exactLimitSell: [exactLimitSell.baseDelta, exactLimitSell.baseReserve, exactLimitSell.quoteReserveCents, exactLimitSell.indexPriceCents, exactLimitSell.markPriceCents, exactLimitSell.balanceAfterCents],
        holdingsAfterExactSell: holdingsAfterExactSell.map((row) => toInt(row.base_units)),
        secondNpcSellCode,
        secondTickerSellCode,
        tslaDrainBaseDelta: tslaDrain.baseDelta,
        holdingsAfterTslaDrain: holdingsAfterTslaDrain.map((row) => toInt(row.base_units)),
        boardBeforeTslaDrain,
        boardAfterTslaDrain,
        holdingsAfterReseed: holdingsAfterReseed.map((row) => toInt(row.base_units)),
        resellAfterReseedCode
      },
      {
        seededTslaHoldings: [8_164],
        seededXtrpcHoldings: [],
        freshSell: [1, 50_001, 12_249_900, 24_499, 24_499, 25_000_100],
        holdingsAfterFreshSell: [8_163],
        sellWithNoHoldingsCode: "INSUFFICIENT_SPOT_INVENTORY",
        spotBuy: [41_666, 8_334, 3_600_000, 43_196, 43_196, 22_000_100],
        holdingsAfterBuy: [41_666],
        spotSell: [3_206, 11_540, 2_600_000, 22_530, 22_530, 23_000_100],
        holdingsAfterSell: [38_460],
        sellBeyondHoldingsCode: "INSUFFICIENT_SPOT_INVENTORY",
        exactLimitSell: [38_460, 50_000, 600_080, 1_200, 1_200, 25_000_020],
        holdingsAfterExactSell: [0],
        secondNpcSellCode: "INSUFFICIENT_SPOT_INVENTORY",
        secondTickerSellCode: "INSUFFICIENT_SPOT_INVENTORY",
        tslaDrainBaseDelta: 8_163,
        holdingsAfterTslaDrain: [0],
        boardBeforeTslaDrain: [36_501_164, -307],
        boardAfterTslaDrain: [36_501_164, -281_134],
        holdingsAfterReseed: [0],
        resellAfterReseedCode: "INSUFFICIENT_SPOT_INVENTORY"
      }
    ))
  })
})

it.effect('Perp open/close idempotency: same key replays the receipt, different params conflict, other traders unaffected (spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage")', () => effect {
  try TestClock.setTime(Date.UTC(2026, 10, 19, 12, 0, 0))
  try runWithSeededDb(effect {
    try createVerifiedAccount("user-alice", "alice", 500_000)
    try createVerifiedAccount("user-bob", "bob", 500_000)

    const openParams = {
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 2_000,
      leverage: 10,
      idempotencyKey: "perp-open-1"
    } as const
    const open1 = try openPerpPosition(openParams)
    const openReplay = try openPerpPosition(openParams)
    const openConflictCode = try marketErrorCode(openPerpPosition({
      ...openParams,
      collateralCents: 3_000
    }))
    const openOtherUser = try openPerpPosition({
      ownerId: "user-bob",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 2_000,
      leverage: 10,
      idempotencyKey: "perp-open-1"
    })
    const close1 = try closePerpPosition({
      ownerId: "user-alice",
      positionId: open1.positionId,
      idempotencyKey: "perp-close-1"
    })
    const closeReplay = try closePerpPosition({
      ownerId: "user-alice",
      positionId: open1.positionId,
      idempotencyKey: "perp-close-1"
    })
    const open2 = try openPerpPosition({
      ownerId: "user-alice",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 2_000,
      leverage: 10,
      idempotencyKey: "perp-open-2"
    })
    const closeConflictCode = try marketErrorCode(closePerpPosition({
      ownerId: "user-alice",
      positionId: open2.positionId,
      idempotencyKey: "perp-close-1"
    }))
    const close2 = try closePerpPosition({
      ownerId: "user-alice",
      positionId: open2.positionId
    })
    const bobPositions = try listPerpPositions("user-bob")
    const alicePositions = try listPerpPositions("user-alice")

    try check(() => assert.deepStrictEqual(
      {
        openReplaySame: [openReplay.tradeId === open1.tradeId, openReplay.positionId === open1.positionId, openReplay.balanceAfterCents === open1.balanceAfterCents],
        openConflictCode,
        openOtherUserDifferent: openOtherUser.tradeId !== open1.tradeId && openOtherUser.positionId !== open1.positionId,
        closeReplaySame: [closeReplay.tradeId === close1.tradeId, closeReplay.balanceAfterCents === close1.balanceAfterCents],
        closeConflictCode,
        close2Ok: close2.positionId === open2.positionId,
        bobStillOpen: bobPositions.length,
        aliceStillOpen: alicePositions.length
      },
      {
        openReplaySame: [true, true, true],
        openConflictCode: "IDEMPOTENCY_CONFLICT",
        openOtherUserDifferent: true,
        closeReplaySame: [true, true],
        closeConflictCode: "IDEMPOTENCY_CONFLICT",
        close2Ok: true,
        bobStillOpen: 1,
        aliceStillOpen: 0
      }
    ))
  })
})

it.effect("prediction, perp, and NPC spot write helpers stamp explicit nowMs timestamps", effect () => {
  provide localStoreLayer({ kind: "pglite", file: undefined }) {
    try migrateFeedSchema()
    try seedFeedWorld()
    const store = try Store
    const simNowMs = 1_750_000_555_000
    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        `INSERT INTO feed_accounts (account_id, handle, display_name, balance_cents, created_at, updated_at)
         VALUES ('user-sim', 'simuser', 'Sim User', 200000, $1, $1)
         ON CONFLICT (account_id) DO NOTHING`,
        [simNowMs - 60_000]
      )
      try tx.query(
        `INSERT INTO feed_prediction_markets
           (id, slot_index, question, description, category, timeframe, phase, yes_shares, no_shares, liquidity_cents, status, secret_outcome, expires_at, created_at)
         VALUES
           ('pred-sim-now', NULL, 'Sim clock market?', 'Tests nowMs threading.', 'Tech', '1d', 'opening', 500000, 500000, 1000000, 'open', 'YES', $1, $2)`,
        [simNowMs + 86_400_000, simNowMs - 60_000]
      )
    })
    const npcRows = try store.transaction((tx: Tx) =>
      tx.query("SELECT id FROM feed_actors WHERE balance_cents >= 50000 ORDER BY id ASC LIMIT 1")
    )
    const npcId = String(npcRows[0]?.id ?? "")
    const predReceipt = try buyPredictionShares({
      actorId: "user-sim",
      actorKind: "user",
      marketId: "pred-sim-now",
      side: "yes",
      amountCents: 1_000,
      nowMs: simNowMs
    })
    const perpReceipt = try openPerpPosition({
      ownerId: "user-sim",
      ownerKind: "user",
      ticker: "XTRPC",
      side: "long",
      collateralCents: 1_000,
      leverage: 2,
      nowMs: simNowMs
    })
    const spotReceipt = try executeNpcSpotTrade({
      actorId: npcId,
      ticker: "XTRPC",
      side: "buy",
      quoteCents: 2_000,
      nowMs: simNowMs
    })
    try check(() => assert.deepStrictEqual(
      [predReceipt.createdAt, perpReceipt.createdAt, perpReceipt.position.createdAt, spotReceipt.createdAt],
      [simNowMs, simNowMs, simNowMs, simNowMs]
    ))
  }
})

effect function setHundredCorpPrices(priceCents: number): void!StoreFailure!Store {
  const store = try Store
  try store.transaction(effect (tx: Tx) => {
    try tx.query(
      `UPDATE feed_perp_markets SET index_price_cents = ${priceCents}, mark_price_cents = ${priceCents} WHERE ticker = 'HUND'`
    )
  })
}

effect function sweepLiquidatedIds(): Array<string>!(MarketFailure | StoreFailure)!Store {
  const busLayer = Layer.succeed(MarketRealtimeBus, {
    publish: (_event: MarketPerpRealtimeEvent) => Effect.sync(() => true)
  })
  return try effect {
    provide busLayer {
      const summary = try liquidateEligiblePositions()
      return [...summary.liquidatedPositionIds]
    }
  }
}

it.effect("displayed liquidation price is the exact sweep boundary", () =>
  runWithSeededMarketDay(effect (now) => {
    try seedHundredCorpMarket(now)
    try createVerifiedAccount("user-liq-a", "liqalice", 500_000)
    try createVerifiedAccount("user-liq-b", "liqbob", 500_000)
    try createVerifiedAccount("user-liq-c", "liqcarol", 500_000)

    const longA = try openPerpPosition({ ownerId: "user-liq-a", ownerKind: "user", ticker: "HUND", side: "long", collateralCents: 300, leverage: 20 })
    const liqA = longA.position.liquidationPriceCents
    try setHundredCorpPrices(liqA + 1)
    assert.deepStrictEqual(try sweepLiquidatedIds(), [])
    try setHundredCorpPrices(liqA)
    assert.deepStrictEqual(try sweepLiquidatedIds(), [longA.position.id])

    try setHundredCorpPrices(10_000)
    const longB = try openPerpPosition({ ownerId: "user-liq-b", ownerKind: "user", ticker: "HUND", side: "long", collateralCents: 500, leverage: 20 })
    const liqB = longB.position.liquidationPriceCents
    try setHundredCorpPrices(liqB + 1)
    assert.deepStrictEqual(try sweepLiquidatedIds(), [])
    try setHundredCorpPrices(liqB)
    assert.deepStrictEqual(try sweepLiquidatedIds(), [longB.position.id])

    try setHundredCorpPrices(10_000)
    const shortC = try openPerpPosition({ ownerId: "user-liq-c", ownerKind: "user", ticker: "HUND", side: "short", collateralCents: 500, leverage: 20 })
    const liqC = shortC.position.liquidationPriceCents
    try setHundredCorpPrices(liqC - 1)
    assert.deepStrictEqual(try sweepLiquidatedIds(), [])
    try setHundredCorpPrices(liqC)
    assert.deepStrictEqual(try sweepLiquidatedIds(), [shortC.position.id])

    try setHundredCorpPrices(10_000)
    try createVerifiedAccount("user-liq-d", "liqdave", 500_000)
    const shortD = try openPerpPosition({ ownerId: "user-liq-d", ownerKind: "user", ticker: "HUND", side: "short", collateralCents: 1_000, leverage: 1 })
    try TestClock.adjust(Duration.seconds(6 * 3_600))
    try accruePerpFunding()
    const heldD = try listPerpPositions("user-liq-d")
    const liqD = heldD[0]?.liquidationPriceCents ?? 0
    try setHundredCorpPrices(liqD - 1)
    assert.deepStrictEqual(try sweepLiquidatedIds(), [])
    try setHundredCorpPrices(liqD)
    assert.deepStrictEqual(try sweepLiquidatedIds(), [shortD.position.id])
  })
)
