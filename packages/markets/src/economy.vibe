// spec/markets/economy.md, "Story: Verify account and claim initial grant once"; spec/markets/economy.md, "Story: Trade with fixed starting capital and rank by net profit"; spec/shared/money.md, "One point equals one hundred cents, and integer bounds clamp cleanly"
import {
  SPOT_BASE_SCALE,
  Store,
  type StoreFailure,
  resolveActorAvatarUrl,
  tierStartingBalanceCents,
  toInt,
  type Row,
  type Tx
} from "@repo/db"
import {
  INITIAL_GRANT_CENTS,
  INITIAL_GRANT_PTS,
  equityCents,
  netProfitCents,
  type PlayerLedger
} from "../gen/markets__economy.effect.vibe"
import { positionEquityAtMark } from "../gen/markets__spotPerp.effect.vibe"
import { canonicalTradingFee } from "../gen/shared__money.effect.vibe"
import { markToMarketPredictionCents } from "./prediction.vibe"
import {
  type MarketFailure,
  marketFail,
  optionalText,
  requiredText,
  toSpecPerpPosition
} from "./shared.vibe"

export { INITIAL_GRANT_CENTS, INITIAL_GRANT_PTS }

export type LeaderboardScope = "players" | "characters"
export type LeaderboardMetric = "net_profit" | "return_pct" | "win_rate" | "volume"
export type LeaderboardFilter = "all" | "traders" | "npcs"
export type LeaderboardTimeframe = "24h" | "7d" | "30d" | "all"

export interface AccountEconomyView {
  readonly accountId: string
  readonly handle: string
  readonly displayName: string
  readonly verified: boolean
  readonly uiMode: "game" | "social"
  readonly balanceCents: number
  readonly positionValueCents: number
  readonly equityCents: number
  readonly startingGrantCents: number
  readonly totalFeesPaidCents: number
  readonly netProfitCents: number
}

export interface PointLedgerEntry {
  readonly id: string
  readonly accountId: string
  readonly kind: string
  readonly deltaCents: number
  readonly balanceAfterCents: number
  readonly refId: string | null
  readonly createdAt: number
}

export interface LeaderboardEntry {
  readonly rank: number
  readonly accountId: string
  readonly handle: string
  readonly displayName: string
  readonly avatarUrl: string | null
  readonly isNpc: boolean
  readonly balanceCents: number
  readonly positionValueCents: number
  readonly equityCents: number
  readonly startingGrantCents: number
  readonly netProfitCents: number
  readonly returnBps: number
  readonly returnPct: number
  readonly roiPct: number
  readonly volumeCents: number
  readonly tradeCount: number
  readonly wins: number
  readonly settledCount: number
  readonly winRate: number
  readonly winRatePct: number
  readonly isFollowing: boolean
}

export interface GetLeaderboardInput {
  readonly scope?: LeaderboardScope
  readonly metric?: LeaderboardMetric
  readonly page?: number
  readonly pageSize?: number
  readonly viewerAccountId?: string
}

export interface LeaderboardPage {
  readonly scope: LeaderboardScope
  readonly metric: LeaderboardMetric
  readonly entries: ReadonlyArray<LeaderboardEntry>
  readonly totalCount: number
  readonly totalPages: number
  readonly page: number
  readonly pageSize: number
  readonly currentUser: LeaderboardEntry | null
}

export interface AccountLeaderboardPosition {
  readonly rank: number
  readonly page: number
  readonly totalCount: number
  readonly entry: LeaderboardEntry
}

export interface LeaderboardPagination {
  readonly page: number
  readonly pageSize: number
  readonly totalCount: number
  readonly totalPages: number
}

export interface FilteredLeaderboardPage {
  readonly metric: LeaderboardMetric
  readonly entries: ReadonlyArray<LeaderboardEntry>
  readonly pagination: LeaderboardPagination
  readonly currentUser: LeaderboardEntry | null
  readonly generatedAt: number
}

export interface LeaderboardViewerRank {
  readonly rank: number | null
  readonly page: number | null
  readonly entry: LeaderboardEntry | null
}

export interface LeaderboardQueryOptions {
  readonly filter?: LeaderboardFilter
  readonly timeframe?: LeaderboardTimeframe
  readonly metric?: LeaderboardMetric
  readonly page?: number
  readonly pageSize?: number
  readonly viewerAccountId?: string
}

export function parseLeaderboardFilter(raw: string | null | undefined): LeaderboardFilter {
  const norm = raw?.trim().toLowerCase()
  if (norm === "traders" || norm === "humans" || norm === "players") return "traders"
  if (norm === "npcs" || norm === "actors" || norm === "characters") return "npcs"
  return "all"
}

export function parseLeaderboardTimeframe(raw: string | null | undefined): LeaderboardTimeframe {
  const norm = raw?.trim().toLowerCase()
  if (norm === "24h" || norm === "1d") return "24h"
  if (norm === "7d" || norm === "1w") return "7d"
  if (norm === "30d" || norm === "1m") return "30d"
  return "all"
}

function timeframeCutoffMs(timeframe: LeaderboardTimeframe, nowMs: number): number | null {
  switch (timeframe) {
    case "24h":
      return nowMs - 86_400_000
    case "7d":
      return nowMs - 7 * 86_400_000
    case "30d":
      return nowMs - 30 * 86_400_000
    case "all":
      return null
  }
}

function buildLedger(
  accountId: string,
  verified: boolean,
  cashCents: number,
  positionValueCents: number,
  startingGrantCents: number
): PlayerLedger {
  return {
    id: accountId,
    verified,
    grantClaimed: verified,
    cashCents,
    positionValueCents,
    startingGrantCents
  }
}

effect function loadOpenPerpRows(tx: Tx, holderKind: "user" | "npc", accountId?: string): ReadonlyArray<Row>!StoreFailure {
  const accountFilter = accountId === undefined ? "" : " AND p.holder_id = $2"
  return try tx.query(
    `SELECT p.holder_id, p.side, p.margin_cents, p.size_cents, p.entry_price_cents, p.leverage, p.accrued_funding_cents, p.last_funding_period, p.created_at, m.mark_price_cents
     FROM feed_perp_positions p
     JOIN feed_perp_markets m ON m.ticker = p.ticker
     WHERE p.holder_kind = $1 AND p.status = 'open'${accountFilter}`,
    accountId === undefined ? [holderKind] : [holderKind, accountId]
  )
}

export effect function getAccountEconomyIn(tx: Tx, accountId: string): AccountEconomyView!(MarketFailure | StoreFailure) {
  const accountRows = try tx.query(
    `SELECT account_id, handle, display_name, phone_verified_at, email_verified_at, ui_mode, balance_cents, starting_grant_cents, total_fees_paid_cents
     FROM feed_accounts
     WHERE account_id = $1`,
    [accountId]
  )
  if (accountRows.length === 0) {
    throw marketFail("ACCOUNT_NOT_FOUND", `Account not found: ${accountId}`)
  }
  const acct = accountRows[0]!
  const now = try Clock.currentTimeMillis
  const predRows = try tx.query(
    `SELECT p.side, p.shares, m.yes_shares, m.no_shares
     FROM feed_prediction_positions p
     JOIN feed_prediction_markets m ON m.id = p.market_id
     WHERE p.holder_id = $1 AND p.holder_kind = 'user' AND p.settled_at IS NULL AND p.shares > 0
       AND m.status = 'open' AND m.expires_at > $2`,
    [accountId, now]
  )
  let predValueCents = 0
  for (const row of predRows) {
    predValueCents += markToMarketPredictionCents(row.side, toInt(row.shares), toInt(row.yes_shares), toInt(row.no_shares))
  }
  const perpRows = try loadOpenPerpRows(tx, "user", accountId)
  let perpValueCents = 0
  for (const row of perpRows) {
    const equity = positionEquityAtMark(toSpecPerpPosition(row), toInt(row.mark_price_cents))
    perpValueCents += Math.max(0, equity)
  }
  const positionValueCents = predValueCents + perpValueCents
  const balanceCents = toInt(acct.balance_cents)
  const startingGrantCents = toInt(acct.starting_grant_cents)
  const verified = acct.phone_verified_at !== null || acct.email_verified_at !== null
  const ledger = buildLedger(accountId, verified, balanceCents, positionValueCents, startingGrantCents)
  return {
    accountId,
    handle: requiredText(acct.handle),
    displayName: requiredText(acct.display_name),
    verified,
    uiMode: requiredText(acct.ui_mode) === "social" ? "social" : "game",
    balanceCents,
    positionValueCents,
    equityCents: equityCents(ledger),
    startingGrantCents,
    totalFeesPaidCents: toInt(acct.total_fees_paid_cents),
    netProfitCents: netProfitCents(ledger)
  }
}

export effect function getAccountEconomy(accountId: string): AccountEconomyView!(MarketFailure | StoreFailure)!Store {
  const store = try Store
  return try store.transaction((tx: Tx) => getAccountEconomyIn(tx, accountId))
}

export effect function getPointLedger(accountId: string, limit = 50): ReadonlyArray<PointLedgerEntry>!StoreFailure!Store {
  const rowLimit = Math.max(1, Math.min(200, Math.floor(limit)))
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      `SELECT id, account_id, kind, delta_cents, balance_after_cents, ref_id, created_at
       FROM feed_point_ledger
       WHERE account_id = $1
       ORDER BY created_at DESC, id DESC
       LIMIT $2`,
      [accountId, rowLimit]
    )
    return rows.map((row) => ({
      id: requiredText(row.id),
      accountId: requiredText(row.account_id),
      kind: requiredText(row.kind),
      deltaCents: toInt(row.delta_cents),
      balanceAfterCents: toInt(row.balance_after_cents),
      refId: optionalText(row.ref_id),
      createdAt: toInt(row.created_at)
    }))
  })
}

type UnrankedLeaderboardRow = Omit<LeaderboardEntry, "rank">

function metricValueFor(entry: UnrankedLeaderboardRow, metric: LeaderboardMetric): number {
  switch (metric) {
    case "return_pct":
      return entry.returnBps
    case "win_rate":
      return entry.winRatePct
    case "volume":
      return entry.volumeCents
    case "net_profit":
      return entry.netProfitCents
  }
}

function rankScoredEntries(
  rows: ReadonlyArray<UnrankedLeaderboardRow>,
  metric: LeaderboardMetric
): ReadonlyArray<LeaderboardEntry> {
  const sorted = [...rows].sort((a, b) => {
    const primary = metricValueFor(b, metric) - metricValueFor(a, metric)
    if (primary !== 0) return primary
    if (b.netProfitCents !== a.netProfitCents) return b.netProfitCents - a.netProfitCents
    if (b.volumeCents !== a.volumeCents) return b.volumeCents - a.volumeCents
    return a.accountId.localeCompare(b.accountId)
  })
  const ranked: Array<LeaderboardEntry> = []
  let prevMetricValue: number | null = null
  let prevRank = 1
  for (let idx = 0; idx < sorted.length; idx++) {
    const row = sorted[idx]!
    const currentMetric = metricValueFor(row, metric)
    const rank = prevMetricValue !== null && currentMetric === prevMetricValue ? prevRank : idx + 1
    prevMetricValue = currentMetric
    prevRank = rank
    ranked.push({ rank, ...row })
  }
  return ranked
}

effect function loadTradingAggregatesTx(
  tx: Tx,
  holderKind: "user" | "npc",
  cutoffMs: number | null = null
): {
  readonly predValueMap: ReadonlyMap<string, number>
  readonly perpValueMap: ReadonlyMap<string, number>
  readonly openUnrealizedMap: ReadonlyMap<string, number>
  readonly volumeMap: ReadonlyMap<string, { readonly volumeCents: number; readonly tradeCount: number }>
  readonly statsMap: ReadonlyMap<string, { readonly wins: number; readonly settledCount: number; readonly realizedPnlCents: number }>
}!StoreFailure {
  const now = try Clock.currentTimeMillis
  const predRows = try tx.query(
    `SELECT p.holder_id, p.side, p.shares, p.cost_basis_cents, m.yes_shares, m.no_shares, m.status, m.expires_at
     FROM feed_prediction_positions p
     JOIN feed_prediction_markets m ON m.id = p.market_id
     WHERE p.holder_kind = $1 AND p.settled_at IS NULL AND p.shares > 0`,
    [holderKind]
  )
  const predValueMap = new Map<string, number>()
  const openUnrealizedMap = new Map<string, number>()
  for (const row of predRows) {
    const holderId = requiredText(row.holder_id)
    const tradeable = requiredText(row.status) === "open" && toInt(row.expires_at) > now
    const mtm = tradeable
      ? markToMarketPredictionCents(row.side, toInt(row.shares), toInt(row.yes_shares), toInt(row.no_shares))
      : 0
    const costBasis = toInt(row.cost_basis_cents)
    predValueMap.set(holderId, (predValueMap.get(holderId) ?? 0) + mtm)
    openUnrealizedMap.set(holderId, (openUnrealizedMap.get(holderId) ?? 0) + (mtm - costBasis))
  }
  const perpRows = try loadOpenPerpRows(tx, holderKind)
  const perpValueMap = new Map<string, number>()
  for (const row of perpRows) {
    const holderId = requiredText(row.holder_id)
    const specPos = toSpecPerpPosition(row)
    const mark = toInt(row.mark_price_cents)
    const equity = Math.max(0, positionEquityAtMark(specPos, mark))
    const clampedUnrealized = equity - specPos.marginCents - canonicalTradingFee(specPos.sizeCents)
    perpValueMap.set(holderId, (perpValueMap.get(holderId) ?? 0) + equity)
    openUnrealizedMap.set(holderId, (openUnrealizedMap.get(holderId) ?? 0) + clampedUnrealized)
  }
  const volumeRows = cutoffMs === null
    ? try tx.query(
        `SELECT trader_id, COALESCE(SUM(notional_cents), 0) AS volume_cents, COUNT(*) AS trade_count
         FROM feed_trades
         WHERE trader_kind = $1
         GROUP BY trader_id`,
        [holderKind]
      )
    : try tx.query(
        `SELECT trader_id, COALESCE(SUM(notional_cents), 0) AS volume_cents, COUNT(*) AS trade_count
         FROM feed_trades
         WHERE trader_kind = $1 AND created_at >= $2
         GROUP BY trader_id`,
        [holderKind, cutoffMs]
      )
  const volumeMap = new Map<string, { readonly volumeCents: number; readonly tradeCount: number }>()
  for (const row of volumeRows) {
    volumeMap.set(requiredText(row.trader_id), {
      volumeCents: toInt(row.volume_cents),
      tradeCount: toInt(row.trade_count)
    })
  }
  const cutoffParams = cutoffMs === null ? [holderKind] : [holderKind, cutoffMs]
  const settledCutoff = cutoffMs === null ? "" : " AND p.settled_at >= $2"
  const resolvedPredRows = try tx.query(
    `SELECT
       p.holder_id,
       COUNT(*) AS settled_count,
       SUM(CASE WHEN p.payout_cents > p.cost_basis_cents THEN 1 ELSE 0 END) AS wins,
       COALESCE(SUM(p.payout_cents - p.cost_basis_cents), 0) AS realized_pnl_cents
     FROM feed_prediction_positions p
     JOIN feed_prediction_markets m ON m.id = p.market_id
     WHERE p.holder_kind = $1
       AND p.settled_at IS NOT NULL${settledCutoff}
       AND p.shares > 0
       AND m.status = 'resolved'
     GROUP BY p.holder_id`,
    cutoffParams
  )
  const tradeCutoff = cutoffMs === null ? "" : " AND created_at >= $2"
  const tradeExitRows = try tx.query(
    `SELECT
       trader_id AS holder_id,
       COUNT(*) AS settled_count,
       SUM(CASE WHEN realized_pnl_cents > 0 THEN 1 ELSE 0 END) AS wins,
       COALESCE(SUM(realized_pnl_cents), 0) AS realized_pnl_cents
     FROM feed_trades
     WHERE trader_kind = $1${tradeCutoff}
       AND realized_pnl_cents IS NOT NULL
       AND (
         (market_kind = 'prediction' AND side IN ('sell_yes', 'sell_no'))
         OR (market_kind = 'perp' AND side IN ('close_long', 'close_short', 'reduce_long', 'reduce_short', 'liquidate_long', 'liquidate_short'))
       )
     GROUP BY trader_id`,
    cutoffParams
  )
  const statsMap = new Map<string, { wins: number; settledCount: number; realizedPnlCents: number }>()
  for (const row of [...resolvedPredRows, ...tradeExitRows]) {
    const holderId = requiredText(row.holder_id)
    const prev = statsMap.get(holderId) ?? { wins: 0, settledCount: 0, realizedPnlCents: 0 }
    statsMap.set(holderId, {
      wins: prev.wins + toInt(row.wins),
      settledCount: prev.settledCount + toInt(row.settled_count),
      realizedPnlCents: prev.realizedPnlCents + toInt(row.realized_pnl_cents)
    })
  }
  return { predValueMap, perpValueMap, openUnrealizedMap, volumeMap, statsMap }
}

function buildUnrankedLeaderboardRow(params: {
  readonly accountId: string
  readonly handle: string
  readonly displayName: string
  readonly avatarUrl: string | null
  readonly isNpc: boolean
  readonly balanceCents: number
  readonly positionValueCents: number
  readonly equityCents: number
  readonly startingGrantCents: number
  readonly profitCents: number
  readonly volume: { readonly volumeCents: number; readonly tradeCount: number }
  readonly stat: { readonly wins: number; readonly settledCount: number }
}): UnrankedLeaderboardRow {
  const returnBps = params.startingGrantCents > 0
    ? Math.round((params.profitCents * 10_000) / params.startingGrantCents)
    : 0
  const winRate = params.stat.settledCount === 0 ? 0 : params.stat.wins / params.stat.settledCount
  return {
    accountId: params.accountId,
    handle: params.handle,
    displayName: params.displayName,
    avatarUrl: params.avatarUrl,
    isNpc: params.isNpc,
    balanceCents: params.balanceCents,
    positionValueCents: params.positionValueCents,
    equityCents: params.equityCents,
    startingGrantCents: params.startingGrantCents,
    netProfitCents: params.profitCents,
    returnBps,
    returnPct: returnBps / 100,
    roiPct: returnBps / 100,
    volumeCents: params.volume.volumeCents,
    tradeCount: params.volume.tradeCount,
    wins: params.stat.wins,
    settledCount: params.stat.settledCount,
    winRate,
    winRatePct: Math.round(winRate * 100),
    isFollowing: false
  }
}

effect function hydrateLeaderboardFollowStateTx(
  tx: Tx,
  entries: ReadonlyArray<LeaderboardEntry>,
  viewerAccountId: string | undefined
): ReadonlyArray<LeaderboardEntry>!StoreFailure {
  if (viewerAccountId === undefined || viewerAccountId.trim() === "" || entries.length === 0) {
    return entries
  }
  const targetIds = [...new Set(entries.map((entry) => entry.accountId).filter((id) => id !== "" && id !== viewerAccountId))]
  if (targetIds.length === 0) return entries
  const followRows = try tx.query(
    "SELECT target_id FROM feed_follows WHERE follower_id = $1 AND target_id = ANY($2)",
    [viewerAccountId, targetIds]
  )
  const followedSet = new Set<string>()
  for (const row of followRows) {
    const tid = optionalText(row.target_id)
    if (tid !== null) followedSet.add(tid)
  }
  return entries.map((entry) => ({
    ...entry,
    isFollowing: followedSet.has(entry.accountId)
  }))
}

effect function scorePlayerLeaderboardTx(tx: Tx, cutoffMs: number | null = null): ReadonlyArray<UnrankedLeaderboardRow>!StoreFailure {
  const accounts = try tx.query(
    `SELECT fa.account_id, fa.handle, fa.display_name, fa.avatar_url, fa.phone_verified_at, fa.email_verified_at, fa.balance_cents, fa.starting_grant_cents
     FROM feed_accounts fa
     INNER JOIN accounts a ON a.key = fa.account_id
     WHERE fa.is_reviewer = false
       AND (fa.phone_verified_at IS NOT NULL OR fa.email_verified_at IS NOT NULL)
       AND a.status = 'active'`
  )
  const { predValueMap, perpValueMap, openUnrealizedMap, volumeMap, statsMap } = try loadTradingAggregatesTx(tx, "user", cutoffMs)
  return accounts.map((acct) => {
    const accountId = requiredText(acct.account_id)
    const balanceCents = toInt(acct.balance_cents)
    const startingGrantCents = toInt(acct.starting_grant_cents)
    const positionValueCents = (predValueMap.get(accountId) ?? 0) + (perpValueMap.get(accountId) ?? 0)
    const ledger = buildLedger(accountId, true, balanceCents, positionValueCents, startingGrantCents)
    const stat = statsMap.get(accountId) ?? { wins: 0, settledCount: 0, realizedPnlCents: 0 }
    return buildUnrankedLeaderboardRow({
      accountId,
      handle: requiredText(acct.handle),
      displayName: requiredText(acct.display_name),
      avatarUrl: optionalText(acct.avatar_url),
      isNpc: false,
      balanceCents,
      positionValueCents,
      equityCents: equityCents(ledger),
      startingGrantCents,
      profitCents: cutoffMs === null ? netProfitCents(ledger) : stat.realizedPnlCents + (openUnrealizedMap.get(accountId) ?? 0),
      volume: volumeMap.get(accountId) ?? { volumeCents: 0, tradeCount: 0 },
      stat
    })
  })
}

effect function scoreCharacterLeaderboardTx(tx: Tx, cutoffMs: number | null = null): ReadonlyArray<UnrankedLeaderboardRow>!StoreFailure {
  const actors = try tx.query(
    `SELECT id, username, name, tier, profile_image_url, balance_cents
     FROM feed_actors
     WHERE id NOT LIKE 'test-%' AND id NOT LIKE 'org-%'
     ORDER BY id ASC`
  )
  const { predValueMap, perpValueMap, openUnrealizedMap, volumeMap, statsMap } = try loadTradingAggregatesTx(tx, "npc", cutoffMs)
  const holdingRows = try tx.query(
    `SELECT h.actor_id, h.ticker, h.base_units, sp.index_price_cents, COALESCE(o.initial_price_cents, sp.index_price_cents) AS initial_price_cents
     FROM feed_npc_spot_holdings h
     JOIN feed_spot_pools sp ON sp.ticker = h.ticker
     LEFT JOIN feed_organizations o ON o.id = sp.organization_id`
  )
  const spotDeltaRows = try tx.query(
    `SELECT trader_id, market_ref AS ticker,
            COALESCE(SUM(CASE WHEN side = 'buy' THEN shares_or_size ELSE -shares_or_size END), 0) AS net_base_delta
     FROM feed_trades
     WHERE trader_kind = 'npc' AND market_kind = 'spot'
     GROUP BY trader_id, market_ref`
  )
  const spotDeltaMap = new Map<string, number>()
  for (const row of spotDeltaRows) {
    spotDeltaMap.set(`${requiredText(row.trader_id)}:${requiredText(row.ticker)}`, toInt(row.net_base_delta))
  }
  const spotValueMap = new Map<string, number>()
  const spotBaselineMap = new Map<string, number>()
  for (const row of holdingRows) {
    const actorId = requiredText(row.actor_id)
    const ticker = requiredText(row.ticker)
    const baseUnits = toInt(row.base_units)
    const indexPriceCents = toInt(row.index_price_cents)
    const initialPriceCents = toInt(row.initial_price_cents)
    const currentValue = Math.floor((baseUnits * indexPriceCents) / SPOT_BASE_SCALE)
    const netDelta = spotDeltaMap.get(`${actorId}:${ticker}`) ?? 0
    const initialUnits = Math.max(0, baseUnits - netDelta)
    const baselineValue = Math.floor((initialUnits * initialPriceCents) / SPOT_BASE_SCALE)
    spotValueMap.set(actorId, (spotValueMap.get(actorId) ?? 0) + currentValue)
    spotBaselineMap.set(actorId, (spotBaselineMap.get(actorId) ?? 0) + baselineValue)
  }
  return actors.map((actor) => {
    const actorId = requiredText(actor.id)
    const balanceCents = toInt(actor.balance_cents)
    const positionValueCents = (predValueMap.get(actorId) ?? 0) + (perpValueMap.get(actorId) ?? 0) + (spotValueMap.get(actorId) ?? 0)
    const startingGrantCents = tierStartingBalanceCents(requiredText(actor.tier)) + (spotBaselineMap.get(actorId) ?? 0)
    const equity = balanceCents + positionValueCents
    const stat = statsMap.get(actorId) ?? { wins: 0, settledCount: 0, realizedPnlCents: 0 }
    return buildUnrankedLeaderboardRow({
      accountId: actorId,
      handle: requiredText(actor.username, actorId).toLowerCase(),
      displayName: requiredText(actor.name),
      avatarUrl: actorId !== "" ? resolveActorAvatarUrl(actorId, optionalText(actor.profile_image_url)) : null,
      isNpc: true,
      balanceCents,
      positionValueCents,
      equityCents: equity,
      startingGrantCents,
      profitCents: cutoffMs === null ? equity - startingGrantCents : stat.realizedPnlCents + (openUnrealizedMap.get(actorId) ?? 0),
      volume: volumeMap.get(actorId) ?? { volumeCents: 0, tradeCount: 0 },
      stat
    })
  })
}

export effect function getLeaderboard(input: GetLeaderboardInput = {}): LeaderboardPage!StoreFailure!Store {
  const scope: LeaderboardScope = input.scope === "characters" ? "characters" : "players"
  const metric: LeaderboardMetric = input.metric === "return_pct" || input.metric === "win_rate" || input.metric === "volume"
    ? input.metric
    : "net_profit"
  const pageSize = Math.max(1, Math.min(200, Math.floor(input.pageSize ?? 50)))
  const requestedPage = Math.max(1, Math.floor(input.page ?? 1))
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const scored = scope === "characters"
      ? try scoreCharacterLeaderboardTx(tx)
      : try scorePlayerLeaderboardTx(tx)
    const ranked = rankScoredEntries(scored, metric)
    const totalCount = ranked.length
    const totalPages = Math.max(1, Math.ceil(totalCount / pageSize))
    const page = Math.min(requestedPage, totalPages)
    const offset = (page - 1) * pageSize
    const entries = try hydrateLeaderboardFollowStateTx(tx, ranked.slice(offset, offset + pageSize), input.viewerAccountId)
    const currentUser = input.viewerAccountId !== undefined
      ? (ranked.find((entry) => entry.accountId === input.viewerAccountId) ?? null)
      : null
    return {
      scope,
      metric,
      entries,
      totalCount,
      totalPages,
      page,
      pageSize,
      currentUser
    }
  })
}

export effect function getAccountLeaderboardRank(
  accountId: string,
  metric: LeaderboardMetric = "net_profit",
  pageSize = 50
): (AccountLeaderboardPosition | null)!StoreFailure!Store {
  const safePageSize = Math.max(1, Math.min(200, Math.floor(pageSize)))
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const scored = try scorePlayerLeaderboardTx(tx)
    const ranked = rankScoredEntries(scored, metric)
    const idx = ranked.findIndex((entry) => entry.accountId === accountId)
    if (idx === -1) return null
    const entry = ranked[idx]!
    return {
      rank: entry.rank,
      page: Math.floor(idx / safePageSize) + 1,
      totalCount: ranked.length,
      entry
    }
  })
}

effect function computeFilteredRankedLeaderboardTx(
  tx: Tx,
  filter: LeaderboardFilter,
  timeframe: LeaderboardTimeframe,
  metric: LeaderboardMetric,
  nowMs: number
): ReadonlyArray<LeaderboardEntry>!StoreFailure {
  const cutoffMs = timeframeCutoffMs(timeframe, nowMs)
  const players = filter === "all" || filter === "traders"
    ? try scorePlayerLeaderboardTx(tx, cutoffMs)
    : []
  const characters = filter === "all" || filter === "npcs"
    ? try scoreCharacterLeaderboardTx(tx, cutoffMs)
    : []
  return rankScoredEntries([...players, ...characters], metric)
}

function normalizeLeaderboardQuery(options: Omit<LeaderboardQueryOptions, "page">) {
  const filter = options.filter ?? "all"
  const timeframe = options.timeframe ?? "all"
  const metric: LeaderboardMetric = options.metric === "return_pct" || options.metric === "win_rate" || options.metric === "volume"
    ? options.metric
    : "net_profit"
  const safePageSize = Math.max(1, Math.min(200, Math.floor(options.pageSize ?? 50)))
  return { filter, timeframe, metric, safePageSize }
}

export effect function getFilteredLeaderboardPage(
  options: LeaderboardQueryOptions = {}
): FilteredLeaderboardPage!StoreFailure!Store {
  const { filter, timeframe, metric, safePageSize } = normalizeLeaderboardQuery(options)
  const requestedPage = Math.max(1, Math.floor(options.page ?? 1))
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const ranked = try computeFilteredRankedLeaderboardTx(tx, filter, timeframe, metric, now)
    const totalCount = ranked.length
    const totalPages = Math.max(1, Math.ceil(totalCount / safePageSize))
    const safePage = Math.min(requestedPage, totalPages)
    const offset = (safePage - 1) * safePageSize
    const entries = try hydrateLeaderboardFollowStateTx(tx, ranked.slice(offset, offset + safePageSize), options.viewerAccountId)
    const currentUser = options.viewerAccountId !== undefined
      ? (ranked.find((entry) => !entry.isNpc && entry.accountId === options.viewerAccountId) ?? null)
      : null
    return {
      metric,
      entries,
      pagination: {
        page: safePage,
        pageSize: safePageSize,
        totalCount,
        totalPages
      },
      currentUser,
      generatedAt: now
    }
  })
}

export effect function getFilteredLeaderboardViewerRank(
  accountId: string,
  options: Omit<LeaderboardQueryOptions, "page"> = {}
): LeaderboardViewerRank!StoreFailure!Store {
  const { filter, timeframe, metric, safePageSize } = normalizeLeaderboardQuery(options)
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const ranked = try computeFilteredRankedLeaderboardTx(tx, filter, timeframe, metric, now)
    const idx = ranked.findIndex((entry) => !entry.isNpc && entry.accountId === accountId)
    if (idx === -1) return { rank: null, page: null, entry: null }
    const entry = ranked[idx]!
    return {
      rank: entry.rank,
      page: Math.floor(idx / safePageSize) + 1,
      entry
    }
  })
}
