// spec/markets/economy.md, "Story: Verify account and claim initial grant once"; spec/markets/economy.md, "Story: Trade with fixed starting capital and rank by net profit"; spec/shared/money.md, "One point equals one hundred cents, and integer bounds clamp cleanly"
import {
  Store,
  type StoreFailure,
  resolveActorAvatarUrl,
  tierStartingBalanceCents,
  toInt,
  toText,
  type Row,
  type Tx
} from "@repo/db"
import { BPS_DENOMINATOR } from "../gen/shared__money.effect.vibe"
import {
  equityCents,
  netProfitCents,
  type PlayerLedger
} from "../gen/markets__economy.effect.vibe"
import { yesOddsBps } from "../gen/markets__prediction.effect.vibe"
import { positionEquityAtMark, unrealizedPnlAtMark } from "../gen/markets__spotPerp.effect.vibe"
import {
  type MarketFailure,
  marketFail,
  optionalText,
  requiredText,
  toSpecPerpPosition
} from "./shared.vibe"

export type LeaderboardFilter = "all" | "traders" | "npcs"
export type LeaderboardTimeframe = "24h" | "7d" | "30d" | "all"

export interface AccountEconomyView {
  readonly accountId: string
  readonly handle: string
  readonly displayName: string
  readonly verified: boolean
  readonly uiMode: "game" | "social"
  readonly balanceCents: number
  readonly positionValueCents: number
  readonly equityCents: number
  readonly startingGrantCents: number
  readonly totalFeesPaidCents: number
  readonly netProfitCents: number
}

export interface PointLedgerEntry {
  readonly id: string
  readonly accountId: string
  readonly kind: string
  readonly deltaCents: number
  readonly balanceAfterCents: number
  readonly refId: string | null
  readonly createdAt: number
}

export interface LeaderboardEntry {
  readonly rank: number
  readonly accountId: string
  readonly handle: string
  readonly displayName: string
  readonly avatarUrl: string | null
  readonly isNpc: boolean
  readonly balanceCents: number
  readonly positionValueCents: number
  readonly equityCents: number
  readonly startingGrantCents: number
  readonly netProfitCents: number
  readonly roiPct: number
  readonly volumeCents: number
  readonly tradeCount: number
  readonly wins: number
  readonly settledCount: number
  readonly winRate: number
  readonly winRatePct: number
}

export interface LeaderboardPagination {
  readonly page: number
  readonly pageSize: number
  readonly totalCount: number
  readonly totalPages: number
}

export interface LeaderboardPage {
  readonly entries: ReadonlyArray<LeaderboardEntry>
  readonly pagination: LeaderboardPagination
  readonly generatedAt: number
}

export interface LeaderboardViewerRank {
  readonly rank: number | null
  readonly page: number | null
  readonly entry: LeaderboardEntry | null
}

export interface LeaderboardQueryOptions {
  readonly filter?: LeaderboardFilter
  readonly timeframe?: LeaderboardTimeframe
  readonly page?: number
  readonly pageSize?: number
}

export function parseLeaderboardFilter(raw: string | null | undefined): LeaderboardFilter {
  const norm = raw?.trim().toLowerCase()
  if (norm === "traders" || norm === "humans") return "traders"
  if (norm === "npcs" || norm === "actors") return "npcs"
  return "all"
}

export function parseLeaderboardTimeframe(raw: string | null | undefined): LeaderboardTimeframe {
  const norm = raw?.trim().toLowerCase()
  if (norm === "24h" || norm === "1d") return "24h"
  if (norm === "7d" || norm === "1w") return "7d"
  if (norm === "30d" || norm === "1m") return "30d"
  return "all"
}

function timeframeCutoffMs(timeframe: LeaderboardTimeframe, nowMs: number): number | null {
  switch (timeframe) {
    case "24h":
      return nowMs - 86_400_000
    case "7d":
      return nowMs - 7 * 86_400_000
    case "30d":
      return nowMs - 30 * 86_400_000
    case "all":
      return null
  }
}

function buildLedger(
  accountId: string,
  verified: boolean,
  cashCents: number,
  positionValueCents: number,
  startingGrantCents: number
): PlayerLedger {
  return {
    id: accountId,
    verified,
    grantClaimed: verified,
    cashCents,
    positionValueCents,
    startingGrantCents
  }
}

function markToMarketPredictionCents(side: unknown, shares: number, yesShares: number, noShares: number): number {
  const yesPriceBps = yesOddsBps(yesShares, noShares)
  const sidePriceBps = toText(side)?.toUpperCase() === "NO" ? BPS_DENOMINATOR - yesPriceBps : yesPriceBps
  return Math.floor((shares * sidePriceBps) / BPS_DENOMINATOR)
}

effect function loadOpenPerpRows(tx: Tx, holderKind?: "user" | "npc", accountId?: string): ReadonlyArray<Row>!StoreFailure {
  if (accountId !== undefined) {
    return try tx.query(
      `SELECT p.holder_id, p.holder_kind, p.side, p.margin_cents, p.size_cents, p.entry_price_cents, p.leverage, p.accrued_funding_cents, p.last_funding_period, p.created_at, m.mark_price_cents
       FROM feed_perp_positions p
       JOIN feed_perp_markets m ON m.ticker = p.ticker
       WHERE p.holder_kind = 'user' AND p.status = 'open' AND p.holder_id = $1`,
      [accountId]
    )
  }
  if (holderKind !== undefined) {
    return try tx.query(
      `SELECT p.holder_id, p.holder_kind, p.side, p.margin_cents, p.size_cents, p.entry_price_cents, p.leverage, p.accrued_funding_cents, p.last_funding_period, p.created_at, m.mark_price_cents
       FROM feed_perp_positions p
       JOIN feed_perp_markets m ON m.ticker = p.ticker
       WHERE p.holder_kind = $1 AND p.status = 'open'`,
      [holderKind]
    )
  }
  return try tx.query(
    `SELECT p.holder_id, p.holder_kind, p.side, p.margin_cents, p.size_cents, p.entry_price_cents, p.leverage, p.accrued_funding_cents, p.last_funding_period, p.created_at, m.mark_price_cents
     FROM feed_perp_positions p
     JOIN feed_perp_markets m ON m.ticker = p.ticker
     WHERE p.status = 'open'`
  )
}

export effect function getAccountEconomyIn(tx: Tx, accountId: string): AccountEconomyView!(MarketFailure | StoreFailure) {
  const accountRows = try tx.query(
    `SELECT account_id, handle, display_name, phone_verified_at, ui_mode, balance_cents, starting_grant_cents, total_fees_paid_cents
     FROM feed_accounts
     WHERE account_id = $1`,
    [accountId]
  )
  if (accountRows.length === 0) {
    throw marketFail("ACCOUNT_NOT_FOUND", `Account not found: ${accountId}`)
  }
  const acct = accountRows[0]!
  const predRows = try tx.query(
    `SELECT p.side, p.shares, m.yes_shares, m.no_shares
     FROM feed_prediction_positions p
     JOIN feed_prediction_markets m ON m.id = p.market_id
     WHERE p.holder_id = $1 AND p.holder_kind = 'user' AND p.settled_at IS NULL AND p.shares > 0`,
    [accountId]
  )
  let predValueCents = 0
  for (const row of predRows) {
    predValueCents += markToMarketPredictionCents(row.side, toInt(row.shares), toInt(row.yes_shares), toInt(row.no_shares))
  }
  const perpRows = try loadOpenPerpRows(tx, "user", accountId)
  let perpValueCents = 0
  for (const row of perpRows) {
    const equity = positionEquityAtMark(toSpecPerpPosition(row), toInt(row.mark_price_cents))
    perpValueCents += Math.max(0, equity)
  }
  const positionValueCents = predValueCents + perpValueCents
  const balanceCents = toInt(acct.balance_cents)
  const startingGrantCents = toInt(acct.starting_grant_cents)
  const verified = acct.phone_verified_at !== null
  const ledger = buildLedger(accountId, verified, balanceCents, positionValueCents, startingGrantCents)
  return {
    accountId,
    handle: requiredText(acct.handle),
    displayName: requiredText(acct.display_name),
    verified,
    uiMode: requiredText(acct.ui_mode) === "social" ? "social" : "game",
    balanceCents,
    positionValueCents,
    equityCents: equityCents(ledger),
    startingGrantCents,
    totalFeesPaidCents: toInt(acct.total_fees_paid_cents),
    netProfitCents: netProfitCents(ledger)
  }
}

export effect function getAccountEconomy(accountId: string): AccountEconomyView!(MarketFailure | StoreFailure)!Store {
  const store = try Store
  return try store.transaction((tx: Tx) => getAccountEconomyIn(tx, accountId))
}

export effect function getPointLedger(accountId: string, limit = 50): ReadonlyArray<PointLedgerEntry>!StoreFailure!Store {
  const safeLimit = Math.max(1, Math.min(200, Math.floor(limit)))
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      `SELECT id, account_id, kind, delta_cents, balance_after_cents, ref_id, created_at
       FROM feed_point_ledger
       WHERE account_id = $1
       ORDER BY created_at DESC, id DESC
       LIMIT $2`,
      [accountId, safeLimit]
    )
    return rows.map((row) => ({
      id: requiredText(row.id),
      accountId: requiredText(row.account_id),
      kind: requiredText(row.kind),
      deltaCents: toInt(row.delta_cents),
      balanceAfterCents: toInt(row.balance_after_cents),
      refId: optionalText(row.ref_id),
      createdAt: toInt(row.created_at)
    }))
  })
}

interface LeaderboardAggregateMaps {
  readonly volumeMap: ReadonlyMap<string, { readonly volumeCents: number; readonly tradeCount: number }>
  readonly statsMap: ReadonlyMap<string, { readonly wins: number; readonly settledCount: number; readonly realizedPnlCents: number }>
}

effect function loadLeaderboardStatsMapsTx(
  tx: Tx,
  kindFilter: "user" | "npc" | undefined,
  cutoffMs: number | null
): LeaderboardAggregateMaps!StoreFailure {
  const volumeRows = cutoffMs === null
    ? (kindFilter === undefined
        ? try tx.query(
            `SELECT trader_id, trader_kind, COALESCE(SUM(notional_cents), 0) AS volume_cents, COUNT(*) AS trade_count
             FROM feed_trades
             GROUP BY trader_id, trader_kind`
          )
        : try tx.query(
            `SELECT trader_id, trader_kind, COALESCE(SUM(notional_cents), 0) AS volume_cents, COUNT(*) AS trade_count
             FROM feed_trades
             WHERE trader_kind = $1
             GROUP BY trader_id, trader_kind`,
            [kindFilter]
          ))
    : (kindFilter === undefined
        ? try tx.query(
            `SELECT trader_id, trader_kind, COALESCE(SUM(notional_cents), 0) AS volume_cents, COUNT(*) AS trade_count
             FROM feed_trades
             WHERE created_at >= $1
             GROUP BY trader_id, trader_kind`,
            [cutoffMs]
          )
        : try tx.query(
            `SELECT trader_id, trader_kind, COALESCE(SUM(notional_cents), 0) AS volume_cents, COUNT(*) AS trade_count
             FROM feed_trades
             WHERE trader_kind = $1 AND created_at >= $2
             GROUP BY trader_id, trader_kind`,
            [kindFilter, cutoffMs]
          ))
  const volumeMap = new Map<string, { readonly volumeCents: number; readonly tradeCount: number }>()
  for (const row of volumeRows) {
    const key = `${requiredText(row.trader_kind)}:${requiredText(row.trader_id)}`
    volumeMap.set(key, {
      volumeCents: toInt(row.volume_cents),
      tradeCount: toInt(row.trade_count)
    })
  }
  const predStatsRows = cutoffMs === null
    ? (kindFilter === undefined
        ? try tx.query(
            `SELECT p.holder_id, p.holder_kind, COUNT(*) AS settled_count,
               SUM(CASE WHEN p.payout_cents > p.cost_basis_cents THEN 1 ELSE 0 END) AS wins,
               COALESCE(SUM(p.payout_cents - p.cost_basis_cents), 0) AS realized_pnl_cents
             FROM feed_prediction_positions p
             JOIN feed_prediction_markets m ON m.id = p.market_id
             WHERE p.settled_at IS NOT NULL AND p.shares > 0 AND m.status = 'resolved'
             GROUP BY p.holder_id, p.holder_kind`
          )
        : try tx.query(
            `SELECT p.holder_id, p.holder_kind, COUNT(*) AS settled_count,
               SUM(CASE WHEN p.payout_cents > p.cost_basis_cents THEN 1 ELSE 0 END) AS wins,
               COALESCE(SUM(p.payout_cents - p.cost_basis_cents), 0) AS realized_pnl_cents
             FROM feed_prediction_positions p
             JOIN feed_prediction_markets m ON m.id = p.market_id
             WHERE p.holder_kind = $1 AND p.settled_at IS NOT NULL AND p.shares > 0 AND m.status = 'resolved'
             GROUP BY p.holder_id, p.holder_kind`,
            [kindFilter]
          ))
    : (kindFilter === undefined
        ? try tx.query(
            `SELECT p.holder_id, p.holder_kind, COUNT(*) AS settled_count,
               SUM(CASE WHEN p.payout_cents > p.cost_basis_cents THEN 1 ELSE 0 END) AS wins,
               COALESCE(SUM(p.payout_cents - p.cost_basis_cents), 0) AS realized_pnl_cents
             FROM feed_prediction_positions p
             JOIN feed_prediction_markets m ON m.id = p.market_id
             WHERE p.settled_at IS NOT NULL AND p.settled_at >= $1 AND p.shares > 0 AND m.status = 'resolved'
             GROUP BY p.holder_id, p.holder_kind`,
            [cutoffMs]
          )
        : try tx.query(
            `SELECT p.holder_id, p.holder_kind, COUNT(*) AS settled_count,
               SUM(CASE WHEN p.payout_cents > p.cost_basis_cents THEN 1 ELSE 0 END) AS wins,
               COALESCE(SUM(p.payout_cents - p.cost_basis_cents), 0) AS realized_pnl_cents
             FROM feed_prediction_positions p
             JOIN feed_prediction_markets m ON m.id = p.market_id
             WHERE p.holder_kind = $1 AND p.settled_at IS NOT NULL AND p.settled_at >= $2 AND p.shares > 0 AND m.status = 'resolved'
             GROUP BY p.holder_id, p.holder_kind`,
            [kindFilter, cutoffMs]
          ))
  const perpStatsRows = cutoffMs === null
    ? (kindFilter === undefined
        ? try tx.query(
            `SELECT holder_id, holder_kind, COUNT(*) AS settled_count,
               SUM(CASE WHEN realized_pnl_cents > 0 THEN 1 ELSE 0 END) AS wins,
               COALESCE(SUM(realized_pnl_cents), 0) AS realized_pnl_cents
             FROM feed_perp_positions
             WHERE status IN ('closed', 'liquidated')
             GROUP BY holder_id, holder_kind`
          )
        : try tx.query(
            `SELECT holder_id, holder_kind, COUNT(*) AS settled_count,
               SUM(CASE WHEN realized_pnl_cents > 0 THEN 1 ELSE 0 END) AS wins,
               COALESCE(SUM(realized_pnl_cents), 0) AS realized_pnl_cents
             FROM feed_perp_positions
             WHERE holder_kind = $1 AND status IN ('closed', 'liquidated')
             GROUP BY holder_id, holder_kind`,
            [kindFilter]
          ))
    : (kindFilter === undefined
        ? try tx.query(
            `SELECT holder_id, holder_kind, COUNT(*) AS settled_count,
               SUM(CASE WHEN realized_pnl_cents > 0 THEN 1 ELSE 0 END) AS wins,
               COALESCE(SUM(realized_pnl_cents), 0) AS realized_pnl_cents
             FROM feed_perp_positions
             WHERE status IN ('closed', 'liquidated') AND closed_at >= $1
             GROUP BY holder_id, holder_kind`,
            [cutoffMs]
          )
        : try tx.query(
            `SELECT holder_id, holder_kind, COUNT(*) AS settled_count,
               SUM(CASE WHEN realized_pnl_cents > 0 THEN 1 ELSE 0 END) AS wins,
               COALESCE(SUM(realized_pnl_cents), 0) AS realized_pnl_cents
             FROM feed_perp_positions
             WHERE holder_kind = $1 AND status IN ('closed', 'liquidated') AND closed_at >= $2
             GROUP BY holder_id, holder_kind`,
            [kindFilter, cutoffMs]
          ))
  const statsMap = new Map<string, { wins: number; settledCount: number; realizedPnlCents: number }>()
  for (const row of [...predStatsRows, ...perpStatsRows]) {
    const key = `${requiredText(row.holder_kind)}:${requiredText(row.holder_id)}`
    const prev = statsMap.get(key) ?? { wins: 0, settledCount: 0, realizedPnlCents: 0 }
    statsMap.set(key, {
      wins: prev.wins + toInt(row.wins),
      settledCount: prev.settledCount + toInt(row.settled_count),
      realizedPnlCents: prev.realizedPnlCents + toInt(row.realized_pnl_cents)
    })
  }
  return { volumeMap, statsMap }
}

effect function computeRankedLeaderboardTx(
  tx: Tx,
  filter: LeaderboardFilter,
  timeframe: LeaderboardTimeframe,
  nowMs: number
): ReadonlyArray<LeaderboardEntry>!StoreFailure {
  const includeTraders = filter === "all" || filter === "traders"
  const includeNpcs = filter === "all" || filter === "npcs"
  const cutoffMs = timeframeCutoffMs(timeframe, nowMs)
  const kindFilter = includeTraders && includeNpcs ? undefined : includeTraders ? "user" : "npc"

  const accounts = includeTraders
    ? try tx.query(
        `SELECT fa.account_id, fa.handle, fa.display_name, fa.avatar_url, fa.phone_verified_at, fa.balance_cents, fa.starting_grant_cents
         FROM feed_accounts fa
         LEFT JOIN accounts a ON a.key = fa.account_id
         WHERE fa.is_reviewer = false
           AND fa.phone_verified_at IS NOT NULL
           AND (a.key IS NULL OR a.status = 'active')`
      )
    : []

  const actors = includeNpcs
    ? try tx.query(
        `SELECT id, username, name, tier, profile_image_url, balance_cents
         FROM feed_actors
         WHERE id NOT LIKE 'test-%'`
      )
    : []

  const predRows = kindFilter === undefined
    ? try tx.query(
        `SELECT p.holder_id, p.holder_kind, p.side, p.shares, p.cost_basis_cents, m.yes_shares, m.no_shares
         FROM feed_prediction_positions p
         JOIN feed_prediction_markets m ON m.id = p.market_id
         WHERE p.settled_at IS NULL AND p.shares > 0`
      )
    : try tx.query(
        `SELECT p.holder_id, p.holder_kind, p.side, p.shares, p.cost_basis_cents, m.yes_shares, m.no_shares
         FROM feed_prediction_positions p
         JOIN feed_prediction_markets m ON m.id = p.market_id
         WHERE p.holder_kind = $1 AND p.settled_at IS NULL AND p.shares > 0`,
        [kindFilter]
      )
  const predValueMap = new Map<string, number>()
  const openUnrealizedMap = new Map<string, number>()
  for (const row of predRows) {
    const key = `${requiredText(row.holder_kind)}:${requiredText(row.holder_id)}`
    const mtm = markToMarketPredictionCents(row.side, toInt(row.shares), toInt(row.yes_shares), toInt(row.no_shares))
    const costBasis = toInt(row.cost_basis_cents)
    predValueMap.set(key, (predValueMap.get(key) ?? 0) + mtm)
    openUnrealizedMap.set(key, (openUnrealizedMap.get(key) ?? 0) + (mtm - costBasis))
  }

  const perpRows = try loadOpenPerpRows(tx, kindFilter)
  const perpValueMap = new Map<string, number>()
  for (const row of perpRows) {
    const key = `${requiredText(row.holder_kind)}:${requiredText(row.holder_id)}`
    const specPos = toSpecPerpPosition(row)
    const mark = toInt(row.mark_price_cents)
    const equity = Math.max(0, positionEquityAtMark(specPos, mark))
    perpValueMap.set(key, (perpValueMap.get(key) ?? 0) + equity)
    openUnrealizedMap.set(key, (openUnrealizedMap.get(key) ?? 0) + unrealizedPnlAtMark(specPos, mark))
  }

  const { volumeMap, statsMap } = try loadLeaderboardStatsMapsTx(tx, kindFilter, cutoffMs)

  const scored: Array<Omit<LeaderboardEntry, "rank">> = []

  for (const acct of accounts) {
    const accountId = requiredText(acct.account_id)
    const key = `user:${accountId}`
    const balanceCents = toInt(acct.balance_cents)
    const startingGrantCents = toInt(acct.starting_grant_cents)
    const positionValueCents = (predValueMap.get(key) ?? 0) + (perpValueMap.get(key) ?? 0)
    const verified = acct.phone_verified_at !== null
    const ledger = buildLedger(accountId, verified, balanceCents, positionValueCents, startingGrantCents)
    const totalEquityCents = equityCents(ledger)
    const vol = volumeMap.get(key) ?? { volumeCents: 0, tradeCount: 0 }
    const stat = statsMap.get(key) ?? { wins: 0, settledCount: 0, realizedPnlCents: 0 }
    const computedNetProfitCents = cutoffMs === null
      ? netProfitCents(ledger)
      : stat.realizedPnlCents + (openUnrealizedMap.get(key) ?? 0)
    const roiPct = startingGrantCents > 0
      ? Math.round((computedNetProfitCents / startingGrantCents) * 10_000) / 100
      : 0
    const winRate = stat.settledCount === 0 ? 0 : stat.wins / stat.settledCount
    const winRatePct = stat.settledCount === 0 ? 0 : Math.round(winRate * 10_000) / 100
    scored.push({
      accountId,
      handle: requiredText(acct.handle),
      displayName: requiredText(acct.display_name),
      avatarUrl: optionalText(acct.avatar_url),
      isNpc: false,
      balanceCents,
      positionValueCents,
      equityCents: totalEquityCents,
      startingGrantCents,
      netProfitCents: computedNetProfitCents,
      roiPct,
      volumeCents: vol.volumeCents,
      tradeCount: vol.tradeCount,
      wins: stat.wins,
      settledCount: stat.settledCount,
      winRate,
      winRatePct
    })
  }

  for (const actor of actors) {
    const actorId = requiredText(actor.id)
    const key = `npc:${actorId}`
    const balanceCents = toInt(actor.balance_cents)
    const startingGrantCents = tierStartingBalanceCents(requiredText(actor.tier))
    const positionValueCents = (predValueMap.get(key) ?? 0) + (perpValueMap.get(key) ?? 0)
    const totalEquityCents = balanceCents + positionValueCents
    const vol = volumeMap.get(key) ?? { volumeCents: 0, tradeCount: 0 }
    const stat = statsMap.get(key) ?? { wins: 0, settledCount: 0, realizedPnlCents: 0 }
    const computedNetProfitCents = cutoffMs === null
      ? totalEquityCents - startingGrantCents
      : stat.realizedPnlCents + (openUnrealizedMap.get(key) ?? 0)
    const roiPct = startingGrantCents > 0
      ? Math.round((computedNetProfitCents / startingGrantCents) * 10_000) / 100
      : 0
    const winRate = stat.settledCount === 0 ? 0 : stat.wins / stat.settledCount
    const winRatePct = stat.settledCount === 0 ? 0 : Math.round(winRate * 10_000) / 100
    scored.push({
      accountId: actorId,
      handle: requiredText(actor.username, actorId),
      displayName: requiredText(actor.name, actorId),
      avatarUrl: optionalText(actor.profile_image_url) ?? (actorId !== "" ? resolveActorAvatarUrl(actorId) : null),
      isNpc: true,
      balanceCents,
      positionValueCents,
      equityCents: totalEquityCents,
      startingGrantCents,
      netProfitCents: computedNetProfitCents,
      roiPct,
      volumeCents: vol.volumeCents,
      tradeCount: vol.tradeCount,
      wins: stat.wins,
      settledCount: stat.settledCount,
      winRate,
      winRatePct
    })
  }

  scored.sort((a, b) => {
    if (b.netProfitCents !== a.netProfitCents) return b.netProfitCents - a.netProfitCents
    if (b.volumeCents !== a.volumeCents) return b.volumeCents - a.volumeCents
    return a.accountId.localeCompare(b.accountId)
  })

  return scored.map((entry, idx) => ({
    rank: idx + 1,
    ...entry
  }))
}

export effect function getLeaderboardPage(options: LeaderboardQueryOptions = {}): LeaderboardPage!StoreFailure!Store {
  const filter = options.filter ?? "all"
  const timeframe = options.timeframe ?? "all"
  const safePageSize = Math.max(1, Math.min(200, Math.floor(options.pageSize ?? 50)))
  const requestedPage = Math.max(1, Math.floor(options.page ?? 1))
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const ranked = try computeRankedLeaderboardTx(tx, filter, timeframe, now)
    const totalCount = ranked.length
    const totalPages = Math.max(1, Math.ceil(totalCount / safePageSize))
    const safePage = Math.min(requestedPage, totalPages)
    const offset = (safePage - 1) * safePageSize
    return {
      entries: ranked.slice(offset, offset + safePageSize),
      pagination: {
        page: safePage,
        pageSize: safePageSize,
        totalCount,
        totalPages
      },
      generatedAt: now
    }
  })
}

export effect function getLeaderboardViewerRank(
  accountId: string,
  options: Omit<LeaderboardQueryOptions, "page"> = {}
): LeaderboardViewerRank!StoreFailure!Store {
  const filter = options.filter ?? "all"
  const timeframe = options.timeframe ?? "all"
  const safePageSize = Math.max(1, Math.min(200, Math.floor(options.pageSize ?? 50)))
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const ranked = try computeRankedLeaderboardTx(tx, filter, timeframe, now)
    const idx = ranked.findIndex((entry) => !entry.isNpc && entry.accountId === accountId)
    if (idx === -1) {
      return { rank: null, page: null, entry: null }
    }
    return {
      rank: idx + 1,
      page: Math.floor(idx / safePageSize) + 1,
      entry: ranked[idx]!
    }
  })
}

export effect function getLeaderboard(limit = 50): ReadonlyArray<LeaderboardEntry>!StoreFailure!Store {
  const page = try getLeaderboardPage({ filter: "traders", timeframe: "all", page: 1, pageSize: limit })
  return page.entries
}
