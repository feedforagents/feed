function safeIndexPriceCents(quoteReserveCents: number, baseReserve: number): number {
  if (quoteReserveCents <= 0 || baseReserve <= 0) return 1
  if (quoteReserveCents <= 90_000_000_000_000 && baseReserve <= Number.MAX_SAFE_INTEGER) {
    return computeIndexPriceCents(quoteReserveCents, baseReserve)
  }
  try {
    const q = BigInt(Math.trunc(quoteReserveCents))
    const b = BigInt(Math.trunc(baseReserve))
    return Math.max(1, Number((q * BigInt(BASE_SCALE)) / b))
  } catch {
    return 1
  }
}

function computePriceImpactBps(beforeMark: number, afterMark: number): number {
  if (beforeMark <= 0) return 0
  return Math.round((Math.abs(afterMark - beforeMark) * BPS_DENOMINATOR) / beforeMark)
}

function computeFlippedOiAndMark(
  indexPriceCents: number,
  longOiCents: number,
  shortOiCents: number,
  existingSide: PerpSide,
  existingSizeCents: number,
  nextSide: PerpSide,
  flipSizeCents: number
): { readonly finalLong: number; readonly finalShort: number; readonly executionPriceCents: number } {
  const afterCloseLong = existingSide === "long" ? Math.max(0, longOiCents - existingSizeCents) : longOiCents
  const afterCloseShort = existingSide === "short" ? Math.max(0, shortOiCents - existingSizeCents) : shortOiCents
  const finalLong = nextSide === "long" ? afterCloseLong + flipSizeCents : afterCloseLong
  const finalShort = nextSide === "short" ? afterCloseShort + flipSizeCents : afterCloseShort
  return {
    finalLong,
    finalShort,
    executionPriceCents: computeMarkPriceCents(indexPriceCents, finalLong, finalShort)
  }
}

effect function assertSlippageWithinCap(beforeMark: number, afterMark: number, maxSlippageBps?: number): void!MarketFailure {
  if (maxSlippageBps === undefined) return
  if (!Number.isFinite(maxSlippageBps) || maxSlippageBps < 0) {
    throw marketFail("INVALID_SLIPPAGE", "maxSlippageBps must be a non-negative number")
  }
  const impactBps = computePriceImpactBps(beforeMark, afterMark)
  if (impactBps > maxSlippageBps) {
    throw marketFail("SLIPPAGE_EXCEEDED", `Price impact ${impactBps} bps exceeds max slippage ${maxSlippageBps} bps`)
  }
}

function blendWeightedEntryPrice(
  prevSize: number,
  prevEntry: number,
  addSize: number,
  addEntry: number,
  side: PerpSide
): number {
  const totalSize = prevSize + addSize
  if (totalSize <= 0) return Math.max(1, addEntry)
  const weighted = (prevEntry * prevSize + addEntry * addSize) / totalSize
  const rounded = side === "long" ? Math.ceil(weighted) : Math.floor(weighted)
  return Math.max(1, rounded)
}

export function computeLiquidationPriceCents(pos: PerpPosition): number {
  if (pos.sizeCents <= 0 || pos.entryPriceCents <= 0) return 1
  const maint = maintenanceMarginCents(pos.sizeCents)
  const netBuffer = pos.marginCents - pos.fundingPaidCents - maint
  const raw = pos.perpSide === "Long"
    ? Math.floor((pos.entryPriceCents * (pos.sizeCents - netBuffer)) / pos.sizeCents)
    : Math.floor((pos.entryPriceCents * (pos.sizeCents + netBuffer)) / pos.sizeCents)
  return Math.max(1, raw)
}

interface Perp24hStats {
  readonly volume24hCents: number
  readonly referencePriceCents: number | null
}

function toPerpMarketView(row: Row, stats?: Perp24hStats): PerpMarketView {
  const longOi = toInt(row.long_oi_cents)
  const shortOi = toInt(row.short_oi_cents)
  const ticker = requiredText(row.ticker)
  const organizationId = requiredText(row.organization_id)
  const markPriceCents = toInt(row.mark_price_cents)
  const initialPriceCents = optionalInt(row.initial_price_cents)
  const refPrice = stats?.referencePriceCents ?? initialPriceCents ?? markPriceCents
  const change24hPct = refPrice > 0
    ? Math.round(((markPriceCents - refPrice) / refPrice) * 10_000) / 100
    : 0
  return {
    ticker,
    organizationId,
    name: requiredText(row.org_name, ticker),
    orgImageUrl: organizationId !== "" ? resolveOrgLogoUrl(organizationId, toText(row.org_image_url)) : null,
    indexPriceCents: toInt(row.index_price_cents),
    markPriceCents,
    change24hPct,
    volume24hCents: stats?.volume24hCents ?? 0,
    longOiCents: longOi,
    shortOiCents: shortOi,
    openInterestCents: longOi + shortOi,
    volumeCents: row.volume_cents === undefined ? 0 : toInt(row.volume_cents),
    maxLeverage: toInt(row.max_leverage),
    fundingRateBps: toInt(row.funding_rate_bps),
    lastFundingPeriod: toInt(row.last_funding_period),
    baseReserve: toInt(row.base_reserve),
    quoteReserveCents: toInt(row.quote_reserve_cents),
    updatedAt: toInt(row.updated_at)
  }
}

export function toPerpPositionView(row: Row): PerpPositionView {
  const specPos = toSpecPerpPosition(row)
  const markPriceCents = toInt(row.mark_price_cents)
  const indexPriceCents = toInt(row.index_price_cents)
  const statusRaw = requiredText(row.status, "open")
  const status: PerpPositionStatus = statusRaw === "closed"
    ? "closed"
    : statusRaw === "liquidated"
      ? "liquidated"
      : "open"
  const unrealizedPnlCents = status === "open" ? unrealizedPnlAtMark(specPos, markPriceCents) : 0
  const equityCents = status === "open" ? positionEquityAtMark(specPos, markPriceCents) : 0
  return {
    id: requiredText(row.id),
    ticker: requiredText(row.ticker),
    holderId: specPos.owner,
    holderKind: requiredText(row.holder_kind) === "npc" ? "npc" : "user",
    side: specPos.perpSide === "Short" ? "short" : "long",
    marginCents: specPos.marginCents,
    sizeCents: specPos.sizeCents,
    leverage: specPos.leverage,
    entryPriceCents: specPos.entryPriceCents,
    markPriceCents,
    indexPriceCents,
    accruedFundingCents: specPos.fundingPaidCents,
    lastFundingPeriod: specPos.lastFundingPeriod,
    unrealizedPnlCents,
    equityCents,
    liquidationPriceCents: computeLiquidationPriceCents(specPos),
    status,
    realizedPnlCents: toInt(row.realized_pnl_cents),
    closedAt: optionalInt(row.closed_at),
    createdAt: toInt(row.created_at)
  }
}

const perpMarketSelectSql = `
  SELECT
    m.ticker,
    m.index_price_cents,
    m.mark_price_cents,
    m.long_oi_cents,
    m.short_oi_cents,
    m.max_leverage,
    m.funding_rate_bps,
    m.last_funding_period,
    m.updated_at,
    COALESCE(p.organization_id, m.ticker) AS organization_id,
    COALESCE(p.base_reserve, 0) AS base_reserve,
    COALESCE(p.quote_reserve_cents, 0) AS quote_reserve_cents,
    COALESCE(o.name, m.ticker) AS org_name,
    COALESCE(tv.volume_cents, 0) AS volume_cents,
    o.image_url AS org_image_url,
    o.initial_price_cents AS initial_price_cents
  FROM feed_perp_markets m
  LEFT JOIN feed_spot_pools p ON p.ticker = m.ticker
  LEFT JOIN feed_organizations o ON o.id = p.organization_id
  LEFT JOIN (
    SELECT market_ref, COALESCE(SUM(notional_cents), 0) AS volume_cents
    FROM feed_trades
    WHERE market_kind = 'perp'
    GROUP BY market_ref
  ) tv ON tv.market_ref = m.ticker
`

effect function loadPerp24hStatsTx(
  tx: Tx,
  tickers: ReadonlyArray<string>,
  nowMs: number
): Map<string, Perp24hStats>!StoreFailure {
  const stats = new Map<string, Perp24hStats>()
  if (tickers.length === 0) return stats
  const cutoffMs = nowMs - 86_400_000
  const volRows = try tx.query(
    `SELECT market_ref AS ticker, COALESCE(SUM(notional_cents), 0) AS volume_24h_cents
     FROM feed_trades
     WHERE market_kind IN ('perp', 'spot') AND market_ref = ANY($1) AND created_at >= $2
     GROUP BY market_ref`,
    [tickers, cutoffMs]
  )
  const volumeByTicker = new Map<string, number>()
  for (const row of volRows) {
    const t = requiredText(row.ticker)
    if (t !== "") volumeByTicker.set(t, toInt(row.volume_24h_cents))
  }
  const priorRows = try tx.query(
    `SELECT DISTINCT ON (market_ref) market_ref AS ticker, mark_price_cents AS price_cents
     FROM feed_market_price_history
     WHERE market_kind = 'perp' AND market_ref = ANY($1) AND recorded_at < $2 AND mark_price_cents > 0
     ORDER BY market_ref, recorded_at DESC, id DESC`,
    [tickers, cutoffMs]
  )
  const refPriceByTicker = new Map<string, number>()
  for (const row of priorRows) {
    const t = requiredText(row.ticker)
    const price = toInt(row.price_cents)
    if (t !== "" && price > 0) refPriceByTicker.set(t, price)
  }
  const windowFirstRows = try tx.query(
    `SELECT DISTINCT ON (market_ref) market_ref AS ticker, mark_price_cents AS price_cents
     FROM feed_market_price_history
     WHERE market_kind = 'perp' AND market_ref = ANY($1) AND recorded_at >= $2 AND mark_price_cents > 0
     ORDER BY market_ref, recorded_at ASC, id ASC`,
    [tickers, cutoffMs]
  )
  for (const row of windowFirstRows) {
    const t = requiredText(row.ticker)
    const price = toInt(row.price_cents)
    if (t !== "" && price > 0 && !refPriceByTicker.has(t)) {
      refPriceByTicker.set(t, price)
    }
  }
  for (const t of tickers) {
    stats.set(t, {
      volume24hCents: volumeByTicker.get(t) ?? 0,
      referencePriceCents: refPriceByTicker.get(t) ?? null
    })
  }
  return stats
}
export effect function listPerpMarkets(): ReadonlyArray<PerpMarketView>!StoreFailure!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(`${perpMarketSelectSql} ORDER BY m.ticker ASC`)
    const tickers = rows.map((r) => requiredText(r.ticker)).filter(Boolean)
    const stats = try loadPerp24hStatsTx(tx, tickers, now)
    return rows.map((row) => toPerpMarketView(row, stats.get(requiredText(row.ticker))))
  })
}

export effect function getPerpMarket(ticker: string): PerpMarketView!(MarketFailure | StoreFailure)!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(`${perpMarketSelectSql} WHERE m.ticker = $1`, [ticker])
    if (rows.length === 0) {
      throw marketFail("MARKET_NOT_FOUND", `Perp market not found: ${ticker}`)
    }
    const row = rows[0]!
    const stats = try loadPerp24hStatsTx(tx, [requiredText(row.ticker)], now)
    return toPerpMarketView(row, stats.get(requiredText(row.ticker)))
  })
}

export effect function listPerpPositionsIn(tx: Tx, ownerId: string): ReadonlyArray<PerpPositionView>!StoreFailure {
  const rows = try tx.query(
    `SELECT
       p.*,
       m.mark_price_cents,
       m.index_price_cents
     FROM feed_perp_positions p
     JOIN feed_perp_markets m ON m.ticker = p.ticker
     WHERE p.holder_id = $1 AND p.status = 'open'
     ORDER BY p.created_at DESC, p.id DESC`,
    [ownerId]
  )
  return rows.map(toPerpPositionView)
}

export effect function listPerpPositions(ownerId: string): ReadonlyArray<PerpPositionView>!StoreFailure!Store {
  const store = try Store
  return try store.transaction((tx) => listPerpPositionsIn(tx, ownerId))
}

effect function resolveTradeNowMs(nowMs?: number): number!! {
  return nowMs !== undefined && Number.isFinite(nowMs) ? Math.trunc(nowMs) : try Clock.currentTimeMillis
}

// spec/markets/spotPerp.md, "Only NPCs may trade the spot CPMM pool, updating the persisted index price"
export effect function executeNpcSpotTrade(input: NpcSpotTradeInput): SpotTradeReceipt!(MarketFailure | StoreFailure)!Store {
  try assertSafePositiveInt(input.quoteCents, "INVALID_AMOUNT", "Spot trade quoteCents must be a positive integer")
  if (input.side !== "buy" && input.side !== "sell") {
    throw marketFail("INVALID_SIDE", "Spot side must be 'buy' or 'sell'")
  }
  const store = try Store
  const now = try resolveTradeNowMs(input.nowMs)
  return try store.transaction(effect (tx: Tx) => {
    const userRows = try tx.query("SELECT account_id FROM feed_accounts WHERE account_id = $1", [input.actorId])
    if (userRows.length > 0) {
      throw marketFail("FORBIDDEN_NON_NPC", "Only NPC actors may trade spot pools")
    }
    const actorRows = try tx.query("SELECT id, balance_cents FROM feed_actors WHERE id = $1 FOR UPDATE", [input.actorId])
    if (actorRows.length === 0) {
      throw marketFail("FORBIDDEN_NON_NPC", `Only registered NPC actors may trade spot pools: ${input.actorId}`)
    }
    const poolRows = try tx.query(
      "SELECT ticker, base_reserve, quote_reserve_cents, index_price_cents FROM feed_spot_pools WHERE ticker = $1 FOR UPDATE",
      [input.ticker]
    )
    const marketRows = try tx.query(
      "SELECT ticker, long_oi_cents, short_oi_cents FROM feed_perp_markets WHERE ticker = $1 FOR UPDATE",
      [input.ticker]
    )
    if (poolRows.length === 0 || marketRows.length === 0) {
      throw marketFail("MARKET_NOT_FOUND", `Spot pool not found for ticker: ${input.ticker}`)
    }
    const baseReserve = toInt(poolRows[0]!.base_reserve)
    const quoteReserve = toInt(poolRows[0]!.quote_reserve_cents)
    const npcBalance = toInt(actorRows[0]!.balance_cents)
    let nextQuote: number
    let nextBase: number
    let baseDelta: number
    let cashDelta: number
    if (input.side === "buy") {
      if (npcBalance < input.quoteCents) {
        throw marketFail("INSUFFICIENT_POINTS", "NPC actor has insufficient points balance")
      }
      nextQuote = quoteReserve + input.quoteCents
      nextBase = ceilDivProduct(baseReserve, quoteReserve, nextQuote)
      if (nextBase <= 0) {
        throw marketFail("INSUFFICIENT_LIQUIDITY", "Spot pool base reserve exhausted")
      }
      baseDelta = baseReserve - nextBase
      if (baseDelta <= 0) {
        throw marketFail("INVALID_AMOUNT", "Spot buy amount too small to acquire base units")
      }
      cashDelta = 0 - input.quoteCents
      try tx.query(
        `INSERT INTO feed_npc_spot_holdings (actor_id, ticker, base_units, updated_at)
         VALUES ($1, $2, $3, $4)
         ON CONFLICT (actor_id, ticker) DO UPDATE
         SET base_units = feed_npc_spot_holdings.base_units + EXCLUDED.base_units,
             updated_at = EXCLUDED.updated_at`,
        [input.actorId, input.ticker, baseDelta, now]
      )
    } else {
      if (input.quoteCents >= quoteReserve) {
        throw marketFail("INSUFFICIENT_LIQUIDITY", "Spot sale exceeds available quote liquidity")
      }
      nextQuote = quoteReserve - input.quoteCents
      nextBase = ceilDivProduct(baseReserve, quoteReserve, nextQuote)
      baseDelta = nextBase - baseReserve
      if (baseDelta <= 0) {
        throw marketFail("INVALID_AMOUNT", "Spot sale amount too small")
      }
      const holdingRows = try tx.query(
        "SELECT base_units FROM feed_npc_spot_holdings WHERE actor_id = $1 AND ticker = $2 FOR UPDATE",
        [input.actorId, input.ticker]
      )
      const heldBase = holdingRows.length > 0 ? toInt(holdingRows[0]!.base_units) : 0
      if (heldBase < baseDelta) {
        throw marketFail("INSUFFICIENT_SPOT_INVENTORY", "NPC actor has insufficient spot inventory to sell")
      }
      try tx.query(
        "UPDATE feed_npc_spot_holdings SET base_units = base_units - $3, updated_at = $4 WHERE actor_id = $1 AND ticker = $2",
        [input.actorId, input.ticker, baseDelta, now]
      )
      cashDelta = input.quoteCents
    }
    const nextIndexPriceCents = safeIndexPriceCents(nextQuote, nextBase)
    const longOi = toInt(marketRows[0]!.long_oi_cents)
    const shortOi = toInt(marketRows[0]!.short_oi_cents)
    const nextMarkPriceCents = computeMarkPriceCents(nextIndexPriceCents, longOi, shortOi)
    try tx.query(
      "UPDATE feed_spot_pools SET base_reserve = $2, quote_reserve_cents = $3, index_price_cents = $4, updated_at = $5 WHERE ticker = $1",
      [input.ticker, nextBase, nextQuote, nextIndexPriceCents, now]
    )
    try tx.query(
      "UPDATE feed_perp_markets SET index_price_cents = $2, mark_price_cents = $3, updated_at = $4 WHERE ticker = $1",
      [input.ticker, nextIndexPriceCents, nextMarkPriceCents, now]
    )
    const updatedActor = try tx.query(
      "UPDATE feed_actors SET balance_cents = balance_cents + $2 WHERE id = $1 RETURNING balance_cents",
      [input.actorId, cashDelta]
    )
    const balanceAfterCents = toInt(updatedActor[0]!.balance_cents)
    const tradeId = newMarketId()
    try insertTradeRecord(tx, {
      tradeId,
      traderId: input.actorId,
      traderKind: "npc",
      marketKind: "spot",
      marketRef: input.ticker,
      side: input.side,
      notionalCents: input.quoteCents,
      feeCents: 0,
      sharesOrSize: baseDelta,
      priceCents: nextIndexPriceCents,
      realizedPnlCents: null,
      viaClientName: null,
      createdAt: now
    })
    try insertLedgerEntry(tx, {
      ledgerId: newMarketId(),
      accountId: input.actorId,
      kind: input.side === "buy" ? "spot_buy" : "spot_sell",
      deltaCents: cashDelta,
      balanceAfterCents,
      refId: tradeId,
      createdAt: now
    })
    try insertPriceHistory(tx, {
      marketKind: "spot",
      marketRef: input.ticker,
      priceCents: nextIndexPriceCents,
      markPriceCents: nextMarkPriceCents,
      volumeCents: input.quoteCents,
      recordedAt: now
    })
    try insertPriceHistory(tx, {
      marketKind: "perp",
      marketRef: input.ticker,
      priceCents: nextIndexPriceCents,
      markPriceCents: nextMarkPriceCents,
      volumeCents: input.quoteCents,
      recordedAt: now
    })
    return {
      tradeId,
      actorId: input.actorId,
      ticker: input.ticker,
      side: input.side,
      quoteCents: input.quoteCents,
      baseDelta,
      indexPriceCents: nextIndexPriceCents,
      markPriceCents: nextMarkPriceCents,
      baseReserve: nextBase,
      quoteReserveCents: nextQuote,
      balanceAfterCents,
      createdAt: now
    }
  })
}

effect function assertUserPerpExposureAndPositionCap(
  tx: Tx,
  ownerId: string,
  ownerKind: MarketActorKind,
  additionalSizeCents: number,
  isNewPosition: boolean
): void!(MarketFailure | StoreFailure) {
  if (ownerKind !== "user") return
  const rows = try tx.query(
    `SELECT COUNT(*) AS open_count, COALESCE(SUM(size_cents), 0) AS total_exposure
     FROM feed_perp_positions
     WHERE holder_id = $1 AND status = 'open'`,
    [ownerId]
  )
  const openCount = toInt(rows[0]?.open_count)
  const currentExposure = toInt(rows[0]?.total_exposure)
  if (isNewPosition && openCount >= MAX_POSITIONS_PER_USER) {
    throw marketFail("MAX_POSITIONS_EXCEEDED", `Maximum open perp positions (${MAX_POSITIONS_PER_USER}) reached`)
  }
  if (currentExposure + additionalSizeCents > MAX_PERP_USER_EXPOSURE_CENTS) {
    throw marketFail("EXPOSURE_LIMIT_EXCEEDED", `Total perp exposure exceeds cap (${MAX_PERP_USER_EXPOSURE_CENTS} cents)`)
  }
}

interface PerpMarketSnapshot {
  readonly ticker: string
  readonly indexPriceCents: number
  readonly markPriceCents: number
  readonly longOiCents: number
  readonly shortOiCents: number
  readonly maxLeverage: number
}

effect function lockPerpMarket(tx: Tx, ticker: string): PerpMarketSnapshot!(MarketFailure | StoreFailure) {
  const rows = try tx.query(
    "SELECT ticker, index_price_cents, mark_price_cents, long_oi_cents, short_oi_cents, max_leverage FROM feed_perp_markets WHERE ticker = $1 FOR UPDATE",
    [ticker]
  )
  if (rows.length === 0) {
    throw marketFail("MARKET_NOT_FOUND", `Perp market not found: ${ticker}`)
  }
  const row = rows[0]!
  return {
    ticker: requiredText(row.ticker),
    indexPriceCents: toInt(row.index_price_cents),
    markPriceCents: toInt(row.mark_price_cents),
    longOiCents: toInt(row.long_oi_cents),
    shortOiCents: toInt(row.short_oi_cents),
    maxLeverage: Math.min(MAX_LEVERAGE, toInt(row.max_leverage))
  }
}

effect function updatePerpMarketOiAndMark(
  tx: Tx,
  ticker: string,
  indexPriceCents: number,
  longOiCents: number,
  shortOiCents: number,
  now: number
): { readonly markPriceCents: number; readonly fundingRateBps: number }!StoreFailure {
  const safeLong = Math.max(0, longOiCents)
  const safeShort = Math.max(0, shortOiCents)
  const markPriceCents = computeMarkPriceCents(indexPriceCents, safeLong, safeShort)
  const fundingRateBps = boundedPremiumBps(safeLong, safeShort)
  try tx.query(
    `UPDATE feed_perp_markets
     SET long_oi_cents = $2, short_oi_cents = $3, mark_price_cents = $4, funding_rate_bps = $5, updated_at = $6
     WHERE ticker = $1`,
    [ticker, safeLong, safeShort, markPriceCents, fundingRateBps, now]
  )
  return { markPriceCents, fundingRateBps }
}

effect function settlePerpCloseSliceTx(
  tx: Tx,
  params: {
    readonly posRow: Row
    readonly market: PerpMarketSnapshot
    readonly closeSizeCents: number
    readonly maxSlippageBps?: number
    readonly viaClientName: string | null
    readonly tradeSideOverride?: string
    readonly now: number
  }
): {
  readonly receipt: ClosePerpReceipt
  readonly updatedPositionRow: Row
  readonly nextLongOi: number
  readonly nextShortOi: number
  readonly postCloseMark: number
}!(MarketFailure | StoreFailure) {
  const specPos = toSpecPerpPosition(params.posRow)
  const positionId = requiredText(params.posRow.id)
  const side: PerpSide = specPos.perpSide === "Short" ? "short" : "long"
  const holderKind: MarketActorKind = requiredText(params.posRow.holder_kind) === "npc" ? "npc" : "user"
  const remainingSizeCents = specPos.sizeCents - params.closeSizeCents
  const isFullClose = remainingSizeCents === 0
  if (!isFullClose && (params.closeSizeCents < MIN_ORDER_SIZE_CENTS || remainingSizeCents < MIN_ORDER_SIZE_CENTS)) {
    throw marketFail("ORDER_TOO_SMALL", `Partial close and remaining size must each be at least ${MIN_ORDER_SIZE_CENTS} cents`)
  }
  if (!isFullClose && specPos.marginCents <= 1) {
    throw marketFail("ORDER_TOO_SMALL", "Remaining position margin would be zero; close the full position instead")
  }
  const closedMarginCents = isFullClose
    ? specPos.marginCents
    : Math.max(1, Math.min(specPos.marginCents - 1, Math.floor((specPos.marginCents * params.closeSizeCents) / specPos.sizeCents)))
  const closedFundingCents = isFullClose
    ? specPos.fundingPaidCents
    : Math.trunc((specPos.fundingPaidCents * params.closeSizeCents) / specPos.sizeCents)
  const nextLongOi = side === "long" ? Math.max(0, params.market.longOiCents - params.closeSizeCents) : params.market.longOiCents
  const nextShortOi = side === "short" ? Math.max(0, params.market.shortOiCents - params.closeSizeCents) : params.market.shortOiCents
  const postCloseMark = computeMarkPriceCents(params.market.indexPriceCents, nextLongOi, nextShortOi)
  try assertSlippageWithinCap(params.market.markPriceCents, postCloseMark, params.maxSlippageBps)
  const closingSlice: PerpPosition = {
    ...specPos,
    sizeCents: params.closeSizeCents,
    marginCents: closedMarginCents,
    fundingPaidCents: closedFundingCents
  }
  const grossCents = clampMin0(positionEquityAtMark(closingSlice, postCloseMark))
  const rawFee = canonicalTradingFee(params.closeSizeCents)
  const collectedFeeCents = minInt(rawFee, grossCents)
  const netCreditCents = clampMin0(grossCents - rawFee)
  const totalOpenFeeEstimate = canonicalTradingFee(specPos.sizeCents)
  const openFeeCents = isFullClose
    ? totalOpenFeeEstimate
    : Math.floor((totalOpenFeeEstimate * params.closeSizeCents) / specPos.sizeCents)
  const realizedPnlCents = netCreditCents - closedMarginCents - openFeeCents
  const updatedRows = isFullClose
    ? try tx.query(
        `UPDATE feed_perp_positions
         SET status = 'closed', realized_pnl_cents = realized_pnl_cents + $2, closed_at = $3
         WHERE id = $1 AND status = 'open'
         RETURNING *`,
        [positionId, realizedPnlCents, params.now]
      )
    : try tx.query(
        `UPDATE feed_perp_positions
         SET margin_cents = margin_cents - $2,
             size_cents = size_cents - $3,
             accrued_funding_cents = accrued_funding_cents - $4,
             realized_pnl_cents = realized_pnl_cents + $5
         WHERE id = $1 AND status = 'open'
         RETURNING *`,
        [positionId, closedMarginCents, params.closeSizeCents, closedFundingCents, realizedPnlCents]
      )
  if (updatedRows.length === 0) {
    throw marketFail("POSITION_CLOSED", "Position is already closed")
  }
  try updatePerpMarketOiAndMark(tx, params.market.ticker, params.market.indexPriceCents, nextLongOi, nextShortOi, params.now)
  const balanceAfterCents = try creditActorBalance(tx, specPos.owner, holderKind, netCreditCents, collectedFeeCents, params.now)
  const tradeId = newMarketId()
  const defaultTradeSide = isFullClose
    ? (side === "long" ? "close_long" : "close_short")
    : (side === "long" ? "reduce_long" : "reduce_short")
  try insertTradeRecord(tx, {
    tradeId,
    traderId: specPos.owner,
    traderKind: holderKind,
    marketKind: "perp",
    marketRef: params.market.ticker,
    side: params.tradeSideOverride ?? defaultTradeSide,
    notionalCents: params.closeSizeCents,
    feeCents: collectedFeeCents,
    sharesOrSize: params.closeSizeCents,
    priceCents: postCloseMark,
    realizedPnlCents,
    viaClientName: params.viaClientName,
    createdAt: params.now
  })
  try insertLedgerEntry(tx, {
    ledgerId: newMarketId(),
    accountId: specPos.owner,
    kind: isFullClose ? "perp_close" : "perp_partial_close",
    deltaCents: netCreditCents,
    balanceAfterCents,
    refId: tradeId,
    createdAt: params.now
  })
  try insertPriceHistory(tx, {
    marketKind: "perp",
    marketRef: params.market.ticker,
    priceCents: params.market.indexPriceCents,
    markPriceCents: postCloseMark,
    volumeCents: params.closeSizeCents,
    recordedAt: params.now
  })
  return {
    receipt: {
      tradeId,
      positionId,
      ticker: params.market.ticker,
      side,
      sizeCents: params.closeSizeCents,
      remainingSizeCents,
      isFullClose,
      exitPriceCents: postCloseMark,
      netCreditCents,
      feeCents: collectedFeeCents,
      realizedPnlCents,
      balanceAfterCents,
      closedAt: params.now
    },
    updatedPositionRow: updatedRows[0]!,
    nextLongOi,
    nextShortOi,
    postCloseMark
  }
}

effect function recordPerpLedgerAndPriceTx(
  tx: Tx,
  params: {
    readonly accountId: string
    readonly kind: string
    readonly deltaCents: number
    readonly balanceAfterCents: number
    readonly refId: string
    readonly ticker: string
    readonly indexPriceCents: number
    readonly markPriceCents: number
    readonly volumeCents: number
    readonly now: number
  }
): void!StoreFailure {
  try insertLedgerEntry(tx, {
    ledgerId: newMarketId(),
    accountId: params.accountId,
    kind: params.kind,
    deltaCents: params.deltaCents,
    balanceAfterCents: params.balanceAfterCents,
    refId: params.refId,
    createdAt: params.now
  })
  try insertPriceHistory(tx, {
    marketKind: "perp",
    marketRef: params.ticker,
    priceCents: params.indexPriceCents,
    markPriceCents: params.markPriceCents,
    volumeCents: params.volumeCents,
    recordedAt: params.now
  })
}

effect function validatePerpOrderInput(input: {
  readonly collateralCents: number
  readonly leverage: number
  readonly side: PerpSide
}): number!MarketFailure {
  try assertSafePositiveInt(input.collateralCents, "INVALID_AMOUNT", "collateralCents must be a positive integer")
  if (!Number.isSafeInteger(input.leverage) || input.leverage < 1 || input.leverage > MAX_LEVERAGE) {
    throw marketFail("INVALID_LEVERAGE", `Leverage must be an integer between 1 and ${MAX_LEVERAGE}`)
  }
  if (input.side !== "long" && input.side !== "short") {
    throw marketFail("INVALID_SIDE", "Perp side must be 'long' or 'short'")
  }
  const sizeCents = input.collateralCents * input.leverage
  if (!Number.isSafeInteger(sizeCents) || sizeCents < MIN_ORDER_SIZE_CENTS) {
    throw marketFail("ORDER_TOO_SMALL", `Notional size must be at least ${MIN_ORDER_SIZE_CENTS} cents`)
  }
  return sizeCents
}

effect function insertFreshPerpPositionTx(
  tx: Tx,
  params: {
    readonly ownerId: string
    readonly ownerKind: MarketActorKind
    readonly market: PerpMarketSnapshot
    readonly side: PerpSide
    readonly collateralCents: number
    readonly sizeCents: number
    readonly leverage: number
    readonly maxSlippageBps?: number
    readonly viaClientName: string | null
    readonly currentPeriod: number
    readonly action: "open" | "flip"
    readonly realizedPnlCents: number
    readonly closedPositionId: string | null
    readonly priorFeeCents?: number
    readonly now: number
  }
): OpenPerpReceipt!(MarketFailure | StoreFailure) {
  const nextLongOi = params.side === "long" ? params.market.longOiCents + params.sizeCents : params.market.longOiCents
  const nextShortOi = params.side === "short" ? params.market.shortOiCents + params.sizeCents : params.market.shortOiCents
  const postOpenMark = computeMarkPriceCents(params.market.indexPriceCents, nextLongOi, nextShortOi)
  try assertSlippageWithinCap(params.market.markPriceCents, postOpenMark, params.maxSlippageBps)
  const feeCents = canonicalTradingFee(params.sizeCents)
  const totalDebitCents = params.collateralCents + feeCents
  const balanceAfterCents = try debitActorBalance(tx, params.ownerId, params.ownerKind, totalDebitCents, feeCents, params.now)
  const positionId = newMarketId()
  const dbSide = params.side === "long" ? "LONG" : "SHORT"
  const inserted = try tx.query(
    `INSERT INTO feed_perp_positions
     (id, ticker, holder_id, holder_kind, side, margin_cents, size_cents, entry_price_cents, leverage, accrued_funding_cents, last_funding_period, status, realized_pnl_cents, closed_at, created_at)
     VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9, 0, $10, 'open', 0, NULL, $11)
     RETURNING *`,
    [positionId, params.market.ticker, params.ownerId, params.ownerKind, dbSide, params.collateralCents, params.sizeCents, postOpenMark, params.leverage, params.currentPeriod, params.now]
  )
  try updatePerpMarketOiAndMark(tx, params.market.ticker, params.market.indexPriceCents, nextLongOi, nextShortOi, params.now)
  const tradeId = newMarketId()
  try insertTradeRecord(tx, {
    tradeId,
    traderId: params.ownerId,
    traderKind: params.ownerKind,
    marketKind: "perp",
    marketRef: params.market.ticker,
    side: params.side === "long" ? "open_long" : "open_short",
    notionalCents: params.sizeCents,
    feeCents,
    sharesOrSize: params.sizeCents,
    priceCents: postOpenMark,
    realizedPnlCents: null,
    viaClientName: params.viaClientName,
    createdAt: params.now
  })
  try recordPerpLedgerAndPriceTx(tx, {
    accountId: params.ownerId,
    kind: "perp_open",
    deltaCents: 0 - totalDebitCents,
    balanceAfterCents,
    refId: tradeId,
    ticker: params.market.ticker,
    indexPriceCents: params.market.indexPriceCents,
    markPriceCents: postOpenMark,
    volumeCents: params.sizeCents,
    now: params.now
  })
  const posRow = {
    ...inserted[0]!,
    mark_price_cents: postOpenMark,
    index_price_cents: params.market.indexPriceCents
  }
  return {
    tradeId,
    positionId,
    action: params.action,
    position: toPerpPositionView(posRow),
    collateralCents: params.collateralCents,
    sizeCents: params.sizeCents,
    leverage: params.leverage,
    feeCents: feeCents + (params.priorFeeCents ?? 0),
    executionPriceCents: postOpenMark,
    realizedPnlCents: params.realizedPnlCents,
    closedPositionId: params.closedPositionId,
    balanceAfterCents,
    createdAt: params.now
  }
}

effect function addToPerpPositionTx(
  tx: Tx,
  params: {
    readonly existingRow: Row
    readonly market: PerpMarketSnapshot
    readonly side: PerpSide
    readonly addCollateralCents: number
    readonly addSizeCents: number
    readonly maxSlippageBps?: number
    readonly viaClientName: string | null
    readonly now: number
  }
): OpenPerpReceipt!(MarketFailure | StoreFailure) {
  const existing = toSpecPerpPosition(params.existingRow)
  const positionId = requiredText(params.existingRow.id)
  const holderKind: MarketActorKind = requiredText(params.existingRow.holder_kind) === "npc" ? "npc" : "user"
  const nextLongOi = params.side === "long" ? params.market.longOiCents + params.addSizeCents : params.market.longOiCents
  const nextShortOi = params.side === "short" ? params.market.shortOiCents + params.addSizeCents : params.market.shortOiCents
  const postAddMark = computeMarkPriceCents(params.market.indexPriceCents, nextLongOi, nextShortOi)
  try assertSlippageWithinCap(params.market.markPriceCents, postAddMark, params.maxSlippageBps)
  const feeCents = canonicalTradingFee(params.addSizeCents)
  const totalDebitCents = params.addCollateralCents + feeCents
  const balanceAfterCents = try debitActorBalance(tx, existing.owner, holderKind, totalDebitCents, feeCents, params.now)
  const nextSize = existing.sizeCents + params.addSizeCents
  const nextMargin = existing.marginCents + params.addCollateralCents
  const nextLeverage = Math.max(1, Math.min(params.market.maxLeverage, ceilDiv(nextSize, nextMargin)))
  const nextEntry = blendWeightedEntryPrice(existing.sizeCents, existing.entryPriceCents, params.addSizeCents, postAddMark, params.side)
  const updatedRows = try tx.query(
    `UPDATE feed_perp_positions
     SET margin_cents = $2, size_cents = $3, entry_price_cents = $4, leverage = $5
     WHERE id = $1 AND status = 'open'
     RETURNING *`,
    [positionId, nextMargin, nextSize, nextEntry, nextLeverage]
  )
  try updatePerpMarketOiAndMark(tx, params.market.ticker, params.market.indexPriceCents, nextLongOi, nextShortOi, params.now)
  const tradeId = newMarketId()
  try insertTradeRecord(tx, {
    tradeId,
    traderId: existing.owner,
    traderKind: holderKind,
    marketKind: "perp",
    marketRef: params.market.ticker,
    side: params.side === "long" ? "add_long" : "add_short",
    notionalCents: params.addSizeCents,
    feeCents,
    sharesOrSize: params.addSizeCents,
    priceCents: postAddMark,
    realizedPnlCents: null,
    viaClientName: params.viaClientName,
    createdAt: params.now
  })
  try recordPerpLedgerAndPriceTx(tx, {
    accountId: existing.owner,
    kind: "perp_add",
    deltaCents: 0 - totalDebitCents,
    balanceAfterCents,
    refId: tradeId,
    ticker: params.market.ticker,
    indexPriceCents: params.market.indexPriceCents,
    markPriceCents: postAddMark,
    volumeCents: params.addSizeCents,
    now: params.now
  })
  const posRow = {
    ...updatedRows[0]!,
    mark_price_cents: postAddMark,
    index_price_cents: params.market.indexPriceCents
  }
  return {
    tradeId,
    positionId,
    action: "add",
    position: toPerpPositionView(posRow),
    collateralCents: params.addCollateralCents,
    sizeCents: params.addSizeCents,
    leverage: nextLeverage,
    feeCents,
    executionPriceCents: postAddMark,
    realizedPnlCents: 0,
    closedPositionId: null,
    balanceAfterCents,
    createdAt: params.now
  }
}

export effect function previewPerpOrder(input: PreviewPerpOrderInput): PerpOrderPreview!(MarketFailure | StoreFailure)!Store {
  const sizeCents = try validatePerpOrderInput(input)
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const marketRows = try tx.query(
      "SELECT ticker, index_price_cents, mark_price_cents, long_oi_cents, short_oi_cents, max_leverage, funding_rate_bps FROM feed_perp_markets WHERE ticker = $1",
      [input.ticker]
    )
    if (marketRows.length === 0) {
      throw marketFail("MARKET_NOT_FOUND", `Perp market not found: ${input.ticker}`)
    }
    const row = marketRows[0]!
    const indexPriceCents = toInt(row.index_price_cents)
    const preMarkPriceCents = toInt(row.mark_price_cents)
    const longOi = toInt(row.long_oi_cents)
    const shortOi = toInt(row.short_oi_cents)
    const maxMarketLeverage = Math.min(MAX_LEVERAGE, toInt(row.max_leverage))
    if (input.leverage > maxMarketLeverage) {
      throw marketFail("INVALID_LEVERAGE", `Market leverage cap is ${maxMarketLeverage}x`)
    }
    const orderCap = getPerpMarketOrderSizeLimitCents(longOi + shortOi)
    if (sizeCents > orderCap) {
      throw marketFail("ORDER_LIMIT_EXCEEDED", `Order size exceeds market limit (${orderCap} cents)`)
    }
    const existingRows = input.ownerId !== undefined
      ? try tx.query(
          "SELECT * FROM feed_perp_positions WHERE holder_id = $1 AND ticker = $2 AND status = 'open' LIMIT 1",
          [input.ownerId, input.ticker]
        )
      : []
    const existing = existingRows.length > 0 ? toSpecPerpPosition(existingRows[0]!) : null
    if (existing !== null) {
      const existingSide: PerpSide = existing.perpSide === "Short" ? "short" : "long"
      if (existingSide === input.side) {
        const nextLong = input.side === "long" ? longOi + sizeCents : longOi
        const nextShort = input.side === "short" ? shortOi + sizeCents : shortOi
        const executionPriceCents = computeMarkPriceCents(indexPriceCents, nextLong, nextShort)
        const feeCents = canonicalTradingFee(sizeCents)
        const nextSize = existing.sizeCents + sizeCents
        const nextMargin = existing.marginCents + input.collateralCents
        const nextEntry = blendWeightedEntryPrice(existing.sizeCents, existing.entryPriceCents, sizeCents, executionPriceCents, input.side)
        const estLiq = computeLiquidationPriceCents({
          ...existing,
          sizeCents: nextSize,
          marginCents: nextMargin,
          entryPriceCents: nextEntry
        })
        return {
          ticker: input.ticker,
          side: input.side,
          action: "add",
          collateralCents: input.collateralCents,
          sizeCents,
          leverage: Math.max(1, Math.min(maxMarketLeverage, ceilDiv(nextSize, nextMargin))),
          feeCents,
          totalDebitCents: input.collateralCents + feeCents,
          indexPriceCents,
          preMarkPriceCents,
          executionPriceCents,
          priceImpactBps: computePriceImpactBps(preMarkPriceCents, executionPriceCents),
          estimatedLiquidationPriceCents: estLiq,
          fundingRateBps: boundedPremiumBps(nextLong, nextShort)
        }
      }
      if (input.mode === "flip") {
        const { finalLong, finalShort, executionPriceCents } = computeFlippedOiAndMark(
          indexPriceCents,
          longOi,
          shortOi,
          existingSide,
          existing.sizeCents,
          input.side,
          sizeCents
        )
        const closeFeeCents = canonicalTradingFee(existing.sizeCents)
        const openFeeCents = canonicalTradingFee(sizeCents)
        return buildFreshPerpOrderPreview({
          ownerId: input.ownerId,
          ticker: input.ticker,
          side: input.side,
          action: "flip",
          collateralCents: input.collateralCents,
          sizeCents,
          leverage: input.leverage,
          feeCents: closeFeeCents + openFeeCents,
          totalDebitCents: input.collateralCents + openFeeCents,
          indexPriceCents,
          preMarkPriceCents,
          executionPriceCents,
          nextLongOi: finalLong,
          nextShortOi: finalShort
        })
      }
      if (sizeCents <= existing.sizeCents) {
        const isFull = sizeCents === existing.sizeCents
        const remSize = existing.sizeCents - sizeCents
        if (!isFull && (sizeCents < MIN_ORDER_SIZE_CENTS || remSize < MIN_ORDER_SIZE_CENTS)) {
          throw marketFail("ORDER_TOO_SMALL", `Partial close and remaining size must each be at least ${MIN_ORDER_SIZE_CENTS} cents`)
        }
        const nextLong = existingSide === "long" ? Math.max(0, longOi - sizeCents) : longOi
        const nextShort = existingSide === "short" ? Math.max(0, shortOi - sizeCents) : shortOi
        const executionPriceCents = computeMarkPriceCents(indexPriceCents, nextLong, nextShort)
        const feeCents = canonicalTradingFee(sizeCents)
        const closedMargin = isFull
          ? existing.marginCents
          : Math.max(1, Math.min(existing.marginCents - 1, Math.floor((existing.marginCents * sizeCents) / existing.sizeCents)))
        const closedFunding = isFull
          ? existing.fundingPaidCents
          : Math.trunc((existing.fundingPaidCents * sizeCents) / existing.sizeCents)
        const remMargin = isFull ? 0 : existing.marginCents - closedMargin
        const remFunding = isFull ? 0 : existing.fundingPaidCents - closedFunding
        const estLiq = isFull ? 0 : computeLiquidationPriceCents({ ...existing, sizeCents: remSize, marginCents: remMargin, fundingPaidCents: remFunding })
        return {
          ticker: input.ticker,
          side: input.side,
          action: isFull ? "close" : "reduce",
          collateralCents: 0,
          sizeCents,
          leverage: existing.leverage,
          feeCents,
          totalDebitCents: feeCents,
          indexPriceCents,
          preMarkPriceCents,
          executionPriceCents,
          priceImpactBps: computePriceImpactBps(preMarkPriceCents, executionPriceCents),
          estimatedLiquidationPriceCents: estLiq,
          fundingRateBps: boundedPremiumBps(nextLong, nextShort)
        }
      }
      const flipSize = sizeCents - existing.sizeCents
      if (flipSize < MIN_ORDER_SIZE_CENTS) {
        throw marketFail("ORDER_TOO_SMALL", `Flipped position size must be at least ${MIN_ORDER_SIZE_CENTS} cents`)
      }
      const flipMargin = ceilDiv(flipSize, input.leverage)
      const { finalLong, finalShort, executionPriceCents } = computeFlippedOiAndMark(
        indexPriceCents,
        longOi,
        shortOi,
        existingSide,
        existing.sizeCents,
        input.side,
        flipSize
      )
      return buildFreshPerpOrderPreview({
        ownerId: input.ownerId,
        ticker: input.ticker,
        side: input.side,
        action: "flip",
        collateralCents: flipMargin,
        sizeCents: flipSize,
        leverage: input.leverage,
        feeCents: canonicalTradingFee(existing.sizeCents) + canonicalTradingFee(flipSize),
        totalDebitCents: flipMargin + canonicalTradingFee(flipSize),
        indexPriceCents,
        preMarkPriceCents,
        executionPriceCents,
        nextLongOi: finalLong,
        nextShortOi: finalShort
      })
    }
    const nextLong = input.side === "long" ? longOi + sizeCents : longOi
    const nextShort = input.side === "short" ? shortOi + sizeCents : shortOi
    const executionPriceCents = computeMarkPriceCents(indexPriceCents, nextLong, nextShort)
    const feeCents = canonicalTradingFee(sizeCents)
    return buildFreshPerpOrderPreview({
      ownerId: input.ownerId,
      ticker: input.ticker,
      side: input.side,
      action: "open",
      collateralCents: input.collateralCents,
      sizeCents,
      leverage: input.leverage,
      feeCents,
      totalDebitCents: input.collateralCents + feeCents,
      indexPriceCents,
      preMarkPriceCents,
      executionPriceCents,
      nextLongOi: nextLong,
      nextShortOi: nextShort
    })
  })
}

const StoredPerpPositionViewSchema = Schema.Struct({
  id: Schema.String,
  ticker: Schema.String,
  holderId: Schema.String,
  holderKind: Schema.Union([Schema.Literal("user"), Schema.Literal("npc")]),
  side: Schema.Union([Schema.Literal("long"), Schema.Literal("short")]),
  marginCents: Schema.Number,
  sizeCents: Schema.Number,
  leverage: Schema.Number,
  entryPriceCents: Schema.Number,
  markPriceCents: Schema.Number,
  indexPriceCents: Schema.Number,
  accruedFundingCents: Schema.Number,
  lastFundingPeriod: Schema.Number,
  unrealizedPnlCents: Schema.Number,
  equityCents: Schema.Number,
  liquidationPriceCents: Schema.Number,
  status: Schema.Union([Schema.Literal("open"), Schema.Literal("closed"), Schema.Literal("liquidated")]),
  realizedPnlCents: Schema.Number,
  closedAt: Schema.NullOr(Schema.Number),
  createdAt: Schema.Number
})

const StoredOpenPerpReceiptSchema = Schema.Struct({
  tradeId: Schema.String,
  positionId: Schema.String,
  action: Schema.Union([
    Schema.Literal("open"),
    Schema.Literal("add"),
    Schema.Literal("reduce"),
    Schema.Literal("close"),
    Schema.Literal("flip")
  ]),
  position: StoredPerpPositionViewSchema,
  collateralCents: Schema.Number,
  sizeCents: Schema.Number,
  leverage: Schema.Number,
  feeCents: Schema.Number,
  executionPriceCents: Schema.Number,
  realizedPnlCents: Schema.Number,
  closedPositionId: Schema.NullOr(Schema.String),
  balanceAfterCents: Schema.Number,
  createdAt: Schema.Number
})

const StoredClosePerpReceiptSchema = Schema.Struct({
  tradeId: Schema.String,
  positionId: Schema.String,
  ticker: Schema.String,
  side: Schema.Union([Schema.Literal("long"), Schema.Literal("short")]),
  sizeCents: Schema.Number,
  remainingSizeCents: Schema.Number,
  isFullClose: Schema.Boolean,
  exitPriceCents: Schema.Number,
  netCreditCents: Schema.Number,
  feeCents: Schema.Number,
  realizedPnlCents: Schema.Number,
  balanceAfterCents: Schema.Number,
  closedAt: Schema.Number
})

function buildFreshPerpOrderPreview(input: {
  readonly ownerId?: string
  readonly ticker: string
  readonly side: PerpSide
  readonly action: PerpOrderAction
  readonly collateralCents: number
  readonly sizeCents: number
  readonly leverage: number
  readonly feeCents: number
  readonly totalDebitCents: number
  readonly indexPriceCents: number
  readonly preMarkPriceCents: number
  readonly executionPriceCents: number
  readonly nextLongOi: number
  readonly nextShortOi: number
}): PerpOrderPreview {
  const estimatedLiquidationPriceCents = computeLiquidationPriceCents({
    posId: 1,
    owner: input.ownerId ?? "",
    perpSide: input.side === "short" ? "Short" : "Long",
    sizeCents: input.sizeCents,
    leverage: input.leverage,
    marginCents: input.collateralCents,
    entryPriceCents: input.executionPriceCents,
    openedPeriod: 0,
    lastFundingPeriod: 0,
    fundingPaidCents: 0
  })
  return {
    ticker: input.ticker,
    side: input.side,
    action: input.action,
    collateralCents: input.collateralCents,
    sizeCents: input.sizeCents,
    leverage: input.leverage,
    feeCents: input.feeCents,
    totalDebitCents: input.totalDebitCents,
    indexPriceCents: input.indexPriceCents,
    preMarkPriceCents: input.preMarkPriceCents,
    executionPriceCents: input.executionPriceCents,
    priceImpactBps: computePriceImpactBps(input.preMarkPriceCents, input.executionPriceCents),
    estimatedLiquidationPriceCents,
    fundingRateBps: boundedPremiumBps(input.nextLongOi, input.nextShortOi)
  }
}

effect function executePerpFlipTx(
  tx: Tx,
  input: {
    readonly existingRow: Row
    readonly market: PerpMarketSnapshot
    readonly existingSizeCents: number
    readonly ownerId: string
    readonly ownerKind: MarketActorKind
    readonly side: PerpSide
    readonly collateralCents: number
    readonly sizeCents: number
    readonly leverage: number
    readonly viaClientName: string | null
    readonly currentPeriod: number
    readonly now: number
  }
): OpenPerpReceipt!(MarketFailure | StoreFailure) {
  const closedOld = try settlePerpCloseSliceTx(tx, {
    posRow: input.existingRow,
    market: input.market,
    closeSizeCents: input.existingSizeCents,
    viaClientName: input.viaClientName,
    now: input.now
  })
  try assertUserPerpExposureAndPositionCap(tx, input.ownerId, input.ownerKind, input.sizeCents, true)
  const postCloseMarket: PerpMarketSnapshot = {
    ...input.market,
    longOiCents: closedOld.nextLongOi,
    shortOiCents: closedOld.nextShortOi,
    markPriceCents: closedOld.postCloseMark
  }
  return try insertFreshPerpPositionTx(tx, {
    ownerId: input.ownerId,
    ownerKind: input.ownerKind,
    market: postCloseMarket,
    side: input.side,
    collateralCents: input.collateralCents,
    sizeCents: input.sizeCents,
    leverage: input.leverage,
    viaClientName: input.viaClientName,
    currentPeriod: input.currentPeriod,
    action: "flip",
    realizedPnlCents: closedOld.receipt.realizedPnlCents,
    closedPositionId: closedOld.receipt.positionId,
    priorFeeCents: closedOld.receipt.feeCents,
    now: input.now
  })
}

effect function saveIdempotentPerpReceipt(
  tx: Tx,
  tradeId: string,
  idempotencyKey: string | null,
  requestFingerprint: string,
  receipt: unknown
): void!StoreFailure {
  if (idempotencyKey === null) return
  try tx.query(
    `UPDATE feed_trades
     SET idempotency_key = $2, request_fingerprint = $3, receipt_json = $4
     WHERE id = $1`,
    [tradeId, idempotencyKey, requestFingerprint, JSON.stringify(receipt)]
  )
}

export effect function openPerpPosition(input: OpenPerpInput): OpenPerpReceipt!(MarketFailure | StoreFailure)!Store {
  const sizeCents = try validatePerpOrderInput(input)
  const viaClientName = normalizeViaClient(input.viaClientName)
  const idempotencyKey = try normalizeIdempotencyKey(input.idempotencyKey)
  const fingerprint = `open:${input.ticker}:${input.side}:${input.collateralCents}:${input.leverage}:${input.mode ?? ""}`
  const store = try Store
  const now = try resolveTradeNowMs(input.nowMs)
  const currentPeriod = fundingPeriodFromSeconds(Math.floor(now / 1000))
  return try store.transaction(effect (tx: Tx) => {
    if (idempotencyKey !== null) {
      const replayed = try findIdempotentTradeReceipt(
        tx,
        input.ownerId,
        idempotencyKey,
        fingerprint,
        StoredOpenPerpReceiptSchema,
        "OpenPerpReceipt"
      )
      if (replayed !== null) return replayed
    }
    const market = try lockPerpMarket(tx, input.ticker)
    if (input.leverage > market.maxLeverage) {
      throw marketFail("INVALID_LEVERAGE", `Market leverage cap is ${market.maxLeverage}x`)
    }
    const orderCap = getPerpMarketOrderSizeLimitCents(market.longOiCents + market.shortOiCents)
    if (sizeCents > orderCap) {
      throw marketFail("ORDER_LIMIT_EXCEEDED", `Order size exceeds market limit (${orderCap} cents)`)
    }
    const existingRows = try tx.query(
      "SELECT * FROM feed_perp_positions WHERE holder_id = $1 AND ticker = $2 AND status = 'open' FOR UPDATE",
      [input.ownerId, input.ticker]
    )
    let receipt: OpenPerpReceipt
    if (existingRows.length === 0) {
      try assertUserPerpExposureAndPositionCap(tx, input.ownerId, input.ownerKind, sizeCents, true)
      receipt = try insertFreshPerpPositionTx(tx, {
        ownerId: input.ownerId,
        ownerKind: input.ownerKind,
        market,
        side: input.side,
        collateralCents: input.collateralCents,
        sizeCents,
        leverage: input.leverage,
        ...(input.maxSlippageBps === undefined ? {} : { maxSlippageBps: input.maxSlippageBps }),
        viaClientName,
        currentPeriod,
        action: "open",
        realizedPnlCents: 0,
        closedPositionId: null,
        now
      })
    } else {
      const existingRow = existingRows[0]!
      const existing = toSpecPerpPosition(existingRow)
      const existingSide: PerpSide = existing.perpSide === "Short" ? "short" : "long"
      if (existingSide === input.side) {
        try assertUserPerpExposureAndPositionCap(tx, input.ownerId, input.ownerKind, sizeCents, false)
        receipt = try addToPerpPositionTx(tx, {
          existingRow,
          market,
          side: input.side,
          addCollateralCents: input.collateralCents,
          addSizeCents: sizeCents,
          ...(input.maxSlippageBps === undefined ? {} : { maxSlippageBps: input.maxSlippageBps }),
          viaClientName,
          now
        })
      } else if (input.mode === "flip") {
        const { executionPriceCents: finalFlipMark } = computeFlippedOiAndMark(
          market.indexPriceCents,
          market.longOiCents,
          market.shortOiCents,
          existingSide,
          existing.sizeCents,
          input.side,
          sizeCents
        )
        try assertSlippageWithinCap(market.markPriceCents, finalFlipMark, input.maxSlippageBps)
        receipt = try executePerpFlipTx(tx, {
          existingRow,
          market,
          existingSizeCents: existing.sizeCents,
          ownerId: input.ownerId,
          ownerKind: input.ownerKind,
          side: input.side,
          collateralCents: input.collateralCents,
          sizeCents,
          leverage: input.leverage,
          viaClientName,
          currentPeriod,
          now
        })
      } else if (sizeCents <= existing.sizeCents) {
        const settled = try settlePerpCloseSliceTx(tx, {
          posRow: existingRow,
          market,
          closeSizeCents: sizeCents,
          ...(input.maxSlippageBps === undefined ? {} : { maxSlippageBps: input.maxSlippageBps }),
          viaClientName,
          now
        })
        const posRow = {
          ...settled.updatedPositionRow,
          mark_price_cents: settled.postCloseMark,
          index_price_cents: market.indexPriceCents
        }
        receipt = {
          tradeId: settled.receipt.tradeId,
          positionId: settled.receipt.positionId,
          action: settled.receipt.isFullClose ? "close" : "reduce",
          position: toPerpPositionView(posRow),
          collateralCents: 0,
          sizeCents,
          leverage: existing.leverage,
          feeCents: settled.receipt.feeCents,
          executionPriceCents: settled.receipt.exitPriceCents,
          realizedPnlCents: settled.receipt.realizedPnlCents,
          closedPositionId: settled.receipt.isFullClose ? settled.receipt.positionId : null,
          balanceAfterCents: settled.receipt.balanceAfterCents,
          createdAt: now
        }
      } else {
        const flipSizeCents = sizeCents - existing.sizeCents
        if (flipSizeCents < MIN_ORDER_SIZE_CENTS) {
          throw marketFail("ORDER_TOO_SMALL", `Flipped position size must be at least ${MIN_ORDER_SIZE_CENTS} cents`)
        }
        const { executionPriceCents: finalFlipMark } = computeFlippedOiAndMark(
          market.indexPriceCents,
          market.longOiCents,
          market.shortOiCents,
          existingSide,
          existing.sizeCents,
          input.side,
          flipSizeCents
        )
        try assertSlippageWithinCap(market.markPriceCents, finalFlipMark, input.maxSlippageBps)
        const flipCollateralCents = ceilDiv(flipSizeCents, input.leverage)
        receipt = try executePerpFlipTx(tx, {
          existingRow,
          market,
          existingSizeCents: existing.sizeCents,
          ownerId: input.ownerId,
          ownerKind: input.ownerKind,
          side: input.side,
          collateralCents: flipCollateralCents,
          sizeCents: flipSizeCents,
          leverage: input.leverage,
          viaClientName,
          currentPeriod,
          now
        })
      }
    }
    try saveIdempotentPerpReceipt(tx, receipt.tradeId, idempotencyKey, fingerprint, receipt)
    return receipt
  })
}

export effect function closePerpPosition(input: ClosePerpInput): ClosePerpReceipt!(MarketFailure | StoreFailure)!Store {
  const viaClientName = normalizeViaClient(input.viaClientName)
  const idempotencyKey = try normalizeIdempotencyKey(input.idempotencyKey)
  const fingerprint = `close:${input.positionId}:${input.sizeCents ?? ""}:${input.closePct ?? ""}`
  const store = try Store
  const now = try resolveTradeNowMs(input.nowMs)
  return try store.transaction(effect (tx: Tx) => {
    if (idempotencyKey !== null) {
      const replayed = try findIdempotentTradeReceipt(
        tx,
        input.ownerId,
        idempotencyKey,
        fingerprint,
        StoredClosePerpReceiptSchema,
        "ClosePerpReceipt"
      )
      if (replayed !== null) return replayed
    }
    const posRows = try tx.query("SELECT * FROM feed_perp_positions WHERE id = $1 FOR UPDATE", [input.positionId])
    if (posRows.length === 0) {
      throw marketFail("POSITION_NOT_FOUND", `Position not found: ${input.positionId}`)
    }
    const pos = posRows[0]!
    if (requiredText(pos.holder_id) !== input.ownerId) {
      throw marketFail("FORBIDDEN", "Not your position")
    }
    if (requiredText(pos.status) !== "open") {
      throw marketFail("POSITION_CLOSED", "Position is already closed")
    }
    const totalSizeCents = toInt(pos.size_cents)
    let closeSizeCents = totalSizeCents
    if (input.sizeCents !== undefined) {
      try assertSafePositiveInt(input.sizeCents, "INVALID_AMOUNT", "sizeCents must be a positive integer")
      if (input.sizeCents > totalSizeCents) {
        throw marketFail("INVALID_AMOUNT", "Close size exceeds open position size")
      }
      closeSizeCents = input.sizeCents
    } else if (input.closePct !== undefined) {
      if (!Number.isFinite(input.closePct) || input.closePct < 1 || input.closePct > 100) {
        throw marketFail("INVALID_AMOUNT", "closePct must be between 1 and 100")
      }
      closeSizeCents = input.closePct >= 100 ? totalSizeCents : Math.floor((totalSizeCents * input.closePct) / 100)
      if (closeSizeCents <= 0) {
        throw marketFail("ORDER_TOO_SMALL", "Partial close size is zero")
      }
    }
    const market = try lockPerpMarket(tx, requiredText(pos.ticker))
    const settled = try settlePerpCloseSliceTx(tx, {
      posRow: pos,
      market,
      closeSizeCents,
      ...(input.maxSlippageBps === undefined ? {} : { maxSlippageBps: input.maxSlippageBps }),
      viaClientName,
      now
    })
    try saveIdempotentPerpReceipt(tx, settled.receipt.tradeId, idempotencyKey, fingerprint, settled.receipt)
    return settled.receipt
  })
}

export effect function liquidateEligiblePositions(): LiquidationSweepSummary!(MarketFailure | StoreFailure)!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const summary = try store.transaction(effect (tx: Tx) => {
    const marketRows = try tx.query(
      "SELECT ticker, index_price_cents, mark_price_cents, long_oi_cents, short_oi_cents FROM feed_perp_markets ORDER BY ticker ASC FOR UPDATE"
    )
    const liveMarkets = new Map<string, { indexPriceCents: number; markPriceCents: number; longOiCents: number; shortOiCents: number }>()
    for (const row of marketRows) {
      liveMarkets.set(requiredText(row.ticker), {
        indexPriceCents: toInt(row.index_price_cents),
        markPriceCents: toInt(row.mark_price_cents),
        longOiCents: toInt(row.long_oi_cents),
        shortOiCents: toInt(row.short_oi_cents)
      })
    }
    const rows = try tx.query(
      `SELECT *
       FROM feed_perp_positions
       WHERE status = 'open'
       ORDER BY ticker ASC, created_at ASC, id ASC
       FOR UPDATE`
    )
    const liquidatedIds: Array<string> = []
    const liquidatedPositions: Array<LiquidatedPositionInfo> = []
    for (const row of rows) {
      const ticker = requiredText(row.ticker)
      const liveMarket = liveMarkets.get(ticker)
      if (liveMarket === undefined) continue
      const specPos = toSpecPerpPosition(row)
      const equityBefore = positionEquityAtMark(specPos, liveMarket.markPriceCents)
      if (equityBefore > maintenanceMarginCents(specPos.sizeCents)) continue
      const posId = requiredText(row.id)
      const side: PerpSide = specPos.perpSide === "Short" ? "short" : "long"
      const nextLongOi = side === "long" ? Math.max(0, liveMarket.longOiCents - specPos.sizeCents) : liveMarket.longOiCents
      const nextShortOi = side === "short" ? Math.max(0, liveMarket.shortOiCents - specPos.sizeCents) : liveMarket.shortOiCents
      const postLiqMark = computeMarkPriceCents(liveMarket.indexPriceCents, nextLongOi, nextShortOi)
      const payoutCents = clampMin0(positionEquityAtMark(specPos, postLiqMark))
      const openFeeCents = canonicalTradingFee(specPos.sizeCents)
      const realizedPnlCents = payoutCents - specPos.marginCents - openFeeCents
      const updated = try tx.query(
        `UPDATE feed_perp_positions
         SET status = 'liquidated', realized_pnl_cents = realized_pnl_cents + $2, closed_at = $3
         WHERE id = $1 AND status = 'open'
         RETURNING id`,
        [posId, realizedPnlCents, now]
      )
      if (updated.length === 0) continue
      try updatePerpMarketOiAndMark(tx, ticker, liveMarket.indexPriceCents, nextLongOi, nextShortOi, now)
      liveMarket.longOiCents = nextLongOi
      liveMarket.shortOiCents = nextShortOi
      liveMarket.markPriceCents = postLiqMark
      const holderKind: MarketActorKind = requiredText(row.holder_kind) === "npc" ? "npc" : "user"
      const balanceAfterCents = try creditActorBalance(tx, specPos.owner, holderKind, payoutCents, 0, now)
      const tradeId = newMarketId()
      try insertTradeRecord(tx, {
        tradeId,
        traderId: specPos.owner,
        traderKind: holderKind,
        marketKind: "perp",
        marketRef: ticker,
        side: side === "short" ? "liquidate_short" : "liquidate_long",
        notionalCents: specPos.sizeCents,
        feeCents: 0,
        sharesOrSize: specPos.sizeCents,
        priceCents: postLiqMark,
        realizedPnlCents,
        viaClientName: null,
        createdAt: now
      })
      if (payoutCents > 0) {
        try insertLedgerEntry(tx, {
          ledgerId: newMarketId(),
          accountId: specPos.owner,
          kind: "perp_liquidation",
          deltaCents: payoutCents,
          balanceAfterCents,
          refId: posId,
          createdAt: now
        })
      }
      try insertPriceHistory(tx, {
        marketKind: "perp",
        marketRef: ticker,
        priceCents: liveMarket.indexPriceCents,
        markPriceCents: postLiqMark,
        volumeCents: specPos.sizeCents,
        recordedAt: now
      })
      if (holderKind === "user") {
        const direction = side === "long" ? "Long" : "Short"
        try insertMarketNotification(tx, {
          id: `perp_liquidated:${posId}`,
          accountId: specPos.owner,
          kind: "perp_liquidated",
          marketId: null,
          title: `$${ticker} ${direction} position liquidated`,
          body: `Your ${specPos.leverage}x $${ticker} ${direction} position was liquidated at ${(postLiqMark / 100).toFixed(2)} pts. Remaining equity credited: ${(payoutCents / 100).toFixed(2)} pts.`,
          createdAt: now
        })
      }
      liquidatedIds.push(posId)
      liquidatedPositions.push({
        positionId: posId,
        holderId: specPos.owner,
        holderKind,
        ticker,
        side,
        sizeCents: specPos.sizeCents,
        leverage: specPos.leverage,
        liquidationMarkPriceCents: postLiqMark,
        payoutCents,
        realizedPnlCents
      })
    }
    return {
      checkedCount: rows.length,
      liquidatedCount: liquidatedIds.length,
      liquidatedPositionIds: liquidatedIds,
      liquidatedPositions
    }
  })
  for (const liq of summary.liquidatedPositions) {
    try maybePublishMarketPerpEvent({
      type: "market.perp",
      action: "liquidate",
      actorId: liq.holderId,
      ticker: liq.ticker,
      side: liq.side,
      sizeCents: liq.sizeCents,
      leverage: liq.leverage,
      positionId: liq.positionId,
      markPriceCents: liq.liquidationMarkPriceCents
    })
  }
  return summary
}

export effect function accruePerpFunding(nowMs?: number): FundingAccrualSummary!(MarketFailure | StoreFailure)!Store {
  const store = try Store
  const now = nowMs ?? (try Clock.currentTimeMillis)
  const period = fundingPeriodFromSeconds(Math.floor(now / 1000))
  return try store.transaction(effect (tx: Tx) => {
    const worldRows = try tx.query(
      "SELECT funding_cutover_period FROM feed_world_state WHERE singleton = true FOR UPDATE"
    )
    const cutoverPeriod = worldRows.length > 0 ? toInt(worldRows[0]!.funding_cutover_period) : 0
    if (period < cutoverPeriod) {
      return { period, accruedCount: 0, skippedCutover: true }
    }
    const marketRows = try tx.query(
      "SELECT ticker, long_oi_cents, short_oi_cents FROM feed_perp_markets ORDER BY ticker ASC FOR UPDATE"
    )
    let accruedCount = 0
    for (const market of marketRows) {
      const ticker = requiredText(market.ticker)
      const premBps = boundedPremiumBps(toInt(market.long_oi_cents), toInt(market.short_oi_cents))
      const posRows = try tx.query(
        `SELECT * FROM feed_perp_positions
         WHERE ticker = $1 AND status = 'open'
         ORDER BY created_at ASC, id ASC
         FOR UPDATE`,
        [ticker]
      )
      for (const row of posRows) {
        const specPos = toSpecPerpPosition(row)
        if (period <= specPos.openedPeriod || period <= specPos.lastFundingPeriod) continue
        const delta = fundingDeltaForPosition(specPos, premBps)
        const claimed = try tx.query(
          `INSERT INTO feed_perp_funding_periods (position_id, period_index, funding_delta_cents, created_at)
           VALUES ($1, $2, $3, $4)
           ON CONFLICT (position_id, period_index) DO NOTHING
           RETURNING position_id`,
          [requiredText(row.id), period, delta, now]
        )
        if (claimed.length === 0) continue
        try tx.query(
          `UPDATE feed_perp_positions
           SET accrued_funding_cents = accrued_funding_cents + $2, last_funding_period = $3
           WHERE id = $1`,
          [requiredText(row.id), delta, period]
        )
        accruedCount += 1
      }
      try tx.query(
        `UPDATE feed_perp_markets
         SET funding_rate_bps = $2, last_funding_period = $3, updated_at = $4
         WHERE ticker = $1 AND last_funding_period < $3`,
        [ticker, premBps, period, now]
      )
    }
    return { period, accruedCount, skippedCutover: false }
  })
}
