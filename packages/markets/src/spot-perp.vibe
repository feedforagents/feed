export type PerpSide = "long" | "short"
export type PerpPositionStatus = "open" | "closed" | "liquidated"
export type PerpOrderAction = "open" | "add" | "reduce" | "close" | "flip"
export type PerpOrderMode = "open" | "add" | "reduce" | "flip"

export const MAX_PERP_USER_EXPOSURE_CENTS = 100_000_000
export const MAX_POSITIONS_PER_USER = 50
export const MIN_PERP_MARKET_ORDER_LIMIT_CENTS = 1_000_000

export function getPerpMarketOrderSizeLimitCents(openInterestCents: number): number {
  return Math.max(Math.floor(Math.max(0, openInterestCents) * 0.1), MIN_PERP_MARKET_ORDER_LIMIT_CENTS)
}

