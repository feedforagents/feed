  buyNextYesReserve,
  buySharesBought,
  cpmmSellGrossUnits,
  oddsWithinBoundsOrUnwinding,
  yesOddsBps,
  type Side
} from "../gen/markets__prediction.effect.vibe"
import {
  type MarketFailure,
  assertSafePositiveInt,
  ceilDivProduct,
  creditActorBalance,
  debitActorBalance,
  insertLedgerEntry,
