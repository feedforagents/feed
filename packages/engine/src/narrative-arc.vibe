// spec/engine/narrativeArc.md, "Story: Advance rolling arcs and publish phase-aware clues"; spec/engine/narrativeArc.md, "Story: Prepare private proofs and settle expired markets safely"
import { parseJsonModelRecord } from "@elizaos/core"
import { Store, type StoreFailure, type Tx, toInt, toText } from "@repo/db"
import { resolvePredictionMarket, type MarketFailure } from "@repo/markets"
import { organizations } from "@repo/pack-default"
import { createPost, type SocialFailure } from "@repo/social"
import {
  declassifyResolution,
  isOpenTradingPhase,
  makeSecretDraft,
  phaseMatchesClue,
  type CluePhase,
  type MarketPhase,
  type SecretOutcome,
} from "../gen/engine__narrativeArc.effect.vibe"
import { generateCompletion } from "./llm-client.vibe"
import { buildWorldContext, renderPrompt, type WorldContextMarketItem } from "./prompts.vibe"
import { EngineFailure, hashString, maybePublishFeedEvent, newEngineId, resolveClockNow, sanitizeText } from "./shared.vibe"

export const ROLLING_SLOT_TIMEFRAMES: ReadonlyArray<{ readonly timeframe: string; readonly durationMs: number }> = [
  { timeframe: "3d", durationMs: 3 * 86_400_000 },
  { timeframe: "2d", durationMs: 2 * 86_400_000 },
  { timeframe: "1d", durationMs: 86_400_000 },
  { timeframe: "12h", durationMs: 12 * 3_600_000 },
  { timeframe: "6h", durationMs: 6 * 3_600_000 },
  { timeframe: "1h", durationMs: 3_600_000 },
  { timeframe: "30m", durationMs: 30 * 60_000 },
  { timeframe: "30m", durationMs: 30 * 60_000 },
  { timeframe: "15m", durationMs: 15 * 60_000 },
  { timeframe: "15m", durationMs: 15 * 60_000 },
]

export interface PhaseAdvanceResult {
  readonly flippedWindows: number
  readonly newlyExpired: number
}

export interface RecoveryRunResult {
  readonly processed: number
  readonly resolved: number
  readonly manualHolds: number
  readonly retried: number
  readonly pendingCount: number
  readonly oldestPendingAt: number | null
}

export interface ManualResolutionResult {
  readonly marketId: string
  readonly outcome: "yes" | "no"
  readonly articleId: string
  readonly replacementMarketId: string | null
}

function normalizeMarketPhase(
  status: string,
  dbPhase: string,
  createdAt: number,
  expiresAt: number,
  nowMs: number,
  resolvedOutcome?: string,
): MarketPhase {
  if (status === "resolved") return resolvedOutcome === "NO" ? "ResolvedNo" : "ResolvedYes"
  if (status === "manual_hold") return "ManualHold"
  if (status === "awaiting_proof") return "AwaitingProof"
  if (status === "expired" || (status === "open" && expiresAt <= nowMs)) return "Expired"
  const elapsed = (nowMs - createdAt) / Math.max(1, expiresAt - createdAt)
  const lower = dbPhase.toLowerCase()
  if (elapsed >= 0.66 || lower === "climax" || lower === "live" || lower === "active") return "Climax"
  if (elapsed >= 0.33 || lower === "mid" || lower === "setup") return "Mid"
  return "Opening"
}

function phaseToDbSlug(phase: MarketPhase): string {
  switch (phase) {
    case "Opening":
      return "opening"
    case "Mid":
      return "mid"
    case "Climax":
      return "climax"
    case "Expired":
      return "expired"
    case "AwaitingProof":
      return "awaiting_proof"
    case "ManualHold":
      return "manual_hold"
    case "ResolvedYes":
    case "ResolvedNo":
      return "resolved"
  }
}

function phaseToCluePhase(phase: MarketPhase): { readonly spec: CluePhase; readonly slug: string } | null {
  switch (phase) {
    case "Opening":
      return { spec: "ClueOpening", slug: "opening" }
    case "Mid":
      return { spec: "ClueMid", slug: "mid" }
    case "Climax":
      return { spec: "ClueClimax", slug: "climax" }
    default:
      return null
  }
}

function parseSecretOutcome(value: string | undefined): SecretOutcome {
  if (value === "YES") return "SecretYes"
  if (value === "NO") return "SecretNo"
  return "SecretUnset"
}

export effect function advanceNarrativePhases(nowMs?: number): PhaseAdvanceResult!(EngineFailure | StoreFailure)!Store {
  const resolvedNow = try resolveClockNow(nowMs)
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      `SELECT id, phase, status, created_at, expires_at
       FROM feed_prediction_markets
       WHERE status = 'open'`,
    )
    let flippedWindows = 0
    let newlyExpired = 0
    for (const row of rows) {
      const id = toText(row.id) ?? ""
      const dbPhase = toText(row.phase) ?? "opening"
      const createdAt = toInt(row.created_at)
      const expiresAt = toInt(row.expires_at)
      const targetPhase = normalizeMarketPhase("open", dbPhase, createdAt, expiresAt, resolvedNow)
      const targetSlug = phaseToDbSlug(targetPhase)
      if (targetPhase === "Expired") {
        try tx.query(
          `UPDATE feed_prediction_markets SET status = 'expired', phase = 'expired' WHERE id = $1 AND status = 'open'`,
          [id],
        )
        try tx.query(
          `INSERT INTO feed_prediction_resolution_work (market_id, attempts, last_error, next_retry_at, updated_at)
           VALUES ($1, 0, NULL, $2, $2)
           ON CONFLICT (market_id) DO NOTHING`,
          [id, resolvedNow],
        )
        newlyExpired += 1
      } else if (targetSlug !== dbPhase) {
        try tx.query(
          `UPDATE feed_prediction_markets SET phase = $2 WHERE id = $1 AND status = 'open'`,
          [id, targetSlug],
        )
        flippedWindows += 1
      }
    }
    return { flippedWindows, newlyExpired }
  })
}

export effect function loadPublicWorldSnapshot(tx: Tx): {
  readonly currentDay: number
  readonly currentHour: number
  readonly phase: string
  readonly worldContext: string
  readonly openMarketIds: ReadonlyArray<string>
  readonly tickers: ReadonlyArray<string>
  readonly existingQuestions: ReadonlyArray<string>
}!StoreFailure {
  const stateRows = try tx.query("SELECT current_day, current_hour, phase FROM feed_world_state WHERE singleton = true")
  const stateRow = stateRows[0] ?? {}
  const currentDay = Math.max(1, toInt(stateRow.current_day) || 1)
  const currentHour = Math.max(0, toInt(stateRow.current_hour))
  const phase = toText(stateRow.phase) ?? "active"
  const factsRows = try tx.query("SELECT fact_text FROM feed_world_facts ORDER BY created_at DESC LIMIT 6")
  const rssRows = try tx.query("SELECT COALESCE(parody_headline, title) AS headline FROM feed_rss_headlines ORDER BY published_at DESC LIMIT 5")
  const marketRows = try tx.query(
    `SELECT id, question, category, timeframe, phase, yes_shares, no_shares, expires_at
     FROM feed_prediction_markets
     WHERE status = 'open'
     ORDER BY slot_index ASC NULLS LAST, expires_at ASC`,
  )
  const perpRows = try tx.query("SELECT ticker, mark_price_cents, index_price_cents, funding_rate_bps FROM feed_perp_markets ORDER BY ticker ASC LIMIT 12")
  const postRows = try tx.query(
    `SELECT id, author_id, author_kind, content
     FROM feed_posts
     WHERE deleted_at IS NULL
     ORDER BY created_at DESC
     LIMIT 8`,
  )
  const openMarkets: WorldContextMarketItem[] = marketRows.map((row) => {
    const yes = Math.max(1, toInt(row.yes_shares))
    const no = Math.max(1, toInt(row.no_shares))
    return {
      id: toText(row.id) ?? "",
      question: toText(row.question) ?? "",
      category: toText(row.category) ?? "general",
      timeframe: toText(row.timeframe) ?? "1d",
      phase: toText(row.phase) ?? "opening",
      yesProbPct: Math.round((no * 100) / (yes + no)),
      expiresAt: toInt(row.expires_at),
    }
  })
  const worldContext = buildWorldContext({
    currentDay,
    currentHour,
    phase,
    worldFacts: factsRows.map((r) => toText(r.fact_text) ?? "").filter((s) => s.length > 0),
    parodyHeadlines: rssRows.map((r) => toText(r.headline) ?? "").filter((s) => s.length > 0),
    openMarkets,
    perpMarkets: perpRows.map((r) => ({
      ticker: toText(r.ticker) ?? "",
      markPriceCents: toInt(r.mark_price_cents),
      indexPriceCents: toInt(r.index_price_cents),
      fundingRateBps: toInt(r.funding_rate_bps),
    })),
    recentPosts: postRows.map((r) => ({
      id: toText(r.id) ?? "",
      authorId: toText(r.author_id) ?? "",
      authorKind: toText(r.author_kind) ?? "npc",
      content: toText(r.content) ?? "",
    })),
  })
  return {
    currentDay,
    currentHour,
    phase,
    worldContext,
    openMarketIds: openMarkets.map((m) => m.id),
    tickers: perpRows.map((r) => toText(r.ticker) ?? "").filter((t) => t.length > 0),
    existingQuestions: openMarkets.map((m) => m.question),
  }
}

export effect function publishPhaseClues(nowMs?: number): number!(EngineFailure | StoreFailure | SocialFailure)!Store {
  const resolvedNow = try resolveClockNow(nowMs)
  const store = try Store
  const candidates = try store.transaction(effect (tx: Tx) => {
    const snapshot = try loadPublicWorldSnapshot(tx)
    const markets = try tx.query(
      `SELECT id, question, category, phase, created_at, expires_at
       FROM feed_prediction_markets
       WHERE status = 'open' AND expires_at > $1
       ORDER BY expires_at ASC
       LIMIT 10`,
      [resolvedNow],
    )
    const actorsRows = try tx.query("SELECT id, name, username, system_prompt FROM feed_actors ORDER BY id ASC")
    const clueRows = try tx.query("SELECT clue_key, market_id, actor_id FROM feed_npc_market_clues")
    const existingKeys = new Set(clueRows.map((r) => toText(r.clue_key) ?? ""))
    return { snapshot, markets, actorsRows, existingKeys }
  })
  if (candidates.actorsRows.length === 0) return 0
  let published = 0
  for (const market of candidates.markets) {
    if (published >= 3) break
    const marketId = toText(market.id) ?? ""
    const dbPhase = toText(market.phase) ?? "opening"
    const specPhase = normalizeMarketPhase("open", dbPhase, toInt(market.created_at), toInt(market.expires_at), resolvedNow)
    const clueTarget = phaseToCluePhase(specPhase)
    if (!isOpenTradingPhase(specPhase) || clueTarget === null || !phaseMatchesClue(specPhase, clueTarget.spec)) {
      continue
    }
    const clueKey = `${marketId}:${clueTarget.slug}`
    if (candidates.existingKeys.has(clueKey)) continue
    const actorIndex = hashString(clueKey) % candidates.actorsRows.length
    const actor = candidates.actorsRows[actorIndex]!
    const actorId = toText(actor.id) ?? ""
    const rendered = renderPrompt("cluePost", {
      actorName: toText(actor.name) ?? actorId,
      actorHandle: toText(actor.username) ?? actorId,
      actorVoice: sanitizeText(toText(actor.system_prompt) ?? "Skeptical market operator", 160),
      question: toText(market.question) ?? "",
      category: toText(market.category) ?? "markets",
      phase: clueTarget.slug,
      worldContext: candidates.snapshot.worldContext,
    })
    const completion = try generateCompletion({
      promptId: "cluePost",
      system: rendered.system,
      user: rendered.user,
      maxTokens: rendered.maxTokens,
      temperature: rendered.temperature,
      nowMs: resolvedNow,
      actorId,
    })
    const clueContent = sanitizeText(completion.text, 275)
    const claimed = try store.transaction(effect (tx: Tx) => {
      const currentRows = try tx.query(
        `SELECT status, phase, created_at, expires_at FROM feed_prediction_markets WHERE id = $1`,
        [marketId],
      )
      const current = currentRows[0]
      if (!current || toText(current.status) !== "open" || toInt(current.expires_at) <= resolvedNow) {
        return false
      }
      const latestSpec = normalizeMarketPhase(
        "open",
        toText(current.phase) ?? "opening",
        toInt(current.created_at),
        toInt(current.expires_at),
        resolvedNow,
      )
      if (!phaseMatchesClue(latestSpec, clueTarget.spec)) {
        return false
      }
      const inserted = try tx.query(
        `INSERT INTO feed_npc_market_clues (clue_key, market_id, actor_id, phase, post_id, created_at)
         VALUES ($1, $2, $3, $4, NULL, $5)
         ON CONFLICT (clue_key) DO NOTHING
         RETURNING clue_key`,
        [clueKey, marketId, actorId, clueTarget.slug, resolvedNow],
      )
      return inserted.length > 0
    })
    if (!claimed) continue
    const createdPost = try createPost({
      authorId: actorId,
      authorKind: "npc",
      content: clueContent,
      marketId,
    })
    const postId = createdPost.id
    try store.transaction(effect (tx: Tx) => {
      try tx.query("UPDATE feed_npc_market_clues SET post_id = $2 WHERE clue_key = $1", [clueKey, postId])
    })
    try maybePublishFeedEvent({ type: "market.clue", marketId, actorId, phase: clueTarget.slug })
    published += 1
  }
  return published
}

effect function resolveDefaultMediaOrgId(tx: Tx): string!StoreFailure {
  const rows = try tx.query("SELECT id FROM feed_organizations ORDER BY (CASE WHEN org_type = 'media' THEN 0 ELSE 1 END), id ASC LIMIT 1")
  const found = rows.length > 0 ? toText(rows[0]?.id) : undefined
  return found ?? organizations[0]?.id ?? "feed-wire"
}

effect function settleMarketWithProofArticle(input: {
  readonly marketId: string
  readonly outcome: "yes" | "no"
  readonly title: string
  readonly summary: string
  readonly body: string
  readonly approveHold: boolean
  readonly nowMs: number
}): { readonly articleId: string }!(EngineFailure | StoreFailure | MarketFailure | SocialFailure)!Store {
  const store = try Store
  const articleId = newEngineId("art")
  const authorOrgId = try store.transaction(effect (tx: Tx) => try resolveDefaultMediaOrgId(tx))
  try resolvePredictionMarket({
    marketId: input.marketId,
    outcome: input.outcome,
    proofArticleId: articleId,
    proofSummary: sanitizeText(input.summary, 480),
    approveHold: input.approveHold,
  })
  try store.transaction(effect (tx: Tx) => {
    try tx.query(
      `INSERT INTO feed_articles (id, title, summary, body, author_org_id, related_market_id, is_resolution_proof, published_at)
       VALUES ($1, $2, $3, $4, $5, $6, true, $7)
       ON CONFLICT (id) DO NOTHING`,
      [articleId, sanitizeText(input.title, 180), sanitizeText(input.summary, 360), input.body, authorOrgId, input.marketId, input.nowMs],
    )
    try tx.query("DELETE FROM feed_prediction_resolution_work WHERE market_id = $1", [input.marketId])
  })
  createPost({
    authorId: authorOrgId,
    authorKind: "org",
    content: sanitizeText(`${input.title} — ${input.summary}`, 275),
    marketId: input.marketId,
  }) catch effect () => undefined
  try maybePublishFeedEvent({ type: "market.resolved", marketId: input.marketId, outcome: input.outcome, articleId })
  return { articleId }
}

export effect function ensureRollingMarketSlots(nowMs?: number): ReadonlyArray<string>!(EngineFailure | StoreFailure)!Store {
  const resolvedNow = try resolveClockNow(nowMs)
  const store = try Store
  const state = try store.transaction(effect (tx: Tx) => {
    const occupiedRows = try tx.query(
      `SELECT slot_index FROM feed_prediction_markets
       WHERE slot_index IS NOT NULL AND status IN ('open', 'expired', 'awaiting_proof', 'manual_hold')`,
    )
    const occupied = new Set(occupiedRows.map((r) => toInt(r.slot_index)))
    const snapshot = try loadPublicWorldSnapshot(tx)
    return { occupied, snapshot }
  })
  const createdIds: string[] = []
  const existingQuestions = [...state.snapshot.existingQuestions]
  for (let slotIndex = 0; slotIndex < ROLLING_SLOT_TIMEFRAMES.length; slotIndex++) {
    if (state.occupied.has(slotIndex)) continue
    const slotSpec = ROLLING_SLOT_TIMEFRAMES[slotIndex]!
    const rendered = renderPrompt("marketQuestion", {
      slotIndex: String(slotIndex),
      timeframe: slotSpec.timeframe,
      existingQuestions: existingQuestions.slice(-10).map((q) => `- ${q}`).join("\n") || "(none)",
      worldContext: state.snapshot.worldContext,
    })
    const completion = generateCompletion({
      promptId: "marketQuestion",
      system: rendered.system,
      user: rendered.user,
      maxTokens: rendered.maxTokens,
      temperature: rendered.temperature,
      jsonMode: true,
      nowMs: resolvedNow,
    }) catch effect () => null
    const parsed = completion ? parseJsonModelRecord(completion.text) : null
    const fallbackSeed = hashString(`slot:${slotIndex}:${resolvedNow}`)
    const question = sanitizeText(
      typeof parsed?.question === "string" && parsed.question.trim().length > 8
        ? parsed.question
        : `Will slot ${slotIndex} (${slotSpec.timeframe}) trigger a major Feed catalyst before expiry?`,
      220,
    )
    const description = sanitizeText(
      typeof parsed?.description === "string" && parsed.description.trim().length > 8
        ? parsed.description
        : `Rolling ${slotSpec.timeframe} Feed prediction market for slot ${slotIndex}.`,
      500,
    )
    const category = sanitizeText(typeof parsed?.category === "string" ? parsed.category : "markets", 40) || "markets"
    const secretOutcome = parsed?.secretOutcome === "NO" || parsed?.secretOutcome === "YES"
      ? parsed.secretOutcome
      : fallbackSeed % 2 === 0
        ? "YES"
        : "NO"
    const marketId = newEngineId(`mkt-s${slotIndex}`)
    const expiresAt = resolvedNow + slotSpec.durationMs
    try store.transaction(effect (tx: Tx) => {
      const check = try tx.query(
        `SELECT id FROM feed_prediction_markets
         WHERE slot_index = $1 AND status IN ('open', 'expired', 'awaiting_proof', 'manual_hold')
         LIMIT 1`,
        [slotIndex],
      )
      if (check.length === 0) {
        try tx.query(
          `INSERT INTO feed_prediction_markets (
             id, slot_index, question, description, category, timeframe, phase,
             yes_shares, no_shares, liquidity_cents, secret_outcome, status, expires_at, created_at
           )
           VALUES ($1, $2, $3, $4, $5, $6, 'opening', 1000, 1000, 100000, $7, 'open', $8, $9)`,
          [marketId, slotIndex, question, description, category, slotSpec.timeframe, secretOutcome, expiresAt, resolvedNow],
        )
        createdIds.push(marketId)
      }
    })
    existingQuestions.push(question)
  }
  return createdIds
}

export effect function queryPendingRecovery(tx: Tx): { readonly pendingCount: number; readonly oldestPendingAt: number | null }!StoreFailure {
  const rows = try tx.query(
    `SELECT COUNT(*) AS cnt, MIN(expires_at) AS oldest
     FROM feed_prediction_markets
     WHERE status IN ('expired', 'awaiting_proof')`,
  )
  const pendingCount = Math.max(0, toInt(rows[0]?.cnt))
  const oldestRaw = rows[0]?.oldest
  const oldestPendingAt = pendingCount > 0 && oldestRaw !== null && oldestRaw !== undefined ? toInt(oldestRaw) : null
  return { pendingCount, oldestPendingAt }
}

export effect function recoverExpiredMarkets(nowMs?: number): RecoveryRunResult!(EngineFailure | StoreFailure)!Store {
  const resolvedNow = try resolveClockNow(nowMs)
  try advanceNarrativePhases(resolvedNow)
  const store = try Store
  const queueData = try store.transaction(effect (tx: Tx) => {
    try tx.query(
      `INSERT INTO feed_prediction_resolution_work (market_id, attempts, last_error, next_retry_at, updated_at)
       SELECT id, 0, NULL, $1, $1
       FROM feed_prediction_markets
       WHERE status IN ('expired', 'awaiting_proof')
       ON CONFLICT (market_id) DO NOTHING`,
      [resolvedNow],
    )
    const due = try tx.query(
      `SELECT w.market_id, w.attempts, m.question, m.description, m.secret_outcome
       FROM feed_prediction_resolution_work w
       JOIN feed_prediction_markets m ON m.id = w.market_id
       WHERE w.next_retry_at <= $1 AND m.status IN ('expired', 'awaiting_proof')
       ORDER BY w.next_retry_at ASC
       LIMIT 5`,
      [resolvedNow],
    )
    const snapshot = try loadPublicWorldSnapshot(tx)
    return { due, worldContext: snapshot.worldContext }
  })
  let processed = 0
  let resolved = 0
  let manualHolds = 0
  let retried = 0
  for (const row of queueData.due) {
    processed += 1
    const marketId = toText(row.market_id) ?? ""
    const attempts = Math.max(0, toInt(row.attempts))
    const question = toText(row.question) ?? ""
    const description = toText(row.description) ?? ""
    const rawSecret = toText(row.secret_outcome)
    const secretSpec = parseSecretOutcome(rawSecret)
    if (secretSpec === "SecretUnset" || attempts >= 3) {
      try store.transaction(effect (tx: Tx) => {
        try tx.query(
          `UPDATE feed_prediction_markets SET status = 'manual_hold', phase = 'manual_hold' WHERE id = $1 AND status IN ('expired', 'awaiting_proof')`,
          [marketId],
        )
        try tx.query("DELETE FROM feed_prediction_resolution_work WHERE market_id = $1", [marketId])
      })
      manualHolds += 1
      continue
    }
    const outcomeLower: "yes" | "no" = secretSpec === "SecretYes" ? "yes" : "no"
    const outcomeUpper = secretSpec === "SecretYes" ? "YES" : "NO"
    try store.transaction(effect (tx: Tx) => {
      try tx.query(
        `UPDATE feed_prediction_markets SET status = 'awaiting_proof', phase = 'awaiting_proof' WHERE id = $1 AND status = 'expired'`,
        [marketId],
      )
    })
    const draft = makeSecretDraft(secretSpec)
    const rendered = renderPrompt("resolutionArticle", {
      marketId,
      question,
      description,
      resolvedOutcome: outcomeUpper,
      worldContext: queueData.worldContext,
    })
    const completion = generateCompletion({
      promptId: "resolutionArticle",
      system: rendered.system,
      user: rendered.user,
      maxTokens: rendered.maxTokens,
      temperature: rendered.temperature,
      jsonMode: true,
      allowOfflineFallback: true,
      nowMs: resolvedNow,
    }) catch effect () => null
    const parsed = completion ? parseJsonModelRecord(completion.text) : null
    const title = typeof parsed?.title === "string" && parsed.title.trim().length > 0 ? parsed.title.trim() : ""
    const summary = typeof parsed?.summary === "string" && parsed.summary.trim().length > 0 ? parsed.summary.trim() : ""
    const body = typeof parsed?.body === "string" && parsed.body.trim().length > 0 ? parsed.body.trim() : ""
    if (!title || !summary || !body) {
      const nextAttempts = attempts + 1
      const nextRetryAt = resolvedNow + Math.min(300_000, 15_000 * Math.pow(2, attempts))
      try store.transaction(effect (tx: Tx) => {
        if (nextAttempts >= 3) {
          try tx.query(`UPDATE feed_prediction_markets SET status = 'manual_hold', phase = 'manual_hold' WHERE id = $1`, [marketId])
          try tx.query("DELETE FROM feed_prediction_resolution_work WHERE market_id = $1", [marketId])
        } else {
          try tx.query(
            `UPDATE feed_prediction_resolution_work
             SET attempts = $2, last_error = $3, next_retry_at = $4, updated_at = $5
             WHERE market_id = $1`,
            [marketId, nextAttempts, "Proof preparation incomplete", nextRetryAt, resolvedNow],
          )
        }
      })
      if (nextAttempts >= 3) manualHolds += 1
      else retried += 1
      continue
    }
    const auditTag = declassifyResolution(secretSpec, draft)
    const settled = settleMarketWithProofArticle({
      marketId,
      outcome: outcomeLower,
      title,
      summary: `${summary} [${auditTag}]`,
      body,
      approveHold: false,
      nowMs: resolvedNow,
    }) catch effect () => null
    if (settled === null) {
      const nextAttempts = attempts + 1
      try store.transaction(effect (tx: Tx) => {
        try tx.query(
          `UPDATE feed_prediction_resolution_work
           SET attempts = $2, last_error = $3, next_retry_at = $4, updated_at = $5
           WHERE market_id = $1`,
          [marketId, nextAttempts, "Market settlement rejected retry", resolvedNow + 30_000, resolvedNow],
        )
      })
      retried += 1
      continue
    }
    resolved += 1
  }
  if (resolved > 0) {
    ensureRollingMarketSlots(resolvedNow) catch effect () => []
  }
  const backlog = try store.transaction(effect (tx: Tx) => try queryPendingRecovery(tx))
  return {
    processed,
    resolved,
    manualHolds,
    retried,
    pendingCount: backlog.pendingCount,
    oldestPendingAt: backlog.oldestPendingAt,
  }
}

effect function resolveHoldCommon(
  marketId: string,
  explicitOutcome: "yes" | "no" | undefined,
  reason: string | undefined,
  requireReason: boolean,
): ManualResolutionResult!(EngineFailure | StoreFailure | MarketFailure | SocialFailure)!Store {
  const cleanId = marketId.trim()
  if (cleanId.length === 0) {
    throw new EngineFailure({ code: "INVALID_ARGUMENT", message: "marketId is required." })
  }
  if (requireReason && (!reason || reason.trim().length === 0)) {
    throw new EngineFailure({ code: "INVALID_ARGUMENT", message: "An admin override reason is required." })
  }
  const nowMs = try resolveClockNow()
  const store = try Store
  const market = try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      `SELECT id, question, description, status, secret_outcome
       FROM feed_prediction_markets
       WHERE id = $1`,
      [cleanId],
    )
    return rows[0] ?? null
  })
  if (!market) {
    throw new EngineFailure({ code: "NOT_FOUND", message: `Prediction market ${cleanId} not found.` })
  }
  if (toText(market.status) !== "manual_hold") {
    throw new EngineFailure({ code: "MANUAL_HOLD_INVALID", message: `Market ${cleanId} is not in manual_hold status.` })
  }
  const storedOutcome = parseSecretOutcome(toText(market.secret_outcome))
  const chosenOutcome: "yes" | "no" | null =
    explicitOutcome ?? (storedOutcome === "SecretYes" ? "yes" : storedOutcome === "SecretNo" ? "no" : null)
  if (chosenOutcome === null) {
    throw new EngineFailure({ code: "MANUAL_HOLD_INVALID", message: "Manual hold market has no stored outcome; specify yes or no." })
  }
  const question = toText(market.question) ?? cleanId
  const outcomeUpper = chosenOutcome === "yes" ? "YES" : "NO"
  const note = reason ? sanitizeText(reason, 280) : "Admin approved manual-hold settlement"
  const settled = try settleMarketWithProofArticle({
    marketId: cleanId,
    outcome: chosenOutcome,
    title: `Admin Resolution: ${sanitizeText(question, 96)} (${outcomeUpper})`,
    summary: note,
    body: `Operator resolved held prediction market "${question}" as ${outcomeUpper}. Reason: ${note}.`,
    approveHold: true,
    nowMs,
  })
  const createdIds = ensureRollingMarketSlots(nowMs) catch effect () => []
  return {
    marketId: cleanId,
    outcome: chosenOutcome,
    articleId: settled.articleId,
    replacementMarketId: createdIds[0] ?? null,
  }
}

export effect function approveManualHold(
  marketId: string,
  outcome?: "yes" | "no",
): ManualResolutionResult!(EngineFailure | StoreFailure | MarketFailure | SocialFailure)!Store {
  return try resolveHoldCommon(marketId, outcome, undefined, false)
}

export effect function overrideManualHold(
  marketId: string,
  outcome: "yes" | "no",
  reason: string,
): ManualResolutionResult!(EngineFailure | StoreFailure | MarketFailure | SocialFailure)!Store {
  return try resolveHoldCommon(marketId, outcome, reason, true)
}
