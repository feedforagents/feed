// spec/engine/index.md, "Story: Run non-blocking minute ticks and D-25 bounded NPC loops"; spec/engine/worldClock.md, "Story: Advance the world clock without blocking on inference"
import { parseJsonModelRecord } from "@elizaos/core"
import { Store, type StoreFailure, type Tx, toInt } from "@repo/db"
import { actors, organizations } from "@repo/pack-default"
import { RealtimeBus, publishFeedEvent } from "@repo/social"
import { FetchHttpClient, HttpClient, type HttpClientRequest, type HttpClientResponse } from "effect/http"

export type EngineErrorCode =
  | "BUDGET_EXCEEDED"
  | "CLOCK_MODE_INVALID"
  | "INVALID_ARGUMENT"
  | "MANUAL_HOLD_INVALID"
  | "LLM_UNAVAILABLE"
  | "RSS_FAILED"
  | "NOT_FOUND"
  | "RUNTIME_FAILED"

export error EngineFailure {
  code: EngineErrorCode
  message: string
  cause?: unknown
}

export function floorDiv(value: number, divisor: number): number {
  return Math.floor(value / divisor)
}

export function utcDayString(nowMs: number): string {
  return new Date(nowMs).toISOString().slice(0, 10)
}

function utcHourOf(nowMs: number): number {
  return new Date(nowMs).getUTCHours()
}

export function minuteIndexOf(nowMs: number): number {
  return Math.floor(nowMs / 60_000)
}

function escapeSlugRegExp(raw: string): string {
  return raw.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
}

const entityDisplayNameById: ReadonlyMap<string, string> = (() => {
  const map = new Map<string, string>()
  for (const org of organizations) {
    map.set(org.id.toLowerCase(), org.name)
    map.set(`org-${org.id.toLowerCase()}`, org.name)
  }
  for (const actor of actors) {
    map.set(actor.id.toLowerCase(), actor.name)
  }
  return map
})()

const slugReplacements: ReadonlyArray<{ readonly pattern: RegExp; readonly displayName: string }> = (() => {
  const seen = new Map<string, string>()
  for (const actor of actors) {
    if (actor.id.includes("-") && actor.name.trim().length > 0) {
      seen.set(actor.id.toLowerCase(), actor.name)
    }
  }
  for (const org of organizations) {
    if (org.id.includes("-") && org.name.trim().length > 0) {
      seen.set(org.id.toLowerCase(), org.name)
    }
    if (org.name.trim().length > 0) {
      seen.set(`org-${org.id.toLowerCase()}`, org.name)
    }
  }
  return [...seen.entries()]
    .sort((a, b) => b[0].length - a[0].length)
    .map(([slug, displayName]) => ({
      pattern: new RegExp(`(?<![a-zA-Z0-9_-])@?${escapeSlugRegExp(slug)}(?![a-zA-Z0-9_-])`, "gi"),
      displayName,
    }))
})()

export function displayNameForEntity(entityId: string, explicitName?: string): string {
  const cleanExplicit = explicitName?.trim() ?? ""
  if (cleanExplicit.length > 0) return cleanExplicit
  const cleanId = entityId.trim()
  if (cleanId.length === 0) return ""
  return entityDisplayNameById.get(cleanId.toLowerCase()) ?? cleanId
}

export function replaceActorSlugsWithNames(input: string): string {
  if (!input.includes("-")) return input
  let output = input
  for (const entry of slugReplacements) {
    output = output.replace(entry.pattern, entry.displayName)
  }
  return output
}

export function stripLeadingSelfPrefix(text: string, actorName: string, actorHandle: string): string {
  let out = text.trim()
  const candidates = [actorName.trim(), actorHandle.trim(), `@${actorHandle.trim()}`].filter((c) => c.length >= 2)
  for (const candidate of candidates) {
    const prefixPattern = new RegExp(`^@?${escapeSlugRegExp(candidate)}\\s*[:—–-]\\s*`, "i")
    out = out.replace(prefixPattern, "")
  }
  return out.trim()
}

export function trimToWordBoundary(input: string, maxLen: number): string {
  const collapsed = input.replace(/\s+/g, " ").trim()
  if (collapsed.length <= maxLen) {
    return collapsed.replace(/\s+#[a-zA-Z0-9_]{0,2}\.\.\.$/, "").trimEnd()
  }
  if (maxLen <= 3) return collapsed.slice(0, maxLen)
  const window = collapsed.slice(0, maxLen)
  const minSentenceCut = Math.floor(maxLen * 0.55)
  let sentenceCut = -1
  for (let i = window.length - 1; i >= minSentenceCut; i--) {
    const ch = window[i]
    if (ch === "." || ch === "!" || ch === "?") {
      const nextCh = collapsed[i + 1]
      if (nextCh === undefined || nextCh === " " || nextCh === "\"" || nextCh === ")") {
        sentenceCut = i + 1
        break
      }
    }
  }
  if (sentenceCut >= minSentenceCut) {
    return window.slice(0, sentenceCut).replace(/\s+#[a-zA-Z0-9_]{0,2}\.\.\.$/, "").trimEnd()
  }
  const budget = maxLen - 3
  const slice = collapsed.slice(0, budget + 1)
  const lastSpace = slice.lastIndexOf(" ")
  const minWordCut = Math.floor(budget * 0.4)
  let prefix = lastSpace >= minWordCut ? slice.slice(0, lastSpace) : collapsed.slice(0, budget)
  prefix = prefix.replace(/(?:\s+#[a-zA-Z0-9_]*|\s+[@$])+$/, "")
  prefix = prefix.replace(/[,;:\-–—(\s]+$/, "").trimEnd()
  if (prefix.length === 0) {
    prefix = collapsed.slice(0, budget).trimEnd()
  }
  if (/[.!?]$/.test(prefix)) return prefix
  return `${prefix}...`
}

export function sanitizeText(input: string, maxLen: number): string {
  let plain = ""
  for (let i = 0; i < input.length; i++) {
    const code = input.charCodeAt(i)
    plain += code <= 31 || code === 127 ? " " : input[i]!
  }
  return trimToWordBoundary(plain, maxLen)
}

export function sanitizeNarrativeText(input: string, maxLen: number): string {
  return sanitizeText(replaceActorSlugsWithNames(input), maxLen)
}

export function isRuntimeNpcActor(id: string, name?: string, username?: string): boolean {
  const cleanId = id.trim()
  if (cleanId.length === 0) return false
  if (/\btest\b/i.test(cleanId) || /^test[-_]/i.test(cleanId)) return false
  if (name !== undefined && /\btest\b/i.test(name)) return false
  if (username !== undefined && (/\btest\b/i.test(username) || /^test[-_]/i.test(username))) return false
  return true
}

export function hashString(input: string): number {
  let hash = 2166136261
  for (let i = 0; i < input.length; i++) {
    hash ^= input.charCodeAt(i)
    hash = Math.imul(hash, 16777619)
  }
  return hash >>> 0
}

module web {
  /** @throws {never} */
  export function uuid(): string {
    return globalThis.crypto.randomUUID()
  }
}
import { uuid } from web

export function newEngineId(prefix: string): string {
  return `${prefix}-${uuid()}`
}

export effect function ensureWorldStateTx(tx: Tx, nowMs: number): void!StoreFailure {
  try tx.query(
    `INSERT INTO feed_world_state (singleton, current_day, current_hour, phase, game_running, funding_cutover_period, last_tick_at, updated_at)
     VALUES (true, 1, $1, 'active', true, 0, $2, $2)
     ON CONFLICT (singleton) DO NOTHING`,
    [utcHourOf(nowMs), nowMs],
  )
}

export effect function resolveClockNow(nowMs?: number): number!(EngineFailure | StoreFailure)!Store {
  if (nowMs !== undefined) {
    if (!Number.isFinite(nowMs) || nowMs < 0) {
      throw new EngineFailure({ code: "INVALID_ARGUMENT", message: "nowMs must be a finite non-negative timestamp." })
    }
    return Math.floor(nowMs)
  }
  const wallNow = try Clock.currentTimeMillis
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query("SELECT last_tick_at FROM feed_world_state WHERE singleton = true")
    const recorded = rows.length > 0 ? toInt(rows[0]?.last_tick_at) : 0
    return Math.max(wallNow, recorded)
  })
}

export effect function recordTickHealth(
  jobName: string,
  nowMs: number,
  status: "ok" | "skipped" | "error",
  lastError: string | null,
  pendingCount: number,
  oldestPendingAt: number | null,
  durationMs: number,
): void!StoreFailure!Store {
  const store = try Store
  const safeDuration = Math.max(0, Math.floor(durationMs))
  const safePending = Math.max(0, Math.floor(pendingCount))
  const successAt = status === "ok" ? nowMs : null
  const truncatedError = lastError === null ? null : sanitizeText(lastError, 500)
  try store.transaction(effect (tx: Tx) => {
    try tx.query(
      `INSERT INTO feed_tick_health (job_name, last_run_at, last_success_at, last_status, last_error, pending_count, oldest_pending_at, duration_ms)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
       ON CONFLICT (job_name) DO UPDATE SET
         last_run_at = EXCLUDED.last_run_at,
         last_success_at = CASE WHEN EXCLUDED.last_status = 'ok' THEN EXCLUDED.last_success_at ELSE feed_tick_health.last_success_at END,
         last_status = EXCLUDED.last_status,
         last_error = EXCLUDED.last_error,
         pending_count = EXCLUDED.pending_count,
         oldest_pending_at = EXCLUDED.oldest_pending_at,
         duration_ms = EXCLUDED.duration_ms`,
      [jobName, nowMs, successAt, status, truncatedError, safePending, oldestPendingAt, safeDuration],
    )
  })
}

export effect function maybePublishFeedEvent(event: Parameters<typeof publishFeedEvent>[0]): void!never!never {
  const busOpt = try Effect.serviceOption(RealtimeBus)
  if (Option.isSome(busOpt)) {
    provide RealtimeBus = busOpt.value {
      try publishFeedEvent(event)
    }
  }
}

export function advanceDayHour(prevDay: number, baseMs: number, nextMs: number): { readonly nextDay: number; readonly nextHour: number } {
  const dayDelta = baseMs > 0 ? Math.max(0, floorDiv(nextMs, 86_400_000) - floorDiv(baseMs, 86_400_000)) : 0
  return { nextDay: prevDay + dayDelta, nextHour: utcHourOf(nextMs) }
}

export effect function executeHttpWithTimeout(
  request: HttpClientRequest.HttpClientRequest,
  duration: "8 seconds" | "25 seconds",
  failureCode: EngineErrorCode,
  failureMessage: string,
): HttpClientResponse.HttpClientResponse!EngineFailure {
  const existingClient = try Effect.serviceOption(HttpClient.HttpClient)
  const execEffect = Option.isSome(existingClient)
    ? existingClient.value.execute(request)
    : Effect.provide(HttpClient.execute(request), FetchHttpClient.layer)
  return timeout(execEffect, duration) catch effect (cause) => {
    throw new EngineFailure({ code: failureCode, message: failureMessage, cause })
  }
}

function isPlainJsonRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value)
}

function isJsonObjectStart(text: string, openIndex: number): boolean {
  for (let i = openIndex + 1; i < text.length; i++) {
    const ch = text[i]
    if (ch === " " || ch === "\t" || ch === "\n" || ch === "\r") continue
    return ch === "\"" || ch === "}"
  }
  return false
}

function extractBalancedJsonObject(text: string, startIndex: number): string | null {
  if (text[startIndex] !== "{") return null
  let depth = 0
  let inString = false
  let escaped = false
  for (let i = startIndex; i < text.length; i++) {
    const ch = text[i]
    if (inString) {
      if (escaped) {
        escaped = false
      } else if (ch === "\\") {
        escaped = true
      } else if (ch === "\"") {
        inString = false
      }
      continue
    }
    if (ch === "\"") {
      inString = true
    } else if (ch === "{") {
      depth += 1
    } else if (ch === "}") {
      depth -= 1
      if (depth === 0) return text.slice(startIndex, i + 1)
    }
  }
  return null
}

function tryParseJsonObject(candidate: string): Record<string, unknown> | null {
  try {
    const parsed: unknown = JSON.parse(candidate)
    return isPlainJsonRecord(parsed) ? parsed : null
  } catch {
    return null
  }
}

export function parseLlmJsonRecord(text: string): Record<string, unknown> | null {
  const direct = parseJsonModelRecord(text)
  if (direct !== null) return direct
  const fenceRegex = /```(?:[a-zA-Z0-9_-]+)?[ \t]*\r?\n?/g
  let fenceMatch = fenceRegex.exec(text)
  while (fenceMatch !== null) {
    let cursor = fenceMatch.index + fenceMatch[0].length
    while (cursor < text.length && (text[cursor] === " " || text[cursor] === "\t" || text[cursor] === "\n" || text[cursor] === "\r")) {
      cursor += 1
    }
    if (cursor < text.length && text[cursor] === "{" && isJsonObjectStart(text, cursor)) {
      const candidate = extractBalancedJsonObject(text, cursor)
      if (candidate !== null) {
        const parsed = tryParseJsonObject(candidate)
        if (parsed !== null) return parsed
      }
    }
    fenceMatch = fenceRegex.exec(text)
  }
  for (let i = 0; i < text.length; i++) {
    if (text[i] !== "{" || !isJsonObjectStart(text, i)) continue
    const candidate = extractBalancedJsonObject(text, i)
    if (candidate === null) continue
    const parsed = tryParseJsonObject(candidate)
    if (parsed !== null) return parsed
  }
  return null
}
