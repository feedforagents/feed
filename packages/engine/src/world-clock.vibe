const JOB_LEASE_TTL_MS = 120_000
const ORG_POST_COOLDOWN_MS = 30 * 60_000
const activeLocalJobLocks = new Set<string>()
const majorOrgSet = new Set(manifest.orgPriorities.major)
const packOrgById = new Map(organizations.map((o) => [o.id, o]))

export function utcMinuteCycle(nowMs: number): number {
  return Math.floor(nowMs / 60_000)
}

export function resolveClockMode(): ClockMode {
  const modeEnv = readEnv("FEED_CLOCK_MODE")?.trim().toLowerCase()
  if (modeEnv === "realtime") return "ClockRealtime"
  if (modeEnv === "simulated") return "ClockSimulated"
  const deployEnv = readEnv("DEPLOYMENT_ENV")?.trim().toLowerCase()
  const nodeEnv = readEnv("NODE_ENV")?.trim().toLowerCase()
  return deployEnv === "production" || nodeEnv === "production" ? "ClockRealtime" : "ClockSimulated"
}

effect function ensureJobLeasesTableTx(tx: Tx): void!StoreFailure {
  try tx.query(
    `CREATE TABLE IF NOT EXISTS feed_job_leases (
       job_name text PRIMARY KEY,
       owner_id text NOT NULL,
       lease_until bigint NOT NULL,
       updated_at bigint NOT NULL
     )`,
  )
}

function formatErrorMessage(err: unknown): string {
  if (err instanceof EngineFailure) return `${err.code}: ${err.message}`
  if (err instanceof Error) return err.message
  if (typeof err === "object" && err !== null && "message" in err && typeof err.message === "string") {
    return err.message
  }
  return String(err)
}

export function isRouteDue(route: RouteName, minuteIndex: number): boolean {
  return minuteIndex % routeCadenceMinutes(route) === 0
}

effect function guardCoreRoute(route: RouteName): void!EngineFailure {
  if (isRetiredRoute(route) || !isCoreRoute(route)) {
    throw new EngineFailure({ code: "INVALID_ARGUMENT", message: `Route ${route} is retired and cannot execute.` })
  }
}

effect function readGameRunning(nowMs: number): boolean!StoreFailure!Store {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    try ensureWorldStateTx(tx, nowMs)
    const rows = try tx.query("SELECT game_running FROM feed_world_state WHERE singleton = true")
    return rows[0]?.game_running !== false
  })
}

effect function withJobLockAndErrorHealth<A, E>(
  jobName: string,
  resolvedNow: number,
  startWall: number,
  onLockBusy: () => A,
  runBody: () => A!E!Store,
): A!(E | StoreFailure)!Store {
  const store = try Store
  if (activeLocalJobLocks.has(jobName)) {
    const endWall = try Clock.currentTimeMillis
    try recordTickHealth(jobName, resolvedNow, "skipped", "Job already running in worker", 0, null, endWall - startWall)
    return onLockBusy()
  }
  activeLocalJobLocks.add(jobName)
  const ownerId = newEngineId("lease")
  return try scoped(effect {
    try Effect.addFinalizer(() => sync(() => activeLocalJobLocks.delete(jobName)))
    const leaseAcquired = try acquireRelease(
      effect {
        const leaseNow = try Clock.currentTimeMillis
        const leaseUntil = leaseNow + JOB_LEASE_TTL_MS
        const rows = try store.transaction(effect (tx: Tx) => {
          try ensureJobLeasesTableTx(tx)
          return try tx.query(
            `INSERT INTO feed_job_leases (job_name, owner_id, lease_until, updated_at)
             VALUES ($1, $2, $3, $4)
             ON CONFLICT (job_name) DO UPDATE
             SET owner_id = EXCLUDED.owner_id,
                 lease_until = EXCLUDED.lease_until,
                 updated_at = EXCLUDED.updated_at
             WHERE feed_job_leases.lease_until <= $4
             RETURNING job_name`,
            [jobName, ownerId, leaseUntil, leaseNow],
          )
        })
        return rows.length > 0
      },
      (acquired) =>
        effect {
          if (acquired) {
            store.transaction(effect (tx: Tx) =>
              try tx.query("DELETE FROM feed_job_leases WHERE job_name = $1 AND owner_id = $2", [jobName, ownerId]),
            ) catch effect () => undefined
          }
        },
    )
    if (!leaseAcquired) {
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth(jobName, resolvedNow, "skipped", "Job lease held by concurrent worker", 0, null, endWall - startWall)
      return onLockBusy()
    }
    return runBody() catch effect (err: E) => {
      const endWall = try Clock.currentTimeMillis
      recordTickHealth(jobName, resolvedNow, "error", formatErrorMessage(err), 0, null, endWall - startWall) catch effect () => undefined
      throw err
    }
  })
}

effect function advanceWorldClockTx(tx: Tx, nowMs: number): {
  readonly nowMs: number
  readonly gameRunning: boolean
  readonly fundingCutoverPeriod: number
}!StoreFailure {
  try ensureWorldStateTx(tx, nowMs)
  const rows = try tx.query(
    `SELECT current_day, current_hour, game_running, funding_cutover_period, last_tick_at
     FROM feed_world_state
     WHERE singleton = true`,
  )
  const row = rows[0] ?? {}
  const prevTickAt = safeNonNegInt(row.last_tick_at, 0)
  const monotonicNow = Math.max(nowMs, prevTickAt)
  const prevDay = Math.max(1, safeNonNegInt(row.current_day, 1))
  const { nextDay, nextHour } = advanceDayHour(prevDay, prevTickAt, monotonicNow)
  const gameRunning = row.game_running !== false
  const fundingCutoverPeriod = try armFundingCutoverTx(tx, gameRunning, safeNonNegInt(row.funding_cutover_period, 0), monotonicNow)
  try tx.query(
    `UPDATE feed_world_state
     SET current_day = $1, current_hour = $2, last_tick_at = $3, updated_at = $3
     WHERE singleton = true`,
    [nextDay, nextHour, monotonicNow],
  )
  return { nowMs: monotonicNow, gameRunning, fundingCutoverPeriod }
}

effect function armFundingCutoverTx(tx: Tx, gameRunning: boolean, cutover: number, nowMs: number): number!StoreFailure {
  if (!gameRunning || cutover > 0) return cutover
  const period = currentFundingPeriod(minuteIndexOf(nowMs))
  try tx.query("UPDATE feed_world_state SET funding_cutover_period = $1, updated_at = $2 WHERE singleton = true", [period + 1, nowMs])
  try tx.query("UPDATE feed_perp_markets SET last_funding_period = GREATEST(last_funding_period, $1)", [period])
  return period + 1
}

effect function pendingResolutionStats(): { readonly pendingCount: number; readonly oldestPendingAt: number | null }!StoreFailure!Store {
  const store = try Store
  return try store.transaction(queryPendingRecovery)
}

effect function checkAndAccrueFunding(nowMs: number, cutoverPeriod: number): boolean!(StoreFailure | MarketFailure)!Store {
  if (cutoverPeriod <= 0) return false
  const currentPeriod = currentFundingPeriod(minuteIndexOf(nowMs))
  if (currentPeriod < cutoverPeriod) return false
  const store = try Store
  const needsAccrual = try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query("SELECT COALESCE(MIN(last_funding_period), $1) AS min_period FROM feed_perp_markets", [currentPeriod])
    const minPeriod = toInt(rows[0]?.min_period)
    return minPeriod < currentPeriod
  })
  if (!needsAccrual) return false
  try accruePerpFunding(nowMs)
  return true
}

effect function simulateCorrelatedSpotActivity(nowMs: number): number!StoreFailure!Store {
  const store = try Store
  const snap = try store.transaction(effect (tx: Tx) => {
    const pools = try tx.query(
      `SELECT ticker, organization_id, base_reserve, quote_reserve_cents, index_price_cents
       FROM feed_spot_pools
       WHERE base_reserve > 0 AND quote_reserve_cents > 0
       ORDER BY ticker ASC`,
    )
    const actorRows = (try tx.query(
      `SELECT id, name, username, balance_cents
       FROM feed_actors
       WHERE id NOT LIKE 'test-%' AND id NOT LIKE 'org-%' AND balance_cents >= 50000
       ORDER BY id ASC`,
    )).filter((r) => isRuntimeNpcActor(toText(r.id) ?? "", toText(r.name), toText(r.username)))
    const holdingRows = try tx.query(
      `SELECT actor_id, ticker, base_units
       FROM feed_npc_spot_holdings
       WHERE base_units > 0`,
    )
    return { pools, actorRows, holdingRows }
  })
  if (snap.pools.length === 0 || snap.actorRows.length === 0) return 0
  const poolByOrg = new Map<string, { readonly ticker: string; readonly orgId: string; readonly indexPriceCents: number }>()
  const poolList: Array<{ readonly ticker: string; readonly orgId: string; readonly indexPriceCents: number }> = []
  for (const row of snap.pools) {
    const ticker = toText(row.ticker) ?? ""
    const orgId = toText(row.organization_id) ?? ""
    const indexPriceCents = Math.max(1, toInt(row.index_price_cents))
    if (ticker.length === 0) continue
    const item = { ticker, orgId, indexPriceCents }
    poolList.push(item)
    if (orgId.length > 0) poolByOrg.set(orgId, item)
  }
  if (poolList.length === 0) return 0
  const holdingsByTicker = new Map<string, Array<{ readonly actorId: string; readonly baseUnits: number }>>()
  for (const row of snap.holdingRows) {
    const actorId = toText(row.actor_id) ?? ""
    const ticker = toText(row.ticker) ?? ""
    const baseUnits = Math.max(0, toInt(row.base_units))
    if (!actorId || !ticker || baseUnits <= 0 || !isRuntimeNpcActor(actorId)) continue
    const list = holdingsByTicker.get(ticker) ?? []
    list.push({ actorId, baseUnits })
    holdingsByTicker.set(ticker, list)
  }
  const majorPools = poolList.filter((p) => majorOrgSet.has(p.orgId))
  const minuteIdx = minuteIndexOf(nowMs)
  const primaryPool =
    majorPools.length > 0 && minuteIdx % 2 === 0
      ? majorPools[hashString(`spot-major:${minuteIdx}`) % majorPools.length]!
      : poolList[hashString(`spot-all:${minuteIdx}`) % poolList.length]!
  const baseSeed = hashString(`spot-sim:${minuteIdx}:${primaryPool.ticker}`)
  const primarySide: "buy" | "sell" = baseSeed % 2 === 0 ? "buy" : "sell"
  const primaryQuoteCents = 3_000 + (baseSeed % 10) * 1_000

  const plannedTrades: Array<{ readonly ticker: string; readonly indexPriceCents: number; readonly side: "buy" | "sell"; readonly quoteCents: number; readonly salt: string }> = [
    { ticker: primaryPool.ticker, indexPriceCents: primaryPool.indexPriceCents, side: primarySide, quoteCents: primaryQuoteCents, salt: "primary" },
  ]
  const relatedLinks = correlations.filter(
    (c) => (c.orgId === primaryPool.orgId || c.relatedOrgId === primaryPool.orgId) && Math.abs(c.strength) >= 0.1,
  )
  let correlatedAdded = 0
  for (const link of relatedLinks) {
    if (correlatedAdded >= 2) break
    const targetOrgId = link.orgId === primaryPool.orgId ? link.relatedOrgId : link.orgId
    const targetPool = poolByOrg.get(targetOrgId)
    if (!targetPool || targetPool.ticker === primaryPool.ticker) continue
    const corrSide: "buy" | "sell" = link.strength >= 0 ? primarySide : primarySide === "buy" ? "sell" : "buy"
    const corrQuoteCents = Math.max(1_500, Math.min(10_000, Math.round(primaryQuoteCents * Math.abs(link.strength) * 2.5)))
    plannedTrades.push({
      ticker: targetPool.ticker,
      indexPriceCents: targetPool.indexPriceCents,
      side: corrSide,
      quoteCents: corrQuoteCents,
      salt: `corr-${correlatedAdded}`,
    })
    correlatedAdded += 1
  }

  let simulatedCount = 0
  for (const trade of plannedTrades) {
    const neededUnits = Math.max(1, Math.ceil((trade.quoteCents * SPOT_BASE_SCALE) / Math.max(1, trade.indexPriceCents)))
    let effectiveSide = trade.side
    let actorId = ""
    if (effectiveSide === "sell") {
      const holders = (holdingsByTicker.get(trade.ticker) ?? []).filter((h) => h.baseUnits >= neededUnits * 2)
      if (holders.length > 0) {
        actorId = holders[hashString(`seller:${minuteIdx}:${trade.salt}:${trade.ticker}`) % holders.length]!.actorId
      } else {
        effectiveSide = "buy"
      }
    }
    if (actorId.length === 0) {
      const buyerRow = snap.actorRows[hashString(`buyer:${minuteIdx}:${trade.salt}:${trade.ticker}`) % snap.actorRows.length]!
      actorId = toText(buyerRow.id) ?? ""
    }
    if (actorId.length === 0) continue
    const receipt = executeNpcSpotTrade({
      actorId,
      ticker: trade.ticker,
      side: effectiveSide,
      quoteCents: trade.quoteCents,
      nowMs,
    }) catch effect () => null
    if (receipt !== null) {
      simulatedCount += 1
      try maybePublishFeedEvent({
        type: "market.spot",
        actorId,
        ticker: trade.ticker,
        side: effectiveSide,
        quoteCents: trade.quoteCents,
        indexPriceCents: receipt.indexPriceCents,
        markPriceCents: receipt.markPriceCents,
      })
    }
  }
  return simulatedCount
}

export effect function runMinuteTick(nowMs?: number): MinuteTickResult!(EngineFailure | StoreFailure | MarketFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RouteGameTick")
  const resolvedNow = try resolveClockNow(nowMs)
  return try withJobLockAndErrorHealth(
    "minute-tick",
    resolvedNow,
    startWall,
    () => ({
      nowMs: resolvedNow,
      skipped: true,
      flippedWindows: 0,
      newlyExpired: 0,
      liquidatedCount: 0,
      fundingAccrued: false,
      spotTradesSimulated: 0,
    }),
    effect () => {
      const store = try Store
      const world = try store.transaction(effect (tx: Tx) => try advanceWorldClockTx(tx, resolvedNow))
      if (!world.gameRunning) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("minute-tick", world.nowMs, "skipped", null, 0, null, endWall - startWall)
        return {
          nowMs: world.nowMs,
          skipped: true,
          flippedWindows: 0,
          newlyExpired: 0,
          liquidatedCount: 0,
          fundingAccrued: false,
          spotTradesSimulated: 0,
        }
      }
      reconcileStaleUncertainSpend(world.nowMs) catch effect () => null
      const phaseRes = try advanceNarrativePhases(world.nowMs)
      const fundingAccrued = checkAndAccrueFunding(world.nowMs, world.fundingCutoverPeriod) catch effect () => false
      const liquidated = liquidateEligiblePositions() catch effect () => null
      const liquidatedCount = liquidated === null ? 0 : liquidated.liquidatedCount
      const spotTradesSimulated = simulateCorrelatedSpotActivity(world.nowMs) catch effect () => 0
      const stats = try pendingResolutionStats()
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("minute-tick", world.nowMs, "ok", null, stats.pendingCount, stats.oldestPendingAt, endWall - startWall)
      return {
        nowMs: world.nowMs,
        skipped: false,
        flippedWindows: phaseRes.flippedWindows,
        newlyExpired: phaseRes.newlyExpired,
        liquidatedCount,
        fundingAccrued,
        spotTradesSimulated,
      }
    },
  )
}

export effect function runGameTick(nowMs?: number): {
  readonly minute: MinuteTickResult
  readonly seededMarketIds: ReadonlyArray<string>
}!(EngineFailure | StoreFailure | MarketFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RouteGameTick")
  const resolvedNow = try resolveClockNow(nowMs)
  return try withJobLockAndErrorHealth(
    "game-tick",
    resolvedNow,
    startWall,
    () => ({
      minute: {
        nowMs: resolvedNow,
        skipped: true,
        flippedWindows: 0,
        newlyExpired: 0,
        liquidatedCount: 0,
        fundingAccrued: false,
        spotTradesSimulated: 0,
      },
      seededMarketIds: [],
    }),
    effect () => {
      const minute = try runMinuteTick(resolvedNow)
      if (minute.skipped) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("game-tick", minute.nowMs, "skipped", null, 0, null, endWall - startWall)
        return { minute, seededMarketIds: [] }
      }
      const store = try Store
      const vacantCount = try store.transaction(effect (tx: Tx) => {
        const rows = try tx.query(
          `SELECT COUNT(DISTINCT slot_index) AS occupied
           FROM feed_prediction_markets
           WHERE slot_index IS NOT NULL AND status IN ('open', 'expired', 'awaiting_proof', 'manual_hold')`,
        )
        return Math.max(0, 10 - toInt(rows[0]?.occupied))
      })
      const seededMarketIds = vacantCount > 0 ? try ensureRollingMarketSlots(minute.nowMs) : []
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("game-tick", minute.nowMs, "ok", null, 0, null, endWall - startWall)
      return { minute, seededMarketIds }
    },
  )
}

export effect function runMarketsTick(nowMs?: number): {
  readonly skipped: boolean
  readonly flippedWindows: number
  readonly newlyExpired: number
  readonly cluesPublished: number
  readonly seededMarketIds: ReadonlyArray<string>
}!(EngineFailure | StoreFailure | SocialFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RouteMarketsTick")
  const resolvedNow = try resolveClockNow(nowMs)
  return try withJobLockAndErrorHealth(
    "markets-tick",
    resolvedNow,
    startWall,
    () => ({ skipped: true, flippedWindows: 0, newlyExpired: 0, cluesPublished: 0, seededMarketIds: [] }),
    effect () => {
      const running = try readGameRunning(resolvedNow)
      if (!running) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("markets-tick", resolvedNow, "skipped", null, 0, null, endWall - startWall)
        return { skipped: true, flippedWindows: 0, newlyExpired: 0, cluesPublished: 0, seededMarketIds: [] }
      }
      const store = try Store
      const needsPhaseAdvance = try store.transaction(effect (tx: Tx) => {
        const rows = try tx.query(
          `SELECT 1
           FROM feed_prediction_markets
           WHERE status = 'open'
             AND (
               expires_at <= $1
               OR (phase = 'opening' AND ($1 - created_at) * 3 >= GREATEST(1, expires_at - created_at))
               OR (phase = 'mid' AND ($1 - created_at) * 3 >= 2 * GREATEST(1, expires_at - created_at))
             )
           LIMIT 1`,
          [resolvedNow],
        )
        return rows.length > 0
      })
      const phaseRes = needsPhaseAdvance ? try advanceNarrativePhases(resolvedNow) : { flippedWindows: 0, newlyExpired: 0 }
      const cluesPublished = try publishPhaseClues(resolvedNow)
      const seededMarketIds = try ensureRollingMarketSlots(resolvedNow)
      snapshotMarketPrices(resolvedNow) catch effect () => ({ perpCount: 0, predictionCount: 0 })
      const stats = try pendingResolutionStats()
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("markets-tick", resolvedNow, "ok", null, stats.pendingCount, stats.oldestPendingAt, endWall - startWall)
      return {
        skipped: false,
        flippedWindows: phaseRes.flippedWindows,
        newlyExpired: phaseRes.newlyExpired,
        cluesPublished,
        seededMarketIds,
      }
    },
  )
}

export effect function runMarketsRecovery(nowMs?: number): RecoveryRunResult!(EngineFailure | StoreFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RouteMarketsRecovery")
  const resolvedNow = try resolveClockNow(nowMs)
  return try withJobLockAndErrorHealth(
    "markets-recovery",
    resolvedNow,
    startWall,
    () => ({ processed: 0, resolved: 0, manualHolds: 0, retried: 0, pendingCount: 0, oldestPendingAt: null }),
    effect () => {
      const running = try readGameRunning(resolvedNow)
      if (!running) {
        const stats = try pendingResolutionStats()
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("markets-recovery", resolvedNow, "skipped", null, stats.pendingCount, stats.oldestPendingAt, endWall - startWall)
        return { processed: 0, resolved: 0, manualHolds: 0, retried: 0, pendingCount: stats.pendingCount, oldestPendingAt: stats.oldestPendingAt }
      }
      const recovery = try recoverExpiredMarkets(resolvedNow)
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("markets-recovery", resolvedNow, "ok", null, recovery.pendingCount, recovery.oldestPendingAt, endWall - startWall)
      return recovery
    },
  )
}

export effect function runNpcTick(nowMs?: number): NpcTickBatchSummary!(EngineFailure | StoreFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RouteNpcTick")
  const resolvedNow = try resolveClockNow(nowMs)
  return try withJobLockAndErrorHealth(
    "npc-tick",
    resolvedNow,
    startWall,
    () => ({ actorsSelected: 0, actorsCompleted: 0, actionsExecuted: 0, maxStepsUsed: 0, throttledBatchSize: 0 }),
    effect () => {
      const running = try readGameRunning(resolvedNow)
      if (!running) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("npc-tick", resolvedNow, "skipped", null, 0, null, endWall - startWall)
        return { actorsSelected: 0, actorsCompleted: 0, actionsExecuted: 0, maxStepsUsed: 0, throttledBatchSize: 0 }
      }
      const summary = try runBoundedNpcBatch(resolvedNow)
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("npc-tick", resolvedNow, "ok", null, 0, null, endWall - startWall)
      return summary
    },
  )
}

const WEIGHTED_ORG_TYPES: ReadonlyArray<{ readonly type: string; readonly weight: number }> = [
  { type: "media", weight: 15 },
  { type: "company", weight: 12 },
  { type: "vc", weight: 10 },
  { type: "organization", weight: 8 },
  { type: "financial", weight: 7 },
  { type: "government", weight: 6 },
]

function orgTypeStyleHint(orgType: string, baseStyle: string): string {
  switch (orgType) {
    case "media":
      return `Breaking newsroom wire (${baseStyle})`
    case "vc":
      return `Venture conviction thread & portfolio brag (${baseStyle})`
    case "government":
      return `Official regulatory/policy bulletin (${baseStyle})`
    case "financial":
      return `Institutional macro & market desk note (${baseStyle})`
    case "organization":
      return `Foundation / industry consortium statement (${baseStyle})`
    default:
      return `Corporate product/earnings PR (${baseStyle})`
  }
}

function pickWeightedOrgTypes(
  availableTypes: ReadonlyArray<string>,
  count: number,
  bucket: number,
): ReadonlyArray<string> {
  const remaining = WEIGHTED_ORG_TYPES.filter((entry) => availableTypes.includes(entry.type))
  const chosen: string[] = []
  for (let slot = 0; slot < count && remaining.length > 0; slot += 1) {
    let totalWeight = 0
    for (const item of remaining) totalWeight += item.weight
    let cursor = hashString(`org-type:${bucket}:${slot}`) % Math.max(1, totalWeight)
    let pickedIdx = 0
    for (let i = 0; i < remaining.length; i += 1) {
      cursor -= remaining[i]!.weight
      if (cursor < 0) {
        pickedIdx = i
        break
      }
    }
    chosen.push(remaining[pickedIdx]!.type)
    remaining.splice(pickedIdx, 1)
  }
  return chosen
}

export effect function runOrganizationTick(nowMs?: number): { readonly skipped: boolean; readonly postsCreated: number }!(EngineFailure | StoreFailure | SocialFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RouteOrganizationTick")
  const resolvedNow = try resolveClockNow(nowMs)
  return try withJobLockAndErrorHealth(
    "organization-tick",
    resolvedNow,
    startWall,
    () => ({ skipped: true, postsCreated: 0 }),
    effect () => {
      const running = try readGameRunning(resolvedNow)
      if (!running) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("organization-tick", resolvedNow, "skipped", null, 0, null, endWall - startWall)
        return { skipped: true, postsCreated: 0 }
      }
      const spend = try getDailySpendStatus(resolvedNow)
      const targetOrgs = spend.batchFraction < 1 ? 2 : 3
      const store = try Store
      const context = try store.transaction(effect (tx: Tx) => {
        const orgRows = try tx.query(
          `SELECT id, name, ticker, org_type, description, post_style
           FROM feed_organizations
           WHERE can_be_involved = true
           ORDER BY id ASC`,
        )
        const recentOrgPostRows = try tx.query(
          `SELECT author_id, content, created_at
           FROM feed_posts
           WHERE author_kind = 'org' AND deleted_at IS NULL AND created_at >= $1
           ORDER BY created_at DESC
           LIMIT 120`,
          [resolvedNow - 6 * 3_600_000],
        )
        const snapshot = try loadPublicWorldSnapshot(tx, resolvedNow)
        return { orgRows, recentOrgPostRows, worldContext: snapshot.worldContext }
      })
      if (context.orgRows.length === 0) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("organization-tick", resolvedNow, "skipped", null, 0, null, endWall - startWall)
        return { skipped: true, postsCreated: 0 }
      }
      const cooldownCutoff = resolvedNow - ORG_POST_COOLDOWN_MS
      const recentlyPostedOrgIds = new Set<string>()
      const recentPostsByOrgId = new Map<string, Array<string>>()
      for (const row of context.recentOrgPostRows) {
        const authorId = toText(row.author_id) ?? ""
        const createdAt = safeNonNegInt(row.created_at, 0)
        const content = sanitizeNarrativeText(toText(row.content) ?? "", 140)
        if (!authorId) continue
        if (createdAt >= cooldownCutoff) recentlyPostedOrgIds.add(authorId)
        if (content.length > 0) {
          const list = recentPostsByOrgId.get(authorId) ?? []
          if (list.length < 4) {
            list.push(content)
            recentPostsByOrgId.set(authorId, list)
          }
        }
      }
      const cooledRows = context.orgRows.filter((row) => !recentlyPostedOrgIds.has(toText(row.id) ?? ""))
      const candidateRows = cooledRows.length >= targetOrgs ? cooledRows : context.orgRows
      const bucket = Math.floor(resolvedNow / (routeCadenceMinutes("RouteOrganizationTick") * 60_000))
      const byType = new Map<string, Array<Readonly<Record<string, unknown>>>>()
      for (const row of candidateRows) {
        const orgType = (toText(row.org_type) ?? "company").toLowerCase()
        const list = byType.get(orgType) ?? []
        list.push(row)
        byType.set(orgType, list)
      }
      const availableTypes = WEIGHTED_ORG_TYPES.map((e) => e.type).filter((t) => (byType.get(t)?.length ?? 0) > 0)
      const chosenTypes = pickWeightedOrgTypes(availableTypes, Math.min(targetOrgs, availableTypes.length), bucket)
      const selected: Array<Readonly<Record<string, unknown>>> = []
      const chosenIds = new Set<string>()
      for (let slot = 0; slot < chosenTypes.length; slot += 1) {
        const typeKey = chosenTypes[slot]!
        const pool = byType.get(typeKey) ?? []
        if (pool.length === 0) continue
        const startIdx = hashString(`org:${bucket}:${typeKey}:${slot}`) % pool.length
        for (let offset = 0; offset < pool.length; offset += 1) {
          const pick = pool[(startIdx + offset) % pool.length]!
          const id = toText(pick.id) ?? ""
          if (id && !chosenIds.has(id)) {
            selected.push(pick)
            chosenIds.add(id)
            break
          }
        }
      }
      const targetCount = Math.min(targetOrgs, candidateRows.length)
      if (selected.length < targetCount) {
        const startIdx = hashString(`org-fill:${bucket}:${selected.length}`) % candidateRows.length
        for (let offset = 0; offset < candidateRows.length && selected.length < targetCount; offset += 1) {
          const fallback = candidateRows[(startIdx + offset) % candidateRows.length]!
          const id = toText(fallback.id) ?? ""
          if (id && !chosenIds.has(id)) {
            selected.push(fallback)
            chosenIds.add(id)
          }
        }
      }
      let postsCreated = 0
      for (const org of selected) {
        const orgId = toText(org.id) ?? ""
        const orgName = toText(org.name) ?? orgId
        const ticker = toText(org.ticker) ?? ""
        const orgType = (toText(org.org_type) ?? "company").toLowerCase()
        const baseStyle = toText(org.post_style) ?? "confident corporate PR"
        const packOrg = packOrgById.get(orgId)
        const orgHandle = packOrg?.username ?? orgId
        const promptId = orgPromptIdForType(orgType)
        const sampledExamples = sampleOrgPostExamples(packOrg, hashString(`${orgId}:${bucket}`), 4)
        const ownRecent = recentPostsByOrgId.get(orgId) ?? []
        const rendered = renderPrompt(promptId, {
          orgName,
          tickerSuffix: ticker ? ` ($${ticker})` : "",
          postStyle: orgTypeStyleHint(orgType, baseStyle),
          orgDescription: toText(org.description) ?? orgName,
          orgExamples: sampledExamples.length > 0 ? sampledExamples.map((e) => `- "${e}"`).join("\n") : "(none)",
          recentOrgPosts: ownRecent.length > 0 ? ownRecent.map((p) => `- ${p}`).join("\n") : "(none)",
          worldContext: context.worldContext,
        })
        const completion = try generateCompletion({
          promptId,
          system: rendered.system,
          user: rendered.user,
          maxTokens: rendered.maxTokens,
          temperature: rendered.temperature,
          nowMs: resolvedNow,
          actorId: orgId,
        })
        let postContent = sanitizeNarrativeText(stripLeadingSelfPrefix(completion.text, orgName, orgHandle), 260)
        if (postContent.length === 0 || hasFirstPersonSingularLeak(postContent)) {
          const safeFallback = sampledExamples[0] ?? `${orgName} desk tracking live developments across Feed markets.`
          postContent = sanitizeNarrativeText(safeFallback, 260)
        }
        try createPost({
          authorId: orgId,
          authorKind: "org",
          content: postContent,
          ...(ticker ? { ticker } : {}),
          nowMs: resolvedNow,
        })
        try maybePublishFeedEvent({ type: "org.posted", organizationId: orgId, ticker })
        postsCreated += 1
      }
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("organization-tick", resolvedNow, "ok", null, 0, null, endWall - startWall)
      return { skipped: false, postsCreated }
    },
  )
}

export effect function runArticleTick(nowMs?: number): { readonly skipped: boolean; readonly articleId: string | null }!(EngineFailure | StoreFailure | SocialFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RouteArticleTick")
  const resolvedNow = try resolveClockNow(nowMs)
  return try withJobLockAndErrorHealth(
    "article-tick",
    resolvedNow,
    startWall,
    () => ({ skipped: true, articleId: null }),
    effect () => {
      const running = try readGameRunning(resolvedNow)
      if (!running) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("article-tick", resolvedNow, "skipped", null, 0, null, endWall - startWall)
        return { skipped: true, articleId: null }
      }
      const store = try Store
      const data = try store.transaction(effect (tx: Tx) => {
        const mediaRows = try tx.query(
          `SELECT id, name, description
           FROM feed_organizations
           WHERE org_type = 'media'
           ORDER BY id ASC`,
        )
        const fallbackRows = mediaRows.length > 0
          ? mediaRows
          : try tx.query("SELECT id, name, description FROM feed_organizations ORDER BY id ASC")
        const snapshot = try loadPublicWorldSnapshot(tx, resolvedNow)
        return { mediaRows: fallbackRows, worldContext: snapshot.worldContext }
      })
      const fallbackOrg = organizations.find((o) => o.type === "media") ?? organizations[0]
      const cadenceBucket = Math.floor(resolvedNow / (routeCadenceMinutes("RouteArticleTick") * 60_000))
      const chosen = data.mediaRows.length > 0 ? data.mediaRows[hashString(`article:${cadenceBucket}`) % data.mediaRows.length]! : null
      const orgId = toText(chosen?.id) ?? fallbackOrg?.id ?? "feed-wire"
      const orgName = toText(chosen?.name) ?? fallbackOrg?.name ?? "The Feed Wire"
      const orgDesc = toText(chosen?.description) ?? fallbackOrg?.description ?? "Feed financial wire"
      const rendered = renderPrompt("feedArticle", {
        orgName,
        orgDescription: orgDesc,
        worldContext: data.worldContext,
      })
      const completion = try generateCompletion({
        promptId: "feedArticle",
        system: rendered.system,
        user: rendered.user,
        maxTokens: rendered.maxTokens,
        temperature: rendered.temperature,
        jsonMode: true,
        nowMs: resolvedNow,
        actorId: orgId,
      })
      const parsed = parseLlmJsonRecord(completion.text)
      const title = sanitizeNarrativeText(typeof parsed?.title === "string" ? parsed.title : `${orgName} Market Dispatch`, 180)
      const summary = sanitizeNarrativeText(typeof parsed?.summary === "string" ? parsed.summary : "Inside the latest spot and prediction market shifts.", 340)
      const body = scrubRealWorldNames(
        replaceActorSlugsWithNames(
          typeof parsed?.body === "string" && parsed.body.trim().length > 0
            ? parsed.body.trim()
            : `${orgName} analysts tracked heightened orderflow across rolling Feed markets and leveraged perpetuals.`,
        ),
      )
      const articleId = newEngineId("art")
      try store.transaction(effect (tx: Tx) => {
        try tx.query(
          `INSERT INTO feed_articles (id, title, summary, body, author_org_id, related_market_id, is_resolution_proof, published_at)
           VALUES ($1, $2, $3, $4, $5, NULL, false, $6)`,
          [articleId, title, summary, body, orgId, resolvedNow],
        )
      })
      try createPost({
        authorId: orgId,
        authorKind: "org",
        content: sanitizeNarrativeText(`${title} — ${summary}`, 260),
        nowMs: resolvedNow,
      })
      try maybePublishFeedEvent({ type: "article.published", articleId, organizationId: orgId })
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("article-tick", resolvedNow, "ok", null, 0, null, endWall - startWall)
      return { skipped: false, articleId }
    },
  )
}

export effect function runPerpFundingTick(nowMs?: number): {
  readonly skipped: boolean
  readonly period: number
  readonly accrued: boolean
  readonly cutoverConfigured: boolean
}!(EngineFailure | StoreFailure | MarketFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RoutePerpFunding")
  const resolvedNow = try resolveClockNow(nowMs)
  const period = currentFundingPeriod(minuteIndexOf(resolvedNow))
  return try withJobLockAndErrorHealth(
    "perp-funding",
    resolvedNow,
    startWall,
    () => ({ skipped: true, period, accrued: false, cutoverConfigured: false }),
    effect () => {
      const store = try Store
      const state = try store.transaction(effect (tx: Tx) => {
        try ensureWorldStateTx(tx, resolvedNow)
        const rows = try tx.query("SELECT game_running, funding_cutover_period FROM feed_world_state WHERE singleton = true")
        const gameRunning = rows[0]?.game_running !== false
        const cutover = try armFundingCutoverTx(tx, gameRunning, safeNonNegInt(rows[0]?.funding_cutover_period, 0), resolvedNow)
        return { gameRunning, cutover }
      })
      if (!state.gameRunning) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("perp-funding", resolvedNow, "skipped", null, 0, null, endWall - startWall)
        return { skipped: true, period, accrued: false, cutoverConfigured: state.cutover > 0 }
      }
      const accrued = try checkAndAccrueFunding(resolvedNow, state.cutover)
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("perp-funding", resolvedNow, "ok", null, 0, null, endWall - startWall)
      return { skipped: false, period, accrued, cutoverConfigured: state.cutover > 0 }
    },
  )
}

export effect function runWorldFactsTick(nowMs?: number): { readonly skipped: boolean; readonly factsAdded: number }!(EngineFailure | StoreFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RouteWorldFacts")
  const resolvedNow = try resolveClockNow(nowMs)
  return try withJobLockAndErrorHealth(
    "world-facts",
    resolvedNow,
    startWall,
    () => ({ skipped: true, factsAdded: 0 }),
    effect () => {
      const running = try readGameRunning(resolvedNow)
      if (!running) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("world-facts", resolvedNow, "skipped", null, 0, null, endWall - startWall)
        return { skipped: true, factsAdded: 0 }
      }
      const store = try Store
      const recentText = try store.transaction(effect (tx: Tx) => {
        const settled = try tx.query(
          `SELECT question, resolved_outcome FROM feed_prediction_markets WHERE status = 'resolved' ORDER BY resolved_at DESC NULLS LAST LIMIT 5`,
        )
        const posts = try tx.query("SELECT author_id, content FROM feed_posts WHERE deleted_at IS NULL ORDER BY created_at DESC LIMIT 6")
        const settledStr = settled.map((r) => `Resolved ${toText(r.resolved_outcome)}: ${toText(r.question)}`).join("\n")
        const postsStr = posts.map((r) => `${displayNameForEntity(toText(r.author_id) ?? "")}: ${sanitizeNarrativeText(toText(r.content) ?? "", 100)}`).join("\n")
        return `${settledStr}\n${postsStr}`.trim() || "Initial market trading session active."
      })
      const rendered = renderPrompt("worldFactsConsolidation", { recentEvents: recentText })
      const completion = try generateCompletion({
        promptId: "worldFactsConsolidation",
        system: rendered.system,
        user: rendered.user,
        maxTokens: rendered.maxTokens,
        temperature: rendered.temperature,
        jsonMode: true,
        nowMs: resolvedNow,
      })
      const parsed = parseLlmJsonRecord(completion.text)
      const items = Array.isArray(parsed?.facts) ? parsed.facts.slice(0, 3) : []
      let factsAdded = 0
      try store.transaction(effect (tx: Tx) => {
        for (const item of items) {
          const rec = item as Record<string, unknown> | null
          const factText = sanitizeNarrativeText(typeof rec?.factText === "string" ? rec.factText : "", 220)
          if (factText.length === 0) continue
          const category = sanitizeText(typeof rec?.category === "string" ? rec.category : "markets", 40) || "markets"
          try tx.query(
            `INSERT INTO feed_world_facts (id, fact_text, category, created_at) VALUES ($1, $2, $3, $4)`,
            [newEngineId("fact"), factText, category, resolvedNow],
          )
          factsAdded += 1
        }
      })
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("world-facts", resolvedNow, "ok", null, 0, null, endWall - startWall)
      return { skipped: false, factsAdded }
    },
  )
}

function decodeXmlEntities(raw: string): string {
  return raw
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, "$1")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, "\"")
    .replace(/&#39;/g, "'")
    .replace(/&#(?:x([0-9a-fA-F]+)|([0-9]+));/g, (_match, hex: string | undefined, dec: string | undefined) => {
      const code = hex === undefined ? Number.parseInt(dec ?? "", 10) : Number.parseInt(hex, 16)
      if (!Number.isInteger(code) || code < 1 || code > 0x10_ffff || (code >= 0xd800 && code <= 0xdfff)) return ""
      return String.fromCodePoint(code)
    })
    .replace(/<[^>]+>/g, " ")
}

export function extractRssHeadlinesFromXml(xml: string, sourceUrl: string): ReadonlyArray<RssFeedHeadlineItem> {
  const out: Array<RssFeedHeadlineItem> = []
  const blockRegex = /<(?:item|entry)\b[^>]*>([\s\S]*?)<\/(?:item|entry)>/gi
  let match = blockRegex.exec(xml)
  while (match !== null && out.length < 10) {
    const titleMatch = /<title\b[^>]*>([\s\S]*?)<\/title>/i.exec(match[1] ?? "")
    if (titleMatch?.[1]) {
      const cleaned = sanitizeText(decodeXmlEntities(titleMatch[1]), 180)
      if (cleaned.length >= 12) {
        out.push({ title: cleaned, sourceUrl })
      }
    }
    match = blockRegex.exec(xml)
  }
  return out
}

export function interleaveRssFeedItems<T>(buckets: ReadonlyArray<ReadonlyArray<T>>): ReadonlyArray<T> {
  const nonEmpty = buckets.filter((b) => b.length > 0)
  if (nonEmpty.length === 0) return []
  const out: T[] = []
  let maxLen = 0
  for (const b of nonEmpty) {
    if (b.length > maxLen) maxLen = b.length
  }
  for (let idx = 0; idx < maxLen; idx += 1) {
    for (const bucket of nonEmpty) {
      const item = bucket[idx]
      if (item !== undefined) out.push(item)
    }
  }
  return out
}

export effect function runRssRefreshTick(nowMs?: number): RssRefreshResult!(EngineFailure | StoreFailure)!Store {
  const startWall = try Clock.currentTimeMillis
  try guardCoreRoute("RouteRssRefresh")
  const resolvedNow = try resolveClockNow(nowMs)
  return try withJobLockAndErrorHealth(
    "rss-refresh",
    resolvedNow,
    startWall,
    () => ({ skipped: true, fetchedCount: 0, insertedCount: 0 }),
    effect () => {
      const running = try readGameRunning(resolvedNow)
      if (!running) {
        const endWall = try Clock.currentTimeMillis
        try recordTickHealth("rss-refresh", resolvedNow, "skipped", null, 0, null, endWall - startWall)
        return { skipped: true, fetchedCount: 0, insertedCount: 0 }
      }
      const cadenceMs = routeCadenceMinutes("RouteRssRefresh") * 60_000
      const store = try Store
      const lastRunAt = try store.transaction(effect (tx: Tx) => {
        const rows = try tx.query("SELECT last_success_at FROM feed_tick_health WHERE job_name = 'rss-refresh'")
        return rows.length > 0 ? safeNonNegInt(rows[0]?.last_success_at, 0) : 0
      })
      if (lastRunAt > 0 && minuteIndexOf(resolvedNow) - minuteIndexOf(lastRunAt) < routeCadenceMinutes("RouteRssRefresh")) {
        return { skipped: true, fetchedCount: 0, insertedCount: 0 }
      }
      const envUrls = readEnv("FEED_RSS_URLS")?.trim()
      const configuredUrls = (envUrls && envUrls.length > 0 ? envUrls.split(",") : [...DEFAULT_RSS_URLS])
        .map((u) => u.trim())
        .filter((u) => u.startsWith("http"))
      const bucket = Math.floor(resolvedNow / cadenceMs)
      const feedCount = Math.min(6, configuredUrls.length)
      const selectedUrls: string[] = []
      for (let i = 0; i < feedCount; i += 1) {
        selectedUrls.push(configuredUrls[(bucket + i) % configuredUrls.length]!)
      }
      const perFeedResults = try Effect.forEach(
        selectedUrls,
        (url) => effect {
          const req = HttpClientRequest.get(url)
          const response = fetchTextWithTimeout(req, "8 seconds", "RSS_FAILED", `RSS fetch failed for ${url}`) catch effect () => null
          if (!response || response.status < 200 || response.status >= 300 || response.text.length === 0) {
            return [] as ReadonlyArray<RssFeedHeadlineItem>
          }
          return extractRssHeadlinesFromXml(response.text, url)
        },
        { concurrency: 6 },
      )
      const perFeedBuckets = perFeedResults.filter((bucket) => bucket.length > 0)
      const interleaved = interleaveRssFeedItems(perFeedBuckets)
      const storedTitles = interleaved.length === 0 ? [] : try store.transaction((tx) => tx.query(
        "SELECT DISTINCT title FROM feed_rss_headlines WHERE title = ANY($1::text[])",
        [interleaved.map((item) => item.title)],
      ))
      const knownTitles = new Set(storedTitles.map((row) => toText(row.title)))
      const candidates: RssFeedHeadlineItem[] = []
      for (const item of interleaved) {
        if (knownTitles.has(item.title)) continue
        knownTitles.add(item.title)
        candidates.push(item)
        if (candidates.length === 6) break
      }
      let insertedCount = 0
      const rosterHint = groundingRosterSummary()
      for (const item of candidates) {
        const rendered = renderPrompt("rssParodyRewrite", { headline: item.title, sourceUrl: item.sourceUrl, rosterHint })
        const completion = generateCompletion({
          promptId: "rssParodyRewrite",
          system: rendered.system,
          user: rendered.user,
          maxTokens: rendered.maxTokens,
          temperature: rendered.temperature,
          nowMs: resolvedNow,
        }) catch effect () => null
        const parody = completion ? sanitizeNarrativeText(completion.text, 180) : item.title
        const inserted = try store.transaction((tx) => tx.query(
          `INSERT INTO feed_rss_headlines (id, source_url, title, parody_headline, published_at, created_at)
           SELECT $1, $2, $3, $4, $5, $5
           WHERE NOT EXISTS (SELECT 1 FROM feed_rss_headlines WHERE title = $3)
           RETURNING id`,
          [newEngineId("rss"), item.sourceUrl, item.title, parody, resolvedNow],
        ))
        insertedCount += inserted.length
      }
      const endWall = try Clock.currentTimeMillis
      try recordTickHealth("rss-refresh", resolvedNow, "ok", null, 0, null, endWall - startWall)
      return { skipped: false, fetchedCount: interleaved.length, insertedCount }
    },
  )
}

export effect function fastForwardSimulatedHours(hours: number): FastForwardResult!(EngineFailure | StoreFailure)!Store {
  const clockMode = resolveClockMode()
  if (clockMode !== "ClockSimulated") {
    throw new EngineFailure({ code: "CLOCK_MODE_INVALID", message: "fastForwardSimulatedHours is only permitted in simulated clock mode." })
  }
  if (!Number.isFinite(hours) || hours <= 0) {
    throw new EngineFailure({ code: "INVALID_ARGUMENT", message: "hours must be a finite positive number." })
  }
  if (hours > 24) {
    throw new EngineFailure({ code: "INVALID_ARGUMENT", message: "hours must be at most 24." })
  }
  const wallNow = try Clock.currentTimeMillis
  const deltaMs = Math.round(hours * 3_600_000)
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    try ensureWorldStateTx(tx, wallNow)
    const rows = try tx.query("SELECT current_day, last_tick_at, game_running FROM feed_world_state WHERE singleton = true")
    if (rows[0]?.game_running === false) {
      throw new EngineFailure({ code: "CLOCK_MODE_INVALID", message: "fastForwardSimulatedHours requires the world to be running." })
    }
    const prevTickAt = safeNonNegInt(rows[0]?.last_tick_at, 0)
    const baseMs = Math.max(wallNow, prevTickAt)
    const nextMs = baseMs + deltaMs
    const prevDay = Math.max(1, safeNonNegInt(rows[0]?.current_day, 1))
    const { nextDay, nextHour } = advanceDayHour(prevDay, baseMs, nextMs)
    try tx.query(
      `UPDATE feed_world_state
       SET current_day = $1, current_hour = $2, last_tick_at = $3, updated_at = $3
       WHERE singleton = true`,
      [nextDay, nextHour, nextMs],
    )
    return {
      clockMode,
      previousMs: baseMs,
      currentMs: nextMs,
      currentDay: nextDay,
      currentHour: nextHour,
      advancedHours: hours,
    }
  })
}

export effect function getEngineAdminStatus(): EngineAdminStatus!(EngineFailure | StoreFailure)!Store {
  const nowMs = try resolveClockNow()
  const spend = try getDailySpendStatus(nowMs)
  const store = try Store
  const dbState = try store.transaction(effect (tx: Tx) => {
    try ensureWorldStateTx(tx, nowMs)
    const worldRows = try tx.query(
      `SELECT current_day, current_hour, phase, game_running, last_tick_at
       FROM feed_world_state
       WHERE singleton = true`,
    )
    const countsRows = try tx.query(
      `SELECT
         COALESCE(SUM(CASE WHEN status IN ('expired', 'awaiting_proof') THEN 1 ELSE 0 END), 0) AS pending_resolutions,
         COALESCE(SUM(CASE WHEN status = 'manual_hold' THEN 1 ELSE 0 END), 0) AS manual_hold_count
       FROM feed_prediction_markets`,
    )
    const w = worldRows[0] ?? {}
    const c = countsRows[0] ?? {}
    return {
      currentDay: Math.max(1, safeNonNegInt(w.current_day, 1)),
      currentHour: safeNonNegInt(w.current_hour, 0),
      phase: toText(w.phase) ?? "active",
      gameRunning: w.game_running !== false,
      lastTickAt: safeNonNegInt(w.last_tick_at, 0),
      pendingResolutions: safeNonNegInt(c.pending_resolutions, 0),
      manualHoldCount: safeNonNegInt(c.manual_hold_count, 0),
    }
  })
  return {
    currentDay: dbState.currentDay,
    currentHour: dbState.currentHour,
    phase: dbState.phase,
    gameRunning: dbState.gameRunning,
    budget: {
      dailyBudgetCents: spend.dailyBudgetCents,
      confirmedCents: spend.confirmedCents,
      reservedCents: spend.reservedCents,
      carryoverReservedCents: spend.carryoverReservedCents,
      maxStepsAllowed: spend.maxStepsAllowed,
      batchFraction: spend.batchFraction,
    },
    pendingResolutions: dbState.pendingResolutions,
    manualHoldCount: dbState.manualHoldCount,
    lastTickAt: dbState.lastTickAt,
  }
}
