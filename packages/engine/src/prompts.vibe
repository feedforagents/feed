// spec/engine/index.md, "Story: Run non-blocking minute ticks and D-25 bounded NPC loops"
import { actors, correlations, manifest, organizations } from "@repo/pack-default"
import { realityGroundingContent } from "./data/reality-grounding.ts"
import { worldFactsContent } from "./data/world-facts.ts"
import { displayNameForEntity, isRuntimeNpcActor, sanitizeNarrativeText, sanitizeText } from "./shared.vibe"

export type PromptId =
  | "ambientPost"
  | "commentary"
  | "replyPost"
  | "orgPost"
  | "marketQuestion"
  | "cluePost"
  | "resolutionArticle"
  | "npcTradingDecision"
  | "alphaGroupMessage"
  | "rssParodyRewrite"
  | "feedArticle"
  | "worldFactsConsolidation"

export interface PromptDefinition {
  readonly id: PromptId
  readonly description: string
  readonly maxTokens: number
  readonly temperature: number
  readonly jsonMode: boolean
  readonly system: string
  readonly user: string
}

export interface RenderedPrompt {
  readonly id: PromptId
  readonly system: string
  readonly user: string
  readonly maxTokens: number
  readonly temperature: number
  readonly jsonMode: boolean
}

export interface WorldContextMarketItem {
  readonly id: string
  readonly question: string
  readonly category: string
  readonly timeframe: string
  readonly phase: string
  readonly yesProbPct: number
  readonly expiresAt: number
}

export interface WorldContextPerpItem {
  readonly ticker: string
  readonly markPriceCents: number
  readonly indexPriceCents: number
  readonly fundingRateBps: number
}

export interface WorldContextPostItem {
  readonly id: string
  readonly authorId: string
  readonly authorName?: string
  readonly authorKind: string
  readonly content: string
}

export interface WorldContextInput {
  readonly currentDay: number
  readonly currentHour: number
  readonly phase: string
  readonly worldFacts: ReadonlyArray<string>
  readonly parodyHeadlines: ReadonlyArray<string>
  readonly openMarkets: ReadonlyArray<WorldContextMarketItem>
  readonly perpMarkets: ReadonlyArray<WorldContextPerpItem>
  readonly recentPosts: ReadonlyArray<WorldContextPostItem>
  readonly actorSummary?: string
}

export type NpcDecisionAction =
  | { readonly kind: "SPOT_TRADE"; readonly ticker: string; readonly side: "buy" | "sell"; readonly quoteCents: number }
  | { readonly kind: "PERP_TRADE"; readonly ticker: string; readonly side: "long" | "short"; readonly collateralCents: number; readonly leverage: number }
  | { readonly kind: "CLOSE_PERP"; readonly positionId: string; readonly closePct?: number }
  | { readonly kind: "PREDICTION_TRADE"; readonly marketId: string; readonly side: "yes" | "no"; readonly amountCents: number }
  | { readonly kind: "SELL_PREDICTION"; readonly marketId: string; readonly side: "yes" | "no"; readonly shares: number }
  | { readonly kind: "CREATE_POST"; readonly content: string; readonly marketId?: string; readonly ticker?: string }
  | { readonly kind: "CREATE_REPLY"; readonly replyToPostId: string; readonly content: string }
  | { readonly kind: "LIKE_POST"; readonly postId: string }
  | { readonly kind: "REPOST_POST"; readonly postId: string }
  | { readonly kind: "FOLLOW_USER"; readonly targetId: string }
  | { readonly kind: "SEND_GROUP_MESSAGE"; readonly chatId: string; readonly content: string }
  | { readonly kind: "INVITE_ALPHA" }

const PARODY_UNIVERSE_RULES =
  "NEVER use real-world company or person names (NVIDIA, OpenAI, Tesla, Elon Musk, Sam Altman, Anthropic, Meta, Apple, SpaceX, Coinbase, Mark Zuckerberg, Jeff Bezos, Vitalik Buterin, Jensen Huang, Jerome Powell) — ALWAYS use Feed parody equivalents (NVIDAI, OpenAGI, TeslAI, AIlon Musk, Sam AIltman, AItropic, MetAI, AIpple, SpAIceX, CoinbAIse, Mark Zuckerborg, Jeff BAIzos, VitAIlik, Jensen HuAIng, JerAIme Powell). Always refer to people and organizations by display name (e.g. Glenn GreenAIwald, OpenAGI), NEVER by raw hyphenated ID slugs."

const FIRST_PERSON_VOICE_RULES =
  "Write strictly in FIRST PERSON (I, me, my) as {{actorName}}. NEVER refer to yourself in the third person, NEVER prefix your own name or @handle in the post text, NEVER use cliché openers like 'As X looms', 'whispers swirl', 'rumors swirl', or 'In the bustling feed', and finish cleanly under 240 characters without trailing hashtag spam."

