export function renderTemplate(template: string, vars: Readonly<Record<string, string>>): string {
  return template.replace(/\{\{([a-zA-Z0-9_]+)\}\}/g, (_match, key: string) => vars[key] ?? "")
}

export function renderPrompt(id: PromptId, vars: Readonly<Record<string, string>>): RenderedPrompt {
  const def = PromptCatalog[id]
  return {
    id: def.id,
    system: renderTemplate(def.system, vars),
    user: renderTemplate(def.user, vars),
    maxTokens: def.maxTokens,
    temperature: def.temperature,
    jsonMode: def.jsonMode,
  }
}

const tickerPriorityRank: ReadonlyMap<string, number> = (() => {
  const orgById = new Map(organizations.map((o) => [o.id, o]))
  const map = new Map<string, number>()
  let rank = 0
  for (const id of manifest.orgPriorities.major) {
    const ticker = orgById.get(id)?.ticker?.toUpperCase()
    if (ticker && !map.has(ticker)) {
      map.set(ticker, rank)
      rank += 1
    }
  }
  for (const id of manifest.orgPriorities.secondary) {
    const ticker = orgById.get(id)?.ticker?.toUpperCase()
    if (ticker && !map.has(ticker)) {
      map.set(ticker, 100 + rank)
      rank += 1
    }
  }
  return map
})()

export function prioritizePerpMarkets(
  perps: ReadonlyArray<WorldContextPerpItem>,
  limit: number = 16,
): ReadonlyArray<WorldContextPerpItem> {
  const safeLimit = Math.max(1, Math.floor(limit))
  return [...perps]
    .toSorted((left, right) => {
      const leftRank = tickerPriorityRank.get(left.ticker.toUpperCase()) ?? 10_000
      const rightRank = tickerPriorityRank.get(right.ticker.toUpperCase()) ?? 10_000
      if (leftRank !== rightRank) return leftRank - rightRank
      const leftActivity = Math.abs(left.markPriceCents - left.indexPriceCents) * 10 + Math.abs(left.fundingRateBps)
      const rightActivity = Math.abs(right.markPriceCents - right.indexPriceCents) * 10 + Math.abs(right.fundingRateBps)
      if (leftActivity !== rightActivity) return rightActivity - leftActivity
      return left.ticker.localeCompare(right.ticker)
    })
    .slice(0, safeLimit)
}

export function groundingRosterSummary(): string {
  const realActors = actors.filter((a) => isRuntimeNpcActor(a.id, a.name, a.username))
  const prioritizedActors = [
    ...realActors.filter((a) => a.tier === "S_TIER"),
    ...realActors.filter((a) => a.tier === "A_TIER"),
  ].slice(0, 8)
  const sampleActors = prioritizedActors.map((a) => `${a.name} (@${a.username.toLowerCase()})`).join(", ")
  const orgById = new Map(organizations.map((o) => [o.id, o]))
  const majorOrgs = manifest.orgPriorities.major
    .map((id) => orgById.get(id))
    .filter((o): o is (typeof organizations)[number] => o !== undefined && Boolean(o.ticker))
    .slice(0, 10)
  const sampleOrgs = (majorOrgs.length > 0 ? majorOrgs : organizations.filter((o) => o.ticker).slice(0, 10))
    .map((o) => `${o.name} [$${o.ticker}]`)
    .join(", ")
  const sampleCorr = correlations
    .slice(0, 3)
    .map((c) => `${orgById.get(c.orgId)?.name ?? c.orgId}->${orgById.get(c.relatedOrgId)?.name ?? c.relatedOrgId}`)
    .join(", ")
  return `Pack ${manifest.id}: S-Tier Actors [${sampleActors}]; Major Tickers [${sampleOrgs}]; Links [${sampleCorr}]`
}

export function buildWorldContext(input: WorldContextInput): string {
  const sections: string[] = [
    `World Clock: Day ${input.currentDay}, Hour ${String(input.currentHour).padStart(2, "0")}:00 UTC (Phase: ${input.phase})`,
    groundingRosterSummary(),
    worldFactsContent,
    realityGroundingContent,
  ]
  if (input.worldFacts.length > 0) {
    sections.push(`World Facts:\n${input.worldFacts.slice(0, 6).map((f) => `- ${sanitizeText(f, 160)}`).join("\n")}`)
  }
  if (input.parodyHeadlines.length > 0) {
    sections.push(`Recent Parody Headlines:\n${input.parodyHeadlines.slice(0, 5).map((h) => `- ${sanitizeText(h, 140)}`).join("\n")}`)
  }
  if (input.openMarkets.length > 0) {
    sections.push(
      `Open Prediction Markets:\n${input.openMarkets.slice(0, 10).map((m) => `- [${m.id}] (${m.timeframe}/${m.phase}, YES ${m.yesProbPct}%) ${sanitizeText(m.question, 140)}`).join("\n")}`,
    )
  }
  if (input.perpMarkets.length > 0) {
    const prioritizedPerps = prioritizePerpMarkets(input.perpMarkets, 16)
    sections.push(
      `Perp & Spot Tickers:\n${prioritizedPerps.map((p) => `- ${p.ticker}: mark $${(p.markPriceCents / 100).toFixed(2)}, index $${(p.indexPriceCents / 100).toFixed(2)}, funding ${p.fundingRateBps}bps`).join("\n")}`,
    )
  }
  if (input.recentPosts.length > 0) {
    sections.push(
      `Recent Feed Posts:\n${input.recentPosts.slice(0, 8).map((post) => `- [${post.id}] ${displayNameForEntity(post.authorId, post.authorName)}: ${sanitizeNarrativeText(post.content, 140)}`).join("\n")}`,
    )
  }
  if (input.actorSummary && input.actorSummary.trim().length > 0) {
    sections.push(`Portfolio & Focus:\n${input.actorSummary.trim()}`)
  }
  return sections.join("\n\n")
}

export function formatFeedDiversityHint(
  recentPosts: ReadonlyArray<{ readonly authorId: string; readonly authorName?: string; readonly content: string }>,
): string {
  if (recentPosts.length === 0) {
    return "Feed is fresh; introduce a crisp first-person angle referencing a live ticker or market."
  }
  const openers = recentPosts
    .slice(0, 6)
    .map((post) => sanitizeNarrativeText(post.content, 48).split(" ").slice(0, 4).join(" "))
    .filter((snippet) => snippet.length > 0)
  const recentAuthors = [...new Set(recentPosts.slice(0, 6).map((p) => displayNameForEntity(p.authorId, p.authorName)))].join(", ")
  const recentTickers = new Set<string>()
  for (const post of recentPosts.slice(0, 6)) {
    for (const match of post.content.matchAll(/\$([A-Za-z][A-Za-z0-9_]{1,10})\b/g)) {
      if (match[1]) recentTickers.add(`$${match[1].toUpperCase()}`)
    }
  }
  const tickerNote = recentTickers.size > 0
    ? ` Recently covered tickers: ${[...recentTickers].slice(0, 5).join(", ")} — prefer a fresh ticker or catalyst.`
    : ""
  return `Avoid repeating recent openers (${openers.join(" | ")}) or echoing ${recentAuthors}; offer a distinct first-person price/catalyst claim.${tickerNote}`
}

function asRecord(value: unknown): Record<string, unknown> | null {
  return value !== null && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : null
}

function asPositiveInt(value: unknown, fallback: number, min: number, max: number): number {
  if (typeof value !== "number" || !Number.isFinite(value)) return fallback
  return Math.max(min, Math.min(max, Math.round(value)))
}

function asNonEmptyString(value: unknown): string | null {
  return typeof value === "string" && value.trim().length > 0 ? value.trim() : null
}

function parseTradeDecision(
  item: Record<string, unknown>,
  kind: string,
  tickers: Set<string>,
  marketIds: Set<string>,
  openPerpPositionIds: Set<string>,
  heldPredictionKeys: Set<string>,
): NpcDecisionAction | null {
  if (kind === "SPOT_TRADE") {
    const ticker = asNonEmptyString(item.ticker)?.toUpperCase() ?? ""
    const side = item.side === "sell" ? "sell" : "buy"
    if (!tickers.has(ticker)) return null
    return { kind: "SPOT_TRADE", ticker, side, quoteCents: asPositiveInt(item.quoteCents, 2_500, 100, 50_000) }
  }
  if (kind === "PERP_TRADE") {
    const ticker = asNonEmptyString(item.ticker)?.toUpperCase() ?? ""
    const side = item.side === "short" ? "short" : "long"
    if (!tickers.has(ticker)) return null
    return { kind: "PERP_TRADE", ticker, side, collateralCents: asPositiveInt(item.collateralCents, 2_500, 500, 50_000), leverage: asPositiveInt(item.leverage, 3, 1, 20) }
  }
  if (kind === "CLOSE_PERP") {
    const positionId = asNonEmptyString(item.positionId) ?? ""
    if (!positionId || !openPerpPositionIds.has(positionId)) return null
    const closePct = item.closePct === undefined ? undefined : asPositiveInt(item.closePct, 100, 1, 100)
    return closePct === undefined ? { kind: "CLOSE_PERP", positionId } : { kind: "CLOSE_PERP", positionId, closePct }
  }
  if (kind === "PREDICTION_TRADE") {
    const marketId = asNonEmptyString(item.marketId) ?? ""
    const side = item.side === "no" ? "no" : "yes"
    if (!marketIds.has(marketId)) return null
    return { kind: "PREDICTION_TRADE", marketId, side, amountCents: asPositiveInt(item.amountCents, 2_000, 100, 25_000) }
  }
  if (kind === "SELL_PREDICTION") {
    const marketId = asNonEmptyString(item.marketId) ?? ""
    const side = item.side === "no" ? "no" : "yes"
    const key = `${marketId}:${side}`
    if (!marketId || !marketIds.has(marketId) || !heldPredictionKeys.has(key)) return null
    return { kind: "SELL_PREDICTION", marketId, side, shares: asPositiveInt(item.shares, 100, 100, 1_000_000) }
  }
  return null
}

function parseSocialDecision(
  item: Record<string, unknown>,
  kind: string,
  tickers: Set<string>,
  marketIds: Set<string>,
  replyIds: Set<string>,
  chatIds: Set<string>,
  followTargetIds: Set<string>,
): NpcDecisionAction | null {
  if (kind === "INVITE_ALPHA") return { kind: "INVITE_ALPHA" }
  if (kind === "LIKE_POST") {
    const postId = asNonEmptyString(item.postId)
    if (!postId || !replyIds.has(postId)) return null
    return { kind: "LIKE_POST", postId }
  }
  if (kind === "REPOST_POST") {
    const postId = asNonEmptyString(item.postId)
    if (!postId || !replyIds.has(postId)) return null
    return { kind: "REPOST_POST", postId }
  }
  if (kind === "FOLLOW_USER") {
    const targetId = asNonEmptyString(item.targetId)
    if (!targetId || !followTargetIds.has(targetId)) return null
    return { kind: "FOLLOW_USER", targetId }
  }
  const rawContent = asNonEmptyString(item.content)
  if (rawContent === null) return null
  const content = sanitizeNarrativeText(rawContent, 260)
  if (kind === "CREATE_POST") {
    const marketId = asNonEmptyString(item.marketId)
    const ticker = asNonEmptyString(item.ticker)?.toUpperCase()
    return {
      kind: "CREATE_POST",
      content,
      ...(marketId && marketIds.has(marketId) ? { marketId } : {}),
      ...(ticker && tickers.has(ticker) ? { ticker } : {}),
    }
  }
  if (kind === "CREATE_REPLY") {
    const replyToPostId = asNonEmptyString(item.replyToPostId)
    if (!replyToPostId || !replyIds.has(replyToPostId)) return null
    return { kind: "CREATE_REPLY", replyToPostId, content }
  }
  if (kind === "SEND_GROUP_MESSAGE") {
    const chatId = asNonEmptyString(item.chatId)
    if (!chatId || !chatIds.has(chatId)) return null
    return { kind: "SEND_GROUP_MESSAGE", chatId, content }
  }
  return null
}

export function validateNpcTradingDecision(
  raw: unknown,
  maxSteps: number,
  availableTickers: ReadonlyArray<string>,
  availableMarketIds: ReadonlyArray<string>,
  replyTargetIds: ReadonlyArray<string> = [],
  chatIds: ReadonlyArray<string> = [],
  openPerpPositionIds: ReadonlyArray<string> = [],
  heldPredictionKeys: ReadonlyArray<string> = [],
  followTargetIds: ReadonlyArray<string> = [],
): ReadonlyArray<NpcDecisionAction> {
  const root = asRecord(raw)
  const rawActions = root && Array.isArray(root.actions) ? root.actions : Array.isArray(raw) ? raw : []
  const cap = Math.max(0, Math.min(4, Math.floor(maxSteps)))
  const tickerSet = new Set(availableTickers.map((t) => t.toUpperCase()))
  const marketSet = new Set(availableMarketIds)
  const replySet = new Set(replyTargetIds)
  const chatSet = new Set(chatIds)
  const openPerpSet = new Set(openPerpPositionIds)
  const heldPredSet = new Set(heldPredictionKeys.map((k) => k.toLowerCase()))
  const followSet = new Set(followTargetIds)
  const out: NpcDecisionAction[] = []
  let postCount = 0
  let replyCount = 0
  for (const entry of rawActions) {
    if (out.length >= cap) break
    const item = asRecord(entry)
    if (!item) continue
    const kind = asNonEmptyString(item.kind)
    if (!kind) continue
    if (kind === "CREATE_POST" && postCount >= 1) continue
    if (kind === "CREATE_REPLY" && replyCount >= 1) continue
    const parsed =
      parseTradeDecision(item, kind, tickerSet, marketSet, openPerpSet, heldPredSet) ??
      parseSocialDecision(item, kind, tickerSet, marketSet, replySet, chatSet, followSet)
    if (parsed !== null) {
      if (parsed.kind === "CREATE_POST") postCount += 1
      if (parsed.kind === "CREATE_REPLY") replyCount += 1
      out.push(parsed)
    }
  }
  return out
}
