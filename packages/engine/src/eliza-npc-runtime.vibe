interface DbActorRow {
  readonly id: string
  readonly name: string
  readonly username: string
  readonly tier: string
  readonly description: string
  readonly systemPrompt: string
  readonly balanceCents: number
}

export interface NpcTickBatchSummary {
  readonly actorsSelected: number
  readonly actorsCompleted: number
  readonly actionsExecuted: number
  readonly maxStepsUsed: number
  readonly throttledBatchSize: number
}

type StoreEffectRunner = <A, E>(eff: A!E!Store) => Promise<A>

const packActorById: ReadonlyMap<string, PackActor> = new Map(actors.map((a) => [a.id, a]))
const orgById = new Map(organizations.map((o) => [o.id, o]))

function asParamRecord(options: unknown, message: Memory): Record<string, unknown> {
  const opt = options as { readonly parameters?: unknown } | undefined
  if (opt?.parameters && typeof opt.parameters === "object" && !Array.isArray(opt.parameters)) {
    return opt.parameters as Record<string, unknown>
  }
  const contentData = (message.content as { readonly data?: unknown } | undefined)?.data
  if (contentData && typeof contentData === "object" && !Array.isArray(contentData)) {
    return contentData as Record<string, unknown>
  }
  return {}
}

function safeElizaUuid(seed: string): UUID {
  try {
    return stringToUuid(seed)
  } catch {
    return seed as UUID
  }
}

function toJsonParamRecord(source: Record<string, unknown>): Record<string, string | number | boolean | null> {
  const out: Record<string, string | number | boolean | null> = {}
  for (const [key, value] of Object.entries(source)) {
    if (
      typeof value === "string" ||
      typeof value === "number" ||
      typeof value === "boolean" ||
      value === null
    ) {
      out[key] = value
    }
  }
  return out
}

function buildNpcCharacter(actor: DbActorRow, packActor: PackActor | undefined): Character {
  return createCharacter({
    id: safeElizaUuid(`feed-npc:${actor.id}`),
    name: actor.name,
    username: actor.username,
    system: packActor?.system ?? actor.systemPrompt,
    bio: packActor ? [...packActor.bio, ...packActor.lore] : [actor.description],
    topics: packActor ? [...packActor.topics] : ["markets", "predictions", "perps"],
    adjectives: packActor ? [...packActor.adjectives] : ["sharp", "opinionated"],
    style: packActor
      ? {
          all: [...packActor.style.all],
          chat: [...packActor.style.chat],
          post: [...packActor.style.post],
        }
      : { all: ["concise", "market-focused"], chat: ["direct"], post: ["punchy"] },
    settings: {
      temperature: packActor?.settings.temperature ?? 0.75,
      maxTokens: packActor?.settings.maxTokens ?? 480,
    },
  })
}

interface NpcProviderSnapshot {
  readonly worldFactsText: string
  readonly marketsText: string
  readonly postsText: string
  readonly portfolioText: string
  readonly alphaChatsText: string
  readonly worldContext: string
  readonly diversityHint: string
  readonly tickers: ReadonlyArray<string>
  readonly marketIds: ReadonlyArray<string>
  readonly replyPostIds: ReadonlyArray<string>
  readonly chatIds: ReadonlyArray<string>
  readonly openPerpPositionIds: ReadonlyArray<string>
  readonly openPerpPositionsSummary: string
  readonly heldPredictionKeys: ReadonlyArray<string>
  readonly heldPredictionsSummary: string
  readonly followTargetIds: ReadonlyArray<string>
}

effect function loadNpcProviderSnapshot(actor: DbActorRow, nowMs: number): NpcProviderSnapshot!StoreFailure!Store {
  const store = try Store
  const dbSnap = try store.transaction(effect (tx: Tx) => {
    const stateRows = try tx.query("SELECT current_day, current_hour, phase FROM feed_world_state WHERE singleton = true")
    const facts = try tx.query("SELECT fact_text FROM feed_world_facts ORDER BY created_at DESC LIMIT 6")
    const headlines = try tx.query("SELECT COALESCE(parody_headline, title) AS headline FROM feed_rss_headlines ORDER BY published_at DESC LIMIT 5")
    const predPositions = try tx.query(
      `SELECT market_id, side, shares, cost_basis_cents
       FROM feed_prediction_positions
       WHERE holder_id = $1 AND holder_kind = 'npc' AND settled_at IS NULL AND shares > 0`,
      [actor.id],
    )
    const chatRows = try tx.query(
      `SELECT c.id, c.name
       FROM feed_chats c
       JOIN feed_chat_members m ON m.chat_id = c.id
       WHERE m.member_id = $1 AND m.member_kind = 'npc' AND c.kind = 'npc_alpha'
       ORDER BY c.created_at DESC
       LIMIT 5`,
      [actor.id],
    )
    const chatIds = chatRows.map((c) => toText(c.id) ?? "").filter((id) => id.length > 0)
    const chatMessages = chatIds.length > 0
      ? try tx.query(
          `SELECT chat_id, sender_id, body
           FROM feed_messages
           WHERE chat_id = ANY($1)
           ORDER BY created_at DESC
           LIMIT 6`,
          [chatIds],
        )
      : []
    const followCandidates = try tx.query(
      `SELECT a.account_id AS target_id
       FROM feed_accounts a
       WHERE NOT EXISTS (
         SELECT 1 FROM feed_follows f WHERE f.follower_id = $1 AND f.target_id = a.account_id
       )
       AND NOT EXISTS (
         SELECT 1 FROM feed_blocks b
         WHERE (b.blocker_id = $1 AND b.blocked_id = a.account_id)
            OR (b.blocker_id = a.account_id AND b.blocked_id = $1)
       )
       ORDER BY a.updated_at DESC
       LIMIT 6`,
      [actor.id],
    )
    const alreadyFollowingRows = try tx.query(
      "SELECT target_id FROM feed_follows WHERE follower_id = $1",
      [actor.id],
    )
    const blockedRows = try tx.query(
      "SELECT blocker_id, blocked_id FROM feed_blocks WHERE blocker_id = $1 OR blocked_id = $1",
      [actor.id],
    )
    return {
      stateRow: stateRows[0] ?? {},
      facts,
      headlines,
      predPositions,
      chatRows,
      chatMessages,
      followCandidates,
      alreadyFollowing: new Set(alreadyFollowingRows.map((r) => toText(r.target_id) ?? "")),
      blockedIds: new Set(
        blockedRows.map((r) => {
          const blocker = toText(r.blocker_id) ?? ""
          const blocked = toText(r.blocked_id) ?? ""
          return blocker === actor.id ? blocked : blocker
        }),
      ),
    }
  })
  const openMarketsRaw = listPredictionMarkets("open") catch effect () => []
  const perpMarketsRaw = listPerpMarkets() catch effect () => []
  const perpPositionsRaw: ReadonlyArray<PerpPositionView> = listPerpPositions(actor.id) catch effect () => []
  const feedPage = listFeedPosts({ tab: "latest", mode: "game", limit: 12 }) catch effect () => ({ items: [] })
  const feedItems = Array.isArray(feedPage)
    ? (feedPage as ReadonlyArray<Record<string, unknown>>)
    : Array.isArray((feedPage as { readonly items?: unknown }).items)
      ? (feedPage as { readonly items: ReadonlyArray<Record<string, unknown>> }).items
      : []
  const markets = (Array.isArray(openMarketsRaw) ? openMarketsRaw : []).map((m) => {
    const row = m as Record<string, unknown>
    const yes = Math.max(1, toInt(row.yesShares ?? row.yes_shares))
    const no = Math.max(1, toInt(row.noShares ?? row.no_shares))
    return {
      id: toText(row.id) ?? "",
      question: toText(row.question) ?? "",
      category: toText(row.category) ?? "markets",
      timeframe: toText(row.timeframe) ?? "1d",
      phase: toText(row.phase) ?? "opening",
      yesProbPct: Math.round((no * 100) / (yes + no)),
      expiresAt: toInt(row.expiresAt ?? row.expires_at),
    }
  }).filter((m) => m.id.length > 0 && m.expiresAt > nowMs)
  const rawPerps = (Array.isArray(perpMarketsRaw) ? perpMarketsRaw : []).map((p) => {
    const row = p as Record<string, unknown>
    return {
      ticker: toText(row.ticker) ?? "",
      markPriceCents: toInt(row.markPriceCents ?? row.mark_price_cents),
      indexPriceCents: toInt(row.indexPriceCents ?? row.index_price_cents),
      fundingRateBps: toInt(row.fundingRateBps ?? row.funding_rate_bps),
    }
  }).filter((p) => p.ticker.length > 0)
  const perps = prioritizePerpMarkets(rawPerps, Math.max(16, rawPerps.length))
  const recentPosts = feedItems.map((p) => ({
    id: toText(p.id) ?? "",
    authorId: toText(p.authorId ?? p.author_id) ?? "",
    authorKind: toText(p.authorKind ?? p.author_kind) ?? "npc",
    content: toText(p.content) ?? "",
  })).filter((p) => p.id.length > 0)
  const openPerps = (Array.isArray(perpPositionsRaw) ? perpPositionsRaw : []).filter((p) => p.status === "open")
  const openPerpPositionIds = openPerps.map((p) => p.id)
  const openPerpEntries = openPerps.map((p) => {
    const pnlSign = p.unrealizedPnlCents >= 0 ? "+" : ""
    return `${p.id}:${p.ticker}:${p.side}(${pnlSign}${p.unrealizedPnlCents}c)`
  })
  const openPerpPositionsSummary = openPerpEntries.join(", ") || "(none)"
  const heldPredEntries = dbSnap.predPositions.map((r) => {
    const marketId = toText(r.market_id) ?? ""
    const side = (toText(r.side) ?? "YES").toLowerCase() === "no" ? "no" : "yes"
    const shares = Math.max(0, toInt(r.shares))
    return { key: `${marketId}:${side}`, text: `${marketId}:${side}(${shares})` }
  }).filter((entry) => entry.key.length > 4)
  const heldPredictionKeys = heldPredEntries.map((e) => e.key)
  const heldPredictionsSummary = heldPredEntries.map((e) => e.text).join(", ") || "(none)"
  const portfolioText =
    `Cash: $${(actor.balanceCents / 100).toFixed(2)} | Held Predictions: ${heldPredictionsSummary} | Open Perps (${openPerps.length}): ${openPerpPositionsSummary}`
  const factsLines = dbSnap.facts.map((r) => toText(r.fact_text) ?? "").filter((s) => s.length > 0)
  const headlineLines = dbSnap.headlines.map((r) => toText(r.headline) ?? "").filter((s) => s.length > 0)
  const worldContext = buildWorldContext({
    currentDay: Math.max(1, toInt(dbSnap.stateRow.current_day) || 1),
    currentHour: Math.max(0, toInt(dbSnap.stateRow.current_hour)),
    phase: toText(dbSnap.stateRow.phase) ?? "active",
    worldFacts: factsLines,
    parodyHeadlines: headlineLines,
    openMarkets: markets,
    perpMarkets: perps,
    recentPosts,
    actorSummary: portfolioText,
  })
  const predMarketsSummary = markets.slice(0, 8).map((m) => `${m.id} (${m.yesProbPct}% YES): ${m.question}`).join(" | ")
  const perpQuotesSummary = perps
    .slice(0, 12)
    .map((p) => `$${p.ticker} mark $${(p.markPriceCents / 100).toFixed(2)} (idx $${(p.indexPriceCents / 100).toFixed(2)}, ${p.fundingRateBps}bps)`)
    .join(" | ")
  const marketsText = [
    predMarketsSummary ? `Predictions: ${predMarketsSummary}` : "",
    perpQuotesSummary ? `Perps: ${perpQuotesSummary}` : "",
  ]
    .filter((s) => s.length > 0)
    .join(" || ") || "No open markets."
  const chatNameById = new Map(dbSnap.chatRows.map((c) => [toText(c.id) ?? "", toText(c.name) ?? "Alpha Desk"]))
  const chatLines = dbSnap.chatRows.map((c) => `${toText(c.id) ?? ""} (${toText(c.name) ?? "Alpha Desk"})`)
  const recentChatLines = dbSnap.chatMessages.map(
    (m) => `[${chatNameById.get(toText(m.chat_id) ?? "") ?? toText(m.chat_id) ?? "alpha"}] @${toText(m.sender_id) ?? ""}: ${sanitizeText(toText(m.body) ?? "", 80)}`,
  )
  const alphaChatsText = chatLines.length > 0
    ? `Groups: ${chatLines.join(", ")}${recentChatLines.length > 0 ? ` | Recent: ${recentChatLines.join(" ; ")}` : ""}`
    : "No alpha group chats."
  const followTargetsSet = new Set<string>()
  for (const row of dbSnap.followCandidates) {
    const id = toText(row.target_id) ?? ""
    if (id.length > 0 && id !== actor.id) followTargetsSet.add(id)
  }
  for (const post of recentPosts) {
    if (
      post.authorId.length > 0 &&
      post.authorId !== actor.id &&
      !dbSnap.alreadyFollowing.has(post.authorId) &&
      !dbSnap.blockedIds.has(post.authorId)
    ) {
      followTargetsSet.add(post.authorId)
    }
    if (followTargetsSet.size >= 8) break
  }
  return {
    worldFactsText: [...factsLines, ...headlineLines].join(" | ") || "No breaking world facts.",
    marketsText,
    postsText: recentPosts.slice(0, 6).map((p) => `[${p.id}] @${p.authorId}: ${sanitizeText(p.content, 80)}`).join(" | ") || "Feed empty.",
    portfolioText,
    alphaChatsText,
    worldContext,
    diversityHint: formatFeedDiversityHint(recentPosts),
    tickers: perps.map((p) => p.ticker),
    marketIds: markets.map((m) => m.id),
    replyPostIds: recentPosts.filter((p) => p.authorId !== actor.id).map((p) => p.id),
    chatIds: dbSnap.chatRows.map((c) => toText(c.id) ?? "").filter((id) => id.length > 0),
    openPerpPositionIds,
    openPerpPositionsSummary,
    heldPredictionKeys,
    heldPredictionsSummary,
    followTargetIds: [...followTargetsSet].slice(0, 8),
  }
}

function buildNpcProviders(actorId: string, snapshot: NpcProviderSnapshot): Provider[] {
  const provider = (name: string, description: string, text: string): Provider => ({
    name,
    description,
    dynamic: true,
    get: () => Promise.resolve({ text, values: { [name]: text }, data: { actorId } }),
  })
  return [
    provider("WORLD_FACTS", "Canonical world facts and satirical headlines", snapshot.worldFactsText),
    provider("TRENDING_MARKETS", "Open prediction markets and spot/perp quotes", snapshot.marketsText),
    provider("RECENT_POSTS", "Recent Feed posts from NPCs and users", snapshot.postsText),
    provider("ACTOR_PORTFOLIO", "Current NPC cash, prediction shares, and open perps", snapshot.portfolioText),
    provider("ALPHA_CHATS", "Private NPC alpha desk chats and recent desk messages", snapshot.alphaChatsText),
  ]
}

function affiliatedTickersForActor(actorId: string): ReadonlyArray<string> {
  const packActor = packActorById.get(actorId)
  if (!packActor) return []
  const tickers: string[] = []
  for (const orgId of packActor.affiliations) {
    const ticker = orgById.get(orgId)?.ticker?.toUpperCase()
    if (ticker) tickers.push(ticker)
  }
  return tickers
}

function affiliatedKeywordsForActor(actorId: string): ReadonlyArray<string> {
  const packActor = packActorById.get(actorId)
  if (!packActor) return []
  const words = new Set<string>()
  for (const orgId of packActor.affiliations) {
    const org = orgById.get(orgId)
    if (org?.name && org.name.length >= 3) words.add(org.name.toLowerCase())
    if (org?.ticker && org.ticker.length >= 2) words.add(org.ticker.toLowerCase())
  }
  if (packActor.name.length >= 4) words.add(packActor.name.toLowerCase())
  return [...words]
}

effect function findEligibleAlphaTargetTx(tx: Tx, actorId: string, nowMs: number): (string | null)!StoreFailure {
  const affiliatedTickers = affiliatedTickersForActor(actorId)
  const keywords = affiliatedKeywordsForActor(actorId)
  const matchedMarkets = keywords.length > 0
    ? (try tx.query("SELECT id, question, description FROM feed_prediction_markets WHERE status IN ('open', 'expired', 'resolved') ORDER BY created_at DESC LIMIT 40"))
        .filter((row) => {
          const text = `${toText(row.question) ?? ""} ${toText(row.description) ?? ""}`.toLowerCase()
          return keywords.some((kw) => text.includes(kw))
        })
        .map((row) => toText(row.id) ?? "")
        .filter((id) => id.length > 0)
    : []
  const rows = try tx.query(
    `SELECT eng.account_id, SUM(eng.score) AS engagement_score
     FROM (
       SELECT l.account_id AS account_id, 1 AS score
       FROM feed_post_likes l
       JOIN feed_posts p ON p.id = l.post_id
       WHERE p.author_id = $1 AND p.author_kind = 'npc'
       UNION ALL
       SELECT r.account_id AS account_id, 1 AS score
       FROM feed_post_reposts r
       JOIN feed_posts p ON p.id = r.post_id
       WHERE p.author_id = $1 AND p.author_kind = 'npc'
       UNION ALL
       SELECT reply.author_id AS account_id, 1 AS score
       FROM feed_posts reply
       JOIN feed_posts p ON p.id = reply.reply_to_post_id
       WHERE p.author_id = $1 AND p.author_kind = 'npc' AND reply.author_kind = 'user' AND reply.deleted_at IS NULL
       UNION ALL
       SELECT t.trader_id AS account_id, 1 AS score
       FROM feed_trades t
       WHERE t.trader_kind = 'user'
         AND (
           (t.market_kind IN ('perp', 'spot') AND upper(t.market_ref) = ANY($4))
           OR (t.market_kind = 'prediction' AND t.market_ref = ANY($5))
         )
     ) eng
     JOIN feed_accounts a ON a.account_id = eng.account_id
     WHERE NOT EXISTS (
       SELECT 1 FROM feed_group_invites gi
       WHERE gi.invited_account_id = eng.account_id AND gi.invited_by_id = $1 AND gi.status IN ('pending', 'accepted')
     )
     AND NOT EXISTS (
       SELECT 1 FROM feed_blocks b
       WHERE (b.blocker_id = $1 AND b.blocked_id = eng.account_id)
          OR (b.blocker_id = eng.account_id AND b.blocked_id = $1)
     )
     AND NOT EXISTS (
       SELECT 1 FROM feed_alpha_invite_cooldowns c
       WHERE c.actor_id = $1 AND c.account_id = eng.account_id AND c.next_eligible_at > $3
     )
     GROUP BY eng.account_id
     HAVING SUM(eng.score) >= $2
     ORDER BY engagement_score DESC, eng.account_id ASC
     LIMIT 1`,
    [actorId, minAlphaEngagement, nowMs, affiliatedTickers, matchedMarkets],
  )
  return rows.length > 0 ? (toText(rows[0]?.account_id) ?? null) : null
}

export effect function findEligibleAlphaTarget(
  actorId: string,
  nowMs?: number,
): (string | null)!(EngineFailure | StoreFailure)!Store {
  const resolvedNow = try resolveClockNow(nowMs)
  const store = try Store
  return try store.transaction(effect (tx: Tx) => try findEligibleAlphaTargetTx(tx, actorId, resolvedNow))
}

function buildNpcActions(actor: DbActorRow, runWithStore: StoreEffectRunner, nowMs: number): Action[] {
  const wrap = (
    name: string,
    description: string,
    eff: (params: Record<string, unknown>) => ActionResult!(EngineFailure | StoreFailure | unknown)!Store,
  ): Action => ({
    name,
    description,
    validate: async () => true,
    handler: async (_runtime, message, _state, options) => {
      const params = asParamRecord(options, message)
      try {
        return await runWithStore(eff(params))
      } catch (err) {
        return { success: false, text: err instanceof Error ? err.message : `${name} skipped`, data: { action: name } }
      }
    },
  })
  return [
    wrap("SPOT_TRADE", "Execute an NPC spot pool swap moving index price", effect (p) => {
      const ticker = String(p.ticker ?? "")
      const side = p.side === "sell" ? "sell" : "buy"
      const quoteCents = Math.max(100, Math.round(Number(p.quoteCents ?? 2500)))
      const spotReceipt = try executeNpcSpotTrade({ actorId: actor.id, ticker, side, quoteCents })
      try maybePublishFeedEvent({
        type: "market.spot",
        actorId: actor.id,
        ticker,
        side,
        quoteCents,
        indexPriceCents: spotReceipt.indexPriceCents,
        markPriceCents: spotReceipt.markPriceCents,
      })
      return { success: true, text: `Spot ${side} ${quoteCents}c ${ticker}`, data: { ticker, side, quoteCents } }
    }),
    wrap("PERP_TRADE", "Open a leveraged NPC perpetual position", effect (p) => {
      const ticker = String(p.ticker ?? "")
      const side = p.side === "short" ? "short" : "long"
      const collateralCents = Math.max(500, Math.round(Number(p.collateralCents ?? 2500)))
      const leverage = Math.max(1, Math.min(20, Math.round(Number(p.leverage ?? 3))))
      const opened = try openPerpPosition({ ownerId: actor.id, ownerKind: "npc", ticker, side, collateralCents, leverage, viaClientName: "eliza-npc" })
      try maybePublishFeedEvent({
        type: "market.perp",
        action: "open",
        actorId: actor.id,
        ticker,
        side,
        sizeCents: opened.sizeCents,
        leverage: opened.leverage,
        positionId: opened.positionId,
        markPriceCents: opened.position.markPriceCents,
      })
      return { success: true, text: `Perp ${side} ${leverage}x ${ticker}`, data: { ticker, side, collateralCents, leverage, positionId: opened.positionId } }
    }),
    wrap("CLOSE_PERP", "Close or reduce an open NPC perpetual position", effect (p) => {
      const positionId = String(p.positionId ?? "")
      if (!positionId) return { success: false, text: "Missing positionId" }
      const rawPct = typeof p.closePct === "number" && Number.isFinite(p.closePct) ? Math.max(1, Math.min(100, Math.round(p.closePct))) : undefined
      const closed = try closePerpPosition({
        positionId,
        ownerId: actor.id,
        ...(rawPct === undefined ? {} : { closePct: rawPct }),
        viaClientName: "eliza-npc",
      })
      try maybePublishFeedEvent({
        type: "market.perp",
        action: "close",
        actorId: actor.id,
        ticker: closed.ticker,
        side: closed.side,
        sizeCents: closed.sizeCents,
        leverage: 1,
        positionId: closed.positionId,
        markPriceCents: closed.exitPriceCents,
      })
      return {
        success: true,
        text: `Closed perp ${closed.ticker} (${closed.positionId}) PnL ${closed.realizedPnlCents}c`,
        data: { positionId: closed.positionId, ticker: closed.ticker, realizedPnlCents: closed.realizedPnlCents },
      }
    }),
    wrap("PREDICTION_TRADE", "Buy prediction market YES/NO shares", effect (p) => {
      const marketId = String(p.marketId ?? "")
      const side = p.side === "no" ? "no" : "yes"
      const amountCents = Math.max(100, Math.round(Number(p.amountCents ?? 1500)))
      const receipt = try buyPredictionShares({ actorId: actor.id, actorKind: "npc", marketId, side, amountCents, viaClientName: "eliza-npc" })
      try maybePublishFeedEvent({
        type: "market.prediction",
        marketId: receipt.marketId,
        action: receipt.action,
        side: receipt.side,
        yesPriceBps: receipt.yesPriceBps,
        noPriceBps: receipt.noPriceBps,
        shares: receipt.shares,
        notionalCents: receipt.notionalCents,
      })
      return { success: true, text: `Prediction ${side} ${amountCents}c on ${marketId}`, data: { marketId, side, amountCents } }
    }),
    wrap("SELL_PREDICTION", "Sell held prediction market YES/NO shares", effect (p) => {
      const marketId = String(p.marketId ?? "")
      const side = p.side === "no" ? "no" : "yes"
      const requestedShares = Math.max(MIN_SELL_SHARE_UNITS, Math.round(Number(p.shares ?? MIN_SELL_SHARE_UNITS)))
      if (!marketId) return { success: false, text: "Missing marketId" }
      const store = try Store
      const heldShares = try store.transaction(effect (tx: Tx) => {
        const rows = try tx.query(
          `SELECT shares FROM feed_prediction_positions
           WHERE market_id = $1 AND holder_id = $2 AND side = $3 AND settled_at IS NULL`,
          [marketId, actor.id, side === "yes" ? "YES" : "NO"],
        )
        return rows.length > 0 ? Math.max(0, toInt(rows[0]?.shares)) : 0
      })
      const sellShares = Math.min(heldShares, requestedShares)
      if (sellShares < MIN_SELL_SHARE_UNITS) {
        return { success: false, text: "Insufficient held shares to sell" }
      }
      const receipt = try sellPredictionShares({
        actorId: actor.id,
        actorKind: "npc",
        marketId,
        side,
        shares: sellShares,
        viaClientName: "eliza-npc",
      })
      return {
        success: true,
        text: `Sold ${sellShares} ${side} shares on ${marketId} for ${receipt.netCents}c`,
        data: { marketId, side, shares: sellShares, netCents: receipt.netCents },
      }
    }),
    wrap("CREATE_POST", "Publish a Feed social post as the NPC", effect (p) => {
      const content = sanitizeText(String(p.content ?? ""), 275)
      if (content.length === 0) return { success: false, text: "Empty post" }
      const marketId = typeof p.marketId === "string" ? p.marketId : undefined
      const ticker = typeof p.ticker === "string" ? p.ticker : undefined
      try createPost({ authorId: actor.id, authorKind: "npc", content, ...(marketId ? { marketId } : {}), ...(ticker ? { ticker } : {}) })
      return { success: true, text: content, data: { marketId, ticker } }
    }),
    wrap("CREATE_REPLY", "Reply to an existing Feed post", effect (p) => {
      const replyToPostId = String(p.replyToPostId ?? "")
      const content = sanitizeText(String(p.content ?? ""), 260)
      if (!replyToPostId || !content) return { success: false, text: "Invalid reply" }
      try createPost({ authorId: actor.id, authorKind: "npc", content, replyToPostId })
      return { success: true, text: content, data: { replyToPostId } }
    }),
    wrap("LIKE_POST", "Like a Feed post as the NPC", effect (p) => {
      const postId = String(p.postId ?? "")
      if (!postId) return { success: false, text: "Invalid postId" }
      const res = try likePost(actor.id, postId)
      return { success: true, text: `Liked post ${res.postId}`, data: { postId: res.postId, likeCount: res.likeCount } }
    }),
    wrap("REPOST_POST", "Repost a Feed post as the NPC", effect (p) => {
      const postId = String(p.postId ?? "")
      if (!postId) return { success: false, text: "Invalid postId" }
      const res = try repostPost(actor.id, postId)
      return { success: true, text: `Reposted post ${res.postId}`, data: { postId: res.postId, repostCount: res.repostCount } }
    }),
    wrap("FOLLOW_USER", "Follow an account or actor as the NPC", effect (p) => {
      const targetId = String(p.targetId ?? "")
      if (!targetId) return { success: false, text: "Invalid targetId" }
      const res = try followAccount(actor.id, targetId)
      return { success: true, text: `Followed ${res.targetId}`, data: { targetId: res.targetId, targetKind: res.targetKind } }
    }),
    wrap("SEND_GROUP_MESSAGE", "Send a message in an NPC alpha group chat", effect (p) => {
      const chatId = String(p.chatId ?? "")
      const content = sanitizeText(String(p.content ?? ""), 275)
      if (!chatId || !content) return { success: false, text: "Invalid chat message" }
      try sendChatMessage({ senderId: actor.id, senderKind: "npc", chatId, content })
      return { success: true, text: content, data: { chatId } }
    }),
    wrap("INVITE_ALPHA", "Invite a qualifying engaged human user to NPC alpha group", effect () => {
      const store = try Store
      const targetAccountId = try store.transaction(effect (tx: Tx) => try findEligibleAlphaTargetTx(tx, actor.id, nowMs))
      if (!targetAccountId) {
        return { success: false, text: "No human user has reached engagement threshold." }
      }
      try createNpcAlphaInvite({ actorId: actor.id, targetAccountId, tier: actor.tier })
      try maybePublishFeedEvent({ type: "alpha.invite", actorId: actor.id, targetAccountId })
      return { success: true, text: `Invited ${targetAccountId} to alpha`, data: { targetAccountId } }
    }),
  ]
}

function createFeedNpcPlugin(actor: DbActorRow, snapshot: NpcProviderSnapshot, runWithStore: StoreEffectRunner, nowMs: number): Plugin {
  return {
    name: `@repo/engine/npc-${actor.id}`,
    description: `Feed autonomous actions and world context for ${actor.name}`,
    providers: buildNpcProviders(actor.id, snapshot),
    actions: buildNpcActions(actor, runWithStore, nowMs),
  }
}

function isActionAllowedByAutonomy(decision: NpcDecisionAction, packActor: PackActor | undefined): boolean {
  const autonomy = packActor?.feed.autonomy
  if (!autonomy) return true
  switch (decision.kind) {
    case "SPOT_TRADE":
    case "PERP_TRADE":
    case "PREDICTION_TRADE":
      return autonomy.trading
    case "CLOSE_PERP":
    case "SELL_PREDICTION":
      return true
    case "CREATE_POST":
      return autonomy.posting
    case "CREATE_REPLY":
      return autonomy.commenting
    case "LIKE_POST":
    case "REPOST_POST":
    case "FOLLOW_USER":
      return autonomy.posting || autonomy.commenting
    case "SEND_GROUP_MESSAGE":
    case "INVITE_ALPHA":
      return autonomy.groups
  }
}

effect function composeFeedProviders(runtime: AgentRuntime, providers: ReadonlyArray<Provider>, message: Memory): State!EngineFailure {
  const initial: State = { values: {}, data: {}, text: "" }
  const ordered = providers.toSorted((left, right) => left.name.localeCompare(right.name))
  const values: State["values"] = {}
  const results: NonNullable<State["data"]["providers"]> = {}
  const texts: string[] = []
  for (const provider of ordered) {
    const result = try tryPromise({
      try: () => provider.get(runtime, message, initial),
      catch: (cause) => new EngineFailure({ code: "RUNTIME_FAILED", message: `Feed NPC provider ${provider.name} failed`, cause }),
    })
    const text = result.text === undefined ? undefined : runtime.redactSecrets(result.text)
    results[provider.name] = { values: result.values, data: result.data, ...(text === undefined ? {} : { text }) }
    for (const [key, value] of Object.entries(result.values ?? {})) values[key] = value
    if (text?.trim()) texts.push(text)
  }
  const text = runtime.redactSecrets(texts.join("\n"))
  return { values: { ...values, providers: text }, data: { providerOrder: ordered.map((provider) => provider.name), providers: results }, text }
}

export effect function executeNpcDecision(
  actorId: string,
  decision: NpcDecisionAction,
  nowMs?: number,
): ActionResult!(EngineFailure | StoreFailure)!Store {
  const resolvedNow = try resolveClockNow(nowMs)
  const store = try Store
  const actorRow = try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      `SELECT id, name, username, tier, description, system_prompt, balance_cents
       FROM feed_actors
       WHERE id = $1`,
      [actorId],
    )
    const row = rows[0]
    if (!row) return null
    return {
      id: toText(row.id) ?? "",
      name: toText(row.name) ?? "",
      username: toText(row.username) ?? "",
      tier: toText(row.tier) ?? "C_TIER",
      description: toText(row.description) ?? "",
      systemPrompt: toText(row.system_prompt) ?? "",
      balanceCents: toInt(row.balance_cents),
    }
  })
  if (!actorRow || !isRuntimeNpcActor(actorRow.id, actorRow.name, actorRow.username)) {
    throw new EngineFailure({ code: "NOT_FOUND", message: `NPC actor ${actorId} not found.` })
  }
  const busOpt = try Effect.serviceOption(RealtimeBus)
  const runWithStore: StoreEffectRunner = <A, E>(eff: A!E!Store) => {
    const layer = Option.isSome(busOpt)
      ? Layer.mergeAll(Layer.succeed(Store, store), Layer.succeed(RealtimeBus, busOpt.value))
      : Layer.succeed(Store, store)
    return runPromise(Effect.provide(eff, layer))
  }
  const packActor = packActorById.get(actorRow.id)
  if (!isActionAllowedByAutonomy(decision, packActor)) {
    return { success: false, text: `Autonomy disables ${decision.kind} for ${actorRow.id}` }
  }
  const character = buildNpcCharacter(actorRow, packActor)
  const agentUuid = safeElizaUuid(`feed-npc:${actorRow.id}`)
  const runtime = try Effect.try({
    try: () => new AgentRuntime({ character, agentId: agentUuid }),
    catch: (cause) => new EngineFailure({ code: "RUNTIME_FAILED", message: `Failed creating AgentRuntime for ${actorRow.id}`, cause }),
  })
  const actions = buildNpcActions(actorRow, runWithStore, resolvedNow)
  const action = actions.find((a) => a.name === decision.kind)
  if (!action) {
    return { success: false, text: `Unknown action ${decision.kind}` }
  }
  const params = toJsonParamRecord(decision as unknown as Record<string, unknown>)
  const actionMemory: Memory = {
    id: safeElizaUuid(newEngineId("act")),
    entityId: agentUuid,
    agentId: agentUuid,
    roomId: safeElizaUuid("feed-world-room"),
    content: { text: decision.kind, data: params },
  }
  const result = try tryPromise({
    try: () => Promise.resolve(action.handler(runtime, actionMemory, { values: {}, data: {}, text: "" }, { parameters: params })),
    catch: (cause) => new EngineFailure({ code: "RUNTIME_FAILED", message: `NPC action ${decision.kind} failed`, cause }),
  })
  return (result as ActionResult | undefined) ?? { success: false, text: "No action result" }
}

effect function runSingleNpcTurn(actor: DbActorRow, maxSteps: number, nowMs: number): number!(EngineFailure | StoreFailure)!Store {
  const store = try Store
  const busOpt = try Effect.serviceOption(RealtimeBus)
  const runWithStore: StoreEffectRunner = <A, E>(eff: A!E!Store) => {
    const layer = Option.isSome(busOpt)
      ? Layer.mergeAll(Layer.succeed(Store, store), Layer.succeed(RealtimeBus, busOpt.value))
      : Layer.succeed(Store, store)
    return runPromise(Effect.provide(eff, layer))
  }
  const snap = try loadNpcProviderSnapshot(actor, nowMs)
  const packActor = packActorById.get(actor.id) ?? actors.find((a) => a.username === actor.username)
  const character = buildNpcCharacter(actor, packActor)
  const plugin = createFeedNpcPlugin(actor, snap, runWithStore, nowMs)
  const agentUuid = safeElizaUuid(`feed-npc:${actor.id}`)
  const runtime = try Effect.try({
    try: () => new AgentRuntime({ character, agentId: agentUuid }),
    catch: (cause) => new EngineFailure({ code: "RUNTIME_FAILED", message: `Failed creating AgentRuntime for ${actor.id}`, cause }),
  })
  try tryPromise({
    try: () => runtime.registerPlugin(plugin),
    catch: (cause) => new EngineFailure({ code: "RUNTIME_FAILED", message: `Failed registering Feed NPC plugin for ${actor.id}`, cause }),
  })
  const triggerMemory: Memory = {
    id: safeElizaUuid(newEngineId("mem")),
    entityId: agentUuid,
    agentId: agentUuid,
    roomId: safeElizaUuid("feed-world-room"),
    content: { text: "Observe Feed markets and social posts, then plan bounded actions." },
  }
  const composedState = try composeFeedProviders(runtime, plugin.providers ?? [], triggerMemory)
  const rendered = renderPrompt("npcTradingDecision", {
    actorId: actor.id,
    actorName: actor.name,
    actorPersona: sanitizeText(packActor?.personality ?? actor.description, 200),
    tradingStyle: packActor?.feed.tradingStyle ?? "balanced catalyst trader",
    maxSteps: String(maxSteps),
    tickers: snap.tickers.join(", ") || "(none)",
    marketIds: snap.marketIds.join(", ") || "(none)",
    openPerpPositions: snap.openPerpPositionsSummary,
    heldPredictions: snap.heldPredictionsSummary,
    replyPostIds: snap.replyPostIds.slice(0, 6).join(", ") || "(none)",
    followTargets: snap.followTargetIds.join(", ") || "(none)",
    chatIds: snap.chatIds.join(", ") || "(none)",
    portfolio: snap.portfolioText,
    worldContext: sanitizeText(composedState.text || snap.worldContext, 2200),
    diversityHint: snap.diversityHint,
  })
  const completion = try generateCompletion({
    promptId: "npcTradingDecision",
    system: rendered.system,
    user: rendered.user,
    maxTokens: rendered.maxTokens,
    temperature: rendered.temperature,
    jsonMode: true,
    nowMs,
    actorId: actor.id,
  })
  const parsed = parseLlmJsonRecord(completion.text)
  const decisions = validateNpcTradingDecision(
    parsed,
    maxSteps,
    snap.tickers,
    snap.marketIds,
    snap.replyPostIds,
    snap.chatIds,
    snap.openPerpPositionIds,
    snap.heldPredictionKeys,
    snap.followTargetIds,
  ).filter((decision) => isActionAllowedByAutonomy(decision, packActor))
  let actionsExecuted = 0
  const actionMap = new Map((plugin.actions ?? []).map((act) => [act.name, act]))
  for (const decision of decisions) {
    if (actionsExecuted >= maxSteps) break
    const action = actionMap.get(decision.kind)
    if (!action) continue
    const params = toJsonParamRecord(decision as unknown as Record<string, unknown>)
    const actionMemory: Memory = {
      id: safeElizaUuid(newEngineId("act")),
      entityId: agentUuid,
      agentId: agentUuid,
      roomId: safeElizaUuid("feed-world-room"),
      content: { text: decision.kind, data: params },
    }
    const result = try tryPromise({
      try: () => Promise.resolve(action.handler(runtime, actionMemory, composedState, { parameters: params })),
      catch: (cause) => new EngineFailure({ code: "RUNTIME_FAILED", message: `NPC action ${decision.kind} failed`, cause }),
    })
    if ((result as ActionResult | undefined)?.success) {
      actionsExecuted += 1
    }
  }
  return actionsExecuted
}

function actorSelectionWeight(tier: string): number {
  switch (tier) {
    case "S_TIER":
      return 4
    case "A_TIER":
      return 3
    case "B_TIER":
      return 2
    default:
      return 1
  }
}

function pickWeightedFromPool(
  pool: Array<DbActorRow>,
  count: number,
  bucketKey: string,
  salt: string,
): ReadonlyArray<DbActorRow> {
  const picked: DbActorRow[] = []
  for (let slot = 0; slot < count && pool.length > 0; slot += 1) {
    let totalWeight = 0
    for (const candidate of pool) {
      totalWeight += actorSelectionWeight(candidate.tier)
    }
    let cursor = hashString(`${bucketKey}:${salt}:${slot}`) % Math.max(1, totalWeight)
    let pickedIdx = 0
    for (let i = 0; i < pool.length; i += 1) {
      cursor -= actorSelectionWeight(pool[i]!.tier)
      if (cursor < 0) {
        pickedIdx = i
        break
      }
    }
    picked.push(pool[pickedIdx]!)
    pool.splice(pickedIdx, 1)
  }
  return picked
}

function resolveConfiguredMaxSteps(budgetMaxSteps: number): number {
  const raw = readEnv("NPC_MAX_STEPS_PER_TICK")?.trim()
  if (raw && raw.length > 0) {
    const parsed = Number(raw)
    if (Number.isFinite(parsed) && parsed >= 1) {
      const clamped = Math.max(1, Math.min(4, Math.floor(parsed)))
      return Math.min(budgetMaxSteps, clamped)
    }
  }
  return Math.max(1, Math.min(4, budgetMaxSteps))
}

function selectSmartNpcBatch(
  allActors: ReadonlyArray<DbActorRow>,
  mentionedActorIds: ReadonlySet<string>,
  postedTodayIds: ReadonlySet<string>,
  batchLimit: number,
  bucketKey: string,
): ReadonlyArray<DbActorRow> {
  const targetCount = Math.min(batchLimit, allActors.length)
  if (targetCount <= 0) return []
  const selected: DbActorRow[] = []
  const selectedIds = new Set<string>()
  const mentionCap = Math.max(1, Math.floor(targetCount / 2))
  const mentionedPool = allActors.filter((a) => mentionedActorIds.has(a.id))
  for (const actor of pickWeightedFromPool([...mentionedPool], Math.min(mentionCap, mentionedPool.length), bucketKey, "mention")) {
    selected.push(actor)
    selectedIds.add(actor.id)
  }
  const remainingAfterMentions = targetCount - selected.length
  if (remainingAfterMentions > 0) {
    const diversityQuota = Math.max(1, Math.floor(remainingAfterMentions * 0.3))
    const unpostedPool = allActors.filter((a) => !selectedIds.has(a.id) && !postedTodayIds.has(a.id))
    for (const actor of pickWeightedFromPool([...unpostedPool], Math.min(diversityQuota, unpostedPool.length), bucketKey, "diversity")) {
      selected.push(actor)
      selectedIds.add(actor.id)
    }
  }
  const remainingSlots = targetCount - selected.length
  if (remainingSlots > 0) {
    const restPool = allActors.filter((a) => !selectedIds.has(a.id))
    for (const actor of pickWeightedFromPool([...restPool], remainingSlots, bucketKey, "tier")) {
      selected.push(actor)
      selectedIds.add(actor.id)
    }
  }
  return selected
}

export effect function runBoundedNpcBatch(nowMs?: number): NpcTickBatchSummary!(EngineFailure | StoreFailure)!Store {
  const resolvedNow = try resolveClockNow(nowMs)
  const spendStatus = try getDailySpendStatus(resolvedNow)
  const batchLimit = Math.max(1, spendStatus.effectiveBatchSize)
  const maxSteps = resolveConfiguredMaxSteps(spendStatus.maxStepsAllowed)
  const utcDayStartMs = Math.floor(resolvedNow / 86_400_000) * 86_400_000
  const mentionWindowMs = resolvedNow - 30 * 60_000
  const store = try Store
  const batchContext = try store.transaction(effect (tx: Tx) => {
    const rows = try tx.query(
      `SELECT id, name, username, tier, description, system_prompt, balance_cents
       FROM feed_actors
       WHERE id NOT LIKE 'test-%'
       ORDER BY id ASC`,
    )
    const allActors: DbActorRow[] = rows
      .map((row) => ({
        id: toText(row.id) ?? "",
        name: toText(row.name) ?? "",
        username: toText(row.username) ?? "",
        tier: toText(row.tier) ?? "C_TIER",
        description: toText(row.description) ?? "",
        systemPrompt: toText(row.system_prompt) ?? "",
        balanceCents: toInt(row.balance_cents),
      }))
      .filter((a) => isRuntimeNpcActor(a.id, a.name, a.username))
    const repliedRows = try tx.query(
      `SELECT DISTINCT parent.author_id AS actor_id
       FROM feed_posts reply
       JOIN feed_posts parent ON parent.id = reply.reply_to_post_id
       WHERE reply.deleted_at IS NULL
         AND reply.created_at >= $1
         AND parent.author_kind = 'npc'
       LIMIT 20`,
      [mentionWindowMs],
    )
    const recentMentionPosts = try tx.query(
      `SELECT content
       FROM feed_posts
       WHERE deleted_at IS NULL AND created_at >= $1 AND content LIKE '%@%'
       ORDER BY created_at DESC
       LIMIT 30`,
      [mentionWindowMs],
    )
    const postedTodayRows = try tx.query(
      `SELECT DISTINCT author_id
       FROM feed_posts
       WHERE author_kind = 'npc' AND deleted_at IS NULL AND created_at >= $1`,
      [utcDayStartMs],
    )
    const actorByUsername = new Map(allActors.map((a) => [a.username.toLowerCase(), a.id]))
    const mentionedActorIds = new Set<string>()
    for (const row of repliedRows) {
      const id = toText(row.actor_id)
      if (id) mentionedActorIds.add(id)
    }
    for (const row of recentMentionPosts) {
      const content = toText(row.content) ?? ""
      const matches = content.matchAll(/@([a-zA-Z0-9_-]{2,40})/g)
      for (const m of matches) {
        const handle = m[1]?.toLowerCase()
        const actorId = handle ? actorByUsername.get(handle) : undefined
        if (actorId) mentionedActorIds.add(actorId)
      }
    }
    const postedTodayIds = new Set(postedTodayRows.map((r) => toText(r.author_id) ?? "").filter((id) => id.length > 0))
    return { allActors, mentionedActorIds, postedTodayIds }
  })
  if (batchContext.allActors.length === 0) {
    return { actorsSelected: 0, actorsCompleted: 0, actionsExecuted: 0, maxStepsUsed: maxSteps, throttledBatchSize: batchLimit }
  }
  const batch = selectSmartNpcBatch(
    batchContext.allActors,
    batchContext.mentionedActorIds,
    batchContext.postedTodayIds,
    batchLimit,
    `npc-batch:${Math.floor(resolvedNow / 120_000)}`,
  )
  let actorsCompleted = 0
  let actionsExecuted = 0
  for (const actor of batch) {
    const executed = runSingleNpcTurn(actor, maxSteps, resolvedNow) catch effect () => null
    if (executed !== null) {
      actorsCompleted += 1
      actionsExecuted += executed
    }
  }
  return {
    actorsSelected: batch.length,
    actorsCompleted,
    actionsExecuted,
    maxStepsUsed: maxSteps,
    throttledBatchSize: batchLimit,
  }
}
