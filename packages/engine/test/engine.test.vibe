    const glennGuardrails = formatActorToneAndFinanceGuardrails(glennPack)
    const multiPostDecisions = validateNpcTradingDecision(
      {
        actions: [
          { kind: "CREATE_POST", content: "First post on $NVDAI" },
          { kind: "CREATE_POST", content: "Second duplicate spam post" },
          { kind: "CREATE_POST", content: "Third spam post" },
        ],
      },
      4,
      ["NVDAI"],
      ["seed-market-1"],
    )
    const postAuthorCountsBefore = try queryRows(
      `SELECT author_id, COUNT(*)::int AS cnt FROM feed_posts WHERE author_kind = 'npc' AND reply_to_post_id IS NULL AND created_at >= $1 GROUP BY author_id`,
      [liveNow - 600_000],
    )
    const maxPostsPerNpcInWindow = Math.max(0, ...postAuthorCountsBefore.map((r) => toInt(r.cnt)))

    try check(() => {
      assert.strictEqual(trimmedHashtag, "Stay tuned for more...")
      assert.strictEqual(trimmedSentence, "Cybercab v14 shipped today. Orderbook looks wild!")
      assert.strictEqual(cleanedSlugText, "Sources close to Glenn GreenAIwald and PolitAIco confirmed the leak.")
      assert.strictEqual(scrubbedNarrative, "OpenAGI and AIlon Musk spoke to BloombAIrg about NVIDAI")
      assert.isFalse(isRuntimeNpcActor("org-bloombairg"))
      assert.isFalse(isRuntimeNpcActor("org-openagi"))
      assert.isTrue(isRuntimeNpcActor("sam-ailtman"))
      assert.strictEqual(orgPromptIdForType("media"), "orgMediaPost")
      assert.strictEqual(orgPromptIdForType("company"), "orgCompanyPost")
      assert.strictEqual(orgPromptIdForType("government"), "orgGovernmentPost")
      assert.strictEqual(orgPromptIdForType("vc"), "orgVcPost")
      assert.strictEqual(orgPromptIdForType("financial"), "orgFinancialPost")
      assert.strictEqual(orgPromptIdForType("organization"), "orgFoundationPost")
      assert.isTrue(PromptCatalog.orgMediaPost.system.includes("THIRD-PERSON"))
      assert.isTrue(PromptCatalog.orgMediaPost.system.includes("NEVER use 'I', 'me', 'my'"))
      assert.isTrue(realityGroundingContent.includes("Sim Cook"))
      assert.isTrue(realityGroundingContent.includes("AItropic"))
      assert.isTrue(realityGroundingContent.includes("NVIDAI"))
      assert.isTrue(realityGroundingContent.includes("Block Rock"))
      assert.isFalse(realityGroundingContent.includes("GPT-5"))
      assert.isFalse(realityGroundingContent.includes("Tim CAIok"))
      assert.isFalse(realityGroundingContent.includes("AInthropic"))
      assert.isFalse(realityGroundingContent.includes("NVAIDAI"))
      assert.strictEqual(minNotionalPerpDecision.length, 1)
      assert.isTrue(
        minNotionalPerpDecision[0]?.kind === "PERP_TRADE" &&
          minNotionalPerpDecision[0].collateralCents * minNotionalPerpDecision[0].leverage >= 1000,
      )
      assert.isTrue(glennVoiceCtx.includes("Example Posts"))
      assert.isTrue(glennGuardrails.includes("NOT a quant"))
      assert.isTrue(orgPosts.every((r) => !hasFirstPersonSingularLeak(toText(r.content) ?? "")))
      assert.isTrue(clueActors.every((r) => !(toText(r.actor_id) ?? "").startsWith("org-")))
      assert.strictEqual(multiPostDecisions.filter((d) => d.kind === "CREATE_POST").length, 1)
      assert.isTrue(PromptCatalog.ambientPost.system.includes("FIRST PERSON"))
      assert.isTrue(PromptCatalog.commentary.system.includes("FIRST PERSON"))
      assert.isTrue(PromptCatalog.replyPost.system.includes("FIRST PERSON"))
      assert.isTrue(PromptCatalog.ambientPost.system.includes("NVIDAI"))
      assert.isTrue(maxPostsPerNpcInWindow <= 2)
      assert.strictEqual(soldPredRes.success, true)
      assert.strictEqual(closedPerpRes.success, true)
      assert.strictEqual(toText(closedPerpRow.status), "closed")
      assert.strictEqual(likeRes.success, true)
      assert.strictEqual(repostRes.success, true)
      assert.strictEqual(followRes.success, true)
      assert.strictEqual(likeRows.length, 1)
      assert.strictEqual(repostRows.length, 1)
      assert.strictEqual(followRows.length, 1)
      assert.strictEqual(eligibleBeforeBlock, humanId)
      assert.isNull(eligibleWhileBlocked)
      assert.isNull(eligibleDuringCooldown)
      assert.strictEqual(eligibleAfterCooldown, humanId)
      assert.strictEqual(cappedNpcTick.maxStepsUsed, 2)
      assert.isTrue(worldSnap.tickers.includes("NVDAI"))
      assert.isTrue(worldSnap.tickers.includes("OPENAGI"))
      assert.isTrue(worldSnap.tickers.includes("TSLAI"))
      assert.isTrue(worldSnap.tickers.includes("METAI"))
      assert.isTrue(worldSnap.worldContext.includes("NVDAI"))
      assert.isTrue(worldSnap.worldContext.includes("OPENAGI"))
      assert.isTrue(worldSnap.worldContext.includes("TSLAI"))
      assert.strictEqual(recovery.resolved, 1)
      assert.strictEqual(toText(settledMarket.status), "resolved")
      assert.strictEqual(toText(settledMarket.resolved_outcome), "YES")
      assert.isTrue(proofArticleId.length > 0)
      assert.strictEqual(proofArticleRow.is_resolution_proof, true)
      assert.isFalse((toText(proofArticleRow.summary) ?? "").includes("[proof-yes]"))
      assert.isFalse((toText(proofArticleRow.summary) ?? "").includes("[proof-no]"))
      assert.isFalse((toText(settledMarket.resolution_proof) ?? "").includes("[proof-yes]"))
      assert.strictEqual(remainingWorkRows.length, 0)
      assert.isTrue(newMarketPosts.length >= 1)
      assert.isTrue(eventTypes.has("market_resolution"))
      assert.isTrue(eventTypes.has("market_opened"))
      assert.isTrue(orgTick.postsCreated >= 2)
      assert.isNotNull(artTick1.articleId)
      assert.isNotNull(artTick2.articleId)
    })
  })
}), 180_000)
it.live('A provider that stalls mid-body times out within one 25 s deadline and keeps the reservation uncertain (spec/engine/spendBudget.md, "Story: Enforce atomic budget reservations and reconciliation"; spec/engine/spendBudget.md, "Timeouts and worker restarts mark open reservations uncertain without releasing funds")', () => scoped(effect {
  const provider = try acquireRelease(
    tryPromise({ try: () => startStalledProvider(), catch: (cause) => new EngineFailure({ code: "LLM_UNAVAILABLE", message: "stalled provider did not start", cause }) }),
    (stub) => sync(() => stub.close()),
  )
  try withEnvOverrides({ ...OFFLINE_ENGINE_ENV, SURPLUS_BASE_URL: provider.url }, scoped(effect {
    provide localStoreLayer({ kind: "pglite", file: undefined }) {
      try migrateFeedSchema()
      try seedFeedWorld()
      const startedAt = try Clock.currentTimeMillis
      const [completion] = try Effect.all([
        generateCompletion({ user: "Hello", maxTokens: 32 }),
        effect {
          try tryPromise({ try: () => provider.requested, catch: (cause) => new EngineFailure({ code: "LLM_UNAVAILABLE", message: "no request", cause }) })
          try Effect.sleep("15 seconds")
          try sync(() => provider.sendHeadersAndStall())
        },
      ], { concurrency: 2 })
      const elapsedMs = (try Clock.currentTimeMillis) - startedAt
      const finishedBeforeClose = try tryPromise({ try: () => provider.closed, catch: (cause) => new EngineFailure({ code: "LLM_UNAVAILABLE", message: "no close", cause }) })
      const reservation = (try queryRows("SELECT status, actual_micros FROM feed_llm_spend_reservations WHERE attempt_id = $1", [completion.attemptId]))[0]
      try check(() => {
        assert.deepStrictEqual(
          { usedFallback: completion.usedFallback, provider: completion.provider, status: toText(reservation?.status), actualMicros: reservation?.actual_micros ?? null, finishedBeforeClose },
          { usedFallback: true, provider: "offline-fallback", status: "uncertain", actualMicros: null, finishedBeforeClose: false },
        )
        assert.isAtLeast(elapsedMs, 25_000)
        assert.isBelow(elapsedMs, 30_000)
      })
    }
  }))
}), 60_000)

it.effect('Failed live LLM calls the provider never receives settle at zero at once (spec/engine/spendBudget.md, "Story: Enforce atomic budget reservations and reconciliation"; spec/engine/spendBudget.md, "Timeouts and worker restarts mark open reservations uncertain without releasing funds")', () => scoped(effect {
  const day1Ms = Date.UTC(2026, 10, 23, 12, 0, 0)
  const day2Ms = day1Ms + 86_400_000
  try withSeededEngine(day1Ms, effect {
    const completion = try withEnvOverrides({ SURPLUS_BASE_URL: "http://127.0.0.1:1" }, generateCompletion({
      user: "Hello",
      nowMs: day1Ms,
    }))
    const surfaced = try Effect.flip(withEnvOverrides({ SURPLUS_BASE_URL: "http://127.0.0.1:1" }, generateCompletion({
      user: "Hello",
      nowMs: day1Ms,
      allowOfflineFallback: false,
    })))
    const settledZeroRows = try queryRows("SELECT COUNT(*) AS cnt FROM feed_llm_spend_reservations WHERE status = 'settled' AND actual_micros = 0")
    const afterFallback = try getDailySpendStatus(day1Ms)
    const fallbackRows = try queryRows("SELECT status, reserved_micros, actual_micros FROM feed_llm_spend_reservations WHERE attempt_id = $1", [completion.attemptId])
    try TestClock.adjust("1 day")
    const day2AfterFallback = try getDailySpendStatus(day2Ms)
    try check(() => {
      assert.isTrue(completion.usedFallback)
      assert.strictEqual(completion.provider, "offline-fallback")
      assert.strictEqual(completion.actualMicros, 0)
      assert.strictEqual(failureCode(surfaced), "LLM_UNAVAILABLE")
      assert.strictEqual(toInt(settledZeroRows[0]?.cnt), 2)
      assert.strictEqual(afterFallback.confirmedCents, 0)
      assert.strictEqual(afterFallback.reservedCents, 0)
      assert.strictEqual(afterFallback.carryoverReservedCents, 0)
      assert.strictEqual(afterFallback.uncertainReservations, 0)
      assert.strictEqual(afterFallback.activeReservations, 0)
      assert.strictEqual(toText(fallbackRows[0]?.status), "settled")
      assert.strictEqual(toInt(fallbackRows[0]?.reserved_micros), 10_000)
      assert.strictEqual(toInt(fallbackRows[0]?.actual_micros), 0)
      assert.strictEqual(day2AfterFallback.carryoverReservedCents, 0)
      assert.strictEqual(day2AfterFallback.uncertainReservations, 0)
      assert.strictEqual(day2AfterFallback.committedCents, 0)
    })
  })
}))

it.effect('Failed live LLM calls the provider answers stay uncertain until reconciled, even when they fall back (spec/engine/spendBudget.md, "Story: Enforce atomic budget reservations and reconciliation"; spec/engine/spendBudget.md, "Timeouts and worker restarts mark open reservations uncertain without releasing funds")', () => scoped(effect {
  const day1Ms = Date.UTC(2026, 10, 23, 12, 0, 0)
  const day2Ms = day1Ms + 86_400_000
  try withSeededEngine(day1Ms, effect {
    try withStubProvider(500, JSON.stringify({ error: { message: "provider down" } }), effect (baseUrl: string) => {
      const completion = try withEnvOverrides({ SURPLUS_BASE_URL: baseUrl }, generateCompletion({
        user: "Hello",
        nowMs: day1Ms,
      }))
      const afterFallback = try getDailySpendStatus(day1Ms)
      const fallbackRows = try queryRows("SELECT status, reserved_micros, actual_micros FROM feed_llm_spend_reservations WHERE attempt_id = $1", [completion.attemptId])
      try TestClock.adjust("1 day")
      const day2BeforeReconcile = try getDailySpendStatus(day2Ms)
      try confirmLlmSpend({ attemptId: completion.attemptId, actualMicros: 0, nowMs: day2Ms + 1_000 })
      const day2Reconciled = try getDailySpendStatus(day2Ms + 1_000)
      const surfaced = try Effect.flip(withEnvOverrides({ SURPLUS_BASE_URL: baseUrl }, generateCompletion({
        user: "Hello",
        nowMs: day2Ms + 2_000,
        allowOfflineFallback: false,
      })))
      const uncertainRows = try queryRows("SELECT status, reserved_micros, actual_micros FROM feed_llm_spend_reservations WHERE status = 'uncertain'")
      try check(() => {
        assert.isTrue(completion.usedFallback)
        assert.strictEqual(completion.provider, "offline-fallback")
        assert.strictEqual(completion.actualMicros, 0)
        assert.strictEqual(afterFallback.reservedCents, 1)
        assert.strictEqual(afterFallback.uncertainReservations, 1)
        assert.strictEqual(afterFallback.committedCents, 1)
        assert.strictEqual(toText(fallbackRows[0]?.status), "uncertain")
        assert.strictEqual(toInt(fallbackRows[0]?.reserved_micros), 10_000)
        assert.strictEqual(day2BeforeReconcile.carryoverReservedCents, 1)
        assert.strictEqual(day2BeforeReconcile.uncertainReservations, 1)
        assert.strictEqual(day2BeforeReconcile.committedCents, 1)
        assert.strictEqual(day2Reconciled.carryoverReservedCents, 0)
        assert.strictEqual(day2Reconciled.uncertainReservations, 0)
        assert.strictEqual(day2Reconciled.committedCents, 0)
        assert.strictEqual(failureCode(surfaced), "LLM_UNAVAILABLE")
        assert.strictEqual(uncertainRows.length, 1)
        assert.strictEqual(toText(uncertainRows[0]?.status), "uncertain")
        assert.strictEqual(toInt(uncertainRows[0]?.reserved_micros), 10_000)
      })
    })
    try withStubProvider(307, "", effect (redirectUrl: string) => {
      const redirect = try withEnvOverrides({ SURPLUS_BASE_URL: redirectUrl }, generateCompletion({
        user: "Hello",
        nowMs: day2Ms + 3_000,
      }))
      const redirectRows = try queryRows("SELECT status, reserved_micros, actual_micros FROM feed_llm_spend_reservations WHERE attempt_id = $1", [redirect.attemptId])
      try check(() => {
        assert.isTrue(redirect.usedFallback)
        assert.strictEqual(redirect.provider, "offline-fallback")
        assert.strictEqual(redirect.actualMicros, 0)
        assert.strictEqual(toText(redirectRows[0]?.status), "uncertain")
        assert.strictEqual(toInt(redirectRows[0]?.reserved_micros), 10_000)
      })
    }, { location: "http://127.0.0.1:1/v1/chat/completions" })
  })
}))
