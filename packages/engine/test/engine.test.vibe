    try queryRows(
      `INSERT INTO feed_posts (id, author_id, author_kind, content, like_count, repost_count, reply_count, created_at)
       VALUES ($1, $2, 'user', 'Watching $NVDAI and $OPENAGI flow closely today', 0, 0, 0, $3)`,
