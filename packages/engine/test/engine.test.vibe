    const npcPost2 = "npc-alpha-post-2"
    try queryRows(
      `INSERT INTO feed_posts (id, author_id, author_kind, content, like_count, repost_count, reply_count, created_at)
       VALUES ($1, $3, 'npc', 'Compute tape check one', 1, 0, 0, $4),
              ($2, $3, 'npc', 'Compute tape check two', 1, 0, 0, $4)`,
      [npcPost1, npcPost2, actorId, liveNow],
    )
    try queryRows(
      `INSERT INTO feed_post_likes (post_id, account_id, created_at)
       VALUES ($1, $3, $4), ($2, $3, $4)`,
      [npcPost1, npcPost2, humanId, liveNow],
    )
    const eligibleBeforeBlock = try findEligibleAlphaTarget(actorId, liveNow)
    try queryRows("INSERT INTO feed_blocks (blocker_id, blocked_id, created_at) VALUES ($1, $2, $3)", [humanId, actorId, liveNow])
    const eligibleWhileBlocked = try findEligibleAlphaTarget(actorId, liveNow)
    try queryRows("DELETE FROM feed_blocks WHERE blocker_id = $1 AND blocked_id = $2", [humanId, actorId])
    try queryRows(
      `INSERT INTO feed_alpha_invite_cooldowns (actor_id, account_id, decline_count, next_eligible_at, updated_at)
       VALUES ($1, $2, 1, $3, $4)`,
      [actorId, humanId, liveNow + 60_000, liveNow],
