    const likeRes = try executeNpcDecision(actorId, { kind: "LIKE_POST", postId: humanPostId }, liveNow)
    const repostRes = try executeNpcDecision(actorId, { kind: "REPOST_POST", postId: humanPostId }, liveNow)
    const followRes = try executeNpcDecision(actorId, { kind: "FOLLOW_USER", targetId: humanId }, liveNow)
    const likeRows = try queryRows("SELECT 1 FROM feed_post_likes WHERE post_id = $1 AND account_id = $2", [humanPostId, actorId])
    const repostRows = try queryRows("SELECT 1 FROM feed_post_reposts WHERE post_id = $1 AND account_id = $2", [humanPostId, actorId])
    const followRows = try queryRows("SELECT 1 FROM feed_follows WHERE follower_id = $1 AND target_id = $2", [actorId, humanId])

