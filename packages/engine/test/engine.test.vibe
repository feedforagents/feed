      actorId,
      { kind: "SELL_PREDICTION", marketId: "seed-market-1", side: "yes", shares: Math.min(boughtPred.shares, 500) },
      liveNow,
    )
    const openedPerp = try openPerpPosition({
      ownerId: actorId,
      ownerKind: "npc",
      ticker: "NVDAI",
      side: "long",
