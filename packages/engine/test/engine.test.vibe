})

it.effect('An exhausted LLM budget defers clues without failing the markets tick, so price snapshots still record (spec/engine/narrativeArc.md, "Story: Advance rolling arcs and publish phase-aware clues"; spec/engine/narrativeArc.md, "Story: Prepare private proofs and settle expired markets safely"; spec/engine/spendBudget.md, "Story: Enforce atomic budget reservations and reconciliation")', () => scoped(effect {
  const liveNow = try TestClock.withLive(Clock.currentTimeMillis)
  try withSeededEngine(liveNow, effect {
    const spent = try reserveLlmBudget({ attemptId: "exhaust-budget", estimatedMicros: 100_000_000, provider: "openai", model: "gpt-4o-mini", nowMs: liveNow })
    try confirmLlmSpend({ attemptId: spent.attemptId, actualMicros: 100_000_000, nowMs: liveNow })
    const tick = try runMarketsTick(liveNow)
    const clueRows = try queryRows("SELECT clue_key FROM feed_npc_market_clues")
    const snapshotRows = try queryRows("SELECT market_kind FROM feed_market_price_history WHERE recorded_at = $1", [liveNow])
    const health = (try queryRows("SELECT last_status FROM feed_tick_health WHERE job_name = 'markets-tick'"))[0] ?? {}
    try check(() => {
      assert.deepStrictEqual(
        [tick.skipped, tick.cluesPublished, clueRows.length, toText(health.last_status)],
        [false, 0, 0, "ok"],
      )
      assert.isTrue(snapshotRows.some((r) => toText(r.market_kind) === "prediction"))
    })
  })
}))

it.effect('RSS refresh ingests unseen headlines when five minute indices have passed (spec/engine/worldClock.md, "RSS ingestion and parody generation have one scheduled owner at 5-minute cadence")', () => scoped(effect {
  const firstMs = Date.UTC(2026, 10, 27, 10, 0, 30)
  const headlines = Array.from({ length: 7 }, (_, i) => `Cadence headline ${i + 1}`)
  const items = headlines.map((title) => `<item><title>${title}</title></item>`).join("")
  const xml = `<?xml version="1.0"?><rss version="2.0"><channel>${items}</channel></rss>`
  try withSeededEngine(firstMs, effect {
    try withStubProvider(200, xml, effect (baseUrl: string) => {
      const runAt = (nowMs: number) => withEnvOverrides({ FEED_RSS_URLS: `${baseUrl}/rss.xml` }, runRssRefreshTick(nowMs))
      const first = try runAt(firstMs)
      const fourMinutesLater = try runAt(Date.UTC(2026, 10, 27, 10, 4, 59))
      const fiveMinutesLater = try runAt(Date.UTC(2026, 10, 27, 10, 5, 0))
      const health = (try queryRows("SELECT last_success_at FROM feed_tick_health WHERE job_name = 'rss-refresh'"))[0] ?? {}
      const stored = try queryRows("SELECT title FROM feed_rss_headlines WHERE title = ANY($1::text[]) ORDER BY title", [headlines])
      try check(() => {
        assert.deepStrictEqual(
          [first, fourMinutesLater, fiveMinutesLater],
          [
            { skipped: false, fetchedCount: 7, insertedCount: 6 },
            { skipped: true, fetchedCount: 0, insertedCount: 0 },
            { skipped: false, fetchedCount: 7, insertedCount: 1 },
          ],
        )
        assert.deepStrictEqual(stored.map((row) => toText(row.title)), headlines)
        assert.strictEqual(toInt(health.last_success_at), Date.UTC(2026, 10, 27, 10, 5, 0))
      })
    })
  })
}))

it.effect('NPCs execute full trading and social actions, alpha invites honor blocks and cooldowns, and atomic settlement publishes clean proof articles and NEW MARKET posts (spec/engine/npcLoop.md, "Story: Drive NPC spot markets, social posts, and alpha-group invites within D-25 bounds"; spec/engine/narrativeArc.md, "Story: Advance rolling arcs and publish phase-aware clues"; spec/engine/narrativeArc.md, "Story: Prepare private proofs and settle expired markets safely"; spec/engine/worldClock.md, "Story: Schedule core world jobs and exclude retired routes")', () => scoped(effect {
  const liveNow = try TestClock.withLive(Clock.currentTimeMillis)
  try withSeededEngine(liveNow, effect {
    const actorId = "sam-ailtman"
    const humanId = "alpha-tester-user"
    try queryRows(
      `INSERT INTO feed_accounts (account_id, handle, display_name, balance_cents, starting_grant_cents, created_at, updated_at)
       VALUES ($1, $2, $3, 10000, 10000, $4, $4)`,
      [humanId, "alphatester", "Alpha Tester", liveNow],
    )
