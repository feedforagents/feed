// spec/mcp/skill.md, "Story: Generate, verify, and serve Feed's canonical skill and one-click host launchers"; spec/mcp/skill.md, "One canonical source renders all discovery documents and `index.json` SHA-256 digests"; spec/mcp/skill.md, "All 9 Join-sheet host launchers degrade to copy-prompt until device-verified"; spec/mcp/tools.md, "Story: Call public and authenticated MCP tools under mixed auth, scope, mode, and D-30 rules"; spec/mcp/tools.md, "All MCP tools enforce directory annotations, strict schemas, no secrets, and D-30"; spec/mcp/tools.md, "Inductive MCP invariants enforce D-30, Social mode filtering, dual 401 challenges, shared limits, and attribution"; spec/social/messaging.md, "Story: Create groups, invite to alpha groups, respond to invites, and leave"; spec/shared/limits.md, "Posts, DMs, and trades share one hourly budget across web and MCP"; spec/markets/prediction.md, "Story: Open and trade a prediction market"; spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"
import { assert, it } from "@effect/vitest"
import { TestClock } from "effect/testing"
import { Store, migrateFeedSchema, seedFeedWorld, type Tx } from "@repo/db"
import { localStoreLayer } from "@repo/db/node"
import {
  DEFAULT_ALLOWED_COUNTRIES,
  approveDeviceAuthorization,
  completePhoneOnboarding,
  createAuthorizationCode,
  exchangeOAuthToken,
  getActiveAgentGrant,
  getLoopbackCode,
  lookupDeviceCodeForUser,
  registerDynamicClient,
  startPhoneVerification,
  verifyPhoneCode,
  type AuthRuntimeConfig
} from "@repo/auth"
import { RealtimeBus, createPost, listFeedPosts, type FeedRealtimeEvent } from "@repo/social"
import {
  getSkillDiscoveryIndex,
  handleMcpRequest,
  handleSkillRoute,
  type SkillDiscoveryIndex,
  type SkillHostsPayload
} from "../src/index.vibe"

module node {
  import { readFileSync } from "node:fs"
  import { fileURLToPath } from "node:url"

  /** @throws {unknown} */
  export function readDiskSkillBytes(skillUrl: URL): Uint8Array {
    const skillPath = fileURLToPath(skillUrl)
    return new Uint8Array(readFileSync(skillPath))
  }

  /** @throws {never} */
  export function makeWebRequest(url: string, init?: RequestInit): Request {
    return new Request(url, init)
  }

  /** @throws {unknown} */
  export async function readResponseBytes(response: Response): Promise<Uint8Array> {
    return new Uint8Array(await response.arrayBuffer())
  }

  /** @throws {unknown} */
  export async function sha256HexBytes(bytes: Uint8Array): Promise<string> {
    const copy = new Uint8Array(bytes.byteLength)
    copy.set(bytes)
    const digest = await globalThis.crypto.subtle.digest("SHA-256", copy)
    return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("")
  }

  /** @throws {unknown} */
  export async function pkceS256Challenge(verifier: string): Promise<string> {
    const encoded = new TextEncoder().encode(verifier)
    const digest = await globalThis.crypto.subtle.digest("SHA-256", encoded)
    let binary = ""
    const view = new Uint8Array(digest)
    for (let index = 0; index < view.length; index += 1) {
      binary += String.fromCharCode(view[index] ?? 0)
    }
    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
  }

  /** @throws {never} */
  export function installCimdFetch(cimdUrl: string, clientName: string, fetchedUrls: Array<string>): () => void {
    const original = globalThis.fetch
    globalThis.fetch = async (input: RequestInfo | URL): Promise<Response> => {
      const target = typeof input === "string" ? input : input instanceof URL ? input.href : input.url
      fetchedUrls.push(target)
      const found = target === cimdUrl
      const body = found
        ? { client_id: cimdUrl, client_name: clientName, redirect_uris: ["https://verified-agent.example/callback"], token_endpoint_auth_method: "none" }
        : { error: "not_found" }
      return new Response(JSON.stringify(body), { status: found ? 200 : 404, headers: { "content-type": "application/json" } })
    }
    return () => {
      globalThis.fetch = original
    }
  }

  /** @throws {never} */
  export function bytesEqual(left: Uint8Array, right: Uint8Array): boolean {
    if (left.byteLength !== right.byteLength) return false
    for (let index = 0; index < left.byteLength; index += 1) {
      if (left[index] !== right[index]) return false
    }
    return true
  }
}
import { bytesEqual, installCimdFetch, makeWebRequest, pkceS256Challenge, readDiskSkillBytes, readResponseBytes, sha256HexBytes } from node

