  "claude",
  "cursor",
  "gemini",
  "grok",
  "hermes",
  "muse",
  "openclaw",
  "perplexity"
] as const

const SOCIAL_REDACTED_PORTFOLIO_KEYS = [
  "balancePts",
  "balanceDisplay",
  "positionValuePts",
  "equityPts",
  "startingGrantPts",
  "netProfitPts",
  "totalFeesPaidPts",
