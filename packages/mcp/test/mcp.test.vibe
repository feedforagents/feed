)

it.effect('MCP perp idempotencyKey replay/conflict for open_perp and close_perp (spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/mcp/tools.md, "Inductive MCP invariants enforce D-30, Social mode filtering, dual 401 challenges, shared limits, and attribution")', () => withSeededWorld(effect (authConfig) => {
  const alice = try onboardPhoneUser("+14155550211", "alice_perp_idem", "Alice Perp Idem", authConfig)
  const aliceToken = (try connectOAuthGrant({
    accountId: alice.account.accountId,
    clientName: "Perp Idem Agent",
    redirectUri: "http://127.0.0.1:4103/callback",
    scope: "read social:write messages trade",
    state: "state_perp_idem",
    verifier: "pkce_verifier_perp_idem_0123456789abcdef0123456789",
    authConfig
  })).access_token

  const marketsPayload = unwrapToolPayload(try callMcpTool(201, "list_markets", { kind: "perp", limit: 5 }, authConfig))
  const firstPerp = ((marketsPayload.perpMarkets ?? []) as ReadonlyArray<{ readonly ticker: string }>)[0]
  const ticker = firstPerp?.ticker ?? ""

  const openFirst = unwrapToolPayload(try callMcpTool(
    202,
    "open_perp",
    { ticker, side: "long", collateralPts: 5, leverage: 3, idempotencyKey: "mcp-perp-open-1" },
    authConfig,
    aliceToken
  ))
  const openReplay = unwrapToolPayload(try callMcpTool(
    203,
    "open_perp",
    { ticker, side: "long", collateralPts: 5, leverage: 3, idempotencyKey: "mcp-perp-open-1" },
    authConfig,
    aliceToken
  ))
  const openConflictErr = unwrapToolError(try callMcpTool(
    204,
    "open_perp",
    { ticker, side: "long", collateralPts: 6, leverage: 3, idempotencyKey: "mcp-perp-open-1" },
    authConfig,
    aliceToken
  ))
  const positionId = String(openFirst.positionId ?? "")
  const closeFirst = unwrapToolPayload(try callMcpTool(
    205,
    "close_perp",
    { positionId, idempotencyKey: "mcp-perp-close-1" },
    authConfig,
    aliceToken
  ))
  const closeReplay = unwrapToolPayload(try callMcpTool(
    206,
    "close_perp",
    { positionId, idempotencyKey: "mcp-perp-close-1" },
    authConfig,
    aliceToken
  ))
  const openSecond = unwrapToolPayload(try callMcpTool(
    207,
    "open_perp",
    { ticker, side: "long", collateralPts: 5, leverage: 3, idempotencyKey: "mcp-perp-open-2" },
    authConfig,
    aliceToken
  ))
  const positionId2 = String(openSecond.positionId ?? "")
  const closeConflictErr = unwrapToolError(try callMcpTool(
    208,
    "close_perp",
    { positionId: positionId2, idempotencyKey: "mcp-perp-close-1" },
    authConfig,
    aliceToken
  ))

  try check(() => {
    assert.notStrictEqual(ticker, "")
    assert.strictEqual(openReplay.tradeId, openFirst.tradeId)
    assert.strictEqual(openReplay.positionId, openFirst.positionId)
    assert.strictEqual(openReplay.balanceAfterPts, openFirst.balanceAfterPts)
    assert.strictEqual(openConflictErr.error, "idempotency_conflict")
    assert.strictEqual(openConflictErr.code, "IDEMPOTENCY_CONFLICT")
    assert.strictEqual(closeFirst.positionId, positionId)
    assert.strictEqual(closeReplay.tradeId, closeFirst.tradeId)
    assert.strictEqual(closeReplay.balanceAfterPts, closeFirst.balanceAfterPts)
    assert.strictEqual(closeConflictErr.error, "idempotency_conflict")
    assert.strictEqual(closeConflictErr.code, "IDEMPOTENCY_CONFLICT")
  })
}))

const setupPerpTrader = effect (
  authConfig: AuthRuntimeConfig,
  phone: string,
  handle: string,
  displayName: string,
  slug: string,
  rpcId: number
) => {
  const user = try onboardPhoneUser(phone, handle, displayName, authConfig)
  const token = (try connectOAuthGrant({
    accountId: user.account.accountId,
    clientName: `${displayName} Agent`,
    redirectUri: "http://127.0.0.1:4104/callback",
    scope: "read social:write messages trade",
    state: `state_${slug}`,
    verifier: `pkce_verifier_${slug}_0123456789abcdef0123456789`,
    authConfig
  })).access_token
  const marketsPayload = unwrapToolPayload(try callMcpTool(rpcId, "list_markets", { kind: "perp", limit: 5 }, authConfig))
  const firstPerp = ((marketsPayload.perpMarkets ?? []) as ReadonlyArray<{ readonly ticker: string }>)[0]
  return { token, ticker: firstPerp?.ticker ?? "" }
}

it.effect('MCP open_perp with mode flip closes the long and opens a short, and an opposite-side close reports the closed side (spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/mcp/tools.md, "Story: Call public and authenticated MCP tools under mixed auth, scope, mode, and D-30 rules")', () => withSeededWorld(effect (authConfig) => {
  const { token: aliceToken, ticker } = try setupPerpTrader(
    authConfig,
    "+14155550212",
    "alice_perp_flip",
    "Alice Perp Flip",
    "perp_flip",
    301
  )
  const previewFreshShort = unwrapToolPayload(try callMcpTool(
    302,
    "preview_perp",
    { ticker, side: "short", collateralPts: 5, leverage: 3 },
    authConfig,
    aliceToken
  ))
  const openedLong = unwrapToolPayload(try callMcpTool(
    303,
    "open_perp",
    { ticker, side: "long", collateralPts: 10, leverage: 3 },
    authConfig,
    aliceToken
  ))
  const longPositionId = String(openedLong.positionId ?? "")
  const previewReduce = unwrapToolPayload(try callMcpTool(
    304,
    "preview_perp",
    { ticker, side: "short", collateralPts: 5, leverage: 3 },
    authConfig,
    aliceToken
  ))
  const previewFlip = unwrapToolPayload(try callMcpTool(
    305,
    "preview_perp",
    { ticker, side: "short", collateralPts: 5, leverage: 3, mode: "flip" },
    authConfig,
    aliceToken
  ))
  const flipped = unwrapToolPayload(try callMcpTool(
    306,
    "open_perp",
    { ticker, side: "short", collateralPts: 5, leverage: 3, mode: "flip" },
    authConfig,
    aliceToken
  ))
  const publishedEvents: FeedRealtimeEvent[] = []
  const closedShort = unwrapToolPayload(try callMcpToolCapturingEvents(
    publishedEvents,
    307,
    "open_perp",
    { ticker, side: "long", collateralPts: 5, leverage: 3 },
    authConfig,
    aliceToken
  ))
  const portfolioAfterClose = unwrapToolPayload(try callMcpTool(308, "get_portfolio", {}, authConfig, aliceToken))
  const flipFeeCents = Math.round(Number(flipped.feePts) * 100)
  const openFeeCents = Math.round(Number(openedLong.feePts) * 100)
  const freshShortFeeCents = Math.round(Number(previewFreshShort.estimatedFeePts) * 100)
  try check(() => {
    assert.deepStrictEqual(portfolioAfterClose.perpPositions, [])
    assert.deepStrictEqual(
      { action: closedShort.action, closedPositionId: closedShort.closedPositionId, ticker: closedShort.ticker, side: closedShort.side },
      { action: "close", closedPositionId: flipped.positionId, ticker, side: "short" }
    )
    assert.deepStrictEqual(
      publishedEvents.map((ev) => ev.type === "market.perp" ? [ev.action, ev.positionId, ev.ticker, ev.side, ev.sizeCents] : [ev.type]),
      [["close", flipped.positionId, ticker, "short", 1500]]
    )
    assert.notStrictEqual(ticker, "")
    assert.strictEqual(previewFreshShort.action, "open")
    assert.strictEqual(openedLong.action, "open")
    assert.strictEqual(openedLong.side, "long")
    assert.strictEqual(openedLong.sizePts, 30)
    assert.strictEqual(previewReduce.action, "reduce")
    assert.strictEqual(previewFlip.action, "flip")
    assert.strictEqual(flipped.action, "flip")
    assert.strictEqual(flipped.side, "short")
    assert.strictEqual(flipped.sizePts, 15)
    assert.strictEqual(flipped.collateralPts, 5)
    assert.strictEqual(flipped.leverage, 3)
    assert.notStrictEqual(flipped.positionId, longPositionId)
    assert.strictEqual(flipped.closedPositionId, longPositionId)
    assert.strictEqual(flipped.feePts, previewFlip.estimatedFeePts)
    assert.strictEqual(flipFeeCents, openFeeCents + freshShortFeeCents)
  })
}))

it.effect('MCP close_perp rejects sizeCents together with closePct (spec/markets/spotPerp.md, "Story: Open and close perpetuals up to 20x leverage"; spec/mcp/tools.md, "Story: Call public and authenticated MCP tools under mixed auth, scope, mode, and D-30 rules")', () =>
  withSeededWorld(effect (authConfig) => {
    const { token: aliceToken, ticker } = try setupPerpTrader(
      authConfig,
      "+14155550221",
      "alice_close_conflict",
      "Alice Close Conflict",
      "close_conflict",
      201
    )
    const openedPerp = unwrapToolPayload(try callMcpTool(
      202,
      "open_perp",
      { ticker, side: "long", collateralPts: 10, leverage: 3 },
      authConfig,
      aliceToken
    ))
    const positionId = String(openedPerp.positionId ?? "")
    const conflictRes = try callMcpTool(
      203,
      "close_perp",
      { positionId, sizeCents: 2000, closePct: 50 },
      authConfig,
      aliceToken
    )
    try check(() => {
      assert.notStrictEqual(ticker, "")
      assert.notStrictEqual(positionId, "")
      assert.strictEqual(conflictRes.status, 400)
      assert.strictEqual((conflictRes.body.error as { readonly code?: number } | undefined)?.code, -32602)
      assert.strictEqual((conflictRes.body.error as { readonly message?: string } | undefined)?.message, "provide only one of sizeCents/sizePts/closePct")
    })
  })
)
