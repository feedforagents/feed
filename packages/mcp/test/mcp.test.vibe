    const searchRes = try callMcpTool(201, "search", { query: "Quibberton", kind: "articles", limit: 10 }, authConfig)
    const searchPayload = unwrapToolPayload(searchRes)
    const articles = (searchPayload.articles ?? []) as ReadonlyArray<{ readonly id: string }>
    try check(() => {
