    const portfolioAfterBuy = unwrapToolPayload(try callMcpTool(1171, "get_portfolio", {}, authConfig, aliceToken))
    const sellFirst = unwrapToolPayload(try callMcpTool(
      118,
      "sell_prediction",
      { marketId: "seed-market-1", side: "yes", shares: 1.5, idempotencyKey: "mcp-sell-idem-1" },
      authConfig,
      aliceToken
    ))
    const sellReplay = unwrapToolPayload(try callMcpTool(
      119,
      "sell_prediction",
      { marketId: "seed-market-1", side: "yes", shares: 1.5, idempotencyKey: "mcp-sell-idem-1" },
