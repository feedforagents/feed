      aliceToken
    ))

    const marketsPayload = unwrapToolPayload(try callMcpTool(120, "list_markets", { kind: "perp", limit: 5 }, authConfig))
    const firstPerp = ((marketsPayload.perpMarkets ?? []) as ReadonlyArray<{ readonly ticker: string }>)[0]
    const ticker = firstPerp?.ticker ?? ""
    const previewTooSmallErr = unwrapToolError(try callMcpTool(
      121,
      "preview_perp",
      { ticker, side: "long", collateralPts: 2, leverage: 2 },
      authConfig,
      aliceToken
    ))
    const previewValid = unwrapToolPayload(try callMcpTool(
      122,
      "preview_perp",
      { ticker, side: "long", collateralPts: 10, leverage: 3 },
      authConfig,
      aliceToken
    ))
    const openedPerp = unwrapToolPayload(try callMcpTool(
      123,
      "open_perp",
      { ticker, side: "long", collateralPts: 10, leverage: 3, maxSlippageBps: 500 },
      authConfig,
      aliceToken
    ))
    const previewRebalance = unwrapToolPayload(try callMcpTool(
      124,
      "preview_perp",
      { ticker, side: "short", collateralPts: 5, leverage: 2 },
      authConfig,
      aliceToken
    ))
    const positionId = String(openedPerp.positionId ?? "")
    const partialClosedPerp = unwrapToolPayload(try callMcpTool(
      1241,
      "close_perp",
      { positionId, closePct: 50, maxSlippageBps: 500 },
      authConfig,
      aliceToken
    ))
    const closedPerp = unwrapToolPayload(try callMcpTool(
      125,
      "close_perp",
      { positionId },
      authConfig,
      aliceToken
    ))
    const perpMarketDetail = unwrapToolPayload(try callMcpTool(
      1251,
      "get_market",
      { marketId: ticker, kind: "perp", tradesLimit: 10, historyLimit: 20 },
      authConfig,
      aliceToken
    ))
    const playersByVolume = unwrapToolPayload(try callMcpTool(
      1252,
      "get_leaderboard",
      { scope: "players", metric: "volume", page: 1, pageSize: 1 },
      authConfig,
      aliceToken
    ))
    const playersPage2 = unwrapToolPayload(try callMcpTool(
      1253,
      "get_leaderboard",
      { scope: "players", metric: "net_profit", page: 2, pageSize: 1 },
      authConfig,
      aliceToken
    ))
    const charactersBoard = unwrapToolPayload(try callMcpTool(
      1254,
      "get_leaderboard",
      { scope: "characters", metric: "net_profit", page: 1, pageSize: 5 },
      authConfig
    ))
    const previewFractionalLeverage = try callMcpTool(
      126,
      "preview_perp",
      { ticker, side: "long", collateralPts: 5, leverage: 2.5 },
      authConfig,
      aliceToken
    )
    const openFractionalLeverage = try callMcpTool(
      127,
      "open_perp",
      { ticker, side: "long", collateralPts: 5, leverage: 2.5 },
      authConfig,
      aliceToken
    )
    const whoamiAfterTrades = unwrapToolPayload(try callMcpTool(128, "whoami", {}, authConfig, aliceToken))

    try check(() => {
      assert.strictEqual(invitedBob.status, "pending")
      assert.strictEqual(invitedBob.added, false)
      assert.isString(invitedBob.inviteId)
      assert.strictEqual(invitedBob.handle, "bob_parity")
      assert.strictEqual(invitedBob.memberId, bob.account.accountId)
      const pendingInvites = (bobInvites.invites ?? []) as ReadonlyArray<{ readonly id: string; readonly chatKind: string }>
      assert.strictEqual(pendingInvites.some((inv) => inv.id === invitedBob.inviteId && inv.chatKind === "user_group"), true)
      const acceptedInvite = bobAcceptedInvite.invite as { readonly status?: string } | undefined
      assert.strictEqual(acceptedInvite?.status, "accepted")
      assert.strictEqual(ownerLeaveErr.error, "Forbidden")
      assert.strictEqual(memberLeft.left, true)
      const blockedHandles = ((aliceBlocks.items ?? []) as ReadonlyArray<{ readonly handle: string }>).map((entry) => entry.handle)
      assert.include(blockedHandles, "charlie_parity")
      const mutedHandles = ((aliceMutes.items ?? []) as ReadonlyArray<{ readonly handle: string }>).map((entry) => entry.handle)
      assert.include(mutedHandles, "bob_parity")
      assert.deepStrictEqual(aliceMutesAfter.items, [])
      assert.strictEqual(inviteBlockedErr.error, "Blocked")
      const followingIds = ((bobFollowingSeenByAlice.items ?? []) as ReadonlyArray<{ readonly id: string }>).map((i) => i.id)
      assert.include(followingIds, alice.account.accountId)
      assert.notInclude(followingIds, charlie.account.accountId)
      assert.strictEqual(reactAdded.added, true)
      assert.strictEqual(reactAdded.emoji, "🔥")
      assert.strictEqual(reactRemoved.added, false)

      const limitsBefore = whoamiBefore.rateLimits as Readonly<Record<string, { readonly used: number }>>
      const limitsAfterSocial = whoamiAfterSocial.rateLimits as Readonly<Record<string, { readonly used: number }>>
      const limitsAfterTrades = whoamiAfterTrades.rateLimits as Readonly<Record<string, { readonly used: number }>>
      assert.strictEqual(limitsBefore.post?.used, 0)
      assert.strictEqual(limitsBefore.dm?.used, 0)
      assert.strictEqual(limitsBefore.trade?.used, 0)
      assert.strictEqual(limitsAfterSocial.post?.used, 1)
      assert.strictEqual(limitsAfterSocial.dm?.used, 2)
      assert.strictEqual(limitsAfterSocial.trade?.used, 0)
      assert.strictEqual(limitsAfterTrades.trade?.used, 9)

      assert.strictEqual(buyReplay.tradeId, buyFirst.tradeId)
      assert.strictEqual(buyReplay.shares, buyFirst.shares)
      assert.strictEqual(buyReplay.shareUnits, buyFirst.shareUnits)
      assert.strictEqual(buyFirst.shares, Math.round(Number(buyFirst.shareUnits)) / 100)
      assert.isAbove(Number(buyFirst.shares), 5)
      assert.isBelow(Number(buyFirst.shares), 15)
      assert.strictEqual(buyReplay.balanceAfterPts, 95)
      const portPreds = (portfolioAfterBuy.predictionPositions ?? []) as ReadonlyArray<{
        readonly marketId: string
        readonly shares: number
        readonly shareUnits: number
      }>
      assert.strictEqual(portPreds[0]?.shares, buyFirst.shares)
      assert.strictEqual(portPreds[0]?.shareUnits, buyFirst.shareUnits)
      assert.strictEqual(buyConflictErr.error, "idempotency_conflict")
      assert.strictEqual(buyConflictErr.code, "IDEMPOTENCY_CONFLICT")
      assert.strictEqual(sellFirst.shares, 1.5)
      assert.strictEqual(sellFirst.shareUnits, 150)
      assert.strictEqual(sellReplay.tradeId, sellFirst.tradeId)
      assert.strictEqual(sellReplay.shares, 1.5)
      assert.strictEqual(sellReplay.shareUnits, 150)
      assert.strictEqual(sellReplay.balanceAfterPts, sellFirst.balanceAfterPts)
      assert.strictEqual(sellByUnits.shares, 1)
      assert.strictEqual(sellByUnits.shareUnits, 100)

      const predTrades = (predMarketDetail.recentTrades ?? []) as ReadonlyArray<{
        readonly shares?: number
        readonly shareUnits?: number
      }>
      assert.isAtLeast(predTrades.length, 3)
      assert.strictEqual(predTrades.some((t) => t.shares === 1.5 && t.shareUnits === 150), true)
      assert.strictEqual(predTrades.some((t) => t.shares === 1 && t.shareUnits === 100), true)
      assert.isAbove(((predMarketDetail.priceHistory ?? []) as ReadonlyArray<unknown>).length, 0)

      assert.notStrictEqual(ticker, "")
      assert.strictEqual(previewTooSmallErr.error, "ORDER_TOO_SMALL")
      assert.strictEqual(previewValid.previewOnly, true)
      assert.strictEqual(previewValid.action, "open")
      assert.strictEqual(openedPerp.action, "open")
      assert.strictEqual(openedPerp.liquidationPricePts, previewValid.estimatedLiquidationPricePts)
      assert.strictEqual(previewRebalance.previewOnly, true)
      assert.strictEqual(previewRebalance.action, "reduce")
      assert.strictEqual(partialClosedPerp.positionId, positionId)
      assert.strictEqual(partialClosedPerp.isFullClose, false)
      assert.strictEqual(partialClosedPerp.sizePts, 15)
      assert.strictEqual(partialClosedPerp.remainingSizePts, 15)
      assert.strictEqual(partialClosedPerp.remainingSizeCents, 1500)
      assert.strictEqual(closedPerp.positionId, positionId)
      assert.strictEqual(closedPerp.isFullClose, true)
      assert.strictEqual(closedPerp.sizePts, 15)
      assert.strictEqual(closedPerp.remainingSizePts, 0)
      assert.isAtLeast(((perpMarketDetail.recentTrades ?? []) as ReadonlyArray<unknown>).length, 3)
      assert.isAbove(((perpMarketDetail.priceHistory ?? []) as ReadonlyArray<unknown>).length, 0)

      assert.strictEqual(playersByVolume.scope, "players")
      assert.strictEqual(playersByVolume.metric, "volume")
      assert.strictEqual(playersByVolume.page, 1)
      assert.strictEqual(playersByVolume.pageSize, 1)
      assert.isAtLeast(Number(playersByVolume.totalCount), 3)
      assert.isAtLeast(Number(playersByVolume.totalPages), 3)
      assert.strictEqual(/purchased/i.test(String(playersByVolume.rankingRule ?? "")), false)
      const volumeEntries = (playersByVolume.entries ?? []) as ReadonlyArray<{
        readonly handle: string
        readonly returnPct: number
        readonly winRatePct: number
      }>
      assert.strictEqual(volumeEntries.length, 1)
      assert.strictEqual(volumeEntries[0]?.handle, "alice_parity")
      assert.isNumber(volumeEntries[0]?.returnPct)
      assert.isNumber(volumeEntries[0]?.winRatePct)
      const volumeCurrent = playersByVolume.currentUser as { readonly handle?: string; readonly rank?: number } | null
      assert.strictEqual(volumeCurrent?.handle, "alice_parity")
      assert.strictEqual(volumeCurrent?.rank, 1)

      assert.strictEqual(playersPage2.page, 2)
      assert.strictEqual(((playersPage2.entries ?? []) as ReadonlyArray<unknown>).length, 1)
      const page2Current = playersPage2.currentUser as { readonly accountId?: string } | null
      assert.strictEqual(page2Current?.accountId, alice.account.accountId)

      assert.strictEqual(charactersBoard.scope, "characters")
      assert.isAbove(Number(charactersBoard.totalCount), 0)
      const charEntries = (charactersBoard.entries ?? []) as ReadonlyArray<{ readonly isNpc: boolean }>
      assert.isAbove(charEntries.length, 0)
      assert.strictEqual(charEntries[0]?.isNpc, true)
      assert.strictEqual(previewFractionalLeverage.status, 400)
      assert.strictEqual((previewFractionalLeverage.body.error as { readonly code?: number } | undefined)?.code, -32602)
      assert.strictEqual(openFractionalLeverage.status, 400)
      assert.strictEqual((openFractionalLeverage.body.error as { readonly code?: number } | undefined)?.code, -32602)

      const perpEvents = publishedEvents.filter(
        (ev): ev is Extract<FeedRealtimeEvent, { readonly type: "market.perp" }> => ev.type === "market.perp"
      )
      assert.strictEqual(perpEvents.length, 3)
      assert.deepStrictEqual(
        {
          action: perpEvents[0]?.action,
          actorId: perpEvents[0]?.actorId,
          ticker: perpEvents[0]?.ticker,
          side: perpEvents[0]?.side,
          sizeCents: perpEvents[0]?.sizeCents,
          leverage: perpEvents[0]?.leverage,
          positionId: perpEvents[0]?.positionId
        },
        {
          action: "open",
          actorId: alice.account.accountId,
          ticker,
          side: "long",
          sizeCents: 3000,
          leverage: 3,
          positionId
        }
      )
      assert.isNumber(perpEvents[0]?.markPriceCents)
      assert.deepStrictEqual(
        {
          action: perpEvents[1]?.action,
          actorId: perpEvents[1]?.actorId,
          ticker: perpEvents[1]?.ticker,
          side: perpEvents[1]?.side,
          sizeCents: perpEvents[1]?.sizeCents,
          leverage: perpEvents[1]?.leverage,
          positionId: perpEvents[1]?.positionId
        },
        {
          action: "close",
          actorId: alice.account.accountId,
          ticker,
          side: "long",
          sizeCents: 1500,
          leverage: 3,
          positionId
        }
      )
      assert.isNumber(perpEvents[1]?.markPriceCents)
      assert.deepStrictEqual(
        {
          action: perpEvents[2]?.action,
          actorId: perpEvents[2]?.actorId,
          ticker: perpEvents[2]?.ticker,
          side: perpEvents[2]?.side,
          sizeCents: perpEvents[2]?.sizeCents,
          leverage: perpEvents[2]?.leverage,
          positionId: perpEvents[2]?.positionId
        },
        {
          action: "close",
          actorId: alice.account.accountId,
          ticker,
          side: "long",
          sizeCents: 1500,
          leverage: 3,
          positionId
        }
      )
      assert.isNumber(perpEvents[2]?.markPriceCents)
    })
  }
}))

it.effect('MCP start_sign_in enforces the same 30/hr per-IP device-code budget as the web route (spec/auth/oauth.md, "Story: Authorize headless agents through RFC 8628 device flow at `/link`"; spec/shared/limits.md, "Posts, DMs, and trades share one hourly budget across web and MCP")', () => withSeededWorld(effect (authConfig) => {
  const limitedIp = { "cf-connecting-ip": "203.0.113.99" }
  const limitedOutcomes: Array<string> = []
  for (let i = 0; i < 31; i += 1) {
    const res = try callMcpTool(i + 1, "start_sign_in", { clientName: "Rate Limit Probe" }, authConfig, undefined, limitedIp)
    limitedOutcomes.push(isRateLimitedToolResult(res) ? "rate_limited" : "ok")
  }
  const unlimitedOutcomes: Array<string> = []
  for (let i = 0; i < 31; i += 1) {
    const res = try callMcpTool(100 + i, "start_sign_in", { clientName: "No IP Probe" }, authConfig)
    unlimitedOutcomes.push(isRateLimitedToolResult(res) ? "rate_limited" : "ok")
  }
  try check(() => assert.deepStrictEqual(
    {
      firstThirtyLimitedOk: limitedOutcomes.slice(0, 30).every((outcome) => outcome === "ok"),
      thirtyFirstLimited: limitedOutcomes[30],
      unlimitedAllOk: unlimitedOutcomes.every((outcome) => outcome === "ok")
    },
    { firstThirtyLimitedOk: true, thirtyFirstLimited: "rate_limited", unlimitedAllOk: true }
  ))
}))

it.effect('MCP start_sign_in shows the verified CIMD client_name at /link, not the caller clientName (spec/auth/oauth.md, "Clients register via CIMD or DCR for hosted callbacks or RFC 8252 loopback redirects only"; spec/auth/oauth.md, "Story: Authorize headless agents through RFC 8628 device flow at `/link`")', () => scoped(effect {
  const cimdUrl = "https://verified-agent.example/oauth/client.json"
  const unownedUrl = "https://unowned-agent.example/oauth/client.json"
  const fetchedUrls: Array<string> = []
  try acquireRelease(
    sync(() => installCimdFetch(cimdUrl, "Verified Example Agent", fetchedUrls)),
    (restore) => sync(restore)
  )
  try withSeededWorld(effect (authConfig) => {
    const unowned = try callMcpTool(1, "start_sign_in", { clientId: unownedUrl, clientName: "Feed Official App" }, authConfig)
    const verified = unwrapToolPayload(try callMcpTool(2, "start_sign_in", { clientId: cimdUrl.replace("https://", "HTTPS://"), clientName: "Feed Official App" }, authConfig))
    const verifiedLookup = try lookupDeviceCodeForUser(String(verified.userCode ?? ""))
    const fallback = unwrapToolPayload(try callMcpTool(3, "start_sign_in", {}, authConfig))
    const fallbackLookup = try lookupDeviceCodeForUser(String(fallback.userCode ?? ""))
    const limitedIp = { "cf-connecting-ip": "203.0.113.100" }
    for (let i = 0; i < 30; i += 1) {
      try callMcpTool(10 + i, "start_sign_in", {}, authConfig, undefined, limitedIp)
    }
    const rateLimitedCimd = try callMcpTool(50, "start_sign_in", { clientId: unownedUrl }, authConfig, undefined, limitedIp)
    try check(() => {
      assert.strictEqual(unwrapToolError(unowned).error, "invalid_client")
      assert.strictEqual(isRateLimitedToolResult(rateLimitedCimd), true)
      assert.deepStrictEqual(
        [verified.clientId, verified.clientName, verifiedLookup.clientId, verifiedLookup.clientName],
        [cimdUrl, "Verified Example Agent", cimdUrl, "Verified Example Agent"]
      )
      assert.deepStrictEqual(
        [fallbackLookup.clientId, fallbackLookup.clientName, /^https?:\/\//i.test(fallbackLookup.clientId)],
        [fallback.clientId, "Feed MCP Agent", false]
      )
      assert.deepStrictEqual(fetchedUrls, [unownedUrl, cimdUrl])
    })
  })
}))

effect function seedTestPerp(tx: Tx, ticker: string, now: number) {
  try tx.query(
    "INSERT INTO feed_perp_markets (ticker, index_price_cents, mark_price_cents, updated_at) VALUES ($1, $2, $3, $4) ON CONFLICT (ticker) DO NOTHING",
    [ticker, 100, 100, now]
  )
}

effect function seedTestArticle(
  tx: Tx,
  article: {
    readonly id: string
    readonly title: string
    readonly summary: string
    readonly body: string
    readonly relatedMarketId: string | null
    readonly isResolutionProof: boolean
    readonly publishedAt: number
  }
) {
  try tx.query(
    "INSERT INTO feed_articles (id, title, summary, body, author_org_id, related_market_id, is_resolution_proof, published_at) VALUES ($1, $2, $3, $4, $5, $6, $7, $8)",
    [
      article.id,
      article.title,
      article.summary,
      article.body,
      "the-new-york-taimes",
      article.relatedMarketId,
      article.isResolutionProof,
      article.publishedAt
    ]
  )
}

effect function seedFillerArticles(tx: Tx, count: number, now: number) {
  for (let i = 1; i <= count; i += 1) {
    try seedTestArticle(tx, {
      id: `filler-article-${i}`,
      title: `Filler article ${i}`,
      summary: "Filler summary",
      body: "Filler body",
      relatedMarketId: null,
      isResolutionProof: false,
      publishedAt: now + i
    })
  }
}

effect function getRelatedMarketArticles(
  reqId: number,
  args: Record<string, unknown>,
  authConfig: Parameters<typeof callMcpTool>[3]
) {
  const res = try callMcpTool(reqId, "get_market", args, authConfig)
  const payload = unwrapToolPayload(res)
  return (payload.relatedArticles ?? []) as ReadonlyArray<{ readonly id: string; readonly relatedMarketId: string | null }>
}

effect function runSeededTx<E, R>(run: (tx: Tx, now: number) => Effect.Effect<void, E, R>) {
  const now = try Clock.currentTimeMillis
  const store = try Store
  try store.transaction(effect (tx: Tx) => {
    try run(tx, now)
  })
}

it.effect(
  'get_market returns related articles for a perp ticker (spec/mcp/tools.md, "Story: Call public and authenticated MCP tools under mixed auth, scope, mode, and D-30 rules")',
  () => withSeededWorld(effect (authConfig) => {
    try runSeededTx(effect (tx, now) => {
      try seedTestPerp(tx, "OPENAGI", now)
      try seedTestArticle(tx, {
        id: "perp-related-article",
        title: "OpenAGI perp scoop",
        summary: "OpenAGI perp summary",
        body: "OpenAGI perp body",
        relatedMarketId: "seed-market-1",
        isResolutionProof: false,
        publishedAt: now
      })
    })
    const relatedArticles = try getRelatedMarketArticles(201, { marketId: "OPENAGI", kind: "perp" }, authConfig)
    try check(() => {
      assert.strictEqual(relatedArticles.some((a) => a.id === "perp-related-article"), true)
    })
  })
)

it.effect(
  'get_market does not return a memecoin-index article for the COIN perp (spec/mcp/tools.md, "Story: Call public and authenticated MCP tools under mixed auth, scope, mode, and D-30 rules")',
  () => withSeededWorld(effect (authConfig) => {
    try runSeededTx(effect (tx, now) => {
      try seedTestPerp(tx, "COIN", now)
      try tx.query(
        "INSERT INTO feed_prediction_markets (id, slot_index, question, description, category, timeframe, phase, yes_shares, no_shares, liquidity_cents, secret_outcome, status, expires_at, created_at) VALUES ($1, $2, $3, $4, $5, $6, 'opening', 50000, 50000, 50000, $7, 'open', $8, $9)",
        ["perp-memecoin-market", 99, "Will the memecoin index rise this hour?", "Resolves YES if the memecoin index closes higher at the end of the hour.", "crypto", "1h", "YES", now + 3600000, now]
      )
      try seedTestArticle(tx, {
        id: "perp-memecoin-article",
        title: "Memecoin index watch",
        summary: "Memecoin index summary",
        body: "Memecoin index body",
        relatedMarketId: "perp-memecoin-market",
        isResolutionProof: false,
        publishedAt: now
      })
    })
    const relatedArticles = try getRelatedMarketArticles(202, { marketId: "COIN", kind: "perp" }, authConfig)
    try check(() => {
      assert.strictEqual(relatedArticles.some((a) => a.id === "perp-memecoin-article"), false)
      assert.strictEqual(relatedArticles.some((a) => a.id === "seed-article-4"), true)
    })
    const fallbackArticles = try getRelatedMarketArticles(203, { marketId: "COIN", kind: "prediction" }, authConfig)
    try check(() => {
      assert.strictEqual(fallbackArticles.some((a) => a.id === "perp-memecoin-article"), false)
      assert.strictEqual(fallbackArticles.some((a) => a.id === "seed-article-4"), true)
    })
  })
)

it.effect('list_markets with status resolved returns no perp markets', () =>
  withSeededWorld(effect (authConfig) => {
    const openPerps = unwrapToolPayload(try callMcpTool(201, "list_markets", { kind: "perp", status: "open", limit: 10 }, authConfig))
    const resolvedPerps = unwrapToolPayload(try callMcpTool(202, "list_markets", { kind: "perp", status: "resolved", limit: 10 }, authConfig))
    const resolvedAll = unwrapToolPayload(try callMcpTool(203, "list_markets", { kind: "all", status: "resolved", limit: 10 }, authConfig))
    const allPerps = unwrapToolPayload(try callMcpTool(204, "list_markets", { kind: "perp", status: "all", limit: 10 }, authConfig))
    try check(() => {
      assert.isAbove((openPerps.perpMarkets as ReadonlyArray<unknown>).length, 0)
      assert.deepStrictEqual(resolvedPerps.perpMarkets, [])
      assert.deepStrictEqual(resolvedAll.perpMarkets, [])
      assert.isAbove((allPerps.perpMarkets as ReadonlyArray<unknown>).length, 0)
    })
  })
)

it.effect(
  'get_market returns a related article older than the 50 newest articles (spec/mcp/tools.md, "Story: Call public and authenticated MCP tools under mixed auth, scope, mode, and D-30 rules")',
  () => withSeededWorld(effect (authConfig) => {
    try runSeededTx(effect (tx, now) => {
      try seedTestArticle(tx, {
        id: "buried-market-article",
        title: "Buried market scoop",
        summary: "Buried summary",
        body: "Buried body",
        relatedMarketId: "seed-market-1",
        isResolutionProof: false,
        publishedAt: now - 1_000_000
      })
      try seedTestArticle(tx, {
        id: "buried-proof-article",
        title: "Unreleased proof",
        summary: "Proof summary",
        body: "Proof body",
        relatedMarketId: "seed-market-1",
        isResolutionProof: true,
        publishedAt: now - 2_000_000
      })
      try seedFillerArticles(tx, 60, now)
    })
    const relatedArticles = try getRelatedMarketArticles(201, { marketId: "seed-market-1" }, authConfig)
    try check(() => {
      assert.strictEqual(relatedArticles.some((a) => a.id === "buried-market-article"), true)
      assert.strictEqual(relatedArticles.every((a) => a.relatedMarketId === "seed-market-1"), true)
      assert.strictEqual(relatedArticles.some((a) => a.id === "buried-proof-article"), false)
    })
  })
)

it.effect(
  'search "$TICKER" returns the matching prediction and perp markets (spec/mcp/tools.md, "Story: Call public and authenticated MCP tools under mixed auth, scope, mode, and D-30 rules")',
  () => withSeededWorld(effect (authConfig) => {
    const dollarOpen = try callMcpTool(202, "search", { query: "$OPENAGI", kind: "markets", limit: 10 }, authConfig)
    const dollarOpenPayload = unwrapToolPayload(dollarOpen)
    const dollarPreds = (dollarOpenPayload.predictionMarkets ?? []) as ReadonlyArray<{ readonly id: string }>
    const dollarPerps = (dollarOpenPayload.perpMarkets ?? []) as ReadonlyArray<{ readonly ticker: string }>
    const dollarNv = try callMcpTool(203, "search", { query: "$NVDAI", kind: "markets", limit: 10 }, authConfig)
    const dollarNvPayload = unwrapToolPayload(dollarNv)
    const dollarNvPerps = (dollarNvPayload.perpMarkets ?? []) as ReadonlyArray<{ readonly ticker: string }>
    const bareDollar = try callMcpTool(204, "search", { query: "$", kind: "markets", limit: 10 }, authConfig)
    const bareDollarPayload = unwrapToolPayload(bareDollar)
    const bareDollarPreds = (bareDollarPayload.predictionMarkets ?? []) as ReadonlyArray<{ readonly id: string }>
    const bareDollarPerps = (bareDollarPayload.perpMarkets ?? []) as ReadonlyArray<{ readonly ticker: string }>
    try check(() => {
      assert.strictEqual(dollarPreds.some((m) => m.id === "seed-market-1"), true)
      assert.strictEqual(dollarPerps.some((m) => m.ticker === "OPENAGI"), true)
      assert.strictEqual(dollarNvPerps.some((m) => m.ticker === "NVDAI"), true)
      assert.strictEqual(bareDollarPreds.length, 1)
      assert.strictEqual(bareDollarPerps.length, 0)
    })
  })
)

it.effect(
  'search returns articles older than the 50 newest (spec/mcp/tools.md, "Story: Call public and authenticated MCP tools under mixed auth, scope, mode, and D-30 rules")',
  () => withSeededWorld(effect (authConfig) => {
    try runSeededTx(effect (tx, now) => {
      try seedTestArticle(tx, {
        id: "buried-article-1",
        title: "Buried Quibberton scoop",
        summary: "Quibberton summary",
        body: "Quibberton body",
