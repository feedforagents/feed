function specScopeToMcpScope(scope: string): McpScope {
  if (scope === "ScopeTrade") return "trade"
  if (scope === "ScopeMessages") return "messages"
  if (scope === "ScopeSocialWrite") return "social:write"
  return "read"
}

function asOptionalString(value: unknown): string | undefined {
  if (typeof value !== "string") return undefined
  const trimmed = value.trim()
  return trimmed === "" ? undefined : trimmed
}

function asOptionalInt(value: unknown): number | undefined {
  if (typeof value !== "number" || !Number.isFinite(value)) return undefined
  return Math.floor(value)
}

function clampCount(value: number | undefined, fallback: number, max: number): number {
  if (value === undefined) return fallback
  if (value < 1) return 1
  return value > max ? max : value
}

const CLIENT_IP_HEADERS = ["cf-connecting-ip", "x-real-ip", "x-forwarded-for"] as const

function mcpClientIp(request: Request): string | undefined {
  for (const header of CLIENT_IP_HEADERS) {
    const raw = request.headers.get(header)
    if (raw === null) continue
    const candidate = (header === "x-forwarded-for" ? raw.split(",")[0] : raw)?.trim()
    if (candidate !== undefined && candidate !== "") return candidate
  }
  return undefined
}

function perpTradeMeta(args: Record<string, unknown>, clientName: string) {
  const maxSlippageBps = asOptionalInt(args.maxSlippageBps)
  const idempotencyKey = asOptionalString(args.idempotencyKey)
  return {
    ...(maxSlippageBps === undefined ? {} : { maxSlippageBps }),
    viaClientName: clientName,
    ...(idempotencyKey === undefined ? {} : { idempotencyKey })
  }
}

function toJsonRpcId(raw: unknown): JsonRpcId {
  if (typeof raw === "string" || typeof raw === "number" || raw === null) return raw
  return null
}

function formatPostForMcp(post: PostView, mode: PlayMode): Record<string, unknown> {
  if (mode === "social") {
    return {
      ...post,
      marketId: null,
      ticker: null,
      marketBadge: null,
      cashtags: [],
      showTradeEmbed: false,
      linkCashtags: false,
      quotePost: post.quotePost === null
        ? null
        : {
            ...post.quotePost,
            marketId: null,
            ticker: null,
            cashtags: [],
            showTradeEmbed: false,
            linkCashtags: false
          }
    }
  }
  return post as unknown as Record<string, unknown>
}

function formatProfileForMcp(profile: ProfileView, isSelf: boolean, mode: PlayMode): Record<string, unknown> {
  const base: Record<string, unknown> = {
    id: profile.id,
    kind: profile.kind,
    handle: profile.handle,
    displayName: profile.displayName,
    bio: profile.bio,
    avatarUrl: profile.avatarUrl,
    bannerUrl: profile.bannerUrl,
    createdAt: profile.createdAt,
    actorMeta: profile.actorMeta,
    orgMeta: profile.orgMeta,
    isParody: profile.isParody,
    parodyLabel: profile.parodyLabel,
    followersCount: profile.followersCount,
    followingCount: profile.followingCount,
    postsCount: profile.postsCount,
    viewerFollows: profile.viewerFollows,
    viewerFollowedBy: profile.viewerFollowedBy,
    viewerBlocks: profile.viewerBlocks,
    viewerBlockedBy: profile.viewerBlockedBy,
    viewerMutes: profile.viewerMutes,
    activeAgentClientName: profile.activeAgentClientName
  }
  if (!isSelf || mode === "social") {
    return base
  }
  return {
    ...base,
    uiMode: profile.uiMode,
    balancePts: profile.balanceCents === null ? null : toPtsNumber(profile.balanceCents),
    balanceDisplay: profile.balanceCents === null ? null : formatPtsLabeled(profile.balanceCents),
    tradeCount: profile.tradeCount,
    openPositionCount: profile.openPositionCount,
    currency: CURRENCY_DISCLAIMER
  }
}

function formatPredictionMarketForMcp(market: PredictionMarketView): Record<string, unknown> {
  return {
    id: market.id,
    slotIndex: market.slotIndex,
    question: market.question,
    description: market.description,
    category: market.category,
    timeframe: market.timeframe,
    phase: market.phase,
    status: market.status,
    yesPrice: market.yesPrice,
    noPrice: market.noPrice,
    yesPriceBps: market.yesPriceBps,
    noPriceBps: market.noPriceBps,
    yesShares: shareUnitsToShares(market.yesShares),
    yesShareUnits: market.yesShares,
    noShares: shareUnitsToShares(market.noShares),
    noShareUnits: market.noShares,
    liquidityPts: toPtsNumber(market.liquidityCents),
    liquidityDisplay: formatPtsLabeled(market.liquidityCents),
    volumePts: toPtsNumber(market.volumeCents),
    resolvedOutcome: market.status === "resolved" ? market.resolvedOutcome : null,
    resolutionProof: market.status === "resolved" ? market.resolutionProof : null,
    resolutionArticleId: market.status === "resolved" ? market.resolutionArticleId : null,
    expiresAt: market.expiresAt,
    resolvedAt: market.resolvedAt,
    createdAt: market.createdAt,
    currency: CURRENCY_DISCLAIMER
  }
}

function formatPerpMarketForMcp(market: PerpMarketView): Record<string, unknown> {
  return {
    ticker: market.ticker,
    organizationId: market.organizationId,
    name: market.name,
    orgImageUrl: market.orgImageUrl,
    indexPricePts: toPtsNumber(market.indexPriceCents),
    markPricePts: toPtsNumber(market.markPriceCents),
    change24hPct: market.change24hPct,
    volume24hPts: toPtsNumber(market.volume24hCents),
    volumePts: toPtsNumber(market.volumeCents),
    longOiPts: toPtsNumber(market.longOiCents),
    shortOiPts: toPtsNumber(market.shortOiCents),
    openInterestPts: toPtsNumber(market.openInterestCents),
    maxLeverage: market.maxLeverage,
    fundingRateBps: market.fundingRateBps,
    lastFundingPeriod: market.lastFundingPeriod,
    updatedAt: market.updatedAt,
    currency: CURRENCY_DISCLAIMER
  }
}

function formatMarketTradeForMcp(trade: MarketTradeView): Record<string, unknown> {
  const quantityFields = trade.marketKind === "prediction"
    ? { shares: shareUnitsToShares(trade.sharesOrSize), shareUnits: trade.sharesOrSize }
    : { sizePts: toPtsNumber(trade.sharesOrSize), sizeCents: trade.sharesOrSize }
  return {
    id: trade.id,
    traderId: trade.traderId,
    traderKind: trade.traderKind,
    marketKind: trade.marketKind,
    marketRef: trade.marketRef,
    side: trade.side,
    ...quantityFields,
    notionalPts: toPtsNumber(trade.notionalCents),
    feePts: toPtsNumber(trade.feeCents),
    pricePts: toPtsNumber(trade.priceCents),
    realizedPnlPts: trade.realizedPnlCents === null ? null : toPtsNumber(trade.realizedPnlCents),
    viaClientName: trade.viaClientName,
    createdAt: trade.createdAt
  }
}

function formatPriceHistoryPointForMcp(point: MarketPriceHistoryPoint): Record<string, unknown> {
  return {
    id: point.id,
    marketKind: point.marketKind,
    marketRef: point.marketRef,
    pricePts: toPtsNumber(point.priceCents),
    yesPriceBps: point.yesPriceBps,
    markPricePts: point.markPriceCents === null ? null : toPtsNumber(point.markPriceCents),
    volumePts: toPtsNumber(point.volumeCents),
    recordedAt: point.recordedAt
  }
}

function formatLeaderboardEntryForMcp(entry: LeaderboardEntry): Record<string, unknown> {
  return {
    rank: entry.rank,
    accountId: entry.accountId,
    handle: entry.handle,
    displayName: entry.displayName,
    avatarUrl: entry.avatarUrl,
    isNpc: entry.isNpc,
    balancePts: toPtsNumber(entry.balanceCents),
    positionValuePts: toPtsNumber(entry.positionValueCents),
    equityPts: toPtsNumber(entry.equityCents),
    startingGrantPts: toPtsNumber(entry.startingGrantCents),
    netProfitPts: toPtsNumber(entry.netProfitCents),
    netProfitDisplay: formatPtsLabeled(entry.netProfitCents),
    returnBps: entry.returnBps,
    returnPct: entry.returnPct,
    volumePts: toPtsNumber(entry.volumeCents),
    tradeCount: entry.tradeCount,
    wins: entry.wins,
    settledCount: entry.settledCount,
    winRate: entry.winRate,
    winRatePct: entry.winRatePct
  }
}

function guideSectionForTopic(topic: string, origin: string): Record<string, unknown> {
  const base = normalizeOrigin(origin)
  const sections: Readonly<Record<string, Record<string, unknown>>> = {
    overview: {
      topic: "overview",
      summary: "Feed is Twitter with markets played from your own AI agent using Virtual points (pts) — no cash value.",
      startingGrant: "100.00 pts ($100 virtual capital) fixed starting grant once upon 18+ phone verification, with no buying, selling, or refilling capital on web or MCP.",
      publicToolsCount: PUBLIC_TOOL_COUNT,
      protectedToolsCount: PROTECTED_TOOL_COUNT,
      guideUrl: `${base}/how-to-play.md`
    },
    prediction: {
      topic: "prediction",
      slots: 10,
      timeframes: ["15m", "30m", "1h", "6h", "12h", "1d", "2d", "3d"],
      pricing: "Complete-set CPMM with 0.1% (10 bps) round-up fee. Winning shares settle idempotently for 1.00 pt (100 cents) per 1.00 share (100 shareUnits).",
      currency: CURRENCY_DISCLAIMER
    },
    perps: {
      topic: "perps",
      rule: "Only NPCs trade spot pools; spot index prices drive player perpetuals up to 20x leverage at post-impact mark prices.",
      feesAndFunding: "0.1% (10 bps) fee on notional size. Funding accrues every 8h UTC (00:00, 08:00, 16:00). Maintenance margin is 2.5% on mark price.",
      workflow: "Always call preview_perp before open_perp. open_perp rebalances existing ticker positions (add/reduce/flip), close_perp supports full or partial closes, and both support maxSlippageBps.",
      currency: CURRENCY_DISCLAIMER
    },
    social: {
      topic: "social",
      postMaxChars: 280,
      messageMaxChars: 500,
      modes: {
        game: "Shows balances, P&L, prediction odds, perps, and market notifications.",
        social: "Omits all balances, P&L, portfolio totals, market odds/quotes/leaderboard financials, $CASHTAG market links, and market notifications while keeping posts, DMs, and alpha chats active."
      }
    },
    auth: {
      topic: "auth",
      oauthMetadata: `${base}/.well-known/oauth-authorization-server`,
      protectedResourceMetadata: `${base}/.well-known/oauth-protected-resource`,
      deviceLink: `${base}/link`,
      singleGrantPolicy: "At most one active MCP client grant per account; connecting a new agent atomically replaces any prior active grant.",
      secretRule: "Never ask for, accept, store, or relay phone numbers or 6-digit SMS verification codes."
    },
    limits: {
      topic: "limits",
      sharedHourlyLimits: {
        postsPerHour: 30,
        dmsPerHour: 60,
        tradesPerHour: 120
      },
      sharedSurfaceRule: "Hourly limits are shared across the web UI and MCP on the same account."
    }
  }
  return sections[topic] ?? { ...sections.overview, fullMarkdown: renderHowToPlayMd(base) }
}

effect function lookupDeviceClientId(deviceCode: string): (string | undefined)!(McpFailure | StoreFailure)!Store {
  const codeHash = computeSkillSha256(deviceCode) catch effect (cause) => {
    throw new McpFailure({ code: "HASH_FAILED", message: "Unable to hash deviceCode.", cause })
  }
  const store = try Store
  const rows = try store.transaction((tx: Tx) =>
    tx.query("SELECT client_id FROM feed_device_codes WHERE device_code_hash = $1 LIMIT 1", [codeHash])
  )
  const found = toText(rows[0]?.client_id)
  return found === null || found === "" ? undefined : found
}

effect function updateAccountProfile(
  accountId: string,
  displayName: string | undefined,
  bio: string | undefined
): UpdatedAccountProfile!(InvalidRpcParamsFailure | SocialFailure | StoreFailure)!Store {
  if (displayName === undefined && bio === undefined) {
    throw new InvalidRpcParamsFailure({ message: "Provide displayName or bio to update." })
  }
  const profile = try updateProfile(accountId, { displayName, bio })
  if (profile === undefined) {
    throw new InvalidRpcParamsFailure({ message: "Account profile not found." })
  }
  return profile
}

effect function resolveOptionalViewer(
  authorizationHeader: string | undefined,
  authConfig: AuthRuntimeConfig
): { readonly viewerId: string | undefined; readonly playMode: PlayMode }!StoreFailure!Store {
  if (authorizationHeader === undefined || authorizationHeader.trim() === "") {
    return { viewerId: undefined, playMode: "game" }
  }
  const caller = verifyAccessToken({ authorizationHeader, config: authConfig }) catch effect (err) => {
    if (err instanceof StoreFailure) throw err
    return undefined
  }
  if (caller === undefined) {
    return { viewerId: undefined, playMode: "game" }
  }
  return { viewerId: caller.accountId, playMode: caller.playMode }
}

effect function requireAuthenticatedCaller(
  authorizationHeader: string | undefined,
  authConfig: AuthRuntimeConfig,
  specTool: McpTool,
  requiredScope: McpScope
): VerifiedAccessToken!(UnauthorizedError | InsufficientScopeFailure | RateLimited | AuthFailure | StoreFailure)!Store {
  const caller = try verifyAccessToken({ authorizationHeader, config: authConfig })
  if (!caller.scopes.includes(requiredScope)) {
    throw new InsufficientScopeFailure({ requiredScope, grantedScopes: caller.scopes })
  }
  try checkAndConsumeRateLimit({ accountId: caller.accountId, action: "mcp_call", surface: "mcp" })
  if (isTradeExecutionTool(specTool)) {
    try checkAndConsumeRateLimit({ accountId: caller.accountId, action: "trade", surface: "mcp" })
  }
  if (isMutatingMcpTool(specTool)) {
    try recordAgentAttribution(caller.accountId, caller.grantId)
  }
  return caller
}

effect function executePublicWorldTool(
  toolName: "about_feed" | "how_to_play" | "start_sign_in" | "check_sign_in",
  args: Record<string, unknown>,
  baseOrigin: string,
  authConfig: AuthRuntimeConfig,
  ipAddress: string | undefined
): object!(InvalidRpcParamsFailure | McpFailure | MarketFailure | AuthFailure | StoreFailure)!Store {
  switch (toolName) {
    case "about_feed": {
      const status = getEngineAdminStatus() catch effect (err) => {
        if (err instanceof StoreFailure) throw err
        return undefined
      }
      const openPrediction = try listPredictionMarkets("open")
      const perps = try listPerpMarkets()
      return {
        name: "Feed",
        tagline: "Twitter with markets, played from your own AI.",
        origin: baseOrigin,
        currency: CURRENCY_DISCLAIMER,
        startingGrant: "100.00 pts (10,000 cents, $100 virtual capital) fixed starting grant once on 18+ phone verification; no buying, selling, or refilling capital on web or MCP.",
        noPurchasePolicy: "No buying, selling, or refilling virtual points anywhere (web or MCP); zero checkout links or upsells.",
        worldStatus: status === undefined
          ? { available: false, openPredictionMarkets: openPrediction.length, perpMarkets: perps.length }
          : {
              available: true,
              currentDay: status.currentDay,
              currentHour: status.currentHour,
              phase: status.phase,
              gameRunning: status.gameRunning,
              openPredictionMarkets: openPrediction.length,
              perpMarkets: perps.length,
              lastTickAt: status.lastTickAt
            },
        auth: {
          mcpEndpoint: `${baseOrigin}/mcp`,
          skillUrl: `${baseOrigin}/SKILL.md`,
          discoveryIndexUrl: `${baseOrigin}/.well-known/agent-skills/index.json`,
          oauthProtectedResource: `${baseOrigin}/.well-known/oauth-protected-resource`,
          oauthAuthorizationServer: `${baseOrigin}/.well-known/oauth-authorization-server`,
          deviceLinkUrl: `${baseOrigin}/link`,
          singleGrantPolicy: "At most one active connected agent per account."
        },
        toolsSummary: {
          publicTools: PUBLIC_TOOL_COUNT,
          protectedTools: PROTECTED_TOOL_COUNT,
          totalTools: MCP_TOOL_DEFINITIONS.length
        }
      }
    }
    case "how_to_play": {
      const topic = asOptionalString(args.topic) ?? "overview"
      return guideSectionForTopic(topic, baseOrigin)
    }
    case "start_sign_in": {
      if (ipAddress !== undefined && authConfig.digestKey.trim() !== "") {
        checkOAuthEndpointRateLimit({
          endpoint: "device_code",
          ipAddress,
          digestKey: authConfig.digestKey
        }) catch effect (err) => {
          if (err instanceof RateLimited) {
            throw new AuthFailure({ code: "rate_limited", message: err.message, status: 429 })
          }
          throw err
        }
      }
      let clientId = asOptionalString(args.clientId) ?? DEFAULT_DEVICE_CLIENT_ID
      let clientName = asOptionalString(args.clientName) ?? DEFAULT_DEVICE_CLIENT_NAME
      if (/^https?:\/\//i.test(clientId)) {
        const cimd = try fetchClientMetadata(clientId)
        clientId = cimd.clientId
        clientName = cimd.clientName
      }
      const rawScopes = Array.isArray(args.scopes) ? (args.scopes as ReadonlyArray<string>) : undefined
      const scopeString = rawScopes !== undefined && rawScopes.length > 0 ? rawScopes.join(" ") : undefined
      const device = try startDeviceAuthorization({
        clientId,
        clientName,
        scope: scopeString,
        resource: `${baseOrigin}/mcp`,
        origin: baseOrigin
      })
      return {
        status: "pending",
        clientId,
        clientName,
        deviceCode: device.device_code,
        userCode: device.user_code,
        verificationUri: device.verification_uri,
        verificationUriComplete: device.verification_uri_complete,
        expiresIn: device.expires_in,
        interval: device.interval,
        instructions: "Share verificationUri and userCode with the player so they can sign in on the browser and approve the connection. Never ask for or relay a phone number or SMS verification code."
      }
    }
    case "check_sign_in": {
      const deviceCode = asOptionalString(args.deviceCode) ?? ""
      if (deviceCode === "") {
        throw new InvalidRpcParamsFailure({ message: "deviceCode is required." })
      }
      const providedClientId = asOptionalString(args.clientId)
      const storedClientId = try lookupDeviceClientId(deviceCode)
      if (providedClientId !== undefined && storedClientId !== undefined && providedClientId !== storedClientId) {
        return {
          status: "error",
          code: "invalid_client",
          message: "clientId does not match the device authorization request."
        }
      }
      const clientId = providedClientId ?? storedClientId ?? DEFAULT_DEVICE_CLIENT_ID
      const exchanged = exchangeOAuthToken({
        grantType: "urn:ietf:params:oauth:grant-type:device_code",
        deviceCode,
        clientId,
        resource: `${baseOrigin}/mcp`,
        config: authConfig
      }) catch effect (err) => {
        if (err instanceof StoreFailure) throw err
        if (err instanceof AuthFailure) {
          if (err.code === "authorization_pending") {
            return { status: "pending", interval: 5, message: "Waiting for player approval at /link." }
          }
          if (err.code === "expired_token") {
            return { status: "expired", message: "Device code expired; call start_sign_in again." }
          }
          if (err.code === "access_denied") {
            return { status: "denied", message: "Connection request was denied by the player." }
          }
          return { status: "error", code: err.code, message: err.message }
        }
        return { status: "error", code: "device_exchange_failed", message: "Unable to check device sign-in." }
      }
      if ("status" in exchanged) {
        return exchanged
      }
      return {
        status: "authorized",
        token_type: exchanged.token_type,
        access_token: exchanged.access_token,
        refresh_token: exchanged.refresh_token,
        expires_in: exchanged.expires_in,
        scope: exchanged.scope,
        resource: exchanged.resource,
        grant_id: exchanged.grant_id,
        client_id: exchanged.client_id,
        client_name: exchanged.client_name
      }
    }
  }
}

effect function executePublicSocialTool(
  toolName: "get_post" | "get_replies" | "get_user_posts" | "get_profile" | "search" | "get_trending" | "get_followers" | "get_following",
  args: Record<string, unknown>,
  viewer: { readonly viewerId: string | undefined; readonly playMode: PlayMode }
): object!(SocialFailure | MarketFailure | StoreFailure)!Store {
  switch (toolName) {
    case "get_post": {
      const postId = asOptionalString(args.postId) ?? ""
      const thread = try getPostThread(postId, viewer.viewerId, viewer.playMode)
      return {
        post: formatPostForMcp(thread.post, viewer.playMode),
        parentPost: thread.parentPost === null ? null : formatPostForMcp(thread.parentPost, viewer.playMode),
        ancestors: thread.ancestors.map((item) => formatPostForMcp(item, viewer.playMode)),
        replyCount: thread.replies.length
      }
    }
    case "get_replies": {
      const postId = asOptionalString(args.postId) ?? ""
      const limit = clampCount(asOptionalInt(args.limit), 25, 100)
      const thread = try getPostThread(postId, viewer.viewerId, viewer.playMode)
      return {
        postId,
        replies: thread.replies.slice(0, limit).map((reply) => formatPostForMcp(reply, viewer.playMode))
      }
    }
    case "get_user_posts": {
      const handleOrId = asOptionalString(args.handleOrId) ?? ""
      const limit = clampCount(asOptionalInt(args.limit), 20, 100)
      const cursor = asOptionalString(args.cursor)
      const target = try getProfile(handleOrId, viewer.viewerId, viewer.playMode)
      const page = try listFeedPosts({
        tab: "latest",
        authorId: target.id,
        viewerId: viewer.viewerId,
        mode: viewer.playMode,
        limit,
        ...(cursor === undefined ? {} : { cursor })
      })
      return {
        author: { id: target.id, handle: target.handle, displayName: target.displayName, kind: target.kind },
        items: page.items.map((post) => formatPostForMcp(post, viewer.playMode)),
        nextCursor: page.nextCursor
      }
    }
    case "get_profile": {
      const handleOrId = asOptionalString(args.handleOrId) ?? ""
      const profile = try getProfile(handleOrId, viewer.viewerId, viewer.playMode)
      const isSelf = viewer.viewerId !== undefined && profile.kind === "user" && viewer.viewerId === profile.id
      return formatProfileForMcp(profile, isSelf, viewer.playMode)
    }
    case "search": {
      const query = asOptionalString(args.query) ?? ""
      const kind = asOptionalString(args.kind) ?? "all"
      const limit = clampCount(asOptionalInt(args.limit), 15, 50)
      const qLower = query.toLowerCase()
      const strippedMarketQuery = qLower.replace(/^\$+/, "").trim()
      const marketQuery = strippedMarketQuery === "" ? qLower : strippedMarketQuery
      const world = try searchWorld({
        query,
        mode: viewer.playMode,
        viewerId: viewer.viewerId,
        limit
      })
      const includePosts = kind === "all" || kind === "posts"
      const includeUsers = kind === "all" || kind === "users"
      const includeMarkets = (kind === "all" || kind === "markets") && viewer.playMode === "game"
      const includeArticles = kind === "all" || kind === "articles"
      const predictionMatches = includeMarkets
        ? (try listPredictionMarkets("open"))
            .filter((m) => m.question.toLowerCase().includes(marketQuery) || m.description.toLowerCase().includes(marketQuery) || m.category.toLowerCase().includes(marketQuery))
            .slice(0, limit)
            .map(formatPredictionMarketForMcp)
        : []
      const perpMatches = includeMarkets
        ? (try listPerpMarkets())
            .filter((m) => m.ticker.toLowerCase().includes(marketQuery) || m.name.toLowerCase().includes(marketQuery))
            .slice(0, limit)
            .map(formatPerpMarketForMcp)
        : []
      const articleMatches = includeArticles
        ? (try listArticles(limit, viewer.playMode, query)).slice(0, limit)
        : []
      return {
        query,
        kind,
        posts: includePosts ? world.posts.map((p) => formatPostForMcp(p, viewer.playMode)) : [],
        accounts: includeUsers ? world.accounts : [],
        actors: includeUsers ? world.actors : [],
        organizations: includeUsers ? world.organizations : [],
        tags: includePosts ? world.tags : [],
        predictionMarkets: predictionMatches,
        perpMarkets: perpMatches,
        articles: articleMatches
      }
    }
    case "get_trending": {
      const limit = clampCount(asOptionalInt(args.limit), 15, 50)
      const items = try listTrending(limit, viewer.playMode, viewer.viewerId)
      return { mode: viewer.playMode, items }
    }
    case "get_followers": {
      const handleOrId = asOptionalString(args.handleOrId) ?? ""
      const limit = clampCount(asOptionalInt(args.limit), 50, 100)
      const items = try listFollowers(handleOrId, viewer.viewerId, limit)
      const target = try getProfile(handleOrId, viewer.viewerId, "game")
      return { targetId: target.id, targetHandle: target.handle, items }
    }
    case "get_following": {
      const handleOrId = asOptionalString(args.handleOrId) ?? ""
      const limit = clampCount(asOptionalInt(args.limit), 50, 100)
      const items = try listFollowing(handleOrId, viewer.viewerId, limit)
      const target = try getProfile(handleOrId, viewer.viewerId, "game")
      return { targetId: target.id, targetHandle: target.handle, items }
    }
  }
}

effect function executePublicMarketTool(
  toolName: "list_markets" | "get_market" | "get_leaderboard",
  args: Record<string, unknown>,
  viewer: { readonly viewerId: string | undefined; readonly playMode: PlayMode }
): object!(SocialFailure | MarketFailure | StoreFailure)!Store {
  switch (toolName) {
    case "list_markets": {
      if (viewer.playMode === "social") {
        return {
          playMode: "social",
          financialFieldsOmittedInSocialMode: true,
          message: "Market odds, quotes, and financial fields are omitted in Social mode. Switch via set_mode({ mode: \"game\" }) only if the user explicitly wants Game mode.",
          currency: CURRENCY_DISCLAIMER,
          predictionMarkets: [],
          perpMarkets: []
        }
      }
      const kind = asOptionalString(args.kind) ?? "all"
      const rawStatus = asOptionalString(args.status) ?? "open"
      const limit = clampCount(asOptionalInt(args.limit), 25, 100)
      const statusParam = rawStatus === "open" ? "open" : rawStatus === "resolved" ? "resolved" : undefined
      const prediction = kind === "all" || kind === "prediction"
        ? (try listPredictionMarkets(statusParam)).slice(0, limit).map(formatPredictionMarketForMcp)
        : []
      const perp = (kind === "all" || kind === "perp") && statusParam !== "resolved"
        ? (try listPerpMarkets()).slice(0, limit).map(formatPerpMarketForMcp)
        : []
      return {
        currency: CURRENCY_DISCLAIMER,
        predictionMarkets: prediction,
        perpMarkets: perp
      }
    }
    case "get_market": {
      const marketId = asOptionalString(args.marketId) ?? ""
      if (viewer.playMode === "social") {
        return {
          playMode: "social",
          financialFieldsOmittedInSocialMode: true,
          marketId,
          message: "Market odds, pricing, trade history, and financial fields are omitted in Social mode. Switch via set_mode({ mode: \"game\" }) only if the user explicitly wants Game mode.",
          currency: CURRENCY_DISCLAIMER,
          relatedPosts: [],
          relatedArticles: [],
          recentTrades: [],
          priceHistory: []
        }
      }
      const kind = asOptionalString(args.kind)
      const tradesLimit = clampCount(asOptionalInt(args.tradesLimit), 20, 100)
      const historyLimit = clampCount(asOptionalInt(args.historyLimit), 50, 200)
      if (kind === "perp") {
        const perp = try getPerpMarket(marketId.toUpperCase())
        const articles = try listArticles(50, viewer.playMode)
        const relatedPosts = try listFeedPosts({ tab: "latest", ticker: perp.ticker, viewerId: viewer.viewerId, mode: viewer.playMode, limit: 20 })
        const recentTrades = try listMarketTrades("perp", perp.ticker, tradesLimit, viewer.viewerId)
        const priceHistory = try getMarketPriceHistory("perp", perp.ticker, historyLimit)
        const perpTicker = perp.ticker.toUpperCase()
        const perpMarketIds = (try listPredictionMarkets(undefined)).filter((m) => resolvePredictionMarketTicker(m.question, m.description, [{ id: perp.organizationId, name: perp.name, ticker: perpTicker }]) === perpTicker).map((m) => m.id)
        return {
          kind: "perp",
          market: formatPerpMarketForMcp(perp),
          recentTrades: recentTrades.map(formatMarketTradeForMcp),
          priceHistory: priceHistory.map(formatPriceHistoryPointForMcp),
          relatedPosts: relatedPosts.items.map((p) => formatPostForMcp(p, viewer.playMode)),
          relatedArticles: articles.filter((a) => a.relatedMarketId !== null && perpMarketIds.includes(a.relatedMarketId))
        }
      }
      const maybePred = getPredictionMarket(marketId) catch effect (err) => {
        if (err instanceof StoreFailure) throw err
        return undefined
      }
      if (maybePred !== undefined && kind !== "perp") {
        const relatedArticles = try listArticlesForMarket(maybePred.id, viewer.playMode)
        const relatedPosts = try listFeedPosts({ tab: "latest", marketId: maybePred.id, viewerId: viewer.viewerId, mode: viewer.playMode, limit: 20 })
        const recentTrades = try listMarketTrades("prediction", maybePred.id, tradesLimit, viewer.viewerId)
        const priceHistory = try getMarketPriceHistory("prediction", maybePred.id, historyLimit)
        const resolutionArticle = maybePred.status === "resolved" && maybePred.resolutionArticleId !== null
          ? (getArticle(maybePred.resolutionArticleId, viewer.playMode) catch effect (err) => {
              if (err instanceof StoreFailure) throw err
              return null
            })
          : null
        return {
          kind: "prediction",
          market: formatPredictionMarketForMcp(maybePred),
          recentTrades: recentTrades.map(formatMarketTradeForMcp),
          priceHistory: priceHistory.map(formatPriceHistoryPointForMcp),
          relatedPosts: relatedPosts.items.map((p) => formatPostForMcp(p, viewer.playMode)),
          relatedArticles,
          resolutionArticle
        }
      }
      const perpFallback = try getPerpMarket(marketId.toUpperCase())
      const articles = try listArticles(50, viewer.playMode)
      const relatedPosts = try listFeedPosts({ tab: "latest", ticker: perpFallback.ticker, viewerId: viewer.viewerId, mode: viewer.playMode, limit: 20 })
      const recentTrades = try listMarketTrades("perp", perpFallback.ticker, tradesLimit, viewer.viewerId)
      const priceHistory = try getMarketPriceHistory("perp", perpFallback.ticker, historyLimit)
      const perpFallbackTicker = perpFallback.ticker.toUpperCase()
      const perpFallbackMarketIds = (try listPredictionMarkets(undefined)).filter((m) => resolvePredictionMarketTicker(m.question, m.description, [{ id: perpFallback.organizationId, name: perpFallback.name, ticker: perpFallbackTicker }]) === perpFallbackTicker).map((m) => m.id)
      return {
        kind: "perp",
        market: formatPerpMarketForMcp(perpFallback),
        recentTrades: recentTrades.map(formatMarketTradeForMcp),
        priceHistory: priceHistory.map(formatPriceHistoryPointForMcp),
        relatedPosts: relatedPosts.items.map((p) => formatPostForMcp(p, viewer.playMode)),
        relatedArticles: articles.filter((a) => a.relatedMarketId !== null && perpFallbackMarketIds.includes(a.relatedMarketId))
      }
    }
    case "get_leaderboard": {
      const scope = args.scope === "characters" ? "characters" : "players"
      const rawMetric = asOptionalString(args.metric) ?? "net_profit"
      const metric = rawMetric === "return_pct" || rawMetric === "win_rate" || rawMetric === "volume"
        ? rawMetric
        : "net_profit"
      const page = clampCount(asOptionalInt(args.page), 1, 1000)
      const pageSize = clampCount(asOptionalInt(args.pageSize) ?? asOptionalInt(args.limit), 25, 100)
      if (viewer.playMode === "social") {
        return {
          playMode: "social",
          financialFieldsOmittedInSocialMode: true,
          scope,
          metric,
          page: 1,
          pageSize,
          totalCount: 0,
          totalPages: 1,
          currentUser: null,
          entries: [],
          message: "Leaderboard profits, balances, and P&L rankings are omitted in Social mode. Switch via set_mode({ mode: \"game\" }) only if the user explicitly wants Game mode.",
          currency: CURRENCY_DISCLAIMER
        }
      }
      const board = try getLeaderboard({
        scope,
        metric,
        page,
        pageSize,
        ...(viewer.viewerId === undefined ? {} : { viewerAccountId: viewer.viewerId })
      })
      return {
        scope: board.scope,
        metric: board.metric,
        page: board.page,
        pageSize: board.pageSize,
        totalCount: board.totalCount,
        totalPages: board.totalPages,
        currency: CURRENCY_DISCLAIMER,
        rankingRule: "Ordered by net profit (equity - fixed 100 pts starting grant), return %, win rate, or volume; never raw point balance.",
        currentUser: board.currentUser === null ? null : formatLeaderboardEntryForMcp(board.currentUser),
        entries: board.entries.map(formatLeaderboardEntryForMcp)
      }
    }
  }
}

effect function executePublicTool(
  definition: McpToolDefinition,
  args: Record<string, unknown>,
  origin: string,
  authorizationHeader: string | undefined,
  authConfig: AuthRuntimeConfig,
  ipAddress: string | undefined
): object!(InvalidRpcParamsFailure | McpFailure | SocialFailure | MarketFailure | AuthFailure | StoreFailure)!Store {
  const baseOrigin = normalizeOrigin(origin)
  const viewer = try resolveOptionalViewer(authorizationHeader, authConfig)

  switch (definition.name) {
    case "about_feed":
    case "how_to_play":
    case "start_sign_in":
    case "check_sign_in":
      return try executePublicWorldTool(definition.name, args, baseOrigin, authConfig, ipAddress)
    case "get_post":
    case "get_replies":
    case "get_user_posts":
    case "get_profile":
    case "search":
    case "get_trending":
    case "get_followers":
    case "get_following":
      return try executePublicSocialTool(definition.name, args, viewer)
    case "list_markets":
    case "get_market":
    case "get_leaderboard":
      return try executePublicMarketTool(definition.name, args, viewer)
    default:
      throw new McpFailure({ code: "INVALID_PUBLIC_TOOL", message: `Unsupported public tool: ${definition.name}` })
  }
}

effect function executeProtectedAccountTool(
  toolName: "whoami" | "get_home_feed" | "get_notifications" | "get_portfolio" | "preview_perp" | "set_mode" | "mark_notifications_read",
  args: Record<string, unknown>,
  caller: VerifiedAccessToken
): object!(InvalidRpcParamsFailure | SocialFailure | MarketFailure | AuthFailure | StoreFailure)!Store {
  const mode = caller.playMode
  switch (toolName) {
    case "whoami": {
      const profile = try getProfile(caller.accountId, caller.accountId, mode)
      const rateLimits = try getRateLimitStatus(caller.accountId)
      const baseWhoami: Record<string, unknown> = {
        accountId: caller.accountId,
        handle: profile.handle,
        displayName: profile.displayName,
        playMode: mode,
        activeGrant: {
          grantId: caller.grantId,
          clientId: caller.clientId,
          clientName: caller.clientName,
          scopes: caller.scopes
        },
        rateLimits
      }
      if (mode === "social") {
        return {
          ...baseWhoami,
          financialFieldsOmittedInSocialMode: true
        }
      }
      const economy = try getAccountEconomy(caller.accountId)
      return {
        ...baseWhoami,
        currency: CURRENCY_DISCLAIMER,
        balancePts: toPtsNumber(economy.balanceCents),
        balanceDisplay: formatPtsLabeled(economy.balanceCents),
        positionValuePts: toPtsNumber(economy.positionValueCents),
        equityPts: toPtsNumber(economy.equityCents),
        netProfitPts: toPtsNumber(economy.netProfitCents)
      }
    }
    case "get_home_feed": {
      const rawTab = asOptionalString(args.tab) ?? "latest"
      const tab = rawTab === "for_you" ? "top" : rawTab === "following" ? "following" : rawTab === "top" ? "top" : "latest"
      const cursor = asOptionalString(args.cursor)
      const limit = clampCount(asOptionalInt(args.limit), 25, 100)
      const page = try listFeedPosts({
        tab,
        viewerId: caller.accountId,
        mode,
        limit,
        ...(cursor === undefined ? {} : { cursor })
      })
      return {
        tab,
        mode,
        items: page.items.map((p) => formatPostForMcp(p, mode)),
        nextCursor: page.nextCursor
      }
    }
    case "get_notifications": {
      const unreadOnly = args.unreadOnly === true
      const limit = clampCount(asOptionalInt(args.limit), 30, 100)
      const items = try listNotifications(caller.accountId, limit, mode, unreadOnly)
      const unreadCount = try getUnreadNotificationCount(caller.accountId, mode)
      return { mode, unreadCount, items }
    }
    case "get_portfolio": {
      if (mode === "social") {
        return {
          accountId: caller.accountId,
          playMode: "social",
          financialFieldsOmittedInSocialMode: true,
          message: "Balances, open positions, and P&L are omitted in Social mode. Open positions continue running safely; switch via set_mode({ mode: \"game\" }) only if the user explicitly wants Game mode.",
          currency: CURRENCY_DISCLAIMER
        }
      }
      const ledgerLimit = clampCount(asOptionalInt(args.ledgerLimit), 20, 50)
      const economy = try getAccountEconomy(caller.accountId)
      const positions = try getUserPositions(caller.accountId)
      const ledger = try getPointLedger(caller.accountId, ledgerLimit)
      return {
        accountId: caller.accountId,
        playMode: "game",
        currency: CURRENCY_DISCLAIMER,
        balancePts: toPtsNumber(economy.balanceCents),
        balanceDisplay: formatPtsLabeled(economy.balanceCents),
        positionValuePts: toPtsNumber(economy.positionValueCents),
        equityPts: toPtsNumber(economy.equityCents),
        startingGrantPts: toPtsNumber(economy.startingGrantCents),
        netProfitPts: toPtsNumber(economy.netProfitCents),
        totalFeesPaidPts: toPtsNumber(economy.totalFeesPaidCents),
        predictionPositions: positions.predictionPositions.map((p) => ({
          marketId: p.marketId,
          question: p.question,
          status: p.marketStatus,
          side: p.side,
          shares: shareUnitsToShares(p.shares),
          shareUnits: p.shares,
          costBasisPts: toPtsNumber(p.costBasisCents),
          estimatedValuePts: toPtsNumber(p.estimatedValueCents),
          payoutPts: toPtsNumber(p.payoutCents),
          yesPriceBps: p.yesPriceBps,
          noPriceBps: p.noPriceBps
        })),
        perpPositions: positions.perpPositions.map((p) => ({
          id: p.id,
          ticker: p.ticker,
          side: p.side,
          status: p.status,
          leverage: p.leverage,
          marginPts: toPtsNumber(p.marginCents),
          sizePts: toPtsNumber(p.sizeCents),
          entryPricePts: toPtsNumber(p.entryPriceCents),
          markPricePts: toPtsNumber(p.markPriceCents),
          unrealizedPnlPts: toPtsNumber(p.unrealizedPnlCents),
          equityPts: toPtsNumber(p.equityCents),
          liquidationPricePts: toPtsNumber(p.liquidationPriceCents),
          accruedFundingPts: toPtsNumber(p.accruedFundingCents)
        })),
        recentLedger: ledger.map((entry) => ({
          id: entry.id,
          kind: entry.kind,
          deltaPts: toPtsNumber(entry.deltaCents),
          balanceAfterPts: toPtsNumber(entry.balanceAfterCents),
          refId: entry.refId,
          createdAt: entry.createdAt
        }))
      }
    }
    case "preview_perp": {
      const { ticker, side, leverage, collateralCents, mode: perpMode } = try parsePerpOrderArgs(args)
      if (mode === "social") {
        return {
          previewOnly: true,
          ticker,
          playMode: "social",
          financialFieldsOmittedInSocialMode: true,
          message: "Perpetual order previews and financial quotes are omitted in Social mode. Switch via set_mode({ mode: \"game\" }) only if the user explicitly wants Game mode.",
          currency: CURRENCY_DISCLAIMER
        }
      }
      const preview = try previewPerpOrder({
        ownerId: caller.accountId,
        ticker,
        side,
        collateralCents,
        leverage,
        ...(perpMode === undefined ? {} : { mode: perpMode })
      })
      return {
        previewOnly: true,
        action: preview.action,
        ticker: preview.ticker,
        side: preview.side,
        leverage: preview.leverage,
        collateralPts: toPtsNumber(preview.collateralCents),
        notionalSizePts: toPtsNumber(preview.sizeCents),
        estimatedFeePts: toPtsNumber(preview.feeCents),
        totalDebitPts: toPtsNumber(preview.totalDebitCents),
        preMarkPricePts: toPtsNumber(preview.preMarkPriceCents),
        entryMarkPricePts: toPtsNumber(preview.executionPriceCents),
        executionPricePts: toPtsNumber(preview.executionPriceCents),
        priceImpactBps: preview.priceImpactBps,
        indexPricePts: toPtsNumber(preview.indexPriceCents),
        estimatedLiquidationPricePts: toPtsNumber(preview.estimatedLiquidationPriceCents),
        fundingRateBps: preview.fundingRateBps,
        currency: CURRENCY_DISCLAIMER
      }
    }
    case "set_mode": {
      const targetMode: PlayMode = args.mode === "social" ? "social" : "game"
      const updated = try setPlayMode(caller.accountId, targetMode)
      return {
        playMode: updated.playMode,
        message: updated.playMode === "social"
          ? "Switched to Social mode: balances, P&L, $CASHTAG market links, and market notifications are now hidden."
          : "Switched to Game mode: balances, P&L, prediction odds, and perpetual quotes are now visible."
      }
    }
    case "mark_notifications_read": {
      const notificationIds = Array.isArray(args.notificationIds)
        ? (args.notificationIds as ReadonlyArray<string>)
        : undefined
      return try markNotificationsRead(caller.accountId, notificationIds)
    }
  }
}

effect function executeProtectedSocialTool(
  toolName: "create_post" | "delete_post" | "like" | "unlike" | "repost" | "unrepost" | "follow" | "unfollow" | "block" | "unblock" | "get_blocks" | "mute" | "unmute" | "get_mutes" | "report" | "update_profile",
  args: Record<string, unknown>,
  caller: VerifiedAccessToken
): object!(InvalidRpcParamsFailure | SocialFailure | StoreFailure)!Store {
  switch (toolName) {
    case "create_post": {
      const content = String(args.content ?? "")
      const created = try createPost({
        authorId: caller.accountId,
        authorKind: "user",
        content,
        replyToPostId: asOptionalString(args.replyToPostId) ?? null,
        quotePostId: asOptionalString(args.quotePostId) ?? null,
        marketId: asOptionalString(args.marketId) ?? null,
        ticker: asOptionalString(args.ticker) ?? null,
        viaClientName: caller.clientName
      })
      return { post: formatPostForMcp(created, caller.playMode), viaClientName: caller.clientName }
    }
    case "delete_post":
      return try deletePost(caller.accountId, asOptionalString(args.postId) ?? "")
    case "like":
      return try likePost(caller.accountId, asOptionalString(args.postId) ?? "")
    case "unlike":
      return try unlikePost(caller.accountId, asOptionalString(args.postId) ?? "")
    case "repost":
      return try repostPost(caller.accountId, asOptionalString(args.postId) ?? "")
    case "unrepost":
      return try unrepostPost(caller.accountId, asOptionalString(args.postId) ?? "")
    case "follow":
      return try followAccount(caller.accountId, asOptionalString(args.handleOrId) ?? "")
    case "unfollow":
      return try unfollowAccount(caller.accountId, asOptionalString(args.handleOrId) ?? "")
    case "block":
      return try blockAccount(caller.accountId, asOptionalString(args.handleOrId) ?? "")
    case "unblock":
      return try unblockAccount(caller.accountId, asOptionalString(args.handleOrId) ?? "")
    case "get_blocks": {
      const limit = clampCount(asOptionalInt(args.limit), 50, 100)
      const items = try listBlockedAccounts(caller.accountId, limit)
      return { items }
    }
    case "mute":
      return try muteAccount(caller.accountId, asOptionalString(args.handleOrId) ?? "")
    case "unmute":
      return try unmuteAccount(caller.accountId, asOptionalString(args.handleOrId) ?? "")
    case "get_mutes": {
      const limit = clampCount(asOptionalInt(args.limit), 50, 100)
      const items = try listMutedAccounts(caller.accountId, limit)
      return { items }
    }
    case "report": {
      const targetKind = args.targetKind === "account" ? "account" : "post"
      const targetId = asOptionalString(args.targetId) ?? ""
      const reason = String(args.reason ?? "")
      const rawCat = asOptionalString(args.category)
      const category: ReportCategory | undefined = rawCat === "Spam" || rawCat === "Harassment" || rawCat === "Impersonation" || rawCat === "OtherViolation"
        ? rawCat
        : undefined
      return try reportTarget({
        reporterId: caller.accountId,
        targetKind,
        targetId,
        reason,
        ...(category === undefined ? {} : { category })
      })
    }
    case "update_profile":
      return try updateAccountProfile(caller.accountId, asOptionalString(args.displayName), typeof args.bio === "string" ? args.bio : undefined)
  }
}

effect function executeProtectedMessagingTool(
  toolName: "list_chats" | "get_messages" | "mark_chat_read" | "send_dm" | "send_message" | "react_to_message" | "create_group" | "invite_to_group" | "leave_group" | "list_group_invites" | "respond_to_group_invite",
  args: Record<string, unknown>,
  caller: VerifiedAccessToken
): object!(SocialFailure | StoreFailure)!Store {
  switch (toolName) {
    case "list_chats": {
      const limit = clampCount(asOptionalInt(args.limit), 50, 100)
      const chats = try listChats(caller.accountId)
      return { chats: chats.slice(0, limit) }
    }
    case "get_messages": {
      const chatId = asOptionalString(args.chatId) ?? ""
      const limit = clampCount(asOptionalInt(args.limit), 50, 100)
      const messages = try getChatMessages(caller.accountId, chatId, limit)
      return { chatId, messages }
    }
    case "mark_chat_read": {
      const chatId = asOptionalString(args.chatId) ?? ""
      return try markChatRead(caller.accountId, chatId)
    }
    case "send_dm": {
      const recipientHandleOrId = asOptionalString(args.recipientHandleOrId) ?? ""
      const content = String(args.content ?? "")
      const chat = try createDirectChat(caller.accountId, recipientHandleOrId)
      const message = try sendChatMessage({
        senderId: caller.accountId,
        senderKind: "user",
        chatId: chat.id,
        content,
        viaClientName: caller.clientName
      })
      return { chatId: chat.id, message, viaClientName: caller.clientName }
    }
    case "send_message": {
      const chatId = asOptionalString(args.chatId) ?? ""
      const content = String(args.content ?? "")
      const message = try sendChatMessage({
        senderId: caller.accountId,
        senderKind: "user",
        chatId,
        content,
        viaClientName: caller.clientName
      })
      return { chatId, message, viaClientName: caller.clientName }
    }
    case "react_to_message": {
      const messageId = asOptionalString(args.messageId) ?? ""
      const emoji = asOptionalString(args.emoji) ?? ""
      return try reactToMessage({
        accountId: caller.accountId,
        messageId,
        emoji
      })
    }
    case "create_group": {
      const title = String(args.title ?? "")
      const memberHandles = Array.isArray(args.memberHandles) ? (args.memberHandles as ReadonlyArray<string>) : []
      const chat = try createUserGroupChat(caller.accountId, title, memberHandles)
      return { chat }
    }
    case "invite_to_group": {
      const chatId = asOptionalString(args.chatId) ?? ""
      const targetHandleOrId = asOptionalString(args.targetHandleOrId) ?? ""
      const invited = try inviteToUserGroupChat({
        accountId: caller.accountId,
        chatId,
        targetHandleOrId
      })
      const target = try getProfile(invited.memberId, caller.accountId, "game")
      return {
        inviteId: invited.inviteId,
        chatId: invited.chatId,
        memberId: invited.memberId,
        invitedAccountId: invited.invitedAccountId,
        handle: target.handle,
        status: invited.status,
        added: invited.added
      }
    }
    case "leave_group":
      return try leaveGroupChat(caller.accountId, asOptionalString(args.chatId) ?? "")
    case "list_group_invites": {
      const rawKind = asOptionalString(args.kind)
      const kind: GroupInviteFilterKind = rawKind === "npc_alpha" || rawKind === "user_group" ? rawKind : "all"
      const invites = try listPendingGroupInvites(caller.accountId, kind)
      return { invites }
    }
    case "respond_to_group_invite": {
      const inviteId = asOptionalString(args.inviteId) ?? ""
      const accept = args.accept === true
      const invite = try respondGroupInvite({ accountId: caller.accountId, inviteId, accept })
      return { invite }
    }
  }
}

effect function parsePerpOrderArgs(args: Record<string, unknown>): {
  readonly ticker: string
  readonly side: "long" | "short"
  readonly leverage: number
  readonly collateralCents: number
readonly mode: "flip" | undefined
}!InvalidRpcParamsFailure {
  const ticker = (asOptionalString(args.ticker) ?? "").toUpperCase()
  const side = args.side === "short" ? "short" : "long"
  const leverage = asOptionalInt(args.leverage) ?? 1
const mode = args.mode === "flip" ? "flip" : undefined
  const collateralCents = ptsToWholeCents(Number(args.collateralPts))
  if (collateralCents === undefined) {
    throw new InvalidRpcParamsFailure({ message: "collateralPts must equal at least 0.01 pt (1 cent)." })
  }
  return { ticker, side, leverage, collateralCents, mode }
}

function tradeBalanceFooter(
  mode: PlayMode,
  clientName: string,
  balanceAfterCents: number,
  extraGameFields?: Record<string, unknown>
): Record<string, unknown> {
  return {
    viaClientName: clientName,
    currency: CURRENCY_DISCLAIMER,
    ...(mode === "social"
      ? { financialFieldsOmittedInSocialMode: true }
      : {
          ...extraGameFields,
          balanceAfterPts: toPtsNumber(balanceAfterCents),
          balanceAfterDisplay: formatPtsLabeled(balanceAfterCents)
        })
  }
}

function formatPredictionTradeReceipt(
  receipt: {
    readonly tradeId: string
    readonly marketId: string
    readonly action: string
    readonly side: string
    readonly shares: number
    readonly notionalCents: number
    readonly feeCents: number
    readonly netCents: number
    readonly yesPriceBps: number
    readonly noPriceBps: number
    readonly balanceAfterCents: number
  },
  caller: VerifiedAccessToken
): Record<string, unknown> {
  return {
    tradeId: receipt.tradeId,
    marketId: receipt.marketId,
    action: receipt.action,
    side: receipt.side,
    shares: shareUnitsToShares(receipt.shares),
    shareUnits: receipt.shares,
    ...tradeBalanceFooter(caller.playMode, caller.clientName, receipt.balanceAfterCents, {
      notionalPts: toPtsNumber(receipt.notionalCents),
      feePts: toPtsNumber(receipt.feeCents),
      netPts: toPtsNumber(receipt.netCents),
      yesPriceBps: receipt.yesPriceBps,
      noPriceBps: receipt.noPriceBps
    })
  }
}

effect function resolveSellShareUnits(args: Record<string, unknown>): number!InvalidRpcParamsFailure {
  const explicitUnits = asOptionalInt(args.shareUnits)
  const rawShares = typeof args.shares === "number" ? args.shares : undefined
  const convertedUnits = rawShares === undefined ? undefined : sharesToShareUnits(rawShares)
  if (rawShares !== undefined && convertedUnits === undefined) {
    throw new InvalidRpcParamsFailure({ message: "shares must be a positive number." })
  }
  if (explicitUnits !== undefined && convertedUnits !== undefined && explicitUnits !== convertedUnits) {
    throw new InvalidRpcParamsFailure({ message: "shares and shareUnits disagree; provide only one or matching values." })
  }
  const units = explicitUnits ?? convertedUnits
  if (units === undefined || units <= 0) {
    throw new InvalidRpcParamsFailure({ message: "Provide shares (e.g. 1.5) or integer shareUnits (100 units = 1.00 share)." })
  }
  return units
}

effect function resolveCloseSizeCents(args: Record<string, unknown>): (number | undefined)!InvalidRpcParamsFailure {
  const explicitCents = asOptionalInt(args.sizeCents)
  const rawSizePts = typeof args.sizePts === "number" ? args.sizePts : undefined
  const convertedCents = rawSizePts === undefined ? undefined : ptsToWholeCents(rawSizePts)
  if (rawSizePts !== undefined && convertedCents === undefined) {
    throw new InvalidRpcParamsFailure({ message: "sizePts must equal at least 0.01 pt (1 cent)." })
  }
  if (explicitCents !== undefined && convertedCents !== undefined && explicitCents !== convertedCents) {
    throw new InvalidRpcParamsFailure({ message: "sizePts and sizeCents disagree; provide only one or matching values." })
  }
  return explicitCents ?? convertedCents
}

effect function executeProtectedTradeTool(
  toolName: "buy_prediction" | "sell_prediction" | "open_perp" | "close_perp",
  args: Record<string, unknown>,
  caller: VerifiedAccessToken
): object!(InvalidRpcParamsFailure | McpFailure | MarketFailure | StoreFailure)!Store {
  const mode = caller.playMode
  if (mode === "social") {
    throw new McpFailure({
      code: "SOCIAL_MODE_TRADING_DISABLED",
      message: "Trading tools are disabled in Social mode. Switch to Game mode with set_mode first."
    })
  }
  switch (toolName) {
    case "buy_prediction": {
      const marketId = asOptionalString(args.marketId) ?? ""
      const side = args.side === "no" ? "no" : "yes"
      const amountCents = ptsToWholeCents(Number(args.amountPts))
      if (amountCents === undefined) {
        throw new InvalidRpcParamsFailure({ message: "amountPts must equal at least 0.01 pt (1 cent)." })
      }
      const idempotencyKey = asOptionalString(args.idempotencyKey)
      const receipt = try buyPredictionShares({
        actorId: caller.accountId,
        actorKind: "user",
        marketId,
        side,
        amountCents,
        viaClientName: caller.clientName,
        ...(idempotencyKey === undefined ? {} : { idempotencyKey })
      })
      try maybePublishFeedEvent({
        type: "market.prediction",
        marketId: receipt.marketId,
        action: "buy",
        side: receipt.side,
        yesPriceBps: receipt.yesPriceBps,
        noPriceBps: receipt.noPriceBps,
        shares: receipt.shares,
        notionalCents: receipt.notionalCents
      })
      return formatPredictionTradeReceipt(receipt, caller)
    }
    case "sell_prediction": {
      const marketId = asOptionalString(args.marketId) ?? ""
      const side = args.side === "no" ? "no" : "yes"
      const shareUnits = try resolveSellShareUnits(args)
      const idempotencyKey = asOptionalString(args.idempotencyKey)
      const receipt = try sellPredictionShares({
        actorId: caller.accountId,
        actorKind: "user",
        marketId,
        side,
        shares: shareUnits,
        viaClientName: caller.clientName,
        ...(idempotencyKey === undefined ? {} : { idempotencyKey })
      })
      try maybePublishFeedEvent({
        type: "market.prediction",
        marketId: receipt.marketId,
        action: "sell",
        side: receipt.side,
        yesPriceBps: receipt.yesPriceBps,
        noPriceBps: receipt.noPriceBps,
        shares: receipt.shares,
        notionalCents: receipt.notionalCents
      })
      return formatPredictionTradeReceipt(receipt, caller)
    }
    case "open_perp": {
      const { ticker, side, leverage, collateralCents, mode: perpMode } = try parsePerpOrderArgs(args)
      const receipt = try openPerpPosition({
        ownerId: caller.accountId,
        ownerKind: "user",
        ticker,
        side,
        collateralCents,
        leverage,
        ...(perpMode === undefined ? {} : { mode: perpMode }),
        ...perpTradeMeta(args, caller.clientName)
      })
      try maybePublishFeedEvent({
        type: "market.perp",
        action: receipt.action,
        actorId: caller.accountId,
        ticker: receipt.position.ticker,
        side: receipt.position.side,
        sizeCents: receipt.sizeCents,
        leverage: receipt.leverage,
        positionId: receipt.positionId,
        markPriceCents: receipt.position.markPriceCents
      })
      return {
        tradeId: receipt.tradeId,
        positionId: receipt.positionId,
        action: receipt.action,
        closedPositionId: receipt.closedPositionId,
        ticker: receipt.position.ticker,
        side: receipt.position.side,
        leverage: receipt.leverage,
        ...tradeBalanceFooter(mode, caller.clientName, receipt.balanceAfterCents, {
          collateralPts: toPtsNumber(receipt.collateralCents),
          sizePts: toPtsNumber(receipt.sizeCents),
          feePts: toPtsNumber(receipt.feeCents),
          executionPricePts: toPtsNumber(receipt.executionPriceCents),
          markPricePts: toPtsNumber(receipt.position.markPriceCents),
          liquidationPricePts: toPtsNumber(receipt.position.liquidationPriceCents),
          realizedPnlPts: toPtsNumber(receipt.realizedPnlCents)
        })
      }
    }
    case "close_perp": {
      const positionId = asOptionalString(args.positionId) ?? ""
      const sizeCents = try resolveCloseSizeCents(args)
      const closePct = typeof args.closePct === "number" && Number.isFinite(args.closePct) ? args.closePct : undefined
      if (sizeCents !== undefined && closePct !== undefined) {
        throw new InvalidRpcParamsFailure({ message: "provide only one of sizeCents/sizePts/closePct" })
      }
      const openPositions = try listPerpPositions(caller.accountId)
      const existingPosition = openPositions.find((pos) => pos.id === positionId)
      const receipt = try closePerpPosition({
        ownerId: caller.accountId,
        positionId,
        ...(sizeCents === undefined ? {} : { sizeCents }),
        ...(closePct === undefined ? {} : { closePct }),
        ...perpTradeMeta(args, caller.clientName)
      })
      try maybePublishFeedEvent({
        type: "market.perp",
        action: "close",
        actorId: caller.accountId,
        ticker: receipt.ticker,
        side: receipt.side,
        sizeCents: receipt.sizeCents,
        leverage: existingPosition?.leverage ?? 1,
        positionId: receipt.positionId,
        markPriceCents: receipt.exitPriceCents
      })
      return {
        tradeId: receipt.tradeId,
        positionId: receipt.positionId,
        ticker: receipt.ticker,
        side: receipt.side,
        isFullClose: receipt.isFullClose,
        ...tradeBalanceFooter(mode, caller.clientName, receipt.balanceAfterCents, {
          sizePts: toPtsNumber(receipt.sizeCents),
          remainingSizePts: toPtsNumber(receipt.remainingSizeCents),
          remainingSizeCents: receipt.remainingSizeCents,
          exitPricePts: toPtsNumber(receipt.exitPriceCents),
          markPricePts: toPtsNumber(receipt.exitPriceCents),
          feePts: toPtsNumber(receipt.feeCents),
          realizedPnlPts: toPtsNumber(receipt.realizedPnlCents),
          netCreditPts: toPtsNumber(receipt.netCreditCents)
        })
      }
    }
  }
}

effect function executeProtectedTool(
  definition: McpToolDefinition,
  args: Record<string, unknown>,
  caller: VerifiedAccessToken
): object!(InvalidRpcParamsFailure | McpFailure | SocialFailure | MarketFailure | AuthFailure | StoreFailure)!Store {
  switch (definition.name) {
    case "whoami":
    case "get_home_feed":
    case "get_notifications":
    case "get_portfolio":
    case "preview_perp":
    case "set_mode":
    case "mark_notifications_read":
      return try executeProtectedAccountTool(definition.name, args, caller)
    case "create_post":
    case "delete_post":
    case "like":
    case "unlike":
    case "repost":
    case "unrepost":
    case "follow":
    case "unfollow":
    case "block":
    case "unblock":
    case "get_blocks":
    case "mute":
    case "unmute":
    case "get_mutes":
    case "report":
    case "update_profile":
      return try executeProtectedSocialTool(definition.name, args, caller)
    case "list_chats":
    case "get_messages":
    case "mark_chat_read":
    case "send_dm":
    case "send_message":
    case "react_to_message":
    case "create_group":
    case "invite_to_group":
    case "leave_group":
    case "list_group_invites":
    case "respond_to_group_invite":
      return try executeProtectedMessagingTool(definition.name, args, caller)
    case "buy_prediction":
    case "sell_prediction":
    case "open_perp":
    case "close_perp":
      return try executeProtectedTradeTool(definition.name, args, caller)
    default:
      throw new McpFailure({ code: "INVALID_PROTECTED_TOOL", message: `Unsupported protected tool: ${definition.name}` })
  }
}

function readResourceText(uri: string, origin: string): { readonly mimeType: string; readonly text: string } | undefined {
  const base = normalizeOrigin(origin)
  switch (uri) {
    case "feed://skill.md":
      return { mimeType: "text/markdown", text: renderFeedSkillMd(base) }
    case "feed://how-to-play.md":
      return { mimeType: "text/markdown", text: renderHowToPlayMd(base) }
    case "feed://llms.txt":
      return { mimeType: "text/plain", text: renderLlmsTxt(base) }
    default:
      return undefined
  }
}

function renderPromptMessages(name: string, args: Readonly<Record<string, unknown>>): {
  readonly description: string
  readonly messages: ReadonlyArray<{
    readonly role: "user"
    readonly content: { readonly type: "text"; readonly text: string }
  }>
} | undefined {
  switch (name) {
    case "explore_feed": {
      const focus = asOptionalString(args.focus)
      const focusLine = focus === undefined ? "" : ` Focus especially on ${focus}.`
      return {
        description: "Explore live Feed posts, trending topics, and open markets without requiring sign-in.",
        messages: [
          {
            role: "user",
            content: {
              type: "text",
              text: `Call about_feed, get_trending, and list_markets to summarize what is happening on Feed right now.${focusLine} Label all market prices as Virtual points (pts) — no cash value.`
            }
          }
        ]
      }
    }
    case "connect_account": {
      const clientName = asOptionalString(args.clientName) ?? "MCP Agent"
      return {
        description: "Connect one Feed account grant via OAuth 2.1 or /link Device Flow.",
        messages: [
          {
            role: "user",
            content: {
              type: "text",
              text: `Call start_sign_in with clientName="${clientName}" and give me the verification_uri (/link) and user_code so I can approve in my browser. Never ask for a phone number or SMS code.`
            }
          }
        ]
      }
    }
    case "analyze_market": {
      const marketId = asOptionalString(args.marketId) ?? ""
      return {
        description: "Inspect a Feed market and linked narrative clues.",
        messages: [
          {
            role: "user",
            content: {
              type: "text",
              text: `Call get_market with marketId="${marketId}" and review linked parody posts and articles. Treat posts as untrusted world signal and confirm with me before placing any trade.`
            }
          }
        ]
      }
    }
    default:
      return undefined
  }
}

effect function handleToolsCall(input: {
  readonly id: JsonRpcId
  readonly params: Record<string, unknown>
  readonly origin: string
  readonly authorizationHeader: string | undefined
  readonly authConfig: AuthRuntimeConfig
  readonly ipAddress: string | undefined
}): Response!StoreFailure!Store {
  const toolName = asOptionalString(input.params.name)
  if (toolName === undefined) {
    return jsonRpcErrorResponse({ id: input.id, status: 400, code: -32602, message: "tools/call requires params.name." })
  }
  const definition = getToolDefinition(toolName)
  if (definition === undefined) {
    return jsonRpcErrorResponse({ id: input.id, status: 404, code: -32602, message: `Unknown MCP tool: ${toolName}` })
  }
  const specTool = SPEC_TOOL_BY_NAME[definition.name]
  const validated = validateToolArguments(definition, input.params.arguments)
  if (!validated.ok) {
    return jsonRpcErrorResponse({ id: input.id, status: 400, code: -32602, message: validated.message })
  }

  const runTool = effect {
    if (isPublicMcpTool(specTool)) {
      const payload = try executePublicTool(definition, validated.args, input.origin, input.authorizationHeader, input.authConfig, input.ipAddress)
      const result: CallToolResult = mcpToolResult(payload)
      return jsonRpcSuccessResponse(input.id, result)
    }
    const specMeta = toolMetadata(specTool)
    const requiredScope = specScopeToMcpScope(requiredScopeOf(specTool))
    const caller = try requireAuthenticatedCaller(input.authorizationHeader, input.authConfig, specTool, requiredScope)
    const payload = try executeProtectedTool(definition, validated.args, caller)
    const finalPayload = hasBalanceOrPnlField(specTool) || specMeta.hasBalanceOrPnlField
      ? { ...payload, currency: CURRENCY_DISCLAIMER }
      : payload
    const result: CallToolResult = mcpToolResult(finalPayload)
    return jsonRpcSuccessResponse(input.id, result)
  }

  const baseOrigin = normalizeOrigin(input.origin)
  return runTool catch effect (err) => {
    if (err instanceof StoreFailure) throw err
    if (err instanceof UnauthorizedError) {
      const reason = err.code === "missing_token"
        ? "missing_token"
        : err.code === "token_revoked"
          ? "revoked_token"
          : "invalid_token"
      return dualUnauthorizedResponse({
        id: input.id,
        origin: baseOrigin,
        message: err.message,
        reason
      })
    }
    if (err instanceof InsufficientScopeFailure) {
      return insufficientScopeResponse({
        id: input.id,
        origin: baseOrigin,
        requiredScope: err.requiredScope,
        grantedScopes: err.grantedScopes
      })
    }
    if (err instanceof RateLimited) {
      return rateLimitedResponse({
        id: input.id,
        action: err.action ?? "mcp_call",
        retryAfterSeconds: err.retryAfterSeconds,
        message: err.message
      })
    }
    if (err instanceof AuthFailure) {
      if (!isPublicMcpTool(specTool) && err.status === 401) {
        return dualUnauthorizedResponse({
          id: input.id,
          origin: baseOrigin,
          message: err.message,
          reason: "invalid_token"
        })
      }
      const result: CallToolResult = mcpToolResult({ error: err.code, message: err.message }, true)
      return jsonRpcSuccessResponse(input.id, result)
    }
    if (err instanceof InvalidRpcParamsFailure) {
      return jsonRpcErrorResponse({ id: input.id, status: 400, code: -32602, message: err.message })
    }
    if (err instanceof MarketFailure) {
      if (err.code === "INSUFFICIENT_POINTS") {
        const result: CallToolResult = mcpToolResult(
          {
            error: "insufficient_points",
            message: "Insufficient virtual points (pts — no cash value) for this order. Capital is fixed at the 100 pts starting grant with no point purchases or refills on web or MCP.",
            currency: CURRENCY_DISCLAIMER
          },
          true
        )
        return jsonRpcSuccessResponse(input.id, result)
      }
      if (err.code === "IDEMPOTENCY_CONFLICT") {
        const result: CallToolResult = mcpToolResult(
          {
            error: "idempotency_conflict",
            code: err.code,
            message: err.message,
            currency: CURRENCY_DISCLAIMER
          },
          true
        )
        return jsonRpcSuccessResponse(input.id, result)
      }
      if (err.code === "INVALID_IDEMPOTENCY_KEY") {
        return jsonRpcErrorResponse({ id: input.id, status: 400, code: -32602, message: err.message })
      }
      const result: CallToolResult = mcpToolResult(
        { error: err.code, message: err.message, currency: CURRENCY_DISCLAIMER },
        true
      )
      return jsonRpcSuccessResponse(input.id, result)
    }
    if (err instanceof SocialFailure) {
      if (err.code === "RateLimited") {
        const action = definition.name === "create_post"
          ? "post"
          : definition.name === "send_dm" || definition.name === "send_message"
            ? "dm"
            : "social"
        return rateLimitedResponse({
          id: input.id,
          action,
          retryAfterSeconds: err.retryAfterSeconds ?? 60,
          message: err.message
        })
      }
      const result: CallToolResult = mcpToolResult({ error: err.code, message: err.message }, true)
      return jsonRpcSuccessResponse(input.id, result)
    }
    const result: CallToolResult = mcpToolResult(
      { error: "mcp_tool_error", message: err instanceof McpFailure ? err.message : "MCP tool call failed." },
      true
    )
    return jsonRpcSuccessResponse(input.id, result)
  }
}

export effect function handleMcpRequest(input: {
  readonly request: Request
  readonly origin: string
  readonly authConfig: AuthRuntimeConfig
}): Response!(McpFailure | StoreFailure)!Store {
  const method = input.request.method.toUpperCase()
  if (method === "OPTIONS") {
    return mcpOptionsResponse()
  }
  if (method !== "POST") {
    return jsonRpcErrorResponse({
      id: null,
      status: 405,
      code: -32000,
      message: "Method not allowed. Send Streamable HTTP JSON-RPC over POST /mcp.",
      extraHeaders: { allow: "POST, OPTIONS" }
    })
  }

  const rawText = try tryPromise({
    try: () => input.request.text(),
    catch: (cause) => new McpFailure({ code: "INVALID_REQUEST", message: "Unable to read HTTP request body.", cause })
  })
  const parsed = parseJsonRpcBody(rawText)
  if (!parsed.ok) {
    return jsonRpcErrorResponse({ id: null, status: 400, code: -32700, message: parsed.message })
  }
  const rpc = parsed.body
  if (rpc.jsonrpc !== "2.0" || typeof rpc.method !== "string") {
    return jsonRpcErrorResponse({
      id: toJsonRpcId(rpc.id),
      status: 400,
      code: -32600,
      message: "Invalid JSON-RPC 2.0 request envelope."
    })
  }
  if (rpc.id === undefined) {
    return mcpAcceptedResponse()
  }

  const id = toJsonRpcId(rpc.id)
  const params = typeof rpc.params === "object" && rpc.params !== null && !Array.isArray(rpc.params)
    ? (rpc.params as Record<string, unknown>)
    : {}
  const baseOrigin = normalizeOrigin(input.origin)

  switch (rpc.method) {
    case "initialize": {
      const requested = typeof params.protocolVersion === "string" ? params.protocolVersion : LATEST_PROTOCOL_VERSION
      const negotiated = SUPPORTED_PROTOCOL_VERSIONS.includes(requested) ? requested : parseProtocolVersion(requested)
      return jsonRpcSuccessResponse(id, buildInitializeResult(negotiated, baseOrigin))
    }
    case "ping":
      return jsonRpcSuccessResponse(id, {})
    case "tools/list":
      return jsonRpcSuccessResponse(id, buildListToolsPayload())
    case "resources/list":
      return jsonRpcSuccessResponse(id, { resources: MCP_RESOURCES })
    case "resources/read": {
      const uri = asOptionalString(params.uri)
      const resource = uri === undefined ? undefined : readResourceText(uri, baseOrigin)
      if (resource === undefined || uri === undefined) {
        return jsonRpcErrorResponse({ id, status: 404, code: -32602, message: `Unknown resource URI: ${uri ?? ""}` })
      }
      return jsonRpcSuccessResponse(id, { contents: [{ uri, mimeType: resource.mimeType, text: resource.text }] })
    }
    case "prompts/list":
      return jsonRpcSuccessResponse(id, { prompts: MCP_PROMPTS })
    case "prompts/get": {
      const promptName = asOptionalString(params.name) ?? ""
      const promptArgs = typeof params.arguments === "object" && params.arguments !== null && !Array.isArray(params.arguments)
        ? (params.arguments as Record<string, unknown>)
        : {}
      const prompt = renderPromptMessages(promptName, promptArgs)
      if (prompt === undefined) {
        return jsonRpcErrorResponse({ id, status: 404, code: -32602, message: `Unknown prompt: ${promptName}` })
      }
      return jsonRpcSuccessResponse(id, prompt)
    }
    case "tools/call": {
      const authorizationHeader = input.request.headers.get("authorization") ?? undefined
      return try handleToolsCall({
        id,
        params,
        origin: baseOrigin,
        authorizationHeader,
        authConfig: input.authConfig,
        ipAddress: mcpClientIp(input.request)
      })
    }
    default:
      return jsonRpcErrorResponse({ id, status: 404, code: -32601, message: `Unsupported MCP method: ${rpc.method}` })
  }
}
