const DEFAULT_DEVICE_CLIENT_ID = "https://feed.fun/clients/mcp-device"
const DEFAULT_DEVICE_CLIENT_NAME = "Feed MCP Agent"
const MIN_ORDER_SIZE_CENTS = 1000
const MAINTENANCE_MARGIN_BPS = 250
const TRADING_FEE_BPS = 10
const BPS_DENOMINATOR = 10_000

function maintenanceMarginCents(sizeCents: number): number {
  return Math.max(1, Math.floor((sizeCents * MAINTENANCE_MARGIN_BPS) / BPS_DENOMINATOR))
}

function computeLiquidationPriceCents(input: {
  readonly side: "long" | "short"
  readonly entryPriceCents: number
  readonly marginCents: number
  readonly sizeCents: number
}): number {
  if (input.sizeCents <= 0 || input.entryPriceCents <= 0) return 1
  const maint = maintenanceMarginCents(input.sizeCents)
  const netBuffer = input.marginCents - maint
  const raw = input.side === "long"
    ? Math.floor((input.entryPriceCents * (input.sizeCents - netBuffer)) / input.sizeCents)
    : Math.floor((input.entryPriceCents * (input.sizeCents + netBuffer)) / input.sizeCents)
  return Math.max(1, raw)
}

effect function maybePublishFeedEvent(event: FeedRealtimeEvent): void!! {
  try publishFeedEvent(event)
}

