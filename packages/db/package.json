{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "workerd": "./dist/src/index.js",
      "types": "./src/index.vibe",
      "default": "./src/index.vibe"
    },
    "./worker": {
      "workerd": "./dist/src/worker.js",
      "types": "./src/worker.vibe",
      "default": "./src/worker.vibe"
    },
    "./node": {
      "types": "./src/node.vibe",
      "default": "./src/node.vibe"
    },
    "./schema": {
      "workerd": "./dist/src/schema.sql.js",
      "types": "./src/schema.sql.ts",
      "default": "./src/schema.sql.ts"
    }
  },
  "scripts": {
    "typecheck": "vibelang --noEmit -p .",
    "build": "vibelang -p tsconfig.build.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@elizaos/cloud": "workspace:*",
    "@repo/pack-default": "workspace:*",
    "effect": "4.1.1",
    "pg": "catalog:",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13"
  }
}
