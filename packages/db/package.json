{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/index.vibe",
    "./worker": "./src/worker.vibe",
